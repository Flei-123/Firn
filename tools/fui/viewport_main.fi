// SPDX-License-Identifier: MPL-2.0
// tools/fui/viewport_main.fi -- DER SCHEIBENKASTEN WIRD NACHGERECHNET.
//
// Die Zahlen sind von Hand gerechnet. Das Blatt: ein Ausschnitt von
// 200 x 300 auf einem Inhalt von 200 x 900, Balkendicke 12.
//
//   1. Welche Balken noetig sind -- samt der Rechnung UEBER KREUZ:
//      ein senkrechter Balken nimmt Breite weg und kann dadurch einen
//      waagerechten noetig machen.
//   2. Der sichtbare Ausschnitt und die groesste Verschiebung.
//   3. Die Klemmung: ueber das Ende hinaus wird nicht gerollt.
//   4. Der Anteil Ausschnitt/Inhalt und die Stellung des Balkens.
//   5. `viewport_ensure_visible` holt ein Rechteck herein -- von unten
//      und von oben, und rollt dabei so wenig wie moeglich.
//   6. Die Trefferpruefung UNTER VERSCHIEBUNG: derselbe Fensterpunkt
//      trifft nach dem Rollen einen anderen Punkt im Inhalt.
//   7. Das kinetische Auslaufen kommt zur Ruhe und laeuft nicht ueber
//      das Ende hinaus.
//
// Ab Abschnitt 8 wird nicht mehr gerechnet, sondern GEMALT und danach
// abgelesen -- auf einer echten Leinwand (canvas.canvas_init), mit dem
// echten Painter und einem echten render.Ctx:
//
//   8. DAS HARTE CLIPPING. Ein absichtlich weit ueberstehender Inhalt
//      wird zwischen `viewport_begin` und `viewport_end` gemalt, und
//      danach wird JEDER Bildpunkt der Leinwand ausserhalb des
//      Ausschnitts angesehen. Ein einziger gesetzter Punkt ist ein
//      Fehlschlag. Damit das nicht dadurch gruen wird, dass gar nichts
//      gemalt wurde, wird im selben Zug gezaehlt, wie viel INNERHALB
//      gesetzt ist. Und es gibt die GEGENPROBE: derselbe Inhalt ohne
//      Clip, von derselben Zaehlung gemessen -- sie muss ueberlaufene
//      Punkte finden und ihre Zahl drucken. Und dieselbe Nullmessung
//      ("kein Punkt ausserhalb") laeuft ein zweites Mal OHNE Clip: sie
//      MUSS scheitern, ihr Scheitern steht als ROT-OK im Protokoll, und
//      damit ist belegt, dass die Null oben ueberhaupt etwas misst.
//   9. DIE LAENGE DES SCHIEBERS, von der Leinwand abgelesen und gegen
//      Ausschnitt/Inhalt * Spurlaenge gerechnet.
//  10. Rad, Tasten und das Auslaufen MITTEN in der Bewegung.
//  11. DERSELBE KASTEN BEI MASSSTAB 1.5. Die Balkendicke steht in
//      Entwurfspunkten; umgerechnet wird sie an EINER Stelle im Baum
//      (`theme.theme_px`, hier 12 -> 18), und dieses Modul rechnet
//      nichts davon nach. Nachgewiesen wird, dass der sichtbare
//      Ausschnitt dann 182 x 282 ist UND dass der Clip weiterhin
//      genau darauf sitzt -- mit derselben Zaehlung wie Abschnitt 8.
//  12. DIE BALKEN WERDEN BEDIENT. Treffer, Griff auf dem Schieber,
//      fuenfzig Punkte gezogen (Verschiebung = 50 * Inhalt/Spur =
//      50 * 900/284 = 158.45), das Weiterziehen vom GRIFF aus, die
//      Klemmung am Ende und der Seitensprung beim Klick auf die Spur.
import std.rt
import paint.canvas
import fui.theme
import fui.style
import fui.painter
import fui.layout
import fui.render
import fui.viewport
import fui.widget
import fui.wave2

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    var w: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&w[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// DER ERWARTET ROTE BEFUND. Eine Zusicherung, die SCHEITERN MUSS:
// dieselbe Messung wie nebenan, nur unter Bedingungen, unter denen sie
// nicht bestehen kann. Scheitert sie, ist alles in Ordnung und im
// Protokoll steht ROT-OK; besteht sie dagegen, dann misst die Messung
// nichts, und DAS ist der Fehlschlag. Ohne diesen Umweg bliebe jede
// Nullmessung dieses Programms unbelegt -- sie waere auch dann gruen,
// wenn sie gar nichts ansieht.
fn rot(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    } else {
        var o: [u8; 8] = "ROT-OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 8)
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    var w: [u8; 20] = " want NICHT genau   "
    rt.buf_push_bytes(&t, (&w[0]) as u64, 18)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// Eine gemessene Zahl ohne Sollwert -- die Gegenprobe druckt damit,
// WIE VIEL ohne Clip uebergelaufen waere. Eine Zahl, die man sieht,
// ist der Unterschied zwischen einem Nachweis und einer Behauptung.
fn zahl(nm: u64, nn: usize, a: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    var g: [u8; 4] = "  = "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// Die Leinwand fuer die Abschnitte 8 und 9. Sie ist absichtlich nur
// wenig groesser als der Ausschnitt bei (50, 40): so liegt rund um den
// Ausschnitt ueberall Leinwand, auf der ein Ueberlauf auffallen MUSS.
const LW: usize = 400
const LH: usize = 400

// DER ABSICHTLICH ZU GROSSE INHALT.
//
// Zwanzig Zeilen zu je 44 Punkten, also 880 Punkte hoch, und jede Zeile
// ist 260 breit und beginnt 30 Punkte links vom Inhaltsanfang. Bei
// einer Verschiebung von 100 ragt der Inhalt damit ueber ALLE VIER
// Kanten des Ausschnitts hinaus -- oben, unten, links und rechts. Ohne
// Clip landet davon mehr als die Haelfte neben dem Kasten.
fn inhalt_malen(z: *mut painter.Painter, v: *mut viewport.Viewport,
    col: u32) {
    let cx: f64 = viewport.viewport_content_x(v)
    let cy: f64 = viewport.viewport_content_y(v)
    var i: usize = 0
    while i < 20 {
        painter.round_rect(z, cx - 30.0, cy + (i as f64) * 44.0, 260.0,
            40.0, 8.0, col)
        i = i + 1
    }
}

// Zaehlt die gesetzten Bildpunkte AUSSERHALB des Ausschnitts. Gesetzt
// heisst: die Deckung ist nicht null -- die Leinwand wurde vorher auf
// durchsichtig geloescht, also ist jeder Punkt mit Deckung von diesem
// Malen gekommen. Gemessen wird gegen den WIRKLICH sichtbaren
// Ausschnitt (ohne die Balkenspuren), denn genau darauf legt
// `viewport_begin` seinen Clip.
fn drueber(cv: *mut canvas.Canvas, v: *mut viewport.Viewport) -> usize {
    let x0: f64 = viewport.viewport_x(v)
    let y0: f64 = viewport.viewport_y(v)
    let x1: f64 = x0 + viewport.viewport_inner_w(v)
    let y1: f64 = y0 + viewport.viewport_inner_h(v)
    var n: usize = 0
    var y: usize = 0
    while y < LH {
        var x: usize = 0
        while x < LW {
            let drin: bool = (x as f64) >= x0 && (x as f64) < x1
            && (y as f64) >= y0 && (y as f64) < y1
            if !drin {
                if canvas.color_a(canvas.canvas_get(cv, x, y)) != 0 as u32 {
                    n = n + 1
                }
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

// Und dieselbe Zaehlung INNERHALB. Ohne sie waere Abschnitt 8 auch
// dann gruen, wenn ueberhaupt nichts gemalt worden waere -- die
// billigste Art, ein Clipping zu bestehen, ist, nichts zu zeichnen.
fn drinnen(cv: *mut canvas.Canvas, v: *mut viewport.Viewport) -> usize {
    let x0: f64 = viewport.viewport_x(v)
    let y0: f64 = viewport.viewport_y(v)
    let x1: f64 = x0 + viewport.viewport_inner_w(v)
    let y1: f64 = y0 + viewport.viewport_inner_h(v)
    var n: usize = 0
    var y: usize = y0 as usize
    while (y as f64) < y1 {
        var x: usize = x0 as usize
        while (x as f64) < x1 {
            if canvas.color_a(canvas.canvas_get(cv, x, y)) != 0 as u32 {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn main(start: u64) -> i32 {
    // Der Inhalt ist genauso breit wie der Ausschnitt, aber dreimal so
    // hoch. Also: senkrechter Balken ja -- und weil der 12 Punkte
    // Breite nimmt, passt der Inhalt waagerecht NICHT mehr, also auch
    // ein waagerechter. Das ist die Rechnung ueber Kreuz.
    var v: viewport.Viewport = viewport.viewport_new(50.0, 40.0, 200.0,
        300.0, 200.0, 900.0)

    var n1: [u8; 30] = "1 senkrechter Balken noetig   "
    report((&n1[0]) as u64, 30, viewport.viewport_needs_v(&v),
        viewport.viewport_needs_v(&v) as i64, 1)
    var n2: [u8; 34] = "1 waagerechter Balken ueber Kreuz "
    report((&n2[0]) as u64, 34, viewport.viewport_needs_h(&v),
        viewport.viewport_needs_h(&v) as i64, 1)

    // 200 - 12 = 188 breit, 300 - 12 = 288 hoch.
    let iw: i64 = viewport.viewport_inner_w(&v) as i64
    let ih: i64 = viewport.viewport_inner_h(&v) as i64
    var n3: [u8; 30] = "2 sichtbare Breite 188        "
    report((&n3[0]) as u64, 30, iw == 188, iw, 188)
    var n4: [u8; 30] = "2 sichtbare Hoehe 288         "
    report((&n4[0]) as u64, 30, ih == 288, ih, 288)
    // 900 - 288 = 612.
    let my: i64 = viewport.viewport_max_y(&v) as i64
    var n5: [u8; 30] = "2 groesste Verschiebung 612   "
    report((&n5[0]) as u64, 30, my == 612, my, 612)

    // ========================================== 3. DIE KLEMMUNG
    viewport.viewport_set_offset(&v, 0.0, 10000.0)
    let o1: i64 = viewport.viewport_off_y(&v) as i64
    var n6: [u8; 32] = "3 ueber das Ende wird geklemmt  "
    report((&n6[0]) as u64, 32, o1 == 612, o1, 612)
    viewport.viewport_scroll_by(&v, 0.0, 0.0 - 100000.0)
    let o2: i64 = viewport.viewport_off_y(&v) as i64
    var n7: [u8; 32] = "3 vor den Anfang auch nicht     "
    report((&n7[0]) as u64, 32, o2 == 0, o2, 0)

    // ======================= 4. ANTEIL UND STELLUNG DES BALKENS
    //
    // 288 / 900 = 0.32 -- in der Sprache von wave2 (VAL_MAX = 1000)
    // sind das 320 Promille. Bei halber Verschiebung (306 von 612)
    // steht der Balken auf 500.
    let anteil: i64 = (viewport.viewport_share_v(&v)
        *(wave2.VAL_MAX as f64)) as i64
    var n8: [u8; 34] = "4 Anteil 288/900 = 320 Promille   "
    report((&n8[0]) as u64, 34, anteil == 320, anteil, 320)
    viewport.viewport_set_offset(&v, 0.0, 306.0)
    let stellung: i64 = viewport.viewport_value_v(&v)
    var n9: [u8; 35] = "4 halbe Verschiebung = Stellung 500"
    report((&n9[0]) as u64, 35, stellung == 500, stellung, 500)

    // ==================================== 5. ETWAS HEREINHOLEN
    //
    // Der Ausschnitt steht bei 306 und zeigt 306..594. Ein Rechteck
    // bei 700 (30 hoch) muss mit seiner UNTERKANTE an die Unterkante:
    // 730 - 288 = 442.
    viewport.viewport_ensure_visible(&v, 0.0, 700.0, 100.0, 30.0)
    let e1: i64 = viewport.viewport_off_y(&v) as i64
    var n10: [u8; 34] = "5 von unten hereingeholt: 442     "
    report((&n10[0]) as u64, 34, e1 == 442, e1, 442)
    // Etwas bei 100 kommt mit seiner OBERKANTE an die Oberkante.
    viewport.viewport_ensure_visible(&v, 0.0, 100.0, 100.0, 30.0)
    let e2: i64 = viewport.viewport_off_y(&v) as i64
    var n11: [u8; 34] = "5 von oben hereingeholt: 100      "
    report((&n11[0]) as u64, 34, e2 == 100, e2, 100)
    // Was schon zu sehen ist, bewegt gar nichts.
    let bewegt: bool = viewport.viewport_ensure_visible(&v, 0.0, 150.0,
        100.0, 30.0)
    let e3: i64 = viewport.viewport_off_y(&v) as i64
    var n12: [u8; 34] = "5 was zu sehen ist, rollt nicht   "
    report((&n12[0]) as u64, 34, !bewegt && e3 == 100, e3, 100)

    // ================= 6. DIE TREFFERPRUEFUNG UNTER VERSCHIEBUNG
    //
    // Der Ausschnitt beginnt bei (50, 40) und steht bei 100. Der
    // Fensterpunkt (60, 50) liegt also 10 unter der Oberkante des
    // Ausschnitts und damit bei 110 im Inhalt.
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    let drin: bool = viewport.viewport_hit(&v, 60.0, 50.0, &cx, &cy)
    var n13: [u8; 34] = "6 Punkt im Inhalt: y = 110        "
    report((&n13[0]) as u64, 34, drin && (cy as i64) == 110,
        cy as i64, 110)
    var n14: [u8; 34] = "6 Punkt im Inhalt: x = 10         "
    report((&n14[0]) as u64, 34, drin && (cx as i64) == 10,
        cx as i64, 10)
    // Unter dem waagerechten Balken ist NICHT mehr Ausschnitt.
    let drunter: bool = viewport.viewport_hit(&v, 60.0, 40.0 + 295.0,
        &cx, &cy)
    var n15: [u8; 34] = "6 unter dem Balken kein Treffer   "
    report((&n15[0]) as u64, 34, !drunter, drunter as i64, 0)

    // ====================================== 7. DAS AUSLAUFEN
    //
    // Eine Geschwindigkeit von 1 Pixel je Millisekunde traegt
    // VP_FLING_MS/2 = 210 Pixel weit: von 100 auf 310.
    viewport.viewport_set_offset(&v, 0.0, 100.0)
    viewport.viewport_fling(&v, 0.0, 1.0, 0)
    viewport.viewport_tick(&v, viewport.VP_FLING_MS)
    let f1: i64 = viewport.viewport_off_y(&v) as i64
    var n16: [u8; 34] = "7 das Auslaufen endet bei 310     "
    report((&n16[0]) as u64, 34, f1 == 310, f1, 310)
    var n17: [u8; 34] = "7 und es steht danach still       "
    report((&n17[0]) as u64, 34, !viewport.viewport_moving(&v),
        viewport.viewport_moving(&v) as i64, 0)

    // ==================================================================
    // 8. DAS HARTE CLIPPING -- AUF DER LEINWAND GEMESSEN
    // ==================================================================
    //
    // Bis hierher hat dieses Programm nur gerechnet. Ein Clip, der
    // gerechnet stimmt und gemalt danebenliegt, ist aber genau der
    // Fehler, wegen dem dieser Kasten gebaut wurde. Also: echte
    // Leinwand, echter Painter, echter render.Ctx -- und hinterher
    // wird jeder einzelne Bildpunkt angesehen.
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, LW, LH) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, LW, LH) {
        return 5
    }
    var m: theme.Theme = theme.theme_new(true)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    let farbe: u32 = theme.opaque((*f).accent)

    var k: viewport.Viewport = viewport.viewport_new(50.0, 40.0, 200.0,
        300.0, 200.0, 900.0)
    viewport.viewport_set_offset(&k, 0.0, 100.0)

    // Durchsichtig geloescht: jeder Punkt mit Deckung ist danach
    // beweisbar von diesem Malen gekommen und nicht vom Grund.
    canvas.canvas_clear(&cv, 0 as u32)
    let auf: bool = viewport.viewport_begin(&c, &k)
    inhalt_malen(&z, &k, farbe)
    viewport.viewport_end(&c, &k)
    let ueber: usize = drueber(&cv, &k)
    let innen: usize = drinnen(&cv, &k)
    var n18: [u8; 40] = "8 kein Punkt ausserhalb des Ausschnitts "
    report((&n18[0]) as u64, 40, auf && ueber == 0, ueber as i64, 0)
    // 20 Zeilen von 40 Punkten im Abstand von 44 decken rund
    // 40/44 des Ausschnitts (188 x 288 = 54144), also ueber 45000
    // Punkte. Die Schwelle steht bei 40000 -- tiefer, als der Inhalt
    // je fallen kann, und weit ueber dem, was eine leere Leinwand
    // liefert.
    var n19: [u8; 40] = "8 innerhalb gemalt: mehr als 40000      "
    report((&n19[0]) as u64, 40, innen > 40000, innen as i64, 40000)

    // DIE GEGENPROBE. Derselbe Inhalt, dieselbe Zaehlung -- nur ohne
    // Clip. Findet sie jetzt KEINEN Ueberlauf, dann misst sie nichts,
    // und Abschnitt 8 waere ein Selbstgespraech.
    canvas.canvas_clear(&cv, 0 as u32)
    inhalt_malen(&z, &k, farbe)
    let ueber2: usize = drueber(&cv, &k)
    // Allein die 30 Punkte links und die 42 rechts ueber 288 Punkte
    // Hoehe sind zusammen ueber 20000 Punkte; dazu kommen die Zeilen
    // ueber und unter dem Ausschnitt.
    var n20: [u8; 40] = "8 Gegenprobe ohne Clip: ueber 20000     "
    report((&n20[0]) as u64, 40, ueber2 > 20000, ueber2 as i64, 20000)
    var n21: [u8; 40] = "8 uebergelaufene Punkte ohne Clip       "
    zahl((&n21[0]) as u64, 40, ueber2 as i64)
    // UND DIESELBE NULLMESSUNG EIN ZWEITES MAL -- WORTGLEICH ZU n18,
    // nur ohne Clip. Sie MUSS scheitern, und ihr Scheitern steht als
    // ROT im Protokoll: damit sieht ein Leser nicht nur, dass die
    // Zaehlung in Zeile n18 null gefunden hat, sondern auch, dass
    // dieselbe Zaehlung ueberhaupt etwas finden KANN. Eine Nullmessung,
    // die nie anschlaegt, ist keine Messung.
    var n22: [u8; 40] = "8 dieselbe Messung ohne Clip (ROT)      "
    rot((&n22[0]) as u64, 40, ueber2 == 0, ueber2 as i64, 0)

    // ==================================================================
    // 9. DIE LAENGE DES SCHIEBERS, VON DER LEINWAND ABGELESEN
    // ==================================================================
    //
    // Die Spur des senkrechten Balkens ist 288 lang, davon gehen oben
    // und unten je 2 Punkte Polster ab: 284. Sichtbar sind 288 von 900,
    // also 284 * 288/900 = 90.88 -- aufgerundet 91 Punkte Schieber.
    // Die Mindestlaenge aus wave2 (24 Punkte) ist die benannte
    // Ausnahme von dieser Rechnung und greift hier nicht.
    //
    // Gemessen wird in der MITTE des Balkens (x = 244): dort ist der
    // Schieber ueber seine ganze Laenge gedeckt, die runden Ecken
    // liegen links und rechts davon.
    canvas.canvas_clear(&cv, theme.opaque((*f).base))
    viewport.viewport_set_offset(&k, 0.0, 306.0)
    viewport.viewport_draw_bars(&c, &k)

    var bx: f64 = 0.0
    var by: f64 = 0.0
    var bw: f64 = 0.0
    var bh: f64 = 0.0
    let hat_balken: bool = viewport.viewport_bar_rect_v(&k, &bx, &by,
        &bw, &bh)
    var n23: [u8; 40] = "9 die Spur des Balkens ist 288 lang     "
    report((&n23[0]) as u64, 40, hat_balken && (bh as i64) == 288,
        bh as i64, 288)

    // Die Spurfarbe wird dort abgelesen, wo sicher kein Schieber
    // liegt: dicht unter der Oberkante. Der Schieber steht bei halber
    // Stellung rund 96 Punkte tiefer.
    //
    // Gezaehlt wird die LAENGSTE ZUSAMMENHAENGENDE Strecke, die von der
    // Spurfarbe abweicht, und nicht jede abweichende Zeile: die Spur
    // ist selbst ein rundes Rechteck, und ihre weichen Kanten ganz oben
    // und ganz unten weichen ebenfalls ab. Der Schieber ist das einzige
    // lange Stueck in dieser Spalte, und genau seine Laenge soll hier
    // herauskommen.
    let spur: u32 = canvas.canvas_get(&cv, 244, 42)
    var gemessen: usize = 0
    var anfang: usize = 0
    var lauf: usize = 0
    var yy: usize = 40
    while yy < 328 {
        if canvas.canvas_get(&cv, 244, yy) != spur {
            lauf = lauf + 1
            if lauf > gemessen {
                gemessen = lauf
                anfang = yy + 1 - lauf
            }
        } else {
            lauf = 0
        }
        yy = yy + 1
    }
    // Ein Punkt Spiel nach oben und unten: die weiche Kante des
    // Rasterers faerbt die angeschnittene Zeile mit.
    var n24: [u8; 40] = "9 Schieberlaenge auf der Leinwand 90..92"
    report((&n24[0]) as u64, 40, gemessen >= 90 && gemessen <= 92,
        gemessen as i64, 91)
    // Und er faengt dort an, wo die Stellung es verlangt: 138.56,
    // also auf der Leinwand bei Zeile 138 (die angeschnittene Zeile
    // ist schon eingefaerbt).
    var n23b: [u8; 40] = "9 Schieber beginnt bei Zeile 138..139   "
    report((&n23b[0]) as u64, 40, anfang >= 138 && anfang <= 139,
        anfang as i64, 138)

    // Und dieselbe Laenge aus wave2.scrollbar_thumb -- der EINEN
    // Stelle, an der sie gerechnet wird. Waere sie hier eine andere,
    // haette der Balken auf dem Bild eine andere Laenge als die, mit
    // der ein Aufrufer rechnet.
    var e: widget.Widget = widget.widget_new(widget.KIND_SCROLLBAR)
    widget.w_place(&e, bx, by, bw, bh)
    widget.w_set_pref(&e, 0.0,
        viewport.viewport_share_v(&k) * (wave2.VAL_MAX as f64))
    widget.w_set_value(&e, viewport.viewport_value_v(&k))
    var tr: layout.Rect = wave2.scrollbar_thumb(&c, &e)
    var n25: [u8; 40] = "9 wave2.scrollbar_thumb sagt 91         "
    report((&n25[0]) as u64, 40, layout.rect_h(&tr) == 91,
        layout.rect_h(&tr), 91)
    // Sie steht auch an der richtigen Stelle: 40 + 2 + (284 - 90.88)
    // * 500/1000 = 138.56, gerundet 139.
    var n26: [u8; 40] = "9 und der Schieber steht bei 139        "
    report((&n26[0]) as u64, 40, layout.rect_y(&tr) == 139,
        layout.rect_y(&tr), 139)

    // ==================================================================
    // 10. RAD, TASTEN UND DAS AUSLAUFEN MITTEN IN DER BEWEGUNG
    // ==================================================================
    //
    // Ein Radrasten sind VP_WHEEL_STEP = 72 Punkte; zwei Rasten in
    // einem Ereignis sind 144.
    viewport.viewport_set_offset(&k, 0.0, 0.0)
    viewport.viewport_wheel(&k, 0.0, 1.0)
    let r1: i64 = viewport.viewport_off_y(&k) as i64
    var n27: [u8; 40] = "10 ein Radrasten rollt 72               "
    report((&n27[0]) as u64, 40, r1 == 72, r1, 72)
    viewport.viewport_wheel(&k, 0.0, 2.0)
    let r2: i64 = viewport.viewport_off_y(&k) as i64
    var n28: [u8; 40] = "10 zwei Rasten dazu: 216                "
    report((&n28[0]) as u64, 40, r2 == 216, r2, 216)

    // Eine Seite ist der sichtbare Ausschnitt: 288. Zweimal sind 576,
    // beim dritten Mal KLEMMT es bei 612 -- und beim vierten bewegt
    // sich gar nichts mehr, was die Taste auch sagt.
    viewport.viewport_set_offset(&k, 0.0, 0.0)
    viewport.viewport_key(&k, viewport.VP_PAGE_DOWN)
    viewport.viewport_key(&k, viewport.VP_PAGE_DOWN)
    let s2: i64 = viewport.viewport_off_y(&k) as i64
    var n29: [u8; 40] = "10 zwei Seiten abwaerts: 576            "
    report((&n29[0]) as u64, 40, s2 == 576, s2, 576)
    viewport.viewport_key(&k, viewport.VP_PAGE_DOWN)
    let s3: i64 = viewport.viewport_off_y(&k) as i64
    var n30: [u8; 40] = "10 die dritte klemmt am Ende: 612       "
    report((&n30[0]) as u64, 40, s3 == 612, s3, 612)
    let s4: bool = viewport.viewport_key(&k, viewport.VP_PAGE_DOWN)
    var n31: [u8; 40] = "10 und die vierte bewegt nichts mehr    "
    report((&n31[0]) as u64, 40, !s4, s4 as i64, 0)
    viewport.viewport_key(&k, viewport.VP_HOME)
    viewport.viewport_key(&k, viewport.VP_DOWN)
    let s5: i64 = viewport.viewport_off_y(&k) as i64
    var n32: [u8; 40] = "10 Pos1 und ein Schritt abwaerts: 24    "
    report((&n32[0]) as u64, 40, s5 == 24, s5, 24)

    // DAS AUSLAUFEN MITTEN IN DER BEWEGUNG. Es beginnt bei der
    // Millisekunde 1000 und nicht bei 0 -- ein Kasten, der seine eigene
    // Zeit fuehrte, wuerde genau hier auffallen.
    //
    // Von 0 mit 1 Punkt je Millisekunde: Ziel 210. Nach der halben
    // Dauer (210 ms) steht ein EASE_OUT (cubic-bezier 0, 0, 0.58, 1)
    // NICHT auf der Haelfte, sondern schon weiter: x(t) = 1.74 t^2 -
    // 0.74 t^3 = 0.5 gibt t = 0.6256, und y(t) = 3 (1-t) t^2 + t^3 =
    // 0.684. Also 0.684 * 210 = 143.7 Punkte -- gefordert wird das
    // Band 140 bis 147, und damit ist zugleich belegt, dass hier
    // wirklich die Kurve aus anim.fi laeuft und keine Gerade.
    viewport.viewport_set_offset(&k, 0.0, 0.0)
    viewport.viewport_fling(&k, 0.0, 1.0, 1000)
    viewport.viewport_tick(&k, 1000)
    let a0: i64 = viewport.viewport_off_y(&k) as i64
    var n33: [u8; 40] = "10 im Augenblick des Anstosses: 0       "
    report((&n33[0]) as u64, 40, a0 == 0, a0, 0)
    var n34: [u8; 40] = "10 und der Kasten ist in Bewegung       "
    report((&n34[0]) as u64, 40, viewport.viewport_moving(&k),
        viewport.viewport_moving(&k) as i64, 1)
    viewport.viewport_tick(&k, 1210)
    let a1: i64 = viewport.viewport_off_y(&k) as i64
    var n35: [u8; 40] = "10 nach der halben Dauer: 140..147      "
    report((&n35[0]) as u64, 40, a1 >= 140 && a1 <= 147, a1, 144)
    viewport.viewport_tick(&k, 1420)
    let a2: i64 = viewport.viewport_off_y(&k) as i64
    var n36: [u8; 40] = "10 am Ende der Dauer: 210               "
    report((&n36[0]) as u64, 40, a2 == 210, a2, 210)
    var n37: [u8; 40] = "10 und danach steht es still            "
    report((&n37[0]) as u64, 40, !viewport.viewport_moving(&k),
        viewport.viewport_moving(&k) as i64, 0)

    // WER WAEHREND DES AUSLAUFENS SELBST ROLLT, HAELT ES AN. Sonst
    // schreibt der naechste Takt die Verschiebung des Tweens darueber,
    // und das Rad haette nichts getan.
    viewport.viewport_set_offset(&k, 0.0, 0.0)
    viewport.viewport_fling(&k, 0.0, 1.0, 2000)
    viewport.viewport_tick(&k, 2100)
    viewport.viewport_wheel(&k, 0.0, 1.0)
    let b0: i64 = viewport.viewport_off_y(&k) as i64
    var n38: [u8; 40] = "10 das Rad haelt das Auslaufen an       "
    report((&n38[0]) as u64, 40, !viewport.viewport_moving(&k),
        viewport.viewport_moving(&k) as i64, 0)
    viewport.viewport_tick(&k, 2400)
    let b1: i64 = viewport.viewport_off_y(&k) as i64
    var n39: [u8; 40] = "10 und der Takt schreibt nichts darueber"
    report((&n39[0]) as u64, 40, b1 == b0, b1, b0)

    // ==================================================================
    // 11. DERSELBE KASTEN BEI MASSSTAB 1.5
    // ==================================================================
    //
    // Die Dicke eines Rollbalkens steht in ENTWURFSPUNKTEN, und dieses
    // Modul rechnet sie NICHT um -- die Umrechnung Entwurfspunkt ->
    // Bildpunkt steht an genau einer Stelle im Baum, naemlich
    // `theme.theme_px`. Ein Kasten auf einem Schirm mit 150 % bekommt
    // seine Dicke darum vom Aufrufer: theme_px(12) = (12*1500+500)/1000
    // = 18 Bildpunkte.
    //
    // Was hier nachgewiesen wird, ist die Folge davon: der sichtbare
    // Ausschnitt schrumpft auf 200 - 18 = 182 und 300 - 18 = 282, und
    // der Clip aus `viewport_begin` sitzt WEITERHIN genau auf diesem
    // Ausschnitt -- gemessen mit derselben Zaehlung wie in Abschnitt 8,
    // Bildpunkt fuer Bildpunkt.
    var m15: theme.Theme = theme.theme_new(true)
    theme.theme_set_scale(&m15, 1500)
    var c15: render.Ctx = render.ctx_new(&m15, &z)
    let dicke: usize = theme.theme_px(&m15, 12)
    var n40: [u8; 40] = "11 theme_px(12) bei Massstab 1.5 ist 18 "
    report((&n40[0]) as u64, 40, dicke == 18, dicke as i64, 18)

    var g: viewport.Viewport = viewport.viewport_new(50.0, 40.0, 200.0,
        300.0, 200.0, 900.0)
    viewport.viewport_set_bar(&g, dicke)
    viewport.viewport_set_offset(&g, 0.0, 100.0)
    let giw: i64 = viewport.viewport_inner_w(&g) as i64
    let gih: i64 = viewport.viewport_inner_h(&g) as i64
    var n41: [u8; 40] = "11 sichtbare Breite 200 - 18 = 182      "
    report((&n41[0]) as u64, 40, giw == 182, giw, 182)
    var n42: [u8; 40] = "11 sichtbare Hoehe 300 - 18 = 282       "
    report((&n42[0]) as u64, 40, gih == 282, gih, 282)

    canvas.canvas_clear(&cv, 0 as u32)
    let auf15: bool = viewport.viewport_begin(&c15, &g)
    inhalt_malen(&z, &g, farbe)
    viewport.viewport_end(&c15, &g)
    let ueber15: usize = drueber(&cv, &g)
    let innen15: usize = drinnen(&cv, &g)
    var n43: [u8; 40] = "11 kein Punkt ausserhalb, auch bei 1.5  "
    report((&n43[0]) as u64, 40, auf15 && ueber15 == 0, ueber15 as i64, 0)
    // 182 x 282 = 51324 Punkte Ausschnitt, davon deckt der Inhalt rund
    // 40/44 -- die Schwelle 40000 ist dieselbe wie in Abschnitt 8 und
    // liegt weit ueber dem, was eine leere Leinwand liefert.
    var n44: [u8; 40] = "11 und innerhalb ist wirklich gemalt    "
    report((&n44[0]) as u64, 40, innen15 > 40000, innen15 as i64, 40000)

    // ==================================================================
    // 12. DIE BALKEN WERDEN BEDIENT -- MIT DER ZAHL DAZU
    // ==================================================================
    //
    // Bis zum 22.09.2026 konnte dieser Kasten seine Balken nur MALEN.
    // Ein Rollbalken, den man nicht anfassen kann, ist eine Anzeige;
    // hier wird nachgerechnet, dass er jetzt eine Bedienung ist.
    //
    // DAS BLATT (dasselbe wie oben): Ausschnitt 200 x 300 bei (50, 40),
    // Inhalt 200 x 900, Balken 12 dick. Der senkrechte Balken sitzt
    // also bei x = 50 + 200 - 12 = 238 und ist 288 lang; seine Spur
    // misst 284 (je 2 Punkte Polster), der Schieber 284 * 288/900 =
    // 90.88, sein Weg 284 - 90.88 = 193.12.
    //
    // BEI STELLUNG 500 (Verschiebung 306 von 612) steht der Schieber
    // bei 40 + 2 + 193.12 * 0.5 = 138.56, also auf der Leinwand mit
    // y = 139 und h = 91. Seine MITTE liegt damit bei 139 + 45 = 184.
    viewport.viewport_set_offset(&k, 0.0, 306.0)
    let dirv: u32 = viewport.viewport_bar_hit(&k, 244.0, 184.0)
    var n45: [u8; 40] = "12 der Punkt (244,184) trifft den Balken"
    report((&n45[0]) as u64, 40, dirv == viewport.VP_BAR_V,
        dirv as i64, viewport.VP_BAR_V as i64)
    let dirn: u32 = viewport.viewport_bar_hit(&k, 100.0, 184.0)
    var n46: [u8; 40] = "12 mitten im Inhalt trifft er keinen    "
    report((&n46[0]) as u64, 40, dirn == viewport.VP_BAR_NONE,
        dirn as i64, viewport.VP_BAR_NONE as i64)
    // Der waagerechte Balken liegt unten: y = 40 + 300 - 12 = 328.
    let dirh: u32 = viewport.viewport_bar_hit(&k, 100.0, 330.0)
    var n47: [u8; 40] = "12 und unten der waagerechte            "
    report((&n47[0]) as u64, 40, dirh == viewport.VP_BAR_H,
        dirh as i64, viewport.VP_BAR_H as i64)

    // DER GRIFF SITZT AUF DEM SCHIEBER -- dieselbe Geometrie, die
    // wave2.scrollbar_thumb malt.
    var tt: layout.Rect = viewport.viewport_bar_thumb(&c, &k,
        viewport.VP_BAR_V)
    var n48: [u8; 40] = "12 der Schieber steht bei 139, 91 lang  "
    report((&n48[0]) as u64, 40,
        layout.rect_y(&tt) == 139 && layout.rect_h(&tt) == 91,
        layout.rect_y(&tt), 139)

    // FUENFZIG PUNKTE GEZOGEN. Die Verschiebung waechst um
    // 50 * groesste Verschiebung / Weg des Schiebers
    //   = 50 * 612 / 193.12 = 158.45,
    // und das ist zahlengleich mit 50 * Inhalt / Spur
    //   = 50 * 900 / 284 = 158.4507...
    // (denn Weg = Spur * (Inhalt - Ausschnitt) / Inhalt). Beide Wege
    // werden hier gegeneinander gehalten, in Hundertsteln gerechnet.
    let gedrueckt: bool = viewport.viewport_bar_press(&c, &k, 244.0,
        184.0)
    var n49: [u8; 40] = "12 der Druck auf den Schieber greift    "
    report((&n49[0]) as u64, 40, gedrueckt
        && viewport.viewport_bar_dragging(&k) == viewport.VP_BAR_V,
        viewport.viewport_bar_dragging(&k) as i64,
        viewport.VP_BAR_V as i64)
    let gezogen: bool = viewport.viewport_bar_drag(&c, &k, 244.0, 234.0)
    let nach: i64 = (viewport.viewport_off_y(&k) * 100.0) as i64
    let soll: i64 = ((306.0 + 50.0 * 900.0 / 284.0) * 100.0) as i64
    var n50: [u8; 40] = "12 50 Punkte gezogen: 306 + 50*900/284  "
    report((&n50[0]) as u64, 40, gezogen && nach == soll, nach, soll)
    // Und dasselbe noch einmal als reine Strecke: 15845 Hundertstel.
    var n51: [u8; 40] = "12 die Strecke allein: 158.45 Punkte    "
    report((&n51[0]) as u64, 40, nach - 30600 == 15845, nach - 30600,
        15845)
    // Weitergezogen wird von demselben GRIFF aus gerechnet, nicht vom
    // letzten Ereignis: 75 Punkte sind 75 * 900/284 = 237.67, und
    // nicht 50 + 75 Punkte weit.
    viewport.viewport_bar_drag(&c, &k, 244.0, 259.0)
    let nach2: i64 = (viewport.viewport_off_y(&k) * 100.0) as i64
    var n52: [u8; 40] = "12 75 Punkte: 237.67 vom Griff gerechnet"
    report((&n52[0]) as u64, 40, nach2 - 30600 == 23767, nach2 - 30600,
        23767)
    // Und ueber das Ende hinaus wird auch hier geklemmt: 306 + 316.9
    // waeren 622.9, die groesste Verschiebung ist 612.
    viewport.viewport_bar_drag(&c, &k, 244.0, 284.0)
    let nach3: i64 = viewport.viewport_off_y(&k) as i64
    var n51b: [u8; 40] = "12 und am Ende klemmt auch das Ziehen   "
    report((&n51b[0]) as u64, 40, nach3 == 612, nach3, 612)
    viewport.viewport_bar_release(&k)
    let nichts: bool = viewport.viewport_bar_drag(&c, &k, 244.0, 334.0)
    var n53: [u8; 40] = "12 nach dem Loslassen zieht nichts mehr "
    report((&n53[0]) as u64, 40, !nichts, nichts as i64, 0)

    // DER SPRUNG AUF DER SPUR. Ueber dem Schieber gedrueckt heisst eine
    // Seite zurueck: 306 - 288 = 18.
    viewport.viewport_set_offset(&k, 0.0, 306.0)
    viewport.viewport_bar_press(&c, &k, 244.0, 60.0)
    let seite: i64 = viewport.viewport_off_y(&k) as i64
    var n54: [u8; 40] = "12 Klick ueber dem Schieber: 306-288=18 "
    report((&n54[0]) as u64, 40, seite == 18, seite, 18)
    // Und unter ihm eine Seite vorwaerts -- von 18 aus auf 306.
    viewport.viewport_bar_press(&c, &k, 244.0, 320.0)
    let seite2: i64 = viewport.viewport_off_y(&k) as i64
    var n55: [u8; 40] = "12 Klick darunter: 18+288 = 306         "
    report((&n55[0]) as u64, 40, seite2 == 306, seite2, 306)
    // Ein Sprung auf der Spur ist KEIN Ziehen: wer danach die Maus
    // bewegt, verschiebt nichts.
    var n56: [u8; 40] = "12 der Spursprung faengt kein Ziehen an "
    report((&n56[0]) as u64, 40,
        viewport.viewport_bar_dragging(&k) == viewport.VP_BAR_NONE,
        viewport.viewport_bar_dragging(&k) as i64,
        viewport.VP_BAR_NONE as i64)

    // ================================= 13. DAS POLSTER DES AUSSCHNITTS
    //
    // Es verkleinert NUR den Schnitt und die Trefferflaeche, nicht das
    // Rechteck: Stellung, Balken und Inhaltsmasse bleiben dieselben
    // Zahlen wie ohne Polster. Gemessen wird beides -- dass im Polster
    // nichts mehr getroffen wird UND dass genau ein Punkt weiter drin
    // wieder getroffen wird.
    var pv: viewport.Viewport = viewport.viewport_new(100.0, 50.0,
        200.0, 100.0, 200.0, 400.0)
    viewport.viewport_set_bar(&pv, 0)
    var pcx: f64 = 0.0
    var pcy: f64 = 0.0
    var n60: [u8; 40] = "13 ohne Polster trifft die Ecke (100,50)"
    report((&n60[0]) as u64, 40,
        viewport.viewport_hit(&pv, 100.0, 50.0, &pcx, &pcy),
        viewport.viewport_hit(&pv, 100.0, 50.0, &pcx, &pcy) as i64, 1)
    viewport.viewport_set_inset(&pv, 10.0)
    var n61: [u8; 40] = "13 das Polster steht auf 10             "
    report((&n61[0]) as u64, 40,
        viewport.viewport_inset(&pv) as i64 == 10,
        viewport.viewport_inset(&pv) as i64, 10)
    var n62: [u8; 40] = "13 mit Polster trifft die Ecke nicht    "
    report((&n62[0]) as u64, 40,
        !viewport.viewport_hit(&pv, 100.0, 50.0, &pcx, &pcy),
        viewport.viewport_hit(&pv, 100.0, 50.0, &pcx, &pcy) as i64, 0)
    var n63: [u8; 40] = "13 (110,60) liegt wieder im Ausschnitt  "
    report((&n63[0]) as u64, 40,
        viewport.viewport_hit(&pv, 110.0, 60.0, &pcx, &pcy),
        viewport.viewport_hit(&pv, 110.0, 60.0, &pcx, &pcy) as i64, 1)
    // Die andere Kante ebenso: 100+200-10 = 290 ist schon Polster.
    var n64: [u8; 40] = "13 und (290,60) liegt schon im Polster  "
    report((&n64[0]) as u64, 40,
        !viewport.viewport_hit(&pv, 290.0, 60.0, &pcx, &pcy),
        viewport.viewport_hit(&pv, 290.0, 60.0, &pcx, &pcy) as i64, 0)
    // Am Rechteck aendert das Polster nichts -- sonst waere es ein
    // zweiter Ort fuer die Groesse des Kastens.
    var n65: [u8; 40] = "13 das Rechteck bleibt 200 breit        "
    report((&n65[0]) as u64, 40, viewport.viewport_w(&pv) as i64 == 200,
        viewport.viewport_w(&pv) as i64, 200)
    // Ein negatives Polster gibt es nicht.
    viewport.viewport_set_inset(&pv, -5.0)
    var n66: [u8; 40] = "13 ein negatives Polster wird zu 0      "
    report((&n66[0]) as u64, 40,
        viewport.viewport_inset(&pv) as i64 == 0,
        viewport.viewport_inset(&pv) as i64, 0)

    painter.painter_free(&z)
    canvas.canvas_free(&cv)

    var t: rt.Buf = rt.buf_new()
    rt.buf_push(&t, 10 as u8)
    if G_ERRORS > 0 {
        var f: [u8; 26] = "VIEWPORT IS NOT IN ORDER.\n"
        rt.buf_push_bytes(&t, (&f[0]) as u64, 26)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
        return 1
    }
    var o: [u8; 17] = "VIEWPORT PASSED.\n"
    rt.buf_push_bytes(&t, (&o[0]) as u64, 17)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 0
}
