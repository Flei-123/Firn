// SPDX-License-Identifier: MPL-2.0
// tools/fui/weight_main.fi -- weight faces in the painter (fUi W18, r252).
//
//     weight <regular.ttf> <semibold.ttf>
//
// A run of weight 600 takes the real SemiBold face (its advances, its glyphs);
// 700 on that face is not thickened again; with no face the faux bold stays.
import std.rt
import paint.canvas
import font.metrics
import font.ttf
import fui.painter

const FONTSET_BYTES: usize = 4096
const CW: usize = 400
const CH: usize = 80
const BG: u32 = 0xff202020
static mut FAILS: usize = 0

fn expect(id: i64, got: i64, want: i64) {
    if got != want {
        FAILS = FAILS + 1
        var t: rt.Buf = rt.buf_new()
        var a: [u8; 11] = "FAIL check "
        rt.buf_push_bytes(&t, (&a[0]) as u64, 11)
        rt.buf_push_dec_i64(&t, id)
        var b: [u8; 6] = " got  "
        rt.buf_push_bytes(&t, (&b[0]) as u64, 6)
        rt.buf_push_dec_i64(&t, got)
        var c: [u8; 6] = " want "
        rt.buf_push_bytes(&t, (&c[0]) as u64, 6)
        rt.buf_push_dec_i64(&t, want)
        rt.buf_push(&t, 10 as u8)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
    }
}

fn load_set(path: u64) -> u64 {
    var fbuf: rt.Buf = rt.buf_new()
    if !rt.read_file(path, &fbuf) {
        return 0
    }
    let fsp: *mut metrics.FontSet = rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    *fsp = metrics.fontset_new()
    if !metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
        return 0
    }
    return fsp as u64
}

// The pixels that differ from the background in columns x0..x1.
fn ink(cv: *mut canvas.Canvas, x0: usize, x1: usize) -> i64 {
    var n: i64 = 0
    var x: usize = x0
    while x < x1 && x < CW {
        var y: usize = 0
        while y < CH {
            if canvas.canvas_get(cv, x, y) != BG {
                n = n + 1
            }
            y = y + 1
        }
        x = x + 1
    }
    return n
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 2
    }
    let m: u64 = load_set(rt.arg_ptr(start, 1))
    let f: u64 = load_set(rt.arg_ptr(start, 2))
    if m == 0 || f == 0 {
        return 3
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, CW, CH) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, CW, CH) {
        return 5
    }
    painter.painter_set_font(&z, m)
    var s: [u8; 12] = "Hamburgefons"
    let sp: u64 = (&s[0]) as u64
    var r4: painter.TextRun = painter.run_new(24.0)
    var r6: painter.TextRun = painter.run_set_weight(painter.run_new(24.0), 600)
    var r7: painter.TextRun = painter.run_set_weight(painter.run_new(24.0), 700)
    // 1. no faces: width independent of weight (faux bold does not move the pen)
    let w4: f64 = painter.run_width(&z, &r4, sp, 12)
    expect(1, // no face: same width
        (painter.run_width(&z, &r6, sp, 12) == w4) as i64, 1)
    canvas.canvas_clear(&cv, BG)
    painter.run_draw(&z, &r7, 10.0, 50.0, 380.0, 0xffffffff as u32, sp, 12, 0 as u32)
    let ink_faux: i64 = ink(&cv, 0, CW)
    // 2. faces set
    painter.painter_set_weight_face(&z, 0, 600, f)
    expect(2, // hash set
        (painter.fb_hash(&z) != 0) as i64, 1)
    var wo: usize = 0
    expect(3, // 600 picks the face
        (painter.face_sel(&z, &r6, &wo) == f) as i64, 1)
    expect(4, // face weight
        wo as i64, 600)
    expect(5, // 400 stays on the main font
        (painter.face_sel(&z, &r4, &wo) == m) as i64, 1)
    expect(6, // 700 picks the nearest
        (painter.face_sel(&z, &r7, &wo) == f) as i64, 1)
    // widths come from the face
    var want: f64 = 0.0
    var i: usize = 0
    while i < 12 {
        let cp: u32 = s[i] as u32
        var nx: u32 = 0 as u32
        if i + 1 < 12 {
            nx = s[i + 1] as u32
        }
        want = want + metrics.fm_advance(f, 24.0, cp) + metrics.fm_kern(f, 24.0, cp, nx)
        i = i + 1
    }
    let w6: f64 = painter.run_width(&z, &r6, sp, 12)
    expect(7, // width = the SemiBold advances
        (w6 > want - 0.05 && w6 < want + 0.05) as i64, 1)
    expect(8, // wider than regular
        (w6 > w4 + 1.0) as i64, 1)
    expect(9, // 400 unchanged
        (painter.run_width(&z, &r4, sp, 12) == w4) as i64, 1)
    // 3. pictures
    canvas.canvas_clear(&cv, BG)
    painter.run_draw(&z, &r6, 10.0, 50.0, 380.0, 0xffffffff as u32, sp, 12, 0 as u32)
    let ink6: i64 = ink(&cv, 0, CW)
    canvas.canvas_clear(&cv, BG)
    painter.run_draw(&z, &r7, 10.0, 50.0, 380.0, 0xffffffff as u32, sp, 12, 0 as u32)
    let ink7: i64 = ink(&cv, 0, CW)
    canvas.canvas_clear(&cv, BG)
    painter.run_draw(&z, &r4, 10.0, 50.0, 380.0, 0xffffffff as u32, sp, 12, 0 as u32)
    let ink4: i64 = ink(&cv, 0, CW)
    expect(10, // semibold differs from regular
        (ink6 != ink4) as i64, 1)
    expect(11, // 700 on the 600 face: no extra thickening
        (ink7 == ink6) as i64, 1)
    expect(12, // faux bold on a lone regular face is thicker than the real face
        (ink_faux != ink7) as i64, 1)
    var ok: [u8; 20] = "weight checks done\n\n"
    rt.write_everything(1, (&ok[0]) as u64, 19)
    if FAILS > 0 {
        return 1
    }
    return 0
}
