import fui.app
import fui.webtheme
import fui.mobile
import fui.lay
import fui.a11y
import fui.appctl
import fui.safeout

static mut BAD: usize = 0
static mut TOTAL: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    TOTAL = TOTAL + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn num(tag: str, v: i64) {
    say(tag)
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
}

// two colours within `tol` per channel
fn near_rgb(a: u32, b: u32, tol: i64) -> bool {
    var s: u32 = 0
    while s <= 16 {
        let x: i64 = ((a >> s) & 255 as u32) as i64
        let y: i64 = ((b >> s) & 255 as u32) as i64
        var d: i64 = x - y
        if d < 0 { d = 0 - d }
        if d > tol { return false }
        s = s + 8
    }
    return true
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    fuiwirt.host_bind(app.app_host(a))
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

static mut APP: u64 = 0
static mut HITS: usize = 0
static mut LAST: usize = 99
static mut LAST_KIND: usize = 0

fn on_tile(a: *mut app.App, arg: usize) {
    HITS = HITS + 1
    LAST = arg
    LAST_KIND = 1
}

fn on_bar(a: *mut app.App, arg: usize) {
    HITS = HITS + 1
    LAST = arg
    LAST_KIND = 2
}

fn on_chip(a: *mut app.App, arg: usize) {
    HITS = HITS + 1
    LAST = arg
    LAST_KIND = 3
}

fn on_close(a: *mut app.App, arg: usize) {
    HITS = HITS + 1
    LAST = arg
    LAST_KIND = 4
}

fn on_seg(a: *mut app.App, arg: usize) {
    HITS = HITS + 1
    LAST = arg
    LAST_KIND = 5
}

fn on_nav(a: *mut app.App, arg: usize) {
    HITS = HITS + 1
    LAST = arg
    LAST_KIND = 6
}

fn click_node(a: *mut app.App, n: usize) {
    let sc: *mut scene.Scene = app.app_scene(a)
    let x: f64 = scene.node_x(sc, n) + scene.node_w(sc, n) * 0.5
    let y: f64 = scene.node_y(sc, n) + scene.node_h(sc, n) * 0.5
    let w: *mut fuiwirt.Host = app.app_host(a)
    let m: u32 = fuiwirt.host_pointer_move(w, x, y)
    let d: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let u: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
    let i: usize = fuiwirt.host_take_activated(w)
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
}

fn absd(x: i64, y: i64) -> i64 {
    if x > y { return x - y }
    return y - x
}

fn nx(a: *mut app.App, n: usize) -> i64 { return scene.node_x(app.app_scene(a), n) as i64 }
fn ny(a: *mut app.App, n: usize) -> i64 { return scene.node_y(app.app_scene(a), n) as i64 }
fn nw(a: *mut app.App, n: usize) -> i64 { return scene.node_w(app.app_scene(a), n) as i64 }
fn nh(a: *mut app.App, n: usize) -> i64 { return scene.node_h(app.app_scene(a), n) as i64 }

struct Ids {
    bar: usize,
    tile0: usize,
    tile1: usize,
    tile2: usize,
    chips: usize,
    chip0: usize,
    chip1: usize,
    chip2: usize,
    chip3: usize,
    chip4: usize,
    chipx: usize,
    seg: usize,
    seg0: usize,
    seg1: usize,
    seg2: usize,
    field: usize,
    area: usize,
    pass: usize,
    bub_me: usize,
    bub_bot: usize,
    pill_ok: usize,
    pill_warn: usize,
    empty: usize,
    nav: usize,
    nav0: usize,
    nav1: usize,
    nav2: usize,
    sec: usize,
    cardn: usize,
    skel: usize,
    spin: usize,
}

// The screen of the picture: every component once.
fn build(a: *mut app.App, ids: *mut Ids, rich: bool) {
    mobile.page(a)
    (*ids).bar = mobile.app_bar(a, "Chats", "menu", "plus", on_bar)
    (*ids).sec = mobile.section(a, "Today")
    (*ids).cardn = mobile.card(a)
    (*ids).tile0 = mobile.list_tile(a, "message-square", "Project plan", "Last message 12:04", "2", on_tile)
    (*ids).tile1 = mobile.list_tile(a, "folder", "Files", "", "", on_tile)
    (*ids).tile2 = mobile.list_tile(a, "settings", "A very long title that has to wrap onto a second line because the phone is narrow", "Subtitle", "", on_tile)
    app.end(a)
    app.end(a)
    (*ids).chips = mobile.chip_row(a)
    (*ids).chip0 = mobile.chip(a, "All", true, on_chip)
    (*ids).chip1 = mobile.chip(a, "Unread", false, on_chip)
    (*ids).chip2 = mobile.chip(a, "Projects", false, on_chip)
    (*ids).chip3 = mobile.chip(a, "Archive of old things", false, on_chip)
    (*ids).chip4 = mobile.chip(a, "Starred", false, on_chip)
    (*ids).chipx = mobile.chip_closable(a, "Closable", false, on_chip, on_close)
    app.end(a)
    (*ids).seg = mobile.segmented(a, 0, on_seg)
    (*ids).seg0 = mobile.segment(a, "Day")
    (*ids).seg1 = mobile.segment(a, "Week")
    (*ids).seg2 = mobile.segment(a, "Month")
    app.end(a)
    (*ids).field = mobile.text_field(a, "E-mail", "name@example.com", false)
    (*ids).pass = mobile.text_field(a, "Password", "secret", true)
    (*ids).area = mobile.text_area(a, "Message", "Write...", 3, 6)
    (*ids).bub_me = mobile.bubble(a, "Hello, can you summarise the plan for tomorrow in three short points please?", true)
    (*ids).bub_bot = mobile.bubble(a, "Sure. 1. Ship the toolkit. 2. Review the golden images. 3. Talk to the team.", false)
    let pr: usize = lay.hbox(a)
    lay.gap(a, pr, 8, 0)
    (*ids).pill_ok = mobile.pill(a, "online", mobile.PILL_OK)
    (*ids).pill_warn = mobile.pill(a, "failed", mobile.PILL_WARN)
    let pd: usize = mobile.pill(a, "idle", mobile.PILL_DIM)
    app.end(a)
    if rich {
        (*ids).empty = mobile.empty_state(a, "inbox", "Nothing here", "New messages will show up in this list.")
    }
    let sp: usize = lay.spacer_grow(a)
    (*ids).nav = mobile.bottom_nav(a, 0, on_nav)
    (*ids).nav0 = mobile.nav_item(a, "message-square", "Chats")
    (*ids).nav1 = mobile.nav_item(a, "folder", "Files")
    (*ids).nav2 = mobile.nav_item(a, "settings", "Settings")
    app.end(a)
    mobile.nav_badge(a, (*ids).nav, 0, "3")
    mobile.sync(a)
}

fn checks(a: *mut app.App, s: *mut Surface, ids: *mut Ids, w: i64, h: i64) {
    let sc: *mut scene.Scene = app.app_scene(a)
    settle(a, s)
    mobile.sync(a)
    settle(a, s)
    say("-- rules\n")
    check(mobile.is_installed(a), "install ran")
    check(mobile.rules_used() <= 24, "components use at most 24 style rules")
    check(sheet.sheet_count(&(*a).sh) + 12 <= 64, "webtheme + mobile + 12 id rules stay under the 64 of a window")
    check(sheet.sheet_rule_overflow(&(*a).sh) == 0, "no rule rejected")
    say("-- app bar\n")
    check(nw(a, (*ids).bar) == w && nx(a, (*ids).bar) == 0, "app bar spans the full width")
    check(nh(a, (*ids).bar) >= 56 && nh(a, (*ids).bar) <= 64, "app bar is 56 high")
    check(ny(a, (*ids).bar) == 0, "app bar sits at the top")
    say("-- card + list tiles\n")
    check(nw(a, (*ids).tile0) > w - 40 && nw(a, (*ids).tile0) <= w, "tile spans its card")
    check(nh(a, (*ids).tile0) >= 56, "tile is at least 56 high")
    check(nh(a, (*ids).tile1) >= 56, "tile without subtitle is at least 56 high")
    check(nh(a, (*ids).tile2) > nh(a, (*ids).tile0), "long title wraps: that tile is taller")
    check(ny(a, (*ids).tile1) > ny(a, (*ids).tile0) + nh(a, (*ids).tile0) - 1, "tiles stand one below the other")
    check(nx(a, (*ids).cardn) >= 0 && nw(a, (*ids).cardn) <= w, "card stays inside the window")
    check(scene.node_has_class(sc, (*ids).cardn, webtheme.K_CARD), "card carries the webtheme card class")
    HITS = 0
    click_node(a, (*ids).tile1)
    check(HITS == 1 && LAST == (*ids).tile1 && LAST_KIND == 1, "tapping a tile calls back with the tile node")
    click_node(a, (*ids).tile0)
    check(HITS == 2 && LAST == (*ids).tile0, "second tile calls back with its own node")
    say("-- bar buttons\n")
    HITS = 0
    let b0: usize = scene.scene_first_child(sc, (*ids).bar)
    var btn: usize = scene.scene_first_child(sc, (*ids).bar)
    var k: usize = 0
    var left: usize = mobile.NONE
    var right: usize = mobile.NONE
    while btn != scene.SCENE_NONE {
        if scene.node_has_class(sc, btn, mobile.K_PRESS) {
            if left == mobile.NONE { left = btn } else { right = btn }
        }
        btn = scene.scene_next_sibling(sc, btn)
    }
    check(left != mobile.NONE && right != mobile.NONE, "bar has a left and a right button")
    check(nw(a, left) == 44 && nh(a, left) == 44, "bar button is 44 x 44")
    click_node(a, left)
    check(HITS == 1 && LAST == 0 && LAST_KIND == 2, "left bar button calls back with 0")
    click_node(a, right)
    check(HITS == 2 && LAST == 1, "right bar button calls back with 1")
    check(nx(a, right) + nw(a, right) <= w && nx(a, right) > w / 2, "right button sits at the right edge")
    say("-- chips\n")
    check(ny(a, (*ids).chip4) > ny(a, (*ids).chip0), "chip row wraps onto a second line when the chips do not fit")
    check(nx(a, (*ids).chip1) >= nx(a, (*ids).chip0) + nw(a, (*ids).chip0) + 8 - 1, "8 pt between chips")
    check(nh(a, (*ids).chip0) >= 36 && nh(a, (*ids).chip0) <= 40, "chip is 36 high")
    check(mobile.chip_selected(a, (*ids).chip0) && !mobile.chip_selected(a, (*ids).chip1), "first chip selected")
    mobile.set_chip_selected(a, (*ids).chip1, true)
    check(mobile.chip_selected(a, (*ids).chip1), "set_chip_selected")
    HITS = 0
    let c2: usize = scene.scene_first_child(sc, (*ids).chip2)
    click_node(a, c2)
    check(HITS == 1 && LAST == 2 && LAST_KIND == 3, "tapping a chip calls back with its index")
    var closer: usize = mobile.NONE
    var cc: usize = scene.scene_first_child(sc, (*ids).chipx)
    while cc != scene.SCENE_NONE {
        closer = cc
        cc = scene.scene_next_sibling(sc, cc)
    }
    click_node(a, closer)
    check(LAST_KIND == 4 && LAST == 5, "closing a chip calls back with its index")
    say("-- segmented\n")
    check(mobile.selected(a, (*ids).seg) == 0, "segmented starts on 0")
    check(scene.node_has_class(sc, (*ids).seg0, mobile.K_SEG_ON) && !scene.node_has_class(sc, (*ids).seg1, mobile.K_SEG_ON), "segment 0 is raised")
    check(absd(nw(a, (*ids).seg0), nw(a, (*ids).seg1)) <= 2 && absd(nw(a, (*ids).seg1), nw(a, (*ids).seg2)) <= 2, "segments have equal width (whole pixels: 2 apart at most)")
    check(nh(a, (*ids).seg0) >= 38, "segment is a 44 pt target (38 inside the track)")
    HITS = 0
    click_node(a, (*ids).seg1)
    check(HITS == 1 && LAST == 1 && LAST_KIND == 5, "tapping a segment calls on_change with its index")
    check(mobile.selected(a, (*ids).seg) == 1, "selected() follows")
    check(scene.node_has_class(sc, (*ids).seg1, mobile.K_SEG_ON) && !scene.node_has_class(sc, (*ids).seg0, mobile.K_SEG_ON), "raised class moved to segment 1")
    mobile.select(a, (*ids).seg, 2)
    check(mobile.selected(a, (*ids).seg) == 2 && scene.node_has_class(sc, (*ids).seg2, mobile.K_SEG_ON) && HITS == 1, "select() sets by program, no callback")
    say("-- text fields\n")
    check(nw(a, (*ids).field) > w - 40, "text field spans the page (not the stock 240)")
    check(nh(a, (*ids).field) >= 44, "text field is at least 44 high")
    check(nw(a, (*ids).pass) == nw(a, (*ids).field), "two fields have the same width")
    check(nw(a, (*ids).area) == nw(a, (*ids).field), "text area has the width of a field")
    check(nh(a, (*ids).area) > nh(a, (*ids).field), "text area is taller than a field")
    let en: usize = mobile.field_error_node(a, (*ids).field)
    check(en != mobile.NONE && scene.node_hidden(sc, en), "error line is hidden until used")
    mobile.field_error(a, (*ids).field, "Not an e-mail address")
    check(!scene.node_hidden(sc, en), "field_error shows the line")
    mobile.field_error(a, (*ids).field, "")
    check(scene.node_hidden(sc, en), "empty message hides it again")
    check(mobile.text_area_rows_of(a, (*ids).area) == 3, "empty text area has rows_min rows")
    app.set_text(a, (*ids).area, "1\n2\n3\n4\n5\n6\n7\n8\n9")
    settle(a, s)
    check(mobile.text_area_rows_of(a, (*ids).area) == 6, "nine lines: capped at rows_max")
    app.set_text(a, (*ids).area, "")
    say("-- bubbles\n")
    let bm: usize = scene.scene_parent(sc, (*ids).bub_me)
    check(nw(a, (*ids).bub_me) <= (w * 82) / 100 + 1, "bubble is at most 82% of the page")
    check(nw(a, (*ids).bub_bot) <= (w * 82) / 100 + 1, "assistant bubble is at most 82% too")
    check(nx(a, (*ids).bub_me) + nw(a, (*ids).bub_me) >= w - 12, "my bubble hugs the right edge")
    check(nx(a, (*ids).bub_bot) <= 12, "assistant bubble hugs the left edge")
    check(scene.node_has_class(sc, (*ids).bub_me, webtheme.K_BUBBLE) && !scene.node_has_class(sc, (*ids).bub_bot, webtheme.K_BUBBLE), "mine = webtheme gradient bubble, theirs = panel")
    check(nh(a, (*ids).bub_me) > 40, "long bubble text wraps (taller than one line)")
    say("-- pills\n")
    check(scene.node_has_class(sc, (*ids).pill_ok, webtheme.K_PILL) && scene.node_has_class(sc, (*ids).pill_ok, mobile.K_PILL_OK), "ok pill")
    check(scene.node_has_class(sc, (*ids).pill_warn, mobile.K_PILL_WARN), "warn pill")
    check(nh(a, (*ids).pill_ok) >= 20 && nh(a, (*ids).pill_ok) <= 28, "pill is about 24 high")
    say("-- bottom nav\n")
    check(ny(a, (*ids).nav) + nh(a, (*ids).nav) == h, "bottom nav sits at the bottom of the window")
    check(nw(a, (*ids).nav) == w, "bottom nav spans the full width")
    check(nw(a, (*ids).nav0) == nw(a, (*ids).nav1) && nw(a, (*ids).nav1) == nw(a, (*ids).nav2), "nav items have equal width")
    check(nh(a, (*ids).nav0) >= 44, "nav item is a 44 pt target")
    check(mobile.nav_item_count(a, (*ids).nav) == 3, "three items")
    HITS = 0
    click_node(a, (*ids).nav2)
    check(HITS == 1 && LAST == 2 && LAST_KIND == 6, "nav tap calls on_change with the index")
    check(mobile.selected(a, (*ids).nav) == 2 && scene.node_has_class(sc, (*ids).nav2, mobile.K_NAV_ON) && !scene.node_has_class(sc, (*ids).nav0, mobile.K_NAV_ON), "chosen item is in the accent class")
    say("-- accessibility\n")
    check(app.audit(a) == 0, "audit: no unnamed control")
    check(a11y.a11y_role(sc, &(*a).ax, (*ids).nav0) == a11y.ROLE_TAB, "nav item is a tab")
    check(a11y.a11y_role(sc, &(*a).ax, (*ids).tile0) == a11y.ROLE_BUTTON, "tile is a button")
    check(a11y.a11y_role(sc, &(*a).ax, (*ids).seg) == a11y.ROLE_GROUP, "segmented is a group")
}

fn safe_area_checks(a: *mut app.App, s: *mut Surface, ids: *mut Ids, h: i64) {
    say("-- safe area\n")
    let sc: *mut scene.Scene = app.app_scene(a)
    let h0: i64 = nh(a, (*ids).bar)
    let n0: i64 = nh(a, (*ids).nav)
    app.set_insets(a, 0.0, 48.0, 0.0, 34.0)
    mobile.sync(a)
    settle(a, s)
    check(nh(a, (*ids).bar) >= h0 + 40, "top inset makes the app bar taller (status bar)")
    check(nh(a, (*ids).nav) >= n0 + 30, "bottom inset makes the nav taller (gesture bar)")
    check(ny(a, (*ids).nav) + nh(a, (*ids).nav) == h, "nav still ends at the window bottom")
    app.set_insets(a, 0.0, 0.0, 0.0, 0.0)
    mobile.sync(a)
    settle(a, s)
    check(nh(a, (*ids).bar) == h0 && nh(a, (*ids).nav) == n0, "insets 0: bars back to their size")
}

fn theme_checks(a: *mut app.App, s: *mut Surface, ids: *mut Ids) {
    say("-- theme switch\n")
    let sc: *mut scene.Scene = app.app_scene(a)
    let r0: usize = sheet.sheet_count(&(*a).sh)
    webtheme.set_mode(a, webtheme.MODE_LIGHT)
    mobile.sync(a)
    settle(a, s)
    check(!webtheme.is_dark() && sheet.sheet_count(&(*a).sh) == r0, "light mode adds no rules")
    check(mobile.is_installed(a), "install survives a theme switch")
    let m: *mut theme.Theme = app.app_theme(a)
    let f: *mut theme.Colors = theme.theme_colors(m)
    check((*f).base != 0x0c0e1f, "light colours are not the dark page")
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("mobile: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let W: usize = 360
    let H: usize = 1120
    let a: *mut app.App = app.window("Mobile components", W, H)
    APP = a as u64
    fuiwirt.host_bind(app.app_host(a))
    webtheme.install(a, webtheme.MODE_DARK)
    let s: *mut Surface = surface_for(a, W, H)
    if s as u64 == 0 {
        say("mobile: no surface\n")
        return 9
    }
    let ids: *mut Ids = rt.heap_alloc(1024) as *mut Ids
    build(a, ids, false)
    checks(a, s, ids, W as i64, H as i64)
    safe_area_checks(a, s, ids, H as i64)
    save(&(*s).cv, dir, "appmobile_components-dark.png")
    theme_checks(a, s, ids)
    save(&(*s).cv, dir, "appmobile_components-light.png")

    say("\n")
    num("checks: ", TOTAL as i64)
    num("wrong: ", BAD as i64)
    if BAD == 0 {
        say("MOBILE PASSED\n")
        return 0
    }
    say("MOBILE FAILED\n")
    return 1
}
