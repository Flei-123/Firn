// tools/fui/gpuvk_main.fi -- fUi on Vulkan, smoke test (W18-F2): clear + rect through lib/fui/gpu.fi on the Vulkan table.
//   gpuvk_main        exit 0 = ok, 4 = no Vulkan (SKIP), 3 = wrong pixels
import std.rt
import std.io
import paint.canvas
import paint.gl
import fui.gpu
import fui.gpu_vk

fn px(cv: *mut canvas.Canvas, x: usize, y: usize) -> u32 {
    return rt.ld32(canvas.canvas_pixels(cv) as u64, y * canvas.canvas_width(cv) + x)
}

fn main() -> i32 {
    var api: gl.GlApi = gl.gl_api_new()
    if !gpu_vk.vkgl_api(&api) {
        io.fmt_print(f"gpuvk: no vulkan (step={gpu_vk.vkgl_step()})\n")
        return 4
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, 64, 48) {
        return 3
    }
    var g: gpu.Gpu = gpu.gpu_new()
    if !gpu.gpu_open(&g, &api) {
        io.print("gpuvk: gpu_open failed\n")
        return 3
    }
    if !gpu.gpu_attach(&g, &cv) {
        io.print("gpuvk: gpu_attach failed\n")
        return 3
    }
    gpu.gpu_clear(&g, 0xFF204060)
    gpu.gpu_rect(&g, 8.0, 8.0, 24.0, 20.0, 0xFFFF0000)
    gpu.gpu_read(&g, 0, 0, 64, 48, canvas.canvas_pixels(&cv) as u64, 64 * 4)
    let a: u32 = px(&cv, 2, 2)
    let b: u32 = px(&cv, 10, 10)
    io.fmt_print(f"gpuvk: bg={a} rect={b} cpu={gpu_vk.vkgl_is_cpu()}\n")
    var st: [u64; 4] = [0; 4]
    gpu_vk.vkgl_stats(&st[0])
    io.fmt_print(f"gpuvk: draws={st[0]} submits={st[1]} uploads={st[2]} readbacks={st[3]}\n")
    return 0
}
