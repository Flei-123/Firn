// SPDX-License-Identifier: MPL-2.0
// tools/fui/pointers_main.fi -- THE POINTER FEED OF A WINDOW, CHECKED WITH
// SYNTHETIC ANDROID MOTION-EVENT STREAMS (lib/window/pointers.fi, r111).
//
// Windowless. Every system event is the same arrays Android's
// AMotionEvent_* calls would give: action, action index, finger count and
// per finger id / x / y / type.
//   1. off by default: nothing is recorded
//   2. one finger: down, batched moves, up; primary; positions
//   3. two fingers: POINTER_DOWN by index, batched MOVE gives one record
//      per finger that moved (none for one that stood still), POINTER_UP
//      of the FIRST finger (the index of the second one changes, its id
//      does not)
//   4. lost UP: a DOWN for a known id cancels the old one; ACTION_DOWN
//      with fingers still marked down cancels them
//   5. CANCEL ends every finger; a mouse and a finger are both primary
//   6. the ring: nobody takes records -> the oldest go, the count is kept
//   7. tool types and the numbers shared with fui.event
import std.rt
import window.pointers
import fui.event

static mut G_ERRORS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_int(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn eq(name: str, got: i64, want: i64) {
    say("  ")
    say(name)
    var k: usize = name.n
    while k < 60 {
        say(" ")
        k = k + 1
    }
    if got == want {
        say("OK    got ")
    } else {
        say("WRONG got ")
        G_ERRORS = G_ERRORS + 1
    }
    say_int(got)
    say(" want ")
    say_int(want)
    say("\n")
}

struct Ev {
    ids: [i32; 10],
    xs: [f64; 10],
    ys: [f64; 10],
    ty: [u32; 10],
}

fn ev_new() -> Ev {
    return Ev { ids: [0; 10], xs: [0.0; 10], ys: [0.0; 10], ty: [2; 10] }
}

fn set(e: *mut Ev, k: usize, id: i32, x: f64, y: f64) {
    (*e).ids[k] = id
    (*e).xs[k] = x
    (*e).ys[k] = y
}

fn send(q: *mut pointers.Pointers, e: *mut Ev, act: u32, idx: usize,
    n: usize, t: i64) {
    pointers.pointers_motion(q, act, idx, n, &(*e).ids, &(*e).xs, &(*e).ys,
        &(*e).ty, t)
}

// Take everything: returns how many records were there; the last one's
// fields land in the globals.
static mut G_N: i64 = 0
static mut G_KINDS: [u32; 64] = [0; 64]
static mut G_IDS: [u32; 64] = [0; 64]
static mut G_PRIM: [u32; 64] = [0; 64]
static mut G_X: [f64; 64] = [0.0; 64]
static mut G_T: [i64; 64] = [0; 64]
static mut G_TYPE: [u32; 64] = [0; 64]

fn drain(q: *mut pointers.Pointers) {
    G_N = 0
    var p: pointers.Pointer = pointers.ptr_blank()
    while pointers.pointers_next(q, &p) {
        if G_N < 64 {
            let k: usize = G_N as usize
            G_KINDS[k] = p.kind
            G_IDS[k] = p.id
            G_PRIM[k] = p.primary
            G_X[k] = p.x
            G_T[k] = p.t
            G_TYPE[k] = p.ptype
        }
        G_N = G_N + 1
    }
}

fn kind(k: usize) -> i64 { return G_KINDS[k] as i64 }
fn id(k: usize) -> i64 { return G_IDS[k] as i64 }

fn main(start: u64) -> i32 {
    let q: *mut pointers.Pointers = rt.heap_alloc(65536) as *mut pointers.Pointers
    *q = pointers.pointers_new()
    var e: Ev = ev_new()

    say("== 1. off by default\n")
    set(&e, 0, 0, 10.0, 20.0)
    send(q, &e, pointers.MA_DOWN, 0, 1, 100)
    drain(q)
    eq("nothing recorded while off", G_N, 0)
    eq("not enabled", pointers.pointers_enabled(q) as i64, 0)
    pointers.pointers_enable(q, true)
    eq("enabled", pointers.pointers_enabled(q) as i64, 1)

    say("== 2. one finger\n")
    set(&e, 0, 4, 10.0, 20.0)
    send(q, &e, pointers.MA_DOWN, 0, 1, 100)
    set(&e, 0, 4, 12.0, 20.0)
    send(q, &e, pointers.MA_MOVE, 0, 1, 116)
    send(q, &e, pointers.MA_MOVE, 0, 1, 120)
    set(&e, 0, 4, 30.0, 25.0)
    send(q, &e, pointers.MA_UP, 0, 1, 132)
    drain(q)
    eq("down, move, (same place: none), up = 3 records", G_N, 3)
    eq("kind 0 is DOWN", kind(0), pointers.PK_DOWN as i64)
    eq("kind 1 is MOVE", kind(1), pointers.PK_MOVE as i64)
    eq("kind 2 is UP", kind(2), pointers.PK_UP as i64)
    eq("the id is the system's (4)", id(0), 4)
    eq("first finger is primary", G_PRIM[0] as i64, 1)
    eq("a finger is touch", G_TYPE[0] as i64, pointers.PTR_TOUCH as i64)
    eq("the move is at 12", G_X[1] as i64, 12)
    eq("the up carries its own position (30)", G_X[2] as i64, 30)
    eq("times are kept (132)", G_T[2], 132)
    eq("nothing down afterwards", pointers.pointers_down(q) as i64, 0)

    say("== 3. two fingers, the first one lifts first\n")
    set(&e, 0, 0, 100.0, 100.0)
    send(q, &e, pointers.MA_DOWN, 0, 1, 1000)
    set(&e, 0, 0, 100.0, 100.0)
    set(&e, 1, 5, 300.0, 100.0)
    send(q, &e, pointers.MA_POINTER_DOWN, 1, 2, 1010)
    drain(q)
    eq("down (id 0), down (id 5) = 2 records", G_N, 2)
    eq("second finger has id 5", id(1), 5)
    eq("second finger is NOT primary", G_PRIM[1] as i64, 0)
    eq("two down", pointers.pointers_down(q) as i64, 2)
    // batched MOVE: both moved
    set(&e, 0, 0, 90.0, 100.0)
    set(&e, 1, 5, 310.0, 100.0)
    send(q, &e, pointers.MA_MOVE, 0, 2, 1020)
    drain(q)
    eq("batched MOVE of two fingers = 2 records", G_N, 2)
    eq("one per finger: ids 0 and 5", id(0) * 10 + id(1), 5)
    // batched MOVE: only the second moved
    set(&e, 1, 5, 320.0, 100.0)
    send(q, &e, pointers.MA_MOVE, 0, 2, 1030)
    drain(q)
    eq("only the finger that moved gives a record", G_N, 1)
    eq("it is id 5", id(0), 5)
    // the first finger lifts: ACTION_POINTER_UP index 0; the event still
    // lists both fingers, and the second one moved at the same time
    set(&e, 0, 0, 85.0, 100.0)
    set(&e, 1, 5, 330.0, 100.0)
    send(q, &e, pointers.MA_POINTER_UP, 0, 2, 1040)
    drain(q)
    eq("move of the other, then up of id 0 = 2 records", G_N, 2)
    eq("the other finger's move comes first", kind(0) * 10 + kind(1),
        (pointers.PK_MOVE as i64) * 10 + pointers.PK_UP as i64)
    eq("the move is id 5", id(0), 5)
    eq("the up is id 0", id(1), 0)
    eq("one down", pointers.pointers_down(q) as i64, 1)
    // now id 5 is at INDEX 0
    set(&e, 0, 5, 340.0, 100.0)
    send(q, &e, pointers.MA_MOVE, 0, 1, 1050)
    drain(q)
    eq("the id survives the index change", id(0), 5)
    send(q, &e, pointers.MA_UP, 0, 1, 1060)
    drain(q)
    eq("last up: 1 record", G_N, 1)
    eq("it is id 5, an UP", id(0) * 10 + kind(0), 50 + pointers.PK_UP as i64)
    eq("none down", pointers.pointers_down(q) as i64, 0)

    say("== 4. a lost UP\n")
    set(&e, 0, 3, 50.0, 50.0)
    send(q, &e, pointers.MA_DOWN, 0, 1, 2000)
    send(q, &e, pointers.MA_POINTER_DOWN, 0, 1, 2010)
    drain(q)
    eq("down, then a down of the same id: down, cancel, down", G_N, 3)
    eq("the middle one is a cancel", kind(1), pointers.PK_CANCEL as i64)
    eq("still one finger down", pointers.pointers_down(q) as i64, 1)
    set(&e, 0, 8, 60.0, 60.0)
    send(q, &e, pointers.MA_DOWN, 0, 1, 2100)
    drain(q)
    eq("ACTION_DOWN with a stale finger: cancel it, then down", G_N, 2)
    eq("cancel first", kind(0), pointers.PK_CANCEL as i64)
    eq("the cancelled one is id 3", id(0), 3)
    eq("then the new finger", id(1) * 10 + kind(1), 80 + pointers.PK_DOWN as i64)

    say("== 5. CANCEL, mouse and finger\n")
    set(&e, 0, 8, 60.0, 60.0)
    set(&e, 1, 9, 160.0, 60.0)
    send(q, &e, pointers.MA_POINTER_DOWN, 1, 2, 3000)
    drain(q)
    send(q, &e, pointers.MA_CANCEL, 0, 2, 3010)
    drain(q)
    eq("CANCEL gives one cancel per finger", G_N, 2)
    eq("both are cancels", kind(0) * 10 + kind(1),
        (pointers.PK_CANCEL as i64) * 11)
    eq("none down", pointers.pointers_down(q) as i64, 0)
    // mouse + touch: primary per type
    set(&e, 0, 20, 5.0, 5.0)
    e.ty[0] = pointers.PTR_MOUSE
    send(q, &e, pointers.MA_DOWN, 0, 1, 4000)
    set(&e, 0, 20, 5.0, 5.0)
    set(&e, 1, 21, 90.0, 90.0)
    e.ty[1] = pointers.PTR_TOUCH
    send(q, &e, pointers.MA_POINTER_DOWN, 1, 2, 4010)
    drain(q)
    eq("mouse is primary", G_PRIM[0] as i64, 1)
    eq("the first touch is primary as well (other type)", G_PRIM[1] as i64, 1)
    eq("types are kept", (G_TYPE[0] * 10 + G_TYPE[1]) as i64, 12)
    send(q, &e, pointers.MA_CANCEL, 0, 2, 4020)
    drain(q)

    say("== 6. the ring\n")
    set(&e, 0, 1, 0.0, 0.0)
    e.ty[0] = pointers.PTR_TOUCH
    send(q, &e, pointers.MA_DOWN, 0, 1, 5000)
    var k: usize = 1
    while k <= 100 {
        set(&e, 0, 1, k as f64, 0.0)
        send(q, &e, pointers.MA_MOVE, 0, 1, 5000 + k as i64)
        k = k + 1
    }
    eq("records were dropped (oldest first)", (pointers.pointers_dropped(q) > 0) as i64, 1)
    drain(q)
    eq("the ring holds 63", G_N, 63)
    eq("the newest record is the last move (x = 100)", G_X[62] as i64, 100)
    send(q, &e, pointers.MA_CANCEL, 0, 1, 6000)
    drain(q)
    pointers.pointers_enable(q, false)
    eq("switching off forgets the fingers", pointers.pointers_down(q) as i64, 0)

    say("== 7. tool types and shared numbers\n")
    eq("finger = touch", pointers.pointers_tool_type(1) as i64, pointers.PTR_TOUCH as i64)
    eq("stylus = pen", pointers.pointers_tool_type(2) as i64, pointers.PTR_PEN as i64)
    eq("mouse = mouse", pointers.pointers_tool_type(3) as i64, pointers.PTR_MOUSE as i64)
    eq("eraser = pen", pointers.pointers_tool_type(4) as i64, pointers.PTR_PEN as i64)
    eq("unknown = touch", pointers.pointers_tool_type(0) as i64, pointers.PTR_TOUCH as i64)
    eq("PTR_MOUSE == event.PT_MOUSE", pointers.PTR_MOUSE as i64, event.PT_MOUSE as i64)
    eq("PTR_TOUCH == event.PT_TOUCH", pointers.PTR_TOUCH as i64, event.PT_TOUCH as i64)
    eq("PTR_PEN == event.PT_PEN", pointers.PTR_PEN as i64, event.PT_PEN as i64)

    if G_ERRORS == 0 {
        say("POINTERS PASSED\n")
        return 0
    }
    say("POINTERS FAILED: ")
    say_int(G_ERRORS as i64)
    say("\n")
    return 1
}
