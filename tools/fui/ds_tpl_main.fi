import ds_testpage
import fui.ds_icons
import fui.ds_icons_full
import fui.ds_icons_names
import fui.ds_settings
import fui.ds_swatch
import fui.ds_tokens
import fui.ds_tpl_settings
import fui.ds_tpl_wizard
import fui.editor
import fui.kit
import fui.render
import fui.theme
import plat.fuiwirt

const NONE: usize = 18446744073709551615
const SWATCH_ID: usize = 11

static mut LAST_ID: usize = 0
static mut LAST_VAL: i64 = 0
static mut CALLS: usize = 0
static mut FIRED: usize = 0
static mut FINISHED: usize = 0
static mut GATE_OPEN: bool = false

fn ico(id: i64) -> i64 { return ds_icons.gid(id) }

fn on_apply(ud: u64, id: usize, v: i64) {
    LAST_ID = id
    LAST_VAL = v
    CALLS = CALLS + 1
}

fn on_fire(ud: u64, id: usize) { FIRED = id }

fn build_settings() -> *mut ds_tpl_settings.Tpl {
    let t: *mut ds_tpl_settings.Tpl = ds_tpl_settings.new("Settings", on_apply, on_fire, 0)
    (*t).ud = t as u64
    ds_tpl_settings.page(t, ico(ds_icons_names.DISPLAY), "System")
    ds_tpl_settings.section(t, "Display")
    ds_tpl_settings.toggle(t, 1, ico(ds_icons_names.MOON), "Dark mode", "Switch the whole app instantly")
    ds_tpl_settings.combo(t, 2, ico(ds_icons_names.GLOBE), "Language", "", "English|Deutsch|Francais")
    ds_tpl_settings.slider(t, 3, ico(ds_icons_names.BRIGHTNESS), "Brightness", "", 0, 100, "%")
    ds_tpl_settings.link(t, 5, ico(ds_icons_names.HARD_DRIVE), "Storage", "Manage disks and cleanup")
    ds_tpl_settings.page(t, ico(ds_icons_names.WIFI_1), "Network")
    ds_tpl_settings.toggle(t, 6, ico(ds_icons_names.WIFI_1), "Wi-Fi", "Connected to Home")
    ds_tpl_settings.button(t, 8, ico(ds_icons_names.SETTINGS), "Network reset", "", "Reset")
    ds_tpl_settings.page(t, ico(ds_icons_names.LOCK), "Privacy")
    ds_tpl_settings.toggle(t, 9, ico(ds_icons_names.NOTIFICATION), "Notifications", "")
    ds_tpl_settings.page(t, ico(ds_icons_names.PERSONALIZE), "Personalization")
    ds_tpl_settings.swatch(t, SWATCH_ID, "Accent color", "")
    return t
}

fn paint(t: *mut ds_tpl_settings.Tpl, pg: *mut ds_testpage.Page, w: f64, h: f64) {
    ds_testpage.clear(pg)
    ds_tpl_settings.paint(t as u64, &(*pg).c, w, h, 0.0 - 1.0, 0.0 - 1.0)
}

fn tap(t: *mut ds_tpl_settings.Tpl, x: f64, y: f64) {
    ds_tpl_settings.press(t as u64, x, y)
    ds_tpl_settings.pointer(t as u64, fuiwirt.HOOK_UP, x, y)
}

fn row_center(t: *mut ds_tpl_settings.Tpl, id: usize, q: *mut [f64; 4]) {
    ds_settings.row_rect(ds_tpl_settings.panel_of(t), id, q)
}

fn run_settings(font: u64) {
    ds_testpage.say("== settings wide\n")
    let pg: *mut ds_testpage.Page = ds_testpage.page_new(1100, 700, false, font)
    let t: *mut ds_tpl_settings.Tpl = build_settings()
    var q: [f64; 4] = [0.0; 4]
    paint(t, pg, 1100.0, 700.0)
    ds_testpage.check(!(*t).stacked, "wide layout is not stacked")
    ds_testpage.check(ds_tpl_settings.count_shown(t) == 4, "page 0 shows its four rows")
    row_center(t, 1, &q)
    tap(t, q[0] + 30.0, q[1] + q[3] / 2.0)
    ds_testpage.check(CALLS == 1 && LAST_ID == 1 && LAST_VAL == 1, "toggle row applies live (id 1, value 1)")
    ds_testpage.check(ds_tpl_settings.get(t, 1) == 1, "get returns the applied value")
    paint(t, pg, 1100.0, 700.0)
    row_center(t, 1, &q)
    tap(t, q[0] + 30.0, q[1] + q[3] / 2.0)
    ds_testpage.check(CALLS == 2 && LAST_VAL == 0, "second tap applies value 0")
    ds_tpl_settings.set(t, 1, 1)
    ds_testpage.check(ds_tpl_settings.get(t, 1) == 1 && CALLS == 2, "set does not call apply")
    paint(t, pg, 1100.0, 700.0)
    row_center(t, 5, &q)
    tap(t, q[0] + 30.0, q[1] + q[3] / 2.0)
    ds_testpage.check(FIRED == 5, "link row fires the action callback")

    ds_testpage.say("== settings search\n")
    kit.search_set_text(ds_tpl_settings.search_of(t), "storage")
    paint(t, pg, 1100.0, 700.0)
    ds_testpage.check(ds_tpl_settings.searching(t) && ds_tpl_settings.count_shown(t) == 1, "search finds one title match")
    kit.search_set_text(ds_tpl_settings.search_of(t), "STORAGE")
    ds_testpage.check(ds_tpl_settings.count_shown(t) == 1, "search ignores case")
    kit.search_set_text(ds_tpl_settings.search_of(t), "connected")
    ds_testpage.check(ds_tpl_settings.count_shown(t) == 1, "search looks into subtitles")
    kit.search_set_text(ds_tpl_settings.search_of(t), "wi")
    ds_testpage.check(ds_tpl_settings.count_shown(t) == 2, "search spans all pages")
    ds_testpage.check(ds_tpl_settings.page_title(t) == (*t).results_text, "title becomes the results text while searching")
    kit.search_set_text(ds_tpl_settings.search_of(t), "zzz")
    ds_testpage.check(ds_tpl_settings.count_shown(t) == 0, "no match shows nothing")
    kit.search_set_text(ds_tpl_settings.search_of(t), "")
    ds_testpage.check(!ds_tpl_settings.searching(t) && ds_tpl_settings.count_shown(t) == 4, "clearing the search restores the page")

    ds_testpage.say("== settings swatch\n")
    (*t).page = 3
    paint(t, pg, 1100.0, 700.0)
    let sw: *mut ds_swatch.Swatch = ds_tpl_settings.swatch_of(t)
    ds_testpage.check((*t).swatch_on && ds_swatch.count(sw) == ds_tokens.accent_count(), "swatch row on the page holds the accent palette")
    let before: u32 = (*theme.theme_colors(&(*pg).m)).accent
    ds_swatch.cell_rect(sw, 2, &q)
    let calls: usize = CALLS
    tap(t, q[0] + q[2] / 2.0, q[1] + q[3] / 2.0)
    ds_testpage.check(CALLS == calls + 1 && LAST_ID == SWATCH_ID && LAST_VAL == 2, "swatch pick applies its index live")
    ds_testpage.check(ds_swatch.selected(sw) == 2, "swatch shows the pick")
    ds_testpage.check((*theme.theme_colors(&(*pg).m)).accent != before, "theme accent changed")
    paint(t, pg, 1100.0, 700.0)
    ds_swatch.cell_rect(sw, 2, &q)
    tap(t, q[0] + q[2] / 2.0, q[1] + q[3] / 2.0)
    ds_testpage.check(CALLS == calls + 1, "picking the same colour again does not re-apply")

    ds_testpage.say("== settings phone\n")
    let ph: *mut ds_testpage.Page = ds_testpage.page_new(390, 800, false, font)
    let u: *mut ds_tpl_settings.Tpl = build_settings()
    paint(u, ph, 390.0, 800.0)
    ds_testpage.check((*u).stacked && !(*u).opened, "phone starts on the page list")
    ds_settings.row_rect(ds_tpl_settings.list_of(u), 1, &q)
    tap(u, q[0] + 30.0, q[1] + q[3] / 2.0)
    ds_testpage.check((*u).opened && (*u).page == 1, "tapping a list row opens that page")
    paint(u, ph, 390.0, 800.0)
    ds_testpage.check(ds_tpl_settings.count_shown(u) == 2, "opened page shows only its rows")
    tap(u, 24.0, 28.0)
    ds_testpage.check(!(*u).opened, "back button returns to the list")
    ds_settings.row_rect(ds_tpl_settings.list_of(u), 0, &q)
    paint(u, ph, 390.0, 800.0)
    ds_settings.row_rect(ds_tpl_settings.list_of(u), 0, &q)
    tap(u, q[0] + 30.0, q[1] + q[3] / 2.0)
    ds_testpage.check((*u).opened && (*u).page == 0, "first list row opens page 0")
    ds_testpage.check(ds_tpl_settings.key(u as u64, editor.KEY_ESC, 0 as u32) && !(*u).opened, "escape closes the page")
    ds_testpage.check(!ds_tpl_settings.key(u as u64, editor.KEY_ESC, 0 as u32), "escape on the list is not consumed")
}

fn gate(ud: u64, step: usize) -> bool { return step != 2 || GATE_OPEN }
fn finish(ud: u64) { FINISHED = FINISHED + 1 }
fn draw(ud: u64, c: *mut render.Ctx, step: usize, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) {}

fn build_wizard() -> *mut ds_tpl_wizard.Wiz {
    let w: *mut ds_tpl_wizard.Wiz = ds_tpl_wizard.new("Setup", draw, gate, finish, 0)
    (*w).ud = w as u64
    ds_tpl_wizard.welcome(w, ico(ds_icons_names.SPARKLE), "Welcome", "Hello")
    ds_tpl_wizard.step(w, "Region", "Pick")
    ds_tpl_wizard.step(w, "Account", "Who")
    ds_tpl_wizard.step(w, "Done", "Ready")
    return w
}

fn wpaint(w: *mut ds_tpl_wizard.Wiz, pg: *mut ds_testpage.Page, cw: f64, ch: f64) {
    ds_testpage.clear(pg)
    ds_tpl_wizard.paint(w as u64, &(*pg).c, cw, ch, 0.0 - 1.0, 0.0 - 1.0)
}

fn wtap(w: *mut ds_tpl_wizard.Wiz, b: usize) {
    let x: f64 = (*w).r[b * 4] + (*w).r[b * 4 + 2] / 2.0
    let y: f64 = (*w).r[b * 4 + 1] + (*w).r[b * 4 + 3] / 2.0
    ds_tpl_wizard.press(w as u64, x, y)
    ds_tpl_wizard.pointer(w as u64, fuiwirt.HOOK_UP, x, y)
}

fn run_wizard(font: u64, cw: usize, ch: usize) {
    let pg: *mut ds_testpage.Page = ds_testpage.page_new(cw, ch, false, font)
    let w: *mut ds_tpl_wizard.Wiz = build_wizard()
    let fw: f64 = cw as f64
    let fh: f64 = ch as f64
    GATE_OPEN = false
    FINISHED = 0
    wpaint(w, pg, fw, fh)
    ds_testpage.check(ds_tpl_wizard.current(w) == 0 && ds_tpl_wizard.is_welcome(w), "starts on the welcome step")
    ds_testpage.check(ds_tpl_wizard.next_label(w) == (*w).start_label, "welcome shows the start label")
    ds_testpage.check(!ds_tpl_wizard.go_back(w), "back does nothing on the first step")
    wtap(w, ds_tpl_wizard.BTN_NEXT)
    ds_testpage.check(ds_tpl_wizard.current(w) == 1, "next button advances")
    wpaint(w, pg, fw, fh)
    ds_testpage.check(ds_tpl_wizard.next_label(w) == (*w).next_label, "middle step shows the next label")
    wtap(w, ds_tpl_wizard.BTN_BACK)
    ds_testpage.check(ds_tpl_wizard.current(w) == 0, "back button returns")
    ds_tpl_wizard.go_next(w)
    ds_tpl_wizard.go_next(w)
    ds_testpage.check(ds_tpl_wizard.current(w) == 2 && !ds_tpl_wizard.allowed(w), "can_next false on step 2")
    ds_tpl_wizard.go_next(w)
    ds_testpage.check(ds_tpl_wizard.current(w) == 2, "next is blocked while can_next is false")
    GATE_OPEN = true
    ds_tpl_wizard.go_next(w)
    ds_testpage.check(ds_tpl_wizard.current(w) == 3 && ds_tpl_wizard.is_last(w), "next works once can_next is true")
    ds_testpage.check(ds_tpl_wizard.next_label(w) == (*w).finish_label, "last step shows the finish label")
    ds_testpage.check(FINISHED == 0 && !ds_tpl_wizard.finished(w), "finish not called early")
    wpaint(w, pg, fw, fh)
    wtap(w, ds_tpl_wizard.BTN_NEXT)
    ds_testpage.check(FINISHED == 1 && ds_tpl_wizard.finished(w), "next on the last step finishes once")
    ds_tpl_wizard.go_next(w)
    ds_testpage.check(FINISHED == 1, "finish is not called twice")
    ds_testpage.check(ds_tpl_wizard.key(w as u64, editor.KEY_ESC, 0 as u32) && ds_tpl_wizard.current(w) == 2, "escape goes back")
}

fn main() -> i32 {
    let font: u64 = ds_testpage.font_load()
    if font == 0 {
        ds_testpage.say("no system font\n")
        return 2
    }
    run_settings(font)
    ds_testpage.say("== wizard desktop\n")
    run_wizard(font, 1100, 700)
    ds_testpage.say("== wizard phone\n")
    run_wizard(font, 390, 800)
    return ds_testpage.finish("DS_TPL")
}
