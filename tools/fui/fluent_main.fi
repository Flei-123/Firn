// SPDX-License-Identifier: MPL-2.0
// tools/fui/fluent_main.fi -- THE MEASURE TEST AGAINST THE FLUENT TARGET.
//
// Paints every standard control onto a plain canvas, MEASURES its size
// in pixels (not from a constant: from the foreign pixels that really
// landed on the canvas) and compares it with the Windows 11 / Fluent 2
// target size. The last line is `DEVIATIONS: <n>`; the goal is 0.
//
//     fluent_main [<font.ttf>]        exit code 1 if there is a deviation
//
// Target sizes (design points at 100 %):
//   button 32 high, radius 4 (controls) / 8 (overlays)   text field 32
//   toggle 40 x 20      checkbox 20 x 20      radio 20 x 20
//   slider track 4, thumb 20      scrollbar thumb 2 idle -> 6 hover
//   menu row 32         type scale 12 / 14 / 20 / 28 / 40     4 px grid
//   button primary / secondary / subtle    combo box 32 + 1 stroke
//   tab indicator 2 inset 8    progress bar 4 round    elevation 1..4
//   dialog padding 24, title 20/28, button bar 32, radius 8
//   title bar 32 high, caption buttons 46 x 32, title 12, close red
import std.rt
import paint.canvas
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.wave2
import fui.wave3
import fui.titlebar
import fui.menuview
import fui.kit
import fui.layout

const FONTSET_BYTES: usize = 4096
const W: usize = 400
const H: usize = 160

static mut DEV: usize = 0
static mut TOTAL: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_num(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// One measurement: name, what was measured, what Fluent wants.
fn check(name: str, got: i64, want: i64) {
    TOTAL = TOTAL + 1
    if got == want {
        say("  ok    ")
    } else {
        say("  DEV   ")
        DEV = DEV + 1
    }
    say(name)
    say("  got ")
    say_num(got)
    say("  want ")
    say_num(want)
    say("\n")
}

// absolute green-channel distance of two colours
fn chan_gap(a: u32, b: u32) -> i64 {
    let x: i64 = ((a >> 8) & 255 as u32) as i64
    let y: i64 = ((b >> 8) & 255 as u32) as i64
    if x > y { return x - y }
    return y - x
}

fn b2i(b: bool) -> i64 {
    if b { return 1 }
    return 0
}

fn px(cv: *mut canvas.Canvas, x: usize, y: usize) -> u32 {
    return canvas.canvas_get(cv, x, y) & 0x00FFFFFF as u32
}

fn clear(cv: *mut canvas.Canvas, m: *mut theme.Theme) {
    let f: *mut theme.Colors = theme.theme_colors(m)
    canvas.canvas_clear(cv, theme.opaque((*f).base))
}

// The extent of everything that is not the page colour inside a box:
// out[0]=left out[1]=top out[2]=right(excl) out[3]=bottom(excl).
fn ink_box(cv: *mut canvas.Canvas, bg: u32, x0: usize, y0: usize,
    x1: usize, y1: usize, out: *mut [i64; 4]) -> bool {
    var l: i64 = 1000000
    var t: i64 = 1000000
    var r: i64 = -1
    var b: i64 = -1
    var y: usize = y0
    while y < y1 {
        var x: usize = x0
        while x < x1 {
            if px(cv, x, y) != bg {
                if (x as i64) < l { l = x as i64 }
                if (y as i64) < t { t = y as i64 }
                if (x as i64) + 1 > r { r = (x as i64) + 1 }
                if (y as i64) + 1 > b { b = (y as i64) + 1 }
            }
            x = x + 1
        }
        y = y + 1
    }
    (*out)[0] = l
    (*out)[1] = t
    (*out)[2] = r
    (*out)[3] = b
    return r >= 0
}

// Height of the foreign run that crosses the row/column at (x, ymid).
fn run_v(cv: *mut canvas.Canvas, bg: u32, x: usize, y0: usize,
    y1: usize) -> i64 {
    var n: i64 = 0
    var y: usize = y0
    while y < y1 {
        if px(cv, x, y) != bg { n = n + 1 }
        y = y + 1
    }
    return n
}

fn run_h(cv: *mut canvas.Canvas, bg: u32, y: usize, x0: usize,
    x1: usize) -> i64 {
    var n: i64 = 0
    var x: usize = x0
    while x < x1 {
        if px(cv, x, y) != bg { n = n + 1 }
        x = x + 1
    }
    return n
}

// Pixels of exactly one colour in a row (the thumb inside a hover track).
fn run_col(cv: *mut canvas.Canvas, col: u32, y: usize, x0: usize,
    x1: usize) -> i64 {
    var n: i64 = 0
    var x: usize = x0
    while x < x1 {
        if px(cv, x, y) == col { n = n + 1 }
        x = x + 1
    }
    return n
}

// Pixels of exactly one colour in a column.
fn run_v_col(cv: *mut canvas.Canvas, col: u32, x: usize, y0: usize,
    y1: usize) -> i64 {
    var n: i64 = 0
    var y: usize = y0
    while y < y1 {
        if px(cv, x, y) == col { n = n + 1 }
        y = y + 1
    }
    return n
}

fn main(start: u64) -> i32 {
    var fbuf: rt.Buf = rt.buf_new()
    var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
    let have: bool = rt.read_file((&f1[0]) as u64, &fbuf)
    let fsp: *mut metrics.FontSet =
    rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 { return 3 }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) { return 4 }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, H) { return 5 }
    painter.painter_set_font(&z, fm)

    var bx: [i64; 4] = [0; 4]
    var m: theme.Theme = theme.theme_new(false)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    let fo: *mut theme.Shape = theme.theme_shape(&m)
    let bg: u32 = (*f).base

    say("-- theme tokens (design points)\n")
    check("radius button", (*fo).r_button as i64, 4)
    check("radius field", (*fo).r_field as i64, 4)
    check("radius panel/card", (*fo).r_panel as i64, 8)
    check("radius window/overlay", (*fo).r_window as i64, 8)
    check("control height", (*fo).ctrl_h as i64, 32)
    check("menu / list row", (*fo).row as i64, 32)
    check("body font", (*fo).font as i64, 14)
    check("spacing xs", (*fo).sp_xs as i64, 4)
    check("spacing s", (*fo).sp_s as i64, 8)
    check("spacing m", (*fo).sp_m as i64, 16)
    check("spacing l", (*fo).sp_l as i64, 24)
    check("menu_item_height px", wave2.menu_item_height(&c) as i64, 32)

    say("-- pixels\n")
    // TOGGLE: place a 200x32 widget at 20,20, no label.
    var tg: widget.Widget = widget.widget_new(widget.KIND_TOGGLE)
    widget.w_place(&tg, 20.0, 20.0, 200.0, 32.0)
    clear(&cv, &m)
    wave2.draw_any(&c, &tg)
    ink_box(&cv, bg, 0, 0, W, H, &bx)
    check("toggle width", bx[2] - bx[0], 40)
    check("toggle height", bx[3] - bx[1], 20)

    var cb: widget.Widget = widget.widget_new(widget.KIND_CHECKBOX)
    widget.w_place(&cb, 20.0, 20.0, 200.0, 32.0)
    clear(&cv, &m)
    wave2.draw_any(&c, &cb)
    ink_box(&cv, bg, 0, 0, W, H, &bx)
    check("checkbox width", bx[2] - bx[0], 20)
    check("checkbox height", bx[3] - bx[1], 20)

    var rd: widget.Widget = widget.widget_new(widget.KIND_RADIO)
    widget.w_place(&rd, 20.0, 20.0, 200.0, 32.0)
    clear(&cv, &m)
    wave2.draw_any(&c, &rd)
    ink_box(&cv, bg, 0, 0, W, H, &bx)
    check("radio width", bx[2] - bx[0], 20)
    check("radio height", bx[3] - bx[1], 20)

    // SLIDER: horizontal 200 x 32 at 20,20, value 0.
    var sl: widget.Widget = widget.widget_new(widget.KIND_SLIDER)
    widget.w_place(&sl, 20.0, 20.0, 200.0, 32.0)
    widget.w_set_value(&sl, 0)
    clear(&cv, &m)
    wave2.draw_any(&c, &sl)
    check("slider track thickness", run_v(&cv, bg, 20 + 100, 0, H), 4)
    check("slider thumb diameter", run_v(&cv, bg, 20 + 16, 0, H), 20)

    // SCROLLBAR: vertical 12 x 120 at 20,20.
    var sb: widget.Widget = widget.widget_new(widget.KIND_SCROLLBAR)
    widget.w_place(&sb, 20.0, 20.0, 12.0, 120.0)
    widget.w_set_value(&sb, 0)
    clear(&cv, &m)
    wave2.draw_any(&c, &sb)
    check("scrollbar thumb idle", run_h(&cv, bg, 20 + 30, 0, W), 2)
    widget.w_set_hover(&sb, true)
    clear(&cv, &m)
    wave2.draw_any(&c, &sb)
    check("scrollbar thumb hover", run_col(&cv, (*f).text_muted, 20 + 30, 0, W), 6)

    // BUTTON + TEXT FIELD: height as placed must stay what is painted
    // (no stray ring / shadow outside the box).
    var bt: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&bt, 20.0, 20.0, 120.0, 32.0)
    clear(&cv, &m)
    render.draw_widget(&c, &bt)
    ink_box(&cv, bg, 0, 0, W, H, &bx)
    check("button painted height", bx[3] - bx[1], 32)
    // corner: radius 4 leaves the very corner pixel as page colour
    check("button corner rounded", b2i(px(&cv, 20, 20) == bg), 1)

    var tf: widget.Widget = widget.widget_new(widget.KIND_TEXTBOX)
    widget.w_place(&tf, 20.0, 20.0, 200.0, 32.0)
    clear(&cv, &m)
    render.draw_widget(&c, &tf)
    ink_box(&cv, bg, 0, 0, W, H, &bx)
    check("field painted height", bx[3] - bx[1], 32)
    // Focus: Fluent draws a 2 px accent line at the BOTTOM only.
    widget.w_set_focus(&tf, true)
    clear(&cv, &m)
    render.draw_widget(&c, &tf)
    check("field focus underline (accent px in bottom row)",
        b2i(px(&cv, 20 + 100, 20 + 31) == (*f).accent), 1)
    check("field focus: no accent on top edge",
        b2i(px(&cv, 20 + 100, 20) != (*f).accent), 1)

    say("-- button variants (secondary / primary / subtle)\n")
    var vb: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&vb, 20.0, 20.0, 120.0, 32.0)
    wave2.button_variant(&m, &vb, wave2.BTN_PRIMARY)
    clear(&cv, &m)
    render.draw_widget(&c, &vb)
    ink_box(&cv, bg, 0, 0, W, H, &bx)
    check("primary painted height", bx[3] - bx[1], 32)
    check("primary face = accent", b2i(px(&cv, 20 + 8, 20 + 16) == (*f).accent), 1)
    check("primary text on accent contrast >= 4.5 (x100)",
        b2i(theme.contrast(theme.opaque((*f).text_on_accent),
            theme.opaque((*f).accent)) >= 4.5), 1)
    widget.w_set_hover(&vb, true)
    clear(&cv, &m)
    render.draw_widget(&c, &vb)
    check("primary hover face differs from accent",
        b2i(px(&cv, 20 + 8, 20 + 16) != (*f).accent), 1)
    check("primary hover is not the page", b2i(px(&cv, 20 + 8, 20 + 16) != bg), 1)

    var vs: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&vs, 20.0, 20.0, 120.0, 32.0)
    wave2.button_variant(&m, &vs, wave2.BTN_SECONDARY)
    clear(&cv, &m)
    render.draw_widget(&c, &vs)
    ink_box(&cv, bg, 0, 0, W, H, &bx)
    check("secondary painted height", bx[3] - bx[1], 32)
    check("secondary face = button", b2i(px(&cv, 20 + 8, 20 + 16) == (*f).button), 1)
    check("secondary stroke = border colour (top edge)",
        b2i(px(&cv, 20 + 60, 20) == (*f).border_col), 1)

    var vu: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&vu, 20.0, 20.0, 120.0, 32.0)
    wave2.button_variant(&m, &vu, wave2.BTN_SUBTLE)
    clear(&cv, &m)
    render.draw_widget(&c, &vu)
    check("subtle at rest paints nothing", b2i(px(&cv, 20 + 8, 20 + 16) == bg), 1)
    widget.w_set_hover(&vu, true)
    clear(&cv, &m)
    render.draw_widget(&c, &vu)
    check("subtle hover = button_hover",
        b2i(px(&cv, 20 + 8, 20 + 16) == (*f).button_hover), 1)

    say("-- combo box, tab, progress\n")
    var dd: widget.Widget = widget.widget_new(widget.KIND_DROPDOWN)
    widget.w_place(&dd, 20.0, 20.0, 160.0, 32.0)
    clear(&cv, &m)
    wave2.draw_any(&c, &dd)
    ink_box(&cv, bg, 0, 0, W, H, &bx)
    check("combo painted height", bx[3] - bx[1], 32)
    check("combo stroke = border colour", b2i(px(&cv, 20 + 80, 20) == (*f).border_col), 1)
    check("combo chevron drawn (ink right of centre)",
        b2i(run_h(&cv, (*f).button, 20 + 16, 20 + 100, 20 + 159) > 0), 1)

    var tb: widget.Widget = widget.widget_new(widget.KIND_TAB)
    widget.w_place(&tb, 20.0, 20.0, 100.0, 32.0)
    widget.w_set_selected(&tb, true)
    clear(&cv, &m)
    wave2.draw_any(&c, &tb)
    // 100 - 2 x 8 = 84; the round caps (radius 1) soften the two end pixels
    let iw: i64 = run_col(&cv, (*f).accent, 20 + 31, 0, W)
    check("tab indicator width (84, caps soft: 82..84)", b2i(iw >= 82 && iw <= 84), 1)
    check("tab indicator thickness", run_v_col(&cv, (*f).accent, 20 + 50, 0, H), 2)

    var pg: widget.Widget = widget.widget_new(widget.KIND_PROGRESS)
    widget.w_place(&pg, 20.0, 20.0, 200.0, 16.0)
    widget.w_set_value(&pg, wave2.VAL_MAX / 2)
    clear(&cv, &m)
    wave2.draw_any(&c, &pg)
    check("progress track thickness", run_v(&cv, bg, 20 + 150, 0, H), 4)
    check("progress fill thickness", run_v(&cv, bg, 20 + 50, 0, H), 4)
    check("progress fill = accent", b2i(px(&cv, 20 + 50, 20 + 8) == (*f).accent), 1)
    check("progress track centred (top row of bar at y 26)",
        b2i(px(&cv, 20 + 150, 26) != bg && px(&cv, 20 + 150, 25) == bg), 1)

    say("-- elevation (shadow under a raised panel)\n")
    check("elev blur level 1", theme.elev_blur(1) as i64, 4)
    check("elev blur level 2", theme.elev_blur(2) as i64, 8)
    check("elev blur level 3", theme.elev_blur(3) as i64, 16)
    check("elev blur level 4", theme.elev_blur(4) as i64, 32)
    check("elev strength grows 1 < 2 < 3 < 4",
        b2i(theme.elev_alpha(1) < theme.elev_alpha(2) && theme.elev_alpha(2) < theme.elev_alpha(3)
            && theme.elev_alpha(3) < theme.elev_alpha(4)), 1)
    // card: level 1 -- shadow reaches ~6 below, nothing 14 below, nothing 12 above
    var cd: widget.Widget = widget.widget_new(widget.KIND_CARD)
    widget.w_place(&cd, 100.0, 40.0, 120.0, 60.0)
    clear(&cv, &m)
    render.draw_widget(&c, &cd)
    check("card: shadow just below", b2i(px(&cv, 160, 100 + 2) != bg), 1)
    check("card: clean 14 below", b2i(px(&cv, 160, 100 + 14) == bg), 1)
    check("card: clean 12 above", b2i(px(&cv, 160, 40 - 12) == bg), 1)
    // dialog: level 3 -- reaches ~24 below, softer than the card at the same spot is stronger
    var dl: widget.Widget = widget.widget_new(widget.KIND_NONE)
    widget.w_place(&dl, 100.0, 20.0, 200.0, 80.0)
    clear(&cv, &m)
    wave3.draw_dialog(&c, &dl)
    check("dialog: shadow 14 below (level 3 reaches further)", b2i(px(&cv, 200, 100 + 14) != bg), 1)
    check("dialog: clean 30 below", b2i(px(&cv, 200, 100 + 30) == bg), 1)
    // menu: level 2 -- between card and dialog
    var mn: widget.Widget = widget.widget_new(widget.KIND_MENU)
    widget.w_place(&mn, 100.0, 40.0, 120.0, 60.0)
    clear(&cv, &m)
    render.draw_widget(&c, &mn)
    check("menu: shadow 8 below", b2i(px(&cv, 160, 100 + 8) != bg), 1)
    check("menu: clean 16 below", b2i(px(&cv, 160, 100 + 16) == bg), 1)


    say("-- dialog inner metrics (Fluent ContentDialog)\n")
    var dt: [u8; 3] = "HHH"
    var dg: widget.Widget = widget.widget_new(widget.KIND_NONE)
    widget.w_place(&dg, 20.0, 10.0, 300.0, 140.0)
    widget.w_set_text(&dg, (&dt[0]) as u64, 3)
    clear(&cv, &m)
    wave3.draw_dialog(&c, &dg)
    let dtr: wave3.FRect = wave3.dialog_title_rect(&c, &dg)
    let dbo: wave3.FRect = wave3.dialog_body_rect(&c, &dg)
    let dbu: wave3.FRect = wave3.dialog_buttons_rect(&c, &dg)
    check("dialog title area = 24 pad + 28 line", dtr.h as i64, 52)
    check("dialog button bar height", dbu.h as i64, 32)
    check("dialog button bar bottom margin 24",
        (10.0 + 140.0 - 1.0) as i64 - (dbu.y + dbu.h) as i64, 24)
    check("dialog body starts 8 under the title", (dbo.y - (dtr.y + dtr.h)) as i64, 8)
    check("dialog body inset 24 from the left", (dbo.x - 20.0) as i64, 25)
    check("dialog button bar starts at the same inset", (dbu.x - 20.0) as i64, 25)
    // title ink: left edge 24 inside the panel (+1 stroke), cap height of 20 px
    let sf: u32 = (*f).surface
    var tb4: [i64; 4] = [0; 4]
    ink_box(&cv, sf, 20 + 10, 10 + 6, 20 + 200, 10 + 52, &tb4)
    check("dialog title ink starts at the 24 pad (25..27)",
        b2i(tb4[0] >= 20 + 25 && tb4[0] <= 20 + 27), 1)
    check("dialog title cap height at 20 px (14..16)",
        b2i(tb4[3] - tb4[1] >= 14 && tb4[3] - tb4[1] <= 16), 1)
    check("dialog title sits in its 28 line (centre within 3)",
        b2i((tb4[1] + tb4[3]) / 2 >= 10 + 25 + 11 && (tb4[1] + tb4[3]) / 2 <= 10 + 25 + 17), 1)
    // radius 8: the corner is cut, the middle of the edge is not
    check("dialog corner rounded (radius 8)", b2i(px(&cv, 20 + 1, 10 + 1) != sf), 1)
    check("dialog edge middle is panel", b2i(px(&cv, 20 + 150, 10 + 3) == sf), 1)
    var ba: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    var bb: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    var bl: [u8; 6] = "Cancel"
    widget.w_set_text(&ba, (&bl[0]) as u64, 6)
    widget.w_set_text(&bb, (&bl[0]) as u64, 6)
    var brow: [u64; 2] = [(&ba) as u64, (&bb) as u64]
    wave3.dialog_buttons_layout(&c, &dg, (&brow[0]) as *mut u64, 2)
    check("dialog button height", widget.w_h(&ba) as i64, 32)
    check("dialog button gap", (widget.w_x(&bb) - widget.w_x(&ba) - widget.w_w(&ba)) as i64, 8)

    say("-- title bar (Windows 11)\n")
    var tt: [u8; 3] = "HEH"
    // inactive: ground = surface, so the ink box is the bar itself
    clear(&cv, &m)
    titlebar.titlebar_draw(&c, 20.0, 20.0, 300.0, "", false, false,
        titlebar.TB_NONE, titlebar.TB_NONE)
    ink_box(&cv, bg, 0, 0, W, H, &bx)
    check("titlebar height", bx[3] - bx[1], 32)
    check("titlebar width", bx[2] - bx[0], 300)
    check("titlebar inactive lifts to the surface colour",
        b2i(px(&cv, 20 + 100, 20 + 4) == (*f).surface), 1)
    clear(&cv, &m)
    titlebar.titlebar_draw(&c, 20.0, 20.0, 300.0, "", true, false,
        titlebar.TB_NONE, titlebar.TB_NONE)
    check("titlebar active keeps the page colour",
        b2i(px(&cv, 20 + 100, 20 + 4) == bg), 1)
    // glyph sizes at rest (active): minimize 10 x 1, maximize 10 x 10, close ~10
    var gb: [i64; 4] = [0; 4]
    ink_box(&cv, bg, 20 + 300 - 138, 20, 20 + 300 - 92, 20 + 32, &gb)
    check("minimize glyph width", gb[2] - gb[0], 10)
    check("minimize glyph thickness", gb[3] - gb[1], 1)
    ink_box(&cv, bg, 20 + 300 - 92, 20, 20 + 300 - 46, 20 + 32, &gb)
    check("maximize glyph width", gb[2] - gb[0], 10)
    check("maximize glyph height", gb[3] - gb[1], 10)
    ink_box(&cv, bg, 20 + 300 - 46, 20, 20 + 300, 20 + 32, &gb)
    check("close glyph width (9..11)", b2i(gb[2] - gb[0] >= 9 && gb[2] - gb[0] <= 11), 1)
    check("close glyph height (9..11)", b2i(gb[3] - gb[1] >= 9 && gb[3] - gb[1] <= 11), 1)
    check("close glyph centred in its button",
        b2i((gb[0] + gb[2]) / 2 >= 20 + 300 - 23 - 1 && (gb[0] + gb[2]) / 2 <= 20 + 300 - 23 + 1), 1)
    // hover: close = Windows red, 46 x 32; minimize = subtle hover face
    clear(&cv, &m)
    titlebar.titlebar_draw(&c, 20.0, 20.0, 300.0, "", true, false,
        titlebar.TB_CLOSE, titlebar.TB_NONE)
    check("close hover red width", run_col(&cv, 0xC42B1C as u32, 20 + 2, 0, W), 46)
    check("close hover red height", run_v_col(&cv, 0xC42B1C as u32, 20 + 300 - 44, 0, H), 32)
    check("close hover glyph is white",
        b2i(run_col(&cv, 0xFFFFFF as u32, 20 + 16, 20 + 300 - 46, 20 + 300) > 0), 1)
    clear(&cv, &m)
    titlebar.titlebar_draw(&c, 20.0, 20.0, 300.0, "", true, false,
        titlebar.TB_CLOSE, titlebar.TB_CLOSE)
    check("close pressed is the darker red",
        b2i(px(&cv, 20 + 300 - 44, 20 + 2) == 0xB22A1B as u32), 1)
    clear(&cv, &m)
    titlebar.titlebar_draw(&c, 20.0, 20.0, 300.0, "", true, false,
        titlebar.TB_MIN, titlebar.TB_NONE)
    check("minimize hover face = button_hover",
        b2i(px(&cv, 20 + 300 - 138 + 2, 20 + 2) == (*f).button_hover), 1)
    check("minimize hover face width", run_col(&cv, (*f).button_hover, 20 + 2, 0, W), 46)
    check("no red on a minimize hover",
        b2i(run_col(&cv, 0xC42B1C as u32, 20 + 2, 0, W) == 0), 1)
    // title text: 12 px -> cap height 8..10, 12 in from the left, centred
    clear(&cv, &m)
    titlebar.titlebar_draw(&c, 20.0, 20.0, 300.0, "HEH", true, false,
        titlebar.TB_NONE, titlebar.TB_NONE)
    ink_box(&cv, bg, 20, 20, 20 + 150, 20 + 32, &gb)
    check("title cap height at 12 px (8..10)", b2i(gb[3] - gb[1] >= 8 && gb[3] - gb[1] <= 10), 1)
    check("title starts 12 from the edge (12..14)", b2i(gb[0] - 20 >= 12 && gb[0] - 20 <= 14), 1)
    check("title is vertically centred (within 1)",
        b2i((gb[1] + gb[3]) / 2 >= 20 + 15 && (gb[1] + gb[3]) / 2 <= 20 + 17), 1)
    // hit areas
    check("hit: drag area", titlebar.titlebar_hit(&c, 20.0, 20.0, 300.0, 100.0, 30.0) as i64, 4)
    check("hit: minimize", titlebar.titlebar_hit(&c, 20.0, 20.0, 300.0, 20.0 + 300.0 - 100.0, 30.0) as i64, 1)
    check("hit: maximize", titlebar.titlebar_hit(&c, 20.0, 20.0, 300.0, 20.0 + 300.0 - 60.0, 30.0) as i64, 2)
    check("hit: close", titlebar.titlebar_hit(&c, 20.0, 20.0, 300.0, 20.0 + 300.0 - 5.0, 30.0) as i64, 3)
    check("hit: below the bar", titlebar.titlebar_hit(&c, 20.0, 20.0, 300.0, 100.0, 20.0 + 32.0) as i64, 0)


    say("-- menu, tooltip, toast (Fluent overlays)\n")
    check("menu row (menuview) = 32", menuview.ROW_MIN_PT as i64, 32)
    check("menu separator slot = 1 line + 4 + 4", menuview.SEP_PT as i64, 9)
    check("menu frame padding = 4", menuview.PAD_PT as i64, 4)
    check("menu label to shortcut gap >= 24", b2i(menuview.GAP_PT >= 24.0), 1)
    check("menu icon / tick column = 28", menuview.GUTTER_PT as i64, 28)
    // menu panel: radius 8 -- the pixel one in / two down from the corner is OUTSIDE
    var pm: widget.Widget = widget.widget_new(widget.KIND_MENU)
    widget.w_place(&pm, 100.0, 40.0, 120.0, 60.0)
    clear(&cv, &m)
    render.draw_widget(&c, &pm)
    check("menu panel radius 8 (corner pixel cut)",
        b2i(px(&cv, 101, 42) != (*f).surface_raised && px(&cv, 101, 42) != (*f).border_col), 1)
    // a hovered menu row: the neutral hover face, 32 high
    var mi: widget.Widget = widget.widget_new(widget.KIND_MENU)
    widget.w_place(&mi, 20.0, 20.0, 120.0, 32.0)
    widget.w_set_hover(&mi, true)
    clear(&cv, &m)
    wave2.draw_menu_item(&c, &mi, false, false)
    check("menu row hover = neutral face (not the accent tint)",
        b2i(px(&cv, 20 + 60, 20 + 16) == (*f).button_hover), 1)
    check("menu row hover casts no shadow (below + above clean)",
        b2i(px(&cv, 20 + 60, 20 + 32 + 2) == bg && px(&cv, 20 + 60, 20 - 2) == bg), 1)
    // tooltip: caption text (12), radius 4, 8 / 6 padding
    var tp: widget.Widget = widget.widget_new(widget.KIND_TOOLTIP)
    var tx: [u8; 3] = "HEH"
    var tw: f64 = 0.0
    var th: f64 = 0.0
    wave2.tooltip_size(&c, (&tx[0]) as u64, 3, &tw, &th)
    widget.w_place(&tp, 40.0, 40.0, tw, th)
    widget.w_set_text(&tp, (&tx[0]) as u64, 3)
    clear(&cv, &m)
    wave2.draw_any(&c, &tp)
    var tbx: [i64; 4] = [0; 4]
    ink_box(&cv, (*f).surface_raised, 40 + 2, 40 + 2, 40 + (tw as usize) - 2, 40 + (th as usize) - 2, &tbx)
    check("tooltip text: cap height at 12 px (8..10)", b2i(tbx[3] - tbx[1] >= 8 && tbx[3] - tbx[1] <= 10), 1)
    check("tooltip text starts at the 8 pad (8..10)", b2i(tbx[0] - 40 >= 8 && tbx[0] - 40 <= 10), 1)
    check("tooltip is 6 + text + 6 high (font 12 line + 12)",
        b2i((th as i64) >= 24 && (th as i64) <= 28), 1)
    check("tooltip corner radius 4 (corner pixel cut, edge pixel not)",
        b2i(px(&cv, 40, 40) != (*f).surface_raised && px(&cv, 40 + 8, 40 + 2) == (*f).surface_raised), 1)
    // r208: a shadow that fades with its card (toast / dialog fade-in)
    clear(&cv, &m)
    let page: u32 = px(&cv, 160, 110)
    render.draw_elevation_faded(&c, 100.0, 20.0, 120.0, 60.0, 8.0, 3, 255 as u32)
    let full: i64 = chan_gap(px(&cv, 160, 80 + 6), page)
    clear(&cv, &m)
    render.draw_elevation_faded(&c, 100.0, 20.0, 120.0, 60.0, 8.0, 3, 80 as u32)
    let part: i64 = chan_gap(px(&cv, 160, 80 + 6), page)
    clear(&cv, &m)
    render.draw_elevation_faded(&c, 100.0, 20.0, 120.0, 60.0, 8.0, 3, 0 as u32)
    let none: i64 = chan_gap(px(&cv, 160, 80 + 6), page)
    check("shadow fade: full strength is visible", b2i(full > 0), 1)
    check("shadow fade 80/255 is weaker than full", b2i(part > 0 && part < full), 1)
    check("shadow fade 0 paints nothing", none, 0)

    say("DEVIATIONS: ")
    say_num(DEV as i64)
    say(" of ")
    say_num(TOTAL as i64)
    say("\n")
    if DEV > 0 { return 1 }
    return 0
}
