// SPDX-License-Identifier: MPL-2.0
import std.rt
import font.metrics
import paint.canvas
import fui.painter
import fui.fontback
import plat.sysfont

static mut BAD: usize = 0
static mut ALT: u64 = 0

struct Req {
    advance: f64,
    calls: usize,
}

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn t_ascent(fm: u64, ctx: u64, size: f64) -> f64 {
    return 7.0
}

fn t_descent(fm: u64, ctx: u64, size: f64) -> f64 {
    return 3.0
}

fn t_advance(fm: u64, ctx: u64, size: f64, cp: u32) -> f64 {
    let r: *mut Req = ctx as *mut Req
    (*r).calls = (*r).calls + 1
    return (*r).advance
}

fn t_pair_adjust(fm: u64, ctx: u64, size: f64, a: u32, b: u32) -> f64 {
    return 0.0
}

fn t_present(fm: u64, ctx: u64) -> bool {
    return true
}

fn t_has(fm: u64, ctx: u64, cp: u32) -> bool {
    return cp < 0x400 as u32
}

fn t_pick(fm: u64, ctx: u64, cp: u32) -> u64 {
    if cp >= 0x400 as u32 {
        return ALT
    }
    return fm
}

fn test_backend() -> fontback.FontBackend {
    var b: fontback.FontBackend = fontback.fbk_default()
    b.ascent = t_ascent
    b.descent = t_descent
    b.advance = t_advance
    b.pair_adjust = t_pair_adjust
    b.present = t_present
    b.has = t_has
    b.pick = t_pick
    return b
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    let fs2: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) || !sysfont.sysfont_load(fs2) {
        say("painter_backend: no font (DejaVu Sans)\n")
        return 9
    }
    ALT = fs2 as u64
    var cv: canvas.Canvas = canvas.canvas_new()
    var z: painter.Painter = painter.painter_new()
    check(canvas.canvas_init(&cv, 200, 40) && painter.painter_init(&z, &cv, 200, 40), "init")
    painter.painter_set_font(&z, fs as u64)
    let s: str = "Hello"
    let w0: f64 = painter.text_width(&z, s.p as u64, s.n, 16.0)
    let a0: f64 = painter.font_ascent(&z, 16.0)
    check(w0 > 20.0 && a0 > 8.0, "default backend measures with the Firn font stack")
    let req: *mut Req = rt.heap_alloc(64) as *mut Req
    (*req).advance = 10.0
    (*req).calls = 0
    painter.painter_set_backend(&z, test_backend())
    painter.painter_set_backend_ctx(&z, req as u64)
    check(painter.painter_backend_ctx(&z) == req as u64, "context is stored")
    check(painter.text_width(&z, s.p as u64, s.n, 16.0) == 50.0, "custom advance drives text_width")
    check((*req).calls >= s.n, "custom advance was called for every character")
    check(painter.font_ascent(&z, 16.0) == 7.0 && painter.font_descent(&z, 16.0) == 3.0, "custom ascent and descent")
    check(painter.text_fits_upto(&z, s.p as u64, s.n, 16.0, 25.0) == 2, "text_fits_upto follows the custom advance")
    check(painter.text_baseline_mid(&z, 0.0, 40.0, 16.0) == 22.0, "baseline uses the custom metrics")
    (*req).advance = 4.0
    check(painter.text_width(&z, s.p as u64, s.n, 16.0) == 20.0, "changing the context changes the measure")
    let run: painter.TextRun = painter.run_new(16.0)
    var r: painter.TextRun = run
    check(painter.fb_pick(&z, &r, 0x41 as u32) == fs as u64, "pick keeps the main font for Latin")
    check(painter.fb_pick(&z, &r, 0x416 as u32) == fs2 as u64, "pick routes Cyrillic to the backend face")
    check(painter.glyph_present(&z, 0x416 as u32) == false, "glyph_present asks the backend")
    painter.painter_reset_backend(&z)
    check(painter.text_width(&z, s.p as u64, s.n, 16.0) == w0, "reset restores the default measure")
    check(painter.font_ascent(&z, 16.0) == a0, "reset restores the default ascent")
    check(painter.fb_pick(&z, &r, 0x416 as u32) == fs as u64, "reset restores the default pick")
    painter.painter_free(&z)
    if BAD != 0 {
        say("painter_backend: FAIL\n")
        return 1
    }
    say("painter_backend: all ok\n")
    return 0
}
