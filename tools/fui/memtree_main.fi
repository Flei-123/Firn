import std.rt
import std.fs
import services.svc
import services.svcdir
import services.svcmut
import fui.memtree
import fui.fsbackend

static mut BAD: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  FAIL  ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn names_of(path: str, out: *mut rt.Buf) -> usize {
    var raw: rt.Buf = rt.buf_new()
    rt.buf_clear(out)
    if fsbackend.list(path, &raw) != svc.OK {
        rt.buf_free(&raw)
        return 0
    }
    var pos: usize = 0
    var n: usize = 0
    var e: svcdir.DirEntry = svcdir.entry_new()
    while svcdir.next_entry(&raw, &pos, &e) {
        if n > 0 {
            rt.buf_push(out, 44 as u8)
        }
        rt.buf_push_bytes(out, e.name.p as u64, e.name.n)
        if e.is_dir {
            rt.buf_push(out, 47 as u8)
        }
        n = n + 1
    }
    rt.buf_free(&raw)
    return n
}

fn same(b: *mut rt.Buf, s: str) -> bool {
    return rt.buf_len(b) == s.n && rt.mem_eq(rt.buf_ptr(b), s.p as u64, s.n)
}

fn test_memory() {
    fsbackend.use_memory_tree(true)
    memtree.reset()
    var names: rt.Buf = rt.buf_new()
    check(fsbackend.make_dir("/docs") == svc.OK, "mem: make folder")
    check(fsbackend.make_dir("/docs") == svc.EXISTS, "mem: folder twice is exists")
    check(fsbackend.make_dir("/no/deep") == svc.NOT_FOUND, "mem: missing parent")
    check(fsbackend.make_dir("/") == svc.INVALID, "mem: root is invalid")
    check(memtree.write_file("/docs/a.txt", "hello".p as u64, 5) == svc.OK, "mem: write file")
    check(memtree.write_file("/docs", "x".p as u64, 1) == svc.INVALID, "mem: write over folder")
    check(names_of("/docs", &names) == 1 && same(&names, "a.txt"), "mem: list shows file")
    check(fsbackend.rename("/docs/a.txt", "/docs/b.txt") == svc.OK, "mem: rename file")
    check(fsbackend.rename("/docs/zzz", "/docs/c.txt") == svc.NOT_FOUND, "mem: rename missing")
    check(fsbackend.make_dir("/docs/sub") == svc.OK, "mem: nested folder")
    check(fsbackend.rename("/docs/b.txt", "/docs/sub") == svc.EXISTS, "mem: rename onto existing")
    check(fsbackend.rename("/docs", "/docs/sub/x") == svc.INVALID, "mem: folder into itself")
    check(fsbackend.rename("/docs/b.txt", "/docs/sub/b.txt") == svc.OK, "mem: move file")
    check(names_of("/docs/sub", &names) == 1 && same(&names, "b.txt"), "mem: moved file listed")
    var data: rt.Buf = rt.buf_new()
    check(fsbackend.read_file("/docs/sub/b.txt", &data) && same(&data, "hello"), "mem: content survives rename")
    check(fsbackend.remove("/docs") == svc.NOT_EMPTY, "mem: non-empty folder is refused")
    check(fsbackend.remove("/docs/sub/b.txt") == svc.OK, "mem: remove file")
    check(fsbackend.remove("/docs/sub") == svc.OK && fsbackend.remove("/docs") == svc.OK, "mem: remove folders")
    check(fsbackend.remove("/docs") == svc.NOT_FOUND, "mem: remove twice")
    check(fsbackend.list("/docs", &data) == svc.NOT_FOUND, "mem: list missing")
    check(memtree.node_count() == 1, "mem: only root is left")
    check(fsbackend.make_dir("a/b") == svc.NOT_FOUND, "mem: relative path resolves from root")
    check(fsbackend.make_dir("a") == svc.OK && fsbackend.make_dir("a/b/") == svc.OK, "mem: relative folder and trailing slash")
    check(names_of("/a", &names) == 1 && same(&names, "b/"), "mem: folder entry flagged")
    check(fsbackend.make_dir("/a/x/y") == svc.NOT_FOUND, "mem: three levels need parents")
    check(fsbackend.make_dir("/a/we ird") == svc.OK, "mem: spaces are fine")
    check(fsbackend.make_dir("") == svc.INVALID, "mem: empty path")
    var i: usize = 0
    var made: usize = 0
    while i < 600 {
        if memtree.write_file("/f", "x".p as u64, 1) == svc.OK { made = made + 1 }
        i = i + 1
    }
    check(made == 600, "mem: overwrite does not grow the table")
    rt.buf_free(&names)
    rt.buf_free(&data)
}

fn test_native() {
    fsbackend.use_memory_tree(false)
    let base: str = fs.temp_dir() + "/fm_mut_test"
    fs.remove_tree(base) catch false
    check(fsbackend.make_dir(base) == svc.OK, "native: make folder")
    check(fsbackend.make_dir(base) == svc.EXISTS, "native: folder twice is exists")
    check(fsbackend.make_dir(base + "/a/b") == svc.NOT_FOUND, "native: missing parent")
    check(fsbackend.make_dir(base + "/a") == svc.OK, "native: nested folder")
    fs.write_file(base + "/a/f.txt", "hi".p as u64, 2) catch 0
    check(fsbackend.rename(base + "/a/f.txt", base + "/a/g.txt") == svc.OK, "native: rename file")
    check(fsbackend.rename(base + "/a/g.txt", base + "/a") == svc.EXISTS, "native: rename onto existing")
    check(fsbackend.rename(base + "/nothing", base + "/x") == svc.NOT_FOUND, "native: rename missing")
    check(fsbackend.remove(base + "/a") == svc.NOT_EMPTY, "native: non-empty folder refused")
    check(fsbackend.remove(base + "/a/g.txt") == svc.OK, "native: remove file")
    check(fsbackend.remove(base + "/a") == svc.OK, "native: remove folder")
    check(fsbackend.remove(base + "/a") == svc.NOT_FOUND, "native: remove twice")
    check(fsbackend.remove("") == svc.INVALID, "native: empty path")
    check(svc.has(svc.CAP_DIR_MUTATE), "native: capability set")
    check(!svcmut.valid_name("a/b") && !svcmut.valid_name("..") && svcmut.valid_name("ok name.txt"), "name validation")
    fs.remove_tree(base) catch false
}

fn main(start: u64) -> i32 {
    test_memory()
    test_native()
    if BAD > 0 {
        say("FAILED\n")
        return 1
    }
    say("memtree: all ok\n")
    return 0
}
