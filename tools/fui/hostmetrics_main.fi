// SPDX-License-Identifier: MPL-2.0
// tools/fui/hostmetrics_main.fi -- W44-c: the host's SAFE AREA (insets) and TEXT SCALE.
//   hostmetrics_main      prints one line per check, exit 0 when all hold
// Pure part (lib/window/hostmetrics.fi): work-area overlap, number / scale parsing. Toolkit part (headless, no window): the theme's
// text scale changes ONLY text sizes (and only when set), `app.set_insets` puts the insets on the root column as padding, the
// default (nothing set) is unchanged -- the goldens depend on that.
import std.rt
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.widget
import fui.app
import fui.appctl
import fui.render
import paint.canvas
import plat.fuiwirt
import plat.sysfont
import window.hostmetrics

static mut BAD: usize = 0
static mut FONT: u64 = 0

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn num(tag: str, v: f64) {
    say(tag)
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v as i64)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn perm(s: str) -> usize {
    return hostmetrics.parse_scale_permille(s.p as u64, s.n)
}

fn ins(s: str, o: *mut [f64; 4]) -> bool {
    return hostmetrics.parse_insets(s.p as u64, s.n, o)
}

fn pure_checks() {
    var o: [f64; 4] = [0.0; 4]
    // a maximised window on a 1920x1080 screen with a 40 px bar at the top and a 48 px bar at the bottom
    check(hostmetrics.insets_overlap(0, 0, 1920, 1080, 0, 40, 1920, 992, &o)
        && o[0] == 0.0 && o[1] == 40.0 && o[2] == 0.0 && o[3] == 48.0, "overlap: window over the whole screen sees both bars")
    check(hostmetrics.insets_overlap(100, 100, 800, 600, 0, 40, 1920, 992, &o)
        && o[0] == 0.0 && o[1] == 0.0 && o[2] == 0.0 && o[3] == 0.0, "overlap: a window inside the work area has no insets")
    check(hostmetrics.insets_overlap(0, 10, 800, 600, 0, 40, 1920, 992, &o) && o[1] == 30.0, "overlap: only the part under the bar counts (30 of 40)")
    check(hostmetrics.insets_screen(1080, 2400, 0, 96, 1080, 2208, &o) && o[1] == 96.0 && o[3] == 96.0 && o[0] == 0.0,
        "screen insets: phone 1080x2400, status bar 96 + nav bar 96")
    check(!hostmetrics.insets_overlap(2500, 100, 800, 600, 0, 40, 1920, 992, &o) && o[0] == 0.0 && o[3] == 0.0,
        "overlap: a window on another monitor gives no answer (and zeros)")
    check(!hostmetrics.insets_overlap(0, 0, 0, 0, 0, 0, 100, 100, &o), "overlap: empty rectangles give no answer")
    check(hostmetrics.insets_overlap(0, 0, 100, 100, 60, 60, 200, 200, &o) == false, "overlap: centre outside the work area = no answer")
    check(hostmetrics.insets_overlap(0, 0, 100, 100, -500, -500, 1000, 1000, &o) && o[0] == 0.0 && o[1] == 0.0, "overlap: a bigger work area = zero insets")
    // clamp: a bar can never cover more than half the window
    check(hostmetrics.insets_overlap(0, 0, 100, 100, 0, 0, 100, 100, &o) && o[0] == 0.0, "overlap: window == work area is zero")
    check(hostmetrics.insets_overlap(0, 0, 100, 100, 40, 0, 100, 100, &o) && o[0] == 40.0, "overlap: a bar over the left 40 px")
    check(hostmetrics.insets_overlap(0, 0, 100, 100, 49, 0, 100, 100, &o) && o[0] == 49.0 && o[0] <= 50.0, "overlap: left inset never beyond half the window")
    // number and scale parsing
    check(perm("1.25") == 1250 && perm("'1.25'\n") == 1250 && perm("1.0") == 1000 && perm("2") == 2000, "scale: GNOME decimals 1.25 / '1.25' / 1.0 / 2")
    check(perm("uint32 125") == 1250 && perm("150") == 1500 && perm("225") == 2250, "scale: percentages from 10 on (125 -> 1.25)")
    check(perm("") == 0 && perm("abc") == 0 && perm("0") == 0 && perm("0.0") == 0, "scale: no number / zero = unknown")
    check(perm("0.1") == 500 && perm("9.9") == 3000 && perm("5000") == 3000, "scale: clamped to 0.5 .. 3.0")
    check(hostmetrics.scale_from_percent(100) == 1000 && hostmetrics.scale_from_percent(225) == 2250 && hostmetrics.scale_from_percent(0) == 0
        && hostmetrics.scale_from_percent(9999) == 3000, "scale: Windows TextScaleFactor percent (100..225)")
    check(hostmetrics.scale_from_factor(1.15) == 1150 && hostmetrics.scale_from_factor(-1.0) == 0 && hostmetrics.scale_from_factor(0.0) == 0,
        "scale: Android fontScale float 1.15 -> 1150")
    check(ins("0,40,0,30", &o) && o[0] == 0.0 && o[1] == 40.0 && o[2] == 0.0 && o[3] == 30.0, "insets text: 0,40,0,30")
    check(ins(" 1.5 ; 2 : 3 / 4 ", &o) && o[0] == 1.5 && o[3] == 4.0, "insets text: any separator, decimals")
    var z: [f64; 4] = [7.0; 4]
    check(!ins("1,2,3", &z) && z[0] == 7.0, "insets text: three numbers = refused, out untouched")
    check(!ins("1,2,-3,4", &z) && !ins("", &z) && !ins("a,b,c,d", &z), "insets text: negative / empty / words refused")
    check(hostmetrics.inset_points(96.0, 1000) == 96 && hostmetrics.inset_points(120.0, 1250) == 96 && hostmetrics.inset_points(0.0, 1000) == 0,
        "inset_points: px to design points at the UI scale")
    check(hostmetrics.scale_text_px(14, 1000) == 14 && hostmetrics.scale_text_px(14, 1250) == 18 && hostmetrics.scale_text_px(1, 500) == 1
        && hostmetrics.scale_text_px(0, 2000) == 0, "scale_text_px: 14 at 125 % = 18 (17.5 rounds up), never to 0")
    android_checks()
}

// r382: the Android JNI answers (lib/android/hostinfo.fi) as pure conversions.
fn android_checks() {
    var o: [f64; 4] = [0.0; 4]
    var r: [f64; 4] = [0.0; 4]
    hostmetrics.insets_from_ints(0, 63, 0, 126, 1080, 2400, &o)
    check(o[0] == 0.0 && o[1] == 63.0 && o[2] == 0.0 && o[3] == 126.0, "android ints: status bar 63 / nav bar 126 pass unchanged")
    hostmetrics.insets_from_ints(-5, -1, 7, -9, 1080, 2400, &o)
    check(o[0] == 0.0 && o[1] == 0.0 && o[2] == 7.0 && o[3] == 0.0, "android ints: negative = 0")
    hostmetrics.insets_from_ints(900, 1500, 10, 2000, 1080, 2400, &o)
    check(o[0] == 540.0 && o[1] == 1200.0 && o[2] == 10.0 && o[3] == 1200.0, "android ints: each side at most half the window")
    hostmetrics.insets_from_ints(900, 1500, 0, 0, 0, 0, &o)
    check(o[0] == 900.0 && o[1] == 1500.0, "android ints: window size 0 = no limit")
    var c: [f64; 4] = [3000.0, 2.0, 0.0, 1.0]
    hostmetrics.insets_clamp(&c, 1000, 1000)
    check(c[0] == 500.0 && c[1] == 2.0 && c[3] == 1.0, "clamp: in place")
    var a: [f64; 4] = [0.0, 63.0, 0.0, 126.0]
    hostmetrics.insets_minus_content(&a, 0, 0, 0, 0, 1080, 2400, &r)
    check(r[1] == 63.0 && r[3] == 126.0, "minus_content: no content rectangle = insets pass")
    hostmetrics.insets_minus_content(&a, 0, 63, 1080, 2211, 1080, 2400, &r)
    check(r[0] == 0.0 && r[1] == 0.0 && r[2] == 0.0 && r[3] == 0.0 && 63 + 2211 + 126 == 2400,
        "minus_content: bars the window already leaves out are not counted twice")
    hostmetrics.insets_minus_content(&a, 0, 63, 1080, 1737, 1080, 2400, &r)
    check(r[1] == 0.0 && r[3] == 0.0, "minus_content: keyboard larger than nav bar shrinks the content rect = still handled")
    var k: [f64; 4] = [0.0, 63.0, 0.0, 700.0]
    hostmetrics.insets_minus_content(&k, 0, 63, 1080, 2211, 1080, 2400, &r)
    check(r[1] == 0.0 && r[3] == 574.0, "minus_content: keyboard 700 - nav margin 126 = 574 left over")
    hostmetrics.insets_minus_content(&k, 0, 0, 1080, 2400, 1080, 2400, &r)
    check(r[1] == 63.0 && r[3] == 700.0, "minus_content: full-size content rect = edge to edge, insets pass")
    hostmetrics.insets_minus_content(&k, 0, 63, 1080, 2211, 1080, 2400, &k)
    check(k[3] == 574.0, "minus_content: out may be the input")
    check(hostmetrics.insets_same(&a, &a) && !hostmetrics.insets_same(&a, &r), "insets_same: equal / different")
    var q: [f64; 4] = [0.0, 63.1, 0.0, 126.0]
    check(hostmetrics.insets_same(&a, &q), "insets_same: within a quarter pixel")
    check(hostmetrics.INSET_TYPES_ALL == 143 && hostmetrics.DISPLAY_CUTOUT_MASK == 128, "WindowInsets.Type mask constants")
    check(hostmetrics.scale_from_factor(1.3) == 1300 && hostmetrics.scale_from_factor(0.85) == 850 && hostmetrics.scale_from_factor(3.5) == 3000,
        "fontScale: 1.3 / 0.85 / clamp 3.5")
}


fn toolkit_checks() {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("hostmetrics: no font (DejaVu Sans)\n")
        BAD = BAD + 1
        return
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Insets", 400, 300)
    let lb: usize = app.label(a, "Text scale probe", 0)
    let s: *mut Surface = surface_for(a, 400, 300)
    let sc: *mut scene.Scene = app.app_scene(a)
    let m: *mut theme.Theme = app.app_theme(a)
    settle(a, s)
    let x0: f64 = scene.node_x(sc, lb)
    let y0: f64 = scene.node_y(sc, lb)
    let w0: f64 = scene.node_w(sc, lb)
    let h0: f64 = scene.node_h(sc, lb)
    check(theme.theme_text_scale(m) == 1000 && app.inset(a, 0) == 0.0, "default: text scale 1000, no insets")
    check(theme.theme_text_px(m, 14) == theme.theme_px(m, 14), "default: theme_text_px == theme_px (the goldens depend on it)")
    // ---- text scale
    app.set_text_scale(a, 1500)
    settle(a, s)
    let w1: f64 = scene.node_w(sc, lb)
    let h1: f64 = scene.node_h(sc, lb)
    num("  label width  1000 -> 1500: ", w0)
    num("                             ", w1)
    check(theme.theme_text_scale(m) == 1500 && theme.theme_text_px(m, 14) == 21 && theme.theme_px(m, 14) == 14,
        "text scale 150 %: font 14 -> 21, a plain length (14) stays 14")
    check(w1 > w0 * 1.3 && h1 > h0, "the label (text only) is wider and taller at 150 %")
    app.set_text_scale(a, 1000)
    settle(a, s)
    check(scene.node_w(sc, lb) == w0 && scene.node_h(sc, lb) == h0, "back to 1000: the very same size as before")
    app.set_text_scale(a, 0)
    check(theme.theme_text_scale(m) == 1000, "0 = off (1000)")
    app.set_text_scale(a, 99999)
    check(theme.theme_text_scale(m) == 3000, "clamped to 3000")
    app.set_text_scale(a, 1000)
    // ---- insets: padding on the root column (the column centres its child, so a top inset of 40 moves the label 20 down)
    app.set_insets(a, 0.0, 40.0, 0.0, 0.0)
    settle(a, s)
    check(app.inset(a, 1) == 40.0 && app.inset(a, 3) == 0.0 && app.inset(a, 0) == 0.0 && app.inset(a, 7) == 0.0, "insets are kept (bad side = 0)")
    num("  label y before / with a top inset of 40: ", y0)
    num("                                           ", scene.node_y(sc, lb))
    check(near(scene.node_y(sc, lb), y0 + 20.0, 1.0) && scene.node_x(sc, lb) == x0, "top inset 40: the content moves down 20 (padding 16 -> 56), x unchanged")
    app.set_insets(a, 120.0, 0.0, 0.0, 0.0)
    settle(a, s)
    check(near(scene.node_x(sc, lb), x0 + 60.0, 1.0) && near(scene.node_y(sc, lb), y0, 0.5), "left inset 120: the content moves 60 right")
    app.set_insets(a, 0.0, 0.0, 0.0, 60.0)
    settle(a, s)
    check(near(scene.node_y(sc, lb), y0 - 30.0, 1.0), "bottom inset 60: the content moves 30 up")
    app.set_insets(a, 0.0, 0.0, 0.0, 0.0)
    settle(a, s)
    check(scene.node_y(sc, lb) == y0 && scene.node_x(sc, lb) == x0, "all zero: the layout is as before")
    // the HiDPI case: insets are device pixels, padding is in design points
    theme.theme_set_scale(m, 2000)
    settle(a, s)
    let y2: f64 = scene.node_y(sc, lb)
    app.set_insets(a, 0.0, 80.0, 0.0, 0.0)
    settle(a, s)
    check(near(scene.node_y(sc, lb), y2 + 40.0, 1.0), "UI scale 200 %: 80 device px = 40 points = 80 px of padding -> 40 px shift")
    theme.theme_set_scale(m, 1000)
    app.set_insets(a, 0.0, 0.0, 0.0, 0.0)
    settle(a, s)
    check(scene.node_y(sc, lb) == y0, "and back")
}

fn main(start: u64) -> i32 {
    pure_checks()
    toolkit_checks()
    if BAD == 0 {
        say("HOSTMETRICS PASSED\n")
        return 0
    }
    say("HOSTMETRICS FAILED\n")
    return 1
}
