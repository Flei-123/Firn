// SPDX-License-Identifier: MPL-2.0
// tools/fui/belegpruef_main.fi -- THE PROOFS ARE RE-CALCULATED.
//
// ========================================================= WHY IT EXISTS
//
// A proof image is written, the run prints "ALL CHECKS PASSED"
// -- and nobody ever LOOKED INTO it. That is exactly how in OrientOS a
// surface without a single letter got through the acceptance:
// the file was there, it was even large, it was just empty.
// An image that merely CAME INTO BEING proves nothing.
//
// This program reads every generated PNG back IN with `paint/png.decode_png`
// and re-calculates three things that an empty or half-painted
// canvas cannot pass:
//
//   1. THE DIMENSIONS. Width and height stand in the call and come
//      from the program that painted the image. A canvas that is
//      suddenly of a different size is a cut-off proof.
//   2. THE NUMBER OF DISTINCT COLOURS. An emptied canvas has a
//      single one; an image with text, edges and gradients has hundreds.
//      Counting is done with an open hash table (4096 slots) --
//      from `MAX_FARBEN` on it is not counted further, the limit suffices.
//   3. THE SHARE OF NON-BACKGROUND PIXELS PER BAND. The image is cut into
//      `BAENDER` horizontal bands, and in EVERY one something must
//      stand. That is the check that an image does not pass
//      whose lower half stayed empty, because a drawing loop broke off too
//      early -- the error that you overlook on a thumbnail.
//
// The background is NOT guessed: it is the colour of the pixel
// (2,2), so of the corner into which no proof paints anything. A pixel counts
// as "not background" if one of its three channels differs by more
// than `TOLERANZ` -- otherwise the noise of an edge smoothing would count
// as content.
//
//     belegpruef_main <bild.png> <breite> <h_min> <h_max> <min_farben>
//
// The width stands EXACTLY fixed; for the height a range is
// given, because three proofs cut their canvas to the
// content (fui-wave2 is three rows shorter in the dark scheme than
// in the light). The upper limit is the height of the canvas from the
// painting program -- cutting is possible only downwards --,
// the lower one pins down that really the whole set was painted and
// not only the header row.
//
// Every violation is named on fd 1, and the return value is
// then 1: `set -e` in tools/fui/run.sh aborts the run with it.
//
// ====================================================== THE SECOND MODE
//
//     belegpruef_main --ketten <schrift.ttf|-> <breite> <quelle.fi> ...
//
// THE ERROR THAT WAS CALLED "red fixe". In tools/fui/gallery_main.fi there stood
// `var t_v3: [u8; 10] = "red fixed "`, of which 8 bytes were painted, and
// in the proof a checker read "red fixe". No program crashed,
// no pixel was wrong, the colour count was right, every band was painted --
// and the word was broken nevertheless. A proof with half a word
// proves the opposite of what it claims.
//
// This mode reads the SOURCES of the proof programs and calculates
// for every painted label two numbers:
//
//   1. THE CHAIN LENGTH AGAINST THE FIELD LENGTH. For every use
//      `(&name[0]) as u64, M` the associated declaration
//      `var name: [u8; N] = "..."` is looked for (the nearest one before it, so
//      the same that the translator takes). Required is
//      N - padding <= M <= N: the WHOLE chain is painted.
//      "Padding" are the trailing spaces, `\0` and `\n` of the
//      literal -- they carry no word, and a label that leaves them
//      out is no truncated label.
//   2. THE TARGET WIDTH AGAINST THE CANVAS. The same chain is measured with
//      `render.pref_of` -- with the measuring protocol of the
//      library itself, not with an estimate next to it -- and
//      must fit at `MESS_PX` points of font size into the canvas of the
//      proof (width minus twice `RAND`). A text that is wider
//      than the sheet can stand in the picture only cut off. Without a font ("-") and
//      without a width (0) this second calculation is omitted, so that the length check also runs
//      when no TTF file is reachable.
//
// Checked are the PAINTED uses, and "painted" is determined from the
// other side (see `wird_gemalt`): a chain counts as
// painted as long as in its three lines before it there stands no call that prints it
// or merely measures it (`report`, `buf_push_*`,
// `write_everything`, `text_width`, `run_width`, `c_length`, `mem_eq`,
// `read_file`). There a piece of a chain is intended --
// tools/fui/contrast_main.fi writes "dE " and appends the number --
// and this check is not responsible for that. Likewise unchecked stay
// uses that do NOT begin at byte 0 (`(&t[3])`): they never
// claim to paint the whole chain.
import std.rt
import paint.png
import paint.canvas
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render

const BAENDER: usize = 6
// How much of a band must be painted. A thousandth is little
// and nevertheless sharp: an EMPTY band has zero, and even a band
// in which only one line of text stands lies above it (a 1240x764 image
// has around 158000 pixels per band, a thousandth of that is 158).
const MIN_PROMILLE: i64 = 1
const TOLERANZ: i64 = 8
const SLOTS: usize = 4096
const MAX_FARBEN: usize = 2000

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    var w: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&w[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// A decimal number from the command line. Everything that is not a digit
// ends the number -- the terminating null byte likewise.
fn number_of(p: u64) -> i64 {
    var v: i64 = 0
    var i: usize = 0
    while i < 20 {
        let c: u32 = rt.ld8(p, i) as u32
        if c < 48 as u32 || c > 57 as u32 {
            return v
        }
        v = v * 10 + ((c - 48 as u32) as i64)
        i = i + 1
    }
    return v
}

// The name of the file into the message -- without it nobody knows WHICH
// proof is broken.
fn say_file(p: u64) {
    var t: rt.Buf = rt.buf_new()
    var k: [u8; 8] = "BELEG:  "
    rt.buf_push_bytes(&t, (&k[0]) as u64, 8)
    rt.buf_push_bytes(&t, p, rt.c_length(p))
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// THE COLOURS. Open addressing with linear probing; 0 means
// "slot free", so the colour is OR-ed with 1 before it is
// stored (the alpha channel of a proof is always 255, the
// lowest bit position of the blue level does not matter here --
// what is counted is the VARIETY, not the individual colour).
fn color_new(tab: *mut u64, c: u32) -> bool {
    let key: u64 = (c as u64) | 1099511627776 as u64
    var h: usize = (((c as u64) * 2654435761 as u64) >> 13) as usize
    var i: usize = 0
    while i < SLOTS {
        let j: usize = (h + i) & (SLOTS - 1)
        let slot: *mut u64 = ((tab as u64) + (j * 8) as u64) as *mut u64
        if *slot == 0 as u64 {
            *slot = key
            return true
        }
        if *slot == key {
            return false
        }
        i = i + 1
    }
    return false
}

fn distance(a: u32, b: u32) -> i64 {
    var d: i64 = (a as i64) - (b as i64)
    if d < 0 {
        d = 0 - d
    }
    return d
}

fn other(a: u32, b: u32) -> bool {
    if distance((a >> 16) & 255 as u32, (b >> 16) & 255 as u32) > TOLERANZ {
        return true
    }
    if distance((a >> 8) & 255 as u32, (b >> 8) & 255 as u32) > TOLERANZ {
        return true
    }
    return distance(a & 255 as u32, b & 255 as u32) > TOLERANZ
}

// ======================================================================
// THE LABELS, MEASURED INSTEAD OF GUESSED
// ======================================================================
//
// From here on it is no longer the image that is read, but the SOURCE that painted
// it. Why stands in the head of this file; in short: an image on which
// "red fixe" stands cannot be told from the outside from a correct one
// -- the number that is missing for that stands in the source.

// The size at which a label is measured. It is the
// size of the header rows of the proofs (15 points) and thereby the
// most unfavourable one that occurs in the sheet: what fits at 15 points
// fits all the more at 12.
const MEAS_PX: usize = 15
// The margin that a proof leaves free left and right. All
// proof programs set their first column at 24 points.
const RAND: i64 = 24
// This many field statements per file are carried along. The densest file
// of the tree (tools/fui/anim_main.fi) has 90.
const MAX_FIELDS: usize = 256

fn at(p: u64, i: usize) -> u32 {
    return rt.ld8(p, i) as u32
}

fn is_namechar(ch: u32) -> bool {
    if ch >= 97 as u32 && ch <= 122 as u32 {
        return true
    }
    if ch >= 65 as u32 && ch <= 90 as u32 {
        return true
    }
    if ch >= 48 as u32 && ch <= 57 as u32 {
        return true
    }
    return ch == 95 as u32
}

fn is_empty(ch: u32) -> bool {
    if ch == 32 as u32 || ch == 9 as u32 {
        return true
    }
    return ch == 10 as u32 || ch == 13 as u32
}

fn is_digit(ch: u32) -> bool {
    return ch >= 48 as u32 && ch <= 57 as u32
}

fn fits(p: u64, n: usize, i: usize, lit: u64, ln: usize) -> bool {
    if i + ln > n {
        return false
    }
    return rt.mem_eq(p + (i as u64), lit, ln)
}

fn over_empty(p: u64, n: usize, i: usize) -> usize {
    var j: usize = i
    while j < n && is_empty(at(p, j)) {
        j = j + 1
    }
    return j
}

// The line number of a place -- without it a human searches for the
// reported chain in eight hundred lines himself.
fn line_of(p: u64, pos: usize) -> i64 {
    var z: i64 = 1
    var i: usize = 0
    while i < pos {
        if at(p, i) == 10 as u32 {
            z = z + 1
        }
        i = i + 1
    }
    return z
}

fn such(p: u64, von: usize, bis: usize, lit: u64, ln: usize) -> bool {
    var i: usize = von
    while i + ln <= bis {
        if rt.mem_eq(p + (i as u64), lit, ln) {
            return true
        }
        i = i + 1
    }
    return false
}

// IS THIS CHAIN PAINTED?
//
// What is asked is not WHICH function takes the text -- that is called differently in
// every proof program (`label`, `kachel`, `reihe`, `uebergang`)
// and a list of them would be incomplete the day after. What is asked is
// the opposite: a chain counts as painted AS LONG AS NOTHING SPEAKS
// AGAINST IT. What speaks against it are the calls that write a chain to fd 1 or
// fd 2 or merely measure it -- there a piece of a
// chain is intended (tools/fui/contrast_main.fi writes "dE " and appends
// the number, tools/fui/wave2_main.fi deliberately measures one byte
// fewer, to show that the last letter carries width).
//
// This direction covers 378 of the chains of the tree instead of 151, and it
// does not become wrong if somebody writes a new proof program with a
// new helper function: a new label is then checked
// by itself, and not only when somebody thinks of it.
fn becomes_painted(p: u64, pos: usize) -> bool {
    var von: usize = pos
    var lines: usize = 0
    while von > 0 && lines < 3 {
        von = von - 1
        if at(p, von) == 10 as u32 {
            lines = lines + 1
        }
    }
    var m1: [u8; 6] = "report"
    if such(p, von, pos, (&m1[0]) as u64, 6) {
        return false
    }
    var m2: [u8; 9] = "buf_push_"
    if such(p, von, pos, (&m2[0]) as u64, 9) {
        return false
    }
    var m3: [u8; 16] = "write_everything"
    if such(p, von, pos, (&m3[0]) as u64, 16) {
        return false
    }
    var m4: [u8; 10] = "text_width"
    if such(p, von, pos, (&m4[0]) as u64, 10) {
        return false
    }
    var m5: [u8; 9] = "run_width"
    if such(p, von, pos, (&m5[0]) as u64, 9) {
        return false
    }
    var m6: [u8; 8] = "c_length"
    if such(p, von, pos, (&m6[0]) as u64, 8) {
        return false
    }
    var m7: [u8; 6] = "mem_eq"
    if such(p, von, pos, (&m7[0]) as u64, 6) {
        return false
    }
    var m8: [u8; 9] = "read_file"
    return !such(p, von, pos, (&m8[0]) as u64, 9)
}

// THE TARGET WIDTH OF A LABEL, BY THE WAY OF THE LIBRARY.
// Measuring is done with `render.pref_of` and not with a summation of its
// own next to it: there is one place for the measuring protocol, and
// that is lib/fui/render.fi.
fn meas_width(c: *mut render.Ctx, p: u64, n: usize) -> f64 {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, 0.0, 0.0, 100.0, 18.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_font(*s, 0, MEAS_PX)
    *s = style.style_set_pad(*s, 0, 0)
    var pw: f64 = 0.0
    var ph: f64 = 0.0
    render.pref_of(c, &e, &pw, &ph)
    return pw
}

// A truncated chain is NAMED: file, line, name, painted
// length, field length. Exactly this line was missing when "red
// fixed " became eight bytes.
fn say_clipped(path: u64, line: i64, name: u64, nl: usize,
    painted: i64, field: i64) {
    var t: rt.Buf = rt.buf_new()
    var k1: [u8; 14] = "  BESCHNITTEN "
    rt.buf_push_bytes(&t, (&k1[0]) as u64, 14)
    rt.buf_push_bytes(&t, path, rt.c_length(path))
    rt.buf_push(&t, 58 as u8)
    rt.buf_push_dec_i64(&t, line)
    var k2: [u8; 2] = "  "
    rt.buf_push_bytes(&t, (&k2[0]) as u64, 2)
    rt.buf_push_bytes(&t, name, nl)
    var k3: [u8; 9] = ": gemalt "
    rt.buf_push_bytes(&t, (&k3[0]) as u64, 9)
    rt.buf_push_dec_i64(&t, painted)
    var k4: [u8; 14] = " Byte von Feld"
    rt.buf_push_bytes(&t, (&k4[0]) as u64, 14)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, field)
    var k5: [u8; 25] = " -- die Kette ist kuerzer"
    rt.buf_push_bytes(&t, (&k5[0]) as u64, 25)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// A label that is wider than the sheet. It too stands in the
// picture only cut off -- only this time the canvas cuts.
fn say_too_wide(path: u64, line: i64, name: u64, nl: usize,
    hat: i64, may: i64) {
    var t: rt.Buf = rt.buf_new()
    var k1: [u8; 12] = "  ZU BREIT  "
    rt.buf_push_bytes(&t, (&k1[0]) as u64, 12)
    rt.buf_push_bytes(&t, path, rt.c_length(path))
    rt.buf_push(&t, 58 as u8)
    rt.buf_push_dec_i64(&t, line)
    var k2: [u8; 2] = "  "
    rt.buf_push_bytes(&t, (&k2[0]) as u64, 2)
    rt.buf_push_bytes(&t, name, nl)
    var k3: [u8; 10] = ": braucht "
    rt.buf_push_bytes(&t, (&k3[0]) as u64, 10)
    rt.buf_push_dec_i64(&t, hat)
    var k4: [u8; 21] = " Punkt, das Blatt hat"
    rt.buf_push_bytes(&t, (&k4[0]) as u64, 21)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, may)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// The summary of a file, with numbers: this many painted chains
// stood in it, this many were truncated, this wide was the widest.
fn say_file_chains(path: u64, chains: i64, schlimm: i64, breitest: i64,
    limit: i64, measure: bool) {
    var t: rt.Buf = rt.buf_new()
    var k0: [u8; 2] = "  "
    rt.buf_push_bytes(&t, (&k0[0]) as u64, 2)
    rt.buf_push_bytes(&t, path, rt.c_length(path))
    var i: usize = rt.c_length(path)
    while i < 32 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    rt.buf_push_dec_i64(&t, chains)
    var k1: [u8; 22] = " gemalte Ketten, davon"
    rt.buf_push_bytes(&t, (&k1[0]) as u64, 22)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, schlimm)
    var k2: [u8; 12] = " beschnitten"
    rt.buf_push_bytes(&t, (&k2[0]) as u64, 12)
    if measure {
        var k3: [u8; 14] = ", breiteste = "
        rt.buf_push_bytes(&t, (&k3[0]) as u64, 14)
        rt.buf_push_dec_i64(&t, breitest)
        var k4: [u8; 4] = " of "
        rt.buf_push_bytes(&t, (&k4[0]) as u64, 4)
        rt.buf_push_dec_i64(&t, limit)
        var k5: [u8; 6] = " Punkt"
        rt.buf_push_bytes(&t, (&k5[0]) as u64, 6)
    }
    if schlimm == 0 {
        var o: [u8; 5] = "  OK\n"
        rt.buf_push_bytes(&t, (&o[0]) as u64, 5)
    } else {
        var o: [u8; 8] = "  WRONG\n"
        rt.buf_push_bytes(&t, (&o[0]) as u64, 8)
    }
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// ONE SOURCE, CALCULATED THROUGH. Returned is the number of violations,
// or -1 if the file was not readable (that too is one: a
// check that does not find its source has checked nothing).
fn chains_file(c: *mut render.Ctx, path: u64, width: i64,
    measure: bool) -> i64 {
    var roh: rt.Buf = rt.buf_new()
    if !rt.read_file(path, &roh) {
        var e1: [u8; 32] = "  QUELLE FEHLT, nicht geprueft: "
        rt.write_everything(1, (&e1[0]) as u64, 32)
        rt.write_everything(1, path, rt.c_length(path))
        var nl: [u8; 1] = "\n"
        rt.write_everything(1, (&nl[0]) as u64, 1)
        rt.buf_free(&roh)
        return -1
    }
    let p: u64 = rt.buf_ptr(&roh)
    let n: usize = rt.buf_len(&roh)
    // The field statements of this file, in the order of the source text.
    // A use belongs to the NEAREST one before it -- the same that
    // the translator takes.
    var d_pos: [usize; 256] = [0; 256]
    var d_no: [usize; 256] = [0; 256]
    var d_nl: [usize; 256] = [0; 256]
    var d_field: [usize; 256] = [0; 256]
    var d_pad: [usize; 256] = [0; 256]
    var d_lit: [usize; 256] = [0; 256]
    var d_esc: [usize; 256] = [0; 256]
    var nd: usize = 0
    var chains: i64 = 0
    var schlimm: i64 = 0
    var breitest: i64 = 0
    let limit: i64 = width - 2 * RAND
    var mfeld: [u8; 4] = "[u8;"
    var mnull: [u8; 4] = "[0])"
    var mas: [u8; 2] = "as"
    var mu64: [u8; 3] = "u64"
    var i: usize = 0
    while i < n {
        let b: u32 = at(p, i)
        if b == 47 as u32 && i + 1 < n && at(p, i + 1) == 47 as u32 {
            // A comment. What stands in it is painted by nobody.
            while i < n && at(p, i) != 10 as u32 {
                i = i + 1
            }
        } else if b == 34 as u32 {
            // A string that belongs to no field statement (say
            // an address with "//" in it). It is skipped,
            // so that its content is not read as source text.
            i = i + 1
            while i < n && at(p, i) != 34 as u32 {
                if at(p, i) == 92 as u32 {
                    i = i + 1
                }
                i = i + 1
            }
            i = i + 1
        } else if fits(p, n, i, (&mfeld[0]) as u64, 4) {
            var j: usize = over_empty(p, n, i + 4)
            var field: usize = 0
            var digits: usize = 0
            while j < n && is_digit(at(p, j)) {
                field = field * 10 + ((at(p, j) - 48 as u32) as usize)
                j = j + 1
                digits = digits + 1
            }
            j = over_empty(p, n, j)
            if digits == 0 || j >= n || at(p, j) != 93 as u32 {
                i = i + 4
            } else {
                j = over_empty(p, n, j + 1)
                // The name stands BEFORE the field statement: "name: [u8; N]".
                var q: usize = i
                var no: usize = 0
                var nlen: usize = 0
                while q > 0 && is_empty(at(p, q - 1)) {
                    q = q - 1
                }
                if q > 0 && at(p, q - 1) == 58 as u32 {
                    q = q - 1
                    while q > 0 && is_empty(at(p, q - 1)) {
                        q = q - 1
                    }
                    let end: usize = q
                    while q > 0 && is_namechar(at(p, q - 1)) {
                        q = q - 1
                    }
                    no = q
                    nlen = end - q
                }
                var lit: usize = 0
                var pad: usize = 0
                var esc: usize = 0
                var next: usize = i + 4
                if j < n && at(p, j) == 61 as u32 {
                    let k0: usize = over_empty(p, n, j + 1)
                    if k0 < n && at(p, k0) == 34 as u32 {
                        lit = k0 + 1
                        var k: usize = lit
                        while k < n && at(p, k) != 34 as u32 {
                            if at(p, k) == 92 as u32 {
                                esc = 1
                                k = k + 2
                            } else {
                                k = k + 1
                            }
                        }
                        // THE PADDING AT THE END. Trailing
                        // spaces, `\0` and `\n` carry no word:
                        // a chain that leaves them out is not
                        // truncated, but only not padded.
                        var e: usize = k
                        var done: bool = false
                        while !done {
                            if e > lit && at(p, e - 1) == 32 as u32 {
                                e = e - 1
                                pad = pad + 1
                            } else if e > lit + 1 && at(p, e - 2) == 92 as u32
                            && (at(p, e - 1) == 48 as u32
                                || at(p, e - 1) == 110 as u32) {
                                e = e - 2
                                pad = pad + 1
                            } else {
                                done = true
                            }
                        }
                        next = k + 1
                    }
                }
                if nlen > 0 && nd < MAX_FIELDS {
                    d_pos[nd] = i
                    d_no[nd] = no
                    d_nl[nd] = nlen
                    d_field[nd] = field
                    d_pad[nd] = pad
                    d_lit[nd] = lit
                    d_esc[nd] = esc
                    nd = nd + 1
                }
                i = next
            }
        } else if fits(p, n, i, (&mnull[0]) as u64, 4) {
            // A use "(&name[0]) as u64, M" -- so the
            // claim to paint the WHOLE chain.
            var q: usize = i
            while q > 0 && is_namechar(at(p, q - 1)) {
                q = q - 1
            }
            let nlen: usize = i - q
            var painted: usize = 0
            var gut: bool = false
            if nlen > 0 {
                var j: usize = over_empty(p, n, i + 4)
                if fits(p, n, j, (&mas[0]) as u64, 2) {
                    j = over_empty(p, n, j + 2)
                    if fits(p, n, j, (&mu64[0]) as u64, 3) {
                        j = over_empty(p, n, j + 3)
                        if j < n && at(p, j) == 44 as u32 {
                            j = over_empty(p, n, j + 1)
                            var st: usize = 0
                            while j < n && is_digit(at(p, j)) {
                                painted = painted * 10
                                +((at(p, j) - 48 as u32) as usize)
                                j = j + 1
                                st = st + 1
                            }
                            gut = st > 0
                        }
                    }
                }
            }
            if gut && becomes_painted(p, i) {
                var k: usize = nd
                var hit: usize = MAX_FIELDS
                while k > 0 {
                    k = k - 1
                    if d_pos[k] < i && d_nl[k] == nlen
                    && rt.mem_eq(p + (d_no[k] as u64), p + (q as u64),
                        nlen) {
                        hit = k
                        break
                    }
                }
                if hit < MAX_FIELDS && d_lit[hit] != 0 {
                    chains = chains + 1
                    let field: i64 = d_field[hit] as i64
                    let pad: i64 = d_pad[hit] as i64
                    let gz: i64 = painted as i64
                    if gz > field || gz + pad < field {
                        schlimm = schlimm + 1
                        say_clipped(path, line_of(p, i),
                            p + (d_no[hit] as u64), nlen, gz, field)
                    } else if measure && d_esc[hit] == 0 && limit > 0
                    && at(p, d_lit[hit]) != 60 as u32 {
                        // NO WIDTH FOR A DOCUMENT. A chain that
                        // begins with "<" is an SVG (tools/fui/
                        // artshow_main.fi holds its symbols as
                        // source text) and no label: it is
                        // rasterised, not set, and its 179 bytes
                        // say nothing about the width of the sheet. The
                        // LENGTH calculation still applies to it -- half an
                        // SVG is just as broken as half a
                        // word.
                        let need: f64 = meas_width(c,
                            p + (d_lit[hit] as u64), painted)
                        let ni: i64 = (need + 0.5) as i64
                        if ni > breitest {
                            breitest = ni
                        }
                        if ni > limit {
                            schlimm = schlimm + 1
                            say_too_wide(path, line_of(p, i),
                                p + (d_no[hit] as u64), nlen, ni, limit)
                        }
                    }
                }
            }
            i = i + 4
        } else {
            i = i + 1
        }
    }
    say_file_chains(path, chains, schlimm, breitest, limit,
        measure && limit > 0)
    rt.buf_free(&roh)
    return schlimm
}

// The mode "--ketten" from start to end: font and canvas
// once, then every named source.
fn chains_run(start: u64) -> i32 {
    let fpfad: u64 = rt.arg_ptr(start, 2)
    let width: i64 = number_of(rt.arg_ptr(start, 3))
    var measure: bool = true
    if rt.ld8(fpfad, 0) == 45 as u8 || width == 0 {
        // "-" instead of a font, or width 0: then only the
        // chain length is calculated. The length check needs no
        // font, and it is to run also on a machine without DejaVu.
        measure = false
    }
    var fbuf: rt.Buf = rt.buf_new()
    let fsp: *mut metrics.FontSet =
    rt.heap_alloc(4096) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if measure {
        if !rt.read_file(fpfad, &fbuf) {
            var ks: [u8; 54] = "  KETTEN: die Schrift ist nicht lesbar -- kein Beleg.\n"
            rt.write_everything(2, (&ks[0]) as u64, 54)
            return 9
        }
        if !metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            var kl: [u8; 49] = "  KETTEN: die Schrift laedt nicht -- kein Beleg.\n"
            rt.write_everything(2, (&kl[0]) as u64, 49)
            return 9
        }
        fm = fsp as u64
    }
    // A small canvas suffices: it is measured, not painted.
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, 64, 64) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, 64, 64) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(false)
    var c: render.Ctx = render.ctx_new(&m, &z)
    var schlimm: i64 = 0
    var i: usize = 4
    while i < rt.arg_count(start) {
        let r: i64 = chains_file(&c, rt.arg_ptr(start, i), width, measure)
        if r < 0 {
            schlimm = schlimm + 1
        } else {
            schlimm = schlimm + r
        }
        i = i + 1
    }
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    if schlimm != 0 {
        var f: [u8; 51] = "  EINE BESCHRIFTUNG IST BESCHNITTEN -- KEIN BELEG.\n"
        rt.write_everything(1, (&f[0]) as u64, 51)
        return 1
    }
    return 0
}

fn main(start: u64) -> i32 {
    // THE MODE STANDS IN THE FIRST WORD. "--ketten" reads sources
    // and re-calculates labels, everything else is an image.
    if rt.arg_count(start) >= 5 {
        var mk: [u8; 8] = "--ketten"
        if rt.c_length(rt.arg_ptr(start, 1)) == 8
        && rt.mem_eq(rt.arg_ptr(start, 1), (&mk[0]) as u64, 8) {
            return chains_run(start)
        }
    }
    if rt.arg_count(start) < 6 {
        var u: [u8; 59] = "belegpruef <png> <br> <hmin> <hmax> <farben> [rand] [seit]\n"
        rt.write_everything(2, (&u[0]) as u64, 59)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    let should_w: i64 = number_of(rt.arg_ptr(start, 2))
    let h_min: i64 = number_of(rt.arg_ptr(start, 3))
    let h_max: i64 = number_of(rt.arg_ptr(start, 4))
    let min_farben: i64 = number_of(rt.arg_ptr(start, 5))
    // THE HIGHEST EMPTY STRIP AT THE BOTTOM, as the sixth argument. If it is
    // missing, it is 0 and section 4 leaves the cut unchecked --
    // the proofs that do not cut their canvas call without it.
    var rand_max: i64 = 0
    if rt.arg_count(start) >= 7 {
        rand_max = number_of(rt.arg_ptr(start, 6))
    }
    // Whether air is also demanded left and right (seventh argument,
    // 1 = yes). See section 4.
    var pages: i64 = 0
    if rt.arg_count(start) >= 8 {
        pages = number_of(rt.arg_ptr(start, 7))
    }

    var roh: rt.Buf = rt.buf_new()
    if !rt.read_file(path, &roh) {
        var e1: [u8; 37] = "BELEG FEHLT: die Datei ist nicht da.\n"
        rt.write_everything(2, (&e1[0]) as u64, 37)
        say_file(path)
        return 1
    }
    var im: png.Image = png.image_new()
    if !png.decode_png(rt.buf_ptr(&roh), rt.buf_len(&roh), &im) {
        var e2: [u8; 42] = "BELEG UNLESBAR: kein gueltiges PNG darin.\n"
        rt.write_everything(2, (&e2[0]) as u64, 42)
        say_file(path)
        rt.buf_free(&roh)
        return 1
    }
    say_file(path)

    // ================================================ 1. DIE ABMESSUNGEN
    let w: usize = png.image_width(&im)
    let h: usize = png.image_height(&im)
    var n1: [u8; 22] = "1 the width as painted"
    report((&n1[0]) as u64, 22, (w as i64) == should_w, w as i64, should_w)
    var n2: [u8; 32] = "1 the height within its bounds  "
    report((&n2[0]) as u64, 30,
        (h as i64) >= h_min && (h as i64) <= h_max, h as i64, h_max)
    if (w as i64) != should_w || (h as i64) < h_min || (h as i64) > h_max ||
    w < 8 || h < 8 {
        png.image_free(&im)
        rt.buf_free(&roh)
        return 1
    }

    // ================ 2. THE VARIETY AND 3. THE CONTENT PER BAND
    let tab: *mut u64 = rt.heap_alloc(SLOTS * 8) as *mut u64
    if tab as usize == 0 {
        png.image_free(&im)
        rt.buf_free(&roh)
        return 3
    }
    rt.mem_set(tab as u64, 0 as u8, SLOTS * 8)
    let basic: u32 = png.image_pixel(&im, 2, 2) & 16777215 as u32
    var farben: usize = 0
    var full: [i64; 6] = [0; 6]
    let bh: usize = h / BAENDER
    var y: usize = 0
    while y < h {
        var b: usize = y / bh
        if b >= BAENDER {
            b = BAENDER - 1
        }
        var x: usize = 0
        while x < w {
            let c: u32 = png.image_pixel(&im, x, y) & 16777215 as u32
            if farben < MAX_FARBEN {
                if color_new(tab, c) {
                    farben = farben + 1
                }
            }
            if other(c, basic) {
                full[b] = full[b] + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    rt.heap_free(tab as u64, SLOTS * 8)

    var n3: [u8; 31] = "2 distinct colours in the image"
    report((&n3[0]) as u64, 31, (farben as i64) >= min_farben,
        farben as i64, min_farben)

    // The share per band in per mille. The last band carries the remainder
    // of the division, so its height is calculated separately --
    // otherwise with a height like 764 the last row falls into a
    // band that counts as empty.
    var i: usize = 0
    while i < BAENDER {
        var height: usize = bh
        if i == BAENDER - 1 {
            height = h - bh * (BAENDER - 1)
        }
        let pro: i64 = (full[i] * 1000) / ((height * w) as i64)
        var nb: [u8; 34] = "3 band 0: per mille painted over 0"
        // Write the band number into the message, so that you see
        // WHICH band stayed empty.
        nb[7] = (48 + i) as u8
        report((&nb[0]) as u64, 34, pro >= MIN_PROMILLE, pro, MIN_PROMILLE)
        i = i + 1
    }

    // ============================== 4. THE CUT AND THE MARGINS
    //
    // Section 3 asks only whether in every band there stands ANYTHING at all.
    // That overlooks exactly two errors that you see at once on the
    // sheet:
    //
    //   a) CUT OFF. An element that protrudes beyond the edge of the canvas
    //      leaves colour in the FIRST or LAST
    //      row or column. A cleanly set sheet has there
    //      its margin and nothing else -- every gallery of this tree
    //      begins with 20 points of air.
    //   b) AN EMPTY STRIP AT THE BOTTOM. Whoever sets the canvas to a
    //      constant instead of to the content delivers under the
    //      last band an empty block as well -- in the dark scheme
    //      a black bar that looks like a half-rendered proof.
    //      Allowed is the margin with which the sheet also begins at the top,
    //      plus some play; more is a cutting error.
    //
    // Measuring is done on the ACTUAL colour, not on a
    // constant of the painting program: `oben`/`unten` are the first
    // and the last row in which something stands.
    var top: i64 = 0 - 1
    var below: i64 = 0 - 1
    var left: i64 = 0 - 1
    var right: i64 = 0 - 1
    var yy: usize = 0
    while yy < h {
        var xx: usize = 0
        while xx < w {
            // FOR THE CUT EVERY DEVIATION IS COUNTED, not
            // only one above TOLERANZ. The reason stands in the proof
            // fui-wave1: there at the bottom lies a surface with the tone
            // 249,249,251 on a background of 244,244,246 -- a
            // difference of 5, so BELOW the threshold that is set against
            // the noise of the edge smoothing. Measured with the
            // threshold, the cut looked 53 points empty, where
            // in truth the button surface still stands (checked:
            // it reaches to row 649 of 670). A check that
            // takes an existing surface for air turns a
            // correct proof red -- so here every
            // difference counts.
            if png.image_pixel(&im, xx, yy) & 16777215 as u32 != basic {
                if top < 0 {
                    top = yy as i64
                }
                below = yy as i64
                if left < 0 || (xx as i64) < left {
                    left = xx as i64
                }
                if (xx as i64) > right {
                    right = xx as i64
                }
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
    // A sheet without any colour has already failed at section 3;
    // here things are divided only if there is something to divide.
    if top >= 0 {
        // THE TOP EDGE ALWAYS APPLIES. Every gallery of this tree begins
        // with air; colour in the first row means that something
        // is cut off at the top.
        var n4: [u8; 40] = "4 nothing touches the top edge          "
        report((&n4[0]) as u64, 38, top >= 1, top, 1)
        // THE SIDES ONLY ON REQUEST. Two proofs deliberately set
        // something across the full width -- the dimmer behind the
        // dialogs in fui-wave3 (rows 634..923) and the dividing line
        // under the title row in fui-demo. That is no
        // cut-off element, but a surface that is meant to be so.
        // Whoever sets `seiten` to 1 demands air also
        // left and right; without the statement it stays with the
        // top edge, and a false check that turns every run red
        // does not arise in the first place.
        if pages != 0 {
            var n5: [u8; 40] = "4 nothing touches the left edge         "
            report((&n5[0]) as u64, 38, left >= 1, left, 1)
            var n6: [u8; 40] = "4 nothing touches the right edge        "
            report((&n6[0]) as u64, 38, right <= (w as i64) - 2,
                right, (w as i64) - 2)
        }
        // THE STRIP AT THE BOTTOM. `rand_max` comes as the sixth argument;
        // without it 0 applies and the check is omitted -- so the
        // call of the proofs stays backward compatible that do not cut their height
        // to the content.
        if rand_max > 0 {
            let empty: i64 = (h as i64) - 1 - below
            var n7: [u8; 40] = "4 the empty strip below stays small     "
            report((&n7[0]) as u64, 38, empty <= rand_max, empty, rand_max)
        }
    }

    png.image_free(&im)
    rt.buf_free(&roh)

    var t: rt.Buf = rt.buf_new()
    if G_ERRORS > 0 {
        var f: [u8; 26] = "THIS PICTURE IS NO PROOF.\n"
        rt.buf_push_bytes(&t, (&f[0]) as u64, 26)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
        return 1
    }
    var o: [u8; 18] = "BELEG IN ORDNUNG.\n"
    rt.buf_push_bytes(&t, (&o[0]) as u64, 18)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 0
}
