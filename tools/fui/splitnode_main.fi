// tools/fui/splitnode_main.fi -- the splitter as a scene node (appctl.split_begin / split_mid / split_end).
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn num(tag: str, v: f64) {
    say(tag)
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v as i64)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("splitnode: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Split", 600, 400)
    let ct: usize = appctl.split_begin(a, true, 300, "Sidebar", changed)
    let la: usize = app.label(a, "Pane A", 0)
    let bar: usize = appctl.split_mid(a)
    let lb: usize = app.label(a, "Pane B", 0)
    appctl.split_end(a)
    let s: *mut Surface = surface_for(a, 600, 400)
    frame(a, s)
    frame(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    scene.node_set_size(sc, ct, 500.0, 100.0)
    appctl.split_set_ratio(a, bar, 100)
    frame(a, s)
    frame(a, s)
    num("  r100 bar.x ", scene.node_x(sc, bar))
    appctl.split_set_ratio(a, bar, 900)
    frame(a, s)
    frame(a, s)
    num("  r900 bar.x ", scene.node_x(sc, bar))
    var k: usize = scene.scene_first_child(sc, ct)
    scene.node_set_grow(sc, k, 1000, 0)
    frame(a, s)
    frame(a, s)
    while k != scene.SCENE_NONE {
        num("  kid x ", scene.node_x(sc, k))
        num("  kid w ", scene.node_w(sc, k))
        k = scene.scene_next_sibling(sc, k)
    }
    appctl.split_set_ratio(a, bar, 300)
    frame(a, s)
    frame(a, s)
    check(bar != appctl.NONE && ct != appctl.NONE, "container and bar exist")
    check(appctl.split_ratio(a, bar) == 300, "start ratio 300")
    let bx0: f64 = scene.node_x(sc, bar)
    let bw: f64 = scene.node_w(sc, bar)
    check(near(bw, 6.0, 1.0), "bar is 6 wide")
    let cw: f64 = scene.node_w(sc, ct)
    check(cw > 100.0, "container has a width")
    let share: f64 = cw - bw
    num("  ct.x ", scene.node_x(sc, ct))
    num("  ct.w ", cw)
    num("  bar.x ", bx0)
    num("  A.x ", scene.node_x(sc, la))
    num("  B.x ", scene.node_x(sc, lb))
    check(near(bx0 - scene.node_x(sc, ct), share * 0.3, 3.0), "bar sits at 30 percent")
    check(scene.node_x(sc, lb) > bx0 + bw - 1.0, "pane B starts behind the bar")
    // drag the bar 100 px to the right
    let w: *mut fuiwirt.Host = app.app_host(a)
    let my: f64 = scene.node_y(sc, bar) + scene.node_h(sc, bar) / 2.0
    let gx: f64 = bx0 + bw / 2.0
    let m0: u32 = fuiwirt.host_pointer_move(w, gx, my)
    check(appctl.split_hovered(a, bar), "hover on the bar")
    let d0: u32 = fuiwirt.host_pointer_down(w, gx, my, fuiwirt.BTN_LEFT)
    check(appctl.split_dragging(a, bar), "drag starts")
    let m1: u32 = fuiwirt.host_pointer_move(w, gx + 100.0, my)
    frame(a, s)
    frame(a, s)
    let u0: u32 = fuiwirt.host_pointer_up(w, gx + 100.0, my, fuiwirt.BTN_LEFT)
    check(!appctl.split_dragging(a, bar), "drag ends")
    check(CHANGES > 0, "callback ran")
    let bx1: f64 = scene.node_x(sc, bar)
    check(near(bx1 - bx0, 100.0, 4.0), "bar moved 100 px")
    check(appctl.split_ratio(a, bar) > 300, "ratio grew")
    check(scene.node_x(sc, lb) > bx1 + bw - 1.0, "pane B follows")
    // far beyond the right edge: pane B keeps its minimum (40)
    let m2: u32 = fuiwirt.host_pointer_move(w, bx1 + bw / 2.0, my)
    let d1: u32 = fuiwirt.host_pointer_down(w, bx1 + bw / 2.0, my, fuiwirt.BTN_LEFT)
    let m3: u32 = fuiwirt.host_pointer_move(w, 5000.0, my)
    frame(a, s)
    frame(a, s)
    let u1: u32 = fuiwirt.host_pointer_up(w, 5000.0, my, fuiwirt.BTN_LEFT)
    let bx2: f64 = scene.node_x(sc, bar)
    check(scene.node_x(sc, ct) + cw - (bx2 + bw) >= 38.0, "pane B keeps its minimum")
    // set by program
    appctl.split_set_ratio(a, bar, 500)
    frame(a, s)
    frame(a, s)
    check(near(scene.node_x(sc, bar) - scene.node_x(sc, ct), share * 0.5, 3.0), "ratio set from code")
    if BAD == 0 {
        say("SPLITNODE PASSED\n")
        return 0
    }
    say("SPLITNODE FAILED\n")
    return 1
}
