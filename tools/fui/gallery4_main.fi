// SPDX-License-Identifier: MPL-2.0
// tools/fui/gallery4_main.fi -- THE TEXT VALUES SHOW THEMSELVES.
//
// ====================================================== WHY IT EXISTS
//
// The same rule as the other galleries: what does not show up here
// counts as unfinished. Justin checks the pictures himself, so every
// text value of 12.09.2026 stands in here, light and dark:
//
//     gallery4_main <out.png> [light|dark] [<font.ttf>]
//
// The page is read in rows. Each row shows ONE value at several
// settings, so the difference is the thing you see -- a single sample
// of "tracking" would prove nothing.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.wave2
import fui.wave3
import fui.layout

const FONTSET_BYTES: usize = 4096
const W: usize = 1240
// H IST DIE HOECHSTHOEHE, NICHT DIE BILDHOEHE -- dieselbe Trennung wie
// in gallery3_main.fi. Gerechnet wird mit H, ausgeliefert wird das
// Bild bis zum tatsaechlich erreichten y; sonst haengt unter dem
// letzten Band ein leeres Drittel, im dunklen Schema ein schwarzer
// Block.
const H: usize = 1180
const BORDER_BELOW: f64 = 20.0

// Zuschneiden auf die erreichte Hoehe. Roh kopiert (`canvas_get` /
// `canvas_set_raw`), nicht gemischt: Kopieren ist kein Malen.
fn zuschnitt(src: *mut canvas.Canvas, dst: *mut canvas.Canvas,
    height: f64) -> bool {
    var h: usize = (height + 0.5) as usize
    if h > canvas.canvas_height(src) {
        h = canvas.canvas_height(src)
    }
    if h == 0 {
        return false
    }
    let w: usize = canvas.canvas_width(src)
    if !canvas.canvas_init(dst, w, h) {
        return false
    }
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            canvas.canvas_set_raw(dst, x, y,
                canvas.canvas_get(src, x, y))
            x = x + 1
        }
        y = y + 1
    }
    return true
}

fn heading(c: *mut render.Ctx, x: f64, y: f64, p: u64, n: usize) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, 900.0, 18.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(style.TOK_TEXT_MUTED))
    *s = style.style_set_font(*s, 0, 12)
    render.draw_label(c, &e)
}

fn caption(c: *mut render.Ctx, x: f64, y: f64, p: u64, n: usize) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, 260.0, 14.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(style.TOK_TEXT_MUTED))
    *s = style.style_set_font(*s, 0, 11)
    render.draw_label(c, &e)
}

// A sample of text with a Style applied. Everything on this page goes
// through `render.draw_label`, so the page also PROVES that the values
// travel through the normal widget road and not through some side door
// the gallery opened for itself.
fn sample(c: *mut render.Ctx, x: f64, y: f64, w: f64, p: u64,
    n: usize, s: style.Style) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, w, 46.0)
    widget.w_set_text(&e, p, n)
    let sp: *mut style.Style = widget.w_style(&e)
    *sp = s
    render.draw_label(c, &e)
}

fn base_style(px: usize) -> style.Style {
    var s: style.Style = style.style_new()
    s = style.style_set_font(s, 0, px)
    s = style.style_set_pad(s, 0, 0)
    return s
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 48] = "gallery4_main <out.png> [light|dark] [font.ttf]\n"
        rt.write_everything(2, (&u[0]) as u64, 47)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    var dark: bool = true
    if rt.arg_count(start) >= 3 {
        if rt.ld8(rt.arg_ptr(start, 2), 0) == 108 as u8 {
            dark = false
        }
    }
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
        rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    // OHNE SCHRIFT KEIN BELEG. Ein Bild ohne einen einzigen
    // Buchstaben sieht von weitem aus wie ein Bild, und genau so ist
    // in OrientOS eine textlose Oberflaeche durch die Abnahme
    // gekommen. Ein Beleg ohne Beschriftung belegt nichts -- also
    // Fehler auf fd 2 und ein Rueckgabewert, an dem der Lauf
    // haengenbleibt, statt ein stummes PNG zu schreiben.
    if fm == 0 {
        var ks: [u8; 60] = "gallery4: keine Schrift gefunden -- ohne Schrift kein Beleg\n"
        rt.write_everything(2, (&ks[0]) as u64, 60)
        return 9
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 300) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(dark)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque((*f).base))

    var tx: [u8; 7] = "Hamburg"
    let tp: u64 = (&tx[0]) as u64
    let tn: usize = 7
    var av: [u8; 7] = "AV To W"
    let ap: u64 = (&av[0]) as u64

    var y: f64 = 24.0

    // ==================================================================
    // TRACKING
    // ==================================================================
    var h1: [u8; 52] = "TRACKING -- letter spacing, may be negative         "
    heading(&c, 24.0, y, (&h1[0]) as u64, 50)
    y = y + 22.0
    var cm2: [u8; 13] = "tracking -2  "
    var c0: [u8; 13] = "tracking  0  "
    var cp2: [u8; 13] = "tracking +2  "
    var cp6: [u8; 13] = "tracking +6  "
    caption(&c, 24.0, y, (&cm2[0]) as u64, 12)
    caption(&c, 330.0, y, (&c0[0]) as u64, 12)
    caption(&c, 636.0, y, (&cp2[0]) as u64, 12)
    caption(&c, 942.0, y, (&cp6[0]) as u64, 12)
    y = y + 16.0

    var s_m2: style.Style = style.style_set_tracking(base_style(30), -2)
    var s_0: style.Style = base_style(30)
    var s_p2: style.Style = style.style_set_tracking(base_style(30), 2)
    var s_p6: style.Style = style.style_set_tracking(base_style(30), 6)
    sample(&c, 24.0, y, 300.0, tp, tn, s_m2)
    sample(&c, 330.0, y, 300.0, tp, tn, s_0)
    sample(&c, 636.0, y, 300.0, tp, tn, s_p2)
    sample(&c, 942.0, y, 290.0, tp, tn, s_p6)
    y = y + 62.0

    // ==================================================================
    // WEIGHT AND SLANT -- the two the Style always had and nobody used
    // ==================================================================
    var h2: [u8; 52] = "WEIGHT AND SLANT -- bold and italic from the Style  "
    heading(&c, 24.0, y, (&h2[0]) as u64, 50)
    y = y + 22.0
    var cw4: [u8; 13] = "weight 400   "
    var cw7: [u8; 13] = "weight 700   "
    var cit: [u8; 13] = "italic       "
    var cbi: [u8; 15] = "bold + italic  "
    caption(&c, 24.0, y, (&cw4[0]) as u64, 12)
    caption(&c, 330.0, y, (&cw7[0]) as u64, 12)
    caption(&c, 636.0, y, (&cit[0]) as u64, 12)
    caption(&c, 942.0, y, (&cbi[0]) as u64, 14)
    y = y + 16.0
    var s_n: style.Style = base_style(30)
    var s_b: style.Style = style.style_set_weight(base_style(30),
        style.WEIGHT_BOLD)
    var s_i: style.Style = style.style_set_slant(base_style(30),
        style.SLANT_ITALIC)
    var s_bi: style.Style = style.style_set_slant(
        style.style_set_weight(base_style(30), style.WEIGHT_BOLD),
        style.SLANT_ITALIC)
    sample(&c, 24.0, y, 300.0, tp, tn, s_n)
    sample(&c, 330.0, y, 300.0, tp, tn, s_b)
    sample(&c, 636.0, y, 300.0, tp, tn, s_i)
    sample(&c, 942.0, y, 290.0, tp, tn, s_bi)
    y = y + 62.0

    // ==================================================================
    // KERNING
    // ==================================================================
    var h3: [u8; 56] = "KERNING -- the font's own pair spacing, on by default   "
    heading(&c, 24.0, y, (&h3[0]) as u64, 54)
    y = y + 22.0
    var ck1: [u8; 23] = "kerning ON (default)   "
    var ck0: [u8; 23] = "kerning OFF            "
    caption(&c, 24.0, y, (&ck1[0]) as u64, 22)
    caption(&c, 480.0, y, (&ck0[0]) as u64, 22)
    y = y + 16.0
    var s_k1: style.Style = style.style_set_kerning(base_style(36),
        true)
    var s_k0: style.Style = style.style_set_kerning(base_style(36),
        false)
    sample(&c, 24.0, y, 440.0, ap, 7, s_k1)
    sample(&c, 480.0, y, 440.0, ap, 7, s_k0)
    y = y + 62.0

    // ==================================================================
    // OUTLINE
    // ==================================================================
    var h4: [u8; 56] = "OUTLINE -- colour and width, so text reads on anything  "
    heading(&c, 24.0, y, (&h4[0]) as u64, 54)
    y = y + 22.0
    var co1: [u8; 15] = "outline 1      "
    var co2: [u8; 15] = "outline 2      "
    var co3: [u8; 15] = "outline 3      "
    caption(&c, 24.0, y, (&co1[0]) as u64, 14)
    caption(&c, 420.0, y, (&co2[0]) as u64, 14)
    caption(&c, 816.0, y, (&co3[0]) as u64, 14)
    y = y + 16.0
    var s_o1: style.Style = style.style_set_outline(base_style(34), 1,
        style.color_token(style.TOK_ACCENT))
    var s_o2: style.Style = style.style_set_outline(base_style(34), 2,
        style.color_token(style.TOK_ACCENT))
    var s_o3: style.Style = style.style_set_outline(base_style(34), 3,
        style.color_token(style.TOK_ACCENT))
    sample(&c, 24.0, y, 380.0, tp, tn, s_o1)
    sample(&c, 420.0, y, 380.0, tp, tn, s_o2)
    sample(&c, 816.0, y, 380.0, tp, tn, s_o3)
    y = y + 62.0

    // ==================================================================
    // SHADOW
    // ==================================================================
    var h5: [u8; 53] = "SHADOW -- offset and colour, and it lies BEHIND      "
    heading(&c, 24.0, y, (&h5[0]) as u64, 50)
    y = y + 22.0
    var cs1: [u8; 17] = "shadow  2 /  2   "
    var cs2: [u8; 17] = "shadow  4 /  4   "
    var cs3: [u8; 17] = "shadow -3 /  3   "
    caption(&c, 24.0, y, (&cs1[0]) as u64, 16)
    caption(&c, 420.0, y, (&cs2[0]) as u64, 16)
    caption(&c, 816.0, y, (&cs3[0]) as u64, 16)
    y = y + 16.0
    var s_s1: style.Style = style.style_set_shadow(base_style(34), 2,
        2, style.color_token(style.TOK_ACCENT))
    var s_s2: style.Style = style.style_set_shadow(base_style(34), 4,
        4, style.color_token(style.TOK_ACCENT))
    var s_s3: style.Style = style.style_set_shadow(base_style(34), -3,
        3, style.color_token(style.TOK_ACCENT))
    sample(&c, 24.0, y, 380.0, tp, tn, s_s1)
    sample(&c, 420.0, y, 380.0, tp, tn, s_s2)
    sample(&c, 816.0, y, 380.0, tp, tn, s_s3)
    y = y + 62.0

    // ==================================================================
    // GRADIENT
    // ==================================================================
    var h6: [u8; 53] = "GRADIENT -- down the line, from the text colour      "
    heading(&c, 24.0, y, (&h6[0]) as u64, 50)
    y = y + 22.0
    var cg1: [u8; 19] = "to the accent      "
    var cg2: [u8; 19] = "to the error tone  "
    var cg3: [u8; 19] = "with an outline    "
    caption(&c, 24.0, y, (&cg1[0]) as u64, 18)
    caption(&c, 420.0, y, (&cg2[0]) as u64, 18)
    caption(&c, 816.0, y, (&cg3[0]) as u64, 18)
    y = y + 16.0
    var s_g1: style.Style = style.style_set_gradient(base_style(40),
        style.color_token(style.TOK_ACCENT))
    var s_g2: style.Style = style.style_set_gradient(base_style(40),
        style.color_token(style.TOK_ERROR))
    var s_g3: style.Style = style.style_set_outline(
        style.style_set_gradient(base_style(40),
            style.color_token(style.TOK_ACCENT)), 2,
        style.color_token(style.TOK_TEXT))
    sample(&c, 24.0, y, 380.0, tp, tn, s_g1)
    sample(&c, 420.0, y, 380.0, tp, tn, s_g2)
    sample(&c, 816.0, y, 380.0, tp, tn, s_g3)
    y = y + 66.0

    // ==================================================================
    // IT WORKS ON EVERY CONTROL, NOT ONLY ON A LABEL
    // ==================================================================
    //
    // This is the row that answers Justin's condition directly. The
    // same tracking and the same bold go on a BUTTON, a CHECKBOX, a
    // TAB, a LIST ROW and a BADGE -- none of which knows that any of
    // this exists.
    var h7: [u8; 58] = "EVERY CONTROL, NOT ONLY THE LABEL -- same Style values    "
    heading(&c, 24.0, y, (&h7[0]) as u64, 56)
    y = y + 24.0

    var bt: [u8; 6] = "Button"
    var b1: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&b1, 24.0, y, 190.0, 40.0)
    widget.w_set_text(&b1, (&bt[0]) as u64, 6)
    wave3.draw_any(&c, &b1)

    var b2: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&b2, 230.0, y, 190.0, 40.0)
    widget.w_set_text(&b2, (&bt[0]) as u64, 6)
    let b2s: *mut style.Style = widget.w_style(&b2)
    *b2s = style.style_set_tracking(*b2s, 3)
    *b2s = style.style_set_weight(*b2s, style.WEIGHT_BOLD)
    wave3.draw_any(&c, &b2)

    var ck: widget.Widget = widget.widget_new(widget.KIND_CHECKBOX)
    var ckt: [u8; 7] = "Checked"
    widget.w_place(&ck, 440.0, y, 220.0, 40.0)
    widget.w_set_text(&ck, (&ckt[0]) as u64, 7)
    widget.w_set_value(&ck, 1)
    let cks: *mut style.Style = widget.w_style(&ck)
    *cks = style.style_set_tracking(*cks, 2)
    wave3.draw_any(&c, &ck)

    var tb: widget.Widget = widget.widget_new(widget.KIND_TAB)
    var tbt: [u8; 8] = "Overview"
    widget.w_place(&tb, 676.0, y, 170.0, 40.0)
    widget.w_set_text(&tb, (&tbt[0]) as u64, 8)
    widget.w_set_selected(&tb, true)
    let tbs: *mut style.Style = widget.w_style(&tb)
    *tbs = style.style_set_weight(*tbs, style.WEIGHT_BOLD)
    wave3.draw_any(&c, &tb)

    var bd: widget.Widget = widget.widget_new(widget.KIND_BADGE)
    var bdt: [u8; 3] = "NEW"
    widget.w_place(&bd, 870.0, y + 8.0, 80.0, 24.0)
    widget.w_set_text(&bd, (&bdt[0]) as u64, 3)
    widget.w_set_value(&bd, wave3.BADGE_ACCENT as i64)
    let bds: *mut style.Style = widget.w_style(&bd)
    *bds = style.style_set_tracking(*bds, 2)
    wave3.draw_any(&c, &bd)

    // a list whose rows carry a tracking through the same road
    var ls: widget.Widget = widget.widget_new(widget.KIND_LIST)
    widget.w_place(&ls, 970.0, y - 4.0, 240.0, 96.0)
    wave3.draw_any(&c, &ls)
    var r1: [u8; 9] = "Documents"
    var r2: [u8; 8] = "Pictures"
    wave3.draw_list_row(&c, &ls, 0, (&r1[0]) as u64, 9, false, false,
        false)
    wave3.draw_list_row(&c, &ls, 1, (&r2[0]) as u64, 8, false, true,
        false)
    y = y + 58.0

    // ---- a text field with tracking, so the editor road is shown too
    var tf: widget.Widget = widget.widget_new(widget.KIND_TEXTBOX)
    var tft: [u8; 21] = "tracking in a field  "
    widget.w_place(&tf, 24.0, y, 400.0, 40.0)
    widget.w_set_text(&tf, (&tft[0]) as u64, 20)
    let tfs: *mut style.Style = widget.w_style(&tf)
    *tfs = style.style_set_tracking(*tfs, 2)
    wave3.draw_any(&c, &tf)

    // ---- a menu, same thing
    // EIN MENUE IST EIN BEHAELTER. Seinen Text traegt der EINTRAG
    // darin, nicht die Flaeche -- eine Menueflaeche mit Text darauf
    // blieb hier bisher ein leerer Kasten, und ein leerer Kasten im
    // Beleg sieht aus wie ein Fehler, weil er einer ist.
    var mn: widget.Widget = widget.widget_new(widget.KIND_MENU)
    widget.w_place(&mn, 440.0, y, 200.0, 40.0)
    wave3.draw_any(&c, &mn)
    var mnt: [u8; 8] = "Settings"
    var mi: widget.Widget = widget.widget_new(widget.KIND_NONE)
    widget.w_place(&mi, 444.0, y + 4.0, 192.0, 32.0)
    widget.w_set_text(&mi, (&mnt[0]) as u64, 8)
    let mns: *mut style.Style = widget.w_style(&mi)
    *mns = style.style_set_tracking(*mns, 3)
    wave2.draw_menu_item(&c, &mi, false, false)

    // ---- WRITING IT OUT
    //
    // Das letzte Band sind Textfeld und Menue auf der Hoehe y, beide
    // 40 hoch. Also endet der Inhalt bei y + 40 -- gerechnet aus dem
    // Zeichnen, nicht aus H.
    let end: f64 = y + 40.0 + BORDER_BELOW
    var image: canvas.Canvas = canvas.canvas_new()
    if !zuschnitt(&cv, &image, end) {
        return 8
    }
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&image, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < rt.c_length(path) {
        rt.buf_push(&pf, rt.ld8(path, k))
        k = k + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 10] = "GALLERY 4\n"
    rt.write_everything(1, (&okm[0]) as u64, 10)
    painter.painter_free(&z)
    canvas.canvas_free(&image)
    canvas.canvas_free(&cv)
    return 0
}
