// SPDX-License-Identifier: MPL-2.0
// tools/fui/splitter_main.fi -- test for lib/fui/splitter.fi
//
//     splitter_main      prints SPLITTER PASSED / FAILED
//
// Geometry and ratio kept on resize, minimum sizes, drag (offset, clamp, cancel), grab margin,
// keyboard (steps, modifiers, Home/End/Enter/Esc), stacked panes, RTL mirroring, degenerate
// sizes, a11y values, cursor/hover and the painted bar.
import std.rt
import paint.canvas
import fui.painter
import fui.editor
import fui.splitter

static mut FAILS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if !ok {
        FAILS = FAILS + 1
        say("FAIL: ")
        say(what)
        say("\n")
    }
}

fn eq4(r: *mut [i64; 4], x: i64, y: i64, w: i64, h: i64) -> bool {
    return (*r)[0] == x && (*r)[1] == y && (*r)[2] == w && (*r)[3] == h
}

fn apos(s: *mut splitter.Splitter) -> i64 {
    var r: [i64; 4] = [0, 0, 0, 0]
    splitter.pane_a(s, &r)
    return r[2]
}

fn bar_x(s: *mut splitter.Splitter) -> i64 {
    var r: [i64; 4] = [0, 0, 0, 0]
    splitter.bar(s, &r)
    return r[0]
}

fn main(start: u64) -> i32 {
    var a: [i64; 4] = [0, 0, 0, 0]
    var b: [i64; 4] = [0, 0, 0, 0]
    var c: [i64; 4] = [0, 0, 0, 0]

    // ---- geometry: avail = 406 - 6 = 400, 30 % -> 120
    var s: splitter.Splitter = splitter.splitter_new(false, 300)
    splitter.layout(&s, 0, 0, 406, 100)
    splitter.pane_a(&s, &a)
    splitter.bar(&s, &b)
    splitter.pane_b(&s, &c)
    check(eq4(&a, 0, 0, 120, 100), "pane a")
    check(eq4(&b, 120, 0, 6, 100), "bar")
    check(eq4(&c, 126, 0, 280, 100), "pane b")
    // the proportion survives a resize
    splitter.layout(&s, 0, 0, 806, 100)
    check(apos(&s) == 240, "ratio kept on resize (30 % of 800)")
    splitter.layout(&s, 10, 20, 406, 100)
    splitter.pane_a(&s, &a)
    check(eq4(&a, 10, 20, 120, 100), "origin offset respected")
    splitter.layout(&s, 0, 0, 406, 100)

    // ---- minimum sizes
    splitter.set_limits(&s, 80, 120)
    splitter.set_ratio(&s, 0)
    check(apos(&s) == 80, "min first pane")
    splitter.set_ratio(&s, 1000)
    check(apos(&s) == 280, "min second pane (400 - 120)")
    check(splitter.value_min(&s) == 200 && splitter.value_max(&s) == 700, "a11y min/max permille")
    splitter.set_ratio(&s, 300)

    // ---- grab margin (bar x 120..126, margin 3)
    check(splitter.hit(&s, 118, 50), "grab margin left")
    check(!splitter.hit(&s, 116, 50), "outside the margin")
    check(splitter.hit(&s, 128, 50), "grab margin right")
    check(!splitter.hit(&s, 123, 150), "below the bar's length")

    // ---- drag: grabbed 2 px into the bar, moved to x=222 -> first pane 220
    check(!splitter.down(&s, 60, 50), "down on a pane does not grab")
    check(splitter.down(&s, 122, 50), "down on the bar grabs")
    check(splitter.dragging(&s), "dragging")
    check(splitter.move(&s, 222, 50), "move reports a change")
    check(apos(&s) == 220 && splitter.value_now(&s) == 550, "drag position and ratio")
    check(!splitter.move(&s, 222, 80), "same position: no change")
    check(splitter.move(&s, 0 - 50, 50) && apos(&s) == 80, "drag clamps to the minimum")
    check(splitter.move(&s, 900, 50) && apos(&s) == 280, "drag clamps to the maximum")
    splitter.up(&s)
    check(!splitter.dragging(&s) && !splitter.move(&s, 150, 50), "after up the divider stays")
    check(apos(&s) == 280, "position kept after up")

    // ---- cancel / Esc
    splitter.set_ratio(&s, 300)
    check(splitter.down(&s, 122, 50), "grab again")
    check(splitter.move(&s, 200, 50), "move")
    check(splitter.key(&s, editor.KEY_ESC, 0 as u32), "Esc during drag")
    check(!splitter.dragging(&s) && splitter.ratio(&s) == 300 && apos(&s) == 120, "Esc restores the start ratio")

    // ---- keyboard
    check(splitter.key(&s, editor.KEY_RIGHT, 0 as u32) && apos(&s) == 136, "Right +16")
    check(splitter.key(&s, editor.KEY_LEFT, 0 as u32) && apos(&s) == 120, "Left -16")
    check(splitter.key(&s, editor.KEY_RIGHT, editor.MOD_SHIFT) && apos(&s) == 280, "Shift = 10x, clamped")
    check(splitter.key(&s, editor.KEY_HOME, 0 as u32) && apos(&s) == 80, "Home")
    check(splitter.key(&s, editor.KEY_RIGHT, editor.MOD_CTRL) && apos(&s) == 81, "Ctrl = 1 px")
    check(splitter.key(&s, editor.KEY_END, 0 as u32) && apos(&s) == 280, "End")
    check(splitter.key(&s, editor.KEY_ENTER, 0 as u32) && apos(&s) == 120, "Enter restores the start ratio")
    check(!splitter.key(&s, editor.KEY_UP, 0 as u32), "Up is not used by side-by-side panes")
    check(!splitter.key(&s, editor.KEY_ESC, 0 as u32), "Esc without a drag is not used")

    // ---- hover and cursor
    check(splitter.cursor(&s) == splitter.CURSOR_DEFAULT, "default cursor")
    check(!splitter.move(&s, 123, 50) && splitter.hovered(&s), "hover over the bar")
    check(splitter.cursor(&s) == splitter.CURSOR_EW, "resize cursor ew")
    check(!splitter.move(&s, 10, 50) && !splitter.hovered(&s), "hover gone")

    // ---- stacked panes
    var v: splitter.Splitter = splitter.splitter_new(true, 500)
    splitter.layout(&v, 5, 7, 300, 206)
    splitter.pane_a(&v, &a)
    splitter.bar(&v, &b)
    splitter.pane_b(&v, &c)
    check(eq4(&a, 5, 7, 300, 100), "stacked pane a")
    check(eq4(&b, 5, 107, 300, 6), "stacked bar")
    check(eq4(&c, 5, 113, 300, 100), "stacked pane b")
    check(splitter.key(&v, editor.KEY_DOWN, 0 as u32), "Down moves the bar down")
    splitter.pane_a(&v, &a)
    check(a[3] == 116, "stacked +16")
    check(!splitter.key(&v, editor.KEY_LEFT, 0 as u32), "Left not used when stacked")
    check(splitter.aria_horizontal(&v) && !splitter.aria_horizontal(&s), "aria orientation of the line")
    check(splitter.down(&v, 100, 125) && splitter.move(&v, 100, 100), "stacked drag")
    splitter.pane_a(&v, &a)
    check(a[3] == 91, "stacked drag position (grabbed 2 px into the bar: 93 - 2)")
    splitter.up(&v)
    check(splitter.cursor(&v) != splitter.CURSOR_EW, "stacked cursor is not ew")

    // ---- RTL: first pane on the right
    var m: splitter.Splitter = splitter.splitter_new(false, 300)
    splitter.set_rtl(&m, true)
    splitter.layout(&m, 0, 0, 406, 100)
    splitter.pane_a(&m, &a)
    splitter.bar(&m, &b)
    splitter.pane_b(&m, &c)
    check(eq4(&a, 286, 0, 120, 100), "rtl pane a on the right")
    check(eq4(&b, 280, 0, 6, 100), "rtl bar")
    check(eq4(&c, 0, 0, 280, 100), "rtl pane b on the left")
    check(splitter.key(&m, editor.KEY_LEFT, 0 as u32) && apos(&m) == 136 && bar_x(&m) == 264, "rtl: Left moves the bar left")
    check(splitter.key(&m, editor.KEY_RIGHT, 0 as u32) && apos(&m) == 120, "rtl: Right moves it back")
    check(splitter.down(&m, 282, 50), "rtl grab")
    check(splitter.move(&m, 182, 50) && apos(&m) == 220, "rtl drag follows the pointer")
    splitter.up(&m)

    // ---- degenerate: the minimums do not fit, room is shared in their proportion
    var d: splitter.Splitter = splitter.splitter_new(false, 500)
    splitter.set_limits(&d, 80, 120)
    splitter.layout(&d, 0, 0, 100, 40)
    check(apos(&d) == 37, "minimums do not fit: proportional share")
    splitter.layout(&d, 0, 0, 0, 0)
    check(apos(&d) == 0, "zero size")
    check(splitter.value_min(&d) == 0 && splitter.value_max(&d) == 1000, "a11y values at zero size")

    // ---- painted bar
    var cv: canvas.Canvas = canvas.canvas_new()
    var z: painter.Painter = painter.painter_new()
    check(canvas.canvas_init(&cv, 406, 100) && painter.painter_init(&z, &cv, 406, 100), "surface")
    painter.painter_clear(&z, 4294967295 as u32)
    var p: splitter.Splitter = splitter.splitter_new(false, 300)
    splitter.layout(&p, 0, 0, 406, 100)
    splitter.draw(&z, &p, 0xFFFF0000 as u32, 0xFF00FF00 as u32, 0xFF0000FF as u32, 0xFF000000 as u32)
    let px: *mut u8 = canvas.canvas_pixels(&cv)
    let o: usize = (10 * 406 + 121) * 4
    check(rt.ld8(px as u64, o) == 255 as u8 && rt.ld8(px as u64, o + 1) == 0 as u8, "bar painted red at rest")
    let o2: usize = (10 * 406 + 60) * 4
    check(rt.ld8(px as u64, o2 + 1) == 255 as u8, "pane not painted")
    check(splitter.down(&p, 122, 50), "grab to paint the active state")
    splitter.draw(&z, &p, 0xFFFF0000 as u32, 0xFF00FF00 as u32, 0xFF0000FF as u32, 0xFF000000 as u32)
    check(rt.ld8(px as u64, o + 2) == 255 as u8 && rt.ld8(px as u64, o) == 0 as u8, "active colour while dragging")

    if FAILS > 0 {
        say("SPLITTER FAILED\n")
        return 1
    }
    say("SPLITTER PASSED\n")
    return 0
}
