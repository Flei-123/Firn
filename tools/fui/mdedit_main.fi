// SPDX-License-Identifier: MPL-2.0
// tools/fui/mdedit_main.fi -- CHECK OF lib/fui/mdedit.fi: documents, typing, focus, revision (no window).
//
//     firnc -o /tmp/mdedit tools/fui/mdedit_main.fi && /tmp/mdedit
import std.io
import std.rt
import fui.editor
import fui.mdedit
import fui.mdspec

static mut BAD: usize = 0
static mut CHECKS: usize = 0

fn expect(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if !ok {
        BAD = BAD + 1
        io.print_line(what)
    }
}

fn same(a: str, b: str) -> bool {
    if a.n != b.n { return false }
    var i: usize = 0
    while i < a.n {
        if rt.ld8(a.p as u64, i) != rt.ld8(b.p as u64, i) { return false }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
    let m: *mut mdedit.MdEd = mdedit.new()
    mdedit.put(m, 0, "# One", "", "")
    mdedit.put(m, 1, "# ", "Two", "\n\nEmpty note.")
    mdedit.open(m, 0)
    expect(same(mdedit.text(m), "# One"), "open 0 shows document 0")
    expect(!mdedit.char(m, 120 as u32, 0 as u32), "typing without focus is not used")
    expect(!mdedit.key(m, editor.KEY_ENTER, 0 as u32), "keys without focus are not used")
    expect(same(mdedit.text(m), "# One"), "no focus: text unchanged")
    (*m).focus = true
    let r0: u32 = (*m).rev
    expect(mdedit.char(m, 33 as u32, 0 as u32), "typing with focus is used")
    expect(same(mdedit.text(m), "!# One"), "typed char lands at the caret (start)")
    expect((*m).rev != r0, "typing marks the preview stale")
    expect(mdedit.key(m, editor.KEY_END, 0 as u32), "End moves")
    expect(mdedit.char(m, 63 as u32, 0 as u32), "type at the end")
    expect(same(mdedit.text(m), "!# One?"), "typed at the end")
    expect(mdedit.key(m, editor.KEY_ENTER, 0 as u32), "Enter is used")
    expect(same(mdedit.text(m), "!# One?\n"), "Enter inserts a line break")
    let r1: u32 = (*m).rev
    expect(mdedit.key(m, editor.KEY_LEFT, 0 as u32), "Left moves")
    expect((*m).rev == r1, "moving does not touch the preview")
    expect(mdedit.key(m, editor.KEY_BACKSPACE, 0 as u32), "Backspace is used")
    expect(same(mdedit.text(m), "!# One\n"), "Backspace deletes before the caret")
    mdedit.open(m, 1)
    expect(same(mdedit.text(m), "# Two\n\nEmpty note."), "open 1 shows document 1")
    mdedit.open(m, 0)
    expect(same(mdedit.text(m), "!# One\n"), "document 0 keeps its edit")
    mdedit.open(m, 0)
    expect(same(mdedit.text(m), "!# One\n"), "reopening the open document keeps the text")
    mdedit.set_text(m, "abc")
    expect(same(mdedit.text(m), "abc"), "set_text replaces the text")
    expect(!mdedit.load(m, 2, "none-such.md"), "load of a missing file fails")
    expect((*m).ln.row_k == 1.6 && (*m).ln.px_pt == 13.5 && (*m).ln.bar_off, "the editor has the article metrics: 13.5 pt, line 1.6, no scroll thumb")
    let art: mdspec.Spec = mdspec.article()
    let cht: mdspec.Spec = mdspec.chat()
    expect(art.h_px[0] == 26.0 && art.h_px[1] == 19.0 && art.muted_body && !art.code_head, "article spec: headings 26 / 19, muted body, no code head")
    expect(cht.h_px[0] == 24.0 && !cht.muted_body && cht.code_head && cht.pad_x == 0.0, "chat spec keeps the web chat measures")
    if BAD == 0 {
        io.print_line("MDEDIT PASSED")
        return 0
    }
    io.print_line("MDEDIT FAILED")
    return 1
}
