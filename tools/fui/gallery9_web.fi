// SPDX-License-Identifier: MPL-2.0
// tools/fui/gallery9_web.fi -- THE DESCRIBED PAGE OF gallery9_main.fi,
// IN A BROWSER (round WASM, step 6).
//
// ================================================================ WHY
//
// tools/fui/gallery9_main.fi describes a whole application page -- a
// toolbar, a scrolling list of 28 rows in a scroll area, two cards with
// switches -- as a TREE (`baue_baum`) and a STYLESHEET (`baue_blatt`), and
// paints it into a PNG. This file shows the same page in a web page: the
// same two functions build it, the same four passes of scene.fi lay it out
// and paint it, and lib/plat/web.fi puts the pixels into a <canvas> and
// brings mouse, wheel and keyboard back.
//
// "Dieselben Pixel = derselbe Code": nothing of the page is written a
// second time here. `gallery9_main` is imported as a module -- that is why
// this file stands NEXT TO it and not in demos/webdemo/: an import resolves
// next to the importing file, and a package manifest may not name a
// directory outside itself. gallery9's own `main`, the one that writes the
// PNG, becomes `gallery9_main.main` and is never called. The lines below
// are exactly the lines of gallery9's `main` between "the font is there"
// and "the four passes" -- the glue that turns the page functions into a
// page -- with the canvas, the painter, the theme, the scene and the sheet
// coming from the Web instead of from the stack of `main`.
//
// The name does not end in `_main.fi` on purpose: tools/fui/run.sh builds
// every `*_main.fi` NATIVELY, and this program imports the page's host
// (`firn_web_present`), which only a browser provides. It is built for
// the browser by tools/wasm/webdemo.sh:
//     firnc --target=wasm32-browser -o demos/webdemo/gallery9.wasm \
//         tools/fui/gallery9_web.fi
import std.rt
import plat.web
import gallery9_main
import fui.theme
import fui.style
import fui.sheet
import fui.scene
import fui.viewport

fn build_page(ud: u64, w: *mut web.Web) -> bool {
    let m: *mut theme.Theme = web.web_theme(w)
    let texts: u64 = rt.heap_alloc(640)
    let field: u64 = rt.heap_alloc(gallery9_main.LINES * gallery9_main.STEP)
    if texts == 0 || field == 0 {
        return false
    }
    gallery9_main.write_texts(texts)
    gallery9_main.write_lines(field)
    var nleiste: [u8; 6] = "leiste"
    var ntitel: [u8; 5] = "titel"
    var nkarte: [u8; 5] = "karte"
    var nueber: [u8; 5] = "ueber"
    var nnotiz: [u8; 5] = "notiz"
    var nliste: [u8; 5] = "liste"
    var nzeile: [u8; 5] = "zeile"
    var ngerade: [u8; 6] = "gerade"
    var nakzent: [u8; 6] = "akzent"
    let k_bar: u32 = sheet.sheet_name((&nleiste[0]) as u64, 6)
    let k_titel: u32 = sheet.sheet_name((&ntitel[0]) as u64, 5)
    let k_karte: u32 = sheet.sheet_name((&nkarte[0]) as u64, 5)
    let k_over: u32 = sheet.sheet_name((&nueber[0]) as u64, 5)
    let k_notiz: u32 = sheet.sheet_name((&nnotiz[0]) as u64, 5)
    let k_list: u32 = sheet.sheet_name((&nliste[0]) as u64, 5)
    let k_line: u32 = sheet.sheet_name((&nzeile[0]) as u64, 5)
    let k_even: u32 = sheet.sheet_name((&ngerade[0]) as u64, 6)
    let k_accent: u32 = sheet.sheet_name((&nakzent[0]) as u64, 6)

    // THE SCROLL AREA IN DEVICE UNITS. viewport.fi converts nothing -- its
    // own comment at `bars_needed` says who does: the caller, through the
    // theme. gallery9's numbers are design points, so here they go through
    // the same scale as every other length of the page (at a device ratio
    // of 1 every one of them is the number itself, and the page is the
    // PNG, pixel for pixel).
    let s: f64 = (theme.theme_scale(m) as f64) / 1000.0
    let v: *mut viewport.Viewport = web.web_viewport(w, 0)
    *v = viewport.viewport_new(0.0, 0.0, gallery9_main.LIST_W * s, 400.0 * s,
        gallery9_main.CONTENT_W * s, gallery9_main.CONTENT_H * s)
    viewport.viewport_set_bar(v, theme.theme_px(m, gallery9_main.BAR))
    viewport.viewport_set_inset(v, gallery9_main.PADDING * s)
    viewport.viewport_set_offset(v, 0.0, gallery9_main.ROLL_Y * s)

    let spurfarbe: u32 = theme.color_from_token(m, style.TOK_SURFACE)
    let basic_list: u32 = theme.mix(spurfarbe,
        theme.color_from_token(m, style.TOK_TEXT), 500)
    gallery9_main.build_leaf(web.web_sheet(w), k_bar, k_titel, k_karte,
        k_over, k_notiz, k_list, k_line, k_even, k_accent,
        style.color_literal(basic_list))
    let frame_box: usize = gallery9_main.build_tree(web.web_scene(w), v, field,
        k_bar, k_titel, k_karte, k_over, k_notiz, k_list, k_line,
        k_even, k_accent, texts)
    return frame_box != scene.SCENE_NONE
}

// The page registers itself and returns. Everything after this happens
// when the host calls: first the font, then the size, then frame after
// frame (lib/plat/web.fi).
fn main() -> i32 {
    if !web.web_page(0, build_page) {
        return 3
    }
    return 0
}
