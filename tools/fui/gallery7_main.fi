// SPDX-License-Identifier: MPL-2.0
// tools/fui/gallery7_main.fi -- THE EFFECTS AS A PICTURE.
//
// Blur shows itself only over a PATTERNED background: on a
// smooth surface a blur looks like nothing at all. So
// first a chessboard, then above it the soft shadow, the
// glass pane and the colour matrix.
//
// Three bands, each answers a question that you decide on the picture and
// not on a number:
//
//   1. Does the shadow fall off SOFTLY, or does it have an edge? Four
//      cards with growing blur and one with spread.
//   2. Does the glass look like a pane? The same surface once
//      under glass and once free next to it -- the comparison stands in the
//      same picture, otherwise you do not believe it.
//   3. Does the colour matrix do what it says? The same background four times.
//
//     gallery7_main <out.png> [light|dark] [<font.ttf>]
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.layout
import fui.effect

const FONTSET_BYTES: usize = 4096
const W: usize = 1240
const H: usize = 700

fn label(c: *mut render.Ctx, x: f64, y: f64, w: f64, px: usize, p: u64,
    n: usize, tok: u32) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, w, 18.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(tok))
    *s = style.style_set_font(*s, 0, px)
    *s = style.style_set_pad(*s, 0, 0)
    render.draw_label(c, &e)
}

// HOW DARK THE SHADOW IN THIS PICTURE IS: AS IN THE LIBRARY.
//
// Until 21.09.2026 this sheet scaled up the opacity of
// `render.shadow_color` itself (doubled, at least 140) and
// painted in the dark scheme instead of a shadow a white
// fringe of light. Thereby it proved the shadow that it would LIKE to have, and
// not the one that the library really casts -- and that is no acceptance,
// but a demonstration. A proof shows the default value;
// if that does not suffice, the default value is wrong and is corrected in
// `lib/fui/theme.fi` (`Shape.shadow`), not here.
//
// That is why there is no longer a function here: the value comes at the
// call site from `render.shadow_color(&c)`, and unchanged.

// THE BACKGROUND ON WHICH THE FOUR PROBES STAND.
//
// A shadow is darker than its background. In the dark scheme, however, the
// background of the page (0x1C1B22, tone value 28) itself already lies almost
// on black -- below it remain 28 tone values, and on such a
// stretch every gradient is a claim. The band of the probes
// therefore gets a background RAISED by a few tone values: 43 % of the
// way from `base` to `surface_raised`. In the dark scheme that is
// 28 -> 40, in the light 244 -> 249. Underneath, the black shadow has
// room to fall, and the card may stay on `surface_raised`, where
// it belongs: a card is a card and no special tone
// for a proof photo.
fn grundton(m: *mut theme.Theme) -> u32 {
    let f: *mut theme.Colors = theme.theme_colors(m)
    return theme.mix((*f).base, (*f).surface_raised, 430)
}

// THE COLOUR OF THE TILE LABEL.
//
// In the light scheme the label stands on the background of the page and
// `text_muted` carries there with 4.5:1 -- that is the supporting role that
// it also has. In the DARK it no longer does: this sheet raises
// its background for the shadow probes (see `grundton`), and
// against a lightened background a muted grey no longer
// reliably suffices. There the full text tone applies
// therefore. Which one it is is decided not by the eye, but by the calculation at the
// end of this program: `theme.contrast`
// against the background really painted, demanded are 4.5:1.
fn beschriftungston(dunkel: bool) -> u32 {
    if dunkel {
        return style.TOK_TEXT
    }
    return style.TOK_TEXT_MUTED
}

// ======================================================================
// THE MEASURING TOOLS OF THIS SHEET
// ======================================================================
//
// The tone value by Rec.601 in thousandths: the brightness that the
// eye sees. For the distance of two surfaces that is the right
// measure -- the same change weighs more in the green channel than in the
// blue channel.
fn tonwert(c: u32) -> i64 {
    let r: i64 = ((c >> 16) & 255 as u32) as i64
    let g: i64 = ((c >> 8) & 255 as u32) as i64
    let b: i64 = (c & 255 as u32) as i64
    return (299 * r + 587 * g + 114 * b) / 1000
}

fn abs(x: i64) -> i64 {
    if x < 0 {
        return 0 - x
    }
    return x
}

// HOW FAR THE SHADOW REACHES.
//
// The distance under the lower edge of the card at which the shadow has
// vanished into the background -- except for two tone values, because the last
// step of a box blur lies below the resolution of the
// eye as of the tone value. That is the measure at which two
// blur radii really differ: a larger radius
// reaches FURTHER, it is not merely darker at one place.
fn reichweite(cv: *mut canvas.Canvas, x: usize, y0: usize,
    basic: i64) -> i64 {
    var d: usize = 0
    while d < 60 {
        if abs(tonwert(canvas.canvas_get(cv, x, y0 + d)) - basic) <= 2 {
            return d as i64
        }
        d = d + 1
    }
    return 60
}

// IS IT A GRADIENT OR AN EDGE?
//
// From the lower edge of the card `n` points downwards: a shadow
// becomes lighter with every point and never darker again. If the
// sequence turns backwards anywhere by more than one tone value, it is no
// gradient, but an edge -- then 0 comes back and the
// demand fails. Otherwise the span comes back: the
// lightest minus the darkest measured tone value. A tone value
// of decline is tolerated, because the Rec.601 calculation is integer
// and trembles at the rounding.
fn gradient_span(cv: *mut canvas.Canvas, x: usize, y0: usize,
    n: usize) -> i64 {
    let first: i64 = tonwert(canvas.canvas_get(cv, x, y0))
    var high: i64 = first
    var k: usize = 1
    while k < n {
        let t: i64 = tonwert(canvas.canvas_get(cv, x, y0 + k))
        if t + 1 < high {
            return 0
        }
        if t > high {
            high = t
        }
        k = k + 1
    }
    return high - first
}

// The largest difference of ONE channel. Two colours can have the same
// tone value and nevertheless be clearly different (blue and yellow
// are the example) -- behind the glass pane it is therefore measured like this
// and not via the brightness.
fn kanalabstand(a: u32, b: u32) -> i64 {
    var d: i64 = abs((((a >> 16) & 255 as u32) as i64)
        -(((b >> 16) & 255 as u32) as i64))
    let g: i64 = abs((((a >> 8) & 255 as u32) as i64)
        -(((b >> 8) & 255 as u32) as i64))
    let u: i64 = abs(((a & 255 as u32) as i64) - ((b & 255 as u32) as i64))
    if g > d { d = g }
    if u > d { d = u }
    return d
}

// A demand on the picture itself. If it is violated, the
// message goes to fd 2 and the program ends with an error -- a
// proof that does not fulfil its own statement must not be
// delivered.
fn request(nm: u64, nn: usize, ist: i64, should: i64) -> usize {
    if ist >= should {
        return 0
    }
    var t: rt.Buf = rt.buf_new()
    var p1: [u8; 10] = "gallery7: "
    rt.buf_push_bytes(&t, (&p1[0]) as u64, 10)
    rt.buf_push_bytes(&t, nm, nn)
    var p2: [u8; 6] = ": got "
    rt.buf_push_bytes(&t, (&p2[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, ist)
    var p3: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&p3[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, should)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(2, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 1
}

// The patterned background. Without it "backdrop-blur" cannot be proven.
fn pattern(z: *mut painter.Painter, m: *mut theme.Theme, x: f64, y: f64,
    w: f64, h: f64) {
    let f: *mut theme.Colors = theme.theme_colors(m)
    painter.round_rect(z, x, y, w, h, 10.0, theme.opaque((*f).surface))
    var j: f64 = 0.0
    while j * 24.0 < h {
        var i: f64 = 0.0
        while i * 24.0 < w {
            if ((i as i64) + (j as i64)) % 2 == 0 {
                var cw: f64 = 24.0
                var ch: f64 = 24.0
                if i * 24.0 + cw > w { cw = w - i * 24.0 }
                if j * 24.0 + ch > h { ch = h - j * 24.0 }
                painter.surface(z, x + i * 24.0, y + j * 24.0, cw, ch,
                    (64 as u32 << 24) | (theme.opaque((*f).accent) & 16777215 as u32))
            }
            i = i + 1.0
        }
        j = j + 1.0
    }
}

// A few coloured shapes ON the pattern. They are the actual
// proof for the glass: a chessboard alone could also be a coarse
// gradient, recognisable shapes behind it cannot.
fn content(z: *mut painter.Painter, m: *mut theme.Theme, x: f64, y: f64,
    w: f64, h: f64) {
    let f: *mut theme.Colors = theme.theme_colors(m)
    painter.round_rect(z, x + 30.0, y + 24.0, 120.0, 120.0, 60.0,
        theme.opaque((*f).accent))
    painter.round_rect(z, x + 200.0, y + 40.0, 180.0, 40.0, 20.0,
        theme.opaque((*f).success))
    painter.round_rect(z, x + 200.0, y + 96.0, 260.0, 40.0, 20.0,
        theme.opaque((*f).warning))
    painter.round_rect(z, x + 490.0, y + 24.0, 90.0, 120.0, 18.0,
        theme.opaque((*f).err_col))
    painter.round_rect(z, x + 650.0, y + 24.0, 120.0, 120.0, 60.0,
        theme.opaque((*f).accent))
    painter.round_rect(z, x + 820.0, y + 40.0, 180.0, 40.0, 20.0,
        theme.opaque((*f).success))
    painter.round_rect(z, x + 820.0, y + 96.0, 260.0, 40.0, 20.0,
        theme.opaque((*f).warning))
    painter.round_rect(z, x + 1110.0, y + 24.0, 30.0, 120.0, 14.0,
        theme.opaque((*f).err_col))
}

// ==================== THE GRID IS RE-CALCULATED
//
// The proof check from outside (tools/fui/belegpruef_main.fi) does not know
// the bands of this sheet; it sees only that colour stands somewhere. WHICH band
// belongs where is known only by this program
// -- so it re-calculates here itself, the same way that
// tools/fui/gallery8_main.fi and demos/fuidemo/main.fi go.
//
// Checked is what a human sees on the sheet:
//
//   a) In EVERY registered row something really stands. A
//      label that was painted into the void (wrong colour,
//      length 0) is noticed here and not only by the reader.
//   b) BETWEEN two bands an empty row remains. If a
//      band runs into the next, something overlaps on the sheet -- the
//      error that the band check from outside does NOT see, because in
//      both bands colour stands after all.
static mut G_ERROR: usize = 0

fn verlange(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 44 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "FALSCH  "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERROR = G_ERROR + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    var w: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&w[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// How many pixels of a row differ from the background.
fn line_color(cv: *mut canvas.Canvas, y: usize, bg: u32) -> i64 {
    let w: usize = canvas.canvas_width(cv)
    var n: i64 = 0
    var x: usize = 0
    while x < w {
        if canvas.canvas_get(cv, x, y) != bg {
            n = n + 1
        }
        x = x + 1
    }
    return n
}

// Does anything at all stand in y0..y1 (inclusive)?
fn band_has_color(cv: *mut canvas.Canvas, y0: usize, y1: usize,
    bg: u32) -> i64 {
    var n: i64 = 0
    var y: usize = y0
    while y <= y1 && y < canvas.canvas_height(cv) {
        n = n + line_color(cv, y, bg)
        y = y + 1
    }
    return n
}

// The first completely empty row in y0..y1 -- the joint between
// two bands. If there is none, -1 comes back, and exactly that
// means: the two bands touch.
fn empty_line(cv: *mut canvas.Canvas, y0: usize, y1: usize,
    bg: u32) -> i64 {
    var y: usize = y0
    while y <= y1 && y < canvas.canvas_height(cv) {
        if line_color(cv, y, bg) == 0 {
            return y as i64
        }
        y = y + 1
    }
    return 0 - 1
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 47] = "gallery7_main <out.png> [light|dark] [font.ttf]"
        rt.write_everything(2, (&u[0]) as u64, 47)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    var dark: bool = true
    if rt.arg_count(start) >= 3 {
        if rt.ld8(rt.arg_ptr(start, 2), 0) == 108 as u8 {
            dark = false
        }
    }
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
    rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    // NO FONT, NO PROOF. A picture without a single
    // letter looks like a picture from afar, and that is exactly how
    // a text-less surface got through the acceptance in OrientOS. A proof without a label proves nothing -- so
    // an error on fd 2 and a return value on which the run
    // gets stuck, instead of writing a silent PNG.
    if fm == 0 {
        var ks: [u8; 60] = "gallery7: keine Schrift gefunden -- ohne Schrift kein Beleg\n"
        rt.write_everything(2, (&ks[0]) as u64, 60)
        return 9
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, H) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(dark)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque(grundton(&m)))

    // THE SHADOW COMES UNCHANGED FROM THE LIBRARY.
    //
    // `render.shadow_color` knows that the same alpha value on a
    // black background carries less than on a white one, and gives in the
    // dark scheme triple the opacity. Exactly this value is painted
    // here -- no surcharge, no minimum value, no second
    // rule next to the library. What the picture shows is thereby what
    // every card in every program gets.
    let schatten: u32 = render.shadow_color(&c)
    // The card is a card: `surface_raised`, in both schemes.
    let kton: u32 = (*f).surface_raised
    let bton: u32 = beschriftungston(dark)

    var t1: [u8; 44] = "EFFECTS -- soft shadow, glass, colour matrix"
    label(&c, 24.0, 20.0, 900.0, 16, (&t1[0]) as u64, 44, style.TOK_TEXT)

    // ================================================= 1. THE SHADOW
    var l1: [u8; 54] = "drop shadow: the blur grows, the last one has spread 8"
    label(&c, 24.0, 52.0, 900.0, 12, (&l1[0]) as u64, 54,
        style.TOK_TEXT_MUTED)
    var i: usize = 0
    while i < 4 {
        let bx: f64 = 40.0 + (i as f64) * 290.0
        var r: i64 = 3
        var spread: f64 = 0.0
        if i == 1 { r = 8 }
        if i == 2 { r = 16 }
        if i == 3 {
            r = 16
            spread = 8.0
        }
        effect.drop_shadow_spread(&z, bx, 84.0, 220.0, 96.0, 16.0, 0.0,
            8.0, r, spread, schatten)
        painter.round_rect(&z, bx, 84.0, 220.0, 96.0, 16.0,
            theme.opaque(kton))
        painter.round_ring(&z, bx, 84.0, 220.0, 96.0, 16.0, 1.0,
            theme.opaque((*f).border_col))
        i = i + 1
    }
    // THE LABEL STANDS IN A ROW OF ITS OWN, FREE OF SHADOW.
    //
    // It used to stand 22 points under the card -- in the middle of the shadow.
    // In the dark scheme the shadow is a FRINGE OF LIGHT, and that
    // lay as a light halo under the letters: the word did not stand
    // on the background, but in a cloud, and that is exactly how
    // you recognise a label that does not belong there.
    //
    // THE LABEL ROW is therefore laid so that it lies OUTSIDE
    // the reach of the largest shadow of this band. The
    // reach stands in `lib/fui/effect.fi` and is no feeling:
    // three boxes of half-width `blur` reach 3*blur far, plus the
    // offset and the spread. For the strongest probe that is
    // 180 (lower edge) + 8 (dy) + 8 (spread) + 48 (3*16) = 244 --
    // the row begins below it, and thereby behind the font lies
    // nothing but the background of the page.
    let beschriftung_y: f64 = 248.0
    var c1: [u8; 9] = "blur 3 px"
    label(&c, 40.0, beschriftung_y, 220.0, 12, (&c1[0]) as u64, 9, bton)
    var c2: [u8; 9] = "blur 8 px"
    label(&c, 330.0, beschriftung_y, 220.0, 12, (&c2[0]) as u64, 9, bton)
    var c3: [u8; 10] = "blur 16 px"
    label(&c, 620.0, beschriftung_y, 220.0, 12, (&c3[0]) as u64, 10,
        bton)
    var c4: [u8; 20] = "blur 16 px, spread 8"
    label(&c, 910.0, beschriftung_y, 220.0, 12, (&c4[0]) as u64, 20,
        bton)

    // ==================================================== 2. THE GLASS
    var l2: [u8; 57] = "glass over content -- left under the pane, right unglazed"
    label(&c, 24.0, 310.0, 1000.0, 12, (&l2[0]) as u64, 57,
        style.TOK_TEXT_MUTED)
    pattern(&z, &m, 40.0, 336.0, 1160.0, 170.0)
    content(&z, &m, 40.0, 336.0, 1160.0, 170.0)
    // The pane casts a shadow itself; it lies UNDER it and
    // is therefore painted before it -- otherwise it blurs it along.
    effect.drop_shadow_spread(&z, 70.0, 366.0, 570.0, 110.0, 22.0, 0.0,
        10.0, 12, 0.0, schatten)
    effect.glass_round(&z, 70.0, 366.0, 570.0, 110.0, 22.0, dark)
    var g1: [u8; 28] = "backdrop blur + saturate 1.4"
    label(&c, 100.0, 394.0, 520.0, 15, (&g1[0]) as u64, 28,
        style.TOK_TEXT)
    var g2: [u8; 43] = "the content behind stays readable as shapes"
    label(&c, 100.0, 424.0, 520.0, 12, (&g2[0]) as u64, 43,
        style.TOK_TEXT_MUTED)

    // ============================================== 3. DIE FARBMATRIX
    var l3: [u8; 64] = "colour matrix on the same ground: grey, saturate 2, contrast 1.6"
    label(&c, 24.0, 530.0, 1000.0, 12, (&l3[0]) as u64, 64,
        style.TOK_TEXT_MUTED)
    var k: usize = 0
    while k < 4 {
        let bx: f64 = 40.0 + (k as f64) * 300.0
        pattern(&z, &m, bx, 556.0, 260.0, 110.0)
        painter.round_rect(&z, bx + 30.0, 576.0, 70.0, 70.0, 35.0,
            theme.opaque((*f).accent))
        painter.round_rect(&z, bx + 120.0, 586.0, 110.0, 24.0, 12.0,
            theme.opaque((*f).success))
        painter.round_rect(&z, bx + 120.0, 618.0, 110.0, 24.0, 12.0,
            theme.opaque((*f).warning))
        if k > 0 {
            var cm: effect.ColorMatrix = effect.cm_grayscale()
            if k == 2 { cm = effect.cm_saturate(2.0) }
            if k == 3 { cm = effect.cm_contrast(1.6) }
            effect.cm_apply_rect(&cv, &cm, bx as i64, 556, 260, 110)
        }
        k = k + 1
    }
    var m1: [u8; 8] = "original"
    label(&c, 40.0, 674.0, 260.0, 12, (&m1[0]) as u64, 8,
        style.TOK_TEXT_MUTED)
    var m2: [u8; 9] = "grayscale"
    label(&c, 340.0, 674.0, 260.0, 12, (&m2[0]) as u64, 9,
        style.TOK_TEXT_MUTED)
    var m3: [u8; 10] = "saturate 2"
    label(&c, 640.0, 674.0, 260.0, 12, (&m3[0]) as u64, 10,
        style.TOK_TEXT_MUTED)
    var m4: [u8; 12] = "contrast 1.6"
    label(&c, 940.0, 674.0, 260.0, 12, (&m4[0]) as u64, 12,
        style.TOK_TEXT_MUTED)

    // ======================================================================
    // THE PICTURE RE-CALCULATES ITSELF
    // ======================================================================
    //
    // "Looks soft" is no statement, and "in the dark you simply see
    // less" is an excuse. This sheet claims five things,
    // and each of them is MEASURED here on its own pixels:
    //
    //   1. THE SHADOW IS DARKER THAN ITS BACKGROUND, and with the
    //      opacity that `render.shadow_color` gives every program --
    //      without a surcharge of this sheet. Measured is ONE point
    //      under the lower edge of every card, in its middle: there
    //      the background tone must be pressed by at least 18 tone values.
    //      Measured on 21.09.2026: light 61/48/40/50, dark
    //      30/24/20/25 tone values of distance.
    //
    //   2. IT IS A GRADIENT AND NO EDGE. From the lower edge
    //      downwards the shadow becomes lighter with every point, 48 points
    //      far, without once becoming darker again -- and between
    //      the darkest and the lightest place lie at least
    //      ten tone values. A hard edge fails here: it
    //      jumps and has no span. Measured: light 40, dark 20
    //      tone values under the probe with blur 16.
    //
    //   3. THE FOUR PROBES CAN BE TOLD APART, and what
    //      distinguishes them is the REACH: how far under the card
    //      the shadow has vanished into the background (except for two
    //      tone values). Exactly that is what a larger blur radius does,
    //      and exactly by that it is recognised -- a single
    //      measuring point twelve points under the card was not it, because
    //      there blur 8 and blur 16 naturally lie close
    //      together. Measured on 21.09.2026: light 13/22/36, dark
    //      12/20/32 points -- the distances thus 9 and 14 (light)
    //      or 8 and 12 (dark). Demanded are six and
    //      ten points, so that the demand carries the statement and
    //      not the last measured place.
    //
    //   4. THE SPREAD ADDS. The same blur with spread 8 is
    //      at the same place darker than without -- demanded are four
    //      tone values, measured were light 10 and dark 5.
    //
    //   5. THE SHAPES BEHIND THE GLASS PANE ARE STILL THERE. A
    //      frosted pane that stirs everything into one tone is no
    //      backdrop blur, but a lid. Measured is the
    //      colour distance (largest channel difference) between three
    //      shapes under the pane and the background BETWEEN them --
    //      likewise under the pane, so that not the pane itself
    //      is measured against the free background. Demanded are 15;
    //      measured were 21 to 50.
    //
    // All numbers apply in BOTH schemes equally: a proof that
    // may show less in the dark is in the dark no proof.
    let basic: i64 = tonwert(theme.opaque(grundton(&m)))
    var wrong: usize = 0
    var pi4: usize = 0
    while pi4 < 4 {
        let px4: usize = 150 + pi4 * 290
        var n1: [u8; 24] = "Schatten unter der Karte"
        wrong = wrong + request((&n1[0]) as u64, 24,
            basic - tonwert(canvas.canvas_get(&cv, px4, 181)), 18)
        var n2: [u8; 24] = "Verlauf, monoton fallend"
        wrong = wrong + request((&n2[0]) as u64, 24,
            gradient_span(&cv, px4, 181, 48), 10)
        pi4 = pi4 + 1
    }
    let w0: i64 = reichweite(&cv, 150, 181, basic)
    let w1: i64 = reichweite(&cv, 440, 181, basic)
    let w2: i64 = reichweite(&cv, 730, 181, basic)
    var e1: [u8; 24] = "blur 8 traegt weiter    "
    wrong = wrong + request((&e1[0]) as u64, 24, w1 - w0, 6)
    var e2: [u8; 24] = "blur 16 traegt weiter   "
    wrong = wrong + request((&e2[0]) as u64, 24, w2 - w1, 10)
    var e3: [u8; 24] = "Streuung 8 legt zu      "
    wrong = wrong + request((&e3[0]) as u64, 24,
        tonwert(canvas.canvas_get(&cv, 730, 197))
        -tonwert(canvas.canvas_get(&cv, 1020, 197)), 4)
    // Under the pane: circle, warning bar, red block -- and the
    // background between warning bar and red block.
    let gg: u32 = canvas.canvas_get(&cv, 510, 457)
    var e4: [u8; 24] = "Kreis hinter dem Glas   "
    wrong = wrong + request((&e4[0]) as u64, 24,
        kanalabstand(canvas.canvas_get(&cv, 130, 457), gg), 15)
    var e5: [u8; 24] = "Balken hinter dem Glas  "
    wrong = wrong + request((&e5[0]) as u64, 24,
        kanalabstand(canvas.canvas_get(&cv, 330, 454), gg), 15)
    var e6: [u8; 24] = "Block hinter dem Glas   "
    wrong = wrong + request((&e6[0]) as u64, 24,
        kanalabstand(canvas.canvas_get(&cv, 575, 457), gg), 15)
    // THE TILE LABEL IS READABLE, and against the background on which
    // it REALLY stands: measured is the pixel pair from the
    // finished image -- the colour of the text token against the background two
    // rows above the label. 4.5:1 is 450 hundredths, the
    // threshold from tools/fui/contrast_main.fi and the skill default.
    let tfarbe: u32 = theme.opaque(theme.color_from_token(&m, bton))
    let tgrund: u32 = canvas.canvas_get(&cv, 60,
        (beschriftung_y as i64 - 2) as usize)
    let kk: i64 = (theme.contrast(tfarbe, tgrund) * 100.0 + 0.5) as i64
    var e7: [u8; 24] = "Kachelbeschriftung 4.5:1"
    wrong = wrong + request((&e7[0]) as u64, 24, kk, 450)
    if wrong > 0 {
        return 8
    }

    // ---- THE THREE BANDS, RE-CALCULATED (see above)
    //
    // The numbers are the y with which painting was done above: the
    // shadow row under its label at 52, the glass at
    // 310/336, the colour matrix at 530. Checking is done against the
    // CANVAS, not against the constants -- otherwise the
    // calculation would check itself.
    let pgrund: u32 = canvas.canvas_get(&cv, 2, 2)
    var b1: [u8; 44] = "1 the shadow band carries ink               "
    verlange((&b1[0]) as u64, 43,
        band_has_color(&cv, 60, 300, pgrund) > 1000,
        band_has_color(&cv, 60, 300, pgrund), 1000)
    var b2: [u8; 44] = "2 the glass band carries ink                "
    verlange((&b2[0]) as u64, 43,
        band_has_color(&cv, 336, 506, pgrund) > 1000,
        band_has_color(&cv, 336, 506, pgrund), 1000)
    var b3: [u8; 44] = "3 the colour matrix band carries ink        "
    verlange((&b3[0]) as u64, 43,
        band_has_color(&cv, 556, 660, pgrund) > 1000,
        band_has_color(&cv, 556, 660, pgrund), 1000)
    // THE JOINTS. Between shadow row and the label of the
    // glass (y 300..310) and between glass and colour matrix
    // (y 506..530) there must lie a completely empty row. If it is missing,
    // a band runs into the next.
    // THE JOINTS ARE MEASURED TIGHTLY. The shadow of the pane runs
    // out to row 514, the label of the colour matrix begins at
    // 530; in between the sheet belongs to nobody and must be
    // COMPLETELY empty. The soft version ("somewhere in the
    // joint there lies an empty row") let a label set 38 points too high
    // through, because behind it there was still air --
    // re-measured on the deliberately shifted sheet. The
    // strict version catches exactly that.
    var b4: [u8; 44] = "1/2 the gap 301..309 is completely empty    "
    verlange((&b4[0]) as u64, 43,
        band_has_color(&cv, 301, 309, pgrund) == 0,
        band_has_color(&cv, 301, 309, pgrund), 0)
    var b5: [u8; 44] = "2/3 the gap 515..529 is completely empty    "
    verlange((&b5[0]) as u64, 43,
        band_has_color(&cv, 515, 529, pgrund) == 0,
        band_has_color(&cv, 515, 529, pgrund), 0)
    // AND THE LABEL OF THE COLOUR MATRIX STANDS WHERE IT BELONGS.
    //
    // The two joints above catch a band that sits too LOW. A
    // band that sits too HIGH is NOT noticed by them: it then disappears
    // into the pane above, where colour stands anyway, and the
    // joint below stays empty. That is no invented case --
    // re-measured on a sheet deliberately set 38 points too high:
    // joints and bands all stayed green, and only
    // rows 533..545 went from 1200 pixels to 0 empty.
    //
    // So exactly that is checked: in the row in which the
    // label stands there MUST be colour.
    var b6: [u8; 44] = "3 the colour matrix label is really there   "
    verlange((&b6[0]) as u64, 43,
        band_has_color(&cv, 533, 545, pgrund) > 200,
        band_has_color(&cv, 533, 545, pgrund), 200)
    // The same question for the label of the glass (y 310, so
    // ascents around 313..325) and that of the shadow row (y 52).
    var b7: [u8; 44] = "2 the glass label is really there           "
    verlange((&b7[0]) as u64, 43,
        band_has_color(&cv, 313, 325, pgrund) > 200,
        band_has_color(&cv, 313, 325, pgrund), 200)
    var b8: [u8; 44] = "1 the shadow label is really there          "
    verlange((&b8[0]) as u64, 43,
        band_has_color(&cv, 55, 67, pgrund) > 200,
        band_has_color(&cv, 55, 67, pgrund), 200)
    if G_ERROR > 0 {
        var gf: [u8; 60] = "gallery7: das Raster stimmt nicht -- kein Beleg geschrieben\n"
        rt.write_everything(2, (&gf[0]) as u64, 60)
        return 10
    }

    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&cv, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var pk: usize = 0
    while pk < rt.c_length(path) {
        rt.buf_push(&pf, rt.ld8(path, pk))
        pk = pk + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 10] = "GALLERY 7\n"
    rt.write_everything(1, (&okm[0]) as u64, 10)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    return 0
}
