// SPDX-License-Identifier: MPL-2.0
// tools/fui/gallery7_main.fi -- DIE EFFEKTE ALS BILD.
//
// Unschaerfe zeigt sich nur ueber einem GEMUSTERTEN Grund: auf einer
// glatten Flaeche sieht ein Weichzeichner aus wie gar nichts. Also
// erst ein Schachbrett, dann darueber der weiche Schatten, die
// Glasscheibe und die Farbmatrix.
//
//     gallery7_main <out.png> [light|dark] [<font.ttf>]
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.layout
import fui.effect

const FONTSET_BYTES: usize = 4096
const W: usize = 1240
const H: usize = 430

fn label(c: *mut render.Ctx, x: f64, y: f64, w: f64, px: usize, p: u64,
    n: usize, tok: u32) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, w, 18.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(tok))
    *s = style.style_set_font(*s, 0, px)
    *s = style.style_set_pad(*s, 0, 0)
    render.draw_label(c, &e)
}

// Der gemusterte Grund. Ohne ihn ist "backdrop-blur" nicht zu belegen.
fn muster(z: *mut painter.Painter, m: *mut theme.Theme, x: f64, y: f64,
    w: f64, h: f64) {
    let f: *mut theme.Colors = theme.theme_colors(m)
    painter.round_rect(z, x, y, w, h, 10.0, theme.opaque((*f).surface))
    var j: f64 = 0.0
    while j * 24.0 < h {
        var i: f64 = 0.0
        while i * 24.0 < w {
            if ((i as i64) + (j as i64)) % 2 == 0 {
                var cw: f64 = 24.0
                var ch: f64 = 24.0
                if i * 24.0 + cw > w { cw = w - i * 24.0 }
                if j * 24.0 + ch > h { ch = h - j * 24.0 }
                painter.surface(z, x + i * 24.0, y + j * 24.0, cw, ch,
                    (64 as u32 << 24) | (theme.opaque((*f).accent) & 16777215 as u32))
            }
            i = i + 1.0
        }
        j = j + 1.0
    }
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 47] = "gallery7_main <out.png> [light|dark] [font.ttf]"
        rt.write_everything(2, (&u[0]) as u64, 47)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    var dark: bool = true
    if rt.arg_count(start) >= 3 {
        if rt.ld8(rt.arg_ptr(start, 2), 0) == 108 as u8 {
            dark = false
        }
    }
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
        rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 300) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(dark)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque((*f).base))

    var t1: [u8; 39] = "EFFECTS -- shadow, glass, colour matrix"
    label(&c, 24.0, 22.0, 900.0, 15, (&t1[0]) as u64, 39, style.TOK_TEXT)

    // ---- Der weiche Schatten, in drei Staerken.
    var l1: [u8; 31] = "drop shadow, blur 2 / 6 / 12 px"
    label(&c, 24.0, 58.0, 500.0, 12, (&l1[0]) as u64, 31,
        style.TOK_TEXT_MUTED)
    var i: usize = 0
    while i < 3 {
        let bx: f64 = 40.0 + (i as f64) * 200.0
        var r: i64 = 2
        if i == 1 { r = 6 }
        if i == 2 { r = 12 }
        effect.drop_shadow_round(&z, bx, 100.0, 150.0, 90.0, 14.0, 0.0,
            6.0, r, (110 as u32 << 24))
        painter.round_rect(&z, bx, 100.0, 150.0, 90.0, 14.0,
            theme.opaque((*f).surface_raised))
        i = i + 1
    }

    // ---- Glas ueber dem Muster.
    var l2: [u8; 36] = "backdrop blur over a pattern (glass)"
    label(&c, 660.0, 58.0, 540.0, 12, (&l2[0]) as u64, 36,
        style.TOK_TEXT_MUTED)
    muster(&z, &m, 660.0, 84.0, 540.0, 130.0)
    effect.backdrop_blur(&z, 700.0, 110.0, 300.0, 80.0, 16.0, 6,
        (60 as u32 << 24) | 16777215 as u32)
    painter.round_ring(&z, 700.0, 110.0, 300.0, 80.0, 16.0, 1.0,
        (90 as u32 << 24) | 16777215 as u32)

    // ---- Die Farbmatrix auf demselben Muster.
    var l3: [u8; 47] = "colour matrix: grey / saturate 2 / contrast 1.6"
    label(&c, 24.0, 250.0, 900.0, 12, (&l3[0]) as u64, 47,
        style.TOK_TEXT_MUTED)
    var k: usize = 0
    while k < 3 {
        let bx: f64 = 40.0 + (k as f64) * 300.0
        muster(&z, &m, bx, 276.0, 260.0, 120.0)
        var cm: effect.ColorMatrix = effect.cm_grayscale()
        if k == 1 { cm = effect.cm_saturate(2.0) }
        if k == 2 { cm = effect.cm_contrast(1.6) }
        effect.cm_apply_rect(&cv, &cm, bx as i64, 276, 260, 120)
        k = k + 1
    }

    // ---- Und eine Karte mit Schatten UND Glas, wie eine echte Leiste.
    muster(&z, &m, 950.0, 276.0, 250.0, 120.0)
    effect.drop_shadow_round(&z, 975.0, 300.0, 200.0, 72.0, 16.0, 0.0,
        8.0, 8, (120 as u32 << 24))
    effect.backdrop_blur(&z, 975.0, 300.0, 200.0, 72.0, 16.0, 8,
        (70 as u32 << 24) | 16777215 as u32)

    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&cv, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var pk: usize = 0
    while pk < rt.c_length(path) {
        rt.buf_push(&pf, rt.ld8(path, pk))
        pk = pk + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 10] = "GALLERY 7\n"
    rt.write_everything(1, (&okm[0]) as u64, 10)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    return 0
}
