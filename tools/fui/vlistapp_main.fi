// SPDX-License-Identifier: MPL-2.0
// tools/fui/vlistapp_main.fi -- THE CHECK OF app.vlist_new (lib/fui/app.fi + vlist.fi + vlistview.fi), WITHOUT A WINDOW.
//
// A window with a list of 100000 rows, a table (3 columns, header, sort) and a button. It is painted into a
// canvas and driven through the entry points the platform hosts call (fuiwirt pointer, app_key, app_char):
// click / Ctrl / Shift click, double click, arrows, PgDn, Home / End, Enter, typeahead, wheel, scroll bar
// drag, header sort click, divider drag, hover, a finger (drag, fling, tap), focus, light + dark pixels,
// the accessibility audit and the time of one frame with 100000 rows.
//
//     firnc -o /tmp/vlistapp tools/fui/vlistapp_main.fi && /tmp/vlistapp [dir-for-pngs | speed]
//
// `speed` = only the frame timing (build with an optimising compiler; the checks run unoptimised).
import std.rt
import fui.safeout
import std.time
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import fui.event
import fui.a11y
import fui.viewport
import fui.vlist
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app

static mut BAD: usize = 0
static mut PICKS: usize = 0
static mut PICK_ID: usize = 0
static mut PICK_ROW: usize = 0
static mut ACTS: usize = 0
static mut ACT_ROW: usize = 0
static mut SORTS: usize = 0
static mut SORT_COL: usize = 0
static mut CLOCK: i64 = 1000
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_num(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

// ------------------------------------------------------------ the rows

fn put_dec(r: *mut vlist.VRow, v: usize) {
    var tmp: [u8; 20] = [0; 20]
    var k: usize = 0
    var x: usize = v
    if x == 0 {
        tmp[0] = 48 as u8
        k = 1
    }
    while x > 0 {
        tmp[k] = (48 + (x % 10)) as u8
        x = x / 10
        k = k + 1
    }
    var n: usize = (*r).n
    var j: usize = k
    while j > 0 {
        j = j - 1
        (*r).text[n] = tmp[j]
        n = n + 1
    }
    (*r).n = n
}

// ud 0: the big list ("Row 12345", every tenth row has a detail); ud 1: the table
fn row_of(ud: u64, i: usize, out: *mut vlist.VRow) {
    if ud == 0 {
        vlist.vrow_text(out, "Row ")
        put_dec(out, i)
        if i % 10 == 0 {
            vlist.vrow_detail(out, "ten")
        }
        return
    }
    if (*out).col == 0 {
        let k: usize = i % 6
        if k == 0 { vlist.vrow_text(out, "Alpha") }
        else if k == 1 { vlist.vrow_text(out, "alpine") }
        else if k == 2 { vlist.vrow_text(out, "Beta") }
        else if k == 3 { vlist.vrow_text(out, "gamma") }
        else if k == 4 { vlist.vrow_text(out, "Gammon") }
        else { vlist.vrow_text(out, "delta") }
    } else if (*out).col == 1 {
        vlist.vrow_text(out, "n")
        put_dec(out, i)
    } else {
        vlist.vrow_text(out, "")
        put_dec(out, (i * 37) % 1000)
    }
}

fn picked(a: *mut app.App, id: usize, i: usize) {
    PICKS = PICKS + 1
    PICK_ID = id
    PICK_ROW = i
}

fn activated(a: *mut app.App, id: usize, i: usize) {
    ACTS = ACTS + 1
    ACT_ROW = i
}

fn sorted(a: *mut app.App, id: usize, col: usize) {
    SORTS = SORTS + 1
    SORT_COL = col
}

fn noop(a: *mut app.App) {
}

// ------------------------------------------------------------ a surface

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn tick(a: *mut app.App, ms: i64) {
    CLOCK = ms
    fuiwirt.host_tick(app.app_host(a), ms)
}

fn settle(a: *mut app.App) {
    let i: usize = fuiwirt.host_take_activated(app.app_host(a))
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
}

fn save(s: *mut Surface, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(&(*s).cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

fn click_at(a: *mut app.App, s: *mut Surface, x: f64, y: f64, mods: u32) {
    let w: *mut fuiwirt.Host = app.app_host(a)
    fuiwirt.host_set_mods(w, mods)
    let c1: u32 = fuiwirt.host_pointer_move(w, x, y)
    let c2: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let c3: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
    fuiwirt.host_set_mods(w, 0 as u32)
    settle(a)
    frame(a, s)
}

fn key(a: *mut app.App, s: *mut Surface, k: u32, mods: u32) {
    let used: bool = app.app_key(a as u64, k, mods)
    if !used {
        let h: u32 = fuiwirt.host_key(app.app_host(a), 0 as u32, 0 as u32)
    }
    frame(a, s)
}

fn type_text(a: *mut app.App, s: *mut Surface, t: str) {
    var i: usize = 0
    while i < t.n {
        let b: bool = app.app_char(a as u64, rt.ld8(t.p as u64, i) as u32, 0 as u32)
        i = i + 1
    }
    frame(a, s)
}

// centre of row `row` in window pixels (the row must show)
fn row_y(a: *mut app.App, id: usize, row: usize) -> f64 {
    let v: *mut vlist.Vlist = app.vlist_model(a, id)
    return vlist.vl_body_y(v) + vlist.vl_row_top(v, row) - vlist.vl_scroll_y(v) + vlist.vl_height_of(v, row) / 2.0
}

fn node_cx(a: *mut app.App, id: usize) -> f64 {
    let sc: *mut scene.Scene = app.app_scene(a)
    return scene.node_x(sc, id) + scene.node_w(sc, id) / 2.0
}

fn node_left(a: *mut app.App, id: usize, dx: f64) -> f64 {
    return scene.node_x(app.app_scene(a), id) + dx
}

fn pix(s: *mut Surface, x: f64, y: f64) -> u32 {
    return canvas.canvas_get(&(*s).cv, x as usize, y as usize)
}

fn luma(c: u32) -> u32 {
    return canvas.color_r(c) + canvas.color_g(c) + canvas.color_b(c)
}

// the number of pixels in the row band [y0, y1) x [x0, x1) that differ from the colour `bg`
fn ink(s: *mut Surface, x0: f64, x1: f64, y0: f64, y1: f64, bg: u32) -> usize {
    var n: usize = 0
    var y: usize = y0 as usize
    while y < y1 as usize {
        var x: usize = x0 as usize
        while x < x1 as usize {
            if canvas.canvas_get(&(*s).cv, x, y) != bg {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

// ------------------------------------------------------------ the frame time

fn speed(a: *mut app.App, s: *mut Surface, big: usize) -> u64 {
    let v: *mut vlist.Vlist = app.vlist_model(a, big)
    var i: usize = 0
    while i < 20 {
        vlist.vl_scroll_to(v, (i * 4999) % 100000, vlist.SCROLL_TOP)
        frame(a, s)
        i = i + 1
    }
    let n: usize = 300
    let t0: u64 = time.monotonic_ns()
    i = 0
    while i < n {
        vlist.vl_scroll_to(v, (i * 331) % 100000, vlist.SCROLL_TOP)
        app.app_paint(a as u64, (*s).w, (*s).h)
        fuiwirt.host_painted(app.app_host(a))
        i = i + 1
    }
    let t1: u64 = time.monotonic_ns()
    return (t1 - t0) / (n as u64)
}

fn run_speed(a: *mut app.App, s: *mut Surface, big: usize, limit_us: u64) {
    let ns: u64 = speed(a, s, big)
    say("  one frame of the window, 100000 rows: ")
    say_num((ns / 1000) as i64)
    say(" us (")
    say_num(((ns % 1000000) / 1000) as i64)
    say(" us part, ns total ")
    say_num(ns as i64)
    say(")\n")
    check(ns < limit_us * 1000, "frame with 100000 rows under the limit")
}

// W5: does the buffer contain the text `t`?
fn has(p: u64, n: usize, t: str) -> bool {
    if t.n == 0 || n < t.n {
        return false
    }
    var i: usize = 0
    while i + t.n <= n {
        var k: usize = 0
        while k < t.n && *((p + (i + k) as u64) as *mut u8) == *(((t.p) as u64 + k as u64) as *mut u8) {
            k = k + 1
        }
        if k == t.n {
            return true
        }
        i = i + 1
    }
    return false
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("vlistapp: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Lists", 640, 560)
    let title: usize = app.label(a, "A list of 100000 rows and a table", 0)
    let big: usize = app.vlist_new(a, "Big list", 560, 220, 100000, row_of, 0)
    let tbl: usize = app.vlist_new(a, "Table", 560, 150, 50, row_of, 1)
    let ok: usize = app.button(a, "OK", noop)
    app.vlist_on_pick(a, big, picked)
    app.vlist_on_activate(a, big, activated)
    app.vlist_on_pick(a, tbl, picked)
    app.vlist_on_activate(a, tbl, activated)
    app.vlist_on_sort(a, tbl, sorted)
    let tv: *mut vlist.Vlist = app.vlist_model(a, tbl)
    vlist.vl_set_columns(tv, 3)
    vlist.vl_set_col_title(tv, 0, "Name")
    vlist.vl_set_col_title(tv, 1, "Key")
    vlist.vl_set_col_title(tv, 2, "Size")
    vlist.vl_set_col_width(tv, 0, 200.0)
    vlist.vl_set_col_width(tv, 1, 150.0)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 640, 560)
    if s as u64 == 0 {
        say("vlistapp: no canvas\n")
        return 9
    }
    tick(a, 1000 as i64)
    frame(a, s)
    frame(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    let bv: *mut vlist.Vlist = app.vlist_model(a, big)

    if dir != 0 && rt.c_length(dir) == 5 && *(dir as *mut u8) == (115 as u8) {
        run_speed(a, s, big, 5000)
        if BAD == 0 {
            say("VLISTAPP PASSED\n")
            return 0
        }
        say("VLISTAPP FAILED\n")
        return 1
    }

    say("-- the nodes\n")
    check(big != app.NONE && tbl != app.NONE && big != tbl, "two lists made (one node each)")
    check(app.vlist_model(a, ok) as u64 == 0, "vlist_model of a button is nothing")
    check(scene.node_w(sc, big) > 100.0 && scene.node_h(sc, big) > 100.0, "the big list has a size")
    check(vlist.vl_count(bv) == 100000, "100000 rows in the model")
    check(vlist.vl_columns(tv) == 3 && vlist.vl_header_h(tv) > 0.0, "the table has a header after painting")
    check(vlist.vl_header_h(bv) == 0.0, "the plain list has none")
    check(a11y.a11y_role(sc, app.ax(a), big) == a11y.ROLE_LIST, "accessibility role LIST")
    check(app.audit(a) == 0, "accessibility audit: no unnamed element")

    say("-- the accessibility tree: the rows that show are virtual listitems\n")
    let abuf: u64 = rt.heap_alloc(131072)
    let an: usize = a11y.a11y_dump(sc, app.ax(a), abuf, 131072)
    check(an > 0 && an < 131072, "the tree dump fits")
    check(has(abuf, an, "list \"Big list\""), "the list is named in the tree")
    check(has(abuf, an, "listitem \"Row 0\" focusable"), "row 0 is a virtual listitem")
    check(has(abuf, an, "pos=1/100000 virtual"), "row 0 knows its place: 1 of 100000")
    check(a11y.a11y_vrow_end(app.ax(a), big) - a11y.a11y_vrow_first(app.ax(a), big) == vlist.vl_end(bv) - vlist.vl_first(bv), "as many virtual rows as show")
    check(a11y.a11y_vrow_end(app.ax(a), big) - a11y.a11y_vrow_first(app.ax(a), big) < 40, "only the visible rows are reported (not 100000)")
    check(has(abuf, an, "listitem \"Alpha"), "the table rows are virtual listitems with their columns joined")
    let jn: usize = a11y.a11y_dump_json(sc, app.ax(a), abuf, 131072)
    check(jn > 0 && jn < 131072 && *(abuf as *mut u8) == (123 as u8), "the JSON export is an object")
    check(has(abuf, jn, "\"virtual\":true") && has(abuf, jn, "\"role\":\"list\""), "the JSON export has the list and its virtual rows")
    var nb: [u8; 64] = [0 as u8; 64]
    let nl: usize = a11y.a11y_vrow_name(app.ax(a), big, 5, (&nb[0]) as u64, 64)
    check(nl == 5 && nb[4] == (53 as u8), "a11y_vrow_name(5) is Row 5")

    say("-- the picture\n")
    let bx: f64 = node_left(a, big, 24.0)
    var edge: u32 = pix(s, 1.0, 1.0)
    check(luma(edge) > 600, "light theme: the window ground is bright")
    let r0: f64 = row_y(a, big, 0)
    let r1: f64 = row_y(a, big, 1)
    let rh: f64 = r1 - r0
    check(rh > 14.0 && rh < 60.0, "row height from the theme")
    let before: usize = ink(s, bx, bx + 120.0, r0 - rh / 2.0 + 2.0, r0 + rh / 2.0 - 2.0, pix(s, bx + 300.0, r0 + 0.0))
    check(before > 20, "row 0 has text pixels")
    save(s, dir, "vlistapp_light.png")

    say("-- the mouse\n")
    tick(a, 2000 as i64)
    click_at(a, s, bx, row_y(a, big, 2), 0 as u32)
    check(PICKS == 1 && PICK_ID == big && PICK_ROW == 2, "click on row 2 picks it (callback once)")
    check(app.vlist_selected(a, big) == 2 && vlist.vl_is_selected(bv, 2), "row 2 is selected")
    check(app.focus(a) == big, "the click gave the list the focus")
    let sel_bg: u32 = pix(s, bx + 300.0, row_y(a, big, 2))
    let off_bg: u32 = pix(s, bx + 300.0, row_y(a, big, 4))
    check(sel_bg != off_bg, "the selected row is painted differently")
    let w: *mut fuiwirt.Host = app.app_host(a)
    let m1: u32 = fuiwirt.host_pointer_move(w, bx, row_y(a, big, 6))
    frame(a, s)
    check(vlist.vl_hover(bv) == 6, "hover follows the pointer")
    check(pix(s, bx + 300.0, row_y(a, big, 6)) != off_bg, "the hovered row is painted differently")
    let m2: u32 = fuiwirt.host_pointer_move(w, 2.0, 2.0)
    check(vlist.vl_hover(bv) == vlist.NONE || vlist.vl_hover(bv) != 6, "the hover leaves with the pointer")
    tick(a, 5000 as i64)
    click_at(a, s, bx, row_y(a, big, 4), 0 as u32)
    check(ACTS == 0 && PICKS == 2, "a second click far later on another row does not activate")
    tick(a, 5100 as i64)
    click_at(a, s, bx, row_y(a, big, 4), 0 as u32)
    check(ACTS == 1 && ACT_ROW == 4, "a double click activates the row")
    let p0: usize = PICKS
    click_at(a, s, bx, row_y(a, big, 7), 4 as u32)
    check(vlist.vl_sel_count(bv) == 1 && app.vlist_selected(a, big) == 7, "Ctrl+click on a single-select list still chooses one row")
    vlist.vl_set_multi(bv, true)
    click_at(a, s, bx, row_y(a, big, 1), 0 as u32)
    click_at(a, s, bx, row_y(a, big, 5), 1 as u32)
    check(vlist.vl_sel_count(bv) == 5 && vlist.vl_is_selected(bv, 3), "multi: Shift+click selects the range 1..5")
    click_at(a, s, bx, row_y(a, big, 7), 4 as u32)
    check(vlist.vl_sel_count(bv) == 6 && vlist.vl_is_selected(bv, 7), "multi: Ctrl+click adds a row")
    vlist.vl_set_multi(bv, false)

    say("-- the keys\n")
    click_at(a, s, bx, row_y(a, big, 3), 0 as u32)
    PICKS = 0
    key(a, s, editor.KEY_DOWN, 0 as u32)
    check(app.vlist_selected(a, big) == 4 && PICKS == 1 && PICK_ROW == 4, "Down moves the choice and calls back")
    key(a, s, editor.KEY_UP, 0 as u32)
    check(app.vlist_selected(a, big) == 3, "Up")
    key(a, s, editor.KEY_PGDN, 0 as u32)
    check(app.vlist_selected(a, big) > 8, "PgDn jumps a page")
    key(a, s, editor.KEY_END, 0 as u32)
    check(app.vlist_selected(a, big) == 99999, "End goes to row 99999")
    let en: usize = a11y.a11y_dump(sc, app.ax(a), abuf, 131072)
    check(has(abuf, en, "listitem \"Row 99999\" focusable focused selected pos=100000/100000 virtual"), "after End: the last row is selected and focused in the tree")
    check(!has(abuf, en, "listitem \"Row 0\""), "after End: row 0 is no longer reported")
    check(vlist.vl_scroll_y(bv) > 1000000.0, "End scrolls 100000 rows down")
    let last_ink: usize = ink(s, bx, bx + 120.0, row_y(a, big, 99999) - rh / 2.0 + 2.0, row_y(a, big, 99999) + rh / 2.0 - 2.0, pix(s, bx + 300.0, row_y(a, big, 99999)))
    check(last_ink > 20, "the last row is painted with its text")
    key(a, s, editor.KEY_HOME, 0 as u32)
    check(app.vlist_selected(a, big) == 0 && vlist.vl_scroll_y(bv) < 1.0, "Home goes back to the first row")
    ACTS = 0
    key(a, s, editor.KEY_ENTER, 0 as u32)
    check(ACTS == 1 && ACT_ROW == 0, "Enter activates the chosen row")
    let tabbed: u32 = fuiwirt.host_key(app.app_host(a), fuiwirt.KEY_TAB, 0 as u32)
    frame(a, s)
    check(app.focus(a) != big, "Tab leaves the list (the list does not keep it)")

    say("-- typeahead in the table\n")
    click_at(a, s, node_left(a, tbl, 20.0), row_y(a, tbl, 0), 0 as u32)
    check(app.focus(a) == tbl && app.vlist_selected(a, tbl) == 0, "click in the table: focus + row 0")
    tick(a, 8000 as i64)
    type_text(a, s, "g")
    check(app.vlist_selected(a, tbl) == 3, "typing g jumps to 'gamma'")
    tick(a, 12000 as i64)
    type_text(a, s, "d")
    check(app.vlist_selected(a, tbl) == 5, "typing d (after a pause) jumps to 'delta'")

    say("-- the wheel\n")
    let w0: f64 = vlist.vl_scroll_y(bv)
    let m3: u32 = fuiwirt.host_pointer_move(w, node_cx(a, big), row_y(a, big, 3))
    let i3: u32 = fuiwirt.host_pointer_down(w, node_cx(a, big), row_y(a, big, 3), fuiwirt.BTN_WHEEL_DOWN)
    var t: i64 = 9000
    var n: usize = 0
    while (app.vlist_moving(a) || n == 0) && n < 40 {
        t = t + 16
        tick(a, t)
        frame(a, s)
        n = n + 1
    }
    check(vlist.vl_scroll_y(bv) > w0, "the wheel scrolls the big list")
    check(!app.vlist_moving(a), "the wheel's run-out ends")

    say("-- the scroll bar\n")
    var bx0: f64 = 0.0
    var by0: f64 = 0.0
    var bw0: f64 = 0.0
    var bh0: f64 = 0.0
    vlist.vl_scroll_to(bv, 0, vlist.SCROLL_TOP)
    frame(a, s)
    let has_bar: bool = viewport.viewport_bar_rect_v(vlist.vl_viewport(bv), &bx0, &by0, &bw0, &bh0)
    check(has_bar && bw0 > 4.0, "the big list shows a vertical bar")
    let s0: f64 = vlist.vl_scroll_y(bv)
    let m4: u32 = fuiwirt.host_pointer_move(w, bx0 + bw0 / 2.0, by0 + 6.0)
    let d4: u32 = fuiwirt.host_pointer_down(w, bx0 + bw0 / 2.0, by0 + 6.0, fuiwirt.BTN_LEFT)
    let m5: u32 = fuiwirt.host_pointer_move(w, bx0 + bw0 / 2.0, by0 + 80.0)
    frame(a, s)
    check(vlist.vl_scroll_y(bv) > s0 + 10000.0, "dragging the thumb 74 px scrolls thousands of rows")
    let u4: u32 = fuiwirt.host_pointer_up(w, bx0 + bw0 / 2.0, by0 + 80.0, fuiwirt.BTN_LEFT)
    let s1: f64 = vlist.vl_scroll_y(bv)
    let m6: u32 = fuiwirt.host_pointer_move(w, bx0 + bw0 / 2.0, by0 + 150.0)
    frame(a, s)
    check(vlist.vl_scroll_y(bv) == s1, "after the release the thumb no longer follows")

    say("-- the table header\n")
    let hy: f64 = scene.node_y(sc, tbl) + vlist.vl_header_h(tv) / 2.0 + 2.0
    SORTS = 0
    click_at(a, s, node_left(a, tbl, 60.0), hy, 0 as u32)
    check(SORTS == 1 && SORT_COL == 0 && vlist.vl_sort_col(tv) == 0, "header click: sort column 0")
    let d0: bool = vlist.vl_sort_desc(tv)
    click_at(a, s, node_left(a, tbl, 60.0), hy, 0 as u32)
    check(SORTS == 2 && vlist.vl_sort_desc(tv) != d0, "the same header again: the direction flips")
    click_at(a, s, node_left(a, tbl, 230.0), hy, 0 as u32)
    check(SORTS == 3 && SORT_COL == 1 && !vlist.vl_sort_desc(tv), "another header: its column, ascending")
    let cw0: f64 = vlist.vl_col_width(tv, 0)
    let dx: f64 = node_left(a, tbl, 0.0) + vlist.vl_col_x(tv, 0) + cw0
    let m7: u32 = fuiwirt.host_pointer_move(w, dx, hy)
    let d7: u32 = fuiwirt.host_pointer_down(w, dx, hy, fuiwirt.BTN_LEFT)
    let m8: u32 = fuiwirt.host_pointer_move(w, dx + 40.0, hy)
    let u7: u32 = fuiwirt.host_pointer_up(w, dx + 40.0, hy, fuiwirt.BTN_LEFT)
    settle(a)
    frame(a, s)
    check(vlist.vl_col_width(tv, 0) > cw0 + 30.0 && SORTS == 3, "dragging a divider widens the column (no sort)")
    save(s, dir, "vlistapp_table.png")

    say("-- a finger\n")
    vlist.vl_scroll_to(bv, 1000, vlist.SCROLL_TOP)
    frame(a, s)
    let f0: f64 = vlist.vl_scroll_y(bv)
    let fx: f64 = bx + 100.0
    var fy: f64 = scene.node_y(sc, big) + 180.0
    PICKS = 0
    t = 20000
    tick(a, t)
    let td: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_DOWN, 1 as u32, event.PT_TOUCH, true, fx, fy, t)
    var step: usize = 0
    while step < 6 {
        t = t + 10
        tick(a, t)
        fy = fy - 20.0
        let tm: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_MOVE, 1 as u32, event.PT_TOUCH, true, fx, fy, t)
        frame(a, s)
        step = step + 1
    }
    check(vlist.vl_scroll_y(bv) > f0 + 100.0 && PICKS == 0, "a finger drag scrolls and selects nothing")
    let f1: f64 = vlist.vl_scroll_y(bv)
    let tu: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 1 as u32, event.PT_TOUCH, true, fx, fy, t)
    check(app.vlist_moving(a), "lifting a fast finger starts a fling")
    n = 0
    while app.vlist_moving(a) && n < 200 {
        t = t + 16
        tick(a, t)
        frame(a, s)
        n = n + 1
    }
    check(!app.vlist_moving(a) && vlist.vl_scroll_y(bv) > f1 + 200.0, "the fling runs on and ends")
    t = t + 1000
    tick(a, t)
    PICKS = 0
    let r5: f64 = row_y(a, big, vlist.vl_first(bv) + 3)
    let tdd: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_DOWN, 1 as u32, event.PT_TOUCH, true, fx, r5, t)
    t = t + 60
    tick(a, t)
    let tuu: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 1 as u32, event.PT_TOUCH, true, fx, r5, t)
    frame(a, s)
    check(PICKS == 1 && PICK_ROW == vlist.vl_first(bv) + 3, "a tap picks the row")

    say("-- the dark theme\n")
    app.set_dark(a, true)
    frame(a, s)
    check(luma(pix(s, 1.0, 1.0)) < luma(edge), "dark theme: the window ground is darker")
    save(s, dir, "vlistapp_dark.png")
    app.set_dark(a, false)
    frame(a, s)

    say("-- speed\n")
    run_speed(a, s, big, 600000)

    check(app.audit(a) == 0, "accessibility audit again: no unnamed element")
    if BAD == 0 {
        say("VLISTAPP PASSED\n")
        return 0
    }
    say("VLISTAPP FAILED (")
    say_num(BAD as i64)
    say(")\n")
    return 1
}
