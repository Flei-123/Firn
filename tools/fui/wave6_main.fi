// tools/fui/wave6_main.fi -- THE CHECK OF lib/fui/wave6.fi (bottom sheet, property grid) and their a11y twins.
import std.rt
import fui.safeout
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.style
import fui.editor
import fui.kit
import fui.kitcolor
import fui.lucide
import fui.wave5
import fui.wave6
import fui.scene
import fui.a11y
import fui.kita11y
import plat.sysfont

static mut BAD: usize = 0
static mut CHECKS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}


fn near(a: f64, b: f64, t: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= t
}

struct Surf {
    cv: canvas.Canvas,
    z: painter.Painter,
    c: render.Ctx,
}

static mut FONT: u64 = 0

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

// One picture: a property grid on the page, a half-open modal bottom sheet over it with a second grid as body.
fn run_picture(dir: u64, font: u64, dark: bool, name: str) {
    let sf: *mut Surf = rt.heap_alloc(65536) as *mut Surf
    (*sf).cv = canvas.canvas_new()
    (*sf).z = painter.painter_new()
    if !canvas.canvas_init(&(*sf).cv, 480, 420) || !painter.painter_init(&(*sf).z, &(*sf).cv, 480, 420) {
        return
    }
    painter.painter_set_font(&(*sf).z, font)
    let m: *mut theme.Theme = rt.heap_alloc(1 << 20) as *mut theme.Theme
    *m = theme.theme_new(dark)
    kitcolor.kit_theme(m, dark)
    (*sf).c = render.ctx_new(m, &(*sf).z)
    let c: *mut render.Ctx = &(*sf).c
    canvas.canvas_clear(&(*sf).cv, theme.opaque(render.color_of(c, style.color_token(style.TOK_BASE))))
    var rows: [wave6.PgRow; 7] = [wave6.pg_group("General", true), wave6.pg_text("Name", "Box", false), wave6.pg_bool("Visible", true),
        wave6.pg_group("Layout", true), wave6.pg_num("Width", 120, "px"), wave6.pg_choice("Align", "Center"), wave6.pg_color("Fill", 0xFF3366CC as u32)]
    var gr: wave6.PGrid = wave6.pgrid_new()
    gr.sel = 1
    wave6.pg_draw(c, &gr, &rows[0], 7, true, 16.0, 16.0, 448.0, 230.0)
    var s: wave6.Sheet = wave6.sheet_new(true)
    wave6.sheet_open(&s, 0)
    var g: usize = 0
    while g < 60 {
        let mv: bool = wave6.sheet_tick(&s, 16, 200)
        g = g + 1
    }
    wave6.sheet_draw(c, &s, 0.0, 0.0, 480.0, 420.0, 0 as u32)
    var b: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    if wave6.sheet_body_begin(c, &s, 0.0, 0.0, 480.0, 420.0, &b) {
        var drows: [wave6.PgRow; 3] = [wave6.pg_group("Details", true), wave6.pg_text("Id", "box-17", true), wave6.pg_num("Opacity", 80, "%")]
        var dg: wave6.PGrid = wave6.pgrid_new()
        wave6.pg_draw(c, &dg, &drows[0], 3, false, b[0] + 8.0, b[1] + 4.0, b[2] - 16.0, b[3] - 8.0)
        wave6.sheet_body_end(c)
    }
    save(&(*sf).cv, dir, name)
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("wave6: no font\n")
        return 9
    }
    FONT = fs as u64
    var pdir: u64 = 0
    if rt.arg_count(start) >= 2 {
        pdir = rt.arg_ptr(start, 1)
    }
    let sf: *mut Surf = rt.heap_alloc(65536) as *mut Surf
    (*sf).cv = canvas.canvas_new()
    (*sf).z = painter.painter_new()
    if !canvas.canvas_init(&(*sf).cv, 640, 480) || !painter.painter_init(&(*sf).z, &(*sf).cv, 640, 480) {
        return 8
    }
    painter.painter_set_font(&(*sf).z, FONT)
    let m: *mut theme.Theme = rt.heap_alloc(1 << 20) as *mut theme.Theme
    *m = theme.theme_new(false)
    kitcolor.kit_theme(m, false)
    (*sf).c = render.ctx_new(m, &(*sf).z)
    let c: *mut render.Ctx = &(*sf).c
    // ---- bottom sheet
    var s: wave6.Sheet = wave6.sheet_new(true)
    check(!wave6.sheet_is_open(&s), "sheet starts closed")
    wave6.sheet_open(&s, 0)
    check(wave6.sheet_is_open(&s), "open")
    var t: i64 = 0
    var g: usize = 0
    while g < 60 {
        let mv: bool = wave6.sheet_tick(&s, 16, 200)
        g = g + 1
    }
    check(near(wave6.sheet_pos(&s), 0.5, 0.002), "glides to the first snap point 0.5")
    check(!wave6.sheet_animating(&s), "rests")
    var r: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    check(wave6.sheet_panel_rect(c, &s, 0.0, 0.0, 640.0, 480.0, &r), "panel rect")
    check(near(r[1], 240.0, 1.0) && near(r[2], 640.0, 1.0), "half height, full width")
    check(wave6.sheet_hit(c, &s, 0.0, 0.0, 640.0, 480.0, 300.0, 100.0) == wave6.SH_NONE, "above the panel is the scrim")
    check(wave6.sheet_hit(c, &s, 0.0, 0.0, 640.0, 480.0, 300.0, 250.0) == wave6.SH_HANDLE, "top of the panel is the handle")
    check(wave6.sheet_hit(c, &s, 0.0, 0.0, 640.0, 480.0, 300.0, 400.0) == wave6.SH_BODY, "below is the body")
    var b: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    check(wave6.sheet_body_rect(c, &s, 0.0, 0.0, 640.0, 480.0, &b) && b[1] > r[1], "body rect under the handle")
    wave6.sheet_draw(c, &s, 0.0, 0.0, 640.0, 480.0, 0 as u32)
    check(wave6.sheet_key(&s, editor.KEY_UP) == wave6.SH_KEY_USED && !false, "Up goes to the next snap point")
    let mv2: bool = wave6.sheet_tick(&s, 16000, 200)
    check(near(wave6.sheet_pos(&s), 0.9, 0.01), "after Up the sheet is at 0.9")
    // drag down fast: closes
    wave6.sheet_drag_begin(&s, 100.0, 0)
    wave6.sheet_drag_move(&s, 300.0, 480.0, 50)
    wave6.sheet_drag_move(&s, 460.0, 480.0, 100)
    check(wave6.sheet_pos(&s) < 0.3, "the drag follows the finger")
    check(wave6.sheet_drag_end(&s), "a long fling down closes")
    check(!wave6.sheet_dragging(&s), "drag over")
    wave6.sheet_open(&s, 1)
    check(wave6.sheet_key(&s, editor.KEY_ESC) == wave6.SH_KEY_CLOSED, "Esc closes")
    var wide: wave6.Sheet = wave6.sheet_new(false)
    wave6.sheet_open(&wide, 1)
    let mv3: bool = wave6.sheet_tick(&wide, 16000, 200)
    var rw: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    check(wave6.sheet_panel_rect(c, &wide, 0.0, 0.0, 1200.0, 600.0, &rw) && near(rw[2], 640.0, 1.0) && near(rw[0], 280.0, 1.0), "panel is 640 wide and centered")
    let sn: bool = wave6.sheet_tick(&wide, 5, 0)
    // ---- property grid
    var rows: [wave6.PgRow; 6] = [wave6.pg_group("General", true), wave6.pg_text("Name", "Box", false), wave6.pg_bool("Visible", true),
        wave6.pg_group("Layout", true), wave6.pg_num("Width", 120, "px"), wave6.pg_color("Fill", 0xFF3366CC as u32)]
    var gr: wave6.PGrid = wave6.pgrid_new()
    let rp: *mut wave6.PgRow = &rows[0]
    check(wave6.pg_visible_count(rp, 6) == 6, "six rows visible")
    wave6.pg_draw(c, &gr, rp, 6, true, 10.0, 10.0, 400.0, 300.0)
    var part: u32 = 0 as u32
    let rh: f64 = wave6.pg_row_h(c)
    let hr: usize = wave6.pg_hit(c, &gr, rp, 6, 10.0, 10.0, 400.0, 300.0, 300.0, 10.0 + rh * 1.5, &part)
    check(hr == 1 && part == wave6.PGP_VALUE, "hit: value of row 1")
    let hl: usize = wave6.pg_hit(c, &gr, rp, 6, 10.0, 10.0, 400.0, 300.0, 40.0, 10.0 + rh * 2.5, &part)
    check(hl == 2 && part == wave6.PGP_LABEL, "hit: label of row 2")
    let ha: usize = wave6.pg_hit(c, &gr, rp, 6, 10.0, 10.0, 400.0, 300.0, 20.0, 15.0, &part)
    check(ha == 0 && part == wave6.PGP_ARROW, "hit: chevron of the group")
    let hd: usize = wave6.pg_hit(c, &gr, rp, 6, 10.0, 10.0, 400.0, 300.0, 10.0 + 400.0 * 0.42, 60.0, &part)
    check(hd == kit.NONE && part == wave6.PGP_DIV, "hit: the divider")
    check(wave6.pg_press(&gr, rp, 6, 2, wave6.PGP_VALUE) == wave6.PGK_TOGGLED && !rows[2].on, "press on the switch flips it")
    check(wave6.pg_press(&gr, rp, 6, 1, wave6.PGP_VALUE) == wave6.PGK_EDIT, "press on a text value asks for an editor")
    check(wave6.pg_press(&gr, rp, 6, 0, wave6.PGP_ARROW) == wave6.PGK_FOLDED && !rows[0].on, "press on a group folds it")
    check(wave6.pg_visible_count(rp, 6) == 4, "folded group hides its two rows")
    check(wave6.pg_key(&gr, rp, 6, editor.KEY_DOWN) == wave6.PGK_MOVED, "Down moves")
    check(gr.sel == 3, "selection skips the hidden rows")
    check(wave6.pg_key(&gr, rp, 6, editor.KEY_RIGHT) == wave6.PGK_NONE, "Right on an open group does nothing")
    check(wave6.pg_key(&gr, rp, 6, editor.KEY_LEFT) == wave6.PGK_FOLDED && !rows[3].on, "Left closes the group")
    wave6.pg_div_begin(&gr, 100.0)
    wave6.pg_div_move(&gr, 160.0, 400.0)
    wave6.pg_div_end(&gr)
    check(gr.label_pm == 570, "divider drag: +60 px of 400 = +150 permille")
    wave6.pg_div_begin(&gr, 100.0)
    wave6.pg_div_move(&gr, 5000.0, 400.0)
    wave6.pg_div_end(&gr)
    check(gr.label_pm == 850, "divider is clamped to 85 percent")
    kit.kit_set_rtl(true)
    wave6.pg_draw(c, &gr, rp, 6, true, 10.0, 10.0, 400.0, 300.0)
    wave6.sheet_draw(c, &s, 0.0, 0.0, 640.0, 480.0, 0 as u32)
    kit.kit_set_rtl(false)
    // ---- a11y
    var sc: scene.Scene = scene.scene_new()
    var ax: a11y.A11y = a11y.a11y_new()
    var kx: kita11y.KitAx = kita11y.kax_new(&sc, &ax)
    let root: usize = kita11y.kax_root(&kx, "Inspector")
    wave6.sheet_open(&s, 0)
    let mv4: bool = wave6.sheet_tick(&s, 16000, 200)
    let sh: usize = kita11y.kax_sheet(&kx, root, "Details", &s, 0 as u32)
    let pgn: usize = kita11y.kax_propgrid(&kx, root, "Properties", &gr, rp, 6, true)
    check(sh != scene.SCENE_NONE && pgn != scene.SCENE_NONE, "sheet and grid are in the a11y tree")
    check(a11y.a11y_unnamed(&sc, &ax) == 0, "no unnamed element")
    wave6.sheet_close(&s)
    let mv5: bool = wave6.sheet_tick(&s, 16000, 200)
    check(kita11y.kax_sheet(&kx, root, "Details", &s, 0 as u32) == scene.SCENE_NONE, "a closed sheet is not described")
    if pdir != 0 {
        run_picture(pdir, FONT, true, "wave6-dark.png")
        run_picture(pdir, FONT, false, "wave6-light.png")
    }
    if BAD == 0 {
        say("WAVE6 PASSED\n")
        return 0
    }
    say("WAVE6 FAILED\n")
    return 1
}
