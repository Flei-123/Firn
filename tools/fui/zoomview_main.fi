// SPDX-License-Identifier: MPL-2.0
// tools/fui/zoomview_main.fi -- test for lib/fui/zoomview.fi (the math of pinch zoom, pan and double tap)
//
//     zoomview_main      prints ZOOMVIEW PASSED / FAILED
import std.rt
import fui.zoomview

static mut FAILS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if !ok {
        FAILS = FAILS + 1
        say("FAIL: ")
        say(what)
        say("\n")
    }
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.01
}

fn main(start: u64) -> i32 {
    var dx: f64 = 0.0
    var dy: f64 = 0.0
    var dw: f64 = 0.0
    var dh: f64 = 0.0

    // a 400x200 picture in a 100x300 viewport at (10, 20): fitted by width -> 100x50, centred
    var z: zoomview.ZoomView = zoomview.zv_new()
    zoomview.zv_open(&z, 400, 200)
    zoomview.zv_layout(&z, 10.0, 20.0, 100.0, 300.0)
    zoomview.zv_dest(&z, &dx, &dy, &dw, &dh)
    check(near(dw, 100.0) && near(dh, 50.0), "fit size")
    check(near(dx, 10.0) && near(dy, 145.0), "fit position centred")
    check(zoomview.zv_contains(&z, 60.0, 170.0), "inside the picture")
    check(!zoomview.zv_contains(&z, 60.0, 100.0), "black ground above the picture")

    // no pan while not zoomed
    zoomview.zv_pan(&z, 30.0, 30.0)
    zoomview.zv_dest(&z, &dx, &dy, &dw, &dh)
    check(near(dx, 10.0) && near(dy, 145.0), "no pan at zoom 1")

    // double tap zooms in about the tap point: the point under the finger stays put
    // the picture point under (35, 160): u = (35 - 10) / 100 = 0.25 of the width, v = (160 - 145) / 50 = 0.3 of the height
    zoomview.zv_double_tap(&z, 35.0, 160.0)
    check(near(zoomview.zv_zoom(&z), 2.5), "double tap zoom 2.5")
    zoomview.zv_dest(&z, &dx, &dy, &dw, &dh)
    check(near(dw, 250.0) && near(dh, 125.0), "zoomed size")
    check(near(dx + 0.25 * dw, 35.0), "focus x stays under the finger")
    check(near(dy + dh * 0.5, 170.0), "height 125 < 300: centred on y (clamped, no empty edge)")
    // a second double tap: back to the fit
    zoomview.zv_double_tap(&z, 50.0, 100.0)
    check(near(zoomview.zv_zoom(&z), 1.0), "double tap back to 1")
    zoomview.zv_dest(&z, &dx, &dy, &dw, &dh)
    check(near(dx, 10.0) && near(dy, 145.0), "centred again")

    // pan is clamped: no empty edge on an axis where the picture is bigger than the viewport
    zoomview.zv_double_tap(&z, 60.0, 170.0)
    zoomview.zv_pan(&z, 1000.0, 1000.0)
    zoomview.zv_dest(&z, &dx, &dy, &dw, &dh)
    check(near(dx, 10.0), "left edge sticks to the viewport")
    check(near(dy + dh * 0.5, 170.0), "height 125 < 300: still centred on y")
    zoomview.zv_pan(&z, -5000.0, -5000.0)
    zoomview.zv_dest(&z, &dx, &dy, &dw, &dh)
    check(near(dx + dw, 110.0), "right edge sticks to the viewport")

    // the visible crop of the wide picture: x from 150 to 400 hidden/shown
    var sx: usize = 0
    var sy: usize = 0
    var sw: usize = 0
    var sh: usize = 0
    var tx: f64 = 0.0
    var ty: f64 = 0.0
    var tw: f64 = 0.0
    var th: f64 = 0.0
    check(zoomview.zv_visible(&z, &sx, &sy, &sw, &sh, &tx, &ty, &tw, &th), "something visible")
    check(sy == 0 && sh == 200, "full height visible")
    check(sx >= 238 && sx <= 242 && sx + sw == 400, "crop starts after the hidden left part (picture px)")
    check(tx >= 9.99 && tw <= 100.1, "target inside the viewport")

    // pinch: out to 4x about a mid point, then in below 1 -> reset
    zoomview.zv_reset(&z)
    zoomview.zv_pinch_start(&z, 60.0, 170.0)
    zoomview.zv_pinch_move(&z, 2.0, 60.0, 170.0)
    check(near(zoomview.zv_zoom(&z), 2.0), "pinch x2")
    zoomview.zv_pinch_move(&z, 20.0, 60.0, 170.0)
    check(near(zoomview.zv_zoom(&z), 8.0), "pinch capped at ZV_MAX")
    zoomview.zv_pinch_move(&z, 0.2, 60.0, 170.0)
    check(near(zoomview.zv_zoom(&z), 1.0), "pinch in below 1 stops at 1")
    zoomview.zv_pinch_end(&z)
    zoomview.zv_dest(&z, &dx, &dy, &dw, &dh)
    check(near(dx, 10.0) && near(dy, 145.0), "reset centred after the pinch");

    // pinch about a point keeps the picture point under the fingers
    zoomview.zv_pinch_start(&z, 35.0, 160.0)
    zoomview.zv_pinch_move(&z, 2.0, 35.0, 160.0)
    zoomview.zv_dest(&z, &dx, &dy, &dw, &dh)
    check(near(dx + 0.25 * dw, 35.0), "pinch focus x")
    check(near(dy + dh * 0.5, 170.0), "pinch y stays centred")
    // the two fingers drag together: the mid point moved by +10 -> the picture moved by +10 (when not clamped)
    zoomview.zv_pinch_move(&z, 2.0, 25.0, 160.0)
    zoomview.zv_pinch_end(&z)
    check(zoomview.zv_zoomed(&z), "still zoomed after the pinch")

    // a portrait picture in a wide viewport (fit by height) and a degenerate picture
    zoomview.zv_open(&z, 100, 400)
    zoomview.zv_layout(&z, 0.0, 0.0, 300.0, 200.0)
    zoomview.zv_dest(&z, &dx, &dy, &dw, &dh)
    check(near(dh, 200.0) && near(dw, 50.0) && near(dx, 125.0), "portrait fit")
    zoomview.zv_open(&z, 0, 0)
    zoomview.zv_layout(&z, 0.0, 0.0, 300.0, 200.0)
    zoomview.zv_double_tap(&z, 10.0, 10.0)
    zoomview.zv_dest(&z, &dx, &dy, &dw, &dh)
    check(dw > 0.0 && dh > 0.0, "degenerate size survives")

    if FAILS > 0 {
        say("ZOOMVIEW FAILED\n")
        return 1
    }
    say("ZOOMVIEW PASSED\n")
    return 0
}
