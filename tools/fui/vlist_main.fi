// SPDX-License-Identifier: MPL-2.0
// tools/fui/vlist_main.fi -- THE CHECK OF THE MODEL lib/fui/vlist.fi.
//
// No window and no painter: heights (equal and variable, against a naive
// reference), 100000 rows, selection against a plain bool array, keys,
// typeahead, columns, and a fuzz of random keys / clicks / characters.
//
//     firnc -o /tmp/vlist tools/fui/vlist_main.fi && /tmp/vlist
//
// The last line is VLIST PASSED or VLIST FAILED.
import std.rt
import std.time
import fui.vlist
import fui.editor
import fui.viewport

static mut BAD: usize = 0
static mut SEED: u64 = 88172645463325252

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_num(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn rnd() -> u64 {
    var x: u64 = SEED
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    SEED = x
    return x
}

fn rnd_to(n: usize) -> usize {
    return (rnd() % (n as u64)) as usize
}

// heights for the variable test: 10..49 px, some 0 height rows
fn height_of(ud: u64, i: usize) -> f64 {
    let k: usize = (i * 2654435761) % 41
    if k == 40 {
        return 0.0
    }
    return 10.0 + (k as f64)
}

// the source: row i has the text "item " + decimal(i) in column 0
fn put_dec(r: *mut vlist.VRow, v: usize) {
    var tmp: [u8; 20] = [0; 20]
    var k: usize = 0
    var x: usize = v
    if x == 0 {
        tmp[0] = 48 as u8
        k = 1
    }
    while x > 0 {
        tmp[k] = (48 + (x % 10)) as u8
        x = x / 10
        k = k + 1
    }
    var n: usize = (*r).n
    var j: usize = k
    while j > 0 {
        j = j - 1
        (*r).text[n] = tmp[j]
        n = n + 1
    }
    (*r).n = n
}

fn row_of(ud: u64, i: usize, out: *mut vlist.VRow) {
    vlist.vrow_text(out, "item ")
    put_dec(out, i)
}

// a source with names, for typeahead: "Alpha", "alpine", "Beta", "gamma", ... repeated
fn name_row(ud: u64, i: usize, out: *mut vlist.VRow) {
    let k: usize = i % 6
    if k == 0 { vlist.vrow_text(out, "Alpha") }
    else if k == 1 { vlist.vrow_text(out, "alpine") }
    else if k == 2 { vlist.vrow_text(out, "Beta") }
    else if k == 3 { vlist.vrow_text(out, "gamma") }
    else if k == 4 { vlist.vrow_text(out, "Gammon") }
    else { vlist.vrow_text(out, "delta") }
}

fn mk(n: usize, h: f64, w: f64, ht: f64) -> vlist.Vlist {
    var v: vlist.Vlist = vlist.vl_new()
    vlist.vl_set_row_height(&v, h)
    vlist.vl_set_count(&v, n)
    vlist.vl_set_rect(&v, 10.0, 20.0, w, ht)
    return v
}

fn test_equal_heights() {
    var v: vlist.Vlist = mk(100000, 24.0, 300.0, 240.0)
    check(vlist.vl_total(&v) == 2400000.0, "100000 rows of 24 px: total 2400000")
    check(vlist.vl_row_top(&v, 5000) == 120000.0, "top of row 5000")
    check(vlist.vl_index_at(&v, 120000.0) == 5000, "index_at on a row's top")
    check(vlist.vl_index_at(&v, 119999.5) == 4999, "index_at just above it")
    check(vlist.vl_index_at(&v, 2400000.0) == vlist.NONE, "index_at below the last row: NONE")
    check(vlist.vl_index_at(&v, 0.0 - 1.0) == vlist.NONE, "index_at above the first row: NONE")
    check(vlist.vl_first(&v) == 0 && vlist.vl_end(&v) == 10, "first 0, end 10 at offset 0 (240 px / 24)")
    vlist.vl_scroll_to(&v, 50000, vlist.SCROLL_TOP)
    check(vlist.vl_first(&v) == 50000, "scroll_to top puts row 50000 first")
    check(vlist.vl_end(&v) - vlist.vl_first(&v) <= 11, "at most 11 rows are asked for at 240 px")
    vlist.vl_scroll_to(&v, 50000, vlist.SCROLL_MIDDLE)
    let f: usize = vlist.vl_first(&v)
    check(f >= 49994 && f <= 49996, "scroll_to middle")
    vlist.vl_scroll_to(&v, 99999, vlist.SCROLL_BOTTOM)
    check(vlist.vl_end(&v) == 100000, "scroll_to bottom: the end is the last row")
    check(vlist.vl_hit(&v, 15.0, 20.0 + 5.0) == vlist.vl_first(&v), "hit at the top of the body = first row")
    check(vlist.vl_hit(&v, 5.0, 25.0) == vlist.NONE, "hit left of the control: NONE")
    vlist.vl_free(&v)
}

fn test_variable_heights() {
    let n: usize = 20000
    var v: vlist.Vlist = mk(n, 24.0, 300.0, 400.0)
    vlist.vl_set_heights(&v, 0, height_of)
    check(vlist.vl_is_variable(&v), "variable heights switched on")
    // reference: plain prefix array
    let ref: u64 = rt.heap_alloc((n + 1) * 8)
    var acc: f64 = 0.0
    var i: usize = 0
    while i <= n {
        rt.st64(ref, i, acc as u64)
        if i < n {
            acc = acc + height_of(0, i)
        }
        i = i + 1
    }
    var bad_top: usize = 0
    i = 0
    while i <= n {
        let t: f64 = vlist.vl_row_top(&v, i)
        let d: f64 = t - (rt.ld64(ref, i) as f64)
        if d > 1.0 || d < 0.0 - 1.0 {
            bad_top = bad_top + 1
        }
        i = i + 1
    }
    check(bad_top == 0, "row_top equals the naive prefix sum on 20001 positions")
    // index_at: the row found must contain y (top <= y < top + h) and rows with 0 height are skipped
    var bad_at: usize = 0
    var q: usize = 0
    while q < 20000 {
        let y: f64 = (rnd_to(1000000) as f64) * (acc / 1000000.0)
        let k: usize = vlist.vl_index_at(&v, y)
        if y >= acc {
            if k != vlist.NONE {
                bad_at = bad_at + 1
            }
        } else if k == vlist.NONE {
            bad_at = bad_at + 1
        } else {
            let t0: f64 = vlist.vl_row_top(&v, k)
            let t1: f64 = vlist.vl_row_top(&v, k + 1)
            if y < t0 - 0.02 || y >= t1 + 0.02 || t1 <= t0 {
                bad_at = bad_at + 1
            }
        }
        q = q + 1
    }
    check(bad_at == 0, "index_at finds a row that contains y (20000 random y)")
    // change one height: everything below moves by the difference
    let before: f64 = vlist.vl_row_top(&v, 15000)
    let h7: f64 = vlist.vl_height_of(&v, 7)
    vlist.vl_set_height(&v, 7, h7 + 100.0)
    let after: f64 = vlist.vl_row_top(&v, 15000)
    check(after - before > 99.9 && after - before < 100.1, "set_height moves all rows below by the difference")
    check(vlist.vl_row_top(&v, 7) - (rt.ld64(ref, 7) as f64) < 1.0, "rows above stay")
    check(vlist.vl_total(&v) > acc + 99.0, "total grew")
    // keys in variable mode keep the focus row inside the body
    vlist.vl_select_only(&v, 100)
    var ok: bool = true
    var s: usize = 0
    while s < 300 {
        let r: u32 = vlist.vl_key(&v, editor.KEY_PGDN, 0 as u32)
        let c: usize = vlist.vl_cur(&v)
        let top: f64 = vlist.vl_row_top(&v, c)
        let oy: f64 = vlist.vl_scroll_y(&v)
        if top < oy - 0.5 || top > oy + 400.0 {
            ok = false
        }
        s = s + 1
    }
    check(ok, "300 x PgDn in variable mode: the focused row is always in the body")
    rt.heap_free(ref, (n + 1) * 8)
    vlist.vl_free(&v)
}

fn test_keys() {
    var v: vlist.Vlist = mk(1000, 20.0, 200.0, 200.0)
    let r0: u32 = vlist.vl_key(&v, editor.KEY_DOWN, 0 as u32)
    check(vlist.vl_cur(&v) == 0, "Down with no focus lands on the first visible row")
    let r1: u32 = vlist.vl_key(&v, editor.KEY_DOWN, 0 as u32)
    check(vlist.vl_cur(&v) == 1 && vlist.vl_is_selected(&v, 1) && vlist.vl_sel_count(&v) == 1, "Down moves and chooses")
    check((r1 & vlist.RES_SELECT) != 0 as u32 && (r1 & vlist.RES_USED) != 0 as u32, "answer says selection changed")
    let r2: u32 = vlist.vl_key(&v, editor.KEY_UP, 0 as u32)
    check(vlist.vl_cur(&v) == 0, "Up moves back")
    let r3: u32 = vlist.vl_key(&v, editor.KEY_UP, 0 as u32)
    check(vlist.vl_cur(&v) == 0 && (r3 & vlist.RES_MOVED) == 0 as u32, "Up at the top stays")
    let r4: u32 = vlist.vl_key(&v, editor.KEY_END, 0 as u32)
    check(vlist.vl_cur(&v) == 999 && vlist.vl_end(&v) == 1000, "End: last row, scrolled into view")
    let r5: u32 = vlist.vl_key(&v, editor.KEY_HOME, 0 as u32)
    check(vlist.vl_cur(&v) == 0 && vlist.vl_first(&v) == 0, "Home: first row, scrolled to the top")
    let r6: u32 = vlist.vl_key(&v, editor.KEY_PGDN, 0 as u32)
    check(vlist.vl_cur(&v) == 10, "PgDn moves one page (200 px / 20 = 10 rows)")
    let r7: u32 = vlist.vl_key(&v, editor.KEY_PGUP, 0 as u32)
    check(vlist.vl_cur(&v) == 0, "PgUp moves one page back")
    let r8: u32 = vlist.vl_key(&v, editor.KEY_ENTER, 0 as u32)
    check((r8 & vlist.RES_ACTIVATE) != 0 as u32, "Enter on a focused row activates")
    check(vlist.vl_key(&v, 99 as u32, 0 as u32) == 0 as u32, "an unknown key is not ours (0)")
    // scroll follows: walk down 50 rows, the focus row stays visible
    var s: usize = 0
    var vis: bool = true
    while s < 50 {
        let rr: u32 = vlist.vl_key(&v, editor.KEY_DOWN, 0 as u32)
        let c: usize = vlist.vl_cur(&v)
        if c < vlist.vl_first(&v) || c >= vlist.vl_end(&v) {
            vis = false
        }
        s = s + 1
    }
    check(vis, "50 x Down: scroll-to-selection keeps the row visible")
    // Enter with nothing chosen
    var e: vlist.Vlist = mk(5, 20.0, 100.0, 100.0)
    check(vlist.vl_key(&e, editor.KEY_ENTER, 0 as u32) == 0 as u32, "Enter without a focus row: nothing")
    // empty list
    var z: vlist.Vlist = mk(0, 20.0, 100.0, 100.0)
    check((vlist.vl_key(&z, editor.KEY_DOWN, 0 as u32) & vlist.RES_USED) != 0 as u32 && vlist.vl_cur(&z) == vlist.NONE, "empty list: key is eaten, no focus")
    vlist.vl_free(&v)
    vlist.vl_free(&e)
    vlist.vl_free(&z)
}

fn test_multi() {
    var v: vlist.Vlist = mk(100, 20.0, 200.0, 200.0)
    vlist.vl_set_multi(&v, true)
    let c1: u32 = vlist.vl_click(&v, 10, 0 as u32)
    let c2: u32 = vlist.vl_click(&v, 14, editor.MOD_SHIFT)
    check(vlist.vl_sel_count(&v) == 5 && vlist.vl_is_selected(&v, 10) && vlist.vl_is_selected(&v, 14), "Shift+click selects the range 10..14")
    let c3: u32 = vlist.vl_click(&v, 20, editor.MOD_CTRL)
    check(vlist.vl_sel_count(&v) == 6 && vlist.vl_is_selected(&v, 20), "Ctrl+click adds a row")
    let c4: u32 = vlist.vl_click(&v, 12, editor.MOD_CTRL)
    check(vlist.vl_sel_count(&v) == 5 && !vlist.vl_is_selected(&v, 12), "Ctrl+click on a chosen row removes it")
    let c5: u32 = vlist.vl_click(&v, 30, 0 as u32)
    check(vlist.vl_sel_count(&v) == 1 && vlist.vl_is_selected(&v, 30), "a plain click chooses only that row")
    let k1: u32 = vlist.vl_key(&v, editor.KEY_DOWN, editor.MOD_SHIFT)
    let k2: u32 = vlist.vl_key(&v, editor.KEY_DOWN, editor.MOD_SHIFT)
    check(vlist.vl_sel_count(&v) == 3 && vlist.vl_anchor(&v) == 30 && vlist.vl_cur(&v) == 32, "Shift+Down extends from the anchor")
    let k3: u32 = vlist.vl_key(&v, editor.KEY_UP, editor.MOD_SHIFT)
    check(vlist.vl_sel_count(&v) == 2, "Shift+Up shrinks again")
    let k4: u32 = vlist.vl_key(&v, editor.KEY_DOWN, editor.MOD_CTRL)
    check(vlist.vl_sel_count(&v) == 2 && vlist.vl_cur(&v) == 32, "Ctrl+Down moves only the focus")
    let k5: u32 = vlist.vl_char(&v, 32 as u32, editor.MOD_CTRL, 0 as i64, 0, row_of)
    check(vlist.vl_is_selected(&v, 32) && vlist.vl_sel_count(&v) == 3, "Ctrl+Space toggles the focused row")
    let k6: u32 = vlist.vl_char(&v, 97 as u32, editor.MOD_CTRL, 0 as i64, 0, row_of)
    check(vlist.vl_sel_count(&v) == 100, "Ctrl+A selects all")
    let c6: u32 = vlist.vl_click(&v, vlist.NONE, 0 as u32)
    check(vlist.vl_sel_count(&v) == 0, "a click on the empty part clears")
    vlist.vl_set_multi(&v, false)
    let c7: u32 = vlist.vl_click(&v, 3, editor.MOD_SHIFT)
    let c8: u32 = vlist.vl_click(&v, 6, editor.MOD_SHIFT)
    check(vlist.vl_sel_count(&v) == 1 && vlist.vl_is_selected(&v, 6), "single mode: Shift+click chooses one row")
    vlist.vl_free(&v)
}

// the reference for the fuzz: a plain bool array
fn test_fuzz_against_reference() {
    let n: usize = 300
    var v: vlist.Vlist = mk(n, 18.0, 200.0, 180.0)
    vlist.vl_set_multi(&v, true)
    var ref: [bool; 300] = [false; 300]
    var anchor: usize = vlist.NONE
    var cur: usize = vlist.NONE
    var bad: usize = 0
    var steps: usize = 0
    while steps < 20000 {
        let op: usize = rnd_to(6)
        var mods: u32 = 0 as u32
        let mr: usize = rnd_to(4)
        if mr == 1 { mods = editor.MOD_SHIFT }
        if mr == 2 { mods = editor.MOD_CTRL }
        if op <= 2 {
            // a click on a random row
            let i: usize = rnd_to(n)
            let r: u32 = vlist.vl_click(&v, i, mods)
            if mods == editor.MOD_SHIFT {
                var a0: usize = anchor
                if a0 == vlist.NONE { a0 = i }
                var lo: usize = a0
                var hi: usize = i
                if lo > hi { lo = i
                    hi = a0 }
                var k: usize = 0
                while k < n { ref[k] = k >= lo && k <= hi
                    k = k + 1 }
                anchor = a0
                cur = i
            } else if mods == editor.MOD_CTRL {
                ref[i] = !ref[i]
                anchor = i
                cur = i
            } else {
                var k2: usize = 0
                while k2 < n { ref[k2] = k2 == i
                    k2 = k2 + 1 }
                anchor = i
                cur = i
            }
        } else if op == 3 {
            let r2: u32 = vlist.vl_key(&v, editor.KEY_DOWN, 0 as u32)
            if cur == vlist.NONE { cur = vlist.vl_first(&v) }
            else if cur + 1 < n { cur = cur + 1 }
            var k3: usize = 0
            while k3 < n { ref[k3] = k3 == cur
                k3 = k3 + 1 }
            anchor = cur
            // vl_first may have moved before the first key: take the model's answer for the very first focus
            cur = vlist.vl_cur(&v)
            anchor = cur
            k3 = 0
            while k3 < n { ref[k3] = k3 == cur
                k3 = k3 + 1 }
        } else if op == 4 {
            let r3: u32 = vlist.vl_char(&v, 97 as u32, editor.MOD_CTRL, 0 as i64, 0, row_of)
            var k4: usize = 0
            while k4 < n { ref[k4] = true
                k4 = k4 + 1 }
            if cur == vlist.NONE { cur = 0 }
            if anchor == vlist.NONE { anchor = 0 }
        } else {
            let r4: u32 = vlist.vl_click(&v, vlist.NONE, 0 as u32)
            var k5: usize = 0
            while k5 < n { ref[k5] = false
                k5 = k5 + 1 }
        }
        // compare
        var cnt: usize = 0
        var j: usize = 0
        while j < n {
            if ref[j] { cnt = cnt + 1 }
            if ref[j] != vlist.vl_is_selected(&v, j) { bad = bad + 1 }
            j = j + 1
        }
        if cnt != vlist.vl_sel_count(&v) { bad = bad + 1 }
        steps = steps + 1
    }
    say("  selection fuzz: 20000 steps, mismatches ")
    say_num(bad as i64)
    say("\n")
    check(bad == 0, "selection model equals the plain bool-array reference (0 mismatches)")
    vlist.vl_free(&v)
}

fn test_typeahead() {
    var v: vlist.Vlist = mk(60, 20.0, 200.0, 100.0)
    // NAMES cycle: 0 Alpha 1 alpine 2 Beta 3 gamma 4 Gammon 5 delta
    var r: u32 = vlist.vl_char(&v, 98 as u32, 0 as u32, 1000 as i64, 0, name_row)
    check(vlist.vl_cur(&v) == 2, "typing b jumps to Beta (row 2)")
    r = vlist.vl_char(&v, 101 as u32, 0 as u32, 1300 as i64, 0, name_row)
    check(vlist.vl_cur(&v) == 2, "typing be stays on Beta")
    r = vlist.vl_char(&v, 103 as u32, 0 as u32, 5000 as i64, 0, name_row)
    check(vlist.vl_cur(&v) == 3, "after a pause g starts anew: gamma (row 3)")
    r = vlist.vl_char(&v, 71 as u32, 0 as u32, 5400 as i64, 0, name_row)
    check(vlist.vl_cur(&v) == 3, "gG matches gamma? no: g then G = gg -> no row, focus stays")
    r = vlist.vl_char(&v, 103 as u32, 0 as u32, 9000 as i64, 0, name_row)
    check(vlist.vl_cur(&v) == 4, "g again after a pause: the next g row (Gammon, row 4)")
    r = vlist.vl_char(&v, 90 as u32, 0 as u32, 12000 as i64, 0, name_row)
    check((r & vlist.RES_USED) != 0 as u32, "a letter without match is eaten")
    check(vlist.vl_is_selected(&v, 4) && vlist.vl_sel_count(&v) == 1, "typeahead chooses exactly the found row")
    r = vlist.vl_char(&v, 97 as u32, 0 as u32, 20000 as i64, 0, name_row)
    check(vlist.vl_cur(&v) == 6, "a: next Alpha after the focus (row 6)")
    r = vlist.vl_char(&v, 108 as u32, 0 as u32, 20100 as i64, 0, name_row)
    r = vlist.vl_char(&v, 112 as u32, 0 as u32, 20200 as i64, 0, name_row)
    r = vlist.vl_char(&v, 105 as u32, 0 as u32, 20300 as i64, 0, name_row)
    check(vlist.vl_cur(&v) == 7, "alpi: Alpine, any case (row 7)")
    check(vlist.vl_end(&v) > 7, "typeahead scrolls the row into view")
    var t: [u8; 48] = [0; 48]
    check(vlist.vl_typeahead_text(&v, &t) == 4, "typeahead buffer holds 4 octets")
    vlist.vl_free(&v)
}

fn test_columns() {
    var v: vlist.Vlist = mk(50, 20.0, 400.0, 200.0)
    vlist.vl_set_header(&v, 24.0)
    check(vlist.vl_header_h(&v) == 24.0 && vlist.vl_body_y(&v) == 44.0, "header 24 px: body starts below it")
    vlist.vl_set_columns(&v, 3)
    check(vlist.vl_columns(&v) == 3 && vlist.vl_col_width(&v, 0) > 100.0, "3 columns share the width")
    vlist.vl_set_col_width(&v, 0, 150.0)
    vlist.vl_set_col_width(&v, 1, 100.0)
    check(vlist.vl_col_x(&v, 2) == 250.0, "column 2 starts at 250")
    check(vlist.vl_col_at(&v, 10.0 + 120.0) == 0 && vlist.vl_col_at(&v, 10.0 + 260.0) == 2, "col_at")
    check(vlist.vl_divider_at(&v, 10.0 + 151.0, 4.0) == 0, "divider after column 0 found within 4 px")
    check(vlist.vl_divider_at(&v, 10.0 + 75.0, 4.0) == vlist.NONE, "no divider in the middle of a cell")
    vlist.vl_col_drag_begin(&v, 0, 160.0)
    let ch: bool = vlist.vl_col_drag(&v, 200.0)
    check(ch && vlist.vl_col_width(&v, 0) == 190.0, "dragging the divider 40 px right widens column 0")
    let ch2: bool = vlist.vl_col_drag(&v, 0.0 - 500.0)
    check(vlist.vl_col_width(&v, 0) == vlist.COL_MIN_W, "dragging far left stops at the minimum width")
    vlist.vl_col_drag_end(&v)
    check(!vlist.vl_col_dragging(&v), "drag ended")
    check(vlist.vl_zone(&v, 20.0, 25.0) == vlist.ZONE_HEADER, "zone: header")
    check(vlist.vl_zone(&v, 20.0, 60.0) == vlist.ZONE_BODY, "zone: body")
    check(vlist.vl_zone(&v, 5.0, 60.0) == vlist.ZONE_NONE, "zone: outside")
    check(vlist.vl_hit(&v, 20.0, 25.0) == vlist.NONE, "hit in the header: no row")
    check(vlist.vl_hit(&v, 20.0, 44.0 + 41.0) == 2, "hit 41 px into the body = row 2")
    check(vlist.vl_header_click(&v, 1) && vlist.vl_sort_col(&v) == 1 && !vlist.vl_sort_desc(&v), "header click: sort column 1 ascending")
    check(vlist.vl_header_click(&v, 1) && vlist.vl_sort_desc(&v), "second click on the same column: descending")
    check(vlist.vl_header_click(&v, 0) && vlist.vl_sort_col(&v) == 0 && !vlist.vl_sort_desc(&v), "another column: ascending again")
    check(!vlist.vl_header_click(&v, 9), "header click outside the columns: nothing")
    vlist.vl_free(&v)
}

// fuzz: random keys, characters, clicks, rects, counts must never crash and must keep the invariants
fn test_fuzz_robust() {
    var v: vlist.Vlist = mk(1000, 17.0, 250.0, 130.0)
    vlist.vl_set_multi(&v, true)
    var bad: usize = 0
    var steps: usize = 0
    while steps < 50000 {
        let op: usize = rnd_to(9)
        var mods: u32 = 0 as u32
        if rnd_to(3) == 0 { mods = editor.MOD_SHIFT }
        if rnd_to(5) == 0 { mods = mods | editor.MOD_CTRL }
        if op == 0 {
            let r: u32 = vlist.vl_key(&v, (1 + rnd_to(14)) as u32, mods)
        } else if op == 1 {
            let r1: u32 = vlist.vl_char(&v, rnd_to(300) as u32, mods, (steps * 300) as i64, 0, row_of)
        } else if op == 2 {
            let r2: u32 = vlist.vl_click(&v, rnd_to(1200), mods)
        } else if op == 3 {
            vlist.vl_wheel(&v, ((rnd_to(21) as f64) - 10.0) * 0.5)
        } else if op == 4 {
            vlist.vl_set_rect(&v, 0.0, 0.0, (rnd_to(400)) as f64, (rnd_to(300)) as f64)
        } else if op == 5 {
            let h: usize = rnd_to(3)
            if h == 0 { vlist.vl_set_count(&v, rnd_to(2000)) }
            if h == 1 { vlist.vl_set_row_height(&v, 1.0 + (rnd_to(60) as f64)) }
            if h == 2 { vlist.vl_set_heights(&v, 0, height_of) }
        } else if op == 6 {
            let k: usize = vlist.vl_hit(&v, (rnd_to(300)) as f64, (rnd_to(300)) as f64)
            if k != vlist.NONE && k >= vlist.vl_count(&v) { bad = bad + 1 }
        } else if op == 7 {
            vlist.vl_scroll_to(&v, rnd_to(2100), rnd_to(3) as u32)
        } else {
            vlist.vl_set_height(&v, rnd_to(2100), (rnd_to(50)) as f64)
        }
        // invariants
        let c: usize = vlist.vl_cur(&v)
        if c != vlist.NONE && c >= vlist.vl_count(&v) { bad = bad + 1 }
        if vlist.vl_sel_count(&v) > vlist.vl_count(&v) { bad = bad + 1 }
        if vlist.vl_end(&v) > vlist.vl_count(&v) { bad = bad + 1 }
        if vlist.vl_first(&v) > vlist.vl_end(&v) { bad = bad + 1 }
        steps = steps + 1
    }
    say("  robustness fuzz: 50000 random operations, invariant violations ")
    say_num(bad as i64)
    say("\n")
    check(bad == 0, "no crash, no invariant violated under random keys / clicks / rects / counts")
    vlist.vl_free(&v)
}

// speed of the model alone: the work one frame needs (range + hit + key) on 100000 rows
fn bench_model() {
    var v: vlist.Vlist = mk(100000, 24.0, 600.0, 800.0)
    let t0: u64 = time.monotonic_ns()
    var sink: usize = 0
    var i: usize = 0
    while i < 2000 {
        vlist.vl_scroll_to(&v, (i * 37) % 100000, vlist.SCROLL_TOP)
        sink = sink + vlist.vl_first(&v) + vlist.vl_end(&v)
        sink = sink + vlist.vl_hit(&v, 50.0, 300.0)
        i = i + 1
    }
    let t1: u64 = time.monotonic_ns()
    say("  model, 100000 equal rows: ")
    say_num(((t1 - t0) / 2000) as i64)
    say(" ns per frame (range+hit)\n")
    vlist.vl_set_heights(&v, 0, height_of)
    let t2: u64 = time.monotonic_ns()
    i = 0
    while i < 2000 {
        vlist.vl_scroll_to(&v, (i * 37) % 100000, vlist.SCROLL_TOP)
        sink = sink + vlist.vl_first(&v) + vlist.vl_end(&v)
        sink = sink + vlist.vl_hit(&v, 50.0, 300.0)
        i = i + 1
    }
    let t3: u64 = time.monotonic_ns()
    say("  model, 100000 variable rows: ")
    say_num(((t3 - t2) / 2000) as i64)
    say(" ns per frame (range+hit)\n")
    check(((t3 - t2) / 2000) < 2000000, "model frame work on 100000 variable rows < 2 ms")
    vlist.vl_free(&v)
}

fn main() -> i32 {
    say("VLIST MODEL\n")
    test_equal_heights()
    test_variable_heights()
    test_keys()
    test_multi()
    test_fuzz_against_reference()
    test_typeahead()
    test_columns()
    test_fuzz_robust()
    bench_model()
    if BAD == 0 {
        say("VLIST PASSED\n")
        return 0
    }
    say("VLIST FAILED\n")
    return 1
}
