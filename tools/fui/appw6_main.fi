// tools/fui/appw6_main.fi -- the wave 6 controls in the ten-line API (appctl.sheet_* bottom sheet overlay, appctl.propgrid).
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.wave6
import fui.a11y
import fui.render

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn num(tag: str, v: f64) {
    say(tag)
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v as i64)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

static mut LAST_ID: usize = 0
static mut CUR_APP: u64 = 0
static mut EDITS: usize = 0
static mut SHEET_CH: usize = 0
static mut BODY_CALLS: usize = 0
static mut BODY_X: f64 = 0.0
static mut BODY_W: f64 = 0.0
static mut BPTR: usize = 0
static mut BDOWN: usize = 0

fn changed2(a: *mut app.App, id: usize) {
    LAST_ID = id
    CHANGES = CHANGES + 1
}

fn edited(a: *mut app.App, id: usize) {
    EDITS = EDITS + 1
}

fn sheet_changed(a: *mut app.App, id: usize) {
    SHEET_CH = SHEET_CH + 1
}

fn body_draw(a: *mut app.App, rc: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64) {
    BODY_CALLS = BODY_CALLS + 1
    BODY_X = x
    BODY_W = w
}

fn body_ptr(a: *mut app.App, kind: u32, x: f64, y: f64) {
    BPTR = BPTR + 1
    if kind == fuiwirt.HOOK_DOWN {
        BDOWN = BDOWN + 1
    }
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

fn click(w: *mut fuiwirt.Host, x: f64, y: f64) {
    let m: u32 = fuiwirt.host_pointer_move(w, x, y)
    let d: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let u: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
}

fn glide(a: *mut app.App, s: *mut Surface, n: usize) {
    let w: *mut fuiwirt.Host = app.app_host(a)
    var t: i64 = fuiwirt.host_now(w)
    var g: usize = 0
    while g < n {
        t = t + 16
        fuiwirt.host_tick(w, t)
        g = g + 1
    }
    frame(a, s)
}

fn str_is(s: str, t: str) -> bool {
    if s.n != t.n {
        return false
    }
    var i: usize = 0
    while i < s.n {
        if *((s.p as u64 + i as u64) as *mut u8) != *((t.p as u64 + i as u64) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return true
}

fn type_text(w: *mut fuiwirt.Host, t: str) {
    var i: usize = 0
    while i < t.n {
        let ch: u8 = *((t.p as u64 + i as u64) as *mut u8)
        let r: bool = app.app_char(CUR_APP, ch as u32, 0 as u32)
        i = i + 1
    }
}

// click on the label part / the value part of row `row` of the grid `g`
fn click_label(a: *mut app.App, w: *mut fuiwirt.Host, g: usize, row: usize) {
    var r: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    if appctl.propgrid_row_rect(a, g, row, &r) {
        click(w, r[0] + 14.0, r[1] + r[3] / 2.0)
    }
}

fn click_value(a: *mut app.App, w: *mut fuiwirt.Host, g: usize, row: usize) {
    var r: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    if appctl.propgrid_cell(a, g, row, &r) {
        click(w, r[0] + r[2] / 2.0, r[1] + r[3] / 2.0)
    }
}

fn has_text(buf: *mut u8, n: usize, t: str) -> bool {
    if t.n == 0 || n < t.n {
        return false
    }
    var i: usize = 0
    while i + t.n <= n {
        var j: usize = 0
        while j < t.n && *(buf + i + j) == *((t.p as u64 + j as u64) as *mut u8) {
            j = j + 1
        }
        if j == t.n {
            return true
        }
        i = i + 1
    }
    return false
}

fn dump_has(a: *mut app.App, t: str) -> bool {
    let cap: usize = 16384
    let buf: *mut u8 = rt.heap_alloc(cap) as *mut u8
    let n: usize = a11y.a11y_dump(app.app_scene(a), app.ax(a), buf as u64, cap)
    var m: usize = n
    if m > cap {
        m = cap
    }
    return has_text(buf, m, t)
}

static mut SENSE: usize = 0
fn sense_changed(a: *mut app.App, id: usize) {
    SENSE = SENSE + 1
}

// A NON-modal sheet: the panel owns its pixels (page controls under it hear nothing), the page outside lives,
// and the sheet is a scene node with true bounds, a description and items for the screen reader.
fn take_act(a: *mut app.App, w: *mut fuiwirt.Host) {
    let i: usize = fuiwirt.host_take_activated(w)
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
}

fn pclick(a: *mut app.App, w: *mut fuiwirt.Host, x: f64, y: f64) {
    click(w, x, y)
    take_act(a, w)
    // a toggled box is noticed (and calls back) on the next pointer event
    let m: u32 = fuiwirt.host_pointer_move(w, x + 1.0, y)
}

fn sheet_make(b: *mut app.App) {
    let shok: bool = appctl.sheet_setup(b, "Panel", false, body_draw, sheet_changed)
    check(shok, "non-modal: the sheet exists")
    appctl.sheet_describe(b, "Three items in the cart")
    let it0: usize = appctl.sheet_item(b, a11y.ROLE_TEXT, "Total 3 items", 0, 0, 200, 24)
    let it1: usize = appctl.sheet_item(b, a11y.ROLE_BUTTON, "Checkout", 0, 30, 120, 32)
    check(it0 == 0 && it1 == 1, "two items are made")
}

// first = the sheet's node stands BEFORE the page controls (they are above it in the tree): only the pointer
// shield of the host keeps the click from them then
fn nonmodal_test(first: bool) {
    let b: *mut app.App = app.window("NonModal", 640, 600)
    if first {
        sheet_make(b)
    }
    let top: usize = appctl.checkbox(b, "Above", false, sense_changed)
    let sp: usize = app.spacer(b, 10, 380)
    let under: usize = appctl.checkbox(b, "Under", false, sense_changed)
    if !first {
        sheet_make(b)
    }
    fuiwirt.host_bind(app.app_host(b))
    let s: *mut Surface = surface_for(b, 640, 600)
    settle(b, s)
    let w: *mut fuiwirt.Host = app.app_host(b)
    let sc: *mut scene.Scene = app.app_scene(b)
    let node: usize = appctl.sheet_node(b)
    check(node != appctl.NONE, "the sheet has a scene node")
    check(!dump_has(b, "dialog \"Panel\"") && !dump_has(b, "Total 3 items"), "closed: the sheet is not listed")
    // the page works before
    let ux: f64 = scene.node_x(sc, under) + 6.0
    let uy: f64 = scene.node_y(sc, under) + scene.node_h(sc, under) / 2.0
    let tx: f64 = scene.node_x(sc, top) + 6.0
    let ty: f64 = scene.node_y(sc, top) + scene.node_h(sc, top) / 2.0
    check(uy > 300.0, "the control stands where the panel will be")
    SENSE = 0
    pclick(b, w, ux, uy)
    check(SENSE == 1, "closed: the control hears the click")
    // open
    appctl.sheet_show(b, 0)
    glide(b, s, 40)
    check(appctl.sheet_visible(b) && appctl.sheet_snap(b) == 0, "non-modal: open")
    SENSE = 0
    pclick(b, w, ux, uy)
    check(SENSE == 0, "a click under the panel does not reach the page")
    let mm: u32 = fuiwirt.host_pointer_move(w, ux, uy)
    check(fuiwirt.host_shielded(w), "the host reports the shielded move")
    pclick(b, w, tx, ty)
    check(SENSE == 1 && appctl.sheet_visible(b), "a click on the page outside the panel works, the sheet stays")
    // a press in the panel released on the page is not a click there
    SENSE = 0
    let pd: u32 = fuiwirt.host_pointer_move(w, ux, uy)
    let pd2: u32 = fuiwirt.host_pointer_down(w, ux, uy, fuiwirt.BTN_LEFT)
    let pm: u32 = fuiwirt.host_pointer_move(w, tx, ty)
    let pu: u32 = fuiwirt.host_pointer_up(w, tx, ty, fuiwirt.BTN_LEFT)
    take_act(b, w)
    let pm2: u32 = fuiwirt.host_pointer_move(w, tx + 1.0, ty)
    check(SENSE == 0, "a press in the panel released on the page does nothing there")
    // a press on the page dragged over the panel and released there is not stuck
    let qd: u32 = fuiwirt.host_pointer_move(w, tx, ty)
    let qd2: u32 = fuiwirt.host_pointer_down(w, tx, ty, fuiwirt.BTN_LEFT)
    let qm: u32 = fuiwirt.host_pointer_move(w, ux, uy)
    let qu: u32 = fuiwirt.host_pointer_up(w, ux, uy, fuiwirt.BTN_LEFT)
    take_act(b, w)
    check(!fuiwirt.host_shielded(w), "the release of a page press is not shielded")
    SENSE = 0
    pclick(b, w, tx, ty)
    check(SENSE == 1, "and the page still takes clicks after it")
    // right click and wheel under the panel
    let rd: u32 = fuiwirt.host_pointer_down(w, ux, uy, fuiwirt.BTN_RIGHT)
    check(fuiwirt.host_shielded(w), "a right click on the panel is shielded")
    // the body hears the pointer
    appctl.sheet_on_pointer(b, body_ptr)
    var br: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    let okb: bool = appctl.sheet_body(b, &br)
    BDOWN = 0
    click(w, br[0] + br[2] / 2.0, br[1] + br[3] / 2.0)
    check(okb && BDOWN == 1, "the body of a non-modal sheet hears the pointer")
    // ---- the scene node
    check(a11y.a11y_role(sc, app.ax(b), node) == a11y.ROLE_DIALOG, "open: the node is a dialog")
    check(dump_has(b, "dialog \"Panel\""), "open: the dump lists the dialog")
    check(dump_has(b, "Total 3 items") && dump_has(b, "Checkout"), "open: the dump lists the items")
    var db: [u8; 64] = [0 as u8; 64]
    let dn: usize = a11y.a11y_description(sc, app.ax(b), node, (&db[0]) as u64, 64)
    check(dn == 23, "the dialog carries the description")
    var pr: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    check(near(scene.node_y(sc, node), 300.0, 2.0) && near(scene.node_h(sc, node), 300.0, 2.0)
        && near(scene.node_w(sc, node), 640.0, 700.0) && scene.node_w(sc, node) > 100.0,
        "the node has the rectangle of the panel")
    let i0n: usize = scene.scene_first_child(sc, node)
    check(i0n != scene.SCENE_NONE && scene.scene_parent(sc, i0n) == node, "the items are children of the node")
    check(near(scene.node_w(sc, i0n), 200.0, 1.0) && near(scene.node_x(sc, i0n), br[0], 1.0)
        && near(scene.node_y(sc, i0n), br[1], 1.0), "an item sits in the body")
    // it follows a relayout
    settle(b, s)
    check(near(scene.node_y(sc, node), 300.0, 2.0), "the rectangle survives a repaint")
    // ---- closed again: not listed, the page is whole
    appctl.sheet_hide(b)
    glide(b, s, 40)
    check(!dump_has(b, "dialog \"Panel\"") && !dump_has(b, "Total 3 items"), "closed again: not listed")
    SENSE = 0
    pclick(b, w, ux, uy)
    check(SENSE == 1, "closed again: the control hears the click")
}

#[allow_escape]
fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appw6: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Wave6", 640, 600)
    CUR_APP = a as u64
    var rows: [wave6.PgRow; 14] = [wave6.pg_group("", true); 14]
    rows[0] = wave6.pg_group("General", true)
    rows[1] = wave6.pg_text("Name", "Widget", false)
    rows[2] = wave6.pg_bool("Visible", true)
    rows[3] = wave6.pg_num("Width", 120, "px")
    rows[4] = wave6.pg_choice("Mode", "Fast")
    rows[5] = wave6.pg_color("Accent", 0xFF3366CC as u32)
    rows[6] = wave6.pg_text("Id", "x-1", true)
    rows[7] = wave6.pg_group("Layout", true)
    rows[8] = wave6.pg_num("Margin", 8, "pt")
    rows[9] = wave6.pg_bool("Wrap", false)
    rows[10] = wave6.pg_text("Tag", "a", false)
    rows[11] = wave6.pg_group("Extra", true)
    rows[12] = wave6.pg_num("A", 1, "")
    rows[13] = wave6.pg_num("B", 2, "")
    let g: usize = appctl.propgrid(a, "Properties", 360, 256, &rows[0], 14, changed2, edited)
    let shok: bool = appctl.sheet_setup(a, "Details", true, body_draw, sheet_changed)
    let s: *mut Surface = surface_for(a, 640, 600)
    settle(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    let w: *mut fuiwirt.Host = app.app_host(a)
    check(g != appctl.NONE && shok, "the grid and the sheet exist")
    check(!appctl.sheet_setup(a, "Again", true, body_draw, sheet_changed), "a second sheet is refused")
    check(scene.node_w(sc, g) > 300.0 && scene.node_h(sc, g) > 200.0, "the grid has a size")
    check(!appctl.sheet_visible(a) && appctl.sheet_snap(a) == appctl.NONE, "the sheet starts closed")

    // ---- grid: switch, fold
    let c0: usize = CHANGES
    click_value(a, w, g, 2)
    settle(a, s)
    check(!rows[2].on, "click on a switch value flips it")
    check(appctl.propgrid_event(a, g) == wave6.PGK_TOGGLED && appctl.propgrid_row(a, g) == 2, "event is TOGGLED for row 2")
    check(CHANGES == c0 + 1 && LAST_ID == g, "one change callback names the grid")
    click_label(a, w, g, 7)
    settle(a, s)
    check(!rows[7].on && appctl.propgrid_event(a, g) == wave6.PGK_FOLDED, "click on a group folds it")
    click_label(a, w, g, 7)
    settle(a, s)
    check(rows[7].on, "and unfolds it")

    // ---- inline editor: text
    click_value(a, w, g, 1)
    settle(a, s)
    check(appctl.propgrid_editing(a), "click on a text value opens the inline editor")
    check(str_is(appctl.propgrid_edit_text(a), "Widget"), "the editor starts with the value")
    type_text(w, "AB")
    let ke: bool = app.app_key(a as u64, editor.KEY_ENTER, 0 as u32)
    settle(a, s)
    check(!appctl.propgrid_editing(a) && str_is(rows[1].text, "AB"), "typing replaces the selected text, Enter commits")
    check(appctl.propgrid_event(a, g) == appctl.PGE_COMMIT && appctl.propgrid_row(a, g) == 1, "event is COMMIT for row 1")
    click_value(a, w, g, 1)
    type_text(w, "Z")
    let ke2: bool = app.app_key(a as u64, editor.KEY_ESC, 0 as u32)
    check(!appctl.propgrid_editing(a) && str_is(rows[1].text, "AB"), "Esc cancels the edit")
    // ---- inline editor: number
    click_value(a, w, g, 3)
    type_text(w, "300")
    let ke3: bool = app.app_key(a as u64, editor.KEY_ENTER, 0 as u32)
    check(rows[3].num == 300 as i64, "a number edit commits as a number")
    click_value(a, w, g, 3)
    type_text(w, "abc")
    let ke4: bool = app.app_key(a as u64, editor.KEY_ENTER, 0 as u32)
    check(rows[3].num == 300 as i64 && !appctl.propgrid_editing(a), "a number that does not parse is dropped")
    click_value(a, w, g, 3)
    type_text(w, "-5")
    click_value(a, w, g, 1)
    check(rows[3].num == 0 as i64 - 5 as i64, "a click elsewhere commits")
    check(appctl.propgrid_editing(a), "and opens the editor of the new row")
    let ke5: bool = app.app_key(a as u64, editor.KEY_ESC, 0 as u32)
    // ---- edit callback: choice, colour; read-only; inline off
    let e0: usize = EDITS
    click_value(a, w, g, 4)
    check(EDITS == e0 + 1 && !appctl.propgrid_editing(a), "a choice value calls the edit callback")
    check(appctl.propgrid_event(a, g) == wave6.PGK_EDIT && appctl.propgrid_row(a, g) == 4, "with EDIT and its row")
    click_value(a, w, g, 5)
    check(EDITS == e0 + 2, "a colour value calls it too")
    click_value(a, w, g, 6)
    check(EDITS == e0 + 2 && !appctl.propgrid_editing(a), "a read-only value asks for nothing")
    appctl.propgrid_inline(a, g, false)
    click_value(a, w, g, 1)
    check(EDITS == e0 + 3 && !appctl.propgrid_editing(a), "inline off: the text value asks the program")
    appctl.propgrid_inline(a, g, true)

    // ---- keys, scroll
    app.set_focus(a, g)
    let kh: bool = app.app_key(a as u64, editor.KEY_HOME, 0 as u32)
    check(appctl.propgrid_selected(a, g) == 0 && appctl.propgrid_top(a, g) == 0, "Home selects the first row")
    let kd: bool = app.app_key(a as u64, editor.KEY_DOWN, 0 as u32)
    check(appctl.propgrid_selected(a, g) == 1, "Down moves the selection")
    let kn: bool = app.app_key(a as u64, editor.KEY_END, 0 as u32)
    check(appctl.propgrid_selected(a, g) == 13, "End selects the last row")
    num("  top after End ", appctl.propgrid_top(a, g) as f64)
    check(appctl.propgrid_top(a, g) == 6, "the grid scrolled so that the last row shows")
    let kh2: bool = app.app_key(a as u64, editor.KEY_HOME, 0 as u32)
    check(appctl.propgrid_top(a, g) == 0, "Home scrolls back")
    var gr: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    let okr: bool = appctl.propgrid_row_rect(a, g, 2, &gr)
    let mw: u32 = fuiwirt.host_pointer_move(w, gr[0] + 30.0, gr[1] + 10.0)
    let wd: u32 = fuiwirt.host_pointer_down(w, gr[0] + 30.0, gr[1] + 10.0, fuiwirt.BTN_WHEEL_DOWN)
    num("  top after wheel ", appctl.propgrid_top(a, g) as f64)
    check(appctl.propgrid_top(a, g) == 3, "the wheel scrolls three rows")
    let wu: u32 = fuiwirt.host_pointer_down(w, gr[0] + 30.0, gr[1] + 10.0, fuiwirt.BTN_WHEEL_UP)
    check(appctl.propgrid_top(a, g) == 0, "and back up")
    appctl.propgrid_set_top(a, g, 99)
    check(appctl.propgrid_top(a, g) == 6, "set_top clamps to the last page")
    appctl.propgrid_set_top(a, g, 0)

    // ---- the divider
    let pm0: i64 = appctl.propgrid_label_pm(a, g)
    var dr: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    let okd: bool = appctl.propgrid_row_rect(a, g, 2, &dr)
    let dx: f64 = dr[0] + dr[2] * (pm0 as f64) / 1000.0
    let dm1: u32 = fuiwirt.host_pointer_move(w, dx, dr[1] + 10.0)
    let dd: u32 = fuiwirt.host_pointer_down(w, dx, dr[1] + 10.0, fuiwirt.BTN_LEFT)
    let dm2: u32 = fuiwirt.host_pointer_move(w, dx + 50.0, dr[1] + 10.0)
    let du: u32 = fuiwirt.host_pointer_up(w, dx + 50.0, dr[1] + 10.0, fuiwirt.BTN_LEFT)
    num("  label permille ", appctl.propgrid_label_pm(a, g) as f64)
    check(appctl.propgrid_label_pm(a, g) > pm0 + 80 as i64, "dragging the divider widens the label column")

    // ---- a11y: the description of the selected row
    appctl.propgrid_select(a, g, 3)
    var db: [u8; 160] = [0 as u8; 160]
    let dn: usize = a11y.a11y_description(sc, app.ax(a), g, (&db[0]) as u64, 160)
    var dstr: str = str { p: (&db[0]) as *mut u8, n: dn }
    num("  description length ", dn as f64)
    check(dn > 8 && db[0] == 87 as u8, "the node describes the selected row (Width, ...)")
    check(a11y.a11y_role(sc, app.ax(a), g) == a11y.ROLE_TREE, "the grid is a tree for the screen reader")

    // ---- sheet: open, glide, snap points, keys
    BODY_CALLS = 0
    appctl.sheet_show(a, 0)
    check(appctl.sheet_visible(a) && appctl.sheet_snap(a) == 0, "show(0) opens at the first snap point")
    glide(a, s, 40)
    num("  sheet height x1000 ", (appctl.sheet_height(a) * 1000.0) as f64)
    check(near(appctl.sheet_height(a), 0.5, 0.01), "the sheet glided to 0.5")
    check(BODY_CALLS > 0, "the body callback paints the content")
    var br: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    check(appctl.sheet_body(a, &br) && br[0] > 0.0 && br[0] + br[2] <= 640.0 && br[1] > 250.0, "the body room is inside the window")
    check(near(BODY_X, br[0], 1.0) && near(BODY_W, br[2], 1.0), "the callback got that room")
    // the page behind is shut off
    let sv: bool = rows[2].on
    click_value(a, w, g, 2)
    check(rows[2].on == sv && appctl.sheet_snap(a) == appctl.NONE, "a click on the scrim closes the sheet, the page behind does nothing")
    appctl.sheet_show(a, 0)
    glide(a, s, 40)
    let c1: usize = SHEET_CH
    let ku: bool = app.app_key(a as u64, editor.KEY_UP, 0 as u32)
    check(appctl.sheet_snap(a) == 1 && SHEET_CH == c1 + 1, "Up goes to the next snap point and calls back")
    glide(a, s, 40)
    check(near(appctl.sheet_height(a), 0.9, 0.01), "and glides to 0.9")
    let kdn: bool = app.app_key(a as u64, editor.KEY_DOWN, 0 as u32)
    check(appctl.sheet_snap(a) == 0, "Down goes back")
    let kes: bool = app.app_key(a as u64, editor.KEY_ESC, 0 as u32)
    check(appctl.sheet_snap(a) == appctl.NONE && SHEET_CH == c1 + 3, "Esc closes and calls back")
    glide(a, s, 40)
    check(!appctl.sheet_visible(a) && appctl.sheet_height(a) < 0.001, "the closed sheet is gone")
    // the page works again
    click_value(a, w, g, 2)
    check(rows[2].on != sv, "the page reacts again")

    // ---- scrim click closes
    appctl.sheet_show(a, 1)
    glide(a, s, 40)
    let c2: usize = SHEET_CH
    click(w, 20.0, 20.0)
    check(appctl.sheet_snap(a) == appctl.NONE && SHEET_CH == c2 + 1, "a click on the scrim closes the sheet")
    glide(a, s, 40)

    // ---- body pointer
    appctl.sheet_on_pointer(a, body_ptr)
    appctl.sheet_show(a, 0)
    glide(a, s, 40)
    let okb: bool = appctl.sheet_body(a, &br)
    BPTR = 0
    BDOWN = 0
    click(w, br[0] + br[2] / 2.0, br[1] + br[3] / 2.0)
    check(BDOWN == 1 && BPTR >= 2 && appctl.sheet_snap(a) == 0, "the body hears the pointer, the sheet stays")

    // ---- drag the handle down: fling closes
    var hr: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    let okh: bool = appctl.sheet_handle(a, &hr)
    check(okh && hr[3] > 10.0, "there is a grab zone")
    let hx: f64 = hr[0] + hr[2] / 2.0
    var hy: f64 = hr[1] + hr[3] / 2.0
    let hm: u32 = fuiwirt.host_pointer_move(w, hx, hy)
    let hd: u32 = fuiwirt.host_pointer_down(w, hx, hy, fuiwirt.BTN_LEFT)
    var t: i64 = fuiwirt.host_now(w)
    var q: usize = 0
    while q < 6 {
        t = t + 16
        fuiwirt.host_tick(w, t)
        hy = hy + 40.0
        let hm2: u32 = fuiwirt.host_pointer_move(w, hx, hy)
        q = q + 1
    }
    check(appctl.sheet_height(a) < 0.5, "the panel follows the finger")
    let c3: usize = SHEET_CH
    let hu: u32 = fuiwirt.host_pointer_up(w, hx, hy, fuiwirt.BTN_LEFT)
    check(appctl.sheet_snap(a) == appctl.NONE && SHEET_CH == c3 + 1, "a fast drag down closes it")
    glide(a, s, 40)
    check(!appctl.sheet_visible(a), "and it is gone")
    // ---- the program closes / opens without a callback
    let c4: usize = SHEET_CH
    appctl.sheet_show(a, 1)
    appctl.sheet_hide(a)
    check(SHEET_CH == c4, "show / hide by the program do not call back")
    glide(a, s, 40)

    nonmodal_test(false)
    nonmodal_test(true)

    if BAD == 0 {
        say("APPW6 PASSED\n")
        return 0
    }
    say("APPW6 FAILED\n")
    return 1
}
