// SPDX-License-Identifier: MPL-2.0
// tools/fui/icons_main.fi -- THE LUCIDE ICONS AT THE PIXEL.
//
//     icons_main                 check only
//     icons_main <sheet.png>     and paint every icon at 16, 24 and 48
//
// What lib/fui/icons.fi promises, measured instead of believed:
//
//   1. every icon of the set parses and puts ink on the canvas -- an icon
//      whose path string the parser silently drops is an empty button;
//   2. Lucide's stroke is 2 units: the bar of PLUS at 24 pixels is two
//      rows of full coverage and nothing a row further out;
//   3. the colour arrives channel for channel (red, green and blue all
//      different, so a swap would show);
//   4. SHARP AT EVERY SIZE: the outline is rastered at the size it is
//      drawn at, so a circle at 64 has many more soft edge pixels than at
//      16 -- a bitmap made bigger would not;
//   5. PLUS is mirror symmetric (the same ink left and right of centre);
//   6. the canvas clip holds: with the right half clipped away nothing is
//      painted there;
//   7. the filled form covers more than the stroked one (LOCK);
//   8. the door in design points: 12 points at scale 2000 are the very
//      pixels of 24 pixels at scale 1000;
//   9. painter.round_rect_grad ramps as asked (the look of avatars and
//      accent buttons that came with the icons);
//  10. effect.frost_rect, the cheap glass: an edge under it is blurred,
//      the far sides keep their colour under the tint, nothing outside
//      the band is touched;
//  11. the ground with depth (effect.veil_rect, glow_ground, Keep): a
//      veil is the same mix as the frost's tint, a spot lights its centre
//      and not its far corner, a kept picture comes back pixel for pixel;
//  12. the shapes at the price of a fill (effect.rrect_fast, rrect_shadow,
//      ramp_rect, shift_rows): the fast round rectangle stays within a few
//      levels of painter.round_rect, a shadow darkens below the card and
//      nowhere far away, a ramp runs out, a block of rows moves.
import std.rt
import html.mem
import paint.canvas
import paint.png
import fui.theme
import fui.painter
import fui.render
import fui.icons
import fui.lucide
import fui.effect

static mut G_ERRORS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn report(s: str, ok: bool, got: i64, want: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, s.p as u64, s.n)
    var i: usize = s.n
    while i < 56 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        let o: str = "OK "
        rt.buf_push_bytes(&t, o.p as u64, o.n)
    } else {
        let f: str = "WRONG   "
        rt.buf_push_bytes(&t, f.p as u64, f.n)
        G_ERRORS = G_ERRORS + 1
    }
    let h1: str = " got "
    rt.buf_push_bytes(&t, h1.p as u64, h1.n)
    rt.buf_push_dec_i64(&t, got)
    let h2: str = " want "
    rt.buf_push_bytes(&t, h2.p as u64, h2.n)
    rt.buf_push_dec_i64(&t, want)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn alpha(cv: *mut canvas.Canvas, x: usize, y: usize) -> i64 {
    return ((canvas.canvas_get(cv, x, y) >> 24) & 255 as u32) as i64
}

fn chan(cv: *mut canvas.Canvas, x: usize, y: usize, sh: u32) -> i64 {
    return ((canvas.canvas_get(cv, x, y) >> sh) & 255 as u32) as i64
}

// Pixels with coverage in a rectangle.
fn ink(cv: *mut canvas.Canvas, x0: usize, y0: usize, x1: usize,
    y1: usize) -> i64 {
    var n: i64 = 0
    var y: usize = y0
    while y < y1 {
        var x: usize = x0
        while x < x1 {
            if alpha(cv, x, y) > 24 {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

// Partly covered pixels -- the measure of the antialiased edge.
fn soft(cv: *mut canvas.Canvas, x0: usize, y0: usize, x1: usize,
    y1: usize) -> i64 {
    var n: i64 = 0
    var y: usize = y0
    while y < y1 {
        var x: usize = x0
        while x < x1 {
            let a: i64 = alpha(cv, x, y)
            if a > 12 && a < 243 {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn abs_i(v: i64) -> i64 {
    if v < 0 {
        return 0 - v
    }
    return v
}

const BLACK: u32 = 4278190080

fn main(start: u64) -> i32 {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, 128, 128) {
        return 3
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, 128, 128) {
        return 3
    }

    say("== 1. EVERY ICON OF THE SET PUTS INK ON THE CANVAS ==\n")
    var empty: i64 = 0
    var i: i64 = 0
    while i < lucide.LUCIDE_N {
        canvas.canvas_clear(&cv, 0 as u32)
        icons.icon(&z, i, 8.0, 8.0, 24.0, BLACK as u32)
        let n: i64 = ink(&cv, 0, 0, 48, 48)
        if n < 12 {
            empty = empty + 1
            let nm: str = lucide.lucide_name(i)
            say("   no ink: ")
            say(nm)
            say("\n")
        }
        i = i + 1
    }
    report("1 icons without ink", empty == 0, empty, 0)
    report("1 the set carries 74 icons", lucide.LUCIDE_N == 74,
        lucide.LUCIDE_N, 74)
    let nm: str = "send-horizontal"
    report("1 lucide_find(send-horizontal) = SEND_HORIZONTAL",
        lucide.lucide_find(nm.p as u64, nm.n) == lucide.SEND_HORIZONTAL,
        lucide.lucide_find(nm.p as u64, nm.n), lucide.SEND_HORIZONTAL)
    report("1 an unknown id draws nothing", !icons.icon_ok(lucide.LUCIDE_N),
        0, 0)

    say("\n== 2. THE STROKE IS LUCIDE'S 2 UNITS ==\n")
    // PLUS: M5 12h14 M12 5v14, at 24 px on (0,0): the bar covers the rows
    // y = 11 and 12 fully, row 10 and 13 not at all.
    canvas.canvas_clear(&cv, 0 as u32)
    icons.icon(&z, lucide.PLUS, 0.0, 0.0, 24.0, BLACK as u32)
    report("2 bar row 11 at x=7 full", alpha(&cv, 7, 11) > 240,
        alpha(&cv, 7, 11), 255)
    report("2 bar row 12 at x=7 full", alpha(&cv, 7, 12) > 240,
        alpha(&cv, 7, 12), 255)
    report("2 row 10 at x=7 empty", alpha(&cv, 7, 10) < 16,
        alpha(&cv, 7, 10), 0)
    report("2 row 13 at x=7 empty", alpha(&cv, 7, 13) < 16,
        alpha(&cv, 7, 13), 0)
    // the round cap reaches one unit past the end (x = 4..5)
    report("2 round cap: x=4 row 11 covered", alpha(&cv, 4, 11) > 60,
        alpha(&cv, 4, 11), 128)
    report("2 nothing at x=2", alpha(&cv, 2, 11) < 16, alpha(&cv, 2, 11), 0)

    say("\n== 3. THE COLOUR ARRIVES CHANNEL FOR CHANNEL ==\n")
    // 0xFF3264C8: red 50, green 100, blue 200
    canvas.canvas_clear(&cv, 0 as u32)
    icons.icon(&z, lucide.PLUS, 0.0, 0.0, 24.0, 4281492680 as u32)
    report("3 red 50", abs_i(chan(&cv, 12, 12, 16 as u32) - 50) <= 2,
        chan(&cv, 12, 12, 16 as u32), 50)
    report("3 green 100", abs_i(chan(&cv, 12, 12, 8 as u32) - 100) <= 2,
        chan(&cv, 12, 12, 8 as u32), 100)
    report("3 blue 200", abs_i(chan(&cv, 12, 12, 0 as u32) - 200) <= 2,
        chan(&cv, 12, 12, 0 as u32), 200)
    // half alpha: the icon fades like a letter
    canvas.canvas_clear(&cv, 0 as u32)
    icons.icon(&z, lucide.PLUS, 0.0, 0.0, 24.0, 2130706432 as u32)
    report("3 alpha 0x7F gives half coverage",
        abs_i(alpha(&cv, 12, 12) - 127) <= 3, alpha(&cv, 12, 12), 127)

    say("\n== 4. RASTERED AT THE SIZE IT IS DRAWN AT ==\n")
    canvas.canvas_clear(&cv, 0 as u32)
    icons.icon(&z, lucide.CIRCLE_CHECK, 0.0, 0.0, 16.0, BLACK as u32)
    let s16: i64 = soft(&cv, 0, 0, 20, 20)
    canvas.canvas_clear(&cv, 0 as u32)
    icons.icon(&z, lucide.CIRCLE_CHECK, 0.0, 0.0, 64.0, BLACK as u32)
    let s64: i64 = soft(&cv, 0, 0, 70, 70)
    report("4 at 16 px the edge is antialiased", s16 > 20, s16, 20)
    report("4 at 64 px more than twice the soft pixels", s64 > s16 * 2,
        s64, s16 * 2)
    let i64n: i64 = ink(&cv, 0, 0, 70, 70)
    report("4 at 64 px the ring stays a thin line (ink < 1/3)",
        i64n < 64 * 64 / 3, i64n, 64 * 64 / 3)

    say("\n== 5. PLUS IS MIRROR SYMMETRIC ==\n")
    canvas.canvas_clear(&cv, 0 as u32)
    icons.icon(&z, lucide.PLUS, 0.0, 0.0, 48.0, BLACK as u32)
    let left: i64 = ink(&cv, 0, 0, 24, 48)
    let right: i64 = ink(&cv, 24, 0, 48, 48)
    report("5 ink left of centre = right of centre", abs_i(left - right) <= 2,
        left, right)
    let top: i64 = ink(&cv, 0, 0, 48, 24)
    let bot: i64 = ink(&cv, 0, 24, 48, 48)
    report("5 ink above centre = below centre", abs_i(top - bot) <= 2, top,
        bot)

    say("\n== 6. THE CANVAS CLIP HOLDS ==\n")
    canvas.canvas_clear(&cv, 0 as u32)
    let _c: bool = canvas.clip_push_rect(&cv, 0.0, 0.0, 24.0, 48.0)
    icons.icon(&z, lucide.PLUS, 0.0, 0.0, 48.0, BLACK as u32)
    canvas.clip_pop(&cv)
    report("6 nothing right of the clip", ink(&cv, 25, 0, 48, 48) == 0,
        ink(&cv, 25, 0, 48, 48), 0)
    report("6 the left half is there", ink(&cv, 0, 0, 24, 48) > 40,
        ink(&cv, 0, 0, 24, 48), 40)

    say("\n== 7. FILLED COVERS MORE THAN STROKED ==\n")
    canvas.canvas_clear(&cv, 0 as u32)
    // LOCK: the body is a closed rectangle -- stroked it is a frame,
    // filled a block. (A thin dart like SEND_HORIZONTAL is a bad witness:
    // its outline at 2 units covers nearly as much as its inside.)
    icons.icon(&z, lucide.LOCK, 0.0, 0.0, 48.0, BLACK as u32)
    let st: i64 = ink(&cv, 0, 0, 52, 52)
    canvas.canvas_clear(&cv, 0 as u32)
    icons.icon_filled(&z, lucide.LOCK, 0.0, 0.0, 48.0, BLACK as u32)
    let fl: i64 = ink(&cv, 0, 0, 52, 52)
    report("7 filled lock > 1.5 x stroked lock", fl * 2 > st * 3, fl, st)
    report("7 the filled body is solid in its middle",
        alpha(&cv, 24, 32) > 240, alpha(&cv, 24, 32), 255)

    say("\n== 8. THE DOOR IN DESIGN POINTS ==\n")
    var m: theme.Theme = theme.theme_new(false)
    theme.theme_set_scale(&m, 2000)
    var c: render.Ctx = render.ctx_new(&m, &z)
    canvas.canvas_clear(&cv, 0 as u32)
    icons.icon_pt(&c, lucide.USERS, 4.0, 4.0, 12.0, BLACK as u32)
    let pt: i64 = ink(&cv, 0, 0, 40, 40)
    canvas.canvas_clear(&cv, 0 as u32)
    icons.icon(&z, lucide.USERS, 8.0, 8.0, 24.0, BLACK as u32)
    let px: i64 = ink(&cv, 0, 0, 40, 40)
    report("8 12 pt at scale 2000 = 24 px at scale 1000", pt == px, pt, px)

    say("\n== 9. THE GRADIENT OF THE PAINTER (round_rect_grad) ==\n")
    // red at the top, blue at the bottom, radius 10: the corner stays
    // empty, the top row is red, the bottom row blue, the middle between.
    canvas.canvas_clear(&cv, 0 as u32)
    painter.round_rect_grad(&z, 0.0, 0.0, 40.0, 40.0, 10.0,
        4294901760 as u32, 4278190335 as u32, 0.0, 1.0)
    report("9 the round corner stays empty", alpha(&cv, 0, 0) < 16,
        alpha(&cv, 0, 0), 0)
    report("9 top row is red", chan(&cv, 20, 0, 16 as u32) > 230,
        chan(&cv, 20, 0, 16 as u32), 255)
    report("9 bottom row is blue", chan(&cv, 20, 39, 0 as u32) > 230,
        chan(&cv, 20, 39, 0 as u32), 255)
    report("9 the middle is half and half",
        abs_i(chan(&cv, 20, 20, 16 as u32) - chan(&cv, 20, 20, 0 as u32)) < 16,
        chan(&cv, 20, 20, 16 as u32), chan(&cv, 20, 20, 0 as u32))
    report("9 and fully covered", alpha(&cv, 20, 20) > 250,
        alpha(&cv, 20, 20), 255)
    // the diagonal: upper left and lower right differ, the other two
    // corners (inside the radius) agree with each other
    canvas.canvas_clear(&cv, 0 as u32)
    painter.round_rect_grad(&z, 0.0, 0.0, 40.0, 40.0, 4.0,
        4294901760 as u32, 4278190335 as u32, 1.0, 1.0)
    report("9 diagonal: ur and ll are the same mix",
        abs_i(chan(&cv, 34, 5, 16 as u32) - chan(&cv, 5, 34, 16 as u32)) <= 2,
        chan(&cv, 34, 5, 16 as u32), chan(&cv, 5, 34, 16 as u32))
    report("9 mix_argb halfway", painter.mix_argb(0 as u32,
        4294967295 as u32, 0.5) == 2155905152 as u32,
        painter.mix_argb(0 as u32, 4294967295 as u32, 0.5) as i64, 2155905152)

    say("\n== 10. FROST (effect.frost_rect): SHRINK, BLUR, STRETCH, TINT ==\n")
    // A hard black/white edge under a frosted band: the edge becomes a
    // ramp (blurred), the far sides keep their colour under the tint, and
    // nothing outside the band is touched.
    canvas.canvas_clear(&cv, 4294967295 as u32)
    painter.surface(&z, 0.0, 0.0, 64.0, 128.0, BLACK as u32)
    let fok: bool = effect.frost_rect(&z, 0.0, 32.0, 128.0, 40.0, 12,
        2164260863 as u32)
    report("10 frost_rect answers true", fok, fok as i64, 1)
    let edge0: i64 = chan(&cv, 60, 50, 16 as u32)
    let edge1: i64 = chan(&cv, 68, 50, 16 as u32)
    report("10 the edge is blurred: x=60 no longer black", edge0 > 100, edge0, 100)
    report("10 the edge is blurred: x=68 no longer the far white", edge1 < 240, edge1, 240)
    report("10 left, far off the edge: black under half white",
        abs_i(chan(&cv, 8, 50, 16 as u32) - 128) <= 6, chan(&cv, 8, 50, 16 as u32), 128)
    report("10 right, far from the edge: white stays white",
        chan(&cv, 120, 50, 16 as u32) >= 250, chan(&cv, 120, 50, 16 as u32), 255)
    report("10 above the band: untouched black", chan(&cv, 60, 20, 16 as u32) == 0,
        chan(&cv, 60, 20, 16 as u32), 0)
    report("10 below the band: untouched white", chan(&cv, 68, 90, 16 as u32) == 255,
        chan(&cv, 68, 90, 16 as u32), 255)
    report("10 the band stays opaque", alpha(&cv, 60, 50) == 255, alpha(&cv, 60, 50), 255)
    // a wide blur (20: shrunk by 8) keeps the same promises
    canvas.canvas_clear(&cv, 4294967295 as u32)
    painter.surface(&z, 0.0, 0.0, 64.0, 128.0, BLACK as u32)
    let fok8: bool = effect.frost_rect(&z, 0.0, 32.0, 128.0, 40.0, 20,
        2164260863 as u32)
    report("10 wide: answers true", fok8, fok8 as i64, 1)
    report("10 wide: the edge is blurred at x=58", chan(&cv, 58, 50, 16 as u32) > 100,
        chan(&cv, 58, 50, 16 as u32), 100)
    report("10 wide: far left black under half white",
        abs_i(chan(&cv, 4, 50, 16 as u32) - 128) <= 8, chan(&cv, 4, 50, 16 as u32), 128)
    report("10 wide: far right stays white", chan(&cv, 124, 50, 16 as u32) >= 247,
        chan(&cv, 124, 50, 16 as u32), 255)
    report("10 wide: below the band untouched", chan(&cv, 68, 90, 16 as u32) == 255,
        chan(&cv, 68, 90, 16 as u32), 255)

    say("\n== 11. DEPTH: VEIL, GLOW GROUND, KEEP ==\n")
    // the veil: half white over black is 128, and outside untouched
    canvas.canvas_clear(&cv, BLACK as u32)
    effect.veil_rect(&z, 10.0, 10.0, 20.0, 20.0, 2164260863 as u32)
    report("11 veil: half white over black", abs_i(chan(&cv, 15, 15, 16 as u32) - 128) <= 1,
        chan(&cv, 15, 15, 16 as u32), 128)
    report("11 veil: outside untouched", chan(&cv, 40, 40, 16 as u32) == 0,
        chan(&cv, 40, 40, 16 as u32), 0)
    report("11 veil: stays opaque", alpha(&cv, 15, 15) == 255, alpha(&cv, 15, 15), 255)
    // the ground: a red spot in the upper left of a dark ramp
    var sp: [f64; 8] = [0.0; 8]
    sp[0] = 20.0
    sp[1] = 20.0
    sp[2] = 60.0
    sp[3] = 60.0
    sp[4] = 0.8
    sp[5] = 255.0
    sp[6] = 0.0
    sp[7] = 0.0
    effect.glow_ground(&z, 0.0, 0.0, 128.0, 128.0, 4278190090 as u32,
        4278190130 as u32, (&sp[0]) as u64, 1)
    report("11 glow: the centre of the spot is red", chan(&cv, 20, 20, 16 as u32) >= 190,
        chan(&cv, 20, 20, 16 as u32), 190)
    report("11 glow: the far corner has no red", chan(&cv, 120, 120, 16 as u32) <= 1,
        chan(&cv, 120, 120, 16 as u32), 0)
    report("11 glow: the ramp runs down (blue)",
        chan(&cv, 120, 124, 0 as u32) > chan(&cv, 120, 90, 0 as u32) &&
        chan(&cv, 120, 90, 0 as u32) > chan(&cv, 120, 3, 0 as u32),
        chan(&cv, 120, 124, 0 as u32), chan(&cv, 120, 3, 0 as u32))
    report("11 glow: opaque", alpha(&cv, 70, 70) == 255, alpha(&cv, 70, 70), 255)
    // keep: take, paint over, put a band back, then everything
    var kp: effect.Keep = effect.keep_new()
    let tk: bool = effect.keep_take(&kp, &z, 7 as u64)
    report("11 keep: taken", tk && effect.keep_has(&kp, &z, 7 as u64), tk as i64, 1)
    report("11 keep: another key is not held", !effect.keep_has(&kp, &z, 8 as u64), 0, 0)
    let before: i64 = chan(&cv, 20, 20, 16 as u32)
    canvas.canvas_clear(&cv, 4294967295 as u32)
    effect.keep_put(&kp, &z, 0.0, 0.0, 64.0, 64.0)
    report("11 keep: the band comes back", chan(&cv, 20, 20, 16 as u32) == before,
        chan(&cv, 20, 20, 16 as u32), before)
    report("11 keep: outside the band still the new white", chan(&cv, 100, 100, 16 as u32) == 255,
        chan(&cv, 100, 100, 16 as u32), 255)
    effect.keep_put(&kp, &z, 0.0, 0.0, 128.0, 128.0)
    report("11 keep: the whole canvas comes back", chan(&cv, 120, 120, 0 as u32) > 10,
        chan(&cv, 120, 120, 0 as u32), 10)

    say("\n== 12. SHAPES AT THE PRICE OF A FILL ==\n")
    // the fast round rectangle against the rasterised one
    var cv2: canvas.Canvas = canvas.canvas_new()
    let okc: bool = canvas.canvas_init(&cv2, 128, 128)
    var z2: painter.Painter = painter.painter_new()
    let okz: bool = painter.painter_init(&z2, &cv2, 128, 128)
    report("12 second canvas", okc && okz, 1, 1)
    canvas.canvas_clear(&cv, 4294967295 as u32)
    canvas.canvas_clear(&cv2, 4294967295 as u32)
    painter.round_rect(&z, 10.3, 12.6, 70.5, 33.2, 11.0, BLACK as u32)
    effect.rrect_fast(&z2, 10.3, 12.6, 70.5, 33.2, 11.0, BLACK as u32, BLACK as u32)
    var worst: i64 = 0
    var off: i64 = 0
    var yy: usize = 0
    while yy < 64 {
        var xx: usize = 0
        while xx < 96 {
            let dd: i64 = abs_i(chan(&cv, xx, yy, 8 as u32) - chan(&cv2, xx, yy, 8 as u32))
            if dd > worst { worst = dd }
            if dd > 8 { off = off + 1 }
            xx = xx + 1
        }
        yy = yy + 1
    }
    // round_rect flattens its cubic arc into chords, which lie a little
    // INSIDE the circle; rrect_fast takes the exact area under the
    // tangent of the true arc. The two meet within a few levels, the
    // straight edges exactly.
    report("12 rrect_fast: no pixel more than 16 levels off round_rect", worst <= 16, worst, 16)
    report("12 rrect_fast: at most 40 arc pixels more than 8 levels off", off <= 40, off, 40)
    report("12 rrect_fast: the inside is black", chan(&cv2, 40, 30, 8 as u32) == 0, chan(&cv2, 40, 30, 8 as u32), 0)
    report("12 rrect_fast: the corner stays light", chan(&cv2, 10, 12, 8 as u32) >= 200, chan(&cv2, 10, 12, 8 as u32), 200)
    report("12 rrect_fast: straight edge = overlap (x=10: 0.7 covered)",
        abs_i(chan(&cv2, 10, 30, 8 as u32) - 77) <= 1, chan(&cv2, 10, 30, 8 as u32), 77)
    // a ramp from red to blue
    canvas.canvas_clear(&cv2, 4294967295 as u32)
    effect.rrect_fast(&z2, 0.0, 0.0, 64.0, 64.0, 8.0, 4294901760 as u32, 4278190335 as u32)
    report("12 rrect_fast gradient: red at the top", chan(&cv2, 32, 1, 16 as u32) > 240, chan(&cv2, 32, 1, 16 as u32), 240)
    report("12 rrect_fast gradient: blue at the bottom", chan(&cv2, 32, 62, 0 as u32) > 240, chan(&cv2, 32, 62, 0 as u32), 240)
    // the clip holds for the fast shapes: only the left half is painted
    canvas.canvas_clear(&cv2, 4294967295 as u32)
    let pushed: bool = canvas.clip_push_rect(&cv2, 0.0, 0.0, 32.0, 128.0)
    effect.rrect_fast(&z2, 8.0, 8.0, 48.0, 48.0, 6.0, BLACK as u32, BLACK as u32)
    effect.veil_rect(&z2, 0.0, 80.0, 128.0, 10.0, 2147483648 as u32)
    canvas.clip_pop(&cv2)
    report("12 clip: inside the clip painted", pushed && chan(&cv2, 20, 30, 8 as u32) == 0,
        chan(&cv2, 20, 30, 8 as u32), 0)
    report("12 clip: outside the clip untouched (shape)", chan(&cv2, 40, 30, 8 as u32) == 255,
        chan(&cv2, 40, 30, 8 as u32), 255)
    report("12 clip: outside the clip untouched (veil)", chan(&cv2, 40, 85, 8 as u32) == 255,
        chan(&cv2, 40, 85, 8 as u32), 255)
    // the shadow of a card
    canvas.canvas_clear(&cv2, 4294967295 as u32)
    effect.rrect_shadow(&z2, 20.0, 20.0, 60.0, 30.0, 10.0, 3.0, 8.0, 2147483648 as u32)
    report("12 shadow: just below the card it is darker", chan(&cv2, 50, 52, 8 as u32) < 200, chan(&cv2, 50, 52, 8 as u32), 200)
    report("12 shadow: far away it is white", chan(&cv2, 50, 100, 8 as u32) == 255, chan(&cv2, 50, 100, 8 as u32), 255)
    report("12 shadow: deep under the card nothing was painted", chan(&cv2, 50, 35, 8 as u32) == 255, chan(&cv2, 50, 35, 8 as u32), 255)
    report("12 shadow: opaque", alpha(&cv2, 50, 52) == 255, alpha(&cv2, 50, 52), 255)
    // a ramp of shade, strongest at the top
    canvas.canvas_clear(&cv2, 4294967295 as u32)
    effect.ramp_rect(&z2, 0.0, 0.0, 128.0, 20.0, BLACK as u32, 0 as u32)
    report("12 ramp: dark at its strong end", chan(&cv2, 5, 0, 8 as u32) < 30, chan(&cv2, 5, 0, 8 as u32), 30)
    report("12 ramp: runs out", chan(&cv2, 5, 19, 8 as u32) > 250 && chan(&cv2, 5, 25, 8 as u32) == 255,
        chan(&cv2, 5, 19, 8 as u32), 250)
    // shift rows: a black row at 30 moves to 35 and to 25
    canvas.canvas_clear(&cv2, 4294967295 as u32)
    painter.surface(&z2, 0.0, 30.0, 128.0, 1.0, BLACK as u32)
    effect.shift_rows(&z2, 0, 64, 10, 100, 5)
    report("12 shift down: the row is at 35", chan(&cv2, 20, 35, 8 as u32) == 0, chan(&cv2, 20, 35, 8 as u32), 0)
    report("12 shift down: outside the columns it stays at 30", chan(&cv2, 100, 30, 8 as u32) == 0 && chan(&cv2, 100, 35, 8 as u32) == 255,
        chan(&cv2, 100, 35, 8 as u32), 255)
    effect.shift_rows(&z2, 0, 64, 10, 100, 0 - 10)
    report("12 shift up: the row is at 25", chan(&cv2, 20, 25, 8 as u32) == 0 && chan(&cv2, 20, 35, 8 as u32) == 255,
        chan(&cv2, 20, 25, 8 as u32), 0)

    // ---- the sheet
    if rt.arg_count(start) >= 2 {
        let cols: i64 = 12
        let cell: i64 = 64
        let rows: i64 = (lucide.LUCIDE_N + cols - 1) / cols
        let sw: usize = (cols * cell) as usize
        let sh: usize = (rows * cell) as usize
        var sc: canvas.Canvas = canvas.canvas_new()
        if !canvas.canvas_init(&sc, sw, sh) {
            return 4
        }
        canvas.canvas_clear(&sc, 4294572537 as u32)
        var sz: painter.Painter = painter.painter_new()
        if !painter.painter_init(&sz, &sc, sw, sh) {
            return 4
        }
        var k: i64 = 0
        while k < lucide.LUCIDE_N {
            let cx: f64 = ((k % cols) * cell) as f64
            let cy: f64 = ((k / cols) * cell) as f64
            icons.icon(&sz, k, cx + 4.0, cy + 4.0, 16.0, 4280427042 as u32)
            icons.icon(&sz, k, cx + 24.0, cy + 4.0, 24.0, 4280427042 as u32)
            icons.icon(&sz, k, cx + 8.0, cy + 30.0, 32.0, 4278214879 as u32)
            k = k + 1
        }
        var out: mem.Buf = mem.buf_new()
        mem.buf_init(&out)
        if !png.write_png(&sc, &out) {
            return 5
        }
        if !rt.write_file(rt.arg_ptr(start, 1), mem.buf_ptr(&out) as u64,
            mem.buf_len(&out)) {
            return 6
        }
        say("\nsheet written\n")
    }

    if G_ERRORS > 0 {
        say("\nICONS: WRONG\n")
        return 1
    }
    say("\nICONS: ALL OK\n")
    return 0
}
