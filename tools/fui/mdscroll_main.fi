import std.rt
import paint.canvas
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.mdedit
import fui.kitcolor
import plat.sysfont

static mut BAD: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn long_text(m: *mut mdedit.MdEd) {
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < 80 {
        rt.buf_push_bytes(&b, "Line of text number\n\n".p as u64, 21)
        i = i + 1
    }
    mdedit.set_text(m, str { p: rt.buf_ptr(&b) as *mut u8, n: rt.buf_len(&b) })
}

fn draw(c: *mut render.Ctx, m: *mut mdedit.MdEd) {
    mdedit.editor_draw(c, m, 0.0, 0.0, 360.0, 700.0)
    mdedit.preview_draw(c, m, 0.0, 0.0, 360.0, 700.0)
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("mdscroll: no font\n")
        return 9
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    var z: painter.Painter = painter.painter_new()
    if !canvas.canvas_init(&cv, 360, 700) || !painter.painter_init(&z, &cv, 360, 700) { return 10 }
    painter.painter_set_font(&z, fs as u64)
    var th: theme.Theme = theme.theme_new(true)
    kitcolor.kit_theme(&th, true)
    let c: render.Ctx = render.ctx_new(&th, &z)
    let m: *mut mdedit.MdEd = mdedit.new()
    long_text(m)
    draw(&c, m)
    check(mdedit.editor_scroll(m) == 0.0 && mdedit.preview_scroll(m) == 0.0, "both start at the top")
    mdedit.wheel_editor(m, 3.0)
    draw(&c, m)
    let w1: f64 = mdedit.editor_scroll(m)
    check(w1 > 0.0, "wheel scrolls the editor")
    mdedit.pan_editor(m, 0.0 - 100.0)
    let w2: f64 = mdedit.editor_scroll(m)
    check(w2 == w1 + 100.0, "dragging the editor up by 100 px scrolls it 100 px down")
    mdedit.pan_editor(m, 100000.0)
    check(mdedit.editor_scroll(m) == 0.0, "dragging far down stops at the top")
    mdedit.wheel_preview(m, 3.0)
    draw(&c, m)
    let p1: f64 = mdedit.preview_scroll(m)
    check(p1 > 0.0, "wheel scrolls the preview")
    mdedit.pan_preview(m, 0.0 - 80.0)
    draw(&c, m)
    check(mdedit.preview_scroll(m) == p1 + 80.0, "dragging the preview up by 80 px scrolls it 80 px down")
    mdedit.pan_preview(m, 100000.0)
    draw(&c, m)
    check(mdedit.preview_scroll(m) == 0.0, "dragging far down stops at the top of the preview")
    if BAD == 0 {
        say("MDSCROLL PASSED\n")
        return 0
    }
    say("MDSCROLL FAILED\n")
    return 1
}
