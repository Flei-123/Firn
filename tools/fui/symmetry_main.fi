// SPDX-License-Identifier: MPL-2.0
// tools/fui/symmetry_main.fi -- EVERY FRAME IS SYMMETRICAL.
//
// ====================================================== WHY IT EXISTS
//
// On 10.09.2026 Justin re-measured the focus ring in the image and found an
// asymmetry that had survived all 81 existing checks:
//
//     upper edge  y=52..57  -> 6 rows thick
//     lower edge  y=80..81  -> 2 rows thick
//     top right up to x=661, the sides only up to x=659
//
// The cause lay in `painter.path_round_ccw`: the inner path of the
// ring had swapped control points and a segment that ended on
// its own start. Compiled cleanly, ran cleanly, looked ALMOST right --
// and that is exactly the dangerous sort.
//
// THE SAME SORT OF ERROR COST US TWO ROUNDS WITH THE CLOSE CROSS
// (see capicon_main.fi). Twice is enough: from now on
// a check COUNTS the edge thicknesses instead of looking at them.
//
// ========================================================== WHAT IT DOES
//
// It paints frames and rings in several sizes, radii and
// stroke widths and measures at each of the four edges HOW THICK it is:
//
//   * top == bottom     (the error that Justin found)
//   * left == right
//   * the thickness is the ORDERED stroke width
//   * no overhang: the outermost painted column at the top is
//     the same as at the side
//
// Measured is in the MIDDLE of each edge, far away from the roundings
// -- there the thickness is unambiguous, whereas in the corner it naturally
// increases.
import std.rt
import paint.canvas
import fui.painter

const W: usize = 300
const H: usize = 200

static mut G_FAIL: usize = 0

fn say(nm: u64, nn: usize, ok: bool, got: i64, want: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "FAILED  "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_FAIL = G_FAIL + 1
    }
    var h1: [u8; 5] = " got "
    rt.buf_push_bytes(&t, (&h1[0]) as u64, 5)
    rt.buf_push_dec_i64(&t, got)
    var h2: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&h2[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, want)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn is_set(cv: *mut canvas.Canvas, x: usize, y: usize) -> bool {
    return (canvas.canvas_get(cv, x, y) & 16777215 as u32) != 0 as u32
}

// How many set pixels lie vertically downwards from (x, y)
// before the first gap comes? That is the thickness of the upper edge.
fn thick_down(cv: *mut canvas.Canvas, x: usize, y0: usize,
    limit: usize) -> i64 {
    var n: i64 = 0
    var y: usize = y0
    while y < y0 + limit {
        if !is_set(cv, x, y) {
            return n
        }
        n = n + 1
        y = y + 1
    }
    return n
}

fn thick_up(cv: *mut canvas.Canvas, x: usize, y0: usize,
    limit: usize) -> i64 {
    var n: i64 = 0
    var y: usize = y0
    while n < (limit as i64) {
        if !is_set(cv, x, y) {
            return n
        }
        n = n + 1
        if y == 0 {
            return n
        }
        y = y - 1
    }
    return n
}

fn thick_right(cv: *mut canvas.Canvas, x0: usize, y: usize,
    limit: usize) -> i64 {
    var n: i64 = 0
    var x: usize = x0
    while x < x0 + limit {
        if !is_set(cv, x, y) {
            return n
        }
        n = n + 1
        x = x + 1
    }
    return n
}

fn thick_left(cv: *mut canvas.Canvas, x0: usize, y: usize,
    limit: usize) -> i64 {
    var n: i64 = 0
    var x: usize = x0
    while n < (limit as i64) {
        if !is_set(cv, x, y) {
            return n
        }
        n = n + 1
        if x == 0 {
            return n
        }
        x = x - 1
    }
    return n
}

// The outermost set column in a row -- as proof
// that the top does not reach further right than the side.
fn last_col(cv: *mut canvas.Canvas, y: usize, x0: usize,
    x1: usize) -> i64 {
    var r: i64 = -1
    var x: usize = x0
    while x < x1 {
        if is_set(cv, x, y) {
            r = x as i64
        }
        x = x + 1
    }
    return r
}

fn first_col(cv: *mut canvas.Canvas, y: usize, x0: usize,
    x1: usize) -> i64 {
    var x: usize = x0
    while x < x1 {
        if is_set(cv, x, y) {
            return x as i64
        }
        x = x + 1
    }
    return -1
}

// ONE RING, FOUR EDGES. The core of this check.
//
// `bx/by/bw/bh` is the rectangle, `r` the radius, `st` the
// stroke width. Checked is in the middle of each edge.
fn check_ring(cv: *mut canvas.Canvas, z: *mut painter.Painter,
    bx: f64, by: f64, bw: f64, bh: f64, r: f64, st: f64,
    nm: u64, nn: usize) {
    canvas.canvas_clear(cv, 4278190080 as u32)
    painter.round_ring(z, bx, by, bw, bh, r, st, 16777215 as u32)

    let cx: usize = (bx + bw / 2.0) as usize
    let cy: usize = (by + bh / 2.0) as usize
    let want: i64 = (st + 0.5) as i64

    // --- top and bottom, measured in the middle of the edge
    let top: i64 = thick_down(cv, cx, by as usize, 20)
    let bot: i64 = thick_up(cv, cx, (by + bh) as usize - 1, 20)
    // --- left and right
    let lef: i64 = thick_right(cv, bx as usize, cy, 20)
    let rig: i64 = thick_left(cv, (bx + bw) as usize - 1, cy, 20)

    var t1: [u8; 24] = "  oben == unten         "
    var b1: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b1, nm, nn)
    rt.buf_push_bytes(&b1, (&t1[0]) as u64, 24)
    say(rt.buf_ptr(&b1), rt.buf_len(&b1), top == bot, top, bot)
    rt.buf_free(&b1)

    var t2: [u8; 24] = "  links == rechts       "
    var b2: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b2, nm, nn)
    rt.buf_push_bytes(&b2, (&t2[0]) as u64, 24)
    say(rt.buf_ptr(&b2), rt.buf_len(&b2), lef == rig, lef, rig)
    rt.buf_free(&b2)

    var t3: [u8; 24] = "  Dicke == Strichstaerke"
    var b3: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b3, nm, nn)
    rt.buf_push_bytes(&b3, (&t3[0]) as u64, 24)
    say(rt.buf_ptr(&b3), rt.buf_len(&b3), top == want, top, want)
    rt.buf_free(&b3)

    // --- NO OVERHANG.
    //
    // Exactly Justin's point (b): the upper edge reached to the right as far as
    // x=661, the side edge only to x=659. The outermost column
    // of the upper edge must not lie further right than that of the
    // side edge.
    let top_r: i64 = last_col(cv, (by as usize) + 1,
        bx as usize, (bx + bw) as usize + 4)
    let side_r: i64 = last_col(cv, cy, bx as usize,
        (bx + bw) as usize + 4)
    var t4: [u8; 24] = "  kein Ueberstand rechts"
    var b4: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b4, nm, nn)
    rt.buf_push_bytes(&b4, (&t4[0]) as u64, 24)
    say(rt.buf_ptr(&b4), rt.buf_len(&b4), top_r <= side_r, top_r,
        side_r)
    rt.buf_free(&b4)

    let top_l: i64 = first_col(cv, (by as usize) + 1,
        bx as usize - 4, (bx + bw) as usize)
    let side_l: i64 = first_col(cv, cy, bx as usize - 4,
        (bx + bw) as usize)
    var t5: [u8; 24] = "  kein Ueberstand links "
    var b5: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b5, nm, nn)
    rt.buf_push_bytes(&b5, (&t5[0]) as u64, 24)
    say(rt.buf_ptr(&b5), rt.buf_len(&b5), top_l >= side_l, top_l,
        side_l)
    rt.buf_free(&b5)
}

// THE MIRROR TEST. It catches every asymmetry, also the ones nobody
// thought of: the image must be mirrorable horizontally AND vertically
// if the rectangle itself is symmetrical.
fn check_mirror(cv: *mut canvas.Canvas, z: *mut painter.Painter,
    bx: f64, by: f64, bw: f64, bh: f64, r: f64, st: f64,
    nm: u64, nn: usize) {
    canvas.canvas_clear(cv, 4278190080 as u32)
    painter.round_ring(z, bx, by, bw, bh, r, st, 16777215 as u32)
    let x0: usize = bx as usize
    let y0: usize = by as usize
    let iw: usize = bw as usize
    let ih: usize = bh as usize

    var diff_v: i64 = 0
    var diff_h: i64 = 0
    var j: usize = 0
    while j < ih {
        var i: usize = 0
        while i < iw {
            let a: u32 = canvas.canvas_get(cv, x0 + i, y0 + j)
            &16777215 as u32
            // senkrecht gespiegelt (oben <-> unten)
            let bv: u32 = canvas.canvas_get(cv, x0 + i,
                y0 + ih - 1 - j) & 16777215 as u32
            // waagerecht gespiegelt (links <-> rechts)
            let bh2: u32 = canvas.canvas_get(cv, x0 + iw - 1 - i,
                y0 + j) & 16777215 as u32
            if a != bv {
                diff_v = diff_v + 1
            }
            if a != bh2 {
                diff_h = diff_h + 1
            }
            i = i + 1
        }
        j = j + 1
    }
    var t1: [u8; 24] = "  Spiegel oben/unten    "
    var b1: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b1, nm, nn)
    rt.buf_push_bytes(&b1, (&t1[0]) as u64, 24)
    say(rt.buf_ptr(&b1), rt.buf_len(&b1), diff_v == 0, diff_v, 0)
    rt.buf_free(&b1)

    var t2: [u8; 24] = "  Spiegel links/rechts  "
    var b2: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b2, nm, nn)
    rt.buf_push_bytes(&b2, (&t2[0]) as u64, 24)
    say(rt.buf_ptr(&b2), rt.buf_len(&b2), diff_h == 0, diff_h, 0)
    rt.buf_free(&b2)
}

fn main(start: u64) -> i32 {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 2
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, H) {
        return 3
    }

    // ==================================================================
    // 1. THE CASE THAT JUSTIN FOUND
    // ==================================================================
    //
    // A button of 150 x 32 with radius 8 and focus ring 2 -- exactly the
    // dimensions of the showcase page.
    var n1: [u8; 16] = "1 Fokusring 2px "
    check_ring(&cv, &z, 40.0, 40.0, 150.0, 32.0, 8.0, 2.0,
        (&n1[0]) as u64, 16)
    check_mirror(&cv, &z, 40.0, 40.0, 150.0, 32.0, 8.0, 2.0,
        (&n1[0]) as u64, 16)

    // ==================================================================
    // 2. THE SAME CHECK AT OTHER DIMENSIONS
    // ==================================================================
    //
    // An error in the rounding shows at one radius differently than at
    // the next. So several -- and expressly also radius 0
    // (shape_classic) and a radius that touches half the height.
    var n2: [u8; 16] = "2 Radius 0      "
    check_ring(&cv, &z, 40.0, 40.0, 120.0, 40.0, 0.0, 2.0,
        (&n2[0]) as u64, 16)
    check_mirror(&cv, &z, 40.0, 40.0, 120.0, 40.0, 0.0, 2.0,
        (&n2[0]) as u64, 16)

    var n3: [u8; 16] = "3 Radius 6 st 1 "
    check_ring(&cv, &z, 40.0, 40.0, 120.0, 40.0, 6.0, 1.0,
        (&n3[0]) as u64, 16)
    check_mirror(&cv, &z, 40.0, 40.0, 120.0, 40.0, 6.0, 1.0,
        (&n3[0]) as u64, 16)

    var n4: [u8; 16] = "4 Radius 12 st 3"
    check_ring(&cv, &z, 40.0, 40.0, 140.0, 60.0, 12.0, 3.0,
        (&n4[0]) as u64, 16)
    check_mirror(&cv, &z, 40.0, 40.0, 140.0, 60.0, 12.0, 3.0,
        (&n4[0]) as u64, 16)

    // Radius = halbe Hoehe: die Rundung stoesst an ihre Grenze.
    var n5: [u8; 16] = "5 Radius = h/2  "
    check_ring(&cv, &z, 40.0, 40.0, 120.0, 40.0, 20.0, 2.0,
        (&n5[0]) as u64, 16)
    check_mirror(&cv, &z, 40.0, 40.0, 120.0, 40.0, 20.0, 2.0,
        (&n5[0]) as u64, 16)

    // A SQUARE -- here the diagonal must in addition be right.
    var n6: [u8; 16] = "6 Quadrat r=10  "
    check_ring(&cv, &z, 40.0, 40.0, 60.0, 60.0, 10.0, 2.0,
        (&n6[0]) as u64, 16)
    check_mirror(&cv, &z, 40.0, 40.0, 60.0, 60.0, 10.0, 2.0,
        (&n6[0]) as u64, 16)

    // ==================================================================
    // 3. THE FILLED AREA IS JUST AS SYMMETRICAL
    // ==================================================================
    //
    // `round_rect` uses only the outer path. If THAT broke, the ring
    // would not necessarily find it -- so here separately.
    canvas.canvas_clear(&cv, 4278190080 as u32)
    painter.round_rect(&z, 40.0, 40.0, 120.0, 40.0, 10.0,
        16777215 as u32)
    var dv: i64 = 0
    var dh: i64 = 0
    var j: usize = 0
    while j < 40 {
        var i: usize = 0
        while i < 120 {
            let a: u32 = canvas.canvas_get(&cv, 40 + i, 40 + j)
            &16777215 as u32
            let bv: u32 = canvas.canvas_get(&cv, 40 + i, 79 - j)
            &16777215 as u32
            let bh2: u32 = canvas.canvas_get(&cv, 159 - i, 40 + j)
            &16777215 as u32
            if a != bv {
                dv = dv + 1
            }
            if a != bh2 {
                dh = dh + 1
            }
            i = i + 1
        }
        j = j + 1
    }
    var m1: [u8; 40] = "7 Flaeche Spiegel oben/unten            "
    say((&m1[0]) as u64, 40, dv == 0, dv, 0)
    var m2: [u8; 40] = "7 Flaeche Spiegel links/rechts          "
    say((&m2[0]) as u64, 40, dh == 0, dh, 0)

    if G_FAIL == 0 {
        var g: [u8; 22] = "\nSYMMETRIE BESTANDEN.\n"
        rt.write_everything(1, (&g[0]) as u64, 22)
        return 0
    }
    var b: [u8; 24] = "\nSYMMETRIE GESCHEITERT.\n"
    rt.write_everything(2, (&b[0]) as u64, 24)
    return 1
}
