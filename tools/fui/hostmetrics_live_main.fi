// SPDX-License-Identifier: MPL-2.0
// tools/fui/hostmetrics_live_main.fi -- W44-c: THE HOST METRICS IN A REAL WINDOW (X11; needs $DISPLAY, tools/fui/hostmetrics.sh runs it on an
// own Xvfb). Opens a window, opts in like app.follow_host does (fuiwin.window_follow_*), runs window_system_look and prints ONE line:
//     HOSTMETRICS text=<per mille of the theme> ins=<l>,<t>,<r>,<b> called=<0|1>
// Switches: FUI_TEXT_SCALE=1.25|125, FUI_INSETS=l,t,r,b (override); otherwise gsettings / _NET_WORKAREA.
import std.rt
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.scene
import fui.flex
import plat.fuiwirt
import plat.fuiwin
import plat.sysfont
import plat.envvar
import window.window

static mut G_CALLED: bool = false
static mut G_L: f64 = 0.0
static mut G_T: f64 = 0.0
static mut G_R: f64 = 0.0
static mut G_B: f64 = 0.0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn put_i(v: i64) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, v)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

fn got(ud: u64, l: f64, t: f64, r: f64, b: f64) {
    G_CALLED = true
    G_L = l
    G_T = t
    G_R = r
    G_B = b
}

fn main() -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("hostmetrics_live: no font\n")
        return 9
    }
    var fx: fuiwin.Window = fuiwin.window_new()
    fuiwin.window_set_font(&fx, fs as u64)
    fuiwin.window_set_gpu(&fx, false)
    var m: theme.Theme = theme.theme_new(false)
    var sc: scene.Scene = scene.scene_new()
    var c: render.Ctx = render.ctx_new(&m, fuiwin.window_painter(&fx))
    var w: fuiwirt.Host = fuiwirt.host_new(&sc, &c)
    let root: usize = scene.scene_box(&sc, scene.SCENE_NONE, 0 as u32, flex.FLEX_COLUMN, flex.JUSTIFY_CENTER, flex.AL_CENTER)
    fuiwirt.host_bind(&w)
    let t: str = "hostmetrics"
    // FUI_LIVE_W: the window width (W47-b: a wide window at 0,0 has its centre on the second monitor -- no window manager moves it)
    var ww: usize = 200
    if envvar.env_has("FUI_LIVE_W") && envvar.env_value_i64("FUI_LIVE_W") > 0 {
        ww = envvar.env_value_i64("FUI_LIVE_W") as usize
    }
    if !fuiwin.window_open(&fx, &w, &m, 0, ww, 120, t.p as u64, t.n) {
        say("hostmetrics_live: no window\n")
        return 1
    }
    fuiwin.window_follow_text_scale(&fx, true)
    fuiwin.window_follow_insets(&fx, 0, got)
    fuiwin.window_system_look(&fx, &m)
    // diagnostics (the test greps only the HOSTMETRICS line): where the window really is
    var dox: i64 = 0
    var doy: i64 = 0
    if window.origin(&fx.f, &dox, &doy) {
        say("HOSTRECT ")
        put_i(dox)
        say(",")
        put_i(doy)
        say(" ")
        put_i(window.width(&fx.f) as i64)
        say("x")
        put_i(window.height(&fx.f) as i64)
        say("\n")
    }
    say("HOSTMETRICS text=")
    put_i(theme.theme_text_scale(&m) as i64)
    say(" ins=")
    put_i(G_L as i64)
    say(",")
    put_i(G_T as i64)
    say(",")
    put_i(G_R as i64)
    say(",")
    put_i(G_B as i64)
    say(" called=")
    if G_CALLED { say("1") } else { say("0") }
    say("\n")
    fuiwin.window_close(&fx)
    return 0
}
