// SPDX-License-Identifier: MPL-2.0
// tools/fui/gsubctx_main.fi -- GSUB context lookups (type 5 and 6) and
// multiple substitution (type 2) of lib/font/gsub.fi against rules read
// from real fonts with fontTools.
//
// Every case is a glyph sequence BUILT FROM A RULE of the font (so it must
// match) plus the answer of a small reference matcher written in Python;
// the records must come back identical. Fonts that are not installed are
// skipped and said so. DejaVu Sans: the two ccmp chaining lookups (class
// format, with backtrack and lookahead) and the skip of absorbed positions.
import std.rt
import font.ttf
import font.gsub
import fui.shape
import fui.painter
import font.metrics
import paint.canvas
import str.ucd_bidi

static mut G_ERRORS: usize = 0
static mut G_CHECKS: usize = 0
static mut G_SKIPPED: usize = 0

fn say(id: i64, got: i64, want: i64) {
    G_CHECKS = G_CHECKS + 1
    var t: rt.Buf = rt.buf_new()
    var okk: [u8; 8] = "ok   #  "
    var bad: [u8; 8] = "FAIL #  "
    if got == want {
        rt.buf_push_bytes(&t, (&okk[0]) as u64, 8)
    } else {
        G_ERRORS = G_ERRORS + 1
        rt.buf_push_bytes(&t, (&bad[0]) as u64, 8)
    }
    rt.buf_push_dec_i64(&t, id)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, got)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, want)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn w32(p: u64, i: usize, v: u32) { *((p + (i * 4) as u64) as *mut u32) = v }
fn r32(p: u64, i: usize) -> u32 { return *((p + (i * 4) as u64) as *mut u32) }
fn w8(p: u64, i: usize, v: u8) { *((p + i as u64) as *mut u8) = v }
fn r8(p: u64, i: usize) -> u8 { return *((p + i as u64) as *mut u8) }

// The sequence a b c ... in `ids` (up to 4 glyphs, 0 = unused after n).
fn fill(ids: u64, skip: u64, a: u32, b: u32, c: u32, n: usize) {
    w32(ids, 0, a)
    w32(ids, 1, b)
    w32(ids, 2, c)
    var i: usize = 0
    while i < 4 {
        *((skip + i as u64) as *mut u8) = 0 as u8
        i = i + 1
    }
}

// One question: lookup `li` at `at`; expected record count `nr` and the
// first record (pos, lookup).
fn ask(id: i64, f: *mut ttf.Font, gs: *mut gsub.Gsub, li: u32, ids: u64,
    skip: u64, n: usize, at: usize, nr: usize, pos0: usize, li0: u32,
    pos1: usize, li1: u32) {
    let c: usize = gsub.gsub_context_li(f, gs, li, ids, skip, n, at)
    say(id * 10, c as i64, nr as i64)
    if nr >= 1 && c >= 1 {
        say(id * 10 + 1, gsub.gsub_act_pos(gs, 0) as i64, pos0 as i64)
        say(id * 10 + 2, gsub.gsub_act_lookup(gs, 0) as i64, li0 as i64)
    }
    if nr >= 2 && c >= 2 {
        say(id * 10 + 3, gsub.gsub_act_pos(gs, 1) as i64, pos1 as i64)
        say(id * 10 + 4, gsub.gsub_act_lookup(gs, 1) as i64, li1 as i64)
    }
}

fn load(path: u64, buf: *mut rt.Buf, f: *mut ttf.Font,
    gs: *mut gsub.Gsub) -> bool {
    if !rt.read_file(path, buf) {
        return false
    }
    *f = ttf.font_new()
    if !ttf.font_init(f, (*buf).ptr as *mut u8, (*buf).len) {
        return false
    }
    return gsub.gsub_open(f, gs)
}

fn main() -> i32 {
    let ids: u64 = rt.heap_alloc(64)
    let skip: u64 = rt.heap_alloc(16)
    var gs: gsub.Gsub = gsub.gsub_new()

    // ------------------------------------------------------ DejaVu Sans
    var p1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
    var b1: rt.Buf = rt.buf_new()
    var f1: ttf.Font = ttf.font_new()
    if load((&p1[0]) as u64, &b1, &f1, &gs) {
        // lookup 2: Hebrew ayin 1337 + vowel 1297 (class 2) -> lookup 31
        fill(ids, skip, 1337 as u32, 1297 as u32, 0 as u32, 2)
        ask(1, &f1, &gs, 2 as u32, ids, skip, 2, 0, 1, 0, 31 as u32, 0, 0 as u32)
        // ayin + ayin: lookahead is class 1, not 2 -> no rule
        fill(ids, skip, 1337 as u32, 1337 as u32, 0 as u32, 2)
        ask(2, &f1, &gs, 2 as u32, ids, skip, 2, 0, 0, 0, 0 as u32, 0, 0 as u32)
        // ayin, ABSORBED glyph, vowel: the middle one does not count
        fill(ids, skip, 1337 as u32, 679 as u32, 1297 as u32, 3)
        *((skip + 1 as u64) as *mut u8) = 1 as u8
        ask(3, &f1, &gs, 2 as u32, ids, skip, 3, 0, 1, 0, 31 as u32, 0, 0 as u32)
        // ... and without the skip it does count -> no rule
        *((skip + 1 as u64) as *mut u8) = 0 as u8
        ask(4, &f1, &gs, 2 as u32, ids, skip, 3, 0, 0, 0, 0 as u32, 0, 0 as u32)
        // lookup 4, tone letters: 679 679 (class 1, lookahead class 1) -> 34
        fill(ids, skip, 679 as u32, 679 as u32, 0 as u32, 2)
        ask(5, &f1, &gs, 4 as u32, ids, skip, 2, 0, 1, 0, 34 as u32, 0, 0 as u32)
        // ... last one has no lookahead -> no rule
        ask(6, &f1, &gs, 4 as u32, ids, skip, 2, 1, 0, 0, 0 as u32, 0, 0 as u32)
        // 679 680: the second subtable fits -> 35
        fill(ids, skip, 679 as u32, 680 as u32, 0 as u32, 2)
        ask(7, &f1, &gs, 4 as u32, ids, skip, 2, 0, 1, 0, 35 as u32, 0, 0 as u32)
        // BACKTRACK: 4946 (680 with a number) then 679 -> lookup 39 at 1
        fill(ids, skip, 4946 as u32, 679 as u32, 0 as u32, 2)
        ask(8, &f1, &gs, 4 as u32, ids, skip, 2, 1, 1, 1, 39 as u32, 0, 0 as u32)
        // ... if the backtrack glyph is absorbed there is nothing behind it
        *((skip + 0 as u64) as *mut u8) = 1 as u8
        ask(9, &f1, &gs, 4 as u32, ids, skip, 2, 1, 0, 0, 0 as u32, 0, 0 as u32)
        *((skip + 0 as u64) as *mut u8) = 0 as u8
        // the nested lookups really change the glyph
        say(100, gsub.gsub_li_single(&f1, &gs, 31 as u32, 1337 as u32) as i64, 5056)
        say(101, gsub.gsub_li_single(&f1, &gs, 34 as u32, 679 as u32) as i64, 4945)
        say(102, gsub.gsub_li_single(&f1, &gs, 39 as u32, 679 as u32) as i64, 4970)
        say(103, gsub.gsub_li_type(&f1, &gs, 2 as u32) as i64, 6)
        // the arab list now holds ccmp: 2 and 4 come first
        var ga: gsub.Gsub = gsub.gsub_new()
        let has: bool = gsub.gsub_init(&f1, &ga)
        say(110, gsub.gsub_count(&ga) as i64, 10)
        say(111, gsub.gsub_lookup_index(&ga, 0) as i64, 2)
        say(112, (gsub.gsub_lookup_mask(&ga, 0) & gsub.F_CCMP) as i64, 128)
        say(113, gsub.gsub_lookup_type(&f1, &ga, 1) as i64, 6)
        fill(ids, skip, 679 as u32, 679 as u32, 0 as u32, 2)
        let nk: usize = gsub.gsub_context(&f1, &ga, 1, ids, skip, 2, 0)
        say(114, nk as i64, 1)
    } else {
        G_SKIPPED = G_SKIPPED + 1
    }

    // ------------------------------------------- Noto Sans Mono Bold
    // lookup 3: chaining context format 3 (coverages); lookup 7: multiple
    var p2: [u8; 56] = "/usr/share/fonts/truetype/noto/NotoSansMono-Bold.ttf\0\0\0\0"
    var b2: rt.Buf = rt.buf_new()
    var f2: ttf.Font = ttf.font_new()
    if load((&p2[0]) as u64, &b2, &f2, &gs) {
        fill(ids, skip, 76 as u32, 1213 as u32, 0 as u32, 2)
        ask(20, &f2, &gs, 3 as u32, ids, skip, 2, 0, 1, 0, 4 as u32, 0, 0 as u32)
        // a glyph the rule does not name in place of the second
        fill(ids, skip, 76 as u32, 3 as u32, 0 as u32, 2)
        ask(21, &f2, &gs, 3 as u32, ids, skip, 2, 0, 0, 0, 0 as u32, 0, 0 as u32)
    } else {
        G_SKIPPED = G_SKIPPED + 1
    }

    // --------------------------------------------- Noto Color Emoji
    // lookup 2: chaining class format; lookup 4: context class format (5)
    var p3: [u8; 50] = "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf\0"
    var b3: rt.Buf = rt.buf_new()
    var f3: ttf.Font = ttf.font_new()
    if load((&p3[0]) as u64, &b3, &f3, &gs) {
        fill(ids, skip, 481 as u32, 1430 as u32, 0 as u32, 2)
        ask(30, &f3, &gs, 2 as u32, ids, skip, 2, 1, 1, 1, 1 as u32, 0, 0 as u32)
        fill(ids, skip, 205 as u32, 205 as u32, 0 as u32, 2)
        ask(31, &f3, &gs, 4 as u32, ids, skip, 2, 0, 2, 0, 5 as u32, 1, 1 as u32)
    } else {
        G_SKIPPED = G_SKIPPED + 1
    }

    // ------------------------------------------ FreeSerif Bold Italic
    // lookup 4: chaining context format 1 (glyph lists)
    var p4: [u8; 59] = "/usr/share/fonts/truetype/freefont/FreeSerifBoldItalic.ttf\0"
    var b4: rt.Buf = rt.buf_new()
    var f4: ttf.Font = ttf.font_new()
    if load((&p4[0]) as u64, &b4, &f4, &gs) {
        fill(ids, skip, 241 as u32, 707 as u32, 0 as u32, 2)
        ask(40, &f4, &gs, 4 as u32, ids, skip, 2, 0, 1, 0, 0 as u32, 0, 0 as u32)
        fill(ids, skip, 241 as u32, 708 as u32, 0 as u32, 2)
        ask(41, &f4, &gs, 4 as u32, ids, skip, 2, 0, 0, 0, 0 as u32, 0, 0 as u32)
    } else {
        G_SKIPPED = G_SKIPPED + 1
    }

    // ------------------------------------------------ fixture gsubnest.ttf
    // Made by tools/fui/gsubnest_gen.py: glyphs A B C D = 1 2 3 4, alef 5,
    // beh 6. Lookups: 0 A->A B C, 1 B->C D, 2 C->D, 3 B->D, 4 D->C, 5 C->A,
    // 6 A->D A (all 0..6 multiple/single), 7 chain (A B' C) -> 3, 8 chain
    // (A B' C') -> 7 at B and 5 at C (NESTED), 9 beh->beh alef beh (arab rlig),
    // 10 alef->D (arab rlig).
    var p5: [u8; 32] = "tools/fui/fixtures/gsubnest.ttf\0"
    var b5: rt.Buf = rt.buf_new()
    var f5: ttf.Font = ttf.font_new()
    if load((&p5[0]) as u64, &b5, &f5, &gs) {
        let gd: u64 = rt.heap_alloc(256)
        let dl: u64 = rt.heap_alloc(64)
        let us: u64 = rt.heap_alloc(64)
        var zi: usize = 0
        while zi < 64 {
            w8(dl, zi, 0 as u8)
            zi = zi + 1
        }
        // type 2 with 3 outputs: the glyph of the position + 2 extras
        gsub.gsub_x_reset(&gs)
        w32(gd, 0, 1 as u32)
        shape.multi_apply(&f5, &gs, gd, 0 as u32, 0)
        say(200, r32(gd, 0) as i64, 1)
        say(201, gsub.gsub_x_count(&gs) as i64, 2)
        say(202, gsub.gsub_x_gid(&gs, 0) as i64, 2)
        say(203, gsub.gsub_x_gid(&gs, 1) as i64, 3)
        say(204, gsub.gsub_x_pos(&gs, 1) as i64, 0)
        // a second multiple substitution at the same position goes IN FRONT
        // of the extras: A -> D A makes D, then A B C
        shape.multi_apply(&f5, &gs, gd, 6 as u32, 0)
        say(205, r32(gd, 0) as i64, 4)
        say(206, gsub.gsub_x_count(&gs) as i64, 3)
        say(207, gsub.gsub_x_gid(&gs, 0) as i64, 1)
        say(208, gsub.gsub_x_gid(&gs, 1) as i64, 2)
        say(209, gsub.gsub_x_gid(&gs, 2) as i64, 3)
        // another position keeps its own extras in order
        w32(gd, 1, 2 as u32)
        shape.multi_apply(&f5, &gs, gd, 1 as u32, 1)
        say(210, r32(gd, 1) as i64, 3)
        say(211, gsub.gsub_x_count(&gs) as i64, 4)
        say(212, gsub.gsub_x_pos(&gs, 3) as i64, 1)
        say(213, gsub.gsub_x_gid(&gs, 3) as i64, 4)
        // a single substitution reaches the glyph AND its extras:
        // lookup 4 is D->C, the base of position 0 is D, its extras A B C
        shape.single_apply(&f5, &gs, gd, 4 as u32, false, 0)
        say(214, r32(gd, 0) as i64, 3)
        // position 1: base C, extra D -> lookup 4 makes the extra a C
        shape.single_apply(&f5, &gs, gd, 4 as u32, false, 1)
        say(215, r32(gd, 1) as i64, 3)
        say(216, gsub.gsub_x_gid(&gs, 3) as i64, 3)
        // a lookup that does not know the glyph changes nothing
        say(217, gsub.gsub_x_gid(&gs, 0) as i64, 1)
        // table full: 32 positions with 2 extras fit, the 33rd stays
        gsub.gsub_x_reset(&gs)
        var fi: usize = 0
        while fi < 40 {
            w32(gd, fi, 1 as u32)
            shape.multi_apply(&f5, &gs, gd, 6 as u32, fi)
            fi = fi + 1
        }
        say(220, gsub.gsub_x_count(&gs) as i64, 40)
        say(221, r32(gd, 39) as i64, 4)
        // lookup 6 makes ONE extra, so 40 of the 64 slots are used; use the
        // 2-extra lookup 0 for the overflow: base A stays A, check by count
        gsub.gsub_x_reset(&gs)
        fi = 0
        while fi < 40 {
            w32(gd, fi, 1 as u32)
            shape.multi_apply(&f5, &gs, gd, 0 as u32, fi)
            fi = fi + 1
        }
        say(222, gsub.gsub_x_count(&gs) as i64, 64)
        // NESTED context lookups. lookup 7 alone at B of A B C: 1 record
        // (position 1, lookup 3).
        gsub.gsub_x_reset(&gs)
        w32(gd, 0, 1 as u32)
        w32(gd, 1, 2 as u32)
        w32(gd, 2, 3 as u32)
        let c7: usize = gsub.gsub_context_li(&f5, &gs, 7 as u32, gd, dl, 3, 1)
        say(230, c7 as i64, 1)
        say(231, gsub.gsub_act_pos(&gs, 0) as i64, 1)
        say(232, gsub.gsub_act_lookup(&gs, 0) as i64, 3)
        // lookup 8 (A B' C') names lookup 7 at B and lookup 5 at C. Lookup 7
        // is itself a context lookup: it must run and make B a D, and the
        // second record (C -> A) must STILL be applied afterwards
        let c8: usize = gsub.gsub_context_li(&f5, &gs, 8 as u32, gd, dl, 3, 1)
        say(233, c8 as i64, 2)
        say(234, gsub.gsub_act_lookup(&gs, 0) as i64, 7)
        say(235, gsub.gsub_li_type(&f5, &gs, 7 as u32) as i64, 6)
        shape.apply_acts(&f5, &gs, gd, dl, 3, us, c8, 0 as u32)
        say(236, r32(gd, 0) as i64, 1)
        say(237, r32(gd, 1) as i64, 4)
        say(238, r32(gd, 2) as i64, 1)
        // the nested rule needs C behind B: A B A has none, so nothing at all
        w32(gd, 0, 1 as u32)
        w32(gd, 1, 2 as u32)
        w32(gd, 2, 1 as u32)
        let c8b: usize = gsub.gsub_context_li(&f5, &gs, 8 as u32, gd, dl, 3, 1)
        say(239, c8b as i64, 0)

        // ---- W23-b: the EXTRA glyphs in the matching ------------------------
        // CONTEXT sees them. Lookup 7 = A B' (lookup 3) C. (a) the backtrack
        // A is an extra of position 0 (glyph D): D [A] B C
        gsub.gsub_x_reset(&gs)
        w32(gd, 0, 4 as u32)
        w32(gd, 1, 2 as u32)
        w32(gd, 2, 3 as u32)
        gsub.gsub_x_insert(&gs, 0, 0, 1 as u32)
        say(400, gsub.gsub_context_li(&f5, &gs, 7 as u32, gd, dl, 3, 1) as i64, 1)
        say(401, gsub.gsub_act_pos(&gs, 0) as i64, 1)
        say(402, gsub.gsub_act_lookup(&gs, 0) as i64, 3)
        // (b) the input B is an extra: A [B] C C, asked at the unit of B
        gsub.gsub_x_reset(&gs)
        w32(gd, 0, 1 as u32)
        w32(gd, 1, 3 as u32)
        w32(gd, 2, 3 as u32)
        gsub.gsub_x_insert(&gs, 0, 0, 2 as u32)
        say(403, gsub.gsub_context_li_u(&f5, &gs, 7 as u32, gd, dl, 3, 1) as i64, 1)
        say(404, gsub.gsub_act_unit(&gs, 0) as i64, 1)
        say(405, gsub.gsub_act_pos(&gs, 0) as i64, 0)
        // ... the record makes the EXTRA a D, the glyph of the position stays
        let c403: usize = gsub.gsub_context_li_u(&f5, &gs, 7 as u32, gd, dl, 3, 1)
        shape.apply_acts(&f5, &gs, gd, dl, 3, us, c403, 0 as u32)
        say(406, gsub.gsub_x_gid(&gs, 0) as i64, 4)
        say(407, r32(gd, 0) as i64, 1)
        // asked at the position (0) the first glyph is A, not B: no rule
        say(408, gsub.gsub_context_li(&f5, &gs, 7 as u32, gd, dl, 3, 0) as i64, 0)
        // (c) the lookahead C is an extra of position 1: A B [C]
        gsub.gsub_x_reset(&gs)
        w32(gd, 0, 1 as u32)
        w32(gd, 1, 2 as u32)
        w32(gd, 2, 1 as u32)
        gsub.gsub_x_insert(&gs, 1, 0, 3 as u32)
        say(409, gsub.gsub_context_li(&f5, &gs, 7 as u32, gd, dl, 3, 1) as i64, 1)
        // without the extra C the lookahead is A: no rule
        gsub.gsub_x_reset(&gs)
        say(410, gsub.gsub_context_li(&f5, &gs, 7 as u32, gd, dl, 3, 1) as i64, 0)
        // LIGATURE over extras. Lookup 13 = A B -> D: A [B] C
        var nu1: usize = 0
        gsub.gsub_x_reset(&gs)
        w32(gd, 0, 1 as u32)
        w32(gd, 1, 3 as u32)
        gsub.gsub_x_insert(&gs, 0, 0, 2 as u32)
        say(411, gsub.gsub_li_ligature_u(&f5, &gs, 13 as u32, gd, dl, 2, 0, us, 16, &nu1) as i64, 4)
        say(412, nu1 as i64, 1)
        say(413, r32(us, 0) as i64, 1)
        // the plain variant says the POSITION of the component: 0
        say(414, gsub.gsub_li_ligature(&f5, &gs, 13 as u32, gd, dl, 2, 0, us, 16, &nu1) as i64, 4)
        say(415, r32(us, 0) as i64, 0)
        // A B [C]: B is the base of position 1, C its extra; lookup 15 (A B C)
        gsub.gsub_x_reset(&gs)
        w32(gd, 0, 1 as u32)
        w32(gd, 1, 2 as u32)
        gsub.gsub_x_insert(&gs, 1, 0, 3 as u32)
        say(416, gsub.gsub_li_ligature_u(&f5, &gs, 15 as u32, gd, dl, 2, 0, us, 16, &nu1) as i64, 4)
        say(417, nu1 as i64, 2)
        say(418, r32(us, 0) as i64, 128)
        say(419, r32(us, 1) as i64, 129)
        // a deleted position is not a component: A (B deleted) [C is gone too]
        w8(dl, 1, 1 as u8)
        say(420, gsub.gsub_li_ligature_u(&f5, &gs, 15 as u32, gd, dl, 2, 0, us, 16, &nu1) as i64, 0)
        w8(dl, 1, 0 as u8)
        // MULTIPLE with 0 outputs (lookup 16, D -> nothing) deletes the unit:
        // position without extras -> absorbed
        gsub.gsub_x_reset(&gs)
        w32(gd, 0, 4 as u32)
        w32(gd, 1, 2 as u32)
        say(421, shape.multi_apply_u(&f5, &gs, gd, dl, 16 as u32, 0) as i64, 0)
        say(422, r8(dl, 0) as i64, 1)
        w8(dl, 0, 0 as u8)
        // ... with extras the first extra takes over the position (not hidden)
        gsub.gsub_x_insert(&gs, 0, 0, 3 as u32)
        gsub.gsub_x_insert(&gs, 0, 1, 2 as u32)
        say(423, shape.multi_apply_u(&f5, &gs, gd, dl, 16 as u32, 0) as i64, 0)
        say(424, r32(gd, 0) as i64, 3)
        say(425, r8(dl, 0) as i64, 0)
        say(426, gsub.gsub_x_count(&gs) as i64, 1)
        say(427, gsub.gsub_x_gid(&gs, 0) as i64, 2)
        // a glyph the lookup does not know stays, step 1
        say(428, shape.multi_apply_u(&f5, &gs, gd, dl, 16 as u32, 0) as i64, 1)
        say(429, r32(gd, 0) as i64, 3)
        // THE WHOLE PATH: Arabic beh alone, `rlig` of the fixture makes
        // beh alef beh of it (lookup 9), then lookup 10 turns the extra alef
        // into a D: glyph beh, extras D beh.
        var ga: gsub.Gsub = gsub.gsub_new()
        let has5: bool = gsub.gsub_init(&f5, &ga)
        say(240, gsub.gsub_count(&ga) as i64, 5)
        let tb: u64 = ucd_bidi.ucd_bidi_map()
        let sp: u64 = rt.heap_alloc(64)
        let sc0: u64 = rt.heap_alloc(16)
        let slv: u64 = rt.heap_alloc(16)
        let sfm: u64 = rt.heap_alloc(16)
        w32(sp, 0, 0x628 as u32)
        w32(sp, 1, 0x627 as u32)
        w8(sc0, 0, 2 as u8)
        w8(sc0, 1, 2 as u8)
        w8(slv, 0, 1 as u8)
        w8(slv, 1, 1 as u8)
        var smiss: usize = 0
        let way: u32 = shape.shape_run(tb, &f5, &ga, true, sp, sc0, slv, 1, gd,
            dl, sfm, us, &smiss)
        say(241, way as i64, 1)
        say(242, r32(gd, 0) as i64, 6)
        say(243, gsub.gsub_x_count(&ga) as i64, 2)
        say(244, gsub.gsub_x_gid(&ga, 0) as i64, 4)
        say(245, gsub.gsub_x_gid(&ga, 1) as i64, 6)
        say(246, gsub.gsub_x_pos(&ga, 1) as i64, 0)
        // two letters: beh (extras) then alef -> D by lookup 10, once
        let way2: u32 = shape.shape_run(tb, &f5, &ga, true, sp, sc0, slv, 2, gd,
            dl, sfm, us, &smiss)
        say(247, way2 as i64, 1)
        say(248, r32(gd, 1) as i64, 4)
        say(249, gsub.gsub_x_count(&ga) as i64, 2)
        // W23-b: meem -> meem alef beh (lookup 11), the ligature alef beh -> D
        // (12) joins two EXTRAS: meem [D]
        w32(sp, 0, 0x645 as u32)
        w8(sc0, 0, 2 as u8)
        w8(slv, 0, 1 as u8)
        let way4: u32 = shape.shape_run(tb, &f5, &ga, true, sp, sc0, slv, 1, gd,
            dl, sfm, us, &smiss)
        say(430, way4 as i64, 1)
        say(431, r32(gd, 0) as i64, 7)
        say(432, gsub.gsub_x_count(&ga) as i64, 1)
        say(433, gsub.gsub_x_gid(&ga, 0) as i64, 4)
        // two meems: the D (extra of position 0) and the meem of position 1
        // become a beh (lookup 17) -- the extra is replaced, the base of
        // position 1 goes, its first extra (D) takes over the position and
        // is NOT hidden: meem [beh], D
        w32(sp, 0, 0x645 as u32)
        w32(sp, 1, 0x645 as u32)
        w8(sc0, 1, 2 as u8)
        w8(slv, 1, 1 as u8)
        let way5: u32 = shape.shape_run(tb, &f5, &ga, true, sp, sc0, slv, 2, gd,
            dl, sfm, us, &smiss)
        say(434, way5 as i64, 1)
        say(435, r32(gd, 0) as i64, 7)
        say(436, gsub.gsub_x_count(&ga) as i64, 1)
        say(437, gsub.gsub_x_gid(&ga, 0) as i64, 6)
        say(438, gsub.gsub_x_pos(&ga, 0) as i64, 0)
        say(439, r32(gd, 1) as i64, 4)
        say(440, r8(dl, 1) as i64, 0)
        say(441, r8(dl, 0) as i64, 0)
        // the next run starts clean: a Latin A has no extras
        w32(sp, 0, 0x41 as u32)
        w8(sc0, 0, 0 as u8)
        w8(slv, 0, 0 as u8)
        let way3: u32 = shape.shape_run(tb, &f5, &ga, true, sp, sc0, slv, 1, gd,
            dl, sfm, us, &smiss)
        say(250, gsub.gsub_x_count(&ga) as i64, 0)

        // THE PAINTER: the measure and the picture of "beh" (U+0628) with the
        // fixture. Glyphs: beh + extras D beh, so the line is
        // adv(beh) + adv(D) + adv(beh) wide at 2048 points, and the ink of the
        // picture is clearly wider than one beh. (Arabic -> bidi path.)
        let fsp5: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
        *fsp5 = metrics.fontset_new()
        if metrics.fontset_load(fsp5, b5.ptr as *mut u8, b5.len) {
            var cv5: canvas.Canvas = canvas.canvas_new()
            let cok: bool = canvas.canvas_init(&cv5, 400, 160)
            var z5: painter.Painter = painter.painter_new()
            let pok: bool = painter.painter_init(&z5, &cv5, 400, 160)
            painter.painter_set_font(&z5, fsp5 as u64)
            var r5: painter.TextRun = painter.run_new(2048.0)
            var beh: [u8; 2] = "ب"
            let want: i64 = (ttf.font_advance(&f5, 6 as u32) as i64) * 2 + (ttf.font_advance(&f5, 4 as u32) as i64)
            say(251, painter.run_width(&z5, &r5, (&beh[0]) as u64, 2) as i64, want)
            var beh2: [u8; 4] = "با"
            // beh alef: beh + D + beh, then the alef (lookup 10 -> D)
            say(252, painter.run_width(&z5, &r5, (&beh2[0]) as u64, 4) as i64,
                want + (ttf.font_advance(&f5, 4 as u32) as i64))
            // meem [D]: the line is adv(meem) + adv(D); two meems: meem, beh, D
            var mm: [u8; 2] = "م"
            say(255, painter.run_width(&z5, &r5, (&mm[0]) as u64, 2) as i64,
                (ttf.font_advance(&f5, 7 as u32) as i64) + (ttf.font_advance(&f5, 4 as u32) as i64))
            var mm2: [u8; 4] = "مم"
            say(256, painter.run_width(&z5, &r5, (&mm2[0]) as u64, 4) as i64,
                (ttf.font_advance(&f5, 7 as u32) as i64) + (ttf.font_advance(&f5, 6 as u32) as i64)
                + (ttf.font_advance(&f5, 4 as u32) as i64))
            var rs: painter.TextRun = painter.run_new(80.0)
            canvas.canvas_clear(&cv5, 0xFFFFFFFF as u32)
            let bg: u32 = canvas.canvas_get(&cv5, 0, 0)
            let dw: f64 = painter.run_draw(&z5, &rs, 40.0, 110.0, 0.0, 0xFF000000 as u32, (&beh[0]) as u64, 2, 0)
            var xmin: usize = 400
            var xmax: usize = 0
            var yy: usize = 0
            while yy < 160 {
                var xx: usize = 0
                while xx < 400 {
                    if canvas.canvas_get(&cv5, xx, yy) != bg {
                        if xx < xmin { xmin = xx }
                        if xx > xmax { xmax = xx }
                    }
                    xx = xx + 1
                }
                yy = yy + 1
            }
            // one beh is adv(6) * 80 / 2048 wide; the picture must be wider
            // than 1.5 of that and no wider than the whole line
            let one: i64 = (ttf.font_advance(&f5, 6 as u32) as i64) * 80 / 2048
            let whole: i64 = (want * 80 / 2048) + 3
            var wide: i64 = 0
            if ((xmax as i64) - (xmin as i64)) * 2 > one * 3 { wide = 1 }
            say(253, wide, 1)
            var inside: i64 = 0
            if (xmax as i64) - 40 <= whole && (xmin as i64) >= 38 { inside = 1 }
            say(254, inside, 1)
        }
    } else {
        G_SKIPPED = G_SKIPPED + 1
    }

    var o: rt.Buf = rt.buf_new()
    var l1: [u8; 8] = "checks: "
    rt.buf_push_bytes(&o, (&l1[0]) as u64, 8)
    rt.buf_push_dec_u64(&o, G_CHECKS as u64)
    var l2: [u8; 10] = " wrong:   "
    rt.buf_push_bytes(&o, (&l2[0]) as u64, 10)
    rt.buf_push_dec_u64(&o, G_ERRORS as u64)
    var l3: [u8; 10] = " skipped: "
    rt.buf_push_bytes(&o, (&l3[0]) as u64, 10)
    rt.buf_push_dec_u64(&o, G_SKIPPED as u64)
    rt.buf_push(&o, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
    if G_ERRORS != 0 {
        return 1
    }
    return 0
}
