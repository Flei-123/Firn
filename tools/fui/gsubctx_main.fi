// SPDX-License-Identifier: MPL-2.0
// tools/fui/gsubctx_main.fi -- GSUB context lookups (type 5 and 6) and
// multiple substitution (type 2) of lib/font/gsub.fi against rules read
// from real fonts with fontTools.
//
// Every case is a glyph sequence BUILT FROM A RULE of the font (so it must
// match) plus the answer of a small reference matcher written in Python;
// the records must come back identical. Fonts that are not installed are
// skipped and said so. DejaVu Sans: the two ccmp chaining lookups (class
// format, with backtrack and lookahead) and the skip of absorbed positions.
import std.rt
import font.ttf
import font.gsub

static mut G_ERRORS: usize = 0
static mut G_CHECKS: usize = 0
static mut G_SKIPPED: usize = 0

fn say(id: i64, got: i64, want: i64) {
    G_CHECKS = G_CHECKS + 1
    var t: rt.Buf = rt.buf_new()
    var okk: [u8; 8] = "ok   #  "
    var bad: [u8; 8] = "FAIL #  "
    if got == want {
        rt.buf_push_bytes(&t, (&okk[0]) as u64, 8)
    } else {
        G_ERRORS = G_ERRORS + 1
        rt.buf_push_bytes(&t, (&bad[0]) as u64, 8)
    }
    rt.buf_push_dec_i64(&t, id)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, got)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, want)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn w32(p: u64, i: usize, v: u32) { *((p + (i * 4) as u64) as *mut u32) = v }

// The sequence a b c ... in `ids` (up to 4 glyphs, 0 = unused after n).
fn fill(ids: u64, skip: u64, a: u32, b: u32, c: u32, n: usize) {
    w32(ids, 0, a)
    w32(ids, 1, b)
    w32(ids, 2, c)
    var i: usize = 0
    while i < 4 {
        *((skip + i as u64) as *mut u8) = 0 as u8
        i = i + 1
    }
}

// One question: lookup `li` at `at`; expected record count `nr` and the
// first record (pos, lookup).
fn ask(id: i64, f: *mut ttf.Font, gs: *mut gsub.Gsub, li: u32, ids: u64,
    skip: u64, n: usize, at: usize, nr: usize, pos0: usize, li0: u32,
    pos1: usize, li1: u32) {
    let c: usize = gsub.gsub_context_li(f, gs, li, ids, skip, n, at)
    say(id * 10, c as i64, nr as i64)
    if nr >= 1 && c >= 1 {
        say(id * 10 + 1, gsub.gsub_act_pos(gs, 0) as i64, pos0 as i64)
        say(id * 10 + 2, gsub.gsub_act_lookup(gs, 0) as i64, li0 as i64)
    }
    if nr >= 2 && c >= 2 {
        say(id * 10 + 3, gsub.gsub_act_pos(gs, 1) as i64, pos1 as i64)
        say(id * 10 + 4, gsub.gsub_act_lookup(gs, 1) as i64, li1 as i64)
    }
}

fn load(path: u64, buf: *mut rt.Buf, f: *mut ttf.Font,
    gs: *mut gsub.Gsub) -> bool {
    if !rt.read_file(path, buf) {
        return false
    }
    *f = ttf.font_new()
    if !ttf.font_init(f, (*buf).ptr as *mut u8, (*buf).len) {
        return false
    }
    return gsub.gsub_open(f, gs)
}

fn main() -> i32 {
    let ids: u64 = rt.heap_alloc(64)
    let skip: u64 = rt.heap_alloc(16)
    var gs: gsub.Gsub = gsub.gsub_new()

    // ------------------------------------------------------ DejaVu Sans
    var p1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
    var b1: rt.Buf = rt.buf_new()
    var f1: ttf.Font = ttf.font_new()
    if load((&p1[0]) as u64, &b1, &f1, &gs) {
        // lookup 2: Hebrew ayin 1337 + vowel 1297 (class 2) -> lookup 31
        fill(ids, skip, 1337 as u32, 1297 as u32, 0 as u32, 2)
        ask(1, &f1, &gs, 2 as u32, ids, skip, 2, 0, 1, 0, 31 as u32, 0, 0 as u32)
        // ayin + ayin: lookahead is class 1, not 2 -> no rule
        fill(ids, skip, 1337 as u32, 1337 as u32, 0 as u32, 2)
        ask(2, &f1, &gs, 2 as u32, ids, skip, 2, 0, 0, 0, 0 as u32, 0, 0 as u32)
        // ayin, ABSORBED glyph, vowel: the middle one does not count
        fill(ids, skip, 1337 as u32, 679 as u32, 1297 as u32, 3)
        *((skip + 1 as u64) as *mut u8) = 1 as u8
        ask(3, &f1, &gs, 2 as u32, ids, skip, 3, 0, 1, 0, 31 as u32, 0, 0 as u32)
        // ... and without the skip it does count -> no rule
        *((skip + 1 as u64) as *mut u8) = 0 as u8
        ask(4, &f1, &gs, 2 as u32, ids, skip, 3, 0, 0, 0, 0 as u32, 0, 0 as u32)
        // lookup 4, tone letters: 679 679 (class 1, lookahead class 1) -> 34
        fill(ids, skip, 679 as u32, 679 as u32, 0 as u32, 2)
        ask(5, &f1, &gs, 4 as u32, ids, skip, 2, 0, 1, 0, 34 as u32, 0, 0 as u32)
        // ... last one has no lookahead -> no rule
        ask(6, &f1, &gs, 4 as u32, ids, skip, 2, 1, 0, 0, 0 as u32, 0, 0 as u32)
        // 679 680: the second subtable fits -> 35
        fill(ids, skip, 679 as u32, 680 as u32, 0 as u32, 2)
        ask(7, &f1, &gs, 4 as u32, ids, skip, 2, 0, 1, 0, 35 as u32, 0, 0 as u32)
        // BACKTRACK: 4946 (680 with a number) then 679 -> lookup 39 at 1
        fill(ids, skip, 4946 as u32, 679 as u32, 0 as u32, 2)
        ask(8, &f1, &gs, 4 as u32, ids, skip, 2, 1, 1, 1, 39 as u32, 0, 0 as u32)
        // ... if the backtrack glyph is absorbed there is nothing behind it
        *((skip + 0 as u64) as *mut u8) = 1 as u8
        ask(9, &f1, &gs, 4 as u32, ids, skip, 2, 1, 0, 0, 0 as u32, 0, 0 as u32)
        *((skip + 0 as u64) as *mut u8) = 0 as u8
        // the nested lookups really change the glyph
        say(100, gsub.gsub_li_single(&f1, &gs, 31 as u32, 1337 as u32) as i64, 5056)
        say(101, gsub.gsub_li_single(&f1, &gs, 34 as u32, 679 as u32) as i64, 4945)
        say(102, gsub.gsub_li_single(&f1, &gs, 39 as u32, 679 as u32) as i64, 4970)
        say(103, gsub.gsub_li_type(&f1, &gs, 2 as u32) as i64, 6)
        // the arab list now holds ccmp: 2 and 4 come first
        var ga: gsub.Gsub = gsub.gsub_new()
        let has: bool = gsub.gsub_init(&f1, &ga)
        say(110, gsub.gsub_count(&ga) as i64, 10)
        say(111, gsub.gsub_lookup_index(&ga, 0) as i64, 2)
        say(112, (gsub.gsub_lookup_mask(&ga, 0) & gsub.F_CCMP) as i64, 128)
        say(113, gsub.gsub_lookup_type(&f1, &ga, 1) as i64, 6)
        fill(ids, skip, 679 as u32, 679 as u32, 0 as u32, 2)
        let nk: usize = gsub.gsub_context(&f1, &ga, 1, ids, skip, 2, 0)
        say(114, nk as i64, 1)
    } else {
        G_SKIPPED = G_SKIPPED + 1
    }

    // ------------------------------------------- Noto Sans Mono Bold
    // lookup 3: chaining context format 3 (coverages); lookup 7: multiple
    var p2: [u8; 56] = "/usr/share/fonts/truetype/noto/NotoSansMono-Bold.ttf\0\0\0\0"
    var b2: rt.Buf = rt.buf_new()
    var f2: ttf.Font = ttf.font_new()
    if load((&p2[0]) as u64, &b2, &f2, &gs) {
        fill(ids, skip, 76 as u32, 1213 as u32, 0 as u32, 2)
        ask(20, &f2, &gs, 3 as u32, ids, skip, 2, 0, 1, 0, 4 as u32, 0, 0 as u32)
        // a glyph the rule does not name in place of the second
        fill(ids, skip, 76 as u32, 3 as u32, 0 as u32, 2)
        ask(21, &f2, &gs, 3 as u32, ids, skip, 2, 0, 0, 0, 0 as u32, 0, 0 as u32)
    } else {
        G_SKIPPED = G_SKIPPED + 1
    }

    // --------------------------------------------- Noto Color Emoji
    // lookup 2: chaining class format; lookup 4: context class format (5)
    var p3: [u8; 50] = "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf\0"
    var b3: rt.Buf = rt.buf_new()
    var f3: ttf.Font = ttf.font_new()
    if load((&p3[0]) as u64, &b3, &f3, &gs) {
        fill(ids, skip, 481 as u32, 1430 as u32, 0 as u32, 2)
        ask(30, &f3, &gs, 2 as u32, ids, skip, 2, 1, 1, 1, 1 as u32, 0, 0 as u32)
        fill(ids, skip, 205 as u32, 205 as u32, 0 as u32, 2)
        ask(31, &f3, &gs, 4 as u32, ids, skip, 2, 0, 2, 0, 5 as u32, 1, 1 as u32)
    } else {
        G_SKIPPED = G_SKIPPED + 1
    }

    // ------------------------------------------ FreeSerif Bold Italic
    // lookup 4: chaining context format 1 (glyph lists)
    var p4: [u8; 59] = "/usr/share/fonts/truetype/freefont/FreeSerifBoldItalic.ttf\0"
    var b4: rt.Buf = rt.buf_new()
    var f4: ttf.Font = ttf.font_new()
    if load((&p4[0]) as u64, &b4, &f4, &gs) {
        fill(ids, skip, 241 as u32, 707 as u32, 0 as u32, 2)
        ask(40, &f4, &gs, 4 as u32, ids, skip, 2, 0, 1, 0, 0 as u32, 0, 0 as u32)
        fill(ids, skip, 241 as u32, 708 as u32, 0 as u32, 2)
        ask(41, &f4, &gs, 4 as u32, ids, skip, 2, 0, 0, 0, 0 as u32, 0, 0 as u32)
    } else {
        G_SKIPPED = G_SKIPPED + 1
    }

    var o: rt.Buf = rt.buf_new()
    var l1: [u8; 8] = "checks: "
    rt.buf_push_bytes(&o, (&l1[0]) as u64, 8)
    rt.buf_push_dec_u64(&o, G_CHECKS as u64)
    var l2: [u8; 10] = " wrong:   "
    rt.buf_push_bytes(&o, (&l2[0]) as u64, 10)
    rt.buf_push_dec_u64(&o, G_ERRORS as u64)
    var l3: [u8; 10] = " skipped: "
    rt.buf_push_bytes(&o, (&l3[0]) as u64, 10)
    rt.buf_push_dec_u64(&o, G_SKIPPED as u64)
    rt.buf_push(&o, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
    if G_ERRORS != 0 {
        return 1
    }
    return 0
}
