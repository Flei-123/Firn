import std.io
import std.json
import std.rt
import paint.canvas
import font.metrics
import plat.sysfont
import fui.anim
import fui.kit
import fui.kitbind
import fui.kitdata
import fui.kitpopup
import fui.kitset
import fui.kitspec
import fui.painter
import fui.render
import fui.screenanim
import fui.theme

static mut BAD: usize = 0

const SPEC: str = "p\ns~0~a.lang~Language~~English|Deutsch|Francais\nt~1~a.auto~Autostart~Launch on login\np\nl~2~b.size~Size~~10~22~px\nr~3~b.mode~Mode~~auto|manual\nf~4~b.user~User~~name\nc~5~b.accent~Accent~~#3ddc84|#5b8cff"
const DOC: str = "{\"a\":{\"lang\":\"Deutsch\",\"auto\":true},\"b\":{\"size\":17,\"mode\":\"manual\",\"user\":\"justin\",\"accent\":\"#5b8cff\"},\"items\":[{\"name\":\"Alpha\",\"info\":\"first\",\"n\":3},{\"name\":\"Beta\",\"n\":12}]}"

fn expect(ok: bool, what: str) {
    if !ok {
        BAD = BAD + 1
        io.print_line(what)
    }
}

fn doc_from(text: str) -> *mut kitdata.Doc {
    let d: *mut kitdata.Doc = rt.heap_alloc(1 << 12) as *mut kitdata.Doc
    (*d).j = json.json_new()
    (*d).text = rt.buf_new()
    rt.buf_push_bytes(&(*d).text, text.p as u64, text.n)
    (*d).ok = json.json_parse(&(*d).j, rt.buf_ptr(&(*d).text), rt.buf_len(&(*d).text)) catch false
    return d
}

fn frame(c: *mut render.Ctx, r: *mut anim.TransReg, ms: i64) {
    render.ctx_set_time(c, ms)
    anim.transreg_new_frame(r)
    screenanim.begin_frame()
}

#[allow_escape]
fn main() -> i32 {
    expect(kitspec.count(SPEC, kitspec.ROW_SEP) == 8, "row count")
    expect(kitspec.dec(kitspec.pick("s~12~x", kitspec.FIELD_SEP, 1)) == 12, "field parse")
    expect(kitspec.pick("a~b", kitspec.FIELD_SEP, 5).n == 0, "missing field is empty")

    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    expect(sysfont.sysfont_load(fs), "fonts")
    var cv: canvas.Canvas = canvas.canvas_new()
    expect(canvas.canvas_init(&cv, 640, 480), "canvas")
    var z: painter.Painter = painter.painter_new()
    expect(painter.painter_init(&z, &cv, 640, 480), "painter")
    painter.painter_set_font(&z, fs as u64)
    var m: theme.Theme = theme.theme_new(true)
    var cx: render.Ctx = render.ctx_new(&m, &z)
    var reg: anim.TransReg = anim.transreg_new()
    anim.transreg_bind(&reg, &cx)
    let c: *mut render.Ctx = &cx
    let rp: *mut anim.TransReg = &reg

    let d: *mut kitdata.Doc = doc_from(DOC)
    let s: *mut kitset.Set = kitset.set_new()
    kitspec.bind(s, d, SPEC)
    expect(kitset.val(s, 0) == 1, "select bound by name")
    expect(kitset.val(s, 1) == 1, "toggle bound")
    expect(kitset.val(s, 2) == 17, "slider bound")
    expect(kitset.val(s, 3) == 1, "radio bound by name")
    expect(kitset.text_of(s, 4).n == 6, "field bound")
    expect(kitset.val(s, 5) == 1, "colour bound by value")

    frame(c, rp, 0)
    kitset.begin(s, c, 20.0, 20.0, 560.0, 0.0 - 1.0, 0.0 - 1.0)
    kitspec.page_draw(s, c, SPEC, 1)
    expect((*s).n == 2 && (*s).k[0] == kitset.SELECT && (*s).k[1] == kitset.TOGGLE, "page 1 rows")
    kitset.begin(s, c, 20.0, 20.0, 560.0, 0.0 - 1.0, 0.0 - 1.0)
    kitspec.page_draw(s, c, SPEC, 2)
    expect((*s).n == 4 && (*s).k[(*s).reg[0]] == kitset.SLIDER && (*s).k[(*s).reg[3]] == kitset.COLORS, "page 2 rows")
    expect((*s).lo[2] == 10 && (*s).hi[2] == 22, "slider range from the spec")

    kitset.begin(s, c, 20.0, 20.0, 560.0, 0.0 - 1.0, 0.0 - 1.0)
    kitspec.page_draw(s, c, SPEC, 1)
    var q: [f64; 4] = [0.0; 4]
    kitset.press(s, (*s).r[0] + 10.0, (*s).r[1] + 10.0)
    expect((*s).open == 0, "select opens")
    kitset.item_rect(s, c, 0, 2, &q)
    expect(kitpopup.hit(c, (*s).r[0], (*s).r[1], (*s).r[2], (*s).r[3], kitspec.pick(kitspec.pick(SPEC, kitspec.ROW_SEP, 1), kitspec.FIELD_SEP, 5), q[0] + 3.0, q[1] + 3.0) == 2, "popup hit item 2")
    expect(kitpopup.hit(c, (*s).r[0], (*s).r[1], (*s).r[2], (*s).r[3], "a|b", 1.0, 1.0) == kitpopup.NONE, "popup miss")
    kitset.press(s, 5.0, 5.0)

    frame(c, rp, 1000)
    kitset.begin(s, c, 20.0, 20.0, 560.0, 0.0 - 1.0, 0.0 - 1.0)
    kitspec.page_draw(s, c, SPEC, 1)
    expect(!anim.transreg_dirty(rp), "rest: no frames asked")
    kitset.set_val(s, 1, 0)
    frame(c, rp, 1010)
    kitset.begin(s, c, 20.0, 20.0, 560.0, 0.0 - 1.0, 0.0 - 1.0)
    kitspec.page_draw(s, c, SPEC, 1)
    expect(anim.transreg_dirty(rp), "toggle flip asks for frames")
    frame(c, rp, 1500)
    kitset.begin(s, c, 20.0, 20.0, 560.0, 0.0 - 1.0, 0.0 - 1.0)
    kitspec.page_draw(s, c, SPEC, 1)
    expect(!anim.transreg_dirty(rp), "toggle arrived")

    let items: u32 = kitdata.get(d, kitdata.root(d), "items")
    expect(kitbind.height(c, d, items, "name|info|n") == kit.ln(c, 68) + kit.ln(c, 58) + kit.ln(c, 20), "auto list height")
    let hot: usize = kitbind.cards(c, d, items, "name|info|n", 20.0, 20.0, 400.0, 30.0, 30.0)
    expect(hot == 0, "auto list hover")
    expect(kitbind.hit(c, d, items, "name|info|n", 20.0, 20.0, 400.0, 30.0, 20.0 + kit.ln(c, 68) + kit.ln(c, 10) + 5.0) == 1, "auto list hit second")
    expect(kitbind.hit(c, d, items, "name|info|n", 20.0, 20.0, 400.0, 500.0, 30.0) == kitbind.NONE, "auto list miss")

    if BAD == 0 { io.print_line("kitspec OK") }
    return BAD as i32
}
