// SPDX-License-Identifier: MPL-2.0
// tools/fui/gallery6_main.fi -- FLEX ALS BILD.
//
// Flexbox laesst sich nur im Vergleich zeigen: DIESELBEN Kinder, einmal
// je Einstellung. Jede Variante steht in einem Rahmen, damit man sieht,
// wo der Behaelter aufhoert und wo die Luft verteilt wird, und jedes
// Kind traegt seine Nummer -- sonst sieht man bei `row-reverse` nicht,
// dass sich die Achse gedreht hat und nicht nur die Kaesten verschoben
// sind.
//
// Die rechte Spalte zeigt, was nur die Flexbox kann: Umbruch mit
// align-content, die Spaltenrichtung in beide Laufrichtungen, und
// GANZ UNTEN die Bruecke zum Mess-Protokoll -- eine Werkzeugleiste aus
// echten Knoepfen, deren Basis `render.pref_of` gemessen hat.
//
//     gallery6_main <out.png> [light|dark] [<font.ttf>]
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.layout
import fui.flex

const FONTSET_BYTES: usize = 4096
const W: usize = 1240
// H IST DIE HOECHSTHOEHE, NICHT DIE BILDHOEHE -- dieselbe Regel wie
// in tools/fui/gallery3_main.fi. Wie hoch das Blatt wirklich wird,
// weiss erst das letzte gezeichnete Band; stand H auch im Bild, hing
// darunter ein leerer Streifen (gemessen 42 Punkte), der im dunklen
// Schema wie ein halb gerenderter Beleg aussieht.
const H: usize = 880
// Der Rand, der unter dem letzten Inhalt stehen bleibt: dasselbe
// Mass, mit dem das Blatt oben anfaengt.
const RAND_UNTEN: usize = 20

// Die linke und die rechte Spalte des Blattes.
const LX: f64 = 24.0
const LW: f64 = 560.0
const RX: f64 = 648.0
const RW: f64 = 568.0

fn label(c: *mut render.Ctx, x: f64, y: f64, w: f64, px: usize, p: u64,
    n: usize, tok: u32) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, w, 18.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(tok))
    *s = style.style_set_font(*s, 0, px)
    *s = style.style_set_pad(*s, 0, 0)
    render.draw_label(c, &e)
}

// EINE UEBERSCHRIFT, DEREN ZAHL GEZAEHLT UND DEREN BREITE GEMESSEN IST.
//
// Zwei Fehler hat dieses Blatt schon gehabt, und beide sehen aus der
// Ferne gleich aus: eine Zeile, die etwas anderes behauptet als das
// Bild darunter. Einmal war es die ZAHL ("vierzehn Regeln" ueber
// dreizehn Kaesten), einmal die BREITE (eine Zeile, die aus ihrem Feld
// lief und hart abgeschnitten wurde). Deshalb setzt diese Funktion die
// Zahl aus dem mitgezaehlten Wert und gibt die von `render.pref_of`
// GEMESSENE Sollbreite zurueck -- der Aufrufer vergleicht sie mit dem
// Band und bricht ab, statt ein beschnittenes Wort auszuliefern.
fn titelzeile(c: *mut render.Ctx, x: f64, y: f64, w: f64, px: usize,
    pre: u64, npre: usize, n: usize, post: u64, npost: usize,
    tok: u32) -> f64 {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, pre, npre)
    rt.buf_push_dec_u64(&t, n as u64)
    rt.buf_push_bytes(&t, post, npost)
    label(c, x, y, w, px, rt.buf_ptr(&t), rt.buf_len(&t), tok)
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, w, 18.0)
    widget.w_set_text(&e, rt.buf_ptr(&t), rt.buf_len(&t))
    let sy: *mut style.Style = widget.w_style(&e)
    *sy = style.style_set_font(*sy, 0, px)
    *sy = style.style_set_pad(*sy, 0, 0)
    var pw: f64 = 0.0
    var ph: f64 = 0.0
    render.pref_of(c, &e, &pw, &ph)
    rt.buf_free(&t)
    return pw
}

// ==================================== DIE BRUECKE ZUM MESS-PROTOKOLL
//
// `render.pref_of` ist das vorhandene Mess-Protokoll und bleibt das
// einzige: es misst ein Widget mit Schrift, Bild und Innenrand und
// liefert f64. Die Flexbox rechnet ganzzahlig. Genau HIER, im
// Aufrufer, steht die Umrechnung -- lib/fui/flex.fi bleibt kernel-rein
// und importiert render.fi nicht; es bringt nur die reine
// Zahlenfunktion `flex_item_from_pref` mit, damit nicht jede
// Aufrufstelle anders rundet.
fn item_von_widget(c: *mut render.Ctx, e: *mut widget.Widget,
    zeile: bool) -> flex.FlexItem {
    var pw: f64 = 0.0
    var ph: f64 = 0.0
    render.pref_of(c, e, &pw, &ph)
    return flex.flex_item_from_pref(pw, ph, zeile)
}

// Ein Rahmen mit Ueberschrift. Die Ueberschrift steht UEBER dem
// Rahmen, damit sie nie in die verteilten Kinder laeuft.
// ZURUECK KOMMT DIE EINS, die dieser Kasten zur Zaehlung beitraegt.
// Die Ueberschrift des Blattes nennt eine Zahl von Faellen, und diese
// Zahl war frueher von Hand getippt: "vierzehn Regeln" stand ueber
// dreizehn gemalten Kaesten, weil jemand einen Fall hinzugefuegt und
// die Ueberschrift vergessen hat. Wer die Zahl ADDIERT, statt sie zu
// behaupten, kann sie nicht mehr vergessen -- die Ueberschrift wird
// deshalb ganz am Ende aus den Summen gesetzt.
fn rahmen(c: *mut render.Ctx, m: *mut theme.Theme, x: f64, y: f64,
    w: f64, h: f64, nm: u64, nn: usize) -> usize {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let f: *mut theme.Colors = theme.theme_colors(m)
    label(c, x, y, w, 12, nm, nn, style.TOK_TEXT)
    painter.round_rect(z, x, y + 20.0, w, h, 8.0,
        theme.opaque((*f).surface))
    return 1
}

// Ein verteiltes Kind: der Kasten und seine Nummer. Die Nummer nur
// dann, wenn der Kasten breit genug dafuer ist -- ein abgeschnittenes
// Zeichen waere genau der Fehler, den dieses Blatt aufdecken soll.
fn kind(c: *mut render.Ctx, m: *mut theme.Theme, r: *mut layout.Rect,
    ziffern: u64, i: usize) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let f: *mut theme.Colors = theme.theme_colors(m)
    let x: f64 = layout.rect_x(r) as f64
    let y: f64 = layout.rect_y(r) as f64
    let w: f64 = layout.rect_w(r) as f64
    let h: f64 = layout.rect_h(r) as f64
    painter.round_rect(z, x, y, w, h, 6.0, theme.opaque((*f).accent))
    if w >= 26.0 && h >= 16.0 {
        label(c, x + 9.0, y + h / 2.0 - 9.0, w - 12.0, 11,
            ziffern + i as u64, 1, style.TOK_TEXT_ON_ACCENT)
    }
}

// Eine Variante: Rahmen, Ueberschrift, verteilen, Kinder malen.
fn variante(c: *mut render.Ctx, m: *mut theme.Theme, x: f64, y: f64,
    w: f64, h: f64, s: *mut flex.FlexBox, k: *mut flex.FlexItem,
    n: usize, nm: u64, nn: usize, ziffern: u64) -> usize {
    var gezaehlt: usize = rahmen(c, m, x, y, w, h, nm, nn)
    var out: [layout.Rect; 8] = [layout.rect_new(0, 0, 0, 0); 8]
    var gr: [i64; 8] = [0; 8]
    var fz: [i64; 8] = [0; 8]
    flex.flex_layout(s, layout.rect_new(x as i64, (y + 20.0) as i64,
        w as i64, h as i64), k, n, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var i: usize = 0
    while i < n {
        kind(c, m, &out[i], ziffern, i)
        i = i + 1
    }
    return gezaehlt
}

// DIE UNTERSTE ZEILE, IN DER NOCH ETWAS STEHT, als HOEHE (also eine
// hinter der letzten bemalten Zeile). Gefragt wird die Leinwand
// selbst und nicht eine mitgefuehrte Zahl: dieses Blatt setzt seine
// Baender aus `flex.flex_layout`, und dessen Ergebnis steht erst
// fest, nachdem es gerechnet hat.
fn inhalt_unten(cv: *mut canvas.Canvas, bg: u32) -> usize {
    let w: usize = canvas.canvas_width(cv)
    var y: usize = canvas.canvas_height(cv)
    while y > 0 {
        y = y - 1
        var x: usize = 0
        while x < w {
            if canvas.canvas_get(cv, x, y) != bg {
                return y + 1
            }
            x = x + 1
        }
    }
    return 0
}

// DIE LEINWAND ENDET, WO DER INHALT ENDET. Eine zweite Leinwand der
// wahren Hoehe, Punkt fuer Punkt roh kopiert -- kopieren ist kein
// Malen, und ein Alphawert, der zweimal durch die Mischung laeuft,
// kaeme heller heraus als er war. Wortgleich zu
// tools/fui/gallery3_main.fi:50.
fn zuschnitt(src: *mut canvas.Canvas, dst: *mut canvas.Canvas,
    hoehe: usize) -> bool {
    var h: usize = hoehe
    if h > canvas.canvas_height(src) {
        h = canvas.canvas_height(src)
    }
    if h == 0 {
        return false
    }
    let w: usize = canvas.canvas_width(src)
    if !canvas.canvas_init(dst, w, h) {
        return false
    }
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            canvas.canvas_set_raw(dst, x, y, canvas.canvas_get(src, x, y))
            x = x + 1
        }
        y = y + 1
    }
    return true
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 47] = "gallery6_main <out.png> [light|dark] [font.ttf]"
        rt.write_everything(2, (&u[0]) as u64, 47)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    var dark: bool = true
    if rt.arg_count(start) >= 3 {
        if rt.ld8(rt.arg_ptr(start, 2), 0) == 108 as u8 {
            dark = false
        }
    }
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
        rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    // OHNE SCHRIFT KEIN BELEG. Ein Bild ohne einen einzigen
    // Buchstaben sieht von weitem aus wie ein Bild, und genau so ist
    // in OrientOS eine textlose Oberflaeche durch die Abnahme
    // gekommen. Ein Beleg ohne Beschriftung belegt nichts -- also
    // Fehler auf fd 2 und ein Rueckgabewert, an dem der Lauf
    // haengenbleibt, statt ein stummes PNG zu schreiben.
    if fm == 0 {
        var ks: [u8; 60] = "gallery6: keine Schrift gefunden -- ohne Schrift kein Beleg\n"
        rt.write_everything(2, (&ks[0]) as u64, 60)
        return 9
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 300) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(dark)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque((*f).base))

    var ziff: [u8; 8] = "12345678"
    let zp: u64 = (&ziff[0]) as u64

    // Die beiden Kopfzeilen werden GANZ AM ENDE gesetzt: sie nennen,
    // wie viele Faelle das Blatt zeigt, und diese Zahlen entstehen
    // erst beim Malen. `links` sind die Regeln der linken Spalte,
    // `rechts` die der rechten; zusammen sind es die Faelle des
    // Blattes.
    var links: usize = 0
    var rechts: usize = 0

    // =============================================== DIE LINKE SPALTE
    //
    // Immer dieselben drei Kinder zu 120 in einem Rahmen von 560 mit
    // 8 Innenrand und 8 Luecke: 544 - 376 = 168 Bildpunkte Luft, die
    // je nach Regel woanders landen.
    var k: [flex.FlexItem; 3] = [flex.flex_item(120, 28); 3]
    var s1: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_padding(&s1, 8, 8, 8, 8)
    flex.flex_set_gap(&s1, 8, 8)
    flex.flex_set_align_items(&s1, flex.AL_CENTER)
    let kp: *mut flex.FlexItem = (&k[0]) as *mut flex.FlexItem
    var y: f64 = 80.0
    var a1: [u8; 27] = "justify-content: flex-start"
    links = links + variante(&c, &m, LX, y, LW, 46.0, &s1, kp, 3,
        (&a1[0]) as u64, 27, zp)
    y = y + 84.0
    flex.flex_set_justify(&s1, flex.JUSTIFY_CENTER)
    var a2: [u8; 23] = "justify-content: center"
    links = links + variante(&c, &m, LX, y, LW, 46.0, &s1, kp, 3,
        (&a2[0]) as u64, 23, zp)
    y = y + 84.0
    flex.flex_set_justify(&s1, flex.JUSTIFY_BETWEEN)
    var a3: [u8; 30] = "justify-content: space-between"
    links = links + variante(&c, &m, LX, y, LW, 46.0, &s1, kp, 3,
        (&a3[0]) as u64, 30, zp)
    y = y + 84.0
    flex.flex_set_justify(&s1, flex.JUSTIFY_EVENLY)
    var a4: [u8; 29] = "justify-content: space-evenly"
    links = links + variante(&c, &m, LX, y, LW, 46.0, &s1, kp, 3,
        (&a4[0]) as u64, 29, zp)
    y = y + 84.0
    // Wachsen: das mittlere Kind nimmt die ganzen 168 dazu.
    flex.flex_set_justify(&s1, flex.JUSTIFY_START)
    var g: [flex.FlexItem; 3] = [flex.flex_item(120, 28); 3]
    flex.item_set_flex(&g[1], 1000, 1000, 120)
    var a5: [u8; 33] = "flex-grow: 1 on the middle child "
    links = links + variante(&c, &m, LX, y, LW, 46.0, &s1,
        (&g[0]) as *mut flex.FlexItem, 3, (&a5[0]) as u64, 33, zp)
    y = y + 84.0
    // Schrumpfen: ein Rahmen, der zu schmal ist. Die Basen 260/130/130
    // sind zusammen 520, hinein passen 344 -- es fehlen 176, und die
    // gehen nach shrink MAL BASIS, also doppelt so viel vom breiten.
    var sh: [flex.FlexItem; 3] = [flex.flex_item(260, 28); 3]
    sh[1] = flex.flex_item(130, 28)
    sh[2] = flex.flex_item(130, 28)
    flex.item_set_bounds(&sh[2], 96, 0)
    var a6: [u8; 41] = "flex-shrink: weighted, the last one stops"
    links = links + variante(&c, &m, LX, y, 376.0, 46.0, &s1,
        (&sh[0]) as *mut flex.FlexItem, 3, (&a6[0]) as u64, 41, zp)
    y = y + 84.0
    // Ausrichtung quer: start / center / end / stretch nebeneinander.
    var q: [flex.FlexItem; 4] = [flex.flex_item(120, 18); 4]
    flex.item_set_align(&q[0], flex.AL_START)
    flex.item_set_align(&q[1], flex.AL_CENTER)
    flex.item_set_align(&q[2], flex.AL_END)
    flex.item_set_align(&q[3], flex.AL_STRETCH)
    // Diese Zeile bekommt einen GROESSEREN Innenrand als die uebrigen.
    // Der Rahmen ist mit Radius 8 gerundet; ein Kind, das mit
    // `align-self: start` oder `end` ganz an den Innenrand rueckt,
    // sitzt bei Innenrand 8 genau auf dem Mittelpunkt des Eckbogens und
    // laeuft damit optisch in die Rundung. 12 haelt es um volle 4
    // Bildpunkte ausserhalb des Bogens -- die Kante des Rahmens bleibt
    // rundherum sichtbar.
    var s2: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_padding(&s2, 12, 12, 12, 12)
    flex.flex_set_gap(&s2, 8, 8)
    var a7: [u8; 42] = "align-self: start / center / end / stretch"
    links = links + variante(&c, &m, LX, y, LW, 64.0, &s2,
        (&q[0]) as *mut flex.FlexItem, 4, (&a7[0]) as u64, 42, zp)
    y = y + 102.0
    // align-content: stretch -- die ZEILEN selbst wachsen, bis sie den
    // Kasten quer fuellen. Fuenf Kinder zu 160 in 544 nutzbarer Breite
    // ergeben 3 + 2 Zeilen; von 124 Hoehe sind 48 belegt und 10 Luecke,
    // die uebrigen 66 gehen je zur Haelfte an die beiden Zeilen.
    var st: [flex.FlexItem; 5] = [flex.flex_item(160, 24); 5]
    var s3: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_padding(&s3, 8, 8, 8, 8)
    flex.flex_set_gap(&s3, 10, 10)
    flex.flex_set_wrap(&s3, flex.WRAP_WRAP)
    flex.flex_set_align_content(&s3, flex.AC_STRETCH)
    var a8: [u8; 41] = "align-content: stretch, the rows grow too"
    links = links + variante(&c, &m, LX, y, LW, 140.0, &s3,
        (&st[0]) as *mut flex.FlexItem, 5, (&a8[0]) as u64, 41, zp)

    // ============================================= DIE RECHTE SPALTE
    //
    // Sieben Kinder zu 160 mit 10 Luecke in 552 nutzbarer Breite:
    // 160+10+160+10+160 = 500 passt, das vierte nicht mehr. Also
    // 3 + 3 + 1 Zeilen.
    var wk: [flex.FlexItem; 7] = [flex.flex_item(160, 30); 7]
    let wp: *mut flex.FlexItem = (&wk[0]) as *mut flex.FlexItem
    var sw: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_padding(&sw, 8, 8, 8, 8)
    flex.flex_set_gap(&sw, 10, 10)
    flex.flex_set_wrap(&sw, flex.WRAP_WRAP)
    flex.flex_set_align_items(&sw, flex.AL_START)
    flex.flex_set_align_content(&sw, flex.AC_START)
    var r: f64 = 80.0
    var b1: [u8; 38] = "flex-wrap: wrap, align-content: start "
    rechts = rechts + variante(&c, &m, RX, r, RW, 150.0, &sw, wp, 7,
        (&b1[0]) as u64, 38, zp)
    r = r + 188.0
    flex.flex_set_align_content(&sw, flex.AC_BETWEEN)
    var b2: [u8; 46] = "flex-wrap: wrap, align-content: space-between "
    rechts = rechts + variante(&c, &m, RX, r, RW, 150.0, &sw, wp, 7,
        (&b2[0]) as u64, 46, zp)
    r = r + 188.0
    // Rueckwaerts: die Nummern laufen von rechts nach links, und bei
    // `flex-start` klebt die Zeile RECHTS.
    var rv: [flex.FlexItem; 3] = [flex.flex_item(120, 28); 3]
    var sr: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW_REVERSE)
    flex.flex_set_padding(&sr, 8, 8, 8, 8)
    flex.flex_set_gap(&sr, 8, 8)
    flex.flex_set_align_items(&sr, flex.AL_CENTER)
    var b3: [u8; 43] = "flex-direction: row-reverse, start is right"
    rechts = rechts + variante(&c, &m, RX, r, RW, 46.0, &sr,
        (&rv[0]) as *mut flex.FlexItem, 3, (&b3[0]) as u64, 43, zp)
    r = r + 84.0
    // Die Spaltenrichtung, beide Laufrichtungen nebeneinander: links
    // steht die 1 oben, rechts unten.
    var cl: [flex.FlexItem; 3] = [flex.flex_item(40, 28); 3]
    var sc: flex.FlexBox = flex.flexbox_new(flex.FLEX_COLUMN)
    flex.flex_set_padding(&sc, 8, 8, 8, 8)
    flex.flex_set_gap(&sc, 8, 8)
    flex.flex_set_justify(&sc, flex.JUSTIFY_CENTER)
    var b4: [u8; 28] = "flex-direction: column      "
    rechts = rechts + variante(&c, &m, RX, r, 274.0, 170.0, &sc,
        (&cl[0]) as *mut flex.FlexItem, 3, (&b4[0]) as u64, 28, zp)
    var sd: flex.FlexBox = flex.flexbox_new(flex.FLEX_COLUMN_REVERSE)
    flex.flex_set_padding(&sd, 8, 8, 8, 8)
    flex.flex_set_gap(&sd, 8, 8)
    flex.flex_set_justify(&sd, flex.JUSTIFY_CENTER)
    var b5: [u8; 28] = "flex-direction: column-rev. "
    rechts = rechts + variante(&c, &m, RX + 294.0, r, 274.0, 170.0, &sd,
        (&cl[0]) as *mut flex.FlexItem, 3, (&b5[0]) as u64, 28, zp)
    r = r + 208.0

    // =============== DIE BRUECKE: GEMESSENE KNOEPFE, RECHTS AUSGERICHTET
    //
    // Vier echte Knoepfe. Ihre Basis kommt aus `render.pref_of` und
    // nicht aus einer geratenen Zahl -- darum ist jeder genau so breit,
    // wie seine Beschriftung samt Innenrand es verlangt, und keiner
    // schneidet ab.
    var b6: [u8; 47] = "measured with render.pref_of, justify: flex-end"
    rechts = rechts + rahmen(&c, &m, RX, r, RW, 56.0, (&b6[0]) as u64, 47)
    var bt: [widget.Widget; 4] =
        [widget.widget_new(widget.KIND_BUTTON); 4]
    var x1: [u8; 4] = "Open"
    var x2: [u8; 4] = "Save"
    var x3: [u8; 6] = "Delete"
    var x4: [u8; 6] = "Cancel"
    widget.w_set_text(&bt[0], (&x1[0]) as u64, 4)
    widget.w_set_text(&bt[1], (&x2[0]) as u64, 4)
    widget.w_set_text(&bt[2], (&x3[0]) as u64, 6)
    widget.w_set_text(&bt[3], (&x4[0]) as u64, 6)
    var bi: [flex.FlexItem; 4] = [flex.flex_item(0, 0); 4]
    var i: usize = 0
    while i < 4 {
        bi[i] = item_von_widget(&c, &bt[i], true)
        i = i + 1
    }
    var sb: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_padding(&sb, 10, 10, 10, 10)
    flex.flex_set_gap(&sb, 8, 8)
    flex.flex_set_justify(&sb, flex.JUSTIFY_END)
    flex.flex_set_align_items(&sb, flex.AL_CENTER)
    var bo: [layout.Rect; 8] = [layout.rect_new(0, 0, 0, 0); 8]
    var bg: [i64; 8] = [0; 8]
    var bf: [i64; 8] = [0; 8]
    flex.flex_layout(&sb, layout.rect_new(RX as i64, (r + 20.0) as i64,
        RW as i64, 56.0 as i64), (&bi[0]) as *mut flex.FlexItem, 4,
        (&bo[0]) as *mut layout.Rect, (&bg[0]) as *mut i64,
        (&bf[0]) as *mut i64)
    i = 0
    while i < 4 {
        widget.w_place(&bt[i], layout.rect_x(&bo[i]) as f64,
            layout.rect_y(&bo[i]) as f64, layout.rect_w(&bo[i]) as f64,
            layout.rect_h(&bo[i]) as f64)
        render.draw_button(&c, &bt[i])
        i = i + 1
    }

    // ========================================== JETZT DIE KOPFZEILEN
    //
    // Titel und Unterzeile sind je EIN vollstaendiger Satz -- frueher
    // lief ein Satz ueber beide Zeilen, und wer nur den Titel las,
    // bekam ein halbes Praedikat. Die Zahlen darin sind die eben
    // gezaehlten, nicht die erinnerten.
    var t1a: [u8; 32] = "FLEX -- the same children under "
    var t1b: [u8; 6] = " rules"
    let t1w: f64 = titelzeile(&c, LX, 20.0, 900.0, 15,
        (&t1a[0]) as u64, 32, links + rechts, (&t1b[0]) as u64, 6,
        style.TOK_TEXT)
    var t2a: [u8; 13] = "on the left, "
    var t2b: [u8; 91] =
        " ways to spend the free space in one row; on the right, wrap, columns and measured buttons."
    let t2w: f64 = titelzeile(&c, LX, 44.0, 1100.0, 12,
        (&t2a[0]) as u64, 13, links, (&t2b[0]) as u64, 91,
        style.TOK_TEXT_MUTED)
    // KEINE KOPFZEILE DARF AUS IHREM FELD LAUFEN. Gemessen wird mit
    // demselben `render.pref_of`, mit dem die Knoepfe oben gemessen
    // sind; passt es nicht, wird kein Bild geschrieben.
    if t1w > 900.0 || t2w > 1100.0 {
        var zb: [u8; 51] = "gallery6: eine Kopfzeile ist breiter als ihr Band.\n"
        rt.write_everything(2, (&zb[0]) as u64, 51)
        return 8
    }

    // ---- ZUSCHNEIDEN, DANN SCHREIBEN. Ohne das haengt unter dem
    // letzten Band der Rest der Hoechsthoehe als leerer Streifen.
    let grund: u32 = canvas.canvas_get(&cv, 2, 2)
    var ende: usize = inhalt_unten(&cv, grund) + RAND_UNTEN
    if ende > H {
        ende = H
    }
    var bild: canvas.Canvas = canvas.canvas_new()
    if !zuschnitt(&cv, &bild, ende) {
        return 9
    }
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&bild, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var pk: usize = 0
    while pk < rt.c_length(path) {
        rt.buf_push(&pf, rt.ld8(path, pk))
        pk = pk + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 10] = "GALLERY 6\n"
    rt.write_everything(1, (&okm[0]) as u64, 10)
    painter.painter_free(&z)
    canvas.canvas_free(&bild)
    canvas.canvas_free(&cv)
    return 0
}
