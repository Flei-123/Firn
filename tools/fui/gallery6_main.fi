// SPDX-License-Identifier: MPL-2.0
// tools/fui/gallery6_main.fi -- FLEX AS A PICTURE.
//
// Flexbox can be shown only by comparison: THE SAME children, once
// per setting. Every variant stands in a frame, so that you see
// where the container ends and where the air is distributed, and every
// child carries its number -- otherwise with `row-reverse` you do not see
// that the axis has turned and not just the boxes have been shifted.
//
// The right column shows what only the flexbox can do: wrapping with
// align-content, the column direction in both directions of travel, and
// RIGHT AT THE BOTTOM the bridge to the measuring protocol -- a toolbar of
// real buttons whose basis `render.pref_of` has measured.
//
//     gallery6_main <out.png> [light|dark] [<font.ttf>]
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.layout
import fui.flex

const FONTSET_BYTES: usize = 4096
const W: usize = 1240
// H IS THE MAXIMUM HEIGHT, NOT THE IMAGE HEIGHT -- the same rule as
// in tools/fui/gallery3_main.fi. How high the sheet really becomes
// is known only by the last band drawn; if H also stood in the picture,
// an empty strip hung underneath (measured 42 points) that in the dark
// scheme looks like a half-rendered proof.
const H: usize = 880
// The margin that stays standing under the last content: the same
// measure with which the sheet begins at the top.
const BORDER_BELOW: usize = 20

// The left and the right column of the sheet.
const LX: f64 = 24.0
const LW: f64 = 560.0
const RX: f64 = 648.0
const RW: f64 = 568.0

fn label(c: *mut render.Ctx, x: f64, y: f64, w: f64, px: usize, p: u64,
    n: usize, tok: u32) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, w, 18.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(tok))
    *s = style.style_set_font(*s, 0, px)
    *s = style.style_set_pad(*s, 0, 0)
    render.draw_label(c, &e)
}

// A HEADING WHOSE NUMBER IS COUNTED AND WHOSE WIDTH IS MEASURED.
//
// This sheet has already had two errors, and both look the same from
// afar: a line that claims something different from the picture below it.
// Once it was the NUMBER ("fourteen rules" over thirteen boxes), once the WIDTH
// (a line that ran out of its field and was hard cut off). That is why this
// function sets the number from the counted value and returns the
// target width MEASURED by `render.pref_of` -- the caller compares it with
// the band and aborts, instead of delivering a truncated word.
fn titelzeile(c: *mut render.Ctx, x: f64, y: f64, w: f64, px: usize,
    pre: u64, npre: usize, n: usize, post: u64, npost: usize,
    tok: u32) -> f64 {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, pre, npre)
    rt.buf_push_dec_u64(&t, n as u64)
    rt.buf_push_bytes(&t, post, npost)
    label(c, x, y, w, px, rt.buf_ptr(&t), rt.buf_len(&t), tok)
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, w, 18.0)
    widget.w_set_text(&e, rt.buf_ptr(&t), rt.buf_len(&t))
    let sy: *mut style.Style = widget.w_style(&e)
    *sy = style.style_set_font(*sy, 0, px)
    *sy = style.style_set_pad(*sy, 0, 0)
    var pw: f64 = 0.0
    var ph: f64 = 0.0
    render.pref_of(c, &e, &pw, &ph)
    rt.buf_free(&t)
    return pw
}

// ==================================== THE BRIDGE TO THE MEASURING PROTOCOL
//
// `render.pref_of` is the existing measuring protocol and stays the
// only one: it measures a widget with font, image and inner margin and
// returns f64. The flexbox calculates in integers. Exactly HERE, in the
// caller, stands the conversion -- lib/fui/flex.fi stays kernel-pure and
// does not import render.fi; it brings along only the pure
// number function `flex_item_from_pref`, so that not every
// call site rounds differently.
fn item_von_widget(c: *mut render.Ctx, e: *mut widget.Widget,
    line: bool) -> flex.FlexItem {
    var pw: f64 = 0.0
    var ph: f64 = 0.0
    render.pref_of(c, e, &pw, &ph)
    return flex.flex_item_from_pref(pw, ph, line)
}

// A frame with a heading. The heading stands ABOVE the
// frame, so that it never runs into the distributed children.
// WHAT COMES BACK IS THE ONE that this box contributes to the count.
// The heading of the sheet names a number of cases, and this
// number used to be typed by hand: "fourteen rules" stood above
// thirteen painted boxes, because somebody added a case and
// forgot the heading. Whoever ADDS the number instead of claiming it
// cannot forget it any more -- the heading is therefore set right at the end
// from the sums.
fn frame(c: *mut render.Ctx, m: *mut theme.Theme, x: f64, y: f64,
    w: f64, h: f64, nm: u64, nn: usize) -> usize {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let f: *mut theme.Colors = theme.theme_colors(m)
    label(c, x, y, w, 12, nm, nn, style.TOK_TEXT)
    painter.round_rect(z, x, y + 20.0, w, h, 8.0,
        theme.opaque((*f).surface))
    return 1
}

// A distributed child: the box and its number. The number only
// if the box is wide enough for it -- a cut-off
// character would be exactly the error that this sheet is meant to uncover.
fn kind(c: *mut render.Ctx, m: *mut theme.Theme, r: *mut layout.Rect,
    digits: u64, i: usize) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let f: *mut theme.Colors = theme.theme_colors(m)
    let x: f64 = layout.rect_x(r) as f64
    let y: f64 = layout.rect_y(r) as f64
    let w: f64 = layout.rect_w(r) as f64
    let h: f64 = layout.rect_h(r) as f64
    painter.round_rect(z, x, y, w, h, 6.0, theme.opaque((*f).accent))
    if w >= 26.0 && h >= 16.0 {
        label(c, x + 9.0, y + h / 2.0 - 9.0, w - 12.0, 11,
            digits + i as u64, 1, style.TOK_TEXT_ON_ACCENT)
    }
}

// A variant: frame, heading, distribute, paint children.
fn variant(c: *mut render.Ctx, m: *mut theme.Theme, x: f64, y: f64,
    w: f64, h: f64, s: *mut flex.FlexBox, k: *mut flex.FlexItem,
    n: usize, nm: u64, nn: usize, digits: u64) -> usize {
    var counted: usize = frame(c, m, x, y, w, h, nm, nn)
    var out: [layout.Rect; 8] = [layout.rect_new(0, 0, 0, 0); 8]
    var gr: [i64; 8] = [0; 8]
    var fz: [i64; 8] = [0; 8]
    flex.flex_layout(s, layout.rect_new(x as i64, (y + 20.0) as i64,
            w as i64, h as i64), k, n, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var i: usize = 0
    while i < n {
        kind(c, m, &out[i], digits, i)
        i = i + 1
    }
    return counted
}

// THE LOWEST ROW IN WHICH SOMETHING STILL STANDS, as a HEIGHT (so one
// behind the last painted row). It is asked of the canvas
// itself and not of a number carried along: this sheet sets its
// bands from `flex.flex_layout`, and its result is fixed
// only after it has calculated.
fn content_below(cv: *mut canvas.Canvas, bg: u32) -> usize {
    let w: usize = canvas.canvas_width(cv)
    var y: usize = canvas.canvas_height(cv)
    while y > 0 {
        y = y - 1
        var x: usize = 0
        while x < w {
            if canvas.canvas_get(cv, x, y) != bg {
                return y + 1
            }
            x = x + 1
        }
    }
    return 0
}

// THE CANVAS ENDS WHERE THE CONTENT ENDS. A second canvas of the
// true height, copied raw point by point -- copying is no
// painting, and an alpha value that runs twice through the mixing
// would come out lighter than it was. Word for word the same as
// tools/fui/gallery3_main.fi:50.
fn zuschnitt(src: *mut canvas.Canvas, dst: *mut canvas.Canvas,
    height: usize) -> bool {
    var h: usize = height
    if h > canvas.canvas_height(src) {
        h = canvas.canvas_height(src)
    }
    if h == 0 {
        return false
    }
    let w: usize = canvas.canvas_width(src)
    if !canvas.canvas_init(dst, w, h) {
        return false
    }
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            canvas.canvas_set_raw(dst, x, y, canvas.canvas_get(src, x, y))
            x = x + 1
        }
        y = y + 1
    }
    return true
}

// ============ THE GRID IS RE-CALCULATED (like gallery7/gallery8)
//
// The proof check from outside sees only THAT colour stands somewhere.
// Whether a label really stands in ITS row or has slipped into the band
// above it is known only by this program.
static mut G_ERROR: usize = 0

fn verlange(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 44 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "FALSCH  "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERROR = G_ERROR + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    var w: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&w[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// How many pixels in y0..y1 differ from the background.
fn band_has_color(cv: *mut canvas.Canvas, y0: usize, y1: usize,
    bg: u32) -> i64 {
    let w: usize = canvas.canvas_width(cv)
    var n: i64 = 0
    var y: usize = y0
    while y <= y1 && y < canvas.canvas_height(cv) {
        var x: usize = 0
        while x < w {
            if canvas.canvas_get(cv, x, y) != bg {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 47] = "gallery6_main <out.png> [light|dark] [font.ttf]"
        rt.write_everything(2, (&u[0]) as u64, 47)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    var dark: bool = true
    if rt.arg_count(start) >= 3 {
        if rt.ld8(rt.arg_ptr(start, 2), 0) == 108 as u8 {
            dark = false
        }
    }
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
    rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    // NO FONT, NO PROOF. A picture without a single
    // letter looks like a picture from afar, and that is exactly how
    // a text-less surface got through the acceptance in OrientOS. A proof without a label proves nothing -- so
    // an error on fd 2 and a return value on which the run
    // gets stuck, instead of writing a silent PNG.
    if fm == 0 {
        var ks: [u8; 60] = "gallery6: keine Schrift gefunden -- ohne Schrift kein Beleg\n"
        rt.write_everything(2, (&ks[0]) as u64, 60)
        return 9
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 300) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(dark)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque((*f).base))

    var ziff: [u8; 8] = "12345678"
    let zp: u64 = (&ziff[0]) as u64

    // The two header rows are set RIGHT AT THE END: they name
    // how many cases the sheet shows, and these numbers arise
    // only while painting. `links` are the rules of the left column,
    // `rechts` those of the right; together they are the cases of the
    // sheet.
    var left: usize = 0
    var right: usize = 0

    // =============================================== THE LEFT COLUMN
    //
    // Always the same three children of 120 in a frame of 560 with
    // 8 inner margin and 8 gap: 544 - 376 = 168 pixels of air that
    // land elsewhere depending on the rule.
    var k: [flex.FlexItem; 3] = [flex.flex_item(120, 28); 3]
    var s1: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_padding(&s1, 8, 8, 8, 8)
    flex.flex_set_gap(&s1, 8, 8)
    flex.flex_set_align_items(&s1, flex.AL_CENTER)
    let kp: *mut flex.FlexItem = (&k[0]) as *mut flex.FlexItem
    var y: f64 = 80.0
    var a1: [u8; 27] = "justify-content: flex-start"
    left = left + variant(&c, &m, LX, y, LW, 46.0, &s1, kp, 3,
        (&a1[0]) as u64, 27, zp)
    y = y + 84.0
    flex.flex_set_justify(&s1, flex.JUSTIFY_CENTER)
    var a2: [u8; 23] = "justify-content: center"
    left = left + variant(&c, &m, LX, y, LW, 46.0, &s1, kp, 3,
        (&a2[0]) as u64, 23, zp)
    y = y + 84.0
    flex.flex_set_justify(&s1, flex.JUSTIFY_BETWEEN)
    var a3: [u8; 30] = "justify-content: space-between"
    left = left + variant(&c, &m, LX, y, LW, 46.0, &s1, kp, 3,
        (&a3[0]) as u64, 30, zp)
    y = y + 84.0
    flex.flex_set_justify(&s1, flex.JUSTIFY_EVENLY)
    var a4: [u8; 29] = "justify-content: space-evenly"
    left = left + variant(&c, &m, LX, y, LW, 46.0, &s1, kp, 3,
        (&a4[0]) as u64, 29, zp)
    y = y + 84.0
    // Growing: the middle child takes the whole 168 in addition.
    flex.flex_set_justify(&s1, flex.JUSTIFY_START)
    var g: [flex.FlexItem; 3] = [flex.flex_item(120, 28); 3]
    flex.item_set_flex(&g[1], 1000, 1000, 120)
    var a5: [u8; 33] = "flex-grow: 1 on the middle child "
    left = left + variant(&c, &m, LX, y, LW, 46.0, &s1,
        (&g[0]) as *mut flex.FlexItem, 3, (&a5[0]) as u64, 33, zp)
    y = y + 84.0
    // Shrinking: a frame that is too narrow. The bases 260/130/130
    // are together 520, 344 fit in -- 176 are missing, and those
    // go by shrink TIMES basis, so twice as much from the wide one.
    var sh: [flex.FlexItem; 3] = [flex.flex_item(260, 28); 3]
    sh[1] = flex.flex_item(130, 28)
    sh[2] = flex.flex_item(130, 28)
    flex.item_set_bounds(&sh[2], 96, 0)
    var a6: [u8; 41] = "flex-shrink: weighted, the last one stops"
    left = left + variant(&c, &m, LX, y, 376.0, 46.0, &s1,
        (&sh[0]) as *mut flex.FlexItem, 3, (&a6[0]) as u64, 41, zp)
    y = y + 84.0
    // Ausrichtung quer: start / center / end / stretch nebeneinander.
    var q: [flex.FlexItem; 4] = [flex.flex_item(120, 18); 4]
    flex.item_set_align(&q[0], flex.AL_START)
    flex.item_set_align(&q[1], flex.AL_CENTER)
    flex.item_set_align(&q[2], flex.AL_END)
    flex.item_set_align(&q[3], flex.AL_STRETCH)
    // This row gets a LARGER inner margin than the others.
    // The frame is rounded with radius 8; a child that with
    // `align-self: start` or `end` moves entirely to the inner margin
    // sits at inner margin 8 exactly on the centre of the corner arc and
    // thereby visually runs into the rounding. 12 keeps it a full 4
    // pixels outside the arc -- the edge of the frame stays
    // visible all around.
    var s2: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_padding(&s2, 12, 12, 12, 12)
    flex.flex_set_gap(&s2, 8, 8)
    var a7: [u8; 42] = "align-self: start / center / end / stretch"
    left = left + variant(&c, &m, LX, y, LW, 64.0, &s2,
        (&q[0]) as *mut flex.FlexItem, 4, (&a7[0]) as u64, 42, zp)
    y = y + 102.0
    // align-content: stretch -- the LINES themselves grow until they fill
    // the box across. Five children of 160 in 544 usable width
    // give 3 + 2 lines; of 124 height 48 are occupied and 10 gap,
    // the remaining 66 go half each to the two lines.
    var st: [flex.FlexItem; 5] = [flex.flex_item(160, 24); 5]
    var s3: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_padding(&s3, 8, 8, 8, 8)
    flex.flex_set_gap(&s3, 10, 10)
    flex.flex_set_wrap(&s3, flex.WRAP_WRAP)
    flex.flex_set_align_content(&s3, flex.AC_STRETCH)
    var a8: [u8; 41] = "align-content: stretch, the rows grow too"
    left = left + variant(&c, &m, LX, y, LW, 140.0, &s3,
        (&st[0]) as *mut flex.FlexItem, 5, (&a8[0]) as u64, 41, zp)

    // ============================================= THE RIGHT COLUMN
    //
    // Seven children of 160 with 10 gap in 552 usable width:
    // 160+10+160+10+160 = 500 fits, the fourth no longer. So
    // 3 + 3 + 1 lines.
    var wk: [flex.FlexItem; 7] = [flex.flex_item(160, 30); 7]
    let wp: *mut flex.FlexItem = (&wk[0]) as *mut flex.FlexItem
    var sw: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_padding(&sw, 8, 8, 8, 8)
    flex.flex_set_gap(&sw, 10, 10)
    flex.flex_set_wrap(&sw, flex.WRAP_WRAP)
    flex.flex_set_align_items(&sw, flex.AL_START)
    flex.flex_set_align_content(&sw, flex.AC_START)
    var r: f64 = 80.0
    var b1: [u8; 38] = "flex-wrap: wrap, align-content: start "
    right = right + variant(&c, &m, RX, r, RW, 150.0, &sw, wp, 7,
        (&b1[0]) as u64, 38, zp)
    r = r + 188.0
    flex.flex_set_align_content(&sw, flex.AC_BETWEEN)
    var b2: [u8; 46] = "flex-wrap: wrap, align-content: space-between "
    right = right + variant(&c, &m, RX, r, RW, 150.0, &sw, wp, 7,
        (&b2[0]) as u64, 46, zp)
    r = r + 188.0
    // Reversed: the numbers run from right to left, and with
    // `flex-start` the row sticks to the RIGHT.
    var rv: [flex.FlexItem; 3] = [flex.flex_item(120, 28); 3]
    var sr: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW_REVERSE)
    flex.flex_set_padding(&sr, 8, 8, 8, 8)
    flex.flex_set_gap(&sr, 8, 8)
    flex.flex_set_align_items(&sr, flex.AL_CENTER)
    var b3: [u8; 43] = "flex-direction: row-reverse, start is right"
    right = right + variant(&c, &m, RX, r, RW, 46.0, &sr,
        (&rv[0]) as *mut flex.FlexItem, 3, (&b3[0]) as u64, 43, zp)
    r = r + 84.0
    // The column direction, both directions of travel side by side: on the left
    // the 1 stands at the top, on the right at the bottom.
    var cl: [flex.FlexItem; 3] = [flex.flex_item(40, 28); 3]
    var sc: flex.FlexBox = flex.flexbox_new(flex.FLEX_COLUMN)
    flex.flex_set_padding(&sc, 8, 8, 8, 8)
    flex.flex_set_gap(&sc, 8, 8)
    flex.flex_set_justify(&sc, flex.JUSTIFY_CENTER)
    var b4: [u8; 28] = "flex-direction: column      "
    right = right + variant(&c, &m, RX, r, 274.0, 170.0, &sc,
        (&cl[0]) as *mut flex.FlexItem, 3, (&b4[0]) as u64, 28, zp)
    var sd: flex.FlexBox = flex.flexbox_new(flex.FLEX_COLUMN_REVERSE)
    flex.flex_set_padding(&sd, 8, 8, 8, 8)
    flex.flex_set_gap(&sd, 8, 8)
    flex.flex_set_justify(&sd, flex.JUSTIFY_CENTER)
    var b5: [u8; 28] = "flex-direction: column-rev. "
    right = right + variant(&c, &m, RX + 294.0, r, 274.0, 170.0, &sd,
        (&cl[0]) as *mut flex.FlexItem, 3, (&b5[0]) as u64, 28, zp)
    r = r + 208.0

    // =============== THE BRIDGE: MEASURED BUTTONS, ALIGNED RIGHT
    //
    // Four real buttons. Their basis comes from `render.pref_of` and
    // not from a guessed number -- that is why each is exactly as wide
    // as its label together with the inner margin demands, and none
    // cuts off.
    var b6: [u8; 47] = "measured with render.pref_of, justify: flex-end"
    right = right + frame(&c, &m, RX, r, RW, 56.0, (&b6[0]) as u64, 47)
    var bt: [widget.Widget; 4] =
    [widget.widget_new(widget.KIND_BUTTON); 4]
    var x1: [u8; 4] = "Open"
    var x2: [u8; 4] = "Save"
    var x3: [u8; 6] = "Delete"
    var x4: [u8; 6] = "Cancel"
    widget.w_set_text(&bt[0], (&x1[0]) as u64, 4)
    widget.w_set_text(&bt[1], (&x2[0]) as u64, 4)
    widget.w_set_text(&bt[2], (&x3[0]) as u64, 6)
    widget.w_set_text(&bt[3], (&x4[0]) as u64, 6)
    var bi: [flex.FlexItem; 4] = [flex.flex_item(0, 0); 4]
    var i: usize = 0
    while i < 4 {
        bi[i] = item_von_widget(&c, &bt[i], true)
        i = i + 1
    }
    var sb: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_padding(&sb, 10, 10, 10, 10)
    flex.flex_set_gap(&sb, 8, 8)
    flex.flex_set_justify(&sb, flex.JUSTIFY_END)
    flex.flex_set_align_items(&sb, flex.AL_CENTER)
    var bo: [layout.Rect; 8] = [layout.rect_new(0, 0, 0, 0); 8]
    var bg: [i64; 8] = [0; 8]
    var bf: [i64; 8] = [0; 8]
    flex.flex_layout(&sb, layout.rect_new(RX as i64, (r + 20.0) as i64,
            RW as i64, 56.0 as i64), (&bi[0]) as *mut flex.FlexItem, 4,
        (&bo[0]) as *mut layout.Rect, (&bg[0]) as *mut i64,
        (&bf[0]) as *mut i64)
    i = 0
    while i < 4 {
        widget.w_place(&bt[i], layout.rect_x(&bo[i]) as f64,
            layout.rect_y(&bo[i]) as f64, layout.rect_w(&bo[i]) as f64,
            layout.rect_h(&bo[i]) as f64)
        render.draw_button(&c, &bt[i])
        i = i + 1
    }

    // ========================================== NOW THE HEADER ROWS
    //
    // Title and subline are each ONE complete sentence -- formerly
    // one sentence ran over both rows, and whoever read only the title
    // got half a predicate. The numbers in it are those just
    // counted, not those remembered.
    var t1a: [u8; 32] = "FLEX -- the same children under "
    var t1b: [u8; 6] = " rules"
    let t1w: f64 = titelzeile(&c, LX, 20.0, 900.0, 15,
        (&t1a[0]) as u64, 32, left + right, (&t1b[0]) as u64, 6,
        style.TOK_TEXT)
    var t2a: [u8; 13] = "on the left, "
    var t2b: [u8; 91] =
    " ways to spend the free space in one row; on the right, wrap, columns and measured buttons."
    let t2w: f64 = titelzeile(&c, LX, 44.0, 1100.0, 12,
        (&t2a[0]) as u64, 13, left, (&t2b[0]) as u64, 91,
        style.TOK_TEXT_MUTED)
    // NO HEADER ROW MAY RUN OUT OF ITS FIELD. Measuring is done with
    // the same `render.pref_of` with which the buttons above
    // are measured; if it does not fit, no image is written.
    if t1w > 900.0 || t2w > 1100.0 {
        var zb: [u8; 51] = "gallery6: eine Kopfzeile ist breiter als ihr Band.\n"
        rt.write_everything(2, (&zb[0]) as u64, 51)
        return 8
    }

    // ---- THE TWO HEADER ROWS REALLY STAND IN THEIR ROW.
    // Set at y 20 and 44; the ascents lie below.
    let kgrund: u32 = canvas.canvas_get(&cv, 2, 2)
    var q1: [u8; 44] = "the FLEX headline is really there           "
    verlange((&q1[0]) as u64, 43,
        band_has_color(&cv, 23, 36, kgrund) > 200,
        band_has_color(&cv, 23, 36, kgrund), 200)
    var q2: [u8; 44] = "its subline is really there                 "
    verlange((&q2[0]) as u64, 43,
        band_has_color(&cv, 47, 58, kgrund) > 200,
        band_has_color(&cv, 47, 58, kgrund), 200)
    if G_ERROR > 0 {
        var gf: [u8; 60] = "gallery6: das Raster stimmt nicht -- kein Beleg geschrieben\n"
        rt.write_everything(2, (&gf[0]) as u64, 60)
        return 12
    }
    // ---- CUT, THEN WRITE. Without that the rest of the maximum height hangs
    // under the last band as an empty strip.
    let basic: u32 = canvas.canvas_get(&cv, 2, 2)
    var end: usize = content_below(&cv, basic) + BORDER_BELOW
    if end > H {
        end = H
    }
    var image: canvas.Canvas = canvas.canvas_new()
    if !zuschnitt(&cv, &image, end) {
        return 9
    }
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&image, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var pk: usize = 0
    while pk < rt.c_length(path) {
        rt.buf_push(&pf, rt.ld8(path, pk))
        pk = pk + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 10] = "GALLERY 6\n"
    rt.write_everything(1, (&okm[0]) as u64, 10)
    painter.painter_free(&z)
    canvas.canvas_free(&image)
    canvas.canvas_free(&cv)
    return 0
}
