import std.io
import std.rt
import paint.canvas
import font.metrics
import fui.ds_appcard
import fui.ds_listdetail
import fui.ds_navview
import fui.ds_vgrid
import fui.editor
import fui.lucide
import fui.painter
import fui.render
import fui.screenax
import fui.theme
import plat.sysfont

static mut BAD: usize = 0

fn expect(ok: bool, what: str) {
    if !ok {
        BAD = BAD + 1
        io.print_line(what)
    }
}

fn now_ms() -> f64 {
    var ts: [u64; 2] = [0; 2]
    syscall(228, 3, (&ts[0]) as u64)
    return (ts[0] as f64) * 1000.0 + (ts[1] as f64) / 1000000.0
}

fn check_appcard(c: *mut render.Ctx) {
    var k: ds_appcard.Card = ds_appcard.card_new()
    screenax.install()
    screenax.begin()
    ds_appcard.draw(&k, c, 20.0, 20.0, 260.0, ds_appcard.preferred_h(c), lucide.PACKAGE, "Notes", "Productivity", "4.8 stars", 0.0, 0.0)
    expect(screenax.count() >= 2, "appcard notes card + button")
    var b: [f64; 4] = [0.0; 4]
    ds_appcard.button_rect(&k, &b)
    expect(b[1] + b[3] <= 20.0 + ds_appcard.preferred_h(c), "button inside card")
    expect(ds_appcard.click(&k, b[0] + 5.0, b[1] + 5.0) == ds_appcard.ACT_INSTALL, "install action")
    ds_appcard.set_state(&k, ds_appcard.S_INSTALLING)
    ds_appcard.set_progress(&k, 420 as i64)
    screenax.begin()
    ds_appcard.draw(&k, c, 20.0, 20.0, 260.0, ds_appcard.preferred_h(c), lucide.PACKAGE, "Notes", "Productivity", "", 0.0, 0.0)
    expect(screenax.kind_of(screenax.count() - 1) == 8 as u32, "installing is a progress node")
    expect(screenax.value_of(screenax.count() - 1) == 420 as i64, "progress value")
    expect(ds_appcard.click(&k, b[0] + 5.0, b[1] + 5.0) == ds_appcard.ACT_CANCEL, "cancel action")
    ds_appcard.set_state(&k, ds_appcard.S_OPEN)
    expect(ds_appcard.click(&k, b[0] + 5.0, b[1] + 5.0) == ds_appcard.ACT_OPEN, "open action")
    ds_appcard.set_state(&k, ds_appcard.S_UPDATE)
    expect(ds_appcard.click(&k, b[0] + 5.0, b[1] + 5.0) == ds_appcard.ACT_UPDATE, "update action")
    expect(ds_appcard.click(&k, 25.0, 25.0) == ds_appcard.ACT_CARD, "card body click")
    expect(ds_appcard.click(&k, 5.0, 5.0) == ds_appcard.ACT_NONE, "miss")
    ds_appcard.set_focus(&k, true, true)
    expect(ds_appcard.key(&k, editor.KEY_ENTER, 0 as u32) == ds_appcard.ACT_UPDATE, "Enter acts")
    expect(ds_appcard.text(&k, 32 as u32, 0 as u32) == ds_appcard.ACT_UPDATE, "Space acts")
    ds_appcard.set_state(&k, ds_appcard.S_UNAVAILABLE)
    expect(ds_appcard.click(&k, b[0] + 5.0, b[1] + 5.0) == ds_appcard.ACT_CARD, "unavailable button is inert")
}

fn nav_fill(v: *mut ds_navview.NavView) {
    ds_navview.add(v, lucide.HOUSE, "Home")
    ds_navview.add(v, lucide.PACKAGE, "Apps")
    ds_navview.add(v, lucide.DOWNLOAD, "Downloads")
    ds_navview.add_footer(v, lucide.SETTINGS, "Settings")
}

fn check_navview(c: *mut render.Ctx) {
    var v: ds_navview.NavView = ds_navview.nv_new()
    nav_fill(&v)
    expect(ds_navview.item_count(&v) == 4, "nav items")
    ds_navview.layout(&v, c, 0.0, 0.0, 1200.0, 700.0)
    expect(ds_navview.mode(&v) == ds_navview.MODE_EXPANDED, "wide = expanded")
    expect(ds_navview.content_x(&v) == ds_navview.pane_w(&v), "content beside pane")
    ds_navview.draw(&v, c, 0.0, 0.0)
    expect(ds_navview.press(&v, 40.0, 90.0) == ds_navview.EV_SELECT || ds_navview.press(&v, 40.0, 140.0) == ds_navview.EV_SELECT, "click selects")
    ds_navview.select(&v, 0)
    expect(ds_navview.key(&v, editor.KEY_DOWN, 0 as u32) == ds_navview.EV_SELECT && ds_navview.selected(&v) == 1, "Down moves")
    expect(ds_navview.key(&v, editor.KEY_END, 0 as u32) == ds_navview.EV_SELECT && ds_navview.selected(&v) == 3, "End reaches footer item")
    expect(ds_navview.is_footer(&v, 3), "footer index")
    expect(ds_navview.key(&v, editor.KEY_DOWN, 0 as u32) == ds_navview.EV_NONE, "no move past the end")
    ds_navview.layout(&v, c, 0.0, 0.0, 800.0, 700.0)
    expect(ds_navview.mode(&v) == ds_navview.MODE_COMPACT, "medium = compact")
    expect(ds_navview.pane_w(&v) < 100.0, "compact pane is narrow")
    ds_navview.layout(&v, c, 0.0, 0.0, 400.0, 700.0)
    expect(ds_navview.mode(&v) == ds_navview.MODE_MINIMAL, "narrow = minimal")
    expect(ds_navview.content_y(&v) > 0.0 && ds_navview.content_x(&v) == 0.0, "minimal has a top bar, no pane")
    ds_navview.draw(&v, c, 0.0, 0.0)
    expect(ds_navview.press(&v, 20.0, 20.0) == ds_navview.EV_TOGGLE && ds_navview.overlay_open(&v), "menu opens overlay")
    ds_navview.draw_overlay(&v, c, 0.0, 0.0)
    expect(ds_navview.key(&v, editor.KEY_ESC, 0 as u32) == ds_navview.EV_DISMISS && !ds_navview.overlay_open(&v), "Esc closes overlay")
    ds_navview.press(&v, 20.0, 20.0)
    expect(ds_navview.press(&v, 390.0, 600.0) == ds_navview.EV_DISMISS, "scrim closes overlay")
    ds_navview.set_back(&v, true)
    ds_navview.layout(&v, c, 0.0, 0.0, 400.0, 700.0)
    expect(ds_navview.press(&v, 20.0, 20.0) == ds_navview.EV_BACK, "back button")
}

fn check_listdetail(c: *mut render.Ctx) {
    var l: ds_listdetail.ListDetail = ds_listdetail.ld_new()
    ds_listdetail.set_count(&l, 50)
    ds_listdetail.layout(&l, c, 0.0, 0.0, 1000.0, 600.0)
    expect(!ds_listdetail.stacked(&l) && ds_listdetail.detail_visible(&l), "wide = split")
    expect(ds_listdetail.detail_x(&l) > ds_listdetail.list_w(&l), "detail right of list")
    expect(ds_listdetail.selected(&l) == 0, "split selects the first")
    ds_listdetail.draw_chrome(&l, c, "Item", 0.0, 0.0)
    expect(ds_listdetail.key(&l, editor.KEY_DOWN, 0 as u32) == ds_listdetail.EV_SELECT && ds_listdetail.selected(&l) == 1, "Down selects next")
    ds_listdetail.layout(&l, c, 0.0, 0.0, 400.0, 600.0)
    expect(ds_listdetail.stacked(&l) && !ds_listdetail.detail_visible(&l), "narrow = stacked list")
    expect(ds_listdetail.press(&l, 100.0, 80.0) == ds_listdetail.EV_OPEN && ds_listdetail.detail_visible(&l), "click opens detail")
    ds_listdetail.draw_chrome(&l, c, "Item", 0.0, 0.0)
    expect(ds_listdetail.press(&l, 20.0, 20.0) == ds_listdetail.EV_BACK && !ds_listdetail.detail_visible(&l), "back bar returns")
    ds_listdetail.press(&l, 100.0, 80.0)
    expect(ds_listdetail.key(&l, editor.KEY_ESC, 0 as u32) == ds_listdetail.EV_BACK, "Esc returns")
}

fn check_vgrid(c: *mut render.Ctx) {
    var g: ds_vgrid.Grid = ds_vgrid.grid_new()
    ds_vgrid.set_count(&g, 5000)
    ds_vgrid.set_cell(&g, 240, 148, 12)
    ds_vgrid.layout(&g, c, 0.0, 0.0, 1240.0, 720.0)
    let cols: usize = ds_vgrid.columns(&g)
    expect(cols >= 4, "columns from width")
    expect(ds_vgrid.rows(&g) * cols >= 5000 && (ds_vgrid.rows(&g) - 1) * cols < 5000, "row count")
    let shown: usize = ds_vgrid.end_index(&g) - ds_vgrid.first(&g)
    expect(shown > 0 && shown <= cols * 8, "only the visible rows are produced")
    ds_vgrid.wheel(&g, 3.0, 1000 as i64)
    var t: i64 = 1000
    while t < 1600 { ds_vgrid.tick(&g, t); t = t + 16 }
    expect(ds_vgrid.scroll_y(&g) > 100.0, "wheel scrolls")
    expect(ds_vgrid.first(&g) >= cols, "range follows scroll")
    var r: [f64; 4] = [0.0; 4]
    let f: usize = ds_vgrid.first(&g)
    ds_vgrid.cell_rect(&g, f, &r)
    expect(ds_vgrid.index_at(&g, r[0] + 3.0, r[1] + r[3] / 2.0) == f || r[1] < 0.0, "hit finds the cell")
    ds_vgrid.cell_rect(&g, f + 1, &r)
    expect(ds_vgrid.index_at(&g, r[0] + 3.0, r[1] + 3.0) == f + 1 || r[1] < 0.0, "hit finds the next cell")
    expect(ds_vgrid.index_at(&g, r[0] - 2.0, r[1] + 3.0) == ds_vgrid.NONE, "gap hits nothing")
    ds_vgrid.select(&g, 0)
    ds_vgrid.scroll_by(&g, 0.0 - 100000.0)
    expect(ds_vgrid.key(&g, editor.KEY_DOWN, 0 as u32) && ds_vgrid.selected(&g) == cols, "Down moves one row")
    expect(ds_vgrid.key(&g, editor.KEY_RIGHT, 0 as u32) && ds_vgrid.selected(&g) == cols + 1, "Right moves one cell")
    expect(ds_vgrid.key(&g, editor.KEY_END, 0 as u32) && ds_vgrid.selected(&g) == 4999, "End reaches the last")
    expect(ds_vgrid.scroll_y(&g) > 1000.0, "End scrolls the last row into view")
    expect(ds_vgrid.key(&g, editor.KEY_HOME, 0 as u32) && ds_vgrid.selected(&g) == 0 && ds_vgrid.scroll_y(&g) == 0.0, "Home returns")
    ds_vgrid.layout(&g, c, 0.0, 0.0, 360.0, 720.0)
    expect(ds_vgrid.columns(&g) == 1, "phone width = one column")
}

#[allow_escape]
fn check_bench(c: *mut render.Ctx) {
    var g: ds_vgrid.Grid = ds_vgrid.grid_new()
    ds_vgrid.set_count(&g, 5000)
    ds_vgrid.set_cell(&g, 240, ds_appcard.preferred_h(c) as usize, 12)
    ds_vgrid.layout(&g, c, 0.0, 0.0, 1240.0, 720.0)
    var slots: [ds_appcard.Card; 64] = [ds_appcard.card_new(); 64]
    var best: f64 = 1000000.0
    var rep: usize = 0
    while rep < 5 {
        var sweep: usize = 0
        var worst: f64 = 0.0
        while sweep < 60 {
            if sweep < 30 { ds_vgrid.scroll_by(&g, 37.0) } else { ds_vgrid.scroll_by(&g, 0.0 - 37.0) }
            let t0: f64 = now_ms()
            screenax.begin()
            ds_vgrid.begin(&g, c, "Apps")
            var n: usize = ds_vgrid.first(&g)
            let e: usize = ds_vgrid.end_index(&g)
            while n < e {
                var r: [f64; 4] = [0.0; 4]
                ds_vgrid.cell_rect(&g, n, &r)
                ds_appcard.draw(&slots[n % 64], c, r[0], r[1], r[2], r[3], lucide.PACKAGE, "Application", "Publisher", "4.8 stars", 0.0, 0.0)
                n = n + 1
            }
            ds_vgrid.finish(&g, c)
            let dt: f64 = now_ms() - t0
            if dt > worst { worst = dt }
            sweep = sweep + 1
        }
        if worst < best { best = worst }
        rep = rep + 1
    }
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&nb, ("ds_catalog: 5000-card grid, worst scroll frame (min of 5 sweeps), microseconds: ").p as u64, ("ds_catalog: 5000-card grid, worst scroll frame (min of 5 sweeps), microseconds: ").n)
    rt.buf_push_dec_i64(&nb, (best * 1000.0) as i64)
    rt.buf_push_bytes(&nb, ("\n").p as u64, ("\n").n)
    rt.write_everything(1, rt.buf_ptr(&nb), rt.buf_len(&nb))
    expect(best <= 16.0, "5000-card grid frame over 16 ms")
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        io.print_line("ds_catalog: no font")
        return 9
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    var z: painter.Painter = painter.painter_new()
    if !canvas.canvas_init(&cv, 1240, 720) || !painter.painter_init(&z, &cv, 1240, 720) {
        io.print_line("ds_catalog: canvas")
        return 9
    }
    painter.painter_set_font(&z, fs as u64)
    var m: theme.Theme = theme.theme_new(true)
    var cx: render.Ctx = render.ctx_new(&m, &z)
    let c: *mut render.Ctx = &cx
    check_appcard(c)
    check_navview(c)
    check_listdetail(c)
    check_vgrid(c)
    if rt.arg_count(start) >= 2 { check_bench(c) }
    if BAD > 0 {
        io.print_line("DS_CATALOG FAILED")
        return 1
    }
    io.print_line("DS_CATALOG PASSED")
    return 0
}
