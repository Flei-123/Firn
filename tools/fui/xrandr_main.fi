// SPDX-License-Identifier: MPL-2.0
// tools/fui/xrandr_main.fi -- XRandR refresh-rate query of the X11 back end (r212)
//
//     xrandr_main            pure checks (hand-computed octets), prints XRANDR PASSED / FAILED
//     xrandr_main live       additionally opens a window on $DISPLAY and prints the reported rate
//                            (XRANDR LIVE hz=N, 0 = the server did not tell)
//
// The back end comes in through tools/fui/window/backend.fi (a link to lib/window/x11.fi).
import std.rt
import window.backend
import window.window

static mut FAILS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_num(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(ok: bool, what: str) {
    if !ok {
        FAILS = FAILS + 1
        say("FAIL: ")
        say(what)
        say("\n")
    }
}

fn same(b: *mut rt.Buf, want: *mut [u8; 12], n: usize) -> bool {
    if rt.buf_len(b) != n {
        return false
    }
    var i: usize = 0
    while i < n {
        if rt.ld8(rt.buf_ptr(b), i) != (*want)[i] {
            return false
        }
        i = i + 1
    }
    return true
}

fn main(start: u64) -> i32 {
    // RRQueryVersion, opcode 140, version 1.2: length 3 units
    var b: rt.Buf = rt.buf_new()
    backend.req_randr_query_version(&b, 140 as u32, 1 as u32, 2 as u32)
    var w1: [u8; 12] = [140 as u8, 0 as u8, 3 as u8, 0 as u8, 1 as u8, 0 as u8, 0 as u8, 0 as u8, 2 as u8, 0 as u8, 0 as u8, 0 as u8]
    check(same(&b, &w1, 12), "RRQueryVersion octets")
    rt.buf_free(&b)

    // RRGetScreenInfo, minor 5, length 2, window 0x2a
    var g: rt.Buf = rt.buf_new()
    backend.req_randr_get_screen_info(&g, 140 as u32, 42 as u32)
    var w2: [u8; 12] = [140 as u8, 5 as u8, 2 as u8, 0 as u8, 42 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    check(same(&g, &w2, 8), "RRGetScreenInfo octets")
    rt.buf_free(&g)

    // replies: a 32-octet reply with the rate at octet 26
    var rep: [u8; 32] = [0 as u8; 32]
    rep[0] = 1 as u8
    rep[26] = 60 as u8
    check(backend.randr_rate_of_reply((&rep[0]) as u64, 32) == 60, "60 Hz")
    rep[26] = 144 as u8
    check(backend.randr_rate_of_reply((&rep[0]) as u64, 32) == 144, "144 Hz")
    rep[26] = 0 as u8
    rep[27] = 1 as u8
    check(backend.randr_rate_of_reply((&rep[0]) as u64, 32) == 256, "high octet counts (256 Hz)")
    rep[27] = 0 as u8
    check(backend.randr_rate_of_reply((&rep[0]) as u64, 32) == 0, "0 = unknown")
    rep[26] = 29 as u8
    check(backend.randr_rate_of_reply((&rep[0]) as u64, 32) == 0, "29 Hz is implausible")
    rep[26] = 75 as u8
    check(backend.randr_rate_of_reply((&rep[0]) as u64, 31) == 0, "short reply")
    rep[0] = 0 as u8
    check(backend.randr_rate_of_reply((&rep[0]) as u64, 32) == 0, "error packet is no reply")

    if rt.arg_count(start) > 1 {
        var f: window.Window = window.window_new()
        if window.open_window(&f, 0) {
            say("XRANDR LIVE hz=")
            say_num(window.refresh_hz(&f))
            say("\n")
            window.close_window(&f)
        } else {
            say("XRANDR LIVE: no X server\n")
        }
    }
    if FAILS > 0 {
        say("XRANDR FAILED\n")
        return 1
    }
    say("XRANDR PASSED\n")
    return 0
}
