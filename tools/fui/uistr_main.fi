// tools/fui/uistr_main.fi -- THE CHECK OF lib/fui/uistr.fi (localised standard texts, gap list #64).
// Pure: no window. Exit 1 on any WRONG.
import std.rt
import fui.uistr

static mut BAD: usize = 0

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }

fn check(ok: bool, what: str) {
    if ok { say("  ok    ") } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn eq(a: str, b: str) -> bool {
    if a.n != b.n { return false }
    var i: usize = 0
    while i < a.n {
        if *((a.p as u64 + i as u64) as *mut u8) != *((b.p as u64 + i as u64) as *mut u8) { return false }
        i = i + 1
    }
    return true
}

fn main(start: u64) -> i32 {
    say("== uistr ==\n")
    check(uistr.lang() == uistr.LANG_EN, "default language is English")
    check(eq(uistr.t("colordlg.ok", "OK"), "OK") && eq(uistr.t("filedlg.cancel", "Cancel"), "Cancel"), "English returns the given text")
    check(eq(uistr.t("filedlg.home", "Home"), "Home"), "English: Home")
    check(uistr.set_lang_tag("de"), "set 'de'")
    check(uistr.lang() == uistr.LANG_DE && eq(uistr.lang_name(), "de"), "language is German")
    check(eq(uistr.t("filedlg.cancel", "Cancel"), "Abbrechen"), "German: Cancel -> Abbrechen")
    check(eq(uistr.t("colordlg.hue", "Hue"), "Farbton"), "German: colordlg.hue -> Farbton")
    check(eq(uistr.t("fontdlg.bold", "Bold"), "Fett"), "German: fontdlg.bold -> Fett")
    check(eq(uistr.t("msgdlg.yes", "Yes"), "Ja") && eq(uistr.t("msgdlg.no", "No"), "Nein"), "German: Ja / Nein")
    check(eq(uistr.t("filedlg.msg_folders", "Folders: "), "Ordner: "), "German keeps the trailing ': ' of a message")
    check(eq(uistr.t("filedlg.ask_replace", "\" already exists. Replace it?"), "\" existiert bereits. Ersetzen?"), "German replace question keeps the quote")
    check(eq(uistr.t("nobody.nothing", "Fallback"), "Fallback"), "unknown key falls back to English (never empty)")
    check(uistr.set_lang_tag("de-AT") && uistr.lang() == uistr.LANG_DE, "tag de-AT = German")
    check(uistr.set_lang_tag("de_DE.UTF-8") && uistr.lang() == uistr.LANG_DE, "tag de_DE.UTF-8 = German")
    check(!uistr.set_lang_tag("deutsch") && uistr.lang() == uistr.LANG_DE, "'deutsch' is not a tag: unchanged")
    check(!uistr.set_lang_tag("xx") && uistr.lang() == uistr.LANG_DE, "unknown language: unchanged")
    check(!uistr.set_lang_tag("d") && !uistr.set_lang_tag(""), "too short: unchanged")
    check(uistr.set_lang_tag("EN") && uistr.lang() == uistr.LANG_EN, "upper-case EN = English again")
    check(eq(uistr.t("filedlg.cancel", "Cancel"), "Cancel"), "back to English text")
    uistr.set_lang("de")
    check(uistr.lang() == uistr.LANG_DE, "set_lang('de')")
    say("UISTR bad=")
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, BAD as u64)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    say("\n")
    if BAD > 0 { return 1 }
    return 0
}
