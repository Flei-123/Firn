// SPDX-License-Identifier: MPL-2.0
// tools/fui/coldwarm_main.fi -- r281: the FIRST paint of a text line (cold: glyph cache /
// raster) must equal every later paint (warm: kept line written back), octet for octet.
//
//     coldwarm <font.ttf>     prints `diff <n>` octets that differ, 0 = pass
import std.rt
import paint.canvas
import font.metrics
import fui.painter
import fui.fcache
import fui.glyphcache

const FONTSET_BYTES: usize = 4096
const W: usize = 640
const H: usize = 120

fn say2(p: u64, n: usize, v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, p, n)
    rt.buf_push_dec_i64(&t, v)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn floor_y(v: f64) -> f64 { return (v as i64) as f64 }

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 2
    }
    var fbuf: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &fbuf) {
        return 3
    }
    let fsp: *mut metrics.FontSet = rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    *fsp = metrics.fontset_new()
    if !metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
        return 3
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, H) {
        return 5
    }
    painter.painter_set_font(&z, fsp as u64)
    var line: [u8; 40] = "Hamburgefonstiv Quick fox AVATAR Tofu ry"
    let tp: u64 = (&line[0]) as u64
    let npix: usize = W * H * 4
    let snap: u64 = rt.heap_alloc(npix)
    let px: u64 = canvas.canvas_pixels(&cv) as u64
    var total: i64 = 0
    var case_i: i64 = 0
    while case_i < 36 {
        var size: f64 = 13.0
        if case_i % 3 == 1 { size = 16.0 }
        if case_i % 3 == 2 { size = 24.5 }
        var fx: f64 = 40.0 + ((case_i / 3) as f64) * 0.3
        var fy: f64 = 60.0 + ((case_i / 4) as f64) * 0.35
        if case_i >= 24 && case_i < 30 {
            // the window is cut by the top / left edge of the canvas
            fx = 41.0 + ((case_i % 3) as f64) * 0.37
            fy = 15.0 + ((case_i % 4) as f64) * 0.41
        }
        if case_i >= 30 {
            // ... and by the bottom edge
            fx = 43.0 + ((case_i % 3) as f64) * 0.29
            fy = 112.0 + ((case_i % 4) as f64) * 0.33
        }
        var r: painter.TextRun = painter.run_new(size)
        var clipped: bool = false
        if case_i >= 12 && case_i < 24 {
            // a clip that cuts the line (a list row at the edge of its viewport)
            clipped = canvas.clip_push_rect(&cv, 30.0, 40.0, 400.0 + ((case_i % 5) as f64) * 0.5,
                fy + ((case_i % 4) as f64) * 1.5 - 4.0)
        }
        if case_i >= 24 {
            fcache.fc_clear()
            glyphcache.gc_clear()
        }
        canvas.canvas_clear(&cv, 4280098846 as u32)
        painter.run_draw(&z, &r, fx, fy, 0.0, 4292927712 as u32, tp, 40, 0)
        rt.mem_copy(snap, px, npix)
        if case_i >= 24 {
            // the same line (same fractions) elsewhere, wholly on the canvas: it gets kept.
            // The edge line must still look the same afterwards (r281: dom_main culling).
            canvas.canvas_clear(&cv, 4280098846 as u32)
            painter.run_draw(&z, &r, fx + 200.0, floor_y(fy) + 45.0 + fy - floor_y(fy), 0.0,
                4292927712 as u32, tp, 40, 0)
        }
        canvas.canvas_clear(&cv, 4280098846 as u32)
        painter.run_draw(&z, &r, fx, fy, 0.0, 4292927712 as u32, tp, 40, 0)
        var i: usize = 0
        var nd: i64 = 0
        while i < npix {
            if rt.ld8(snap, i) != rt.ld8(px, i) {
                if nd < 3 {
                    var m: [u8; 5] = "case "
                    say2((&m[0]) as u64, 5, case_i)
                    var m2: [u8; 4] = "  i "
                    say2((&m2[0]) as u64, 4, i as i64)
                    var m3: [u8; 6] = "cold  "
                    say2((&m3[0]) as u64, 6, rt.ld8(snap, i) as i64)
                    var m4: [u8; 6] = "warm  "
                    say2((&m4[0]) as u64, 6, rt.ld8(px, i) as i64)
                }
                nd = nd + 1
            }
            i = i + 1
        }
        if clipped {
            canvas.clip_pop(&cv)
        }
        total = total + nd
        case_i = case_i + 1
    }
    var d: [u8; 5] = "diff "
    say2((&d[0]) as u64, 5, total)
    if total != 0 { return 1 }
    return 0
}
