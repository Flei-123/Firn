// SPDX-License-Identifier: MPL-2.0
// tools/fui/touch_main.fi -- THE CHECK OF lib/fui/kittouch.fi and of the kit parts that take
// its gestures (the tile grid, the Markdown view).
//
// Synthetic pointer streams (the records lib/window/pointers.fi hands a program, the same a
// MotionEvent of Android becomes) go into the recogniser and the gestures that come out are
// compared with what the rules say: tap, double tap (and the one that is too late), long
// press by the clock and at the lift, pan with its steps and totals, fling with a velocity
// measured over the last 100 ms (and clamped), pinch with scale and angle, a lifted finger
// of a pinch leaving the other dead, a mouse giving clicks only, cancels, a third finger.
// Then the parts: a pan scrolls the grid by the step, a fling runs on after the lift
// (grid_tick), a tap selects the tile under it, a tap on a link of the Markdown view calls
// back, a long press selects the word. The constants are checked against lib/fui/event.fi.
//
//     firnc -o /tmp/touch tools/fui/touch_main.fi && /tmp/touch
import std.rt
import std.io
import paint.canvas
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.style
import fui.viewport
import fui.kit
import fui.kittouch
import fui.event
import fui.markdownview
import markdown.doc
import window.pointers
import plat.sysfont

static mut BAD: usize = 0
static mut CHECKS: usize = 0
static mut LINK_HITS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: io.Fmt) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    io.fmt_print_line(what)
}

fn pe(kind: u32, id: u32, ptype: u32, x: f64, y: f64, t: i64) -> pointers.Pointer {
    return pointers.Pointer { kind: kind, id: id, ptype: ptype, primary: 1 as u32, x: x, y: y, t: t }
}

fn feed(g: *mut kittouch.Touch, kind: u32, id: u32, ptype: u32, x: f64, y: f64, t: i64) {
    var p: pointers.Pointer = pe(kind, id, ptype, x, y, t)
    kittouch.tg_feed(g, &p)
}

// the kinds of every pending gesture, as a string of digits
fn drain(g: *mut kittouch.Touch, out: *mut [u32; 16]) -> usize {
    var n: usize = 0
    var e: kittouch.Gesture = kittouch.gesture_blank()
    while n < 16 && kittouch.tg_next(g, &e) {
        (*out)[n] = e.kind
        n = n + 1
    }
    return n
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    return d <= tol
}

fn run_recogniser() {
    say("== the recogniser\n")
    check(kittouch.TG_SLOP == event.TOUCH_SLOP && kittouch.TG_LONG_MS == event.LONG_MS && kittouch.TG_DOUBLE_MS == event.DOUBLE_MS
        && kittouch.TG_DOUBLE_DIST == event.DOUBLE_DIST && kittouch.TG_FLING_MIN == event.FLING_MIN
        && kittouch.TG_FLING_MAX == event.FLING_MAX, f"the constants are those of lib/fui/event.fi")
    let T: u32 = pointers.PTR_TOUCH
    let M: u32 = pointers.PTR_MOUSE
    var k: [u32; 16] = [0 as u32; 16]
    var e: kittouch.Gesture = kittouch.gesture_blank()
    // --- a tap
    var g: kittouch.Touch = kittouch.tg_new()
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 100.0, 100.0, 1000)
    check(kittouch.tg_pending(&g) == 0, f"a finger down gives nothing yet")
    feed(&g, pointers.PK_MOVE, 1 as u32, T, 104.0, 102.0, 1030)
    feed(&g, pointers.PK_UP, 1 as u32, T, 104.0, 102.0, 1060)
    var n: usize = drain(&g, &k)
    check(n == 1 && k[0] == kittouch.TG_TAP, f"down, a little jitter, up: one TAP ({n} gestures)")
    // --- a double tap
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 100.0, 100.0, 2000)
    feed(&g, pointers.PK_UP, 1 as u32, T, 100.0, 100.0, 2050)
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 110.0, 105.0, 2200)
    feed(&g, pointers.PK_UP, 1 as u32, T, 110.0, 105.0, 2250)
    n = drain(&g, &k)
    check(n == 3 && k[0] == kittouch.TG_TAP && k[1] == kittouch.TG_TAP && k[2] == kittouch.TG_DOUBLE_TAP, f"two taps within 300 ms and 100 px: TAP, TAP, DOUBLE_TAP ({n})")
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 100.0, 100.0, 3000)
    feed(&g, pointers.PK_UP, 1 as u32, T, 100.0, 100.0, 3040)
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 100.0, 100.0, 3500)
    feed(&g, pointers.PK_UP, 1 as u32, T, 100.0, 100.0, 3540)
    n = drain(&g, &k)
    check(n == 2 && k[1] == kittouch.TG_TAP, f"the second tap 460 ms later is no double tap ({n} TAPs)")
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 100.0, 100.0, 4000)
    feed(&g, pointers.PK_UP, 1 as u32, T, 100.0, 100.0, 4040)
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 400.0, 100.0, 4100)
    feed(&g, pointers.PK_UP, 1 as u32, T, 400.0, 100.0, 4140)
    n = drain(&g, &k)
    check(n == 2, f"the second tap 300 px away is no double tap")
    // --- the long press
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 50.0, 50.0, 10000)
    check(!kittouch.tg_tick(&g, 10499), f"499 ms: not yet")
    check(kittouch.tg_tick(&g, 10500), f"500 ms: LONG_PRESS")
    check(!kittouch.tg_tick(&g, 10900), f"it fires once")
    feed(&g, pointers.PK_UP, 1 as u32, T, 50.0, 50.0, 11000)
    n = drain(&g, &k)
    check(n == 1 && k[0] == kittouch.TG_LONG_PRESS, f"the lift after a long press gives no tap ({n})")
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 50.0, 50.0, 20000)
    feed(&g, pointers.PK_UP, 1 as u32, T, 50.0, 50.0, 20700)
    n = drain(&g, &k)
    check(n == 1 && k[0] == kittouch.TG_LONG_PRESS, f"a host that never ticked still gets the long press at the lift")
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 50.0, 50.0, 30000)
    feed(&g, pointers.PK_MOVE, 1 as u32, T, 50.0, 90.0, 30300)
    check(!kittouch.tg_tick(&g, 30600), f"a finger that left the slop is no long press")
    feed(&g, pointers.PK_UP, 1 as u32, T, 50.0, 90.0, 30700)
    kittouch.tg_reset(&g)
    // --- the pan and its fling: 10 px every 10 ms = 1000 px/s upwards
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 200.0, 300.0, 40000)
    var y: f64 = 300.0
    var tm: i64 = 40000
    var i: usize = 0
    while i < 10 {
        tm = tm + 10
        y = y - 10.0
        feed(&g, pointers.PK_MOVE, 1 as u32, T, 200.0, y, tm)
        i = i + 1
    }
    feed(&g, pointers.PK_UP, 1 as u32, T, 200.0, y, tm + 10)
    n = drain(&g, &k)
    check(k[0] == kittouch.TG_PAN_START, f"the first gesture of a drag is PAN_START")
    check(k[n - 1] == kittouch.TG_PAN_END, f"and the last PAN_END")
    check(n == 3 && k[1] == kittouch.TG_PAN_MOVE, f"ten pointer records in one go give START, ONE coalesced MOVE, END ({n} gestures)")
    // the steps add up to the total
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 200.0, 300.0, 50000)
    var sum: f64 = 0.0
    y = 300.0
    tm = 50000
    i = 0
    while i < 10 {
        tm = tm + 10
        y = y - 10.0
        feed(&g, pointers.PK_MOVE, 1 as u32, T, 200.0, y, tm)
        i = i + 1
    }
    var steps: usize = 0
    var last_total: f64 = 0.0
    // drain after every record, as a program that polls once per record does: the steps are
    // then the single ones, and they still add up
    kittouch.tg_reset(&g)
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 200.0, 300.0, 55000)
    y = 300.0
    tm = 55000
    i = 0
    while i < 10 {
        tm = tm + 10
        y = y - 10.0
        feed(&g, pointers.PK_MOVE, 1 as u32, T, 200.0, y, tm)
        while kittouch.tg_next(&g, &e) {
            if e.kind == kittouch.TG_PAN_MOVE {
                sum = sum + e.dy
                steps = steps + 1
                last_total = e.ty
            }
        }
        i = i + 1
    }
    check(near(sum, last_total, 0.001) && near(sum, 0.0 - 100.0 + 0.0, 0.001), f"the PAN_MOVE steps (dy) add up to the total ({sum} = {last_total})")
    feed(&g, pointers.PK_UP, 1 as u32, T, 200.0, y, tm + 10)
    kittouch.tg_next(&g, &e)
    check(e.kind == kittouch.TG_PAN_END && e.fling && near(e.vy, 0.0 - 1000.0, 60.0) && near(e.vx, 0.0, 1.0),
        f"PAN_END is a fling at about -1000 px/s upwards (vy = {e.vy})")
    // a slow pan is no fling
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 200.0, 300.0, 60000)
    feed(&g, pointers.PK_MOVE, 1 as u32, T, 200.0, 270.0, 61000)
    feed(&g, pointers.PK_MOVE, 1 as u32, T, 200.0, 269.0, 62000)
    feed(&g, pointers.PK_UP, 1 as u32, T, 200.0, 269.0, 63000)
    var slow: bool = true
    while kittouch.tg_next(&g, &e) {
        if e.kind == kittouch.TG_PAN_END {
            slow = !e.fling
        }
    }
    check(slow, f"a drag that ends at rest is no fling")
    // a violent fling is clamped
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 100.0, 1000.0, 70000)
    feed(&g, pointers.PK_MOVE, 1 as u32, T, 100.0, 800.0, 70010)
    feed(&g, pointers.PK_MOVE, 1 as u32, T, 100.0, 400.0, 70020)
    feed(&g, pointers.PK_UP, 1 as u32, T, 100.0, 400.0, 70030)
    var clamped: bool = false
    while kittouch.tg_next(&g, &e) {
        if e.kind == kittouch.TG_PAN_END {
            clamped = e.fling && near(e.vy, 0.0 - kittouch.TG_FLING_MAX, 1.0)
        }
    }
    check(clamped, f"a 30000 px/s drag is clamped to 8000 px/s")
    // --- the pinch
    kittouch.tg_reset(&g)
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 100.0, 100.0, 80000)
    feed(&g, pointers.PK_DOWN, 2 as u32, T, 200.0, 100.0, 80010)
    n = drain(&g, &k)
    check(n == 1 && k[0] == kittouch.TG_PINCH_START, f"a second finger gives PINCH_START")
    feed(&g, pointers.PK_MOVE, 2 as u32, T, 300.0, 100.0, 80050)
    kittouch.tg_next(&g, &e)
    check(e.kind == kittouch.TG_PINCH_MOVE && near(e.scale, 2.0, 0.001) && near(e.angle, 0.0, 0.01), f"fingers twice as far apart: scale {e.scale}, angle {e.angle}")
    check(near(e.x, 200.0, 0.001) && near(e.y, 100.0, 0.001), f"the midpoint is where the two fingers' middle is ({e.x}, {e.y})")
    feed(&g, pointers.PK_MOVE, 2 as u32, T, 100.0, 200.0, 80100)
    kittouch.tg_next(&g, &e)
    check(near(e.scale, 1.0, 0.001) && near(e.angle, 90.0, 0.6), f"a quarter turn: scale {e.scale}, angle {e.angle}")
    feed(&g, pointers.PK_MOVE, 2 as u32, T, 0.0, 100.0, 80150)
    kittouch.tg_next(&g, &e)
    check(near(e.angle, 180.0, 1.0) || near(e.angle, 0.0 - 180.0, 1.0), f"a half turn: angle {e.angle}")
    feed(&g, pointers.PK_UP, 2 as u32, T, 0.0, 100.0, 80200)
    kittouch.tg_next(&g, &e)
    check(e.kind == kittouch.TG_PINCH_END, f"a finger lifts: PINCH_END")
    feed(&g, pointers.PK_MOVE, 1 as u32, T, 100.0, 300.0, 80300)
    feed(&g, pointers.PK_UP, 1 as u32, T, 100.0, 300.0, 80400)
    check(kittouch.tg_pending(&g) == 0, f"the remaining finger of a pinch gives nothing (no pan, no tap)")
    // a pan that gets a second finger ends without a fling and becomes a pinch
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 100.0, 300.0, 90000)
    feed(&g, pointers.PK_MOVE, 1 as u32, T, 100.0, 250.0, 90010)
    feed(&g, pointers.PK_DOWN, 2 as u32, T, 200.0, 250.0, 90020)
    var flung: bool = false
    var got_pinch: bool = false
    while kittouch.tg_next(&g, &e) {
        if e.kind == kittouch.TG_PAN_END && e.fling {
            flung = true
        }
        if e.kind == kittouch.TG_PINCH_START {
            got_pinch = true
        }
    }
    check(!flung && got_pinch, f"a second finger over a pan: the pan ends without a fling, the pinch starts")
    feed(&g, pointers.PK_UP, 2 as u32, T, 200.0, 250.0, 90100)
    feed(&g, pointers.PK_UP, 1 as u32, T, 100.0, 250.0, 90110)
    kittouch.tg_reset(&g)
    // --- a third finger is ignored
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 100.0, 100.0, 95000)
    feed(&g, pointers.PK_DOWN, 2 as u32, T, 200.0, 100.0, 95010)
    feed(&g, pointers.PK_DOWN, 3 as u32, T, 300.0, 100.0, 95020)
    check(kittouch.tg_active_fingers(&g) == 2, f"a third finger is not tracked")
    feed(&g, pointers.PK_UP, 3 as u32, T, 300.0, 100.0, 95030)
    feed(&g, pointers.PK_UP, 2 as u32, T, 200.0, 100.0, 95040)
    feed(&g, pointers.PK_UP, 1 as u32, T, 100.0, 100.0, 95050)
    drain(&g, &k)
    // --- the mouse: clicks only
    kittouch.tg_reset(&g)
    feed(&g, pointers.PK_DOWN, 1 as u32, M, 100.0, 100.0, 100000)
    feed(&g, pointers.PK_MOVE, 1 as u32, M, 100.0, 160.0, 100050)
    feed(&g, pointers.PK_UP, 1 as u32, M, 100.0, 160.0, 100100)
    check(kittouch.tg_pending(&g) == 0, f"a mouse drag gives no gesture (it has hover, drag and the wheel)")
    feed(&g, pointers.PK_DOWN, 1 as u32, M, 100.0, 100.0, 101000)
    feed(&g, pointers.PK_UP, 1 as u32, M, 100.0, 100.0, 101050)
    kittouch.tg_next(&g, &e)
    check(e.kind == kittouch.TG_TAP && e.mouse, f"a mouse click is a TAP (marked as the mouse's)")
    kittouch.tg_reset(&g)
    feed(&g, pointers.PK_DOWN, 1 as u32, M, 100.0, 100.0, 102000)
    check(!kittouch.tg_tick(&g, 103000), f"a mouse button held is no long press")
    feed(&g, pointers.PK_UP, 1 as u32, M, 100.0, 100.0, 103100)
    drain(&g, &k)
    // --- cancel
    kittouch.tg_reset(&g)
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 100.0, 100.0, 110000)
    feed(&g, pointers.PK_CANCEL, 1 as u32, T, 100.0, 100.0, 110050)
    check(kittouch.tg_pending(&g) == 0, f"a cancelled touch is no tap")
    feed(&g, pointers.PK_DOWN, 1 as u32, T, 100.0, 300.0, 111000)
    feed(&g, pointers.PK_MOVE, 1 as u32, T, 100.0, 260.0, 111010)
    feed(&g, pointers.PK_MOVE, 1 as u32, T, 100.0, 200.0, 111020)
    feed(&g, pointers.PK_CANCEL, 1 as u32, T, 100.0, 200.0, 111030)
    var cancel_fling: bool = false
    var ended: bool = false
    while kittouch.tg_next(&g, &e) {
        if e.kind == kittouch.TG_PAN_END {
            ended = true
            cancel_fling = e.fling
        }
    }
    check(ended && !cancel_fling, f"a cancelled pan ends without a fling")
    // --- the angle approximation over a circle
    var worst: f64 = 0.0
    var deg: i64 = 0 - 179
    while deg <= 180 {
        // a point at `deg` degrees from (0,0), radius 100: by the series of sin/cos from the angle
        let rad: f64 = (deg as f64) * 3.14159265358979 / 180.0
        let cx: f64 = 100.0 * cosd(rad)
        let cy: f64 = 100.0 * sind(rad)
        kittouch.tg_reset(&g)
        feed(&g, pointers.PK_DOWN, 1 as u32, T, 0.0, 0.0, 200000)
        feed(&g, pointers.PK_DOWN, 2 as u32, T, 100.0, 0.0, 200001)
        feed(&g, pointers.PK_MOVE, 2 as u32, T, cx, cy, 200002)
        var e2: kittouch.Gesture = kittouch.gesture_blank()
        kittouch.tg_next(&g, &e2)
        kittouch.tg_next(&g, &e2)
        var d: f64 = e2.angle - (deg as f64)
        if d > 180.0 { d = d - 360.0 }
        if d < 0.0 - 180.0 { d = d + 360.0 }
        if d < 0.0 { d = 0.0 - d }
        if d > worst {
            worst = d
        }
        deg = deg + 1
    }
    check(worst < 0.5, f"the pinch angle is within half a degree on the whole circle (worst {worst})")
}

// sin and cos by Taylor series on a reduced argument (the test needs no std.math)
fn sind(x0: f64) -> f64 {
    var x: f64 = x0
    while x > 3.14159265358979 { x = x - 6.28318530717959 }
    while x < 0.0 - 3.14159265358979 { x = x + 6.28318530717959 }
    var term: f64 = x
    var sum: f64 = x
    var k: i64 = 1
    while k < 12 {
        term = 0.0 - term * x * x / (((2 * k) * (2 * k + 1)) as f64)
        sum = sum + term
        k = k + 1
    }
    return sum
}

fn cosd(x0: f64) -> f64 {
    return sind(x0 + 1.57079632679490)
}

// ---------------------------------------------------------------------- the parts

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
}

fn page_new(w: usize, h: usize, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(false)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn on_link(ud: u64, url: u64, n: usize) {
    LINK_HITS = LINK_HITS + 1
}

const LONG_DOC: str = "# Notes\n\nFirst paragraph with a [link](https://example.org) in it.\n\nSecond paragraph.\n\nThird paragraph.\n\nFourth paragraph.\n\nFifth paragraph.\n\nSixth paragraph.\n\nSeventh paragraph.\n\nEighth paragraph.\n\nNinth paragraph.\n\nTenth paragraph.\n\nEleventh paragraph.\n\nTwelfth paragraph.\n"

fn run_parts(font: u64) {
    say("== the parts\n")
    let p: *mut Page = page_new(640, 300, font)
    let c: *mut render.Ctx = &(*p).c
    var tiles: [kit.Tile; 12] = [kit.Tile { title: "T", sub: "", badge: "", icon: kit.ICON_NONE, seed: 0 as u32, px: 0, w: 0, h: 0, stride: 0 }; 12]
    var g: kit.TileGrid = kit.grid_new()
    kit.grid_set_rect(&g, 0.0, 0.0, 640.0, 300.0)
    kit.grid_layout(c, &g, 12)
    kit.grid_paint(c, &g, (&tiles[0]) as *mut kit.Tile, 12)
    let before: f64 = viewport.viewport_off_y(&g.vp)
    kit.grid_touch_pan(&g, 0.0 - 40.0) // the finger moved up by 40
    check(viewport.viewport_off_y(&g.vp) == before + 40.0, f"a pan of the finger up by 40 scrolls the content down by 40")
    kit.grid_touch_pan(&g, 15.0)
    check(viewport.viewport_off_y(&g.vp) == before + 25.0, f"and the finger down by 15 scrolls back by 15")
    kit.grid_touch_pan(&g, 100000.0)
    check(viewport.viewport_off_y(&g.vp) == 0.0, f"the offset is clamped at the top")
    kit.grid_touch_fling(&g, 0.0 - 2000.0, 1000)
    check(kit.grid_tick(&g, 1000 + 50), f"a fling runs on: the next tick moves the grid")
    let mid: f64 = viewport.viewport_off_y(&g.vp)
    kit.grid_tick(&g, 1000 + 2000)
    let end: f64 = viewport.viewport_off_y(&g.vp)
    check(mid > 0.0 && end > mid, f"it carries on ({mid} after 50 ms, {end} when done)")
    check(!kit.grid_tick(&g, 1000 + 5000), f"and stops")
    // a tap selects the tile under it
    var x0: f64 = 0.0
    var y0: f64 = 0.0
    var w0: f64 = 0.0
    var h0: f64 = 0.0
    viewport.viewport_set_offset(&g.vp, 0.0, 0.0)
    kit.grid_tile_rect(&g, 1, &x0, &y0, &w0, &h0)
    let idx: usize = kit.grid_touch_tap(&g, x0 + w0 / 2.0, y0 + h0 / 2.0, 12)
    check(idx == 1 && kit.grid_selected(&g) == 1, f"a tap selects the tile under it ({idx})")
    check(kit.grid_touch_tap(&g, 5000.0, 5000.0, 12) == kit.NONE, f"a tap outside selects nothing")
    // the Markdown view
    var v: markdownview.MdView = markdownview.mdv_new()
    markdownview.mdv_set_markdown(&v, LONG_DOC, doc.opts_default())
    markdownview.mdv_set_link_cb(&v, 0, on_link)
    markdownview.mdv_set_background(&v, style.TOK_BASE)
    markdownview.mdv_set_rect(&v, 0.0, 0.0, 400.0, 200.0)
    markdownview.mdv_paint(&v, c)
    check(markdownview.mdv_content_height(&v) > 400.0, f"the document is taller than the view")
    markdownview.mdv_touch_pan(&v, 0.0, 0.0 - 60.0)
    check(markdownview.mdv_offset(&v) == 60.0, f"a pan up by 60 scrolls the Markdown view by 60")
    markdownview.mdv_touch_fling(&v, 0.0, 0.0 - 3000.0, 5000)
    check(markdownview.mdv_tick(&v, 5000 + 100), f"a fling: the view moves on its tick")
    markdownview.mdv_tick(&v, 5000 + 3000)
    check(markdownview.mdv_offset(&v) > 200.0, f"and carries on to {markdownview.mdv_offset(&v)}")
    viewport.viewport_set_offset(&v.vp, 0.0, 0.0)
    markdownview.mdv_paint(&v, c)
    var lx: f64 = 0.0
    var ly: f64 = 0.0
    var lw: f64 = 0.0
    var lh: f64 = 0.0
    check(markdownview.mdv_link_rect(&v, 0 as u32, &lx, &ly, &lw, &lh), f"the link has a rectangle")
    let ox: f64 = viewport.viewport_content_x(&v.vp)
    let oy: f64 = viewport.viewport_content_y(&v.vp)
    LINK_HITS = 0
    check(markdownview.mdv_touch_tap(&v, c, ox + lx + lw / 2.0, oy + ly + lh / 2.0) && LINK_HITS == 1, f"a tap on the link follows it")
    check(!markdownview.mdv_touch_tap(&v, c, 390.0, 190.0) && LINK_HITS == 1, f"a tap elsewhere follows nothing")
    // a long press on a word selects it
    check(markdownview.mdv_touch_long(&v, c, ox + 20.0, oy + 22.0), f"a long press on the heading selects a word")
    var b: rt.Buf = rt.buf_new()
    markdownview.mdv_selection_text(&v, &b)
    check(rt.buf_len(&b) == 5 && rt.mem_eq(rt.buf_ptr(&b), "Notes".p as u64, 5), f"the word is 'Notes' ({rt.buf_len(&b)} octets)")
    rt.buf_free(&b)
    check(!markdownview.mdv_touch_tap(&v, c, 390.0, 190.0) && !markdownview.mdv_has_selection(&v), f"a tap elsewhere clears the selection")
    markdownview.mdv_free(&v)
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("touch: no font (DejaVu Sans)\n")
        return 9
    }
    run_recogniser()
    run_parts(fs as u64)
    say("checks: ")
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&nb, CHECKS as u64)
    rt.write_everything(1, rt.buf_ptr(&nb), rt.buf_len(&nb))
    rt.buf_free(&nb)
    say("\n")
    if BAD == 0 {
        say("TOUCH PASSED\n")
        return 0
    }
    say("TOUCH FAILED\n")
    return 1
}
