// SPDX-License-Identifier: MPL-2.0
// tools/fui/apptb_main.fi -- the toolbar overflow (appctl.toolbar*, r338): items fold behind a "..." button when narrow.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.wave8m
import fui.inspect
import fui.safeout
import fui.sheet
import fui.anim
import fui.style
import fui.a11y
import fui.render

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

static mut HITS: usize = 0
static mut LAST: usize = 0

fn hit_cut(a: *mut app.App) {
    HITS = HITS + 1
    LAST = 1
}

fn hit_copy(a: *mut app.App) {
    HITS = HITS + 1
    LAST = 2
}

fn hit_paste(a: *mut app.App) {
    HITS = HITS + 1
    LAST = 3
}

fn hit_save(a: *mut app.App) {
    HITS = HITS + 1
    LAST = 4
}

fn frame_at(a: *mut app.App, s: *mut Surface, w: usize, h: usize) {
    app.app_paint(a as u64, w, h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn settle_at(a: *mut app.App, s: *mut Surface, w: usize, h: usize) {
    var k: usize = 0
    while k < 5 {
        frame_at(a, s, w, h)
        k = k + 1
    }
}

fn shown(a: *mut app.App, n: usize) -> bool {
    let sc: *mut scene.Scene = app.app_scene(a)
    return !scene.node_hidden(sc, n) && scene.node_w(sc, n) > 2.0
}

fn num(tag: str, v: f64) {
    say(tag)
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v as i64)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

#[allow_escape]
fn dlen(a: *mut app.App, node: usize) -> usize {
    var db: [u8; 192] = [0 as u8; 192]
    let n: usize = a11y.a11y_description(app.app_scene(a), app.ax(a), node, (&db[0]) as u64, 192)
    return n
}

fn click(w: *mut fuiwirt.Host, x: f64, y: f64) {
    let m: u32 = fuiwirt.host_pointer_move(w, x, y)
    let d: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let u: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

fn pressed(a: *mut app.App) {
    CHANGES = CHANGES + 1
}

fn has(buf: u64, n: usize, what: str) -> bool {
    if what.n > n {
        return false
    }
    var i: usize = 0
    while i + what.n <= n {
        var j: usize = 0
        while j < what.n && *((buf + (i + j) as u64) as *mut u8) == *((what.p as u64 + j as u64) as *mut u8) {
            j = j + 1
        }
        if j == what.n {
            return true
        }
        i = i + 1
    }
    return false
}

fn act(a: *mut app.App) {
    let i: usize = fuiwirt.host_take_activated(app.app_host(a))
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
}

fn centre(a: *mut app.App, sc: *mut scene.Scene, n: usize) {
    let w: *mut fuiwirt.Host = app.app_host(a)
    click(w, scene.node_x(sc, n) + scene.node_w(sc, n) / 2.0, scene.node_y(sc, n) + scene.node_h(sc, n) / 2.0)
    act(a)
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("apptb: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Toolbar", 640, 300)
    let tb: usize = appctl.toolbar(a, "Tools")
    let b_cut: usize = appctl.toolbar_item(a, tb, "Cut", 3, hit_cut)
    let b_copy: usize = appctl.toolbar_item(a, tb, "Copy", 2, hit_copy)
    let b_paste: usize = appctl.toolbar_item(a, tb, "Paste", 1, hit_paste)
    let b_save: usize = appctl.toolbar_item(a, tb, "Save", 0, hit_save)
    appctl.toolbar_end(a, tb)
    let after: usize = app.button(a, "After", hit_save)
    let s: *mut Surface = surface_for(a, 640, 300)
    fuiwirt.host_bind(app.app_host(a))
    let sc: *mut scene.Scene = app.app_scene(a)
    let w: *mut fuiwirt.Host = app.app_host(a)
    check(tb != appctl.NONE && b_cut != appctl.NONE && b_copy != appctl.NONE && b_paste != appctl.NONE && b_save != appctl.NONE, "toolbar and four items exist")
    let more: usize = appctl.toolbar_more(a, tb)
    check(more != appctl.NONE, "the \"...\" button exists")
    settle_at(a, s, 640, 300)
    num("  parent width ", scene.node_w(sc, scene.scene_parent(sc, tb)))
    num("  toolbar width ", scene.node_w(sc, tb))
    num("  cut width ", scene.node_pref_w(sc, b_cut))
    check(appctl.toolbar_folded(a, tb) == 0, "wide: nothing is folded")
    check(shown(a, b_cut) && shown(a, b_copy) && shown(a, b_paste) && shown(a, b_save), "wide: all items are in the bar")
    check(!shown(a, more), "wide: no \"...\" button")
    // ---- narrow: the highest priority folds first (Cut, then Copy), Save never folds
    settle_at(a, s, 250, 300)
    num("  narrow folded ", appctl.toolbar_folded(a, tb) as f64)
    check(appctl.toolbar_folded(a, tb) >= 1 && appctl.toolbar_is_folded(a, tb, 0), "narrow: Cut (prio 3) is folded first")
    check(!appctl.toolbar_is_folded(a, tb, 3) && shown(a, b_save), "narrow: Save (prio 0) stays")
    check(shown(a, more), "narrow: the \"...\" button shows")
    check(!shown(a, b_cut), "narrow: the folded original is squeezed away")
    var r: f64 = scene.node_x(sc, more) + scene.node_w(sc, more)
    check(r <= 250.0 + 1.0, "narrow: the bar (with the \"...\" button) fits the width")
    // ---- very narrow: everything but Save folds
    settle_at(a, s, 150, 300)
    check(appctl.toolbar_folded(a, tb) == 3 && appctl.toolbar_is_folded(a, tb, 2) && appctl.toolbar_is_folded(a, tb, 1), "very narrow: Cut, Copy and Paste fold")
    check(shown(a, b_save), "very narrow: Save stays")
    // ---- the panel: closed first, open with a click on "...", shows the copies of the folded items
    check(!appctl.toolbar_open(a, tb), "the panel starts closed")
    settle_at(a, s, 250, 300)
    let nf: usize = appctl.toolbar_folded(a, tb)
    centre(a, sc, more)
    settle_at(a, s, 250, 300)
    check(appctl.toolbar_open(a, tb), "a click on the \"...\" button opens the panel")
    // the copies are the buttons after the bar: find visible buttons named like the folded ones via the callbacks
    HITS = 0
    var found: usize = 0
    var n: usize = 0
    while n < scene.scene_count(sc) {
        if shown(a, n) && n > more && n < after && scene.node_kind(sc, n) == scene.N_WIDGET {
            found = found + 1
        }
        n = n + 1
    }
    num("  copies shown ", found as f64)
    check(found == nf, "the panel shows one copy per folded item")
    // click the first copy: its callback runs (Cut = 1)
    var cp: usize = 0
    n = 0
    while n < scene.scene_count(sc) && cp == 0 {
        if shown(a, n) && n > more && n < after && scene.node_kind(sc, n) == scene.N_WIDGET {
            cp = n
        }
        n = n + 1
    }
    check(cp != 0, "found a copy")
    centre(a, sc, cp)
    check(HITS == 1 && LAST == 1, "a copy runs the item's callback (Cut)")
    // ---- widening closes the panel and unfolds
    settle_at(a, s, 640, 300)
    check(appctl.toolbar_folded(a, tb) == 0 && !appctl.toolbar_open(a, tb), "wide again: nothing folded, panel closed")
    check(shown(a, b_cut) && shown(a, b_copy) && shown(a, b_paste), "wide again: all items back in the bar")
    // ---- program side
    settle_at(a, s, 250, 300)
    appctl.toolbar_set_open(a, tb, true)
    check(appctl.toolbar_open(a, tb), "toolbar_set_open(true) opens the panel while something is folded")
    appctl.toolbar_set_open(a, tb, false)
    check(!appctl.toolbar_open(a, tb), "toolbar_set_open(false) closes it")
    settle_at(a, s, 640, 300)
    appctl.toolbar_set_open(a, tb, true)
    check(!appctl.toolbar_open(a, tb), "nothing folded: the panel cannot open")
    // ---- a11y: the toolbar role and name, the \"...\" button name and expanded state
    var ib: [u8; 2048] = [0 as u8; 2048]
    let ax: *mut a11y.A11y = app.ax(a)
    check(a11y.a11y_role(sc, ax, tb) == a11y.ROLE_TOOLBAR, "a11y: the column is a toolbar")
    settle_at(a, s, 250, 300)
    appctl.toolbar_set_open(a, tb, false)
    check((a11y.a11y_state(sc, ax, more) & a11y.ST_COLLAPSED) != 0 as u32, "a11y: \"...\" is collapsed while the panel is closed")
    appctl.toolbar_set_open(a, tb, true)
    check((a11y.a11y_state(sc, ax, more) & a11y.ST_EXPANDED) != 0 as u32, "a11y: \"...\" is expanded while the panel is open")
    appctl.toolbar_set_open(a, tb, false)
    // ---- picture: narrow with the panel open, light then dark
    let s2: *mut Surface = surface_for(a, 250, 300)
    settle_at(a, s2, 250, 300)
    appctl.toolbar_set_open(a, tb, true)
    settle_at(a, s2, 250, 300)
    save(&(*s2).cv, dir, "toolbar-light.png")
    app.set_dark(a, true)
    settle_at(a, s2, 250, 300)
    save(&(*s2).cv, dir, "toolbar-dark.png")
    app.set_dark(a, false)
    // ---- harmless misuse
    appctl.toolbar_set_open(a, 99999, true)
    check(appctl.toolbar_item(a, tb, "Late", 1, hit_cut) == appctl.NONE, "no item after toolbar_end")
    check(appctl.toolbar_folded(a, 99999) == 0 && !appctl.toolbar_is_folded(a, 99999, 0), "bad ids are harmless")
    if BAD == 0 {
        say("APPTB PASSED\n")
        return 0
    }
    say("APPTB FAILED\n")
    return 1
}
