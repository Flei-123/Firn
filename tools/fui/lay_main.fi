// SPDX-License-Identifier: MPL-2.0
// tools/fui/lay_main.fi -- lib/fui/lay.fi (CSS flexbox for the app API).
//
// 1. The flex arithmetic against rectangles MEASURED IN CHROMIUM
//    (tools/fui/lay_ref.py -> tools/fui/lay_cases.txt): every node of every
//    case must land on the same pixel. Run from the repository root.
// 2. A mobile page built with the lay.* calls: stretch, full-width fields,
//    wrapping text, a field that takes the rest of a row, a wrapping row.
import std.rt
import font.metrics
import paint.canvas
import fui.theme
import fui.painter
import fui.scene
import fui.widget
import fui.flex
import plat.fuiwirt
import plat.sysfont
import fui.app
import fui.lay

static mut BAD: usize = 0
static mut OKS: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_num(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(ok: bool, what: str) {
    if ok {
        OKS = OKS + 1
        return
    }
    say("  WRONG ")
    say(what)
    say("\n")
    BAD = BAD + 1
}

fn check_num(got: i64, want: i64, what: str) {
    if got == want {
        OKS = OKS + 1
        return
    }
    say("  WRONG ")
    say(what)
    say(" got ")
    say_num(got)
    say(" want ")
    say_num(want)
    say("\n")
    BAD = BAD + 1
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

// ------------------------------------------------------------ THE TABLE
struct Rd {
    p: u64,
    n: usize,
    i: usize,
}

fn rd_int(r: *mut Rd) -> i64 {
    while (*r).i < (*r).n {
        let c: u8 = rt.ld8((*r).p, (*r).i)
        if c == 45 as u8 || (c >= 48 as u8 && c <= 57 as u8) {
            break
        }
        (*r).i = (*r).i + 1
    }
    var neg: bool = false
    if (*r).i < (*r).n && rt.ld8((*r).p, (*r).i) == 45 as u8 {
        neg = true
        (*r).i = (*r).i + 1
    }
    var v: i64 = 0
    while (*r).i < (*r).n {
        let c: u8 = rt.ld8((*r).p, (*r).i)
        if c < 48 as u8 || c > 57 as u8 {
            break
        }
        v = v * 10 + ((c as i64) - 48)
        (*r).i = (*r).i + 1
    }
    if neg {
        return 0 - v
    }
    return v
}

// 25 inputs + 4 expected numbers per node
const NF: usize = 29

// One case: build the tree with lay.* from the table, lay it out, compare.
fn run_case(a: *mut app.App, s: *mut Surface, r: *mut Rd, ci: usize) {
    let nn: usize = rd_int(r) as usize
    var t: [i64; 1856] = [0; 1856]
    var i: usize = 0
    while i < nn * NF && i < 1856 {
        t[i] = rd_int(r)
        i = i + 1
    }
    var ids: [usize; 64] = [0; 64]
    var haskids: [bool; 64] = [false; 64]
    i = 1
    while i < nn {
        haskids[t[i * NF] as usize] = true
        i = i + 1
    }
    // the stack of open parents (case node indexes)
    var open: [usize; 16] = [0; 16]
    var depth: usize = 0
    i = 0
    while i < nn {
        let b: usize = i * NF
        let parent: i64 = t[b]
        if i > 0 {
            while depth > 0 && open[depth - 1] != (parent as usize) {
                app.end(a)
                depth = depth - 1
            }
        }
        var id: usize = app.NONE
        if haskids[i] {
            if t[b + 1] == 1 {
                id = lay.vbox(a)
            } else if t[b + 4] == 1 {
                id = lay.hwrap(a)
            } else {
                id = lay.hbox(a)
            }
            open[depth] = i
            depth = depth + 1
            lay.justify(a, id, t[b + 2] as u32)
            lay.align(a, id, t[b + 3] as u32)
            lay.gap(a, id, t[b + 5], t[b + 6])
            lay.pad(a, id, t[b + 7], t[b + 8], t[b + 9], t[b + 10])
        } else {
            id = app.spacer(a, 0, 0)
        }
        ids[i] = id
        var w: i64 = t[b + 11]
        var h: i64 = t[b + 12]
        if w < 0 {
            w = 0
        }
        if h < 0 {
            h = 0
        }
        lay.size(a, id, w, h)
        lay.grow(a, id, t[b + 13])
        lay.shrink(a, id, t[b + 14])
        if t[b + 15] >= 0 {
            lay.basis(a, id, t[b + 15])
        }
        lay.min_w(a, id, t[b + 16])
        lay.max_w(a, id, t[b + 17])
        lay.min_h(a, id, t[b + 18])
        lay.max_h(a, id, t[b + 19])
        if t[b + 20] != 0 {
            lay.align_self(a, id, t[b + 20] as u32)
        }
        lay.margin(a, id, t[b + 21], t[b + 22], t[b + 23], t[b + 24])
        if i == 0 {
            // the case root is a fixed-size block in the page column
            lay.shrink(a, id, 0)
            lay.align_self(a, id, lay.AL_START)
        }
        i = i + 1
    }
    while depth > 0 {
        app.end(a)
        depth = depth - 1
    }
    frame(a, s)
    frame(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    let ox: f64 = scene.node_x(sc, ids[0])
    let oy: f64 = scene.node_y(sc, ids[0])
    i = 0
    while i < nn {
        let b: usize = i * NF + 25
        let gx: i64 = (scene.node_x(sc, ids[i]) - ox) as i64
        let gy: i64 = (scene.node_y(sc, ids[i]) - oy) as i64
        let gw: i64 = scene.node_w(sc, ids[i]) as i64
        let gh: i64 = scene.node_h(sc, ids[i]) as i64
        if gx != t[b] || gy != t[b + 1] || gw != t[b + 2] || gh != t[b + 3] {
            say("  WRONG case ")
            say_num(ci as i64)
            say(" node ")
            say_num(i as i64)
            say(" got ")
            say_num(gx)
            say(",")
            say_num(gy)
            say(",")
            say_num(gw)
            say(",")
            say_num(gh)
            say(" want ")
            say_num(t[b])
            say(",")
            say_num(t[b + 1])
            say(",")
            say_num(t[b + 2])
            say(",")
            say_num(t[b + 3])
            say("\n")
            BAD = BAD + 1
        } else {
            OKS = OKS + 1
        }
        i = i + 1
    }
}

fn table_test() {
    var buf: rt.Buf = rt.buf_new()
    var path: [u8; 26] = "tools/fui/lay_cases.txt\0\0\0"
    if !rt.read_file((&path[0]) as u64, &buf) {
        say("  WRONG cannot read tools/fui/lay_cases.txt (run from the repository root)\n")
        BAD = BAD + 1
        return
    }
    var r: Rd = Rd { p: rt.buf_ptr(&buf), n: rt.buf_len(&buf), i: 0 }
    let ncases: usize = rd_int(&r) as usize
    check(ncases >= 60, "at least 60 reference cases")
    var done: usize = 0
    var batch: usize = 0
    var a: *mut app.App = 0 as u64 as *mut app.App
    var s: *mut Surface = 0 as u64 as *mut Surface
    while done < ncases {
        // a fresh window every 8 cases (the page column holds 64 children)
        if batch == 0 {
            a = app.window("lay", 480, 700)
            lay.page(a)
            fuiwirt.host_bind(app.app_host(a))
            s = surface_for(a, 480, 700)
        }
        run_case(a, s, &r, done)
        done = done + 1
        batch = batch + 1
        if batch == 8 {
            batch = 0
        }
    }
    say("  table: ")
    say_num(ncases as i64)
    say(" cases against Chromium\n")
}

// ----------------------------------------------------- THE MOBILE PAGE
fn noop(a: *mut app.App) {
}

fn page_test() {
    let a: *mut app.App = app.window("page", 360, 640)
    lay.page(a)
    let top: usize = lay.vbox(a)
    lay.fill_h(a, top)
    lay.pad_all(a, top, 16)
    lay.gap(a, top, 0, 12)
    let title: usize = lay.label(a, "Settings", 20)
    let para: usize = lay.label(a, "A long paragraph of text that has to break into several lines at the width of the phone and must start at the left edge like web text does.", 0)
    let card: usize = app.card(a)
    let name: usize = app.entry(a, "Name")
    lay.fill_w(a, name)
    let save: usize = app.button(a, "Save", noop)
    lay.fill_w(a, save)
    app.end(a)
    let row: usize = lay.hbox(a)
    lay.gap(a, row, 8, 0)
    let find: usize = app.entry(a, "Search")
    lay.grow(a, find, 1000)
    let go: usize = app.button(a, "Go", noop)
    app.end(a)
    let tags: usize = lay.hwrap(a)
    lay.gap(a, tags, 8, 8)
    var k: usize = 0
    var tg: [usize; 8] = [0; 8]
    while k < 8 {
        tg[k] = app.button(a, "A tag chip", noop)
        k = k + 1
    }
    app.end(a)
    let foot: usize = lay.spacer_grow(a)
    let last: usize = app.button(a, "Bottom button", noop)
    lay.fill_w(a, last)
    app.end(a)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 360, 640)
    frame(a, s)
    frame(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    check_num(scene.node_x(sc, top) as i64, 0, "screen box at x 0")
    check_num(scene.node_w(sc, top) as i64, 360, "screen box is the full width")
    check_num(scene.node_h(sc, top) as i64, 640, "screen box is the full height (fill_h)")
    check_num(scene.node_x(sc, title) as i64, 16, "title starts at the padding")
    check_num(scene.node_w(sc, title) as i64, 328, "title is as wide as the content")
    check_num(scene.node_w(sc, para) as i64, 328, "paragraph is as wide as the content")
    check(scene.node_text_lines(sc, para) >= 3, "paragraph breaks into 3 or more lines")
    check_num(scene.node_y(sc, para) as i64, (scene.node_y(sc, title) + scene.node_h(sc, title)) as i64 + 12,
        "gap 12 between title and paragraph")
    check_num(scene.node_w(sc, card) as i64, 328, "card is full width")
    check_num(scene.node_w(sc, name) as i64, 304, "full-width entry fills the card (328 - 2*12)")
    check_num(scene.node_x(sc, name) as i64, 28, "entry starts inside the card padding")
    check_num(scene.node_w(sc, save) as i64, 304, "full-width button fills the card")
    check_num((scene.node_x(sc, find) + scene.node_w(sc, find)) as i64 + 8, scene.node_x(sc, go) as i64,
        "row: entry then gap 8 then button")
    check_num((scene.node_x(sc, go) + scene.node_w(sc, go)) as i64, 344, "row: button ends at the right padding")
    check(scene.node_w(sc, find) > 120.0, "row: the entry took the rest")
    check(scene.node_y(sc, tg[7]) > scene.node_y(sc, tg[0]), "wrap row: the last chip is on a lower line")
    check_num(scene.node_x(sc, tg[0]) as i64, 16, "wrap row: first chip at the start")
    check_num(scene.node_h(sc, tags) as i64,
        (scene.node_y(sc, tg[7]) + scene.node_h(sc, tg[7]) - scene.node_y(sc, tg[0])) as i64,
        "wrap row: the box is as high as its lines")
    check_num((scene.node_y(sc, last) + scene.node_h(sc, last)) as i64, 624,
        "grow spacer pushes the last button to the bottom padding")
    check_num(scene.node_w(sc, last) as i64, 328, "bottom button full width")
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("lay: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    table_test()
    page_test()
    say("lay: ")
    say_num(OKS as i64)
    say(" ok, ")
    say_num(BAD as i64)
    say(" wrong\n")
    if BAD > 0 {
        say("LAY IS NOT IN ORDER.\n")
        return 1
    }
    say("LAY PASSED.\n")
    return 0
}
