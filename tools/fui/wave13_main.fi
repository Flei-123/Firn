// SPDX-License-Identifier: MPL-2.0
// tools/fui/wave13_main.fi -- wave 13: flyout and teaching tip (lib/fui/wave13.fi).
// Logic, geometry (hit = draw), placement flips, keys, pixels.
//
//     wave13_main            prints one line per check, exit 0 when all hold
//     wave13_main <dir>      additionally writes wave13-light.png / wave13-dark.png into <dir>
import std.rt
import fui.safeout
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.style
import fui.editor
import fui.kit
import fui.kitcolor
import fui.wave13
import fui.lucide
import plat.sysfont

static mut BAD: usize = 0
static mut CHECKS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
    w: usize,
    h: usize,
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    kitcolor.kit_theme(&(*p).m, dark)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    (*p).w = w
    (*p).h = h
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn tok(p: *mut Page, t: u32) -> u32 {
    return theme.opaque(render.color_of(&(*p).c, style.color_token(t))) & 16777215 as u32
}

fn clear(p: *mut Page) {
    canvas.canvas_clear(&(*p).cv, tok(p, style.TOK_BASE) | (255 as u32) << 24)
}

fn px(p: *mut Page, x: f64, y: f64) -> u32 {
    return canvas.canvas_get(&(*p).cv, x as usize, y as usize) & 16777215 as u32
}

fn near(a: f64, b: f64, eps: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    return d <= eps
}

fn rect_ok(r: *mut [f64; 4], w: f64, h: f64) -> bool {
    return (*r)[0] >= 0.0 && (*r)[1] >= 0.0 && (*r)[0] + (*r)[2] <= w + 0.5 && (*r)[1] + (*r)[3] <= h + 0.5
}

fn run_model(p: *mut Page, ts: str, rtl: bool) {
    let c: *mut render.Ctx = &(*p).c
    kit.kit_set_rtl(rtl)
    say("-- flyout ")
    say(ts)
    if rtl { say(" rtl") }
    say("\n")
    var f: wave13.Fly = wave13.fl_new(wave13.FL_FLYOUT)
    f.title = "Delete file"
    f.text = "This removes the file for good. You can not undo it."
    check(wave13.fl_add_action(&f, "Cancel") && wave13.fl_add_action(&f, "Delete") && f.na == 2, "two actions")
    wave13.fl_set_anchor(&f, 200.0, 100.0, 80.0, 32.0)
    check(wave13.fl_hit(c, &f, 560.0, 520.0, 10.0, 10.0) == wave13.FL_OUT, "closed: everything is outside")
    wave13.fl_open(&f)
    check(f.open && f.kin && f.foc == wave13.FL_ACT0 + 1 && f.light, "a flyout opens with the keyboard on the main action")
    var g: wave13.FlGeom = wave13.fl_geom(c, &f, 560.0, 520.0)
    check(g.ok && g.dir == wave13.D_BOTTOM && g.y >= 132.0 && g.x >= 0.0 && g.x + g.w <= 560.0, "default: below the anchor, inside the window")
    check(g.tipy < g.y && g.tipx >= 200.0 && g.tipx <= 280.0, "the arrow points up at the anchor")
    var r: [f64; 4] = [0.0; 4]
    check(wave13.fl_part_rect(c, &f, 560.0, 520.0, wave13.FL_ACT0 + 1, &r) && r[1] + r[3] <= g.y + g.h && r[0] >= g.x, "action rect inside the panel")
    check(wave13.fl_hit(c, &f, 560.0, 520.0, r[0] + r[2] / 2.0, r[1] + r[3] / 2.0) == wave13.FL_ACT0 + 1, "hit = geometry (action 1)")
    check(wave13.fl_hit(c, &f, 560.0, 520.0, g.x + 4.0, g.y + 4.0) == wave13.FL_BODY, "the panel body")
    check(wave13.fl_hit(c, &f, 560.0, 520.0, 5.0, 500.0) == wave13.FL_OUT, "outside")
    check(wave13.fl_window_hit(c, &f, 560.0, 520.0, 5.0, 500.0), "light dismiss: the whole window belongs to it")
    // flip: anchor at the bottom -> panel above
    wave13.fl_set_anchor(&f, 200.0, 480.0, 80.0, 32.0)
    g = wave13.fl_geom(c, &f, 560.0, 520.0)
    check(g.dir == wave13.D_TOP && g.y + g.h <= 480.0 && g.tipy > g.y + g.h, "no room below: it flips above, the arrow points down")
    // forced side
    wave13.fl_set_anchor(&f, 200.0, 200.0, 80.0, 32.0)
    f.side = wave13.FL_END
    wave13.fl_set_anchor(&f, 400.0, 200.0, 80.0, 32.0)
    g = wave13.fl_geom(c, &f, 1200.0, 520.0)
    var want: u32 = wave13.D_RIGHT
    if rtl { want = wave13.D_LEFT }
    check(g.dir == want, "side END follows the reading direction")
    check(g.tipx > 0.0 && (g.x > 480.0 || g.x + g.w < 400.0), "the panel stands beside the anchor")
    f.side = wave13.FL_AUTO
    // no anchor: centred, no arrow
    wave13.fl_set_anchor(&f, 0.0, 0.0, 0.0, 0.0)
    g = wave13.fl_geom(c, &f, 560.0, 520.0)
    check(g.dir == wave13.D_NONE && near(g.x + g.w / 2.0, 280.0, 1.0), "no anchor: centred, no arrow")
    // keys
    check(wave13.fl_key(&f, editor.KEY_TAB, false) == wave13.FR_FOCUS && f.foc == wave13.FL_ACT0, "Tab wraps to the first action")
    check(wave13.fl_key(&f, editor.KEY_RIGHT, false) == wave13.FR_FOCUS && f.foc == wave13.FL_ACT0 + 1 || rtl, "arrows walk")
    f.foc = wave13.FL_ACT0 + 1
    check(wave13.fl_key(&f, editor.KEY_ENTER, false) == wave13.FR_ACTION && f.pick == 1 && !f.open && f.reason == wave13.RS_ACTION, "Enter on an action: picked, closed")
    wave13.fl_open(&f)
    check(wave13.fl_key(&f, editor.KEY_ESC, false) == wave13.FR_CLOSED && !f.open && f.reason == wave13.RS_ESC, "Esc closes")
    // teaching tip
    var t: wave13.Fly = wave13.fl_new(wave13.FL_TIP)
    t.title = "New: tabs"
    t.text = "Drag a tab out of the window to make it a window of its own."
    wave13.fl_set_anchor(&t, 100.0, 60.0, 40.0, 40.0)
    wave13.fl_open(&t)
    check(!t.light && t.closable && !t.kin && t.foc == wave13.FL_NONE, "a tip: no light dismiss, close button, keyboard outside")
    check(wave13.fl_key(&t, editor.KEY_TAB, false) == wave13.FR_NONE, "Tab is not taken while the keyboard is outside")
    check(!wave13.fl_window_hit(c, &t, 560.0, 520.0, 5.0, 500.0), "a tip owns only its panel")
    check(wave13.fl_part_rect(c, &t, 560.0, 520.0, wave13.FL_CLOSE, &r) && wave13.fl_hit(c, &t, 560.0, 520.0, r[0] + 4.0, r[1] + 4.0) == wave13.FL_CLOSE, "close button hit")
    wave13.fl_enter(&t)
    check(t.kin && t.foc == wave13.FL_CLOSE, "fl_enter: the keyboard goes in, on the close button")
    check(wave13.fl_key(&t, editor.KEY_ENTER, false) == wave13.FR_CLOSED && t.reason == wave13.RS_CLOSE, "Enter on the close button")
    // pixels
    clear(p)
    wave13.fl_open(&f)
    wave13.fl_set_anchor(&f, 200.0, 100.0, 80.0, 32.0)
    wave13.fl_draw(c, &f, 560.0, 520.0)
    g = wave13.fl_geom(c, &f, 560.0, 520.0)
    check(px(p, g.x + g.w / 2.0, g.y + 3.0) != tok(p, style.TOK_BASE), "the panel is painted over the page")
    check(px(p, g.tipx, g.tipy + 3.0) != tok(p, style.TOK_BASE), "the arrow is painted")
    kit.kit_set_rtl(false)
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("wave13: no font (DejaVu Sans)\n")
        return 9
    }
    var d: usize = 0
    while d < 2 {
        let dark: bool = d == 1
        var ts: str = "light"
        if dark { ts = "dark" }
        let p: *mut Page = page_new(560, 520, dark, fs as u64)
        if p as u64 == 0 {
            say("no page\n")
            return 2
        }
        run_model(p, ts, false)
        run_model(p, ts, true)
        if dir != 0 {
            if dark { save(&(*p).cv, dir, "wave13-dark.png") } else { save(&(*p).cv, dir, "wave13-light.png") }
        }
        d = d + 1
    }
    if BAD == 0 {
        say("WAVE13 PASSED\n")
        return 0
    }
    say("WAVE13 FAILED\n")
    return 1
}
