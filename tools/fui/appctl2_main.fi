// SPDX-License-Identifier: MPL-2.0
// tools/fui/appctl2_main.fi -- THE CHECK OF lib/fui/appctl.fi PART 2 (menus, tooltip, dialogs), WITHOUT A WINDOW.
//
// Builds a window with a menu bar, a context menu, tooltips and dialogs through the public appctl
// calls only, and drives it through the entry points the platform hosts call (fuiwirt pointer / tick,
// app_key + host_key, app_char).
//
//     firnc -o /tmp/appctl2 tools/fui/appctl2_main.fi && /tmp/appctl2
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.action

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut LAST_ID: usize = 0

static mut MAIL_ID: usize = 0
static mut OUT_ID: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_num(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

static mut FONT: u64 = 0

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn settle(a: *mut app.App) {
    let i: usize = fuiwirt.host_take_activated(app.app_host(a))
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
}

fn click_at(a: *mut app.App, s: *mut Surface, x: f64, y: f64) {
    let w: *mut fuiwirt.Host = app.app_host(a)
    let c1: u32 = fuiwirt.host_pointer_move(w, x, y)
    let c2: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let c3: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
    settle(a)
    frame(a, s)
}

fn click(a: *mut app.App, s: *mut Surface, id: usize) {
    let sc: *mut scene.Scene = app.app_scene(a)
    click_at(a, s, scene.node_x(sc, id) + scene.node_w(sc, id) / 2.0,
        scene.node_y(sc, id) + scene.node_h(sc, id) / 2.0)
}

fn key(a: *mut app.App, s: *mut Surface, k: u32) {
    let used: bool = app.app_key(a as u64, k, 0 as u32)
    if !used {
        let h: u32 = fuiwirt.host_key(app.app_host(a), 0 as u32, 0 as u32)
    }
    frame(a, s)
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
    LAST_ID = id
}

fn focus_on(a: *mut app.App, id: usize) {
    let r: u32 = fuiwirt.host_pointer_move(app.app_host(a), 1.0, 1.0)
    let f: bool = false
}

static mut ANS: u32 = 0

fn btn_none(a: *mut app.App) {
}
static mut ASKS: usize = 0

fn answered(a: *mut app.App, ans: u32) {
    ANS = ans
    ASKS = ASKS + 1
}

fn hkey(a: *mut app.App, s: *mut Surface, k: u32) {
    let r: u32 = fuiwirt.host_key(app.app_host(a), k, 0 as u32)
    frame(a, s)
}

fn hash(s: *mut Surface) -> u64 {
    let p: *mut u8 = canvas.canvas_pixels(&(*s).cv)
    var h: u64 = 2166136261
    var i: usize = 0
    while i < (*s).w * (*s).h * 4 {
        h = (h ^ ((*((p as u64 + i as u64) as *mut u8)) as u64)) * 16777619 % 4294967296
        i = i + 7
    }
    return h
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appctl2: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Part 2", 520, 420)
    let bar: usize = appctl.menubar(a)
    let mf: usize = appctl.menu(a, "&File")
    let i_new: usize = appctl.menu_item(a, mf, "file.new", "&New", changed)
    appctl.menu_shortcut(a, i_new, 78 as u32, action.MOD_CTRL)
    let i_open: usize = appctl.menu_item(a, mf, "file.open", "&Open", changed)
    let sp: bool = appctl.menu_sep(a, mf)
    let i_quit: usize = appctl.menu_item(a, mf, "file.quit", "&Quit", changed)
    let me: usize = appctl.menu(a, "&Edit")
    let i_wrap: usize = appctl.menu_check(a, me, "edit.wrap", "&Wrap", true, changed)
    appctl.menubar_end(a)
    let bt: usize = app.button(a, "Save", btn_none)
    let tp: bool = appctl.tooltip(a, bt, "Save the file")
    let lb: usize = app.label(a, "Right-click me", 0)
    let pm: usize = appctl.popup_menu(a)
    let i_copy: usize = appctl.menu_item(a, pm, "ctx.copy", "&Copy", changed)
    let cm: bool = appctl.context_menu(a, lb, pm)
    let cbx: usize = appctl.checkbox(a, "Behind", false, changed)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 520, 420)
    frame(a, s)
    frame(a, s)
    let w: *mut fuiwirt.Host = app.app_host(a)
    let sc: *mut scene.Scene = app.app_scene(a)

    // ---- the menu bar
    check(!appctl.menu_is_open(a), "no menu open at the start")
    LAST_ID = 999
    let h0: u64 = hash(s)
    let used: bool = app.app_char(a as u64, 102 as u32, editor.MOD_ALT)
    frame(a, s)
    check(used && appctl.menu_is_open(a), "Alt+F opens the File menu")
    check(hash(s) != h0, "the open menu is painted")
    hkey(a, s, fuiwirt.KEY_RETURN)
    check(!appctl.menu_is_open(a) && LAST_ID == i_new, "Alt+F, Enter runs the first item (focused on open) and closes")
    let r1: u32 = fuiwirt.host_char(w, 102 as u32, 0 as u32)
    let u2: bool = app.app_char(a as u64, 102 as u32, editor.MOD_ALT)
    frame(a, s)
    let c1: u32 = fuiwirt.host_char(w, 111 as u32, 0 as u32)
    frame(a, s)
    check(!appctl.menu_is_open(a) && LAST_ID == i_open, "the mnemonic letter in an open menu runs 'Open'")
    let u3: bool = app.app_char(a as u64, 110 as u32, editor.MOD_CTRL)
    check(u3 && LAST_ID == i_new, "Ctrl+N runs the shortcut of 'New'")
    appctl.menu_enable(a, i_new, false)
    LAST_ID = 999
    let u4: bool = app.app_char(a as u64, 110 as u32, editor.MOD_CTRL)
    check(LAST_ID != i_new, "a disabled item does not run from its shortcut")
    appctl.menu_enable(a, i_new, true)
    let u5: bool = app.app_char(a as u64, 102 as u32, editor.MOD_ALT)
    frame(a, s)
    let k1: bool = app.app_key(a as u64, editor.KEY_RIGHT, 0 as u32)
    frame(a, s)
    check(appctl.menu_is_open(a), "Right in the File menu opens the Edit menu")
    hkey(a, s, fuiwirt.KEY_DOWN)
    hkey(a, s, fuiwirt.KEY_RETURN)
    check(!appctl.menu_checked(a, i_wrap) && LAST_ID == i_wrap, "the check item flips its tick when chosen")
    let u6: bool = app.app_char(a as u64, 101 as u32, editor.MOD_ALT)
    hkey(a, s, fuiwirt.KEY_ESCAPE)
    check(!appctl.menu_is_open(a), "Esc closes the menu")
    click(a, s, mf)
    check(appctl.menu_is_open(a), "a click on a header opens its menu")
    hkey(a, s, fuiwirt.KEY_ESCAPE)

    // ---- the context menu
    let q1: u32 = fuiwirt.host_pointer_move(w, scene.node_x(sc, lb) + 5.0, scene.node_y(sc, lb) + 5.0)
    let q2: u32 = fuiwirt.host_pointer_down(w, scene.node_x(sc, lb) + 5.0, scene.node_y(sc, lb) + 5.0, fuiwirt.BTN_RIGHT)
    let q3: u32 = fuiwirt.host_pointer_up(w, scene.node_x(sc, lb) + 5.0, scene.node_y(sc, lb) + 5.0, fuiwirt.BTN_RIGHT)
    frame(a, s)
    check(ctxmenu.ctx_is_open(app.context(a)), "right click on the label opens its context menu")
    hkey(a, s, fuiwirt.KEY_ESCAPE)

    // ---- the tooltip
    fuiwirt.host_tick(w, 1000)
    let m1: u32 = fuiwirt.host_pointer_move(w, scene.node_x(sc, bt) + 5.0, scene.node_y(sc, bt) + 5.0)
    fuiwirt.host_tick(w, 1200)
    check(!appctl.tooltip_shown(a), "no tooltip before the delay")
    fuiwirt.host_tick(w, 1700)
    frame(a, s)
    check(appctl.tooltip_shown(a), "the tooltip shows after 500 ms of rest")
    let h2: u64 = hash(s)
    let m2: u32 = fuiwirt.host_pointer_move(w, 300.0, 380.0)
    frame(a, s)
    check(!appctl.tooltip_shown(a) && hash(s) != h2, "moving away hides it")

    // ---- the dialogs
    let o1: bool = appctl.message(a, "Saved", "The file was saved.\nAll good.", answered)
    frame(a, s)
    check(o1 && appctl.dialog_open(a), "message opens")
    check(!appctl.message(a, "x", "y", answered), "a second dialog is refused")
    let cb0: bool = appctl.checked(a, cbx)
    click(a, s, cbx)
    check(appctl.checked(a, cbx) == cb0, "the window behind a dialog gets no click")
    let k2: bool = app.app_key(a as u64, editor.KEY_ENTER, 0 as u32)
    check(!appctl.dialog_open(a) && ANS == appctl.ANS_OK && ASKS == 1, "Enter answers OK and closes")
    let o2: bool = appctl.confirm(a, "Delete", "Delete it?", answered)
    frame(a, s)
    let k3: bool = app.app_key(a as u64, editor.KEY_ESC, 0 as u32)
    check(!appctl.dialog_open(a) && ANS == appctl.ANS_CANCEL, "Esc cancels a confirm")
    let o3: bool = appctl.confirm(a, "Delete", "Delete it?", answered)
    frame(a, s)
    let k4: bool = app.app_key(a as u64, editor.KEY_TAB, 0 as u32)
    let k5: bool = app.app_key(a as u64, editor.KEY_ENTER, 0 as u32)
    check(ANS == appctl.ANS_CANCEL && !appctl.dialog_open(a), "Tab + Enter presses Cancel")
    let o4: bool = appctl.confirm(a, "Delete", "Delete it?", answered)
    frame(a, s)
    var r: [f64; 4] = [0.0; 4]
    check(appctl.dialog_rect(a, appctl.ANS_OK, &r), "the OK button has a rectangle")
    click_at(a, s, r[0] + r[2] / 2.0, r[1] + r[3] / 2.0)
    check(!appctl.dialog_open(a) && ANS == appctl.ANS_OK, "a click on OK answers OK")
    let o5: bool = appctl.input(a, "Rename", "New name:", "abc", answered)
    frame(a, s)
    let c2: bool = app.app_char(a as u64, 120 as u32, 0 as u32)
    let c3: bool = app.app_char(a as u64, 121 as u32, 0 as u32)
    frame(a, s)
    let t: str = appctl.dialog_text(a)
    check(t.n == 2 && appctl.dialog_open(a), "typing replaces the selected initial text")
    let k6: bool = app.app_key(a as u64, editor.KEY_ENTER, 0 as u32)
    check(!appctl.dialog_open(a) && ANS == appctl.ANS_OK && appctl.dialog_text(a).n == 2, "Enter in the field answers OK, text stays readable")
    check(app.audit(a) == 0, "accessibility audit: no unnamed element")
    if BAD == 0 {
        say("APPCTL2 PASSED\n")
        return 0
    }
    say("APPCTL2 FAILED (")
    say_num(BAD as i64)
    say(")\n")
    return 1
}
