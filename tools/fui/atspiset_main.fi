import std.rt
import std.env
import fui.atspi
import fui.kitset
import fui.mdedit
import fui.screenax
import fui.screenaxtree
import fui.widget

static mut BAD: usize = 0
static mut QUIT: bool = false
static mut TREE: u64 = 0
static mut SET: u64 = 0
static mut ED: u64 = 0

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }

fn expect(ok: bool, what: str) {
    if !ok {
        BAD = BAD + 1
        say("  WRONG ")
        say(what)
        say("\n")
    }
}

fn set() -> *mut kitset.Set { return SET as *mut kitset.Set }
fn editor() -> *mut mdedit.MdEd { return ED as *mut mdedit.MdEd }
fn tree() -> *mut screenaxtree.Tree { return TREE as *mut screenaxtree.Tree }

fn on_act(ud: u64, node: usize, row: usize) -> bool {
    let i: usize = screenaxtree.reg_of_node(tree(), node)
    if i != screenax.NONE && screenax.name_of(i) == "Quit" { QUIT = true }
    return true
}

fn on_focus(ud: u64, node: usize) -> bool { return true }

fn on_setnum(ud: u64, node: usize, v: i64) -> bool {
    let i: usize = screenaxtree.reg_of_node(tree(), node)
    if i == screenax.NONE { return false }
    return screenax.apply_num(i, v)
}

#[allow_escape]
fn on_settext(ud: u64, node: usize, t: str) -> bool {
    let i: usize = screenaxtree.reg_of_node(tree(), node)
    if i == screenax.NONE { return false }
    return screenax.apply_text(i, t)
}

fn frame() {
    screenax.begin()
    kitset.ax_row(set(), 3, kitset.SLIDER, "Size", 10.0, 10.0, 220.0, 24.0)
    kitset.ax_row(set(), 4, kitset.FIELD, "Name", 10.0, 50.0, 220.0, 38.0)
    mdedit.ax_editor_note(editor(), 10.0, 100.0, 300.0, 200.0)
    mdedit.ax_preview_note(editor(), 320.0, 100.0, 300.0, 200.0)
    screenax.note(widget.KIND_TEXTBOX, 0 as u32, "Plain", 10.0, 320.0, 100.0, 24.0, 0)
    screenax.note(widget.KIND_BUTTON, 0 as u32, "Quit", 10.0, 360.0, 80.0, 30.0, 0)
    if screenax.changed() { screenaxtree.publish(tree()) }
}

#[allow_escape]
fn main() -> i32 {
    screenax.install()
    SET = kitset.set_new() as u64
    kitset.reg_add(set(), 3, kitset.SLIDER, 10.0, 10.0, 220.0, 24.0)
    (*set()).lo[3] = 0
    (*set()).hi[3] = 200
    kitset.set_val(set(), 3, 40)
    kitset.reg_add(set(), 4, kitset.FIELD, 10.0, 50.0, 220.0, 38.0)
    kitset.set_text(set(), 4, "abc")
    ED = mdedit.new() as u64
    mdedit.set_text(editor(), "# Hi")
    TREE = screenaxtree.tree_new("Setters") as u64
    frame()
    let addr: str = env.get("FUI_ATSPI_ADDR")
    var br: atspi.Bridge = atspi.bridge_new(screenaxtree.tree_scene(tree()), screenaxtree.tree_ax(tree()), "Setters")
    atspi.bridge_set_actions(&br, 0, on_act, on_focus)
    atspi.bridge_set_setters(&br, on_setnum, on_settext)
    if addr.n == 0 || !atspi.bridge_open_address(&br, addr) {
        say("atspiset: no bus (set FUI_ATSPI_ADDR)\n")
        return 8
    }
    say("ATSPI READY\n")
    var waited: i64 = 0
    while !QUIT && waited < 25000 {
        let n: i32 = atspi.bridge_serve(&br, 100)
        atspi.bridge_poll(&br)
        if n < 0 { return 7 }
        if n == 0 { waited = waited + 100 }
        frame()
    }
    expect(QUIT, "the client ended the run")
    expect(kitset.val(set(), 3) == 200, "slider ends at the clamped top")
    expect(kitset.text_of(set(), 4) == "renamed", "field text set over the bus")
    expect(mdedit.text(editor()) == "set by reader", "editor text set over the bus")
    atspi.bridge_free(&br)
    if BAD == 0 { say("atspiset: all ok\n") }
    return BAD as i32
}
