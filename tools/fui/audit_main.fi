// SPDX-License-Identifier: MPL-2.0
// tools/fui/audit_main.fi -- THE ACCESSIBILITY AUDIT HAS TEETH (r98).
//
// lib/fui/audit.fi counts what must be zero in every fUi program: operable
// nodes without a name, duplicate keys, secrets in the export. A check that
// never fails proves nothing, so each count is shown to come out non-zero for
// a tree built to be wrong, and zero for the same tree repaired:
//
//   1. a clean tree passes (and says how many controls it has)
//   2. an unnamed button is counted; naming it (a11y_set_name) clears it
//   3. two nodes with one key under one parent are counted
//   4. a secret field passes, its text is back after the audit
//   5. the canary search finds a leak when there is one: an ORDINARY text
//      field holding the canary shows up in the dump, a secret one does not
//   6. an empty tree fails
//   7. the log line says what is wrong
import std.rt
import fui.scene
import fui.widget
import fui.a11y
import fui.query
import fui.audit

static mut G_ERRORS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_int(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn eq(name: str, got: i64, want: i64) {
    say("  ")
    say(name)
    var k: usize = name.n
    while k < 62 {
        say(" ")
        k = k + 1
    }
    if got == want {
        say("OK    got ")
    } else {
        say("WRONG got ")
        G_ERRORS = G_ERRORS + 1
    }
    say_int(got)
    say(" want ")
    say_int(want)
    say("\n")
}

fn key(s: str) -> u32 {
    return query.query_key(s.p as u64, s.n)
}

fn button(sc: *mut scene.Scene, parent: usize, text: str, k: str) -> usize {
    let b: usize = scene.scene_widget(sc, parent, widget.KIND_BUTTON, text.p as u64, text.n)
    if k.n > 0 {
        scene.node_set_id(sc, b, key(k))
    }
    scene.node_set_size(sc, b, 100.0, 30.0)
    return b
}

fn root(sc: *mut scene.Scene) -> usize {
    scene.scene_reset(sc)
    let r: usize = scene.scene_add(sc, scene.SCENE_NONE, scene.N_BOX)
    scene.node_set_id(sc, r, key("app"))
    return r
}

// The scene keeps pointers to the texts that stand in this frame.
#[allow_escape]
fn main(start: u64) -> i32 {
    let sc: *mut scene.Scene = rt.heap_alloc(1048576) as *mut scene.Scene
    *sc = scene.scene_new()
    var ax: a11y.A11y = a11y.a11y_new()

    say("== 1. a clean tree\n")
    var r: usize = root(sc)
    let ok1: usize = button(sc, r, "Save", "save")
    let ok2: usize = button(sc, r, "Cancel", "cancel")
    var a: audit.Audit = audit.audit_tree_ax(sc, &ax)
    eq("2 controls", a.controls as i64, 2)
    eq("none unnamed", a.unnamed as i64, 0)
    eq("no duplicate keys", a.key_dups as i64, 0)
    eq("it passes", audit.audit_ok(&a) as i64, 1)

    say("== 2. an unnamed button\n")
    r = root(sc)
    let nb: usize = button(sc, r, "", "icon")
    let nb2: usize = button(sc, r, "OK", "ok")
    a = audit.audit_tree_ax(sc, &ax)
    eq("one control has no name", a.unnamed as i64, 1)
    eq("it is the first button", a.first_unnamed as i64, nb as i64)
    eq("it fails", audit.audit_ok(&a) as i64, 0)
    var nm: [u8; 11] = "Close panel"
    a11y.a11y_set_name(&ax, nb, (&nm[0]) as u64, 11)
    a = audit.audit_tree_ax(sc, &ax)
    eq("named with a11y_set_name: none unnamed", a.unnamed as i64, 0)
    eq("it passes", audit.audit_ok(&a) as i64, 1)
    a11y.a11y_reset(&ax)

    say("== 3. duplicate keys\n")
    r = root(sc)
    let d1: usize = button(sc, r, "One", "same")
    let d2: usize = button(sc, r, "Two", "same")
    a = audit.audit_tree_ax(sc, &ax)
    eq("the second #same is counted", a.key_dups as i64, 1)
    eq("it fails", audit.audit_ok(&a) as i64, 0)
    r = root(sc)
    let row1: usize = scene.scene_box(sc, r, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    scene.node_set_id(sc, row1, key("row1"))
    let row2: usize = scene.scene_box(sc, r, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    scene.node_set_id(sc, row2, key("row2"))
    let e1: usize = button(sc, row1, "Edit", "edit")
    let e2: usize = button(sc, row2, "Edit", "edit")
    a = audit.audit_tree_ax(sc, &ax)
    eq("the same key under two different parents is fine", a.key_dups as i64, 0)

    say("== 4. a secret field\n")
    r = root(sc)
    var pw: [u8; 7] = "hunter2"
    let f: usize = scene.scene_widget(sc, r, widget.KIND_TEXTBOX, (&pw[0]) as u64, 7)
    scene.node_set_id(sc, f, key("pw"))
    widget.w_set_secret(scene.node_widget(sc, f), true)
    var nm2: [u8; 8] = "Password"
    a11y.a11y_set_name(&ax, f, (&nm2[0]) as u64, 8)
    a = audit.audit_tree_ax(sc, &ax)
    eq("one secret", a.secrets as i64, 1)
    eq("the canary does not reach the dump: no leak", a.leaks as i64, 0)
    eq("it passes", audit.audit_ok(&a) as i64, 1)
    eq("the text is back after the audit (same pointer)",
        (widget.w_text(scene.node_widget(sc, f)) == (&pw[0]) as u64) as i64, 1)
    eq("and the same length", widget.w_text_len(scene.node_widget(sc, f)) as i64, 7)
    a11y.a11y_reset(&ax)

    say("== 5. the canary search finds a leak\n")
    r = root(sc)
    var cn: [u8; 22] = "FUI-AUDIT-CANARY-7-XYZ"
    let g: usize = scene.scene_widget(sc, r, widget.KIND_TEXTBOX, (&cn[0]) as u64, 22)
    scene.node_set_id(sc, g, key("plain"))
    var nm3: [u8; 5] = "Notes"
    a11y.a11y_set_name(&ax, g, (&nm3[0]) as u64, 5)
    let buf: u64 = rt.heap_alloc(8192)
    let n: usize = a11y.a11y_dump(sc, &ax, buf, 8192)
    eq("an ORDINARY text field's text IS in the dump",
        (audit.audit_find(buf, n, (&cn[0]) as u64, 8) < n) as i64, 1)
    // ... and a secret one's is not
    widget.w_set_secret(scene.node_widget(sc, g), true)
    let n2: usize = a11y.a11y_dump(sc, &ax, buf, 8192)
    eq("the same field as a SECRET: not in the dump",
        (audit.audit_find(buf, n2, (&cn[0]) as u64, 8) < n2) as i64, 0)
    eq("audit_find: not in unrelated bytes", audit.audit_find((&pw[0]) as u64, 7, (&cn[0]) as u64, 8) as i64, 7)
    eq("audit_find: an empty needle is never found", audit.audit_find(buf, n2, (&cn[0]) as u64, 0) as i64, n2 as i64)
    rt.heap_free(buf, 8192)
    a11y.a11y_reset(&ax)

    say("== 6. an empty tree\n")
    scene.scene_reset(sc)
    a = audit.audit_tree_ax(sc, &ax)
    eq("no nodes", a.nodes as i64, 0)
    eq("it fails", audit.audit_ok(&a) as i64, 0)

    say("== 7. the log line\n")
    r = root(sc)
    let l1: usize = button(sc, r, "", "x")
    a = audit.audit_tree_ax(sc, &ax)
    var b: rt.Buf = rt.buf_new()
    audit.audit_line(&a, &b)
    let line: u64 = rt.buf_ptr(&b)
    let ln: usize = rt.buf_len(&b)
    var f1: [u8; 6] = "FAILED"
    var f2: [u8; 12] = "1 unnamed, 0"
    eq("it says FAILED", (audit.audit_find(line, ln, (&f1[0]) as u64, 6) < ln) as i64, 1)
    eq("it counts 1 unnamed", (audit.audit_find(line, ln, (&f2[0]) as u64, 11) < ln) as i64, 1)
    rt.buf_free(&b)

    if G_ERRORS == 0 {
        say("AUDIT PASSED\n")
        return 0
    }
    say("AUDIT FAILED: ")
    say_int(G_ERRORS as i64)
    say("\n")
    return 1
}
