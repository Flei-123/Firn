import std.rt
import paint.canvas
import font.metrics
import fui.painter
import fui.scene
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.app
import fui.appwin

static mut BAD: usize = 0
static mut FONT: u64 = 0
static mut CLOSED: usize = 0

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h) || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    fuiwirt.host_bind(app.app_host(a))
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn lines_of_label(a: *mut app.App, id: usize) -> usize {
    return widget.w_text_lines(scene.node_widget(app.app_scene(a), id))
}

fn on_closed(a: *mut app.App) {
    CLOSED = CLOSED + 1
}

fn nothing(a: *mut app.App) {}

const LONG: str = "A long sentence that is much wider than any of these small windows and has to wrap into several lines"

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appwin: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let main_app: *mut app.App = app.window("Main", 520, 300)
    let main_label: usize = app.label(main_app, LONG, 0)
    let child: *mut app.App = appwin.open("Child", 260, 300)
    check((child as u64 != 0) == appwin.supported(), "a second window opens exactly where the platform supports it")
    if !appwin.supported() {
        check(appwin.count() == 0, "nothing is registered when refused")
        check(!appwin.alive(child), "a refused window is not alive")
    } else {
        check(appwin.count() == 1 && appwin.alive(child), "the child is registered and alive")
        check(appwin.at(0) == child, "windows are listed in opening order")
        appwin.on_close(child, on_closed)
        let child_label: usize = app.label(child, LONG, 0)
        let sm: *mut Surface = surface_for(main_app, 520, 300)
        let sc: *mut Surface = surface_for(child, 260, 300)
        frame(main_app, sm)
        frame(child, sc)
        frame(main_app, sm)
        frame(child, sc)
        check(lines_of_label(main_app, main_label) < lines_of_label(child, child_label),
            "each window wraps its own label to its own width")
        let third: *mut app.App = appwin.open("Third", 200, 200)
        check(appwin.count() == 2 && appwin.at(1) == third, "several windows can be open")
        var extra: usize = 0
        var more: *mut app.App = appwin.open("More", 100, 100)
        while more as u64 != 0 {
            extra = extra + 1
            more = appwin.open("More", 100, 100)
        }
        check(appwin.count() == appwin.SLOT_MAX, "the window table is bounded")
        appwin.close(child)
        check(!appwin.alive(child) && appwin.alive(third), "closing one window leaves the others alive")
        check(!app.app_done(main_app as u64), "closing a child does not quit the main window")
    }
    if BAD == 0 {
        say("APPWIN PASSED\n")
        return 0
    }
    say("APPWIN FAILED\n")
    return 1
}
