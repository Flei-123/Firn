// SPDX-License-Identifier: MPL-2.0
// tools/fui/sizeclass_main.fi -- THE CHECK OF lib/fui/sizeclass.fi (responsive size classes). Gate of gap list
// #5: the app switches its layout at 600 / 900 dp, tested at 3 widths, plus hysteresis and columns.
// Pure: no window. Exit 1 on any WRONG.
import std.rt
import fui.sizeclass

static mut BAD: usize = 0

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }

fn check(ok: bool, what: str) {
    if ok { say("  ok    ") } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn main(start: u64) -> i32 {
    say("== sizeclass ==\n")
    check(sizeclass.classify(0, 600, 900) == sizeclass.SC_COMPACT, "0 dp compact")
    check(sizeclass.classify(599, 600, 900) == sizeclass.SC_COMPACT, "599 dp compact")
    check(sizeclass.classify(600, 600, 900) == sizeclass.SC_MEDIUM, "600 dp medium")
    check(sizeclass.classify(899, 600, 900) == sizeclass.SC_MEDIUM, "899 dp medium")
    check(sizeclass.classify(900, 600, 900) == sizeclass.SC_EXPANDED, "900 dp expanded")
    check(sizeclass.classify(5000, 600, 900) == sizeclass.SC_EXPANDED, "5000 dp expanded")

    // the three-width layout switch of the gate: phone / tablet / desktop
    var t: sizeclass.Tracker = sizeclass.tracker_new()
    check(sizeclass.track(&t, 360), "first call reports a change")
    check(sizeclass.nav_mode(sizeclass.class_w(&t)) == sizeclass.NAV_BOTTOM, "360 dp -> bottom bar")
    check(sizeclass.track(&t, 700) && sizeclass.nav_mode(sizeclass.class_w(&t)) == sizeclass.NAV_RAIL, "700 dp -> rail")
    check(sizeclass.track(&t, 1200) && sizeclass.nav_mode(sizeclass.class_w(&t)) == sizeclass.NAV_SIDEBAR, "1200 dp -> sidebar")
    check(!sizeclass.track(&t, 1300), "same class: no change")

    // hysteresis: expanded falls only below 900 - 16 = 884
    check(!sizeclass.track(&t, 895) && sizeclass.class_w(&t) == sizeclass.SC_EXPANDED, "895 dp stays expanded (inside the band)")
    check(!sizeclass.track(&t, 884) && sizeclass.class_w(&t) == sizeclass.SC_EXPANDED, "884 dp still expanded")
    check(sizeclass.track(&t, 883) && sizeclass.class_w(&t) == sizeclass.SC_MEDIUM, "883 dp falls to medium")
    check(!sizeclass.track(&t, 899) && sizeclass.class_w(&t) == sizeclass.SC_MEDIUM, "899 dp stays medium until 900")
    check(sizeclass.track(&t, 900) && sizeclass.class_w(&t) == sizeclass.SC_EXPANDED, "900 dp rises")
    // dragging back and forth over the line produces no flicker: count changes
    var flips: usize = 0
    var w: i64 = 880
    while w < 920 {
        if sizeclass.track(&t, w) { flips = flips + 1 }
        w = w + 1
    }
    var w2: i64 = 920
    while w2 > 880 {
        if sizeclass.track(&t, w2) { flips = flips + 1 }
        w2 = w2 - 1
    }
    check(flips <= 3, "drag across the line: at most 3 changes (no flicker)")

    // a big jump settles in one call
    var j: sizeclass.Tracker = sizeclass.tracker_new()
    sizeclass.track(&j, 300)
    check(sizeclass.track(&j, 1920) && sizeclass.class_w(&j) == sizeclass.SC_EXPANDED, "300 -> 1920 in one call is expanded")
    check(sizeclass.track(&j, 200) && sizeclass.class_w(&j) == sizeclass.SC_COMPACT, "1920 -> 200 in one call is compact")

    // own lines
    var o: sizeclass.Tracker = sizeclass.tracker_new()
    sizeclass.set_lines(&o, 480, 720)
    sizeclass.set_hysteresis(&o, 0)
    sizeclass.track(&o, 479)
    check(sizeclass.class_w(&o) == sizeclass.SC_COMPACT, "own lines: 479 compact")
    sizeclass.track(&o, 480)
    check(sizeclass.class_w(&o) == sizeclass.SC_MEDIUM, "own lines: 480 medium")
    sizeclass.track(&o, 720)
    check(sizeclass.class_w(&o) == sizeclass.SC_EXPANDED, "own lines: 720 expanded")
    sizeclass.set_lines(&o, 500, 300)
    sizeclass.track(&o, 501)
    check(sizeclass.class_w(&o) != sizeclass.SC_COMPACT, "lines with l2 <= l1 are repaired (l2 = l1 + 1)")

    // height classes: phone in landscape
    var h: sizeclass.Tracker = sizeclass.tracker_new()
    sizeclass.track(&h, 850)
    sizeclass.track_h(&h, 400)
    check(sizeclass.class_w(&h) == sizeclass.SC_MEDIUM && sizeclass.class_h(&h) == sizeclass.SC_COMPACT, "landscape phone: wide medium, low compact")
    check(sizeclass.is_compact_any(&h), "compact in any direction")
    check(sizeclass.track_h(&h, 1000) && sizeclass.class_h(&h) == sizeclass.SC_EXPANDED, "tall window -> expanded height")
    check(!sizeclass.is_compact_any(&h), "no longer compact")

    // columns
    check(sizeclass.columns(1000, 280, 16, 6) == 3, "1000 dp / 280 dp cards + 16 gap = 3 columns")
    check(sizeclass.columns(872, 280, 16, 6) == 3, "872 = 3*280 + 2*16 exactly fits 3")
    check(sizeclass.columns(871, 280, 16, 6) == 2, "871 fits only 2")
    check(sizeclass.columns(100, 280, 16, 6) == 1, "narrower than one card: still 1")
    check(sizeclass.columns(5000, 280, 16, 4) == 4, "capped at max_cols")
    check(sizeclass.columns(500, 0, 0, 3) == 3, "degenerate min_col 0 is capped by max_cols")

    // pick + container queries
    check(sizeclass.pick(sizeclass.SC_COMPACT, 8, 16, 24) == 8 && sizeclass.pick(sizeclass.SC_MEDIUM, 8, 16, 24) == 16
        && sizeclass.pick(sizeclass.SC_EXPANDED, 8, 16, 24) == 24, "pick by class")
    check(sizeclass.fits_min(400, 400) && !sizeclass.fits_min(399, 400), "container min-width")
    check(sizeclass.fits_range(300, 300, 500) && !sizeclass.fits_range(500, 300, 500), "container range [lo, hi)")
    // a 400 dp side panel on a 1920 dp screen is compact
    check(sizeclass.classify(400, 600, 900) == sizeclass.SC_COMPACT, "container 400 dp inside a big window is compact")

    say("SIZECLASS bad=")
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, BAD as u64)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    say("\n")
    if BAD > 0 { return 1 }
    return 0
}
