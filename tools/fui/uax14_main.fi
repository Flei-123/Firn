// SPDX-License-Identifier: MPL-2.0
// tools/fui/uax14_main.fi -- the painter wraps lines by UAX #14 (fUi W14).
//
//     uax14 <font.ttf>
import std.rt
import paint.canvas
import font.metrics
import fui.painter

const FONTSET_BYTES: usize = 4096
static mut FAILS: usize = 0

fn expect(name: u64, nn: usize, got: i64, want: i64) {
    if got != want {
        FAILS = FAILS + 1
        var t: rt.Buf = rt.buf_new()
        var a: [u8; 5] = "FAIL "
        rt.buf_push_bytes(&t, (&a[0]) as u64, 5)
        rt.buf_push_bytes(&t, name, nn)
        var b: [u8; 6] = " got  "
        rt.buf_push_bytes(&t, (&b[0]) as u64, 6)
        rt.buf_push_dec_i64(&t, got)
        var c: [u8; 6] = " want "
        rt.buf_push_bytes(&t, (&c[0]) as u64, 6)
        rt.buf_push_dec_i64(&t, want)
        rt.buf_push(&t, 10 as u8)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
    }
}

fn main(start: u64) -> i32 {
    var fbuf: rt.Buf = rt.buf_new()
    if rt.arg_count(start) < 2 || !rt.read_file(rt.arg_ptr(start, 1), &fbuf) {
        return 2
    }
    let fsp: *mut metrics.FontSet = rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    *fsp = metrics.fontset_new()
    if !metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
        return 3
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, 640, 120) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, 640, 120) {
        return 5
    }
    painter.painter_set_font(&z, fsp as u64)
    var r: painter.TextRun = painter.run_new(16.0)
    var to: usize = 0
    // 1. a hyphen is a break: "xx yy-" fits, "zz" goes down
    var s1: [u8; 9] = "xx yy-zz "
    let w6: f64 = painter.run_width(&z, &r, (&s1[0]) as u64, 6)
    var up: usize = painter.run_line_upto(&z, &r, (&s1[0]) as u64, 8, w6 + 1.0, &to)
    var n1: [u8; 6] = "hyphen"
    expect((&n1[0]) as u64, 6, up as i64, 6)
    expect((&n1[0]) as u64, 6, to as i64, 6)
    // 2. spaces hang: the line is "xx", the next one starts at "yy"
    var s2: [u8; 7] = "xx   yy"
    let w2: f64 = painter.run_width(&z, &r, (&s2[0]) as u64, 2)
    up = painter.run_line_upto(&z, &r, (&s2[0]) as u64, 7, w2 + 1.0, &to)
    var n2: [u8; 5] = "hangs"
    expect((&n2[0]) as u64, 5, up as i64, 2)
    expect((&n2[0]) as u64, 5, to as i64, 5)
    // 3. no break inside a number with a separator
    var s3: [u8; 8] = "ab 10,00"
    let w4: f64 = painter.run_width(&z, &r, (&s3[0]) as u64, 5)
    up = painter.run_line_upto(&z, &r, (&s3[0]) as u64, 8, w4 + 1.0, &to)
    var n3: [u8; 6] = "number"
    expect((&n3[0]) as u64, 6, up as i64, 2)
    expect((&n3[0]) as u64, 6, to as i64, 3)
    // 4. a line end is a must
    var s4: [u8; 5] = "ab\ncd"
    up = painter.run_line_upto(&z, &r, (&s4[0]) as u64, 5, 500.0, &to)
    var n4: [u8; 4] = "must"
    expect((&n4[0]) as u64, 4, up as i64, 2)
    expect((&n4[0]) as u64, 4, to as i64, 3)
    // 5. ideographs break between any two (3 octets each)
    var s5: [u8; 12] = "\u{4e2d}\u{6587}\u{6587}\u{5b57}"
    let wc: f64 = painter.run_width(&z, &r, (&s5[0]) as u64, 6)
    up = painter.run_line_upto(&z, &r, (&s5[0]) as u64, 12, wc + 1.0, &to)
    var n5: [u8; 3] = "cjk"
    expect((&n5[0]) as u64, 3, up as i64, 6)
    expect((&n5[0]) as u64, 3, to as i64, 6)
    var ok: [u8; 18] = "UAX14 checks done\n"
    rt.write_everything(1, (&ok[0]) as u64, 18)
    if FAILS > 0 {
        return 1
    }
    return 0
}
