import std.rt
import fui.kitdoc
import docview.dvinstall

fn main(start: u64) -> i32 {
    dvinstall.install_builtin()
    var v: kitdoc.DocView = kitdoc.docv_new()
    let n: usize = 4096
    let d: u64 = rt.heap_alloc(n)
    let ok: bool = kitdoc.docv_open(&v, d, n, "a.pdf")
    kitdoc.docv_free(&v)
    if ok {
        return 1
    }
    return 0
}
