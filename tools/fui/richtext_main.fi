// SPDX-License-Identifier: MPL-2.0
// tools/fui/richtext_main.fi -- THE CHECK OF lib/fui/richtext.fi (rich text and the
// selectable label).
//
// Text is laid out and painted into a canvas with the real font and theme, the pixels
// are read back: styles (link colour, underline under the pointer, strike line, the
// colour of a span), wrapping (width -> number of lines, a hard break, a word wider than
// the line), the selection (drag, double click = word, triple click = paragraph, Ctrl+A,
// the selection colour behind the text), Ctrl+C into a clipboard hook, link clicks, and a
// right-to-left paragraph (starts on the right).
//
//     firnc -o /tmp/richtext tools/fui/richtext_main.fi && /tmp/richtext [dir]
import std.rt
import std.io
import paint.canvas
import paint.png
import html.mem
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.style
import fui.richtext
import fui.editor
import fui.kitcolor
import plat.sysfont

static mut BAD: usize = 0
static mut CHECKS: usize = 0
static mut CLICKED: u32 = 0
static mut CLIP_N: usize = 0
static mut CLIP: [u8; 256] = [0 as u8; 256]

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: io.Fmt) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    io.fmt_print_line(what)
}

fn checkp(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn on_link(ud: u64, id: u32) {
    CLICKED = id
}

fn on_clip(p: u64, n: usize) -> bool {
    var i: usize = 0
    CLIP_N = n
    if n > 256 {
        CLIP_N = 256
    }
    while i < CLIP_N {
        CLIP[i] = rt.ld8(p, i)
        i = i + 1
    }
    return true
}

fn clip_is(s: str) -> bool {
    if CLIP_N != s.n {
        return false
    }
    var i: usize = 0
    while i < s.n {
        if CLIP[i] != rt.ld8(s.p as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
    w: usize,
    h: usize,
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    theme.theme_set_accent(&(*p).m, 0x1BD96A as u32)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    (*p).w = w
    (*p).h = h
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn tokc(p: *mut Page, t: u32) -> u32 {
    return theme.opaque(render.color_of(&(*p).c, style.color_token(t)))
}

fn clear(p: *mut Page) {
    canvas.canvas_clear(&(*p).cv, tokc(p, style.TOK_BASE))
}

fn count_col(p: *mut Page, x0: f64, y0: f64, x1: f64, y1: f64, col: u32) -> usize {
    var n: usize = 0
    var y: f64 = y0
    while y < y1 {
        var x: f64 = x0
        while x < x1 {
            if canvas.canvas_get(&(*p).cv, x as usize, y as usize) == col {
                n = n + 1
            }
            x = x + 1.0
        }
        y = y + 1.0
    }
    return n
}

fn chan_near(a: u32, b: u32, sh: u32, tol: u32) -> bool {
    let x: u32 = (a >> sh) & 255 as u32
    let y: u32 = (b >> sh) & 255 as u32
    var d: u32 = 0 as u32
    if x >= y {
        d = x - y
    } else {
        d = y - x
    }
    return d <= tol
}

// pixels within `tol` per channel of `col`
fn count_near(p: *mut Page, x0: f64, y0: f64, x1: f64, y1: f64, col: u32, tol: u32) -> usize {
    var n: usize = 0
    var y: f64 = y0
    while y < y1 {
        var x: f64 = x0
        while x < x1 {
            let v: u32 = canvas.canvas_get(&(*p).cv, x as usize, y as usize)
            if chan_near(v, col, 0 as u32, tol) && chan_near(v, col, 8 as u32, tol) && chan_near(v, col, 16 as u32, tol) {
                n = n + 1
            }
            x = x + 1.0
        }
        y = y + 1.0
    }
    return n
}

// pixels that are not the page ground
fn count_ink(p: *mut Page, x0: f64, y0: f64, x1: f64, y1: f64) -> usize {
    let bg: u32 = tokc(p, style.TOK_BASE)
    var n: usize = 0
    var y: f64 = y0
    while y < y1 {
        var x: f64 = x0
        while x < x1 {
            if canvas.canvas_get(&(*p).cv, x as usize, y as usize) != bg {
                n = n + 1
            }
            x = x + 1.0
        }
        y = y + 1.0
    }
    return n
}

// the left-most and right-most x of a pixel that is not the ground, in a band
fn ink_x(p: *mut Page, y0: f64, y1: f64, lo: *mut f64, hi: *mut f64) -> bool {
    let bg: u32 = tokc(p, style.TOK_BASE)
    var found: bool = false
    var a: f64 = 100000.0
    var b: f64 = 0.0
    var y: f64 = y0
    while y < y1 {
        var x: f64 = 0.0
        while x < (*p).w as f64 {
            if canvas.canvas_get(&(*p).cv, x as usize, y as usize) != bg {
                found = true
                if x < a { a = x }
                if x > b { b = x }
            }
            x = x + 1.0
        }
        y = y + 1.0
    }
    *lo = a
    *hi = b
    return found
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = rt.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

fn text_of(r: *mut richtext.RichText, out: *mut rt.Buf) {
    rt.buf_clear(out)
    richtext.rt_selection_text(r, out)
}

fn sel_is(r: *mut richtext.RichText, s: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    text_of(r, &b)
    let ok: bool = rt.buf_len(&b) == s.n && rt.mem_eq(rt.buf_ptr(&b), s.p as u64, s.n)
    rt.buf_free(&b)
    return ok
}

fn run_theme(dir: u64, font: u64, dark: bool, tag: str) {
    let p: *mut Page = page_new(420, 260, dark, font)
    clear(p)
    var r: richtext.RichText = richtext.rt_new()
    richtext.rt_set_link_cb(&r, 0, on_link)
    richtext.rt_set_clipboard(&r, on_clip)
    richtext.rt_append(&r, "Hello ", 0 as u32, 0 as u32, 0 as u32)
    richtext.rt_append(&r, "bold", richtext.RT_BOLD, 0 as u32, 0 as u32)
    richtext.rt_append(&r, " and ", 0 as u32, 0 as u32, 0 as u32)
    richtext.rt_append(&r, "red", 0 as u32, 0xFFD32F2F as u32, 0 as u32)
    richtext.rt_append(&r, " and a link", 0 as u32, 0 as u32, 7 as u32)
    richtext.rt_append(&r, " and struck", richtext.RT_STRIKE, 0 as u32, 0 as u32)
    richtext.rt_append(&r, " text that goes on for a while so that it must wrap.", 0 as u32, 0 as u32, 0 as u32)
    let base: u32 = tokc(p, style.TOK_BASE)
    // a wide paragraph is fewer lines than a narrow one
    richtext.rt_layout(&r, &(*p).c, 400.0)
    let wide: usize = richtext.rt_line_count(&r)
    richtext.rt_layout(&r, &(*p).c, 140.0)
    let narrow: usize = richtext.rt_line_count(&r)
    check(wide >= 1 && narrow > wide, f"{tag}: lines at 400 pt: {wide}, at 140 pt: {narrow}")
    richtext.rt_paint(&r, &(*p).c, 10.0, 10.0, 400.0)
    let h: f64 = richtext.rt_height(&r)
    check(h > 15.0 && h < 120.0, f"{tag}: the paragraph is {h} high")
    // the red span has its colour, the link the accent as readable text, plain text the theme's
    let red: u32 = 0xFFD32F2F as u32 & 16777215 as u32 | (255 as u32 << 24)
    check(count_col(p, 0.0, 0.0, 420.0, 240.0, red) > 20, f"{tag}: the red span has its colour")
    let m: *mut theme.Theme = render.ctx_theme(&(*p).c)
    let f: *mut theme.Colors = theme.theme_colors(m)
    let linkc: u32 = theme.opaque(kitcolor.accent_text(m, (*f).base))
    check(count_near(p, 0.0, 0.0, 420.0, 240.0, linkc, 24 as u32) > 20, f"{tag}: the link has the readable accent")
    check(count_col(p, 0.0, 0.0, 420.0, 240.0, tokc(p, style.TOK_TEXT)) > 100, f"{tag}: plain text has the text colour")
    var nm1: str = "richtext-light.png"
    var nm2: str = "richtext-light-selected.png"
    if dark {
        nm1 = "richtext-dark.png"
        nm2 = "richtext-dark-selected.png"
    }
    save(&(*p).cv, dir, nm1)
    // the link under the pointer gets an underline (more link-coloured pixels than before)
    let before: usize = count_ink(p, 0.0, 0.0, 420.0, 240.0)
    var changed: bool = false
    // find the link: scan along the first line for a hover hit
    var lx: f64 = 10.0
    var hit: u32 = 0 as u32
    while lx < 400.0 && hit == 0 as u32 {
        hit = richtext.rt_link_at(&r, &(*p).c, lx, 10.0 + 8.0)
        if hit == 0 as u32 {
            lx = lx + 4.0
        }
    }
    check(hit == 7 as u32, f"{tag}: rt_link_at finds link 7 (x = {lx})")
    changed = richtext.rt_pointer_move(&r, &(*p).c, lx, 18.0)
    clear(p)
    richtext.rt_paint(&r, &(*p).c, 10.0, 10.0, 400.0)
    let after: usize = count_ink(p, 0.0, 0.0, 420.0, 240.0)
    check(changed && after > before + 15, f"{tag}: the link under the pointer is underlined ({before} -> {after} ink pixels)")
    // a click on the link calls the callback; a press elsewhere does not
    CLICKED = 0 as u32
    richtext.rt_pointer_down(&r, &(*p).c, lx, 18.0)
    let clicked: bool = richtext.rt_pointer_up(&r, &(*p).c, lx, 18.0)
    check(clicked && CLICKED == 7 as u32, f"{tag}: a click on the link calls back with its id")
    // --- selection by drag: from before "bold" to after it
    rt_reset_sel(&r)
    var yb: f64 = 0.0
    var hb: f64 = 0.0
    let xs: f64 = 10.0 + richtext.rt_caret_x(&r, &(*p).c, 6, &yb, &hb)
    let xe: f64 = 10.0 + richtext.rt_caret_x(&r, &(*p).c, 10, &yb, &hb)
    richtext.rt_set_time(&r, 1000)
    richtext.rt_pointer_down(&r, &(*p).c, xs + 1.0, 18.0)
    richtext.rt_pointer_move(&r, &(*p).c, xe - 1.0, 18.0)
    richtext.rt_pointer_up(&r, &(*p).c, xe - 1.0, 18.0)
    checkp(sel_is(&r, "bold"), "a drag over a word selects exactly that word")
    clear(p)
    richtext.rt_paint(&r, &(*p).c, 10.0, 10.0, 400.0)
    let selc: u32 = tokc(p, style.TOK_SELECTION)
    check(count_col(p, 0.0, 0.0, 420.0, 240.0, selc) > 50, f"{tag}: the selection is painted in the selection colour")
    save(&(*p).cv, dir, nm2)
    // Ctrl+C
    CLIP_N = 0
    let taken: bool = richtext.rt_char(&r, 3 as u32, 0 as u32)
    checkp(taken && clip_is("bold"), "Ctrl+C (control character 3) copies the selection to the clipboard")
    CLIP_N = 0
    richtext.rt_char(&r, 99 as u32, editor.MOD_CTRL)
    checkp(clip_is("bold"), "Ctrl + the letter c copies it too")
    // double click: the word
    rt_reset_sel(&r)
    richtext.rt_set_time(&r, 5000)
    richtext.rt_pointer_down(&r, &(*p).c, xs + 3.0, 18.0)
    richtext.rt_pointer_up(&r, &(*p).c, xs + 3.0, 18.0)
    richtext.rt_set_time(&r, 5200)
    richtext.rt_pointer_down(&r, &(*p).c, xs + 3.0, 18.0)
    richtext.rt_pointer_up(&r, &(*p).c, xs + 3.0, 18.0)
    checkp(sel_is(&r, "bold"), "a double click selects the word under the pointer")
    // triple click: the paragraph
    richtext.rt_set_time(&r, 5400)
    richtext.rt_pointer_down(&r, &(*p).c, xs + 3.0, 18.0)
    richtext.rt_pointer_up(&r, &(*p).c, xs + 3.0, 18.0)
    var lo: usize = 0
    var hi: usize = 0
    richtext.rt_selection(&r, &lo, &hi)
    check(lo == 0 && hi == richtext.rt_text_len(&r), f"{tag}: a third click selects the paragraph ({lo}..{hi})")
    // Ctrl+A
    rt_reset_sel(&r)
    richtext.rt_char(&r, 1 as u32, 0 as u32)
    richtext.rt_selection(&r, &lo, &hi)
    check(lo == 0 && hi == richtext.rt_text_len(&r), f"{tag}: Ctrl+A selects everything")
    richtext.rt_free(&r)
}

fn rt_reset_sel(r: *mut richtext.RichText) {
    richtext.rt_clear_selection(r)
    richtext.rt_set_time(r, 100000)
}

fn run_wrap(font: u64) {
    let p: *mut Page = page_new(300, 200, false, font)
    var r: richtext.RichText = richtext.rt_new()
    richtext.rt_set_text(&r, "one\ntwo\n\nfour")
    richtext.rt_layout(&r, &(*p).c, 280.0)
    check(richtext.rt_line_count(&r) == 4, f"hard breaks: {richtext.rt_line_count(&r)} lines for one\\ntwo\\n\\nfour")
    // a word wider than the line is cut, not overflowing
    richtext.rt_set_text(&r, "Donaudampfschifffahrtsgesellschaftskapitaen")
    richtext.rt_layout(&r, &(*p).c, 120.0)
    check(richtext.rt_line_count(&r) >= 2, f"a long word is cut: {richtext.rt_line_count(&r)} lines at 120 pt")
    clear(p)
    richtext.rt_paint(&r, &(*p).c, 5.0, 5.0, 120.0)
    var lo: f64 = 0.0
    var hi: f64 = 0.0
    let ink: bool = ink_x(p, 0.0, 200.0, &lo, &hi)
    check(ink && hi <= 126.0, f"the cut word stays inside its width (ink up to x = {hi})")
    // two styles in one word stay together: "bo" bold + "ld" plain never break between
    richtext.rt_set_text(&r, "xx Mi")
    richtext.rt_append(&r, "ddle", richtext.RT_BOLD, 0 as u32, 0 as u32)
    richtext.rt_layout(&r, &(*p).c, 100000.0)
    let wide: f64 = richtext.rt_height(&r)
    richtext.rt_free(&r)
}

fn run_rtl(font: u64) {
    let p: *mut Page = page_new(300, 100, false, font)
    var r: richtext.RichText = richtext.rt_new()
    richtext.rt_set_text(&r, "\u{5E9}\u{5DC}\u{5D5}\u{5DD} \u{5E2}\u{5D5}\u{5DC}\u{5DD}")
    clear(p)
    richtext.rt_paint(&r, &(*p).c, 10.0, 10.0, 280.0)
    var lo: f64 = 0.0
    var hi: f64 = 0.0
    let ink: bool = ink_x(p, 0.0, 100.0, &lo, &hi)
    check(ink && lo > 120.0 && hi > 250.0, f"a Hebrew paragraph starts on the right (ink {lo} .. {hi})")
    richtext.rt_set_text(&r, "Hello")
    clear(p)
    richtext.rt_paint(&r, &(*p).c, 10.0, 10.0, 280.0)
    let ink2: bool = ink_x(p, 0.0, 100.0, &lo, &hi)
    check(ink2 && lo < 20.0, f"a Latin paragraph starts on the left (ink {lo} .. {hi})")
    richtext.rt_set_dir(&r, richtext.RT_DIR_RTL)
    clear(p)
    richtext.rt_paint(&r, &(*p).c, 10.0, 10.0, 280.0)
    let ink3: bool = ink_x(p, 0.0, 100.0, &lo, &hi)
    check(ink3 && lo > 150.0, f"direction forced to RTL puts Latin text on the right (ink {lo} .. {hi})")
    richtext.rt_set_dir(&r, richtext.RT_DIR_AUTO)
    richtext.rt_set_align(&r, richtext.RT_ALIGN_CENTER)
    clear(p)
    richtext.rt_paint(&r, &(*p).c, 10.0, 10.0, 280.0)
    let ink4: bool = ink_x(p, 0.0, 100.0, &lo, &hi)
    check(ink4 && lo > 80.0 && hi < 220.0, f"centred text is in the middle (ink {lo} .. {hi})")
    richtext.rt_free(&r)
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("richtext: no font (DejaVu Sans)\n")
        return 9
    }
    run_theme(dir, fs as u64, false, "light")
    run_theme(dir, fs as u64, true, "dark")
    run_wrap(fs as u64)
    run_rtl(fs as u64)
    say("checks: ")
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&nb, CHECKS as u64)
    rt.write_everything(1, rt.buf_ptr(&nb), rt.buf_len(&nb))
    rt.buf_free(&nb)
    say("\n")
    if BAD == 0 {
        say("RICHTEXT PASSED\n")
        return 0
    }
    say("RICHTEXT FAILED\n")
    return 1
}
