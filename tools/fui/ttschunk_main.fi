// SPDX-License-Identifier: MPL-2.0
// tools/fui/ttschunk_main.fi -- read aloud pieces (lib/net/ttschunk.fi) and the generic WAV player clock (lib/plat/voiceio.fi), a66.
//     firnc -o /tmp/ttschunk tools/fui/ttschunk_main.fi && /tmp/ttschunk
import std.rt
import std.time
import net.ttschunk
import plat.voiceio
import plat.android.pcmwav

static mut BAD: usize = 0

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }
fn check(ok: bool, what: str) {
    if ok { say("  ok    ") } else { say("  WRONG "); BAD = BAD + 1 }
    say(what)
    say("\n")
}

fn end_of(t: str, start: usize, limit: usize, first: bool) -> usize {
    return ttschunk.chunk_end(t.p as u64, t.n, start, limit, first)
}

fn main() -> i32 {
    say("== ttschunk ==\n")
    let a: str = "Hallo. Wie geht es dir?"
    check(end_of(a, 0, 90, true) == a.n, "short text = one piece")

    // 3 sentences of 40 / 40 / 30 octets: limit 90 takes the first two, the third is the next piece
    let b: str = "Das ist der erste Satz mit viel Text da. Das ist der zweite Satz mit viel Text da. Und noch ein dritter."
    let e1: usize = end_of(b, 0, 90, false)
    check(e1 == 83, "first piece = two sentences (83)")
    check(end_of(b, e1, 90, false) == b.n, "second piece = the rest")

    // limit 50: one sentence per piece, the blank behind the stop belongs to the piece
    check(end_of(b, 0, 50, false) == 41, "limit 50: one sentence + blank (41)")

    // the first piece may end at a comma after 25 octets
    let c: str = "Guten Morgen Justin, heute ist ein schoener Tag, fuer ein Experiment mit der Stimme"
    check(end_of(c, 0, 90, true) == 49, "first piece ends at the second comma (49)")
    check(end_of(c, 0, 90, false) == c.n, "later pieces ignore the comma")

    // a stop inside a word (z.B.x, 3.14) is no stop
    let d: str = "Version 3.14 ist da. Fertig."
    check(end_of(d, 0, 10, false) == 21, "3.14 is not a sentence end (21)")

    // line breaks end a piece
    let f: str = "Zeile eins\nZeile zwei\nZeile drei"
    check(end_of(f, 0, 5, false) == 11, "a line break is a stop (11)")

    // UTF-8: pieces start and end at ASCII octets
    let g: str = "Äpfel sind süß. Öl ist gelb. Übung macht den Meister."
    let ge: usize = end_of(g, 0, 20, false)
    check(rt.ld8(g.p as u64, ge - 1) == 32 as u8 && ge > 0, "cut behind a blank, never inside a character")

    // no stop at all: cut at a blank at HARD_MAX
    var w: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < 400 {
        rt.buf_push_bytes(&w, "ab ".p as u64, 3)
        k = k + 1
    }
    let we: usize = ttschunk.chunk_end(w.ptr, w.len, 0, 280, false)
    check(we <= ttschunk.HARD_MAX && we > 600 && rt.ld8(w.ptr, we) != 98 as u8 || we == w.len, "no stop: cut at a blank near HARD_MAX")
    rt.buf_free(&w)

    say("== generic voiceio.vio_play (clock only) ==\n")
    var wav: rt.Buf = rt.buf_new()
    let frames: usize = 22050 / 5 // 0.2 s
    rt.buf_reserve(&wav, 44 + frames * 2)
    rt.buf_set_len(&wav, 44 + frames * 2)
    pcmwav.wav_header(wav.ptr, 22050 as u32, 1 as u32, frames * 2)
    check(voiceio.vio_play_start(wav.ptr, wav.len), "a 0.2 s WAV starts")
    check(voiceio.vio_play_state() == voiceio.VIO_PLAY_PLAYING, "state PLAYING right after the start")
    time.sleep_ms(300)
    check(voiceio.vio_play_state() == voiceio.VIO_PLAY_DONE, "state DONE after 0.3 s")
    check(voiceio.vio_play_start(wav.ptr, wav.len), "start again")
    voiceio.vio_play_stop()
    check(voiceio.vio_play_state() == voiceio.VIO_PLAY_IDLE, "stop -> IDLE")
    check(!voiceio.vio_play_start(a.p as u64, a.n), "text is no WAV")
    rt.buf_free(&wav)

    if BAD == 0 { say("ALL OK\n"); return 0 }
    say("FAILED\n")
    return 1
}
