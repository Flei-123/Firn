import ds_testpage
import fui.ds_iconbtn
import fui.editor
import fui.lucide
import fui.render
import fui.screenax
import fui.style
import fui.widget

fn frame(b: *mut ds_iconbtn.Btns, pg: *mut ds_testpage.Page, hx: f64, hy: f64) {
    let c: *mut render.Ctx = &(*pg).c
    ds_testpage.clear(pg)
    screenax.begin()
    ds_iconbtn.begin(b, c, hx, hy)
    ds_iconbtn.set_bounds(b, 400.0, 200.0)
    ds_iconbtn.add(b, c, 1, 20.0, 20.0, lucide.ARROW_LEFT, "Back", false, true)
    ds_iconbtn.add(b, c, 2, 60.0, 20.0, lucide.ARROW_RIGHT, "Forward", false, false)
    ds_iconbtn.add(b, c, 3, 100.0, 20.0, ds_iconbtn.more_glyph(), "More", true, true)
    ds_iconbtn.add(b, c, 4, 150.0, 20.0, lucide.X, "Close", false, true)
    ds_iconbtn.end(b, c)
}

fn main() -> i32 {
    let font: u64 = ds_testpage.font_load()
    if font == 0 {
        ds_testpage.say("no system font\n")
        return 2
    }
    screenax.install()
    let pg: *mut ds_testpage.Page = ds_testpage.page_new(400, 200, true, font)
    let c: *mut render.Ctx = &(*pg).c
    let b: *mut ds_iconbtn.Btns = ds_iconbtn.btns_new()
    let base: u32 = ds_testpage.tok(pg, style.TOK_BASE)

    ds_testpage.say("== geometry and hit testing\n")
    frame(b, pg, 0.0 - 1.0, 0.0 - 1.0)
    var q: [f64; 4] = [0.0; 4]
    ds_testpage.check(ds_iconbtn.rect_of(b, 1, &q) && q[2] == 32.0 && q[3] == 32.0, "small button is 32 px")
    ds_testpage.check(ds_iconbtn.rect_of(b, 3, &q) && q[2] == 40.0 && q[3] == 40.0, "big button is 40 px")
    ds_testpage.check(ds_iconbtn.hit(b, 30.0, 30.0) == 1, "hit inside back")
    ds_testpage.check(ds_iconbtn.hit(b, 55.0, 30.0) == ds_iconbtn.NONE, "gap between buttons hits nothing")
    ds_testpage.check(ds_iconbtn.hit(b, 119.0, 59.0) == 3, "big button covers 40 px")
    ds_testpage.check(ds_iconbtn.hit(b, 141.0, 30.0) == ds_iconbtn.NONE, "outside big button")

    ds_testpage.say("== click semantics\n")
    ds_iconbtn.press(b, 30.0, 30.0)
    ds_testpage.check(ds_iconbtn.release(b, 40.0, 40.0) == 1, "release on the same button fires it")
    ds_iconbtn.press(b, 30.0, 30.0)
    ds_testpage.check(ds_iconbtn.release(b, 300.0, 150.0) == ds_iconbtn.NONE, "release elsewhere cancels")
    ds_testpage.check(ds_iconbtn.click(b, 70.0, 30.0) == ds_iconbtn.NONE, "disabled button ignores a click")
    ds_testpage.check(ds_iconbtn.click(b, 160.0, 30.0) == 4, "click close")
    ds_testpage.check(ds_iconbtn.release(b, 160.0, 30.0) == ds_iconbtn.NONE, "release without press does nothing")

    ds_testpage.say("== keyboard\n")
    ds_iconbtn.set_focus(b, ds_iconbtn.NONE)
    ds_testpage.check(ds_iconbtn.key(b, editor.KEY_TAB, 0 as u32) && ds_iconbtn.focus_id(b) == 1, "Tab goes to the first enabled")
    ds_testpage.check(ds_iconbtn.key(b, editor.KEY_TAB, 0 as u32) && ds_iconbtn.focus_id(b) == 3, "Tab skips the disabled one")
    ds_testpage.check(ds_iconbtn.key(b, editor.KEY_TAB, editor.MOD_SHIFT) && ds_iconbtn.focus_id(b) == 1, "Shift+Tab goes back")
    ds_testpage.check(ds_iconbtn.key(b, editor.KEY_TAB, editor.MOD_SHIFT) && ds_iconbtn.focus_id(b) == 4, "Shift+Tab wraps")
    ds_testpage.check(ds_iconbtn.key(b, editor.KEY_ENTER, 0 as u32) && ds_iconbtn.fired(b) == 4, "Enter fires the focused button")
    ds_testpage.check(ds_iconbtn.fired(b) == ds_iconbtn.NONE, "fired is consumed")
    ds_testpage.check(ds_iconbtn.text(b, 32 as u32, 0 as u32) && ds_iconbtn.fired(b) == 4, "Space fires too")
    ds_testpage.check(ds_iconbtn.key(b, editor.KEY_LEFT, 0 as u32) && ds_iconbtn.focus_id(b) == 3, "Left moves focus")

    ds_testpage.say("== accessibility\n")
    frame(b, pg, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(screenax.count() == 5, "four buttons and the focus tooltip")
    ds_testpage.check(screenax.kind_of(0) == widget.KIND_BUTTON && screenax.name_of(0) == "Back", "back is a button named Back")
    ds_testpage.check((screenax.state_of(1) & screenax.F_DISABLED) != 0 as u32, "forward is disabled")
    ds_testpage.check((screenax.state_of(2) & screenax.F_FOCUS) != 0 as u32 && screenax.name_of(2) == "More", "keyboard focus lands on More")
    ds_testpage.check((screenax.state_of(0) & screenax.F_FOCUS) == 0 as u32, "no focus on back")

    ds_testpage.say("== tooltip\n")
    ds_iconbtn.set_focus(b, ds_iconbtn.NONE)
    frame(b, pg, 30.0, 30.0)
    ds_testpage.check(ds_iconbtn.tip_shown(b, c), "tooltip shows under the pointer")
    ds_testpage.check(screenax.count() == 5 && screenax.kind_of(4) == widget.KIND_TOOLTIP && screenax.name_of(4) == "Back", "tooltip is an a11y node")
    ds_testpage.check(ds_testpage.region_differs(pg, 20.0, 56.0, 80.0, 30.0, base) > 100, "tooltip pixels below the button")
    frame(b, pg, 70.0, 30.0)
    ds_testpage.check(!ds_iconbtn.tip_shown(b, c), "no tooltip on a disabled button")
    frame(b, pg, 300.0, 150.0)
    ds_iconbtn.set_focus(b, 1)
    frame(b, pg, 300.0, 150.0)
    ds_testpage.check(ds_iconbtn.tip_shown(b, c), "tooltip shows for keyboard focus")

    ds_testpage.say("== pixels\n")
    ds_iconbtn.set_focus(b, ds_iconbtn.NONE)
    frame(b, pg, 300.0, 150.0)
    ds_testpage.check(ds_testpage.region_differs(pg, 20.0, 20.0, 32.0, 32.0, base) > 20, "glyph drawn")
    let rest_px: u32 = ds_testpage.px(pg, 36.0, 22.0)
    frame(b, pg, 30.0, 30.0)
    ds_testpage.check(ds_testpage.px(pg, 36.0, 22.0) != rest_px, "hover tints the button")
    ds_iconbtn.press(b, 30.0, 30.0)
    frame(b, pg, 30.0, 30.0)
    let pressed_px: u32 = ds_testpage.px(pg, 36.0, 22.0)
    ds_testpage.check(pressed_px != rest_px, "pressed differs from rest")
    ds_iconbtn.release(b, 300.0, 150.0)
    frame(b, pg, 70.0, 30.0)
    ds_testpage.check(ds_testpage.px(pg, 76.0, 22.0) == base, "disabled button has no hover tint")
    ds_iconbtn.set_focus(b, 4)
    frame(b, pg, 300.0, 150.0)
    ds_testpage.check(ds_testpage.region_differs(pg, 146.0, 16.0, 40.0, 4.0, base) > 10, "focus ring above close")
    ds_testpage.check(ds_testpage.region_differs(pg, 100.0, 20.0, 40.0, 40.0, base) > 20, "more dots drawn")

    ds_testpage.say("== light theme\n")
    let lg: *mut ds_testpage.Page = ds_testpage.page_new(400, 200, false, font)
    ds_iconbtn.set_focus(b, ds_iconbtn.NONE)
    frame(b, lg, 300.0, 150.0)
    ds_testpage.check(ds_testpage.px(lg, 5.0, 5.0) != ds_testpage.px(pg, 5.0, 5.0), "light page differs from dark")
    ds_testpage.check(ds_testpage.region_differs(lg, 20.0, 20.0, 32.0, 32.0, ds_testpage.tok(lg, style.TOK_BASE)) > 20, "glyph drawn in light")
    return ds_testpage.finish("DS_ICONBTN")
}
