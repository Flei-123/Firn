import std.rt
import fui.editor
import fui.textbuf
import fui.mdedit
import fui.screenax
import fui.screenaxtree
import fui.scene
import fui.widget
import fui.uia
import fui.uiacom
import fui.uiatextcom
import gpu.wgl

static mut BAD: usize = 0
static mut TREE: u64 = 0
static mut ED: u64 = 0
static mut F_GETELEM: u64 = 0

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn editor() -> *mut mdedit.MdEd { return ED as *mut mdedit.MdEd }
fn tree() -> *mut screenaxtree.Tree { return TREE as *mut screenaxtree.Tree }

fn on_act(ud: u64, node: usize) -> bool { return true }
fn on_focus(ud: u64, node: usize) -> bool { return true }
fn on_click(ud: u64, x: f64, y: f64) -> bool { return true }
fn on_setnum(ud: u64, node: usize, v: i64) -> bool { return false }

#[allow_escape]
fn on_settext(ud: u64, node: usize, t: str) -> bool {
    let i: usize = screenaxtree.reg_of_node(tree(), node)
    if i == screenax.NONE { return false }
    return screenax.apply_text(i, t)
}

fn on_getcaret(ud: u64, node: usize, caret: *mut usize, anchor: *mut usize) -> bool {
    let i: usize = screenaxtree.reg_of_node(tree(), node)
    if i == screenax.NONE { return false }
    return screenax.caret_of(i, caret, anchor)
}

fn on_setcaret(ud: u64, node: usize, anchor: usize, caret: usize) -> bool {
    let i: usize = screenaxtree.reg_of_node(tree(), node)
    if i == screenax.NONE { return false }
    return screenax.apply_caret(i, anchor, caret)
}

fn frame() {
    screenax.begin()
    mdedit.ax_editor_note(editor(), 10.0, 100.0, 300.0, 200.0)
    screenax.note(widget.KIND_BUTTON, 0 as u32, "Quit", 10.0, 360.0, 80.0, 30.0, 0)
    if screenax.changed() { screenaxtree.publish(tree()) }
}

fn vc(p: u64, i: usize, a: u64, b: u64, c: u64) -> u64 {
    return wgl.call4(rt.ld64(rt.ld64(p, 0), i), p, a, b, c)
}

fn vc5(p: u64, i: usize, a: u64, b: u64, c: u64, d: u64) -> u64 {
    return wgl.call5(rt.ld64(rt.ld64(p, 0), i), p, a, b, c, d)
}

fn hr(x: u64) -> u64 { return x & 4294967295 }

fn qi(p: u64, w0: u64, w1: u64) -> u64 {
    var g: [u64; 2] = [w0, w1]
    var out: [u64; 1] = [0; 1]
    if hr(vc(p, 0, (&g[0]) as u64, (&out[0]) as u64, 0)) != 0 { return 0 }
    return out[0]
}

fn release(p: u64) -> u64 { return hr(vc(p, 2, 0, 0, 0)) }

fn bstr_is(b: u64, want: str) -> bool {
    if b == 0 { return want.n == 0 }
    var i: usize = 0
    while i < want.n {
        if (rt.ld16(b, i) as u64) != (want.chars(i) as u64) { return false }
        i = i + 1
    }
    return rt.ld16(b, i) == 0 as u16
}

fn range_text(r: u64) -> u64 {
    var out: [u64; 1] = [0; 1]
    let h: u64 = hr(vc(r, 12, 4294967295, (&out[0]) as u64, 0))
    if h != 0 { return 1 }
    return out[0]
}

fn text_is(r: u64, want: str) -> bool {
    let b: u64 = range_text(r)
    if b == 1 { return false }
    return bstr_is(b, want)
}

fn out_range(p: u64, i: usize, a: u64) -> u64 {
    var out: [u64; 1] = [0; 1]
    if hr(vc(p, i, (&out[0]) as u64, a, 0)) != 0 { return 0 }
    return out[0]
}

fn array_first(sa: u64) -> u64 {
    var idx: [i32; 1] = [0]
    var out: [u64; 1] = [0; 1]
    if wgl.call3(F_GETELEM, sa, (&idx[0]) as u64, (&out[0]) as u64) != 0 { return 0 }
    return out[0]
}

fn doc_text_node() -> uia.El {
    let pv: *mut uia.Provider = uiacom.provider()
    var i: usize = 0
    while i < scene.scene_count((*pv).sc) {
        let el: uia.El = uia.el_from_node(pv, i)
        if !uia.el_is_none(el) && uiacom.text_available(el) { return el }
        i = i + 1
    }
    return uia.el_none()
}

#[allow_escape]
fn main(start: u64) -> i32 {
    F_GETELEM = wgl.dll_sym("oleaut32.dll", "SafeArrayGetElement")
    screenax.install()
    ED = mdedit.new() as u64
    mdedit.set_text(editor(), "hello world\nsecond line\näö end")
    let tb: *mut textbuf.TextBuf = editor.editor_buf(&(*editor()).ed)
    textbuf.tb_set_range(tb, 8, 2)
    TREE = screenaxtree.tree_new("Text") as u64
    frame()
    say("== UIA TextPattern (through the vtables) ==\n")
    check(uiacom.source_bind(screenaxtree.tree_scene(tree()), screenaxtree.tree_ax(tree()), "Text", 0, on_act, on_focus, on_click, on_setnum, on_settext), "source bound")
    check(uiatextcom.install(), "text glue installed")
    uiacom.source_set_carets(on_getcaret, on_setcaret)
    let el: uia.El = doc_text_node()
    check(!uia.el_is_none(el), "the editor offers the text pattern")
    let simple: u64 = uiacom.give(el, uiacom.S_SIMPLE)
    check(simple != 0, "simple interface")
    var pv: [u64; 1] = [0; 1]
    let t0: u64 = hr(vc(simple, 4, 10014, (&pv[0]) as u64, 0))
    check(t0 == 0 && pv[0] != 0, "GetPatternProvider(Text) gives an interface")
    var pv2: [u64; 1] = [0; 1]
    let t1: u64 = hr(vc(simple, 4, 10024, (&pv2[0]) as u64, 0))
    check(t1 == 0 && pv2[0] != 0, "GetPatternProvider(Text2) gives an interface")
    var prop: [u64; 3] = [0; 3]
    let t2: u64 = hr(vc(simple, 5, 30040, (&prop[0]) as u64, 0))
    check(t2 == 0 && (prop[0] & 65535) == 11 && (prop[1] & 65535) != 0, "IsTextPatternAvailable is true")
    let tp: u64 = qi(simple, 0x436763f33589c92c, 0xf27cb753a6adbb99)
    check(tp != 0, "QI ITextProvider")
    let tp2: u64 = qi(simple, 0x4bf13e160dc5e6ed, 0x95c18b8779a99a8f)
    check(tp2 != 0, "QI ITextProvider2")
    var sup: [u32; 1] = [0 as u32]
    check(hr(vc(tp, 8, (&sup[0]) as u64, 0, 0)) == 0 && sup[0] == 1 as u32, "SupportedTextSelection = Single")

    let doc: u64 = out_range(tp, 7, 0)
    check(doc != 0, "DocumentRange")
    var tail: [u64; 1] = [0; 1]
    let lim: u64 = hr(vc(doc, 12, 5, (&tail[0]) as u64, 0))
    check(lim == 0 && bstr_is(tail[0], "hello"), "GetText(maxLength 5)")
    var head: [u64; 1] = [0; 1]
    let lim2: u64 = hr(vc(doc, 12, 12, (&head[0]) as u64, 0))
    check(lim2 == 0 && bstr_is(head[0], "hello world\n"), "GetText(maxLength 12)")

    var sa: [u64; 1] = [0; 1]
    check(hr(vc(tp, 3, (&sa[0]) as u64, 0, 0)) == 0 && sa[0] != 0, "GetSelection gives an array")
    let sel: u64 = array_first(sa[0])
    check(sel != 0 && text_is(sel, "llo wo"), "selection text is bytes 2..8 (anchor 2, caret 8)")

    let w: u64 = out_range(sel, 3, 0)
    check(w != 0 && text_is(w, "llo wo"), "Clone")
    var same: [u32; 1] = [0 as u32]
    check(hr(vc(w, 4, sel, (&same[0]) as u64, 0)) == 0 && same[0] != 0 as u32, "Compare equal")
    check(hr(vc(w, 6, 2, 0, 0)) == 0 && text_is(w, "hello "), "ExpandToEnclosingUnit(Word) -> 'hello '")
    var moved: [i32; 1] = [0]
    check(hr(vc(w, 13, 2, 1, (&moved[0]) as u64)) == 0 && moved[0] == 1 && text_is(w, "world"), "Move(Word, +1) -> 'world'")
    check(hr(vc5(w, 14, 1, 0, 1, (&moved[0]) as u64)) == 0 && moved[0] == 1 && text_is(w, "world\n"), "MoveEndpointByUnit(End, Char, +1) -> 'world\\n'")
    var cmp: [i32; 1] = [0]
    check(hr(vc5(w, 5, 0, sel, 0, (&cmp[0]) as u64)) == 0 && cmp[0] > 0, "CompareEndpoints(start vs selection start) > 0")
    check(hr(vc5(w, 5, 1, doc, 1, (&cmp[0]) as u64)) == 0 && cmp[0] < 0, "CompareEndpoints(end vs document end) < 0")
    check(hr(vc(w, 16, 0, 0, 0)) == 0, "Select")
    check(textbuf.tb_anchor(tb) == 6 && textbuf.tb_caret(tb) == 12, "Select moved anchor and caret of the editor")
    check(hr(vc(w, 15, 0, doc, 0)) == 0 && text_is(w, "hello world\n"), "MoveEndpointByRange(start -> document start)")

    var found: [u64; 1] = [0; 1]
    var wide: [u16; 8] = [83 as u16, 69 as u16, 67 as u16, 79 as u16, 78 as u16, 68 as u16, 0 as u16, 0 as u16]
    let nb: u64 = wgl.call2(wgl.dll_sym("oleaut32.dll", "SysAllocString"), (&wide[0]) as u64, 0)
    check(hr(vc5(doc, 8, nb, 0, 1, (&found[0]) as u64)) == 0 && found[0] != 0 && text_is(found[0], "second"), "FindText ignoring case")
    var miss: [u64; 1] = [1; 1]
    check(hr(vc5(doc, 8, nb, 0, 0, (&miss[0]) as u64)) == 0 && miss[0] == 0, "FindText case sensitive: no range")

    var active: [u32; 1] = [7 as u32]
    var cr: [u64; 1] = [0; 1]
    check(hr(vc(tp2, 10, (&active[0]) as u64, (&cr[0]) as u64, 0)) == 0 && cr[0] != 0, "GetCaretRange")
    check(text_is(cr[0], "") && hr(vc(cr[0], 4, doc, (&same[0]) as u64, 0)) == 0 && same[0] == 0 as u32, "caret range is collapsed")

    var enc: [u64; 1] = [0; 1]
    check(hr(vc(doc, 11, (&enc[0]) as u64, 0, 0)) == 0 && enc[0] == simple, "GetEnclosingElement is the text element")
    var rects: [u64; 1] = [0; 1]
    check(hr(vc(doc, 10, (&rects[0]) as u64, 0, 0)) == 0 && rects[0] != 0, "GetBoundingRectangles")
    var kids: [u64; 1] = [0; 1]
    check(hr(vc(doc, 20, (&kids[0]) as u64, 0, 0)) == 0 && kids[0] != 0, "GetChildren")
    check(hr(vc(doc, 17, 0, 0, 0)) != 0, "AddToSelection is not supported")

    let ch: u64 = out_range(doc, 3, 0)
    var u: [i32; 1] = [0]
    check(hr(vc(ch, 6, 0, 0, 0)) == 0, "expand clone to a character")
    check(hr(vc(ch, 13, 0, 24, (&u[0]) as u64)) == 0 && u[0] == 24 && range_text(ch) != 1, "Move(Char, +24)")
    var u2: [u64; 1] = [0; 1]
    check(hr(vc(ch, 12, 4294967295, (&u2[0]) as u64, 0)) == 0 && rt.ld16(u2[0], 0) == 228 as u16 && rt.ld16(u2[0], 1) == 0 as u16, "a two byte character is one UTF-16 unit (U+00E4)")

    textbuf.tb_set_range(tb, 3, 3)
    frame()
    var sa2: [u64; 1] = [0; 1]
    check(hr(vc(tp, 3, (&sa2[0]) as u64, 0, 0)) == 0, "GetSelection after the caret moved")
    check(text_is(array_first(sa2[0]), ""), "selection is collapsed at the caret")

    var rr: u64 = release(doc)
    rr = release(sel)
    rr = release(w)
    rr = release(ch)
    rr = release(found[0])
    rr = release(cr[0])
    let before: usize = uiatextcom.range_count()
    let extra: u64 = out_range(tp, 7, 0)
    check(uiatextcom.range_count() == before + 1, "Clone takes a pool entry")
    rr = release(extra)
    check(uiatextcom.range_count() == before, "Release frees the pool entry")

    say("UIATEXTCOM bad=")
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, BAD as i64)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    say("\n")
    if BAD == 0 {
        say("UIATEXTCOM PASSED\n")
        return 0
    }
    return 1
}
