// tools/fui/kitset_main.fi -- CHECK OF lib/fui/kitset.fi (hit handling, keys, state) + kitcolor.look (no window).
//
//     firnc -o /tmp/kitset tools/fui/kitset_main.fi && /tmp/kitset
import std.io
import fui.editor
import fui.kit
import fui.kitcolor
import fui.kitset
import fui.painter
import fui.render
import fui.theme

static mut BAD: usize = 0

fn expect(ok: bool, what: str) {
    if !ok {
        BAD = BAD + 1
        io.print_line(what)
    }
}

fn list(s: *mut kitset.Set, id: usize, l: str) {
    (*s).o[id] = l.p as u64
    (*s).on[id] = l.n
}

#[allow_escape]
fn main() -> i32 {
    var m: theme.Theme = theme.theme_new(true)
    var cx: render.Ctx = render.ctx_new(&m, 0 as u64 as *mut painter.Painter)
    let c: *mut render.Ctx = &cx
    let s: *mut kitset.Set = kitset.set_new()
    (*s).ctx = c as u64

    // toggle: a click flips, a second click flips back, a click beside does nothing
    kitset.reg_add(s, 1, kitset.TOGGLE, 100.0, 100.0, 42.0, 24.0)
    expect(kitset.press(s, 110.0, 110.0) == 1 && kitset.val(s, 1) == 1, "toggle on")
    expect(kitset.press(s, 110.0, 110.0) == 1 && kitset.val(s, 1) == 0, "toggle off")
    expect(kitset.press(s, 50.0, 50.0) == kitset.NONE && kitset.val(s, 1) == 0, "miss")

    // drop-down: click opens, click on item 2 picks it and closes, click away closes without a change
    kitset.reg_add(s, 0, kitset.SELECT, 400.0, 100.0, 240.0, 36.0)
    list(s, 0, "English|Deutsch|Francais|Espanol")
    expect(kitset.press(s, 450.0, 110.0) == 0 && (*s).open == 0, "select opens")
    var q: [f64; 4] = [0.0; 4]
    kitset.item_rect(s, c, 0, 2, &q)
    expect(q[1] > 136.0, "list under the box")
    expect(kitset.press(s, q[0] + 5.0, q[1] + 5.0) == 0 && kitset.val(s, 0) == 2 && (*s).open == kitset.NONE, "item 2 picked")
    kitset.press(s, 450.0, 110.0)
    expect(kitset.press(s, 10.0, 600.0) == kitset.NONE && (*s).open == kitset.NONE && kitset.val(s, 0) == 2, "click away closes")
    kitset.press(s, 450.0, 110.0)
    kitset.key(s, editor.KEY_ESC, 0 as u32)
    expect((*s).open == kitset.NONE, "Esc closes")

    // radio: boundaries 80 / 170 / 260 -> x in the third segment picks 2
    kitset.reg_add(s, 4, kitset.RADIO, 100.0, 200.0, 250.0, 24.0)
    list(s, 4, "a|b|c")
    (*s).b[16] = 80.0
    (*s).b[17] = 170.0
    (*s).b[18] = 260.0
    kitset.press(s, 100.0 + 200.0, 210.0)
    expect(kitset.val(s, 4) == 2, "radio third")
    kitset.press(s, 100.0 + 90.0, 210.0)
    expect(kitset.val(s, 4) == 1, "radio second")

    // slider 10..22 over 220 wide: the ends and the middle
    kitset.reg_add(s, 6, kitset.SLIDER, 100.0, 300.0, 220.0, 24.0)
    (*s).lo[6] = 10
    (*s).hi[6] = 22
    kitset.press(s, 100.0, 310.0)
    expect(kitset.val(s, 6) == 10, "slider left end")
    kitset.press(s, 319.0, 310.0)
    expect(kitset.val(s, 6) == 22, "slider right end")
    kitset.press(s, 210.0, 310.0)
    expect(kitset.val(s, 6) == 16, "slider middle")

    // colours: 5 swatches 34 apart
    kitset.reg_add(s, 5, kitset.COLORS, 100.0, 400.0, 160.0, 24.0)
    list(s, 5, "#3ddc84|#5b8cff|#ff8a4c|#c06bff|#ff5d7a")
    kitset.press(s, 101.0, 410.0)
    expect(kitset.val(s, 5) == 0, "swatch 0")
    kitset.press(s, 100.0 + 34.0 * 3.0 + 5.0, 410.0)
    expect(kitset.val(s, 5) == 3, "swatch 3")
    kitset.press(s, 259.0, 410.0)
    expect(kitset.val(s, 5) == 4, "swatch 4")

    // keys: Tab walks the registered controls, arrows change, Enter/Space flip, a field takes text
    (*s).n = 0
    kitset.reg_add(s, 1, kitset.TOGGLE, 100.0, 100.0, 42.0, 24.0)
    kitset.reg_add(s, 4, kitset.RADIO, 100.0, 200.0, 250.0, 24.0)
    kitset.reg_add(s, 6, kitset.SLIDER, 100.0, 300.0, 220.0, 24.0)
    kitset.reg_add(s, 9, kitset.FIELD, 100.0, 500.0, 240.0, 38.0)
    kitset.set_text(s, 9, "ab")
    (*s).foc = kitset.NONE
    kitset.key(s, editor.KEY_TAB, 0 as u32)
    expect((*s).foc == 1, "Tab to the first")
    kitset.key(s, editor.KEY_ENTER, 0 as u32)
    expect(kitset.val(s, 1) == 1, "Enter flips the toggle")
    expect(kitset.text(s, 32 as u32, 0 as u32) && kitset.val(s, 1) == 0, "Space flips the toggle")
    kitset.key(s, editor.KEY_TAB, 0 as u32)
    kitset.key(s, editor.KEY_LEFT, 0 as u32)
    expect(kitset.val(s, 4) == 0, "Left on radio")
    kitset.key(s, editor.KEY_LEFT, 0 as u32)
    expect(kitset.val(s, 4) == 0, "radio stops at 0")
    kitset.key(s, editor.KEY_TAB, 0 as u32)
    kitset.key(s, editor.KEY_RIGHT, 0 as u32)
    expect(kitset.val(s, 6) == 17, "Right on slider = one step")
    kitset.key(s, editor.KEY_TAB, 0 as u32)
    expect((*s).foc == 9, "Tab to the field")
    expect(kitset.text(s, 99 as u32, 0 as u32), "char goes to the field")
    expect(kitset.text_of(s, 9).n == 3, "field holds abc")
    kitset.key(s, editor.KEY_TAB, 0 as u32)
    expect((*s).foc == 1, "Tab wraps")
    kitset.reset(s)
    expect((*s).foc == kitset.NONE && (*s).open == kitset.NONE, "reset")

    // helpers
    expect(kitset.hex("#3ddc84") == 0x3ddc84 as u32 && kitset.hex("5b8cff") == 0x5b8cff as u32, "hex")
    expect(kitset.index_of("auto|manual|offline", "offline") == 2 && kitset.index_of("a|b", "zz") == 0, "index_of")
    var buf: [u8; 40] = [0 as u8; 40]
    expect(kitset.val_text(14, "px", &buf) == 5 && buf[0] == 49 as u8 && buf[3] == 112 as u8, "val_text 14 px")

    // live accent: look() sets it, kit_apply keeps it, the default comes back
    kitcolor.look(&m, true, 0x5b8cff as u32)
    expect(((*theme.theme_colors(&m)).accent & 16777215 as u32) == 0x5b8cff as u32, "look sets the accent")
    kitcolor.kit_apply(&m)
    expect(((*theme.theme_colors(&m)).accent & 16777215 as u32) == 0x5b8cff as u32, "kit_apply keeps it")
    kitcolor.look(&m, false, kitcolor.LAUNCHER_ACCENT)
    expect(((*theme.theme_colors(&m)).accent & 16777215 as u32) == kitcolor.LAUNCHER_ACCENT, "default accent back")

    if BAD == 0 { io.print_line("kitset: all checks passed") }
    return BAD as i32
}
