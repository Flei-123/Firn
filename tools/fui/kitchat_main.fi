// SPDX-License-Identifier: MPL-2.0
// tools/fui/kitchat_main.fi -- CHECK OF lib/fui/kitchat.fi: colour/date helpers, search filter, send, autoscroll state,
// clicks on the contact list and the Send button (no window, no fonts).
//
//     firnc -o /tmp/kitchat tools/fui/kitchat_main.fi && /tmp/kitchat
import std.io
import std.rt
import fui.editor
import fui.kit
import fui.kitform
import fui.kitchat
import fui.painter
import fui.render
import fui.theme

static mut BAD: usize = 0
static mut CHECKS: usize = 0

fn expect(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if !ok {
        BAD = BAD + 1
        io.print_line(what)
    }
}

fn label_is(ts: str, want: str) -> bool {
    var b: [u8; 48] = [0 as u8; 48]
    let n: usize = kitchat.day_label(ts, &b)
    if n != want.n { return false }
    var i: usize = 0
    while i < n {
        if b[i] != rt.ld8(want.p as u64, i) { return false }
        i = i + 1
    }
    return true
}

#[allow_escape]
fn main() -> i32 {
    expect(kitchat.hex_color("#e57373") == 0xE57373 as u32 && kitchat.hex_color("#FFffFF") == 0xFFFFFF as u32, "hex colour")
    expect(kitchat.hex_color("e57373") == 0 as u32 && kitchat.hex_color("#12") == 0 as u32, "bad hex is 0")
    expect(label_is("2026-10-22T03:30:00", "Thursday 22 October"), "label Thursday 22 October")
    expect(label_is("2026-10-19T11:21:00", "Monday 19 October"), "label Monday 19 October")
    expect(label_is("2000-01-01T00:00:00", "Saturday 1 January"), "label Saturday 1 January (leap year, Jan)")
    expect(label_is("2024-03-01T00:00:00", "Friday 1 March"), "label Friday 1 March (after Feb 29)")
    expect(label_is("2026-12-31T23:59:00", "Thursday 31 December"), "label Thursday 31 December")
    expect(kitchat.day_label("junk", 0 as u64 as *mut [u8; 48]) == 0, "no label for junk")
    expect(kitchat.same_day("2026-10-22T03:30:00", "2026-10-22T23:59:00") && !kitchat.same_day("2026-10-22T03:30:00", "2026-10-21T03:30:00"), "same_day")
    expect(kitchat.matches("Anna Berger", "ber") && kitchat.matches("Anna Berger", "ANNA") && !kitchat.matches("Anna Berger", "xyz") && kitchat.matches("x", ""), "matches")

    let z: *mut kitchat.Chat = kitchat.chat_new()
    kitchat.add_contact(z, "Anna Berger", "AB", 0xE57373 as u32, 2 as u32)
    kitchat.add_contact(z, "Max Huber", "MH", 0x64B5F6 as u32, 0 as u32)
    kitchat.add_contact(z, "Lena Gruber", "LG", 0x81C784 as u32, 5 as u32)
    kitchat.add_msg(z, 0, false, "Hello", "2026-10-19T11:21:00")
    kitchat.add_msg(z, 1, true, "Hi Max", "2026-10-19T11:59:00")
    kitchat.add_msg(z, 0, true, "Later", "2026-10-19T23:59:00")
    expect((*z).nc == 3 && (*z).nm == 3 && (*z).sel == 0 && (*z).stick, "model state")
    expect(kitchat.last_msg(z, 0) == 3 && kitchat.last_msg(z, 1) == 2 && kitchat.last_msg(z, 2) == 0, "last_msg")

    var vis: [u32; 16] = [0 as u32; 16]
    expect(kitchat.visible(z, &vis) == 3, "all contacts visible")
    kit.search_set_text(kitchat.qf(z), "gru")
    expect(kitchat.visible(z, &vis) == 1 && vis[0] == 2 as u32, "search 'gru' leaves Lena")
    kit.search_set_text(kitchat.qf(z), "")
    expect(kitchat.visible(z, &vis) == 3, "cleared search shows all")

    // send: blank ignored, text appended to the selected contact, field cleared, ts one minute later
    expect(!kitchat.chat_send(z) && (*z).nm == 3, "empty input is not sent")
    kit.search_set_text(kitchat.inf(z), "   ")
    expect(!kitchat.chat_send(z), "blank input is not sent")
    kit.search_set_text(kitchat.inf(z), "Ping")
    (*z).stick = false
    expect(kitchat.chat_send(z) && (*z).nm == 4 && (*z).stick, "send appends and sticks to the bottom")
    expect((*z).ms[3].mine && (*z).ms[3].who == 0 && (*z).ms[3].text.n == 4 && kit.search_text_len(kitchat.inf(z)) == 0, "sent message is mine, to contact 0, field empty")
    let t: str = (*z).ms[3].ts
    expect(t.n == 19 && rt.ld8(t.p as u64, 11) == 48 as u8 && rt.ld8(t.p as u64, 12) == 48 as u8 && rt.ld8(t.p as u64, 14) == 48 as u8 && rt.ld8(t.p as u64, 15) == 48 as u8, "23:59 wraps to 00:00")
    kit.search_set_text(kitchat.inf(z), "Pong")
    kitchat.chat_send(z)
    expect((*z).ms[4].ts.n == 19 && rt.ld8((*z).ms[4].ts.p as u64, 15) == 49 as u8, "next ts is one minute later (00:01)")

    // keys: Enter sends, Tab switches the focus, typed text goes to the focused field
    kitchat.chat_text(z as u64, 72 as u32, 0 as u32)
    expect((*z).focus == kitchat.FOCUS_INPUT && kit.search_text_len(kitchat.inf(z)) == 1, "typing focuses the input")
    expect(kitchat.chat_key(z as u64, editor.KEY_TAB, 0 as u32) && (*z).focus == kitchat.FOCUS_SEARCH, "Tab moves to search")
    kitchat.chat_text(z as u64, 77 as u32, 0 as u32)
    expect(kit.search_text_len(kitchat.qf(z)) == 1 && kit.search_text_len(kitchat.inf(z)) == 1, "text goes to the focused field")
    kitchat.chat_key(z as u64, editor.KEY_ENTER, 0 as u32)
    expect((*z).nm == 5, "Enter in search does not send")
    kitchat.chat_key(z as u64, editor.KEY_TAB, 0 as u32)
    kitchat.chat_key(z as u64, editor.KEY_ENTER, 0 as u32)
    expect((*z).nm == 6 && kit.search_text_len(kitchat.inf(z)) == 0, "Enter in the input sends")

    // scrolling: up leaves the bottom (no autoscroll), back down to the end sticks again
    (*z).top = 500.0
    (*z).scroll = 500.0
    kitchat.scroll_by(z, 0.0 - 100.0)
    expect(!(*z).stick && (*z).scroll == 400.0, "scroll up unsticks")
    kitchat.scroll_by(z, 0.0 - 1000.0)
    expect((*z).scroll == 0.0, "scroll clamps at the top")
    kitchat.scroll_by(z, 2000.0)
    expect((*z).stick && (*z).scroll == 500.0, "scroll to the end sticks")
    kitchat.select(z, 1)
    expect((*z).sel == 1 && (*z).stick, "select sticks to the bottom of the new log")
    kitchat.select(z, 9)
    expect((*z).sel == 1, "select out of range is ignored")

    // clicks (a theme context is enough for the geometry: no painter, no fonts)
    kit.search_set_text(kitchat.qf(z), "")
    var m: theme.Theme = theme.theme_new(true)
    var cx: render.Ctx = render.ctx_new(&m, 0 as u64 as *mut painter.Painter)
    let c: *mut render.Ctx = &cx
    (*z).ctx = c as u64
    (*z).w = 1100.0
    (*z).h = 700.0
    let ry: f64 = kit.ln(c, 70) + kit.ln(c, 62) * 2.0 + 10.0
    kitchat.chat_press(z as u64, 100.0, ry)
    expect((*z).sel == 2, "click on row 3 selects Lena")
    kitchat.chat_press(z as u64, 100.0, kit.ln(c, 70) + 10.0)
    expect((*z).sel == 0, "click on row 1 selects Anna")
    kit.search_set_text(kitchat.qf(z), "max")
    kitchat.chat_press(z as u64, 100.0, kit.ln(c, 70) + 10.0)
    expect((*z).sel == 1, "with the filter 'max' row 1 is Max")
    kitchat.chat_press(z as u64, 100.0, kit.ln(c, 70) + kit.ln(c, 62) + 10.0)
    expect((*z).sel == 1, "click below the last row selects nothing")
    kit.search_set_text(kitchat.qf(z), "")
    kit.search_set_text(kitchat.inf(z), "via button")
    let sy: f64 = 700.0 - kit.ln(c, 67) + kit.ln(c, 14) + 10.0
    let n0: usize = (*z).nm
    kitchat.chat_press(z as u64, 1100.0 - kit.ln(c, 22) - 10.0, sy)
    expect((*z).nm == n0 + 1 && (*z).ms[n0].who == 1, "click on Send sends to the selected contact")
    expect(kitchat.chat_wheel(z as u64, 600.0, 300.0, 0.0, 1.0) && !kitchat.chat_wheel(z as u64, 100.0, 300.0, 0.0, 1.0), "wheel scrolls the log, not the side bar")

    (*z).w = 360.0
    (*z).h = 800.0
    kitchat.show_detail(z, false)
    expect(kitchat.list_only(z, c) && kitchat.side_w(z, c) == 360.0, "phone: the contact list fills the width")
    kitchat.chat_press(z as u64, 100.0, kit.ln(c, 70) + kit.ln(c, 62) + 10.0)
    expect((*z).sel == 1 && (*z).detail && !kitchat.list_only(z, c) && kitchat.side_w(z, c) == 0.0, "phone: a tap on a contact opens its conversation")
    expect(kitchat.chat_wheel(z as u64, 100.0, 300.0, 0.0, 1.0), "phone: the wheel scrolls the conversation")
    kitchat.chat_press(z as u64, kit.ln(c, 20), kit.ln(c, 30))
    expect(!(*z).detail, "phone: the back control returns to the contacts")
    kitchat.show_detail(z, true)
    expect(kitchat.chat_key(z as u64, editor.KEY_ESC, 0 as u32) && !(*z).detail, "phone: Escape returns to the contacts")
    kitchat.show_detail(z, false)
    let n1: usize = (*z).nm
    kit.search_set_text(kitchat.inf(z), "hidden")
    kitchat.chat_key(z as u64, editor.KEY_ENTER, 0 as u32)
    expect((*z).nm == n1, "phone: Enter on the contact list sends nothing")
    (*z).w = 1100.0
    (*z).h = 700.0
    expect(!kitchat.narrow(z, c) && kitchat.side_w(z, c) == kit.ln(c, 300), "desktop width keeps the 300 side column")

    if BAD == 0 {
        io.print_line("KITCHAT PASSED")
        return 0
    }
    io.print_line("KITCHAT FAILED")
    return 1
}
