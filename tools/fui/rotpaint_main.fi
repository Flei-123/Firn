// SPDX-License-Identifier: MPL-2.0
// tools/fui/rotpaint_main.fi -- r455: the paint-only frame after app.touch_rotated gives the SAME picture as a full repaint.
//
//     firnc -o /tmp/rotpaint tools/fui/rotpaint_main.fi && /tmp/rotpaint
//
// Two identical apps: A turns a box with touch_rotated (style + draw under the clip), B turns it with a full host_touch.
// Their canvases must match byte for byte. Anything else dirty (text, hover) must leave the fast path.
import std.rt
import font.metrics
import paint.canvas
import fui.painter
import fui.scene
import fui.sheet
import fui.style
import fui.theme
import fui.app
import plat.fuiwirt
import plat.sysfont

static mut BAD: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Rig {
    a: *mut app.App,
    cv: canvas.Canvas,
    z: painter.Painter,
    rule: usize,
    node: usize,
    label: usize,
    btn: usize,
}

fn noop(a: *mut app.App) {}

fn rig_new() -> *mut Rig {
    let r: *mut Rig = rt.heap_alloc(65536) as *mut Rig
    let a: *mut app.App = app.window("rot", 400, 300)
    (*r).a = a
    var st: style.Style = style.style_new()
    st = style.style_set_bg(st, style.color_token(style.TOK_ACCENT))
    st = style.style_set_radius(st, 24)
    st = style.style_set_size(st, 120, 120)
    let rb: usize = sheet.sheet_rule(&(*a).sh, sheet.sel_class(5), st)
    var d: sheet.Decl = sheet.decl_new()
    sheet.decl_set_rotate(&d, 0.0)
    (*r).rule = sheet.sheet_add(&(*a).sh, sheet.sel_class(6), d)
    (*r).label = app.label(a, "turning", 16)
    (*r).node = app.spacer(a, 120, 120)
    let c1: bool = scene.node_add_class(app.app_scene(a), (*r).node, 5)
    let c2: bool = scene.node_add_class(app.app_scene(a), (*r).node, 6)
    (*r).btn = app.button(a, "Hover me", noop)
    fuiwirt.host_bind(app.app_host(a))
    (*r).cv = canvas.canvas_new()
    (*r).z = painter.painter_new()
    let ok: bool = canvas.canvas_init(&(*r).cv, 400, 300) && painter.painter_init(&(*r).z, &(*r).cv, 400, 300)
    painter.painter_set_font(&(*r).z, FONT)
    app.app_attach(a as u64, &(*r).z)
    return r
}

fn paint(r: *mut Rig) {
    app.app_paint((*r).a as u64, 400, 300)
    fuiwirt.host_painted(app.app_host((*r).a))
}

fn turn(r: *mut Rig, deg: f64) {
    sheet.decl_set_rotate(sheet.sheet_decl(&(*(*r).a).sh, (*r).rule), deg)
}

fn same_picture(x: *mut Rig, y: *mut Rig) -> bool {
    let p: *mut u8 = canvas.canvas_pixels(&(*x).cv)
    let q: *mut u8 = canvas.canvas_pixels(&(*y).cv)
    var i: usize = 0
    while i < 400 * 300 * 4 {
        if rt.ld8(p as u64, i) != rt.ld8(q as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("rotpaint: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut Rig = rig_new()
    let b: *mut Rig = rig_new()
    paint(a)
    paint(b)
    check(same_picture(a, b), "both start with the same picture")
    let n0: i64 = app.rot_only_frames()
    var deg: f64 = 0.0
    var k: usize = 0
    var all: bool = true
    while k < 12 {
        deg = deg + 17.0
        turn(a, deg)
        app.touch_rotated((*a).a, (*a).node)
        paint(a)
        turn(b, deg)
        fuiwirt.host_touch(app.app_host((*b).a))
        paint(b)
        if !same_picture(a, b) {
            all = false
        }
        k = k + 1
    }
    check(all, "12 steps: paint-only frame == full repaint, byte for byte")
    check(app.rot_only_frames() - n0 == 12, "all 12 frames took the paint-only path")
    // something else dirty in the same step: text -> the fast path must not be used
    let n1: i64 = app.rot_only_frames()
    deg = deg + 17.0
    turn(a, deg)
    app.touch_rotated((*a).a, (*a).node)
    app.set_text((*a).a, (*a).label, "turning a lot more than before")
    paint(a)
    turn(b, deg)
    app.set_text((*b).a, (*b).label, "turning a lot more than before")
    paint(b)
    check(app.rot_only_frames() == n1, "set_text in the same step: full path")
    check(same_picture(a, b), "... and the same picture")
    // a hover (the pointer moves onto the button) in the same step
    let n2: i64 = app.rot_only_frames()
    let sc: *mut scene.Scene = app.app_scene((*a).a)
    let hx: f64 = scene.node_x(sc, (*a).btn) + scene.node_w(sc, (*a).btn) / 2.0
    let hy: f64 = scene.node_y(sc, (*a).btn) + scene.node_h(sc, (*a).btn) / 2.0
    deg = deg + 17.0
    turn(a, deg)
    app.touch_rotated((*a).a, (*a).node)
    let c1: u32 = fuiwirt.host_pointer_move(app.app_host((*a).a), hx, hy)
    paint(a)
    turn(b, deg)
    fuiwirt.host_touch(app.app_host((*b).a))
    let c2: u32 = fuiwirt.host_pointer_move(app.app_host((*b).a), hx, hy)
    paint(b)
    check(app.rot_only_frames() == n2, "hover in the same step: full path")
    check(same_picture(a, b), "... and the same picture")
    if BAD == 0 {
        say("ROTPAINT PASSED\n")
        return 0
    }
    say("ROTPAINT FAILED\n")
    return 1
}
