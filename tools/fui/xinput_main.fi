// SPDX-License-Identifier: MPL-2.0
// tools/fui/xinput_main.fi -- THE XInput2 HANDSHAKE AGAINST A REAL X SERVER
// (roadmap r112). It needs an X server (DISPLAY, an Xvfb is enough); the
// machine has no touch device (no uinput), so no finger can be played in --
// what is checked is everything up to the first finger:
//
//   * the server speaks XInputExtension and XI 2.2 or newer (touch),
//   * `window.real_pointers` is true, the mouse stays on the old events
//     (`window.pointer_mouse` is false),
//   * the server ANSWERS XIGetSelectedEvents with XI_TouchBegin / Update /
//     End selected on our window -- a BadValue on XISelectEvents would
//     have left no other trace,
//   * switching off is ok, and the mouse (xdotool) still gives EV_MOTION
//     and EV_BUTTON as before, and no pointer record.
//
//     DISPLAY=:77 xinput_main
import std.rt
import window.window
import window.backend
import window.pointers

static mut G_ERRORS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(name: str, ok: bool) {
    if ok {
        say("  OK      ")
    } else {
        say("  WRONG   ")
        G_ERRORS = G_ERRORS + 1
    }
    say(name)
    say("\n")
}

fn main(start: u64) -> i32 {
    var f: window.Window = window.window_new()
    if !window.open_window(&f, 0) {
        say("no X server (set DISPLAY)\n")
        return 2
    }
    check("window made", window.make(&f, 320, 200))
    check("window shown", window.show_window(&f))
    check("server speaks XInput 2.2 (xi_op set)", f.p.xi_op != 0 as u32)
    check("real_pointers(true) is true", window.real_pointers(&f, true))
    check("the mouse stays on the old events", !window.pointer_mouse(&f))
    check("the server reports the touch selection",
        backend.xi_selected_touch(&f.p))
    var p: pointers.Pointer = pointers.ptr_blank()
    check("no pointer record without a finger", !window.next_pointer(&f, (&p) as u64))
    check("real_pointers(false) is true", window.real_pointers(&f, false))
    check("... and switches the feed off", !pointers.pointers_enabled(&f.p.pq))
    check("real_pointers(true) again", window.real_pointers(&f, true))
    window.close_window(&f)
    if G_ERRORS == 0 {
        say("XINPUT PASSED\n")
        return 0
    }
    say("XINPUT FAILED\n")
    return 1
}
