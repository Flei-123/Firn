import ds_testpage
import fui.ds_appcard
import fui.ds_icons_full
import fui.ds_tpl_store
import fui.event
import fui.render
import fui.screenax
import plat.fuiwirt

static mut LAST_ACTION: u32 = 0

fn count(ud: u64, cat: usize, q: str) -> usize {
    if q.n > 0 { return 2 }
    return 24
}

fn item(ud: u64, cat: usize, q: str, i: usize, out: *mut ds_tpl_store.Item) {
    (*out).name = "App"
    (*out).sub = "Sub"
    (*out).desc = "A fast and simple app for everyday use. It starts instantly, works offline and keeps your data on your device. Sync is optional and encrypted end to end. The interface follows your system theme and scales from phones to large desktop screens."
}

fn act(ud: u64, cat: usize, q: str, i: usize, a: u32) { LAST_ACTION = a }

fn swipe(s: u64, x0: f64, y0: f64, dx: f64, dy: f64, steps: usize, t0: i64, hold_ms: i64) -> i64 {
    var t: i64 = t0
    ds_tpl_store.touch_down(s, x0, y0, t * 1000 as i64)
    var k: usize = 1
    while k <= steps {
        t = t + 16 as i64
        ds_tpl_store.touch_move(s, x0 + dx * (k as f64) / (steps as f64), y0 + dy * (k as f64) / (steps as f64), t * 1000 as i64)
        k = k + 1
    }
    t = t + hold_ms
    ds_tpl_store.touch_up(s, x0 + dx, y0 + dy, t * 1000 as i64)
    return t
}

fn run_out(s: u64, c: *mut render.Ctx, t0: i64) -> i64 {
    var t: i64 = t0
    var n: usize = 0
    while ds_tpl_store.moving(s) && n < 600 {
        t = t + 16 as i64
        render.ctx_set_time(c, t)
        ds_tpl_store.tick(s, t)
        n = n + 1
    }
    return t
}

fn repaint(pg: *mut ds_testpage.Page, c: *mut render.Ctx, s: u64, w: f64, h: f64, t: i64) {
    render.ctx_set_time(c, t)
    ds_testpage.clear(pg)
    ds_tpl_store.paint(s, c, w, h, 0.0 - 1.0, 0.0 - 1.0)
}

fn main() -> i32 {
    let font: u64 = ds_testpage.font_load()
    if font == 0 {
        ds_testpage.say("no system font\n")
        return 2
    }
    screenax.install()
    ds_icons_full.install()
    let spec: ds_tpl_store.Spec = ds_tpl_store.Spec { ud: 0, title: "Store", cats: "Home|Apps", icons: [0, 0, 0, 0, 0, 0, 0, 0], foot: "", foot_icon: 0 - 1,
        hint: "Search", shots: 6, count: count, item: item, act: act }
    let st: *mut ds_tpl_store.Store = ds_tpl_store.store_new(spec)
    let s: u64 = st as u64
    let pg: *mut ds_testpage.Page = ds_testpage.page_new(1100, 420, false, font)
    let c: *mut render.Ctx = &(*pg).c
    var t: i64 = 1000

    ds_testpage.say("== catalog\n")
    repaint(pg, c, s, 1100.0, 420.0, t)
    ds_testpage.check(ds_tpl_store.grid_scroll_y(s) == 0.0, "grid starts at the top")
    t = swipe(s, 700.0, 350.0, 0.0, 0.0 - 160.0, 10, t, 0 as i64)
    repaint(pg, c, s, 1100.0, 420.0, t)
    let after_drag: f64 = ds_tpl_store.grid_scroll_y(s)
    ds_testpage.check(after_drag > 100.0, "vertical swipe scrolls the grid")
    ds_testpage.check(ds_tpl_store.moving(s), "a fast release keeps moving")
    t = run_out(s, c, t)
    ds_testpage.check(ds_tpl_store.grid_scroll_y(s) > after_drag, "the fling carries on after the lift")
    ds_testpage.check(!ds_tpl_store.moving(s), "the fling comes to rest")
    let rest: f64 = ds_tpl_store.grid_scroll_y(s)
    t = swipe(s, 700.0, 350.0, 0.0, 0.0 - 60.0, 6, t, 200 as i64)
    ds_testpage.check(!ds_tpl_store.moving(s), "a held finger gives no fling")
    ds_testpage.check(ds_tpl_store.grid_scroll_y(s) > rest, "slow drag still scrolls")
    let before_h: f64 = ds_tpl_store.grid_scroll_y(s)
    t = swipe(s, 700.0, 350.0, 0.0 - 200.0, 0.0, 8, t, 0 as i64)
    ds_testpage.check(ds_tpl_store.grid_scroll_y(s) == before_h && !ds_tpl_store.moving(s), "horizontal swipe on the grid does nothing")
    t = swipe(s, 100.0, 350.0, 0.0, 0.0 - 120.0, 8, t, 200 as i64)
    ds_testpage.check(ds_tpl_store.grid_scroll_y(s) == before_h, "a swipe on the pane does not scroll the grid")

    ds_testpage.say("== tap\n")
    ds_tpl_store.select_cat(st, 0)
    ds_tpl_store.set_query(st, "ab")
    repaint(pg, c, s, 1100.0, 420.0, t)
    LAST_ACTION = 0 as u32
    ds_tpl_store.touch_down(s, 330.0, 196.0, t * 1000 as i64)
    t = t + 60 as i64
    ds_tpl_store.touch_up(s, 330.0, 196.0, t * 1000 as i64)
    ds_testpage.check(LAST_ACTION == ds_appcard.ACT_INSTALL, "a tap on the install button fires it")
    ds_testpage.check(ds_tpl_store.grid_scroll_y(s) == 0.0, "a tap does not scroll")

    ds_testpage.say("== detail\n")
    ds_tpl_store.set_query(st, "")
    ds_tpl_store.open_detail(st, 1)
    repaint(pg, c, s, 1100.0, 420.0, t)
    ds_testpage.check(ds_tpl_store.page_scroll_y(s) == 0.0 && ds_tpl_store.shots_scroll_x(s) == 0.0, "detail starts at the origin")
    t = swipe(s, 700.0, 120.0, 0.0, 0.0 - 120.0, 8, t, 0 as i64)
    repaint(pg, c, s, 1100.0, 420.0, t)
    ds_testpage.check(ds_tpl_store.page_scroll_y(s) > 60.0, "vertical swipe scrolls the page")
    ds_testpage.check(ds_tpl_store.shots_scroll_x(s) == 0.0, "vertical swipe leaves the screenshot row")
    let page_end: f64 = ds_tpl_store.page_scroll_y(s)
    t = run_out(s, c, t)
    ds_testpage.check(ds_tpl_store.page_scroll_y(s) >= page_end, "the page fling never runs backwards")
    ds_tpl_store.open_detail(st, 1)
    repaint(pg, c, s, 1100.0, 700.0, t)
    t = swipe(s, 800.0, 100.0, 0.0 - 240.0, 0.0, 8, t, 0 as i64)
    ds_testpage.check(ds_tpl_store.shots_scroll_x(s) == 0.0, "horizontal swipe outside the screenshot row does nothing")
    t = swipe(s, 800.0, 380.0, 0.0 - 240.0, 0.0, 10, t, 0 as i64)
    repaint(pg, c, s, 1100.0, 700.0, t)
    let row_drag: f64 = ds_tpl_store.shots_scroll_x(s)
    ds_testpage.check(row_drag > 150.0, "horizontal swipe scrolls the screenshot row")
    ds_testpage.check(ds_tpl_store.page_scroll_y(s) == 0.0, "the page stays put during a row swipe")
    ds_testpage.check(ds_tpl_store.moving(s), "a fast row swipe keeps moving")
    t = run_out(s, c, t)
    ds_testpage.check(ds_tpl_store.shots_scroll_x(s) > row_drag, "the row fling carries on")
    t = swipe(s, 300.0, 380.0, 0.0 + 900.0, 0.0, 12, t, 0 as i64)
    t = run_out(s, c, t)
    ds_testpage.check(ds_tpl_store.shots_scroll_x(s) == 0.0, "the row stops at its start")
    t = swipe(s, 800.0, 380.0, 0.0 - 600.0, 0.0, 6, t, 0 as i64)
    t = swipe(s, 800.0, 380.0, 0.0 - 600.0, 0.0, 6, t, 0 as i64)
    t = swipe(s, 800.0, 380.0, 0.0 - 600.0, 0.0, 6, t, 0 as i64)
    t = run_out(s, c, t)
    repaint(pg, c, s, 1100.0, 700.0, t)
    t = run_out(s, c, t)
    let end_x: f64 = ds_tpl_store.shots_scroll_x(s)
    t = swipe(s, 800.0, 380.0, 0.0 - 600.0, 0.0, 6, t, 0 as i64)
    t = run_out(s, c, t)
    repaint(pg, c, s, 1100.0, 700.0, t)
    ds_testpage.check(end_x > 0.0 && ds_tpl_store.shots_scroll_x(s) == end_x, "the row stops at its end")
    ds_tpl_store.touch_down(s, 60.0, 29.0, t * 1000 as i64)
    ds_tpl_store.touch_up(s, 60.0, 29.0, (t + 50 as i64) * 1000 as i64)
    ds_testpage.check(!ds_tpl_store.in_detail(st), "a tap on Back leaves the detail page")

    ds_testpage.say("== pointer records\n")
    ds_tpl_store.open_detail(st, 1)
    repaint(pg, c, s, 1100.0, 420.0, t)
    ds_testpage.check(!ds_tpl_store.touch_pointer(s, fuiwirt.PE_DOWN, 1 as u32, event.PT_MOUSE, 700.0, 120.0, 0.0), "mouse records pass through")
    ds_testpage.check(ds_tpl_store.touch_pointer(s, fuiwirt.PE_DOWN, 1 as u32, event.PT_TOUCH, 700.0, 120.0, 0.0), "a touch down is consumed")
    ds_testpage.check(ds_tpl_store.touch_pointer(s, fuiwirt.PE_DOWN, 2 as u32, event.PT_TOUCH, 300.0, 120.0, 0.0), "a second finger is consumed and ignored")
    ds_tpl_store.touch_pointer(s, fuiwirt.PE_MOVE, 2 as u32, event.PT_TOUCH, 300.0, 40.0, 0.0)
    ds_testpage.check(ds_tpl_store.page_scroll_y(s) == 0.0, "the second finger does not scroll")
    t = t + 16 as i64
    repaint(pg, c, s, 1100.0, 420.0, t)
    ds_tpl_store.touch_pointer(s, fuiwirt.PE_MOVE, 1 as u32, event.PT_TOUCH, 700.0, 60.0, 0.0)
    t = t + 16 as i64
    repaint(pg, c, s, 1100.0, 420.0, t)
    ds_tpl_store.touch_pointer(s, fuiwirt.PE_MOVE, 1 as u32, event.PT_TOUCH, 700.0, 20.0, 0.0)
    ds_testpage.check(ds_tpl_store.page_scroll_y(s) > 0.0, "touch records drive the page")
    ds_tpl_store.touch_pointer(s, fuiwirt.PE_CANCEL, 1 as u32, event.PT_TOUCH, 700.0, 20.0, 0.0)
    ds_testpage.check(!ds_tpl_store.moving(s), "a cancel starts no fling")
    return ds_testpage.finish("ds_store_touch")
}
