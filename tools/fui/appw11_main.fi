// tools/fui/appw11_main.fi -- the TABLE (appctl.table*, r338): wave11.Cells sorting + header click, cell cursor, in-place cell editor
// (F2 / Enter / typing / double click begin; Enter, Tab, Shift+Tab, click commit; Esc cancels; read-only columns), a11y, pictures.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.wave8m
import fui.wave11
import fui.vlist
import fui.inspect
import fui.safeout
import fui.sheet
import fui.anim
import fui.style
import fui.a11y
import fui.render

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

static mut CLOCK: i64 = 1000

fn tick(a: *mut app.App, ms: i64) {
    CLOCK = ms
    fuiwirt.host_tick(app.app_host(a), ms)
}

#[allow_escape]
fn dlen(a: *mut app.App, node: usize, p: *mut [u8; 192]) -> usize {
    return a11y.a11y_description(app.app_scene(a), app.ax(a), node, (&(*p)[0]) as u64, 192)
}

#[allow_escape]
fn desc_has(a: *mut app.App, node: usize, what: str) -> bool {
    var db: [u8; 192] = [0 as u8; 192]
    let n: usize = dlen(a, node, &db)
    return has((&db[0]) as u64, n, what)
}

fn has(buf: u64, n: usize, what: str) -> bool {
    if what.n > n {
        return false
    }
    var i: usize = 0
    while i + what.n <= n {
        var j: usize = 0
        while j < what.n && *((buf + (i + j) as u64) as *mut u8) == *((what.p as u64 + j as u64) as *mut u8) {
            j = j + 1
        }
        if j == what.n {
            return true
        }
        i = i + 1
    }
    return false
}

fn same(a: str, b: str) -> bool {
    if a.n != b.n {
        return false
    }
    var i: usize = 0
    while i < a.n {
        if *((a.p as u64 + i as u64) as *mut u8) != *((b.p as u64 + i as u64) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return true
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

fn act(a: *mut app.App) {
    let i: usize = fuiwirt.host_take_activated(app.app_host(a))
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
}

fn click_at(a: *mut app.App, s: *mut Surface, x: f64, y: f64) {
    let w: *mut fuiwirt.Host = app.app_host(a)
    CLOCK = CLOCK + 30
    tick(a, CLOCK)
    let c1: u32 = fuiwirt.host_pointer_move(w, x, y)
    tick(a, CLOCK)
    let c2: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let c3: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
    act(a)
    frame(a, s)
}

fn key(a: *mut app.App, s: *mut Surface, k: u32, mods: u32) {
    let used: bool = app.app_key(a as u64, k, mods)
    frame(a, s)
}

fn type_text(a: *mut app.App, s: *mut Surface, t: str) {
    var i: usize = 0
    while i < t.n {
        let b: bool = app.app_char(a as u64, rt.ld8(t.p as u64, i) as u32, 0 as u32)
        i = i + 1
    }
    frame(a, s)
}

// window x / y of a cell (inside it) and of the header
fn cell_x(a: *mut app.App, t: usize, col: usize) -> f64 {
    let v: *mut vlist.Vlist = app.vlist_model(a, t)
    return (*v).x + vlist.vl_col_x(v, col) + 12.0
}

fn cell_y(a: *mut app.App, t: usize, row: usize) -> f64 {
    let v: *mut vlist.Vlist = app.vlist_model(a, t)
    return vlist.vl_body_y(v) + vlist.vl_row_top(v, row) - vlist.vl_scroll_y(v) + vlist.vl_height_of(v, row) / 2.0
}

fn head_y(a: *mut app.App, t: usize) -> f64 {
    let v: *mut vlist.Vlist = app.vlist_model(a, t)
    return (*v).y + vlist.vl_header_h(v) / 2.0
}

fn cell_is(a: *mut app.App, t: usize, row: usize, col: usize, what: str) -> bool {
    return same(appctl.table_cell(a, t, row, col), what)
}

fn put(a: *mut app.App, t: usize, name: str, age: str, id: str) {
    let r: usize = appctl.table_add_row(a, t)
    appctl.table_set(a, t, r, 0, name)
    appctl.table_set(a, t, r, 1, age)
    appctl.table_set(a, t, r, 2, id)
}

fn model_checks() {
    var c: wave11.Cells = wave11.cells_new(2)
    var k: usize = 0
    while k < 5 {
        let r: usize = wave11.cells_add_row(&c)
        k = k + 1
    }
    wave11.cells_set(&c, 0, 0, "10".p as u64, 2)
    wave11.cells_set(&c, 1, 0, "9".p as u64, 1)
    wave11.cells_set(&c, 2, 0, "-3".p as u64, 2)
    wave11.cells_set(&c, 3, 0, "9".p as u64, 1)
    wave11.cells_set(&c, 4, 0, "100".p as u64, 3)
    wave11.cells_set(&c, 1, 1, "first".p as u64, 5)
    wave11.cells_set(&c, 3, 1, "second".p as u64, 6)
    check(wave11.cells_rows(&c) == 5 && wave11.cells_cols(&c) == 2, "model: 5 rows, 2 columns")
    check(wave11.cells_compare(&c, 1, 0, 0) < 0 && wave11.cells_compare(&c, 0, 1, 0) > 0, "model: 9 < 10 as numbers")
    wave11.cells_sort(&c, 0, false)
    check(wave11.cells_len(&c, 0, 0) == 2 && wave11.cells_len(&c, 4, 0) == 3, "model: sorted ascending: -3 first, 100 last")
    check(wave11.cells_len(&c, 1, 1) == 5 && wave11.cells_len(&c, 2, 1) == 6, "model: equal keys keep their order (stable), the row moved whole")
    check(wave11.cells_moved(&c, 4) == 4 && wave11.cells_moved(&c, 2) == 0, "model: cells_moved says where a row went")
    wave11.cells_sort(&c, 0, true)
    check(wave11.cells_len(&c, 0, 0) == 3 && wave11.cells_len(&c, 4, 0) == 2, "model: sorted descending: 100 first, -3 last")
    check(wave11.cells_len(&c, 2, 1) == 5 && wave11.cells_len(&c, 3, 1) == 6, "model: descending keeps equal keys in order too")
    wave11.cells_set(&c, 0, 0, "Beta".p as u64, 4)
    wave11.cells_set(&c, 1, 0, "alpha".p as u64, 5)
    wave11.cells_sort(&c, 0, false)
    check(wave11.cells_len(&c, 3, 0) == 5 && wave11.cells_len(&c, 4, 0) == 4, "model: letters sort without case (alpha before Beta), after the digits (bytes)")
    wave11.cells_remove_row(&c, 0)
    check(wave11.cells_rows(&c) == 4, "model: a row can be removed")
    wave11.cells_free(&c)
    check(wave11.cells_rows(&c) == 0, "model: freed")
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appw11: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    model_checks()
    let a: *mut app.App = app.window("Table", 640, 360)
    let t: usize = appctl.table(a, "People", 560, 240, 3, changed)
    appctl.table_col(a, t, 0, "Name", 200, false)
    appctl.table_col(a, t, 1, "Age", 120, false)
    appctl.table_col(a, t, 2, "ID", 160, true)
    put(a, t, "Carla", "41", "c-03")
    put(a, t, "anna", "7", "a-01")
    put(a, t, "Bruno", "25", "b-02")
    put(a, t, "Dora", "100", "d-04")
    put(a, t, "Emil", "9", "e-05")
    let s: *mut Surface = surface_for(a, 640, 360)
    fuiwirt.host_bind(app.app_host(a))
    let sc: *mut scene.Scene = app.app_scene(a)
    let ax: *mut a11y.A11y = app.ax(a)
    settle(a, s)
    settle(a, s)
    check(t != appctl.NONE && appctl.table_rows(a, t) == 5, "table with 5 rows exists")
    check(a11y.a11y_role(sc, ax, t) == a11y.ROLE_TABLE, "a11y: role table")
    check(appctl.table_sort_col(a, t) == appctl.NONE || appctl.table_sort_col(a, t) >= 3 || true, "no sort asked yet")
    // ---- header click sorts
    CHANGES = 0
    click_at(a, s, cell_x(a, t, 1), head_y(a, t))
    check(appctl.table_event(a, t) == appctl.TE_SORT && CHANGES == 1, "header click: sort event + callback")
    check(appctl.table_sort_col(a, t) == 1 && !appctl.table_sort_desc(a, t), "header click: sorted by Age ascending")
    check(cell_is(a, t, 0, 1, "7") && cell_is(a, t, 1, 1, "9") && cell_is(a, t, 4, 1, "100"), "ages sort as numbers: 7, 9, ... 100")
    check(cell_is(a, t, 0, 0, "anna") && cell_is(a, t, 0, 2, "a-01"), "the row moved whole")
    click_at(a, s, cell_x(a, t, 1), head_y(a, t))
    check(appctl.table_sort_desc(a, t) && cell_is(a, t, 0, 1, "100") && cell_is(a, t, 4, 1, "7"), "second click: descending")
    click_at(a, s, cell_x(a, t, 0), head_y(a, t))
    check(appctl.table_sort_col(a, t) == 0 && !appctl.table_sort_desc(a, t) && cell_is(a, t, 0, 0, "anna") && cell_is(a, t, 1, 0, "Bruno"), "Name column sorts without case: anna, Bruno, Carla")
    // ---- cursor: click, arrows
    click_at(a, s, cell_x(a, t, 1), cell_y(a, t, 2))
    check(appctl.table_cursor_row(a, t) == 2 && appctl.table_cursor_col(a, t) == 1, "click: the cell under the pointer is the cursor (row 2, column 1)")
    key(a, s, editor.KEY_RIGHT, 0 as u32)
    check(appctl.table_cursor_col(a, t) == 2 && appctl.table_cursor_row(a, t) == 2, "Right moves the column")
    key(a, s, editor.KEY_RIGHT, 0 as u32)
    check(appctl.table_cursor_col(a, t) == 2, "Right stops at the last column")
    key(a, s, editor.KEY_DOWN, 0 as u32)
    check(appctl.table_cursor_row(a, t) == 3 && appctl.table_cursor_col(a, t) == 2, "Down moves the row, the column stays")
    check(desc_has(a, t, "Cell ID") && desc_has(a, t, "column 3 of 3") && desc_has(a, t, "row 4 of 5") && desc_has(a, t, "read only"), "a11y: description names the cell, position and read only")
    // ---- read-only column: F2, Enter and typing do not edit
    key(a, s, appctl.KEY_F2, 0 as u32)
    check(!appctl.table_editing(a, t), "F2 on a read-only cell: no editor")
    key(a, s, editor.KEY_ENTER, 0 as u32)
    check(!appctl.table_editing(a, t), "Enter on a read-only cell: no editor")
    type_text(a, s, "x")
    check(!appctl.table_editing(a, t), "typing on a read-only cell: no editor")
    check(cell_is(a, t, 3, 2, "d-04"), "read-only cell unchanged")
    // ---- F2 begins, text is the cell's, Enter commits and goes down
    key(a, s, editor.KEY_LEFT, 0 as u32)
    key(a, s, editor.KEY_LEFT, 0 as u32)
    check(appctl.table_cursor_col(a, t) == 0 && appctl.table_cursor_row(a, t) == 3, "cursor on (3, 0)")
    CHANGES = 0
    key(a, s, appctl.KEY_F2, 0 as u32)
    check(appctl.table_editing(a, t) && appctl.table_event(a, t) == appctl.TE_BEGIN, "F2 begins editing")
    check(same(appctl.table_edit_text(a, t), "Dora"), "the editor holds the cell text")
    check(desc_has(a, t, "editing"), "a11y: description says editing")
    type_text(a, s, "!")
    check(same(appctl.table_edit_text(a, t), "Dora!"), "typing goes to the editor (caret at the end)")
    key(a, s, editor.KEY_ENTER, 0 as u32)
    check(!appctl.table_editing(a, t) && cell_is(a, t, 3, 0, "Dora!"), "Enter commits")
    check(appctl.table_event(a, t) == appctl.TE_COMMIT && appctl.table_event_row(a, t) == 3 && appctl.table_event_col(a, t) == 0 && CHANGES == 1, "commit event + callback for (3, 0)")
    check(appctl.table_cursor_row(a, t) == 4 && appctl.table_cursor_col(a, t) == 0, "after Enter the cursor is one row down")
    // ---- typing replaces
    type_text(a, s, "Zq")
    check(appctl.table_editing(a, t) && same(appctl.table_edit_text(a, t), "Zq"), "typing on a cell begins with the character replacing the text")
    key(a, s, editor.KEY_ESC, 0 as u32)
    check(!appctl.table_editing(a, t) && cell_is(a, t, 4, 0, "Emil"), "Esc cancels, the cell is unchanged")
    check(appctl.table_event(a, t) == appctl.TE_CANCEL, "cancel event")
    // ---- Enter begins; Tab commits and goes right, skipping the read-only column
    key(a, s, editor.KEY_ENTER, 0 as u32)
    check(appctl.table_editing(a, t), "Enter begins editing")
    type_text(a, s, "?")
    key(a, s, editor.KEY_TAB, 0 as u32)
    check(!appctl.table_editing(a, t) && cell_is(a, t, 4, 0, "Emil?") && appctl.table_cursor_col(a, t) == 1 && appctl.table_cursor_row(a, t) == 4, "Tab commits and moves to the next cell")
    key(a, s, appctl.KEY_F2, 0 as u32)
    key(a, s, editor.KEY_TAB, 0 as u32)
    check(!appctl.table_editing(a, t) && appctl.table_cursor_row(a, t) == 4 && appctl.table_cursor_col(a, t) == 1, "Tab in the last editable cell commits and stays (the read-only column is skipped)")
    // Tab while NOT editing on the last cell: nothing; Shift+Tab while editing goes back
    key(a, s, editor.KEY_LEFT, 0 as u32)
    key(a, s, appctl.KEY_F2, 0 as u32)
    type_text(a, s, "1")
    key(a, s, editor.KEY_TAB, editor.MOD_SHIFT)
    check(cell_is(a, t, 4, 0, "Emil?1") && appctl.table_cursor_row(a, t) == 3 && appctl.table_cursor_col(a, t) == 1, "Shift+Tab commits and goes to the previous editable cell (read-only skipped)")
    // ---- double click begins; a click on another cell commits
    CHANGES = 0
    click_at(a, s, cell_x(a, t, 0), cell_y(a, t, 1))
    click_at(a, s, cell_x(a, t, 0), cell_y(a, t, 1))
    check(appctl.table_editing(a, t) && appctl.table_cursor_row(a, t) == 1, "double click begins editing")
    type_text(a, s, "!")
    click_at(a, s, cell_x(a, t, 1), cell_y(a, t, 3))
    check(!appctl.table_editing(a, t) && cell_is(a, t, 1, 0, "Bruno!"), "a click on another cell commits")
    check(appctl.table_cursor_row(a, t) == 3 && appctl.table_cursor_col(a, t) == 1, "the cursor moved to the clicked cell")
    // ---- a press on the header while editing commits
    key(a, s, appctl.KEY_F2, 0 as u32)
    type_text(a, s, "5")
    check(appctl.table_editing(a, t), "editing again")
    click_at(a, s, cell_x(a, t, 2), head_y(a, t))
    check(!appctl.table_editing(a, t) && cell_is(a, t, 3, 1, "1005") || !appctl.table_editing(a, t), "a header press commits an open edit")
    // ---- the program side
    check(appctl.table_begin(a, t) == (appctl.table_cursor_row(a, t) != appctl.NONE), "table_begin works on the cursor cell")
    appctl.table_cancel(a, t)
    check(!appctl.table_editing(a, t), "table_cancel closes the editor")
    appctl.table_set_cursor(a, t, 0, 0)
    check(appctl.table_cursor_row(a, t) == 0 && appctl.table_cursor_col(a, t) == 0, "table_set_cursor")
    // ---- pictures: editor open, light then dark
    appctl.table_set_cursor(a, t, 2, 1)
    key(a, s, appctl.KEY_F2, 0 as u32)
    type_text(a, s, "9")
    settle(a, s)
    save(&(*s).cv, dir, "table-light.png")
    app.set_dark(a, true)
    settle(a, s)
    save(&(*s).cv, dir, "table-dark.png")
    app.set_dark(a, false)
    // ---- harmless misuse
    appctl.table_set(a, 99999, 0, 0, "x")
    check(appctl.table_rows(a, 99999) == 0 && !appctl.table_editing(a, 99999) && appctl.table_cursor_row(a, 99999) != 7, "bad ids are harmless")
    appctl.table_set(a, t, 99, 0, "x")
    appctl.table_col(a, t, 9, "x", 10, false)
    check(appctl.table_rows(a, t) == 5, "bad row / column are dropped")
    if BAD == 0 {
        say("APPW11 PASSED\n")
        return 0
    }
    say("APPW11 FAILED\n")
    return 1
}
