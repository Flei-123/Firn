// SPDX-License-Identifier: GPL-2.0-only
// tools/fui/kontrast_main.fi -- DIE MARKE RECHNET IHRE ZUSAGE NACH.
//
// Das Entwurfssystem stellt EINE Bedingung an erster Stelle
// (.../skills/ui-ux-pro-max/SKILL.md, Prioritaet 1, "Accessibility,
// CRITICAL"): Kontrast 4,5:1 fuer gewoehnlichen Text.
//
// Eine Zusage, die niemand nachrechnet, ist eine Behauptung. Dieses
// Programm rechnet jedes Textpaar der Marke nach -- in BEIDEN Schemata
// -- und beendet sich mit 1, wenn eines darunter liegt. Damit faellt
// eine Farbe, die jemand "nur kurz" aendert, im Bau auf und nicht auf
// Justins Bildschirm.
//
// Es hat schon drei echte Fehler gefunden, zwei davon im ausgelieferten
// Certus; sie stehen im Kopf von lib/fui/marke.fi.
//
//     kontrast_main            nur die Zusammenfassung und was faellt
//     kontrast_main --laut     jede einzelne Paarung
import std.rt
import fui.marke

static mut G_LAUT: u32 = 0
static mut G_SCHLECHT: usize = 0
static mut G_ALLE: usize = 0
static mut G_MIN: i64 = 9900

// Zwei Nachkommastellen, ganzzahlig -- Firn Stufe 0 hat kein Format.
fn zahl2(t: *mut rt.Buf, hundertstel: i64) {
    rt.buf_push_dec_i64(t, hundertstel / 100)
    rt.buf_push(t, 46 as u8)
    let rest: i64 = hundertstel % 100
    if rest < 10 {
        rt.buf_push(t, 48 as u8)
    }
    rt.buf_push_dec_i64(t, rest)
}

// Eine Paarung pruefen und melden. Die Schwelle ist 4,5:1 = 450
// Hundertstel.
fn pruefe(nm: u64, nn: usize, vg: u32, hg: u32) {
    let k: f64 = marke.kontrast(vg, hg)
    let h: i64 = (k * 100.0 + 0.5) as i64
    G_ALLE = G_ALLE + 1
    if h < G_MIN {
        G_MIN = h
    }
    let schlecht: bool = h < 450
    if schlecht {
        G_SCHLECHT = G_SCHLECHT + 1
    }
    if G_LAUT == 0 && !schlecht {
        return
    }
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 30 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    zahl2(&t, h)
    var s_v: [u8; 3] = ":1 "
    rt.buf_push_bytes(&t, (&s_v[0]) as u64, 3)
    if schlecht {
        var s_n: [u8; 13] = "ZU WENIG <<<\n"
        rt.buf_push_bytes(&t, (&s_n[0]) as u64, 13)
    } else {
        var s_o: [u8; 3] = "OK\n"
        rt.buf_push_bytes(&t, (&s_o[0]) as u64, 3)
    }
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// Alle Textpaare EINES Schemas. Die Liste ist die vollstaendige Menge
// der Faelle, in denen fUi Text auf eine Flaeche malt -- wer ein
// Bedienelement hinzufuegt, das eine neue Paarung braucht, traegt sie
// hier ein.
fn schema(f: *mut marke.Farben) {
    var n1: [u8; 22] = "  text/knopf          "
    var n2: [u8; 22] = "  text/knopf_ueber    "
    var n3: [u8; 22] = "  text/knopf_druck    "
    var n4: [u8; 22] = "  text/feld           "
    var n5: [u8; 22] = "  text/feld_fokus     "
    var n6: [u8; 22] = "  text/flaeche        "
    var n7: [u8; 22] = "  text/flaeche_hoch   "
    var n8: [u8; 22] = "  text/grund          "
    var n9: [u8; 22] = "  text_blass/flaeche  "
    var na: [u8; 22] = "  text_gesperrt/knopf "
    var nb: [u8; 22] = "  ausw_text/auswahl   "
    var nc: [u8; 22] = "  auf_akzent/akzent   "
    var nd: [u8; 22] = "  fehler/flaeche      "
    var ne: [u8; 22] = "  warnung/flaeche     "
    var nf: [u8; 22] = "  gut/flaeche         "
    pruefe((&n1[0]) as u64, 22, (*f).text, (*f).knopf)
    pruefe((&n2[0]) as u64, 22, (*f).text, (*f).knopf_ueber)
    pruefe((&n3[0]) as u64, 22, (*f).text, (*f).knopf_druck)
    pruefe((&n4[0]) as u64, 22, (*f).text, (*f).feld)
    pruefe((&n5[0]) as u64, 22, (*f).text, (*f).feld_fokus)
    pruefe((&n6[0]) as u64, 22, (*f).text, (*f).flaeche)
    pruefe((&n7[0]) as u64, 22, (*f).text, (*f).flaeche_hoch)
    pruefe((&n8[0]) as u64, 22, (*f).text, (*f).grund)
    pruefe((&n9[0]) as u64, 22, (*f).text_blass, (*f).flaeche)
    pruefe((&na[0]) as u64, 22, (*f).text_gesperrt, (*f).knopf)
    pruefe((&nb[0]) as u64, 22, (*f).auswahl_text, (*f).auswahl)
    pruefe((&nc[0]) as u64, 22, (*f).text_auf_akzent, (*f).akzent)
    pruefe((&nd[0]) as u64, 22, (*f).fehler, (*f).flaeche)
    pruefe((&ne[0]) as u64, 22, (*f).warnung, (*f).flaeche)
    pruefe((&nf[0]) as u64, 22, (*f).gut, (*f).flaeche)
}

// DIE ZWEITE PRUEFUNG: DIE RANGFOLGE.
//
// Kontrast allein genuegt nicht. Ein GESPERRTES Element muss schwaecher
// aussehen als ein aktives -- sonst ist "gesperrt" zwar lesbar, aber
// nicht erkennbar. Und die drei Knopfflaechen muessen sich
// unterscheiden, sonst ist die Rueckmeldung auf einen Zeiger keine.
fn rangfolge(f: *mut marke.Farben) -> usize {
    var schlecht: usize = 0
    var t: rt.Buf = rt.buf_new()
    let k_norm: f64 = marke.kontrast((*f).text, (*f).knopf)
    let k_sperr: f64 = marke.kontrast((*f).text_gesperrt, (*f).knopf)
    var s1: [u8; 28] = "  gesperrt schwaecher:      "
    rt.buf_push_bytes(&t, (&s1[0]) as u64, 28)
    if k_sperr < k_norm {
        var ok: [u8; 3] = "OK\n"
        rt.buf_push_bytes(&t, (&ok[0]) as u64, 3)
    } else {
        var no: [u8; 7] = "FALSCH\n"
        rt.buf_push_bytes(&t, (&no[0]) as u64, 7)
        schlecht = schlecht + 1
    }
    var s2: [u8; 28] = "  drei Knopfflaechen:       "
    rt.buf_push_bytes(&t, (&s2[0]) as u64, 28)
    if (*f).knopf != (*f).knopf_ueber && (*f).knopf_ueber != (*f).knopf_druck
        && (*f).knopf != (*f).knopf_druck {
        var ok2: [u8; 3] = "OK\n"
        rt.buf_push_bytes(&t, (&ok2[0]) as u64, 3)
    } else {
        var no2: [u8; 7] = "FALSCH\n"
        rt.buf_push_bytes(&t, (&no2[0]) as u64, 7)
        schlecht = schlecht + 1
    }
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return schlecht
}

fn main(start: u64) -> i32 {
    var i: usize = 1
    while i < rt.arg_count(start) {
        let p: u64 = rt.arg_ptr(start, i)
        // "--laut" -- das dritte Oktett ist 'l'
        if rt.c_length(p) == 6 && rt.ld8(p, 2) == 108 as u8 {
            G_LAUT = 1
        }
        i = i + 1
    }

    var hell: marke.Farben = marke.farben_hell()
    var dunkel: marke.Farben = marke.farben_dunkel()

    var v1: [u8; 6] = "HELL:\n"
    rt.write_everything(1, (&v1[0]) as u64, 6)
    schema(&hell)
    let b1: usize = rangfolge(&hell)

    var v2: [u8; 8] = "DUNKEL:\n"
    rt.write_everything(1, (&v2[0]) as u64, 8)
    schema(&dunkel)
    let b2: usize = rangfolge(&dunkel)

    // ---- DIE ZUSAMMENFASSUNG
    var t: rt.Buf = rt.buf_new()
    var z1: [u8; 10] = "\nGEPRUEFT "
    rt.buf_push_bytes(&t, (&z1[0]) as u64, 10)
    rt.buf_push_dec_i64(&t, G_ALLE as i64)
    var z2: [u8; 12] = " Textpaare, "
    rt.buf_push_bytes(&t, (&z2[0]) as u64, 12)
    rt.buf_push_dec_i64(&t, G_SCHLECHT as i64)
    var z3: [u8; 22] = " unter 4.5:1, kleinst "
    rt.buf_push_bytes(&t, (&z3[0]) as u64, 22)
    zahl2(&t, G_MIN)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)

    if G_SCHLECHT > 0 || b1 > 0 || b2 > 0 {
        var f1: [u8; 33] = "MARKE HAELT IHRE ZUSAGE NICHT.\n\0\0"
        rt.write_everything(1, (&f1[0]) as u64, 31)
        return 1
    }
    var o1: [u8; 18] = "MARKE BESTANDEN.\n\0"
    rt.write_everything(1, (&o1[0]) as u64, 17)
    return 0
}
