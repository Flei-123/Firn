// SPDX-License-Identifier: MPL-2.0
// tools/fui/appnodes_main.fi -- THE CHECK OF fui.app NODES (r145: card, groupbox, separator, badge,
// image, icon) AND OF THE BIG TREE (r102: more than 128 nodes in one window), WITHOUT A WINDOW.
//
//     firnc -o /tmp/appnodes tools/fui/appnodes_main.fi && /tmp/appnodes
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.uiimage
import fui.uisvg

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut LAST_ID: usize = 0

static mut MAIL_ID: usize = 0
static mut OUT_ID: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_num(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

static mut FONT: u64 = 0

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn settle(a: *mut app.App) {
    let i: usize = fuiwirt.host_take_activated(app.app_host(a))
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
}

fn click_at(a: *mut app.App, s: *mut Surface, x: f64, y: f64) {
    let w: *mut fuiwirt.Host = app.app_host(a)
    let c1: u32 = fuiwirt.host_pointer_move(w, x, y)
    let c2: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let c3: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
    settle(a)
    frame(a, s)
}

fn click(a: *mut app.App, s: *mut Surface, id: usize) {
    let sc: *mut scene.Scene = app.app_scene(a)
    click_at(a, s, scene.node_x(sc, id) + scene.node_w(sc, id) / 2.0,
        scene.node_y(sc, id) + scene.node_h(sc, id) / 2.0)
}

fn key(a: *mut app.App, s: *mut Surface, k: u32) {
    let used: bool = app.app_key(a as u64, k, 0 as u32)
    if !used {
        let h: u32 = fuiwirt.host_key(app.app_host(a), 0 as u32, 0 as u32)
    }
    frame(a, s)
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
    LAST_ID = id
}

fn focus_on(a: *mut app.App, id: usize) {
    let r: u32 = fuiwirt.host_pointer_move(app.app_host(a), 1.0, 1.0)
    let f: bool = false
}

static mut ANS: u32 = 0

fn btn_none(a: *mut app.App) {
}
static mut ASKS: usize = 0

fn answered(a: *mut app.App, ans: u32) {
    ANS = ans
    ASKS = ASKS + 1
}

fn hkey(a: *mut app.App, s: *mut Surface, k: u32) {
    let r: u32 = fuiwirt.host_key(app.app_host(a), k, 0 as u32)
    frame(a, s)
}

fn hash(s: *mut Surface) -> u64 {
    let p: *mut u8 = canvas.canvas_pixels(&(*s).cv)
    var h: u64 = 2166136261
    var i: usize = 0
    while i < (*s).w * (*s).h * 4 {
        h = (h ^ ((*((p as u64 + i as u64) as *mut u8)) as u64)) * 16777619 % 4294967296
        i = i + 7
    }
    return h
}

static mut CLICKS: usize = 0

fn clicked(a: *mut app.App) {
    CLICKS = CLICKS + 1
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appnodes: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64

    // ---- part 1: the new nodes
    let a: *mut app.App = app.window("Nodes", 480, 360)
    let hd: usize = app.label(a, "Header", 0)
    let card: usize = app.card(a)
    let c_lab: usize = app.label(a, "Inside the card", 0)
    let c_btn: usize = app.button(a, "Card button", clicked)
    app.end(a)
    let gb: usize = app.groupbox(a, "Options")
    let g_lab: usize = app.label(a, "Inside the group", 0)
    app.end(a)
    let sep: usize = app.separator(a)
    let bd: usize = app.badge(a, "New")
    // image and icon belong to the program: on the heap, as long as the window
    let px: *mut u32 = rt.heap_alloc(64) as *mut u32
    var q: usize = 0
    while q < 16 {
        *((px as u64 + (q * 4) as u64) as *mut u32) = 4278190335 as u32
        q = q + 1
    }
    let img: *mut uiimage.Image = rt.heap_alloc(1024) as *mut uiimage.Image
    *img = uiimage.image_wrap(px as u64, 4, 4, 16)
    let im: usize = app.image(a, img, 24, 24)
    let ic: *mut uisvg.Icon = rt.heap_alloc(4096) as *mut uisvg.Icon
    *ic = uisvg.icon_new()
    let io: usize = app.icon(a, ic, 16, 16)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 480, 360)
    frame(a, s)
    frame(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    check(card != app.NONE && gb != app.NONE && sep != app.NONE && bd != app.NONE && im != app.NONE && io != app.NONE,
        "all new calls return a node")
    check(scene.node_kind(sc, card) == scene.N_WIDGET && widget.w_kind(scene.node_widget(sc, card)) == widget.KIND_CARD,
        "card is a widget node of kind CARD")
    check(widget.w_kind(scene.node_widget(sc, gb)) == widget.KIND_GROUPBOX, "groupbox is of kind GROUPBOX")
    check(widget.w_kind(scene.node_widget(sc, sep)) == widget.KIND_SEPARATOR, "separator is of kind SEPARATOR")
    check(widget.w_kind(scene.node_widget(sc, bd)) == widget.KIND_BADGE, "badge is of kind BADGE")
    check(scene.node_kind(sc, im) == scene.N_IMAGE && scene.node_kind(sc, io) == scene.N_SVG, "image / icon are N_IMAGE / N_SVG")
    check(scene.scene_parent(sc, c_lab) == card && scene.scene_parent(sc, c_btn) == card, "the card holds its children")
    check(scene.scene_parent(sc, g_lab) == gb, "the group box holds its child")
    check(scene.scene_parent(sc, sep) != card && scene.scene_parent(sc, sep) != gb, "end() closes card and group box")
    let cx0: f64 = scene.node_x(sc, card)
    let cx1: f64 = cx0 + scene.node_w(sc, card)
    check(scene.node_x(sc, c_lab) >= cx0 && scene.node_x(sc, c_lab) + scene.node_w(sc, c_lab) <= cx1 + 0.5,
        "the card's child lies inside its box")
    check(scene.node_y(sc, c_btn) + scene.node_h(sc, c_btn) <= scene.node_y(sc, card) + scene.node_h(sc, card) + 0.5,
        "the card grows around its children")
    check(scene.node_h(sc, sep) >= 1.0 && scene.node_h(sc, sep) <= 2.0 && scene.node_w(sc, sep) > 100.0,
        "the separator is a thin rule across the window")
    check(scene.node_w(sc, im) == 24.0 && scene.node_h(sc, im) == 24.0, "the image has its size")
    let h1: u64 = hash(s)
    click(a, s, c_btn)
    check(CLICKS == 1, "a button inside a card is clicked")
    check(app.audit(a) >= 0, "audit runs on the new nodes")

    // ---- part 2: more than 128 nodes (r102)
    let b: *mut app.App = app.window("Big", 640, 480)
    var made: usize = 0
    var bad: usize = 0
    var first_btn: usize = app.NONE
    var r: usize = 0
    while r < 30 {
        let ro: usize = app.row(b)
        if ro == app.NONE {
            bad = bad + 1
        }
        var k: usize = 0
        while k < 40 {
            var id: usize = app.NONE
            if r == 5 && k == 0 {
                id = app.button(b, "Deep button", clicked)
                first_btn = id
            } else {
                id = app.label(b, "x", 0)
            }
            if id == app.NONE {
                bad = bad + 1
            } else {
                made = made + 1
            }
            k = k + 1
        }
        app.end(b)
        r = r + 1
    }
    fuiwirt.host_bind(app.app_host(b))
    let s2: *mut Surface = surface_for(b, 640, 480)
    frame(b, s2)
    frame(b, s2)
    let sc2: *mut scene.Scene = app.app_scene(b)
    check(bad == 0 && made == 1200, "1200 widgets + 30 rows: no add was refused")
    check(scene.scene_count(sc2) > 1200 && scene.scene_node_overflow(sc2) == 0, "the tree holds more than 1200 nodes")
    check(first_btn > 128, "the deep button sits past the old limit of 128 nodes")
    check(str_eq(app.text(b, first_btn), "Deep button"), "its text survives (per-node text table)")
    CLICKS = 0
    app.app_act(b as u64, first_btn)
    check(CLICKS == 1, "its click handler runs (per-node handler table)")
    check(scene.node_w(sc2, first_btn) > 0.0, "it was laid out")
    check(scene.scene_kid_overflow(sc2) == 0, "no box lost children")
    let ax: u64 = hash(s2)
    check(ax != 0, "the big window paints")

    say("\n")
    if BAD == 0 {
        say("APPNODES PASSED.\n")
        return 0
    }
    say("APPNODES FAILED.\n")
    return 1
}

fn str_eq(a: str, b: str) -> bool {
    if a.n != b.n {
        return false
    }
    var i: usize = 0
    while i < a.n {
        if rt.ld8(a.p as u64, i) != rt.ld8(b.p as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}
