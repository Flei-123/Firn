import std.rt
import html.mem
import paint.canvas
import paint.png
import ds_testpage
import fui.action
import fui.ds_icons
import fui.ds_icons_full
import fui.ds_icons_names
import fui.style
import fui.safeout

const COLS: usize = 16
const CELL: f64 = 40.0

fn save(pg: *mut ds_testpage.Page, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(&(*pg).cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

fn has(name: str) -> bool {
    return ds_icons.find(name) >= 0
}

fn sheet(pg: *mut ds_testpage.Page, filled: bool, base: u32, ink: u32) -> usize {
    ds_testpage.clear(pg)
    var empty: usize = 0
    var i: i64 = 0
    while i < ds_icons.count() {
        let cx: f64 = ((i as usize % COLS) as f64) * CELL
        let cy: f64 = ((i as usize / COLS) as f64) * CELL
        let ok: bool = ds_icons.draw_id(&(*pg).z, i, cx + 8.0, cy + 8.0, 24.0, ink, filled)
        if !ok || ds_testpage.region_differs(pg, cx, cy, CELL, CELL, base) < 12 {
            empty = empty + 1
            ds_testpage.say("  empty: ")
            ds_testpage.say(ds_icons.name_of(i))
            ds_testpage.say("\n")
        }
        i = i + 1
    }
    return empty
}

fn main(start: u64) -> i32 {
    ds_icons_full.install()
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let font: u64 = ds_testpage.font_load()
    if font == 0 {
        ds_testpage.say("no system font\n")
        return 2
    }
    let rows: usize = (ds_icons.count() as usize + COLS - 1) / COLS
    let pg: *mut ds_testpage.Page = ds_testpage.page_new(COLS * 40, rows * 40, false, font)
    let base: u32 = ds_testpage.tok(pg, style.TOK_BASE)
    let ink: u32 = ds_testpage.tok(pg, style.TOK_TEXT)

    ds_testpage.say("== catalog\n")
    ds_testpage.check(ds_icons.count() >= 120, "at least 120 icons")
    var dup: usize = 0
    var i: i64 = 0
    while i < ds_icons.count() {
        var j: i64 = i + 1
        while j < ds_icons.count() {
            if action.str_eq(ds_icons.name_of(i), ds_icons.name_of(j)) { dup = dup + 1 }
            if action.str_eq(ds_icons.path_of(i, 24.0, false), ds_icons.path_of(j, 24.0, false)) { dup = dup + 1 }
            j = j + 1
        }
        i = i + 1
    }
    ds_testpage.check(dup == 0, "no duplicate names or glyphs")
    ds_testpage.check(ds_icons.find(ds_icons.name_of(7)) == 7, "find round trip")

    ds_testpage.say("== required names\n")
    let need: [str; 40] = [
        "store", "folder", "document", "document_pdf", "image", "settings", "wifi_1", "wifi_2", "wifi_3", "wifi_4",
        "wifi_off", "bluetooth", "battery_0", "battery_10", "battery_charge", "volume_0", "volume_2", "volume_mute",
        "display", "user", "update", "install", "open", "search", "back", "forward", "up", "close", "more", "home",
        "trash", "copy", "paste", "info", "warning", "error", "success", "globe", "sort", "grid",
    ]
    var k: usize = 0
    var miss: usize = 0
    while k < 40 {
        if !has(need[k]) { miss = miss + 1 }
        k = k + 1
    }
    ds_testpage.check(miss == 0, "all Store/Explorer/Settings/Welcome names exist")
    ds_testpage.check(has("list") && has("maximize") && has("restore") && has("rocket") && has("hand"), "list, window controls, welcome")

    ds_testpage.say("== unknown name fails loudly\n")
    let before: usize = ds_icons.missing_count()
    ds_testpage.check(!ds_icons.draw(&(*pg).z, "no_such_icon", 0.0, 0.0, 24.0, ink, false), "unknown name returns false")
    ds_testpage.check(ds_icons.missing_count() == before + 1, "unknown name counted")
    ds_testpage.check(ds_icons.find("no_such_icon") == ds_icons.NONE, "find unknown")

    ds_testpage.say("== every icon renders\n")
    ds_testpage.check(sheet(pg, false, base, ink) == 0, "regular: all non-empty")
    save(pg, dir, "ds_icons-regular.png")
    ds_testpage.check(sheet(pg, true, base, ink) == 0, "filled: all non-empty")
    save(pg, dir, "ds_icons-filled.png")

    ds_testpage.say("== sizes\n")
    ds_testpage.clear(pg)
    ds_testpage.check(ds_icons.draw(&(*pg).z, "store", 8.0, 8.0, 16.0, ink, false), "16 px")
    ds_testpage.check(ds_icons.draw(&(*pg).z, "store", 48.0, 8.0, 20.0, ink, false), "20 px")
    ds_testpage.check(ds_icons.draw(&(*pg).z, "store", 88.0, 8.0, 48.0, ink, true), "48 px")
    ds_testpage.check(ds_icons.draw_pt(&(*pg).z, ds_icons.find("store"), 160.0, 8.0, 12.0, ink, false), "12 pt")
    ds_testpage.check(ds_testpage.region_differs(pg, 0.0, 0.0, 200.0, 64.0, base) > 100, "sizes paint")

    return ds_testpage.finish("ds_icons")
}
