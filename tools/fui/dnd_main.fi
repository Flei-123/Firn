// SPDX-License-Identifier: MPL-2.0
// tools/fui/dnd_main.fi -- THE CHECK OF lib/fui/dnd.fi (drag and drop inside the app). Gate of gap list #96:
// drag row -> row and text -> field scripted without a window, keyboard way included. Exit 1 on any WRONG.
import std.rt
import fui.dnd

static mut BAD: usize = 0

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }

fn check(ok: bool, what: str) {
    if ok { say("  ok    ") } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn main(start: u64) -> i32 {
    say("== dnd ==\n")
    var d: dnd.Drag = dnd.drag_new()
    check(dnd.is_idle(&d) && !dnd.is_active(&d), "starts idle")

    // a click without travel is not a drag
    dnd.press(&d, 100, 100, dnd.KIND_ROW, 7, dnd.OP_MOVE | dnd.OP_COPY, false)
    check(dnd.is_pending(&d), "press -> pending")
    check(!dnd.motion(&d, 102, 102, 0 as u32), "2 px diagonal (2.8 px) stays pending")
    check(dnd.release(&d) == dnd.OP_NONE && dnd.is_idle(&d), "release while pending = a click, no effect")

    // threshold 4 px
    dnd.press(&d, 100, 100, dnd.KIND_ROW, 7, dnd.OP_MOVE | dnd.OP_COPY, false)
    check(!dnd.motion(&d, 103, 100, 0 as u32), "3 px: pending")
    check(dnd.motion(&d, 104, 100, 0 as u32), "4 px: the drag STARTS (true once)")
    check(!dnd.motion(&d, 150, 120, 0 as u32) && dnd.is_active(&d), "later motion does not start again")
    check(dnd.drag_dx(&d) == 50 && dnd.drag_dy(&d) == 20, "offset from the press point")
    check(dnd.payload_id(&d) == 7 && dnd.payload_kind(&d) == dnd.KIND_ROW, "payload kept")

    // no target -> nothing
    check(dnd.effect(&d) == dnd.OP_NONE, "no target under the pointer: effect NONE")
    // target that accepts rows and moves
    dnd.over(&d, 3, dnd.KIND_ROW, dnd.OP_MOVE)
    check(dnd.effect(&d) == dnd.OP_MOVE && dnd.target(&d) == 3, "row -> row target: MOVE")
    // modifier asks copy, target does not allow it -> NONE
    dnd.motion(&d, 151, 120, dnd.MOD_CTRL)
    check(dnd.effect(&d) == dnd.OP_NONE, "Ctrl (copy) where only move is allowed: NONE, not a silent move")
    dnd.over(&d, 3, dnd.KIND_ROW, dnd.OP_MOVE | dnd.OP_COPY)
    check(dnd.effect(&d) == dnd.OP_COPY, "Ctrl where copy is allowed: COPY")
    dnd.motion(&d, 152, 120, dnd.MOD_SHIFT)
    check(dnd.effect(&d) == dnd.OP_MOVE, "Shift: MOVE")
    dnd.motion(&d, 153, 120, 0 as u32)
    check(dnd.effect(&d) == dnd.OP_MOVE, "no modifier: MOVE wins over COPY")
    // wrong kind
    dnd.over(&d, 4, dnd.KIND_TEXT, dnd.OP_MOVE | dnd.OP_COPY)
    check(dnd.effect(&d) == dnd.OP_NONE, "target does not accept rows: NONE")
    dnd.over(&d, 5, dnd.KIND_ROW | dnd.KIND_TAB, dnd.OP_COPY)
    check(dnd.effect(&d) == dnd.OP_COPY, "no common move: COPY")
    dnd.leave(&d)
    check(dnd.effect(&d) == dnd.OP_NONE && dnd.target(&d) == 0, "leave clears the target")
    dnd.over(&d, 5, dnd.KIND_ROW, dnd.OP_COPY)
    check(dnd.release(&d) == dnd.OP_COPY && dnd.is_idle(&d), "release drops with COPY and ends the drag")

    // Esc cancels
    dnd.press(&d, 0, 0, dnd.KIND_TEXT, 1, dnd.OP_COPY, false)
    dnd.motion(&d, 50, 0, 0 as u32)
    dnd.over(&d, 9, dnd.KIND_TEXT, dnd.OP_COPY)
    dnd.cancel(&d)
    check(dnd.is_idle(&d) && dnd.release(&d) == dnd.OP_NONE, "cancel: idle, a later release does nothing")

    // text -> field
    dnd.press(&d, 10, 10, dnd.KIND_TEXT, 42, dnd.OP_COPY | dnd.OP_MOVE, false)
    dnd.motion(&d, 60, 12, 0 as u32)
    dnd.over(&d, 8, dnd.KIND_TEXT | dnd.KIND_FILE, dnd.OP_COPY)
    check(dnd.release(&d) == dnd.OP_COPY, "text -> field: COPY")

    // link by Alt
    dnd.press(&d, 0, 0, dnd.KIND_FILE, 5, dnd.OP_MOVE | dnd.OP_COPY | dnd.OP_LINK, false)
    dnd.motion(&d, 30, 0, dnd.MOD_ALT)
    dnd.over(&d, 2, dnd.KIND_FILE, dnd.OP_MOVE | dnd.OP_COPY | dnd.OP_LINK)
    check(dnd.effect(&d) == dnd.OP_LINK, "Alt: LINK")
    dnd.cancel(&d)

    // touch needs 10 px
    dnd.press(&d, 0, 0, dnd.KIND_ROW, 1, dnd.OP_MOVE, true)
    check(!dnd.motion(&d, 8, 0, 0 as u32) && dnd.motion(&d, 10, 0, 0 as u32), "touch: 8 px pending, 10 px starts")
    dnd.cancel(&d)

    // over() outside a drag does nothing
    dnd.over(&d, 3, dnd.KIND_ROW, dnd.OP_MOVE)
    check(dnd.target(&d) == 0, "over() while idle is ignored")

    // list slots: 10 rows of 20 px from y=100
    check(dnd.slot_gap(100, 100, 20, 10) == 0, "slot gap: top edge = 0")
    check(dnd.slot_gap(109, 100, 20, 10) == 0 && dnd.slot_gap(110, 100, 20, 10) == 1, "gap flips at the row's middle")
    check(dnd.slot_gap(95, 100, 20, 10) == 0, "above the list = 0")
    check(dnd.slot_gap(299, 100, 20, 10) == 10, "lower half of the last row = 10 (end)")
    check(dnd.slot_gap(900, 100, 20, 10) == 10, "below the list = n (end)")
    check(dnd.slot_gap(150, 100, 20, 0) == 0, "empty list = 0")
    check(dnd.slot_zone(103, 100, 20, 10, false) == dnd.SLOT_BEFORE && dnd.slot_zone(117, 100, 20, 10, false) == dnd.SLOT_AFTER, "list zones: halves")
    check(dnd.slot_zone(103, 100, 20, 10, true) == dnd.SLOT_BEFORE, "tree: top quarter = BEFORE")
    check(dnd.slot_zone(110, 100, 20, 10, true) == dnd.SLOT_ON, "tree: middle = ON (drop into the row)")
    check(dnd.slot_zone(118, 100, 20, 10, true) == dnd.SLOT_AFTER, "tree: bottom quarter = AFTER")
    let sl: i64 = dnd.slot(150, 100, 20, 10, true)
    check(sl / 4 == 2 && (sl % 4) == (dnd.SLOT_ON as i64), "packed slot: row 2, ON")
    let sl2: i64 = dnd.slot(5000, 100, 20, 10, false)
    check(sl2 / 4 == 9, "packed slot clamps to the last row")

    // edge scroll: viewport 100..500, zone 40, max 20 px/frame
    check(dnd.edge_scroll(300, 100, 500, 40, 20) == 0, "middle: no scroll")
    check(dnd.edge_scroll(140, 100, 500, 40, 20) == 0, "just outside the zone: none")
    check(dnd.edge_scroll(139, 100, 500, 40, 20) == 0 - 1, "1 px into the top zone: -1")
    check(dnd.edge_scroll(120, 100, 500, 40, 20) == 0 - 10, "half way into the zone: -10")
    check(dnd.edge_scroll(100, 100, 500, 40, 20) == 0 - 20, "at the edge: -max")
    check(dnd.edge_scroll(50, 100, 500, 40, 20) == 0 - 20, "outside above: still -max")
    check(dnd.edge_scroll(480, 100, 500, 40, 20) == 10 && dnd.edge_scroll(500, 100, 500, 40, 20) == 20, "bottom zone scrolls down")
    check(dnd.edge_scroll(101, 100, 110, 40, 20) < 0 && dnd.edge_scroll(109, 100, 110, 40, 20) > 0 && dnd.edge_scroll(105, 100, 110, 40, 20) == 0, "tiny viewport: zone shrinks to half, middle stays calm")
    check(dnd.edge_scroll(300, 100, 500, 0, 20) == 0, "zone 0: never")

    // keyboard way
    var k: dnd.Drag = dnd.drag_new()
    dnd.grab(&k, dnd.KIND_ROW, 11, dnd.OP_MOVE)
    check(dnd.is_keyboard(&k) && dnd.is_active(&k) && dnd.kbd_target(&k) == 0 - 1, "Space grabs: keyboard drag, no target yet")
    check(dnd.kbd_move(&k, 1, 4) == 0, "Down: first target")
    check(dnd.kbd_move(&k, 1, 4) == 1 && dnd.kbd_move(&k, 1, 4) == 2 && dnd.kbd_move(&k, 1, 4) == 3, "Down walks")
    check(dnd.kbd_move(&k, 1, 4) == 0, "Down wraps to the first")
    check(dnd.kbd_move(&k, 0 - 1, 4) == 3, "Up wraps to the last")
    dnd.over(&k, 4, dnd.KIND_ROW, dnd.OP_MOVE)
    check(dnd.kbd_drop(&k) == dnd.OP_MOVE && dnd.is_idle(&k), "Enter drops with MOVE")
    var k2: dnd.Drag = dnd.drag_new()
    dnd.grab(&k2, dnd.KIND_ROW, 11, dnd.OP_MOVE)
    check(dnd.kbd_drop(&k2) == dnd.OP_NONE && dnd.is_idle(&k2), "Enter with no target: nothing")
    var k3: dnd.Drag = dnd.drag_new()
    dnd.grab(&k3, dnd.KIND_ROW, 11, dnd.OP_MOVE)
    dnd.kbd_move(&k3, 0 - 1, 5)
    check(dnd.kbd_target(&k3) == 4, "Up from nothing goes to the last target")
    dnd.cancel(&k3)
    check(dnd.is_idle(&k3) && dnd.kbd_move(&k3, 1, 5) == 0 - 1, "Esc ends it; arrows do nothing after")

    say("DND bad=")
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, BAD as u64)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    say("\n")
    if BAD > 0 { return 1 }
    return 0
}
