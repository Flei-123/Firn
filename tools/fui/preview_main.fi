// SPDX-License-Identifier: MPL-2.0
// tools/fui/preview_main.fi -- fUi PAINTS ITSELF, AS A PNG.
//
// A control nobody can see is a control nobody checked. This program
// paints the fUi elements in all their states onto a canvas and writes
// it out as a PNG -- no window, no X11, no Wine. That way every change
// to the drawing layer can be LOOKED AT, and at Justin's resolution.
//
//     preview_main <out.png> [light|dark] [<font.ttf>]
//
// Why this exists and not just a screenshot: the very same drawing has
// already broken TWICE in OrientOS today (first a frayed cross, then
// only a single diagonal), and both times nobody spotted it in the
// source. In the image it is obvious at once.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.style
import fui.painter

const FONTSET_BYTES: usize = 4096

// EINE FORDERUNG AN DAS EIGENE BILD.
//
// Dieses Blatt hat bis zum 21.09.2026 eine Adresse gezeigt, die
// jemand von Hand auf "https://de.wikipedia." gekuerzt hatte, damit
// sie ins Feld passt. Im Bild sieht das aus wie ein Textfeld, das
// mitten im Wort abschneidet -- also genau wie der Fehler, gegen den
// `painter.run_draw_ellipsis` gebaut wurde. Jetzt steht die
// VOLLSTAENDIGE Adresse in der Quelle, und das Programm rechnet nach,
// dass sie in ihr Feld passt beziehungsweise sauber in den drei
// Punkten endet. Wird die Forderung verletzt, geht die Meldung auf
// fd 2 und der Lauf bleibt daran haengen -- ein Beleg, der seine
// eigene Aussage nicht erfuellt, darf nicht ausgeliefert werden.
fn request(nm: u64, nn: usize, ist: i64, should: i64) -> usize {
    if ist >= should {
        return 0
    }
    var t: rt.Buf = rt.buf_new()
    var p1: [u8; 9] = "preview: "
    rt.buf_push_bytes(&t, (&p1[0]) as u64, 9)
    rt.buf_push_bytes(&t, nm, nn)
    var p2: [u8; 6] = ": got "
    rt.buf_push_bytes(&t, (&p2[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, ist)
    var p3: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&p3[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, should)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(2, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 1
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 47] = "preview_main <out.png> [light|dark] [font.ttf]\n"
        rt.write_everything(2, (&u[0]) as u64, 47)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)

    // light or dark
    var dark: bool = true
    if rt.arg_count(start) >= 3 {
        let p2: u64 = rt.arg_ptr(start, 2)
        // "light" -- five octets, first one 'l'
        if rt.ld8(p2, 0) == 108 as u8 {
            dark = false
        }
    }

    // ---- THE FONT. Without it everything but the text is painted.
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
        rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    // OHNE SCHRIFT KEIN BELEG -- dieselbe Regel wie in den Galerien:
    // ein Bild ohne einen einzigen Buchstaben sieht von weitem aus wie
    // ein Bild und belegt nichts. Also Fehler auf fd 2 und ein
    // Rueckgabewert, an dem der Lauf haengenbleibt.
    if fm == 0 {
        var ks: [u8; 59] = "preview: keine Schrift gefunden -- ohne Schrift kein Beleg\n"
        rt.write_everything(2, (&ks[0]) as u64, 59)
        return 9
    }

    // ---- THE CANVAS
    //
    // Die Hoehe endet, wo der Inhalt endet: die letzte bemalte Zeile
    // liegt bei 225, darunter stand bis zum 20.09.2026 fast die Haelfte
    // der Leinwand leer. Eine leere untere Haelfte sieht auf einem
    // Daumennagel aus wie Absicht und ist keine -- die Belegpruefung
    // in tools/fui/run.sh rechnet seit dieser Runde nach, dass in JEDEM
    // waagerechten Band etwas steht, und dieses Bild bestand das nicht.
    let W: usize = 760
    let H: usize = 240
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    // The grid cell: sized like the largest widget plus some air.
    if !painter.painter_init(&z, &cv, 320, 120) {
        return 5
    }
    painter.painter_set_font(&z, fm)

    var m: theme.Theme = theme.theme_new(dark)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    let fo: *mut theme.Shape = theme.theme_shape(&m)
    canvas.canvas_clear(&cv, theme.opaque((*f).base))

    let px: f64 = theme.theme_px(&m, 1) as f64
    let r_button: f64 = theme.theme_px(&m, (*fo).r_button) as f64
    let r_field: f64 = theme.theme_px(&m, (*fo).r_field) as f64
    let ch: f64 = theme.theme_px(&m, (*fo).ctrl_h) as f64
    let padx: f64 = theme.theme_px(&m, (*fo).pad_x) as f64
    let gap: f64 = theme.theme_px(&m, (*fo).gap) as f64
    let spl: f64 = theme.theme_px(&m, (*fo).sp_l) as f64
    let spm: f64 = theme.theme_px(&m, (*fo).sp_m) as f64
    let focus_w: f64 = theme.theme_px(&m, (*fo).focus_w) as f64
    let size: f64 = theme.theme_px(&m, (*fo).font) as f64

    // ============================= ROW 1: THE FIVE BUTTON STATES
    var t_norm: [u8; 6] = "Normal"
    var t_hover: [u8; 5] = "Hover"
    var t_pressed: [u8; 8] = "Pressed "
    var t_focus: [u8; 6] = "Focus "
    var t_disabled: [u8; 8] = "Disabled"
    var y: f64 = spl
    var x: f64 = spl
    let bw: f64 = 128.0

    // Normal
    painter.round_rect(&z, x, y, bw, ch, r_button,
        theme.surface_for(&m, style.STATE_NORMAL))
    let by1: f64 = painter.text_baseline_mid(&z, y, ch, size)
    let e1: f64 = painter.text(&z, x, by1, bw, size,
        theme.text_for(&m, style.STATE_NORMAL), (&t_norm[0]) as u64, 6,
        painter.TEXT_M)
    x = x + bw + gap
    // Hover
    painter.round_rect(&z, x, y, bw, ch, r_button,
        theme.surface_for(&m, style.STATE_HOVER))
    let e2: f64 = painter.text(&z, x, by1, bw, size,
        theme.text_for(&m, style.STATE_HOVER), (&t_hover[0]) as u64, 5,
        painter.TEXT_M)
    x = x + bw + gap
    // Pressed
    painter.round_rect(&z, x, y, bw, ch, r_button,
        theme.surface_for(&m, style.STATE_ACTIVE))
    let e3: f64 = painter.text(&z, x, by1, bw, size,
        theme.text_for(&m, style.STATE_ACTIVE), (&t_pressed[0]) as u64, 8,
        painter.TEXT_M)
    x = x + bw + gap
    // Focused -- surface as in normal, plus the RING
    painter.round_rect(&z, x, y, bw, ch, r_button,
        theme.surface_for(&m, style.STATE_FOCUS))
    let e4: f64 = painter.text(&z, x, by1, bw, size,
        theme.text_for(&m, style.STATE_FOCUS), (&t_focus[0]) as u64, 5,
        painter.TEXT_M)
    painter.round_ring(&z, x, y, bw, ch, r_button, focus_w, (*f).accent)
    x = x + bw + gap
    // Disabled
    painter.round_rect(&z, x, y, bw, ch, r_button,
        theme.surface_for(&m, style.STATE_DISABLED))
    let e5: f64 = painter.text(&z, x, by1, bw, size,
        theme.text_for(&m, style.STATE_DISABLED), (&t_disabled[0]) as u64, 8,
        painter.TEXT_M)

    // =================================== ROW 2: THE TEXT FIELDS
    y = y + ch + spm
    x = spl
    let fw: f64 = 300.0
    // DIE ADRESSE STEHT VOLLSTAENDIG IN DER QUELLE. Ob sie ganz ins
    // Feld passt, entscheidet die GEMESSENE Breite und nicht das
    // Augenmass dessen, der die Zeichenkette hinschreibt: passt sie
    // nicht, kuerzt `run_draw_ellipsis` sie sichtbar mit drei Punkten
    // -- das ist der Unterschied zwischen "der Rest steht anderswo"
    // und "hier hoert ein Textfeld mitten im Wort auf".
    var t_url: [u8; 34] = "https://en.wikipedia.org/wiki/Firn"
    let url_n: usize = 34
    let inner: f64 = fw - 2.0 * padx
    var r0: painter.TextRun = painter.run_new(size)
    var gekuerzt: bool = false
    let view: usize = painter.run_fits_ellipsis(&z, &r0,
        (&t_url[0]) as u64, url_n, inner, &gekuerzt)
    // Was am Ende WIRKLICH im Feld steht: der sichtbare Teil, und bei
    // gekuerztem Text die drei Punkte dahinter.
    var painted: f64 = painter.run_width(&z, &r0, (&t_url[0]) as u64,
        view)
    if gekuerzt {
        painted = painted + painter.ellipsis_w(&z, &r0)
    }
    var wrong: usize = 0
    var q1: [u8; 26] = "Adresse passt in ihr Feld "
    wrong = wrong + request((&q1[0]) as u64, 26,
        (inner as i64) - (painted as i64), 0)
    var q2: [u8; 26] = "Adresse bleibt erkennbar  "
    wrong = wrong + request((&q2[0]) as u64, 26, view as i64, 16)

    // Field at rest
    painter.round_rect(&z, x, y, fw, ch, r_field, (*f).field)
    painter.round_ring(&z, x, y, fw, ch, r_field, px, (*f).border_col)
    let by2: f64 = painter.text_baseline_mid(&z, y, ch, size)
    let te: f64 = painter.run_draw_ellipsis(&z, &r0, x + padx, by2,
        inner, (*f).text, (&t_url[0]) as u64, url_n, painter.TEXT_L)

    // Field with focus, selection and caret -- this is the case Justin
    // does NOT have today: selected text with a visible selection colour.
    x = x + fw + spm
    painter.round_rect(&z, x, y, fw, ch, r_field, (*f).field_focus)
    // The selection bar LIES UNDERNEATH the text.
    let tx: f64 = x + padx
    let ah: f64 = size * 1.3
    let ay: f64 = by2 - painter.font_ascent(&z, size) - 1.0
    // Der Auswahlbalken ist so breit wie das, was wirklich im Feld
    // steht -- bei gekuerztem Text samt der drei Punkte und keinen
    // Punkt breiter, sonst liefe die Auswahl ueber den gerundeten
    // Rand des Feldes hinaus.
    painter.surface(&z, tx, ay, painted, ah, (*f).selection)
    let te2: f64 = painter.run_draw_ellipsis(&z, &r0, tx, by2, inner,
        (*f).selection_text, (&t_url[0]) as u64, url_n, painter.TEXT_L)
    painter.caret_bar(&z, te2, ay, ah, px, (*f).text)
    painter.round_ring(&z, x, y, fw, ch, r_field, focus_w, (*f).accent)

    // ================== ROW 3: THE SHAPE IS A BRAND, NOT CODE
    // The same five buttons with `shape_classic`. If they look the
    // same, someone wrote his numbers in instead of fetching them.
    y = y + ch + spl
    var fk: theme.Shape = theme.shape_classic()
    theme.theme_set_shape(&m, &fk)
    let fo2: *mut theme.Shape = theme.theme_shape(&m)
    let ch2: f64 = theme.theme_px(&m, (*fo2).ctrl_h) as f64
    let rk2: f64 = theme.theme_px(&m, (*fo2).r_button) as f64
    let gap2: f64 = theme.theme_px(&m, (*fo2).gap) as f64
    x = spl
    var i: usize = 0
    while i < 5 {
        var zu: u32 = style.STATE_NORMAL
        if i == 1 { zu = style.STATE_HOVER }
        if i == 2 { zu = style.STATE_ACTIVE }
        if i == 3 { zu = style.STATE_FOCUS }
        if i == 4 { zu = style.STATE_DISABLED }
        painter.round_rect(&z, x, y, bw, ch2, rk2, theme.surface_for(&m, zu))
        let byk: f64 = painter.text_baseline_mid(&z, y, ch2, size)
        let ek: f64 = painter.text(&z, x, byk, bw, size,
            theme.text_for(&m, zu), (&t_norm[0]) as u64, 6,
            painter.TEXT_M)
        if i == 3 {
            painter.round_ring(&z, x, y, bw, ch2, rk2,
                theme.theme_px(&m, (*fo2).focus_w) as f64, (*f).accent)
        }
        x = x + bw + gap2
        i = i + 1
    }

    // ===================== ROW 4: THE SCALING (150 %)
    // Justin's screen is 3440x1440. A widget that does not scale with
    // it is exactly the bug from the header of lib/fenster/fenster.fi.
    y = y + ch2 + spl
    var fosum: theme.Shape = theme.shape_osum()
    theme.theme_set_shape(&m, &fosum)
    theme.theme_set_scale(&m, 1500)
    let fo3: *mut theme.Shape = theme.theme_shape(&m)
    let ch3: f64 = theme.theme_px(&m, (*fo3).ctrl_h) as f64
    let rk3: f64 = theme.theme_px(&m, (*fo3).r_button) as f64
    let size3: f64 = theme.theme_px(&m, (*fo3).font) as f64
    let bw3: f64 = 192.0
    x = spl
    var j: usize = 0
    while j < 3 {
        var zu3: u32 = style.STATE_NORMAL
        if j == 1 { zu3 = style.STATE_HOVER }
        if j == 2 { zu3 = style.STATE_ACTIVE }
        painter.round_rect(&z, x, y, bw3, ch3, rk3,
            theme.surface_for(&m, zu3))
        let by3: f64 = painter.text_baseline_mid(&z, y, ch3, size3)
        let e3b: f64 = painter.text(&z, x, by3, bw3, size3,
            theme.text_for(&m, zu3), (&t_norm[0]) as u64, 6,
            painter.TEXT_M)
        x = x + bw3 + theme.theme_px(&m, (*fo3).gap) as f64
        j = j + 1
    }

    // ---- WRITING IT OUT
    //
    // Erst aber die Forderungen aus Zeile 2: ein Bild, dessen Adresse
    // aus ihrem Feld laeuft, wird gar nicht erst geschrieben.
    if wrong > 0 {
        return 8
    }
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&cv, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < rt.c_length(path) {
        rt.buf_push(&pf, rt.ld8(path, k))
        k = k + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 10] = "PNG OK\n\0\0\0"
    rt.write_everything(1, (&okm[0]) as u64, 7)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    return 0
}
