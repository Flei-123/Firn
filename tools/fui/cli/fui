#!/usr/bin/env bash
# SPDX-License-Identifier: MPL-2.0
set -uo pipefail
FUI_CLI=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
. "$FUI_CLI/lib/env.sh"
. "$FUI_CLI/lib/log.sh"
verb=${1:-help}
[ $# -eq 0 ] || shift
case "$verb" in
    -h|--help) verb=help ;;
esac
[ -f "$FUI_CLI/verbs/$verb.sh" ] || fui_die 2 "unknown command '$verb' (try: fui help)"
. "$FUI_CLI/verbs/$verb.sh"
"verb_$verb" "$@"
