import fui.app
import fui.appshot
import fui.kitdata

static mut COUNTER: usize = 0

fn bump(a: *mut app.App) {
    app.set_number(a, COUNTER, app.number(a, COUNTER) + 1)
}

fn greeting() -> str {
    let d: *mut kitdata.Doc = kitdata.load("greeting.json")
    return kitdata.text(d, kitdata.get(d, kitdata.root(d), "text"))
}

fn main(start: u64) -> i32 {
    let a: *mut app.App = app.window("@NAME@", 480, 320)
    app.label(a, greeting(), 20)
    COUNTER = app.label(a, "0", 32)
    app.button(a, "Count", bump)
    return appshot.finish(a, start, 480, 320)
}
