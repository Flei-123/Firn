import std.rt
import font.metrics
import paint.canvas
import fui.painter
import plat.sysfont

static mut BAD: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn ink_bounds(cv: *mut canvas.Canvas, w: usize, h: usize, x0: *mut usize, x1: *mut usize) -> bool {
    var lo: usize = w
    var hi: usize = 0
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            if canvas.canvas_get(cv, x, y) != 0xFFFFFFFF as u32 {
                if x < lo {
                    lo = x
                }
                if x > hi {
                    hi = x
                }
            }
            x = x + 1
        }
        y = y + 1
    }
    *x0 = lo
    *x1 = hi
    return hi >= lo
}

fn draw_aligned(z: *mut painter.Painter, cv: *mut canvas.Canvas, align: u32, lo: *mut usize, hi: *mut usize) -> bool {
    canvas.canvas_clear(cv, 0xFFFFFFFF as u32)
    let s: str = "Hello"
    let base: f64 = painter.text_baseline_mid(z, 0.0, 40.0, 16.0)
    painter.text(z, 20.0, base, 160.0, 16.0, 0xFF000000 as u32, s.p as u64, s.n, align)
    return ink_bounds(cv, 200, 40, lo, hi)
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("painter_textapi: no font (DejaVu Sans)\n")
        return 9
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    var z: painter.Painter = painter.painter_new()
    check(canvas.canvas_init(&cv, 200, 40) && painter.painter_init(&z, &cv, 200, 40), "init")
    painter.painter_set_font(&z, fs as u64)
    let s: str = "Hello"
    let w: f64 = painter.text_width(&z, s.p as u64, s.n, 16.0)
    check(w > 20.0 && w < 80.0, "text_width of Hello at 16px is plausible")
    let all: usize = painter.text_fits_upto(&z, s.p as u64, s.n, 16.0, 1000.0)
    check(all == s.n, "text_fits_upto with room keeps every byte")
    let some: usize = painter.text_fits_upto(&z, s.p as u64, s.n, 16.0, w / 2.0)
    check(some > 0 && some < s.n, "text_fits_upto with half room cuts on a boundary")
    check(painter.text_fits_upto(&z, s.p as u64, s.n, 16.0, 0.0) == 0, "no room keeps nothing")
    check(painter.TEXT_L == 0 as u32 && painter.TEXT_M == 1 as u32 && painter.TEXT_R == 2 as u32, "alignment constants")
    var l0: usize = 0
    var l1: usize = 0
    var m0: usize = 0
    var m1: usize = 0
    var r0: usize = 0
    var r1: usize = 0
    check(draw_aligned(&z, &cv, painter.TEXT_L, &l0, &l1), "TEXT_L paints ink")
    check(draw_aligned(&z, &cv, painter.TEXT_M, &m0, &m1), "TEXT_M paints ink")
    check(draw_aligned(&z, &cv, painter.TEXT_R, &r0, &r1), "TEXT_R paints ink")
    check(l0 >= 19 && l0 <= 24, "left aligned ink starts at the rect edge")
    check(r1 >= 176 && r1 <= 181, "right aligned ink ends at the rect edge")
    check(m0 > l0 && m1 < r1, "centred ink lies between the two")
    let end: f64 = painter.text(&z, 20.0, 25.0, 160.0, 16.0, 0xFF000000 as u32, s.p as u64, s.n, painter.TEXT_L)
    check(end > 20.0 + w - 1.0 && end < 20.0 + w + 1.0, "text returns the end position")
    check(painter.font_ascent(&z, 16.0) > 0.0 && painter.font_descent(&z, 16.0) > 0.0, "font metrics")
    painter.painter_free(&z)
    if BAD != 0 {
        say("painter_textapi: FAIL\n")
        return 1
    }
    say("painter_textapi: all ok\n")
    return 0
}
