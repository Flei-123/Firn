// tools/fui/appw8m_main.fi -- wave 8m controls in the ten-line API: accordion (r335), toolbar overflow.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.wave8m
import fui.inspect
import fui.safeout
import fui.sheet
import fui.anim
import fui.style
import fui.a11y
import fui.render

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn num(tag: str, v: f64) {
    say(tag)
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v as i64)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

#[allow_escape]
fn dlen(a: *mut app.App, node: usize) -> usize {
    var db: [u8; 192] = [0 as u8; 192]
    let n: usize = a11y.a11y_description(app.app_scene(a), app.ax(a), node, (&db[0]) as u64, 192)
    return n
}

fn click(w: *mut fuiwirt.Host, x: f64, y: f64) {
    let m: u32 = fuiwirt.host_pointer_move(w, x, y)
    let d: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let u: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

fn pressed(a: *mut app.App) {
    CHANGES = CHANGES + 1
}

fn has(buf: u64, n: usize, what: str) -> bool {
    if what.n > n {
        return false
    }
    var i: usize = 0
    while i + what.n <= n {
        var j: usize = 0
        while j < what.n && *((buf + (i + j) as u64) as *mut u8) == *((what.p as u64 + j as u64) as *mut u8) {
            j = j + 1
        }
        if j == what.n {
            return true
        }
        i = i + 1
    }
    return false
}

fn act(a: *mut app.App) {
    let i: usize = fuiwirt.host_take_activated(app.app_host(a))
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
}

fn centre(a: *mut app.App, sc: *mut scene.Scene, n: usize) {
    let w: *mut fuiwirt.Host = app.app_host(a)
    click(w, scene.node_x(sc, n) + scene.node_w(sc, n) / 2.0, scene.node_y(sc, n) + scene.node_h(sc, n) / 2.0)
    act(a)
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appw8m: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Wave8m", 480, 520)
    let acc: usize = appctl.accordion(a, "FAQ", true, changed)
    let s0: usize = appctl.accordion_section(a, acc, "General", true)
    let l0: usize = app.label(a, "General text", 0)
    app.end(a)
    let s1: usize = appctl.accordion_section(a, acc, "Advanced", false)
    let l1: usize = app.label(a, "Advanced text", 0)
    app.end(a)
    let s2: usize = appctl.accordion_section(a, acc, "About", false)
    let l2: usize = app.label(a, "About text", 0)
    app.end(a)
    app.end(a)
    let free: usize = appctl.accordion(a, "Free", false, changed)
    let f0: usize = appctl.accordion_section(a, free, "One", false)
    let m0: usize = app.label(a, "one", 0)
    app.end(a)
    let f1: usize = appctl.accordion_section(a, free, "Two", false)
    let m1: usize = app.label(a, "two", 0)
    app.end(a)
    app.end(a)
    let s: *mut Surface = surface_for(a, 480, 520)
    fuiwirt.host_bind(app.app_host(a))
    settle(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    let w: *mut fuiwirt.Host = app.app_host(a)
    check(acc != appctl.NONE && s0 != appctl.NONE && s1 != appctl.NONE && s2 != appctl.NONE && free != appctl.NONE, "accordions and sections exist")
    check(appctl.accordion_sections(a, acc) == 3 && appctl.accordion_sections(a, free) == 2, "3 + 2 sections")
    check(appctl.accordion_is_open(a, acc, 0) && !appctl.accordion_is_open(a, acc, 1) && appctl.expanded(a, s0) && !appctl.expanded(a, s1), "the first section starts open")
    check((a11y.a11y_state(sc, app.ax(a), s0) & a11y.ST_EXPANDED) != 0 as u32 && (a11y.a11y_state(sc, app.ax(a), s1) & a11y.ST_COLLAPSED) != 0 as u32, "a11y: the open header is expanded, the closed one collapsed")
    let h_closed: f64 = scene.node_y(sc, s2) - scene.node_y(sc, s1)
    check(scene.node_y(sc, s1) - scene.node_y(sc, s0) > h_closed + 10.0, "the open section's body takes room, the closed one's does not")
    // ---- exclusive: open another, the first closes
    let b0: usize = CHANGES
    centre(a, sc, s1)
    settle(a, s)
    check(appctl.accordion_is_open(a, acc, 1) && !appctl.accordion_is_open(a, acc, 0) && appctl.expanded(a, s1) && !appctl.expanded(a, s0), "click: Advanced opens, General closes (exclusive)")
    check(CHANGES == b0 + 1 && appctl.accordion_open_count(a, acc) == 1, "one callback, one open section")
    centre(a, sc, s1)
    settle(a, s)
    check(appctl.accordion_open_count(a, acc) == 0 && !appctl.expanded(a, s1), "a second click closes it: none open")
    // ---- keys: Up/Down/Home/End move the header focus; Enter toggles
    app.set_focus(a, s0)
    let k1: bool = app.app_key(a as u64, editor.KEY_DOWN, 0 as u32)
    check(app.focus(a) == s1, "Down: focus on the next header")
    let k2: bool = app.app_key(a as u64, editor.KEY_END, 0 as u32)
    check(app.focus(a) == s2, "End: last header")
    let k3: bool = app.app_key(a as u64, editor.KEY_UP, 0 as u32)
    check(app.focus(a) == s1, "Up: previous header")
    let k4: bool = app.app_key(a as u64, editor.KEY_HOME, 0 as u32)
    check(app.focus(a) == s0, "Home: first header")
    let k5: bool = app.app_key(a as u64, editor.KEY_UP, 0 as u32)
    check(app.focus(a) == s0, "Up at the first header stays (no wrap)")
    let b1: usize = CHANGES
    let k6: bool = app.app_key(a as u64, editor.KEY_ENTER, 0 as u32)
    if !k6 {
        let hk: u32 = fuiwirt.host_key(w, fuiwirt.KEY_RETURN, 0 as u32)
    }
    act(a)
    settle(a, s)
    check(appctl.expanded(a, s0) && appctl.accordion_is_open(a, acc, 0) && CHANGES == b1 + 1, "Enter opens the focused section (model follows)")
    // ---- program side: no callback, exclusive still applies
    let b2: usize = CHANGES
    appctl.accordion_set(a, acc, 2, true)
    settle(a, s)
    check(appctl.accordion_is_open(a, acc, 2) && !appctl.accordion_is_open(a, acc, 0) && !appctl.expanded(a, s0) && appctl.expanded(a, s2) && CHANGES == b2, "accordion_set: exclusive, no callback")
    // ---- free group: both can be open
    centre(a, sc, f0)
    settle(a, s)
    centre(a, sc, f1)
    settle(a, s)
    check(appctl.accordion_open_count(a, free) == 2 && appctl.expanded(a, f0) && appctl.expanded(a, f1), "free group: two open at once")
    centre(a, sc, f0)
    settle(a, s)
    check(appctl.accordion_open_count(a, free) == 1 && !appctl.expanded(a, f0) && appctl.expanded(a, f1), "free group: closing one leaves the other")
    // ---- a plain expander is no accordion member; bad ids are harmless
    check(appctl.accordion_section(a, 9999, "x", false) == appctl.NONE && !appctl.accordion_is_open(a, 9999, 0) && appctl.accordion_sections(a, s0) == 0, "wrong ids are harmless")
    appctl.accordion_set(a, acc, 99, true)
    check(appctl.accordion_open_count(a, acc) == 1, "a section index out of range changes nothing")
    if BAD == 0 {
        say("APPW8M PASSED\n")
        return 0
    }
    say("APPW8M FAILED\n")
    return 1
}
