// SPDX-License-Identifier: MPL-2.0
// tools/fui/appw13_main.fi -- flyout / teaching tip (appctl.flyout, teaching_tip) and the wave 12 additions (date limits, nested nav items, wheel)
// in the ten-line API: clicks, keys, light dismiss, shield, a11y, pictures.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.wave12
import fui.wave13
import fui.lucide
import fui.anim
import fui.style
import fui.a11y
import fui.render
import fui.safeout

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

static mut FLY_CLOSED: usize = 0
static mut TIP_CLOSED: usize = 0
static mut INFO_CLICKS: usize = 0
static mut HELP_CLICKS: usize = 0

fn fly_closed(a: *mut app.App, id: usize) {
    FLY_CLOSED = FLY_CLOSED + 1
}

fn tip_closed(a: *mut app.App, id: usize) {
    TIP_CLOSED = TIP_CLOSED + 1
}

fn on_info(a: *mut app.App) {
    INFO_CLICKS = INFO_CLICKS + 1
}

fn on_help(a: *mut app.App) {
    HELP_CLICKS = HELP_CLICKS + 1
}

#[allow_escape]
fn name_is(a: *mut app.App, node: usize, want: str) -> bool {
    var nb: [u8; 64] = [0 as u8; 64]
    let n: usize = a11y.a11y_name(app.app_scene(a), app.ax(a), node, (&nb[0]) as u64, 64)
    if n != want.n { return false }
    var k: usize = 0
    while k < n {
        if nb[k] != *((want.p as u64 + k as u64) as *mut u8) { return false }
        k = k + 1
    }
    return true
}

fn mid(r: *mut [f64; 4], ix: usize) -> f64 {
    return (*r)[ix] + (*r)[ix + 2] / 2.0
}

fn wheel(w: *mut fuiwirt.Host, x: f64, y: f64, down: bool) {
    let m: u32 = fuiwirt.host_pointer_move(w, x, y)
    if down {
        let d: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_WHEEL_DOWN)
    } else {
        let d2: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_WHEEL_UP)
    }
}

fn num(tag: str, v: f64) {
    say(tag)
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v as i64)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

#[allow_escape]
fn dlen(a: *mut app.App, node: usize) -> usize {
    var db: [u8; 192] = [0 as u8; 192]
    let n: usize = a11y.a11y_description(app.app_scene(a), app.ax(a), node, (&db[0]) as u64, 192)
    return n
}

static mut APP: u64 = 0
static mut PUMP: bool = true

fn click(w: *mut fuiwirt.Host, x: f64, y: f64) {
    let m: u32 = fuiwirt.host_pointer_move(w, x, y)
    let d: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let u: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
    let i: usize = fuiwirt.host_take_activated(w)
    if PUMP && i != fuiwirt.KEINER {
        app.app_act(APP, i)
    }
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appw13: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Wave13", 700, 1100)
    let bh: usize = app.button(a, "Help", on_help)
    let bi: usize = app.button(a, "Info", on_info)
    let fl: usize = appctl.flyout(a, "Details", fly_closed)
    let tp: usize = appctl.teaching_tip(a, "Tip", tip_closed)
    let dp: usize = appctl.datepicker(a, "Trip", 2026, 10, 18, true, changed)
    let nv: usize = appctl.navview(a, "Sections", 240, changed)
    let tr: usize = appctl.tree(a, "Files", 240, 160, changed)
    let s: *mut Surface = surface_for(a, 700, 1100)
    APP = a as u64
    fuiwirt.host_bind(app.app_host(a))
    appctl.flyout_anchor(a, fl, bi)
    appctl.flyout_text(a, fl, "", "Saved to the cloud. You can change this later in the settings.")
    let fa: bool = appctl.flyout_action(a, fl, "Later") && appctl.flyout_action(a, fl, "OK")
    appctl.flyout_anchor(a, tp, bh)
    appctl.flyout_side(a, tp, wave13.FL_TOP)
    appctl.flyout_text(a, tp, "Quick tip", "Drag the handle to resize the panel.")
    let ta: bool = appctl.flyout_action(a, tp, "Got it")
    var added: bool = appctl.navview_add_at(a, nv, 0, lucide.HOUSE, "Home", 0)
    && appctl.navview_add_at(a, nv, 0, lucide.FOLDER, "Files", 0)
    && appctl.navview_add_at(a, nv, 1, lucide.FOLDER, "Docs", 0)
    && appctl.navview_add_at(a, nv, 1, lucide.IMAGE, "Pics", 0)
    && appctl.navview_add_at(a, nv, 2, lucide.IMAGE, "Raw", 0)
    && appctl.navview_add_at(a, nv, 0, lucide.STAR, "Starred", 0)
    var ti: usize = 0
    var tok: bool = true
    while ti < 14 {
        if !appctl.tree_add(a, tr, 0, "Row", false) { tok = false }
        ti = ti + 1
    }
    settle(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    let w: *mut fuiwirt.Host = app.app_host(a)
    let ax: *mut a11y.A11y = app.ax(a)
    check(bi != appctl.NONE && bh != appctl.NONE && fl != appctl.NONE && tp != appctl.NONE && fa && ta && tok, "flyout, tip and the page controls exist")
    check(added && !appctl.navview_add_at(a, nv, 5, lucide.HOUSE, "Too deep", 0), "navview_add_at: 3 levels, a bad depth is refused")
    // ---- closed: nothing to see, nothing listed
    check(!appctl.flyout_is_open(a, fl) && !appctl.flyout_is_open(a, tp) && scene.node_hidden(sc, fl), "closed: the marker is hidden")
    check(a11y.a11y_role(sc, ax, fl) != a11y.ROLE_DIALOG && appctl.flyout_dir(a, fl) == wave13.D_NONE, "closed: no dialog role, no geometry")
    var r: [f64; 4] = [0.0; 4]
    var ar: [f64; 4] = [0.0; 4]
    check(!appctl.flyout_rect(a, fl, &r), "closed: no panel rectangle")
    // ---- open the flyout
    check(appctl.flyout_open(a, fl) && appctl.flyout_is_open(a, fl), "flyout_open")
    settle(a, s)
    check(appctl.flyout_rect(a, fl, &r), "open: panel rectangle")
    ar[0] = scene.node_x(sc, bi)
    ar[1] = scene.node_y(sc, bi)
    ar[2] = scene.node_w(sc, bi)
    ar[3] = scene.node_h(sc, bi)
    check(appctl.flyout_dir(a, fl) == wave13.D_BOTTOM && r[1] >= ar[1] + ar[3] && near(mid(&r, 0), mid(&ar, 0), 160.0), "the panel hangs below its anchor")
    check(!scene.node_hidden(sc, fl) && a11y.a11y_role(sc, ax, fl) == a11y.ROLE_DIALOG && name_is(a, fl, "Details"), "marker: dialog named Details")
    check(near(scene.node_x(sc, fl), r[0], 0.6) && near(scene.node_y(sc, fl), r[1], 0.6) && near(scene.node_w(sc, fl), r[2], 0.6) && near(scene.node_h(sc, fl), r[3], 0.6), "marker has the rectangle of the panel")
    check(dlen(a, fl) > 20, "description = the text")
    let pc: usize = appctl.flyout_part_node(a, fl, wave13.FL_CLOSE)
    let p0: usize = appctl.flyout_part_node(a, fl, wave13.FL_ACT0)
    let p1: usize = appctl.flyout_part_node(a, fl, wave13.FL_ACT0 + 1)
    let p2: usize = appctl.flyout_part_node(a, fl, wave13.FL_ACT0 + 2)
    check(a11y.a11y_role(sc, ax, p0) == a11y.ROLE_BUTTON && name_is(a, p0, "Later") && name_is(a, p1, "OK"), "action nodes: role button, names")
    check(a11y.a11y_role(sc, ax, p2) != a11y.ROLE_BUTTON && a11y.a11y_role(sc, ax, pc) != a11y.ROLE_BUTTON, "no third action, no close button on a flyout")
    check(appctl.flyout_part_rect(a, fl, wave13.FL_ACT0 + 1, &ar), "action rectangle")
    check(near(scene.node_x(sc, p1), ar[0], 0.6) && near(scene.node_y(sc, p1), ar[1], 0.6) && near(scene.node_w(sc, p1), ar[2], 0.6), "the action node has the true bounds")
    check(appctl.flyout_focus(a, fl) == wave13.FL_ACT0 + 1, "a flyout takes the keyboard: ring on the main action")
    save(&(*s).cv, dir, "wave13-flyout-light.png")
    app.set_dark(a, true)
    settle(a, s)
    save(&(*s).cv, dir, "wave13-flyout-dark.png")
    app.set_dark(a, false)
    settle(a, s)
    // ---- light dismiss: a click outside closes it and the page does not hear it
    check(appctl.flyout_part_rect(a, fl, wave13.FL_BODY, &r), "panel rect")
    let c0: usize = FLY_CLOSED
    click(w, r[0] + 10.0, r[1] + 10.0)
    check(appctl.flyout_is_open(a, fl) && FLY_CLOSED == c0, "a click on the body keeps it open")
    let h0: usize = HELP_CLICKS
    check(appctl.flyout_part_rect(a, tp, wave13.FL_BODY, &ar) == false, "tip closed: no rectangle")
    click(w, 690.0, 750.0)
    settle(a, s)
    check(!appctl.flyout_is_open(a, fl) && FLY_CLOSED == c0 + 1 && appctl.flyout_reason(a, fl) == wave13.RS_OUTSIDE && appctl.flyout_picked(a, fl) == appctl.NONE, "click outside: closed (outside), called back once")
    // the press on the page button closes AND is not delivered to it
    check(appctl.flyout_open(a, fl), "reopen")
    settle(a, s)
    click(w, scene.node_x(sc, bh) + scene.node_w(sc, bh) / 2.0, scene.node_y(sc, bh) + scene.node_h(sc, bh) / 2.0)
    settle(a, s)
    check(!appctl.flyout_is_open(a, fl) && HELP_CLICKS == h0 && FLY_CLOSED == c0 + 2, "the press that closes it is eaten (the Help button did not click)")
    click(w, scene.node_x(sc, bh) + scene.node_w(sc, bh) / 2.0, scene.node_y(sc, bh) + scene.node_h(sc, bh) / 2.0)
    check(HELP_CLICKS == h0 + 1, "after it, the page hears the pointer again")
    // ---- an action by click
    check(appctl.flyout_open(a, fl), "reopen 2")
    settle(a, s)
    check(appctl.flyout_part_rect(a, fl, wave13.FL_ACT0, &r), "action 0 rectangle")
    click(w, mid(&r, 0), mid(&r, 1))
    settle(a, s)
    check(!appctl.flyout_is_open(a, fl) && appctl.flyout_reason(a, fl) == wave13.RS_ACTION && appctl.flyout_picked(a, fl) == 0 && FLY_CLOSED == c0 + 3, "click on Later: action 0")
    check(a11y.a11y_role(sc, ax, fl) != a11y.ROLE_DIALOG && a11y.a11y_role(sc, ax, p0) != a11y.ROLE_BUTTON && scene.node_hidden(sc, p0), "closed again: roles taken back")
    // ---- keys
    check(appctl.flyout_open(a, fl), "reopen 3")
    settle(a, s)
    let k1: bool = app.app_key(a as u64, editor.KEY_TAB, 0 as u32)
    check(k1 && appctl.flyout_focus(a, fl) == wave13.FL_ACT0, "Tab wraps to the first action")
    let k2: bool = app.app_key(a as u64, editor.KEY_RIGHT, 0 as u32)
    check(k2 && appctl.flyout_focus(a, fl) == wave13.FL_ACT0 + 1, "Right: the next action")
    let k3: bool = app.app_key(a as u64, editor.KEY_TAB, 1 as u32)
    check(k3 && appctl.flyout_focus(a, fl) == wave13.FL_ACT0, "Shift+Tab: back")
    let k4: bool = app.app_key(a as u64, editor.KEY_ENTER, 0 as u32)
    check(k4 && !appctl.flyout_is_open(a, fl) && appctl.flyout_picked(a, fl) == 0 && FLY_CLOSED == c0 + 4, "Enter presses the action with the ring")
    check(appctl.flyout_open(a, fl), "reopen 4")
    let k5: bool = app.app_char(a as u64, 32 as u32, 0 as u32)
    check(k5 && !appctl.flyout_is_open(a, fl) && appctl.flyout_picked(a, fl) == 1, "Space presses the main action")
    check(appctl.flyout_open(a, fl), "reopen 5")
    let k6: bool = app.app_key(a as u64, editor.KEY_ESC, 0 as u32)
    check(k6 && !appctl.flyout_is_open(a, fl) && appctl.flyout_reason(a, fl) == wave13.RS_ESC && FLY_CLOSED == c0 + 6, "Esc closes (esc)")
    // ---- the screen reader's default action
    check(appctl.flyout_open(a, fl), "reopen 6")
    settle(a, s)
    app.app_act(a as u64, p1)
    check(!appctl.flyout_is_open(a, fl) && appctl.flyout_picked(a, fl) == 1 && FLY_CLOSED == c0 + 7, "app_act on the action node presses it")
    // ---- closing from the program: no call back; the second flyout does not stack
    check(appctl.flyout_open(a, fl), "reopen 7")
    appctl.flyout_close(a, fl)
    check(!appctl.flyout_is_open(a, fl) && FLY_CLOSED == c0 + 7 && appctl.flyout_reason(a, fl) == wave13.RS_PROGRAM, "flyout_close: no call back")
    // ---- the teaching tip: placed on the other side (flip), page stays live, close button, Esc
    check(appctl.flyout_open(a, tp), "tip open")
    settle(a, s)
    check(appctl.flyout_rect(a, tp, &r) && appctl.flyout_dir(a, tp) == wave13.D_BOTTOM, "tip wanted on top, there is no room: it flipped below")
    check(appctl.flyout_focus(a, tp) == wave13.FL_NONE, "a tip does not take the keyboard")
    let pt: usize = appctl.flyout_part_node(a, tp, wave13.FL_CLOSE)
    check(a11y.a11y_role(sc, ax, pt) == a11y.ROLE_BUTTON && name_is(a, pt, "Close") && a11y.a11y_role(sc, ax, tp) == a11y.ROLE_DIALOG, "tip: close button node, dialog")
    save(&(*s).cv, dir, "wave13-tip-light.png")
    app.set_dark(a, true)
    settle(a, s)
    save(&(*s).cv, dir, "wave13-tip-dark.png")
    app.set_dark(a, false)
    settle(a, s)
    let i0: usize = HELP_CLICKS
    click(w, scene.node_x(sc, bh) + scene.node_w(sc, bh) / 2.0, scene.node_y(sc, bh) + scene.node_h(sc, bh) / 2.0)
    check(appctl.flyout_is_open(a, tp) && HELP_CLICKS == i0 + 1 && TIP_CLOSED == 0, "the page stays live: Help clicks, the tip stays")
    let k7: bool = app.app_key(a as u64, editor.KEY_TAB, 0 as u32)
    check(!k7 || !appctl.flyout_is_open(a, tp), "Tab is not taken before the keyboard is in")
    appctl.flyout_enter(a, tp)
    check(appctl.flyout_focus(a, tp) == wave13.FL_ACT0, "flyout_enter: ring on the main action")
    let k8: bool = app.app_key(a as u64, editor.KEY_LEFT, 0 as u32)
    check(k8 && appctl.flyout_focus(a, tp) == wave13.FL_CLOSE, "Left: the close button")
    let k9: bool = app.app_key(a as u64, editor.KEY_ENTER, 0 as u32)
    check(k9 && !appctl.flyout_is_open(a, tp) && appctl.flyout_reason(a, tp) == wave13.RS_CLOSE && TIP_CLOSED == 1, "Enter on the close button")
    check(appctl.flyout_open(a, tp), "tip reopen")
    settle(a, s)
    check(appctl.flyout_part_rect(a, tp, wave13.FL_CLOSE, &r), "close button rectangle")
    click(w, mid(&r, 0), mid(&r, 1))
    check(!appctl.flyout_is_open(a, tp) && appctl.flyout_reason(a, tp) == wave13.RS_CLOSE && TIP_CLOSED == 2, "a click on the close button")
    check(appctl.flyout_open(a, tp), "tip reopen 2")
    let k10: bool = app.app_key(a as u64, editor.KEY_ESC, 0 as u32)
    check(k10 && !appctl.flyout_is_open(a, tp) && appctl.flyout_reason(a, tp) == wave13.RS_ESC, "Esc closes the tip")
    check(!appctl.flyout_open(a, 9999) && appctl.flyout_picked(a, bi) == appctl.NONE, "wrong ids are harmless")
    // ---- the wave 12 additions: wheel, limits (clicks on these nodes work through the hook; no activation pump)
    PUMP = false
    settle(a, s)
    check(appctl.datepicker_month(a, dp) == 202610, "calendar shows October")
    let dw: f64 = scene.node_x(sc, dp) + scene.node_w(sc, dp) / 2.0
    let dh: f64 = scene.node_y(sc, dp) + scene.node_h(sc, dp) / 2.0
    wheel(w, dw, dh, true)
    check(appctl.datepicker_month(a, dp) == 202611, "wheel down: the next month")
    wheel(w, dw, dh, false)
    wheel(w, dw, dh, false)
    check(appctl.datepicker_month(a, dp) == 202609, "wheel up twice: September")
    check(appctl.datepicker_limits(a, dp, 20261005, 20261020) && appctl.datepicker_month(a, dp) == 202610, "datepicker_limits: the month is pulled into the range")
    wheel(w, dw, dh, true)
    check(appctl.datepicker_month(a, dp) == 202610, "wheel: no month past the limits")
    settle(a, s)
    check(appctl.datepicker_day_rect(a, dp, 25, &r), "day rect 25")
    let cc: usize = CHANGES
    click(w, mid(&r, 0), mid(&r, 1))
    check(appctl.datepicker_start(a, dp) == 0 && CHANGES == cc, "a click on a locked day chooses nothing")
    check(appctl.datepicker_day_rect(a, dp, 12, &r), "day rect 12")
    click(w, mid(&r, 0), mid(&r, 1))
    check(appctl.datepicker_start(a, dp) == 20261012 && CHANGES == cc + 1, "an allowed day is chosen")
    check(appctl.datepicker_arrow_rect(a, dp, wave12.CAL_NEXT, &r), "arrow rect")
    click(w, mid(&r, 0), mid(&r, 1))
    check(appctl.datepicker_month(a, dp) == 202610, "the next arrow stops at the limit")
    check(appctl.datepicker_limits(a, dp, 0, 0) && !appctl.datepicker_limits(a, tr, 0, 0), "limits off; only for calendars")
    // nested navigation items
    check(appctl.navview_selected(a, nv) == 0, "nav: Home selected")
    check(!appctl.navview_item_rect(a, nv, 2, &r), "nav: Docs hidden while Files is closed")
    app.set_focus(a, nv)
    let n1: bool = app.app_key(a as u64, editor.KEY_DOWN, 0 as u32)
    let n2: bool = app.app_key(a as u64, editor.KEY_RIGHT, 0 as u32)
    settle(a, s)
    check(n1 && n2 && appctl.navview_selected(a, nv) == 1 && appctl.navview_item_rect(a, nv, 2, &r), "Down to Files, Right opens it: Docs is listed")
    let c3: usize = CHANGES
    click(w, mid(&r, 0), mid(&r, 1))
    check(appctl.navview_selected(a, nv) == 2 && CHANGES > c3, "a click on the sub item selects it")
    // tree wheel
    check(appctl.tree_item_rect(a, tr, 0, &r), "tree: first row visible")
    let tx: f64 = scene.node_x(sc, tr) + scene.node_w(sc, tr) / 2.0
    let ty: f64 = scene.node_y(sc, tr) + scene.node_h(sc, tr) / 2.0
    wheel(w, tx, ty, true)
    check(!appctl.tree_item_rect(a, tr, 0, &r) && !appctl.tree_item_rect(a, tr, 2, &r) && appctl.tree_item_rect(a, tr, 3, &r), "tree wheel: three rows per notch")
    wheel(w, tx, ty, false)
    check(appctl.tree_item_rect(a, tr, 0, &r), "wheel back up")
    // ---- both panels together (the pictures are the four single ones above)
    appctl.flyout_anchor(a, fl, bh)
    appctl.flyout_side(a, fl, wave13.FL_END)
    check(appctl.flyout_open(a, tp) && appctl.flyout_open(a, fl), "both open")
    settle(a, s)
    check(appctl.flyout_is_open(a, tp) && appctl.flyout_is_open(a, fl), "a tip and a flyout can stand together")
    if BAD == 0 {
        say("APPW13 PASSED\n")
        return 0
    }
    say("APPW13 FAILED\n")
    return 1
}
