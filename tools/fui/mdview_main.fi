// SPDX-License-Identifier: MPL-2.0
// tools/fui/mdview_main.fi -- THE CHECK OF lib/fui/markdownview.fi.
//
// A Markdown document is laid out and painted into a canvas with the real
// font and the real theme, the pixels are read back and compared with what the
// theme says they must be -- in light and dark, wide and narrow. Without a
// window:
//
//     firnc -o /tmp/mdview tools/fui/mdview_main.fi && /tmp/mdview [dir]
//
// With a directory the pictures mdview-dark.png / -light.png / -narrow.png
// are written there. The last line is MDVIEW PASSED or MDVIEW FAILED.
import std.rt
import std.vec
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.style
import fui.viewport
import fui.markdownview
import fui.kitcolor
import markdown.doc
import plat.sysfont

static mut BAD: usize = 0
static mut CLICKED: usize = 0
static mut CLICK_LEN: usize = 0
static mut CLICK_BUF: [u8; 64] = [0 as u8; 64]
static mut PICS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = rt.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64,
            mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
    w: usize,
    h: usize,
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    theme.theme_set_accent(&(*p).m, 0x1BD96A as u32)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    (*p).w = w
    (*p).h = h
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn tok(p: *mut Page, t: u32) -> u32 {
    return theme.opaque(render.color_of(&(*p).c, style.color_token(t)))
}

fn px(p: *mut Page, x: f64, y: f64) -> u32 {
    return canvas.canvas_get(&(*p).cv, x as usize, y as usize)
}

fn clear(p: *mut Page) {
    canvas.canvas_clear(&(*p).cv, tok(p, style.TOK_BASE))
}

// how many pixels of the box have exactly this colour
fn count_col(p: *mut Page, x0: f64, y0: f64, x1: f64, y1: f64, col: u32) -> usize {
    var n: usize = 0
    var y: f64 = y0
    while y < y1 {
        var x: f64 = x0
        while x < x1 {
            if px(p, x, y) == col {
                n = n + 1
            }
            x = x + 1.0
        }
        y = y + 1.0
    }
    return n
}

fn on_link(ud: u64, url: u64, n: usize) {
    CLICKED = CLICKED + 1
    CLICK_LEN = n
    if n > 64 {
        CLICK_LEN = 64
    }
    var i: usize = 0
    while i < CLICK_LEN {
        CLICK_BUF[i] = rt.ld8(url, i)
        i = i + 1
    }
}

fn url_is(s: str) -> bool {
    if CLICK_LEN != s.n {
        return false
    }
    var i: usize = 0
    while i < s.n {
        if CLICK_BUF[i] != rt.ld8(s.p as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// a picture of 40 x 20 red pixels: RGBA bytes FF 00 00 FF = the u32 0xFF0000FF (little endian)
static mut PIC: [u32; 800] = [0 as u32; 800]

fn on_image(ud: u64, url: u64, n: usize, info: *mut markdownview.ImgInfo) -> u32 {
    // "ready.png" (9 bytes) is there, "late.png" is not yet, "bad.png" failed
    if n == 9 {
        var i: usize = 0
        while i < 800 {
            PIC[i] = 0xFF0000FF as u32
            i = i + 1
        }
        (*info).px = (&PIC[0]) as u64
        (*info).w = 40
        (*info).h = 20
        (*info).stride = 160
        return markdownview.IMG_READY
    }
    if n == 7 {
        return markdownview.IMG_FAILED
    }
    return markdownview.IMG_PENDING
}

const DOC: str = "# Launcher notes\n\nA paragraph with **bold**, *italic*, ~~gone~~ and `inline code` plus a [link to Modrinth](https://modrinth.com/mod/x \"Modrinth\") that goes on for a while so that it wraps in a narrow view.\n\n## Features\n\n- first item\n- second item with a longer text that will certainly wrap around in the narrow view\n  - nested one\n- [x] task done\n- [ ] task open\n\n1. one\n2. two\n\n> quoted text\n\n```\nfn main() {}\n```\n\n| Name | Count |\n|:-----|------:|\n| alpha | 1 |\n| beta | 22 |\n\n---\n\n![ready](ready.png) ![late](late.png) ![bad](bad.png)\n\nThe end. See https://example.com/docs.\n"

fn item_bounds_ok(v: *mut markdownview.MdView, width: f64) -> bool {
    // every link rectangle stays inside the content width
    var i: u32 = 0
    while (i as usize) < markdownview.mdv_link_count(v) {
        var x: f64 = 0.0
        var y: f64 = 0.0
        var w: f64 = 0.0
        var h: f64 = 0.0
        if markdownview.mdv_link_rect(v, i, &x, &y, &w, &h) {
            if x < 0.0 || x + w > width + 0.5 {
                return false
            }
        }
        i = i + 1 as u32
    }
    return true
}

fn run_theme(dir: u64, font: u64, dark: bool) {
    if dark {
        say("== dark theme\n")
    } else {
        say("== light theme\n")
    }
    let p: *mut Page = page_new(520, 640, dark, font)
    let c: *mut render.Ctx = &(*p).c
    var v: markdownview.MdView = markdownview.mdv_new()
    markdownview.mdv_set_markdown(&v, DOC, doc.opts_default())
    markdownview.mdv_set_link_cb(&v, 0, on_link)
    markdownview.mdv_set_image_cb(&v, 0, on_image)
    markdownview.mdv_set_background(&v, style.TOK_BASE)
    markdownview.mdv_set_rect(&v, 0.0, 0.0, 520.0, 640.0)
    clear(p)
    markdownview.mdv_paint(&v, c)

    check(markdownview.mdv_content_height(&v) > 640.0, "the document is taller than the view (it scrolls)")
    check(markdownview.mdv_item_count(&v) > 60, "many items were laid out")
    check(markdownview.mdv_link_count(&v) == 2, "two links: the written one and the bare URL")
    check(item_bounds_ok(&v, 520.0), "no link rectangle leaves the content width")

    // the accent colour is on screen (the link), and so is the checked box
    let accent: u32 = tok(p, style.TOK_ACCENT)
    check(count_col(p, 0.0, 0.0, 520.0, 640.0, accent) > 30, "the accent colour appears (task box)")
    let lnk: u32 = theme.opaque(kitcolor.accent_text(&(*p).m, (*theme.theme_colors(&(*p).m)).base))
    check(count_col(p, 0.0, 0.0, 520.0, 640.0, lnk) > 30, "links are painted in the accent text colour")
    // the heading is painted: ink in the text colour near the top
    let ink: u32 = tok(p, style.TOK_TEXT)
    check(count_col(p, 12.0, 8.0, 300.0, 50.0, ink) > 40, "the h1 is painted in the text colour")
    // the rule under the h1 (separator colour, full width)
    var rule_row: usize = 0
    var ry: f64 = 60.0
    while ry < 90.0 {
        let diff: usize = 520 - count_col(p, 0.0, ry, 520.0, ry + 1.0, tok(p, style.TOK_BASE))
        if diff > rule_row {
            rule_row = diff
        }
        ry = ry + 1.0
    }
    check(rule_row > 400, "the h1 has its rule (a row of non-ground pixels as wide as the text column)")
    // the code block has the surface ground
    check(count_col(p, 0.0, 0.0, 520.0, 640.0, tok(p, style.TOK_SURFACE)) > 2000,
        "a code block / table header / placeholders paint the surface colour")

    // clicking the link: find its rectangle, press and release in it
    var lx: f64 = 0.0
    var ly: f64 = 0.0
    var lw: f64 = 0.0
    var lh: f64 = 0.0
    check(markdownview.mdv_link_rect(&v, 0 as u32, &lx, &ly, &lw, &lh), "link 0 has a rectangle")
    let cx: f64 = lx + lw / 2.0
    let cy: f64 = ly + lh / 2.0
    CLICKED = 0
    check(markdownview.mdv_pointer_move(&v, c, cx, cy), "moving onto the link changes the hover")
    check(markdownview.mdv_hover_link(&v) == 0 as u32, "link 0 is hovered")
    check(!markdownview.mdv_pointer_move(&v, c, cx + 1.0, cy), "moving inside the same link changes nothing")
    clear(p)
    markdownview.mdv_paint(&v, c)
    check(markdownview.mdv_pointer_down(&v, c, cx, cy), "a press on the link is taken")
    check(CLICKED == 0, "no click before the release")
    check(markdownview.mdv_pointer_up(&v, c, cx, cy), "the release on the same link clicks it")
    check(CLICKED == 1 && url_is("https://modrinth.com/mod/x"), "the callback got the link target")
    // press on the link, release elsewhere: no click
    CLICKED = 0
    let dn: bool = markdownview.mdv_pointer_down(&v, c, cx, cy)
    check(!markdownview.mdv_pointer_up(&v, c, 500.0, 300.0) && CLICKED == 0, "release elsewhere is no click")

    // scrolling: the wheel moves the content, the offset is clamped
    let before: f64 = markdownview.mdv_offset(&v)
    markdownview.mdv_wheel(&v, 3.0)
    check(markdownview.mdv_offset(&v) > before, "the wheel scrolls down")
    markdownview.mdv_wheel(&v, 10000.0)
    check(markdownview.mdv_offset(&v) <= markdownview.mdv_content_height(&v) - 600.0,
        "the offset is clamped to the end of the content")
    clear(p)
    markdownview.mdv_paint(&v, c)
    // at the end the last paragraph shows ("The end.")
    check(count_col(p, 0.0, 560.0, 520.0, 640.0, ink) > 20, "the end of the document is painted at the bottom")
    check(markdownview.mdv_key(&v, viewport.VP_HOME), "Home goes to the top")
    check(markdownview.mdv_offset(&v) == 0.0, "the offset is 0 at the top")

    clear(p)
    markdownview.mdv_paint(&v, c)
    if dark {
        save(&(*p).cv, dir, "mdview-dark.png")
    } else {
        save(&(*p).cv, dir, "mdview-light.png")
    }
    // the picture of the second page: the images
    markdownview.mdv_key(&v, viewport.VP_END)
    clear(p)
    markdownview.mdv_paint(&v, c)
    if dark {
        save(&(*p).cv, dir, "mdview-end-dark.png")
    } else {
        save(&(*p).cv, dir, "mdview-end-light.png")
    }
    check(count_col(p, 0.0, 0.0, 520.0, 640.0, 0xFFFF0000 as u32) > 500,
        "a READY image is drawn with its own pixels (40 x 20 red)")
    markdownview.mdv_free(&v)
}

fn run_narrow(dir: u64, font: u64) {
    say("== narrow: the text wraps, the table shrinks\n")
    let pw: *mut Page = page_new(520, 640, true, font)
    let pn: *mut Page = page_new(240, 900, true, font)
    var v1: markdownview.MdView = markdownview.mdv_new()
    var v2: markdownview.MdView = markdownview.mdv_new()
    markdownview.mdv_set_markdown(&v1, DOC, doc.opts_default())
    markdownview.mdv_set_markdown(&v2, DOC, doc.opts_default())
    markdownview.mdv_set_rect(&v1, 0.0, 0.0, 520.0, 640.0)
    markdownview.mdv_set_rect(&v2, 0.0, 0.0, 240.0, 900.0)
    markdownview.mdv_paint(&v1, &(*pw).c)
    markdownview.mdv_paint(&v2, &(*pn).c)
    check(markdownview.mdv_content_height(&v2) > markdownview.mdv_content_height(&v1),
        "the same text is taller in a narrow view")
    check(item_bounds_ok(&v2, 240.0), "no link rectangle leaves the narrow view")
    // no text pixel in the right margin strip beyond the padding
    clear(pn)
    markdownview.mdv_paint(&v2, &(*pn).c)
    check(count_col(pn, 238.0, 0.0, 240.0, 900.0, tok(pn, style.TOK_TEXT)) == 0,
        "nothing is painted into the last two pixel columns")
    save(&(*pn).cv, dir, "mdview-narrow.png")
    markdownview.mdv_free(&v1)
    markdownview.mdv_free(&v2)
}

// WCAG 2 contrast of the pairs the view uses, with the launcher accent
fn run_contrast() {
    say("== contrast of the pairs the view paints (WCAG 2, 4.5:1)\n")
    var d: usize = 0
    while d < 2 {
        let dark: bool = d == 1
        var m: theme.Theme = theme.theme_new(dark)
        theme.theme_set_accent(&m, 0x1BD96A as u32)
        let f: *mut theme.Colors = theme.theme_colors(&m)
        var nm: str = "light"
        if dark {
            nm = "dark"
        }
        check(kitcolor.kit_contrast_ok(kitcolor.accent_text(&m, (*f).base), (*f).base), "link colour on the page ground")
        check(kitcolor.kit_contrast_ok(kitcolor.accent_text(&m, (*f).surface), (*f).surface), "link colour on the surface (code block, table header)")
        check(theme.contrast((*f).text, (*f).surface) >= 4.5, "text on the surface")
        check(theme.contrast((*f).text, (*f).button) >= 4.5, "text on the ground of inline code")
        check(theme.contrast((*f).text_muted, (*f).base) >= 4.5, "muted text (quote) on the page ground")
        check(theme.contrast((*f).text_muted, (*f).surface) >= 4.5, "muted text on the surface")
        check(theme.contrast((*f).text_on_accent, (*f).accent) >= 4.5, "check mark on the accent box")
        d = d + 1
    }
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("mdview: no font (DejaVu Sans)\n")
        return 9
    }
    run_theme(dir, fs as u64, true)
    run_theme(dir, fs as u64, false)
    run_narrow(dir, fs as u64)
    run_contrast()
    if BAD == 0 {
        say("MDVIEW PASSED\n")
        return 0
    }
    say("MDVIEW FAILED\n")
    return 1
}
