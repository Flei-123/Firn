// SPDX-License-Identifier: MPL-2.0
// tools/fui/fontpick_main.fi -- host test of lib/plat/fontpick.fi (no window): prints what each choice loads.
//   FUI_FONTS_XML=<fonts.xml> FUI_FONTS_DIR=<dir> fontpick_main <system|inter|grotesk|mono> [dir-of-web-fonts]
// Output lines: "FONTPICK choice=<id> loaded=<0|1> sys=<file name> adv_a=<advance of 'a' at 100 px>".
import std.rt
import font.metrics
import plat.fontpick

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }

fn num(v: i64) {
    var b: rt.Buf = rt.buf_new()
    var x: i64 = v
    if x < 0 {
        rt.buf_push(&b, 45 as u8)
        x = 0 - x
    }
    var digits: [u8; 24] = [0; 24]
    var n: usize = 0
    if x == 0 {
        digits[0] = 48 as u8
        n = 1
    }
    while x > 0 {
        digits[n] = (48 + (x % 10)) as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        rt.buf_push(&b, digits[n])
    }
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

fn main(start: u64) -> i32 {
    var id: str = "system"
    if rt.arg_count(start) >= 2 {
        let bp: u64 = rt.arg_ptr(start, 1)
        id = str { p: bp as *mut u8, n: rt.c_length(bp) }
    }
    var dir: str = "/nonexistent"
    if rt.arg_count(start) >= 3 {
        let dp: u64 = rt.arg_ptr(start, 2)
        dir = str { p: dp as *mut u8, n: rt.c_length(dp) }
    }
    fontpick.fontpick_boot(dir)
    fontpick.fontpick_set(fontpick.fontpick_id(id))
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    let ok: bool = fontpick.fontpick_load_main(fs)
    say("FONTPICK choice=")
    say(fontpick.fontpick_name(fontpick.fontpick_choice()))
    say(" loaded=")
    if ok { say("1") } else { say("0") }
    say(" sys=")
    say(fontpick.fontpick_system_file())
    say(" adv_a=")
    if ok { num(metrics.fm_advance(fs as u64, 100.0, 97 as u32) as i64) } else { say("-") }
    say(" files=")
    if fontpick.fontpick_files_present(fontpick.fontpick_choice()) { say("1") } else { say("0") }
    say("\n")
    return 0
}
