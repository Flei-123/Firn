import std.rt
import fui.services

static mut BAD: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  FAIL  ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn same(b: *mut rt.Buf, s: str) -> bool {
    return rt.buf_len(b) == s.n && rt.mem_eq(rt.buf_ptr(b), s.p as u64, s.n)
}

fn put(path: str, text: str) -> bool {
    return services.write_path(path, text.p as u64, text.n)
}

fn test_store() {
    var out: rt.Buf = rt.buf_new()
    check(!services.store_get("missing", &out), "store: missing key is absent")
    check(services.store_set("theme", "dark".p as u64, 4), "store: set")
    check(services.store_get("theme", &out) && same(&out, "dark"), "store: get returns the value")
    rt.buf_clear(&out)
    check(services.store_set("theme", "light!".p as u64, 6), "store: overwrite")
    check(services.store_get("theme", &out) && same(&out, "light!"), "store: overwrite visible")
    rt.buf_free(&out)
}

fn test_clipboard() {
    var ev: services.SvcEvent = services.event_new()
    check(services.clip_request() && services.next(&ev), "clip: empty request answers")
    check(ev.kind == services.EV_CLIP && ev.status == 0 as u32, "clip: empty clipboard has status 0")
    check(services.clip_copy("héllo"), "clip: copy")
    check(services.clip_request() && services.next(&ev), "clip: request answers")
    check(ev.kind == services.EV_CLIP && ev.status == 1 as u32 && same(&ev.data, "héllo"), "clip: text round trip")
    services.event_free(&ev)
}

fn test_open() {
    var ev: services.SvcEvent = services.event_new()
    check(put("notes.txt", "line one"), "open: seed file")
    services.script_pick("notes.txt")
    check(services.open_request("Open", "") && services.pending() == 1, "open: request queues one event")
    check(services.next(&ev) && ev.kind == services.EV_OPENED && ev.status == 1 as u32, "open: event kind and status")
    check(same(&ev.name, "notes.txt") && same(&ev.data, "line one"), "open: name and data")
    check(!services.next(&ev), "open: queue empty afterwards")
    services.script_pick("")
    check(services.open_request("Open", "") && services.next(&ev) && ev.status == 0 as u32, "open: cancel gives status 0")
    services.script_pick("absent.txt")
    check(services.open_request("Open", "") && services.next(&ev) && ev.status == 0 as u32, "open: unreadable file gives status 0")
    services.event_free(&ev)
}

fn test_save() {
    var ev: services.SvcEvent = services.event_new()
    var out: rt.Buf = rt.buf_new()
    services.script_pick("out.md")
    check(services.save_request("Save", "draft.md", "# hi".p as u64, 4), "save: request")
    check(services.next(&ev) && ev.kind == services.EV_SAVED && ev.status == 1 as u32, "save: event kind and status")
    check(same(&ev.name, "out.md"), "save: event carries the chosen name")
    check(services.read_path("out.md", &out) && same(&out, "# hi"), "save: file content")
    services.script_pick("")
    check(services.save_request("Save", "draft.md", "x".p as u64, 1) && services.next(&ev) && ev.status == 0 as u32, "save: cancel gives status 0")
    rt.buf_free(&out)
    services.event_free(&ev)
}

fn test_paths() {
    var out: rt.Buf = rt.buf_new()
    check(!services.read_path("no/such/file", &out), "path: missing file is absent")
    check(put("a.bin", "abc") && put("a.bin", "abcdef"), "path: replace")
    check(services.read_path("a.bin", &out) && same(&out, "abcdef"), "path: replaced content")
    rt.buf_free(&out)
}

fn test_queue() {
    services.memory_reset()
    var accepted: usize = 0
    var i: usize = 0
    while i < 12 {
        if services.clip_request() {
            accepted = accepted + 1
        }
        i = i + 1
    }
    check(accepted == 8 && services.pending() == 8, "queue: holds 8 events and refuses the rest")
    var ev: services.SvcEvent = services.event_new()
    var drained: usize = 0
    while services.next(&ev) {
        drained = drained + 1
    }
    check(drained == 8 && services.pending() == 0, "queue: drains in order")
    services.event_free(&ev)
}

fn test_dialog() {
    services.script_answer(services.ANS_YES)
    check(services.message(services.KIND_QUESTION, "t", "x", services.BTNS_YES_NO) == services.ANS_YES, "dialog: scripted answer")
    check(services.confirm("t", "x"), "dialog: confirm yes")
    services.script_answer(services.ANS_NO)
    check(!services.confirm("t", "x"), "dialog: confirm no")
}

fn test_platform() {
    services.use_memory(false)
    var out: rt.Buf = rt.buf_new()
    check(!services.read_path("no/such/file/anywhere", &out), "platform: missing file is absent")
    rt.buf_free(&out)
    services.use_memory(true)
}

fn main() -> i32 {
    services.use_memory(true)
    test_store()
    test_clipboard()
    test_open()
    test_save()
    test_paths()
    test_queue()
    test_dialog()
    test_platform()
    if BAD != 0 {
        say("SERVICES FAILED\n")
        return 1
    }
    say("SERVICES PASSED\n")
    return 0
}
