// SPDX-License-Identifier: MPL-2.0
// tools/fui/uiatab_main.fi -- W37: THE TABLE / EDIT / SLIDER ANSWERS OF THE UIA MODEL (lib/fui/uia.fi), headless.
// Same window as tools/fui/uialive/main.fi (buttons, controls, a 3x3 table, a sheet). Checks Grid / Table / GridItem /
// TableItem / Selection patterns, the real text of the text field, the 0..100 slider range, hit tests over rows.
// (was: THE UIA BRIDGE IN A REAL WINDOW (Windows, W36-a): window, buttons, controls, a table
// (rows + cells), a bottom sheet. Live: `uialive.exe` opens the window and serves UIA (Inspect.exe / Narrator).
// Oracle: with FUI_UIALIVE_DUMP=<path> the same window is built headless (any target), painted once and its a11y
// JSON is written to <path>; the program exits. The tree is the same on every OS.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.a11y
import fui.uia
import fui.vlist
import fui.render
import fui.safeout
import std.env

static mut CHANGES: usize = 0
static mut BAD: usize = 0
static mut FONT: u64 = 0

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn on_quit(a: *mut app.App) {
    app.quit(a)
}

fn on_save(a: *mut app.App) {
    CHANGES = CHANGES + 1
}

fn body_draw(a: *mut app.App, rc: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64) {
}

#[allow_escape]
fn main(start: u64) -> i32 {
    let a: *mut app.App = app.window("fUi UIA Live", 560, 760)
    let hd: usize = app.label(a, "Preferences", 0)
    a11y.a11y_set_role(app.ax(a), hd, a11y.ROLE_HEADING)
    a11y.a11y_set_level(app.ax(a), hd, 1 as u32)
    let b1: usize = app.button(a, "Save", on_save)
    let cb: usize = appctl.checkbox(a, "Dark mode", false, changed)
    let tg: usize = appctl.toggle(a, "Notifications", false, changed)
    let sl: usize = appctl.slider(a, "Volume", 0, 100, 40, changed)
    let en: usize = app.entry(a, "Search")
    let tbl: usize = appctl.table(a, "People", 520, 150, 3, changed)
    appctl.table_col(a, tbl, 0, "Name", 200, false)
    appctl.table_col(a, tbl, 1, "Age", 120, false)
    appctl.table_col(a, tbl, 2, "ID", 160, true)
    let tr0: usize = appctl.table_add_row(a, tbl)
    appctl.table_set(a, tbl, tr0, 0, "Anna")
    appctl.table_set(a, tbl, tr0, 1, "7")
    appctl.table_set(a, tbl, tr0, 2, "a-01")
    let tr1: usize = appctl.table_add_row(a, tbl)
    appctl.table_set(a, tbl, tr1, 0, "Bruno")
    appctl.table_set(a, tbl, tr1, 1, "25")
    appctl.table_set(a, tbl, tr1, 2, "b-02")
    let tr2: usize = appctl.table_add_row(a, tbl)
    appctl.table_set(a, tbl, tr2, 0, "Carla")
    appctl.table_set(a, tbl, tr2, 1, "41")
    appctl.table_set(a, tbl, tr2, 2, "c-03")
    let qb: usize = app.button(a, "Quit", on_quit)
    let shok: bool = appctl.sheet_setup(a, "Panel", false, body_draw, changed)
    appctl.sheet_describe(a, "Three items in the cart")
    let it0: usize = appctl.sheet_item(a, a11y.ROLE_TEXT, "Total 3 items", 0, 0, 200, 24)
    let it1: usize = appctl.sheet_item(a, a11y.ROLE_BUTTON, "Checkout", 0, 30, 120, 32)
    appctl.sheet_show(a, 0)
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("uiatab: no font\n")
        return 9
    }
    FONT = fs as u64
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 560, 760)
    frame(a, s)
    frame(a, s)
    var pv: uia.Provider = uia.provider_new(app.app_scene(a), app.ax(a), "UIA Live")
    uia.provider_set_app(&pv, a)
    let tb: uia.El = uia.el_from_node(&pv, tbl)
    check(uia.el_has_pattern(&pv, tb, uia.PAT_GRID) && uia.el_has_pattern(&pv, tb, uia.PAT_TABLE), "table: Grid + Table patterns")
    check(uia.el_has_pattern(&pv, tb, uia.PAT_SELECTION), "table: Selection pattern")
    check(!uia.el_has_pattern(&pv, uia.el_from_node(&pv, en), uia.PAT_GRID), "edit: no Grid pattern")
    check(uia.pattern_id(uia.PAT_GRID) == 10006 as u32 && uia.pattern_id(uia.PAT_GRIDITEM) == 10007 as u32
        && uia.pattern_id(uia.PAT_TABLE) == 10012 as u32 && uia.pattern_id(uia.PAT_TABLEITEM) == 10013 as u32
        && uia.pattern_id(uia.PAT_SELECTION) == 10001 as u32, "UIA_PatternIds: Selection 10001, Grid 10006, GridItem 10007, Table 10012, TableItem 10013")
    check(uia.el_grid_rows(&pv, tb) == 3 && uia.el_grid_cols(&pv, tb) == 3, "grid: 3 rows x 3 columns")
    check(uia.el_grid_rows(&pv, uia.el_from_node(&pv, b1)) == 0, "button: no grid rows")
    let c12: uia.El = uia.el_cell_at(&pv, tb, 1, 2)
    var nb: [u8; 64] = [0 as u8; 64]
    let nn: usize = uia.el_name(&pv, c12, (&nb[0]) as u64, 64)
    check(!uia.el_is_none(c12) && nn == 4 && nb[0] == 98 as u8 && nb[3] == 50 as u8, "GetItem(1, 2) is the cell 'b-02'")
    check(uia.el_is_none(uia.el_cell_at(&pv, tb, 3, 0)) && uia.el_is_none(uia.el_cell_at(&pv, tb, 0, 3)), "GetItem out of range: none")
    check(uia.el_has_pattern(&pv, c12, uia.PAT_GRIDITEM) && uia.el_has_pattern(&pv, c12, uia.PAT_TABLEITEM), "cell: GridItem + TableItem")
    check(uia.el_cell_row(c12) == 1 && uia.el_cell_col(c12) == 2, "cell: Row 1, Column 2")
    check(uia.el_equal(uia.el_parent(&pv, uia.el_row_of_cell(&pv, c12)), tb), "cell: containing grid = the table")
    check(!uia.el_has_pattern(&pv, tb, uia.PAT_GRIDITEM) && !uia.el_has_pattern(&pv, uia.el_row_of_cell(&pv, c12), uia.PAT_TABLEITEM), "table / row: no GridItem / TableItem")
    check(uia.el_has_pattern(&pv, uia.el_row_of_cell(&pv, c12), uia.PAT_SELITEM), "row: SelectionItem")
    check(uia.el_selected_count(&pv, tb) == 0, "nothing selected at the start")
    // click the middle row like a mouse (what SelectionItem.Select does)
    var rq: [i64; 4] = [0; 4]
    uia.el_rect(&pv, uia.el_row_of_cell(&pv, c12), &rq)
    let w: *mut fuiwirt.Host = app.app_host(a)
    let px: f64 = (rq[0] + rq[2] / 2) as f64
    let py: f64 = (rq[1] + rq[3] / 2) as f64
    let m1: u32 = fuiwirt.host_pointer_move(w, px, py)
    let m2: u32 = fuiwirt.host_pointer_down(w, px, py, fuiwirt.BTN_LEFT)
    let m3: u32 = fuiwirt.host_pointer_up(w, px, py, fuiwirt.BTN_LEFT)
    frame(a, s)
    check(uia.el_selected_count(&pv, tb) == 1 && uia.el_equal(uia.el_selected_at(&pv, tb, 0), uia.el_row_of_cell(&pv, c12)), "after the click: Selection = row 1")
    check(uia.el_is_selected(&pv, uia.el_row_of_cell(&pv, c12)), "row 1: SelectionItem.IsSelected")
    check(!uia.el_multi_select(&pv, tb), "table: CanSelectMultiple false")
    // the text field: the REAL text, not the label
    let e0: uia.El = uia.el_from_node(&pv, en)
    var vb: [u8; 128] = [0 as u8; 128]
    check(uia.el_value(&pv, e0, (&vb[0]) as u64, 128) == 0, "text field, empty: Value is the empty string (not the label)")
    app.set_text(a, en, "hello fUi")
    frame(a, s)
    let vn: usize = uia.el_value(&pv, e0, (&vb[0]) as u64, 128)
    check(vn == 9 && vb[0] == 104 as u8 && vb[8] == 105 as u8, "text field: Value = 'hello fUi'")
    check(!uia.el_readonly(&pv, e0), "text field: not read only")
    check(uia.el_has_pattern(&pv, e0, uia.PAT_VALUE), "text field: Value pattern")
    // the slider: 0 .. 100
    let sle: uia.El = uia.el_from_node(&pv, sl)
    check(uia.el_range_min() == 0 && uia.el_range_max() == 100, "slider: range 0 .. 100")
    check(uia.el_range_value_ui(&pv, sle) == 40.0, "slider: value 40.0 of 100")
    // hit tests: over a table cell, over a button
    let hc: uia.El = uia.el_from_point(&pv, px as i64, py as i64)
    check(uia.el_equal(uia.el_row_of_cell(&pv, hc), uia.el_row_of_cell(&pv, c12)), "ElementFromPoint over a table row finds a cell of that row")
    var qq: [i64; 4] = [0; 4]
    uia.el_rect(&pv, uia.el_from_node(&pv, qb), &qq)
    let hb: uia.El = uia.el_from_point(&pv, qq[0] + qq[2] / 2, qq[1] + qq[3] / 2)
    check(uia.el_equal(hb, uia.el_from_node(&pv, qb)), "ElementFromPoint over Quit finds Quit")
    // W40-a r361: the column headers (HeaderItem) -- Table.GetColumnHeaders, TableItem.GetColumnHeaderItems, Invoke = sort
    check(uia.el_head_count(&pv, tb) == 3, "table: 3 column headers")
    let h0: uia.El = uia.el_head_at(&pv, tb, 0)
    let h1: uia.El = uia.el_head_at(&pv, tb, 1)
    let h2: uia.El = uia.el_head_at(&pv, tb, 2)
    check(!uia.el_is_none(h0) && !uia.el_is_none(h1) && !uia.el_is_none(h2) && uia.el_is_none(uia.el_head_at(&pv, tb, 3)),
        "headers: columns 0..2 exist, column 3 does not")
    var hdb: [u8; 32] = [0 as u8; 32]
    let hn0: usize = uia.el_name(&pv, h0, (&hdb[0]) as u64, 32)
    check(hn0 == 4 && hdb[0] == 78 as u8 && hdb[3] == 101 as u8, "header 0 is named 'Name'")
    let hn2: usize = uia.el_name(&pv, h2, (&hdb[0]) as u64, 32)
    check(hn2 == 2 && hdb[0] == 73 as u8 && hdb[1] == 68 as u8, "header 2 is named 'ID'")
    check(uia.el_control_type(&pv, h1) == uia.CT_HEADERITEM && uia.CT_HEADERITEM == 50034 as u32, "header: control type HeaderItem (50034)")
    check(uia.el_has_pattern(&pv, h1, uia.PAT_INVOKE), "header: Invoke pattern")
    check(!uia.el_has_pattern(&pv, h1, uia.PAT_GRIDITEM) && !uia.el_has_pattern(&pv, h1, uia.PAT_TABLEITEM), "header: no GridItem / TableItem (it is not a data cell)")
    check(uia.el_equal(uia.el_parent(&pv, h1), tb), "header: parent = the table")
    check(uia.el_equal(uia.el_head_of_cell(&pv, c12), h2), "TableItem.GetColumnHeaderItems of 'b-02' = header 2 ('ID')")
    check(uia.el_equal(uia.el_head_of_cell(&pv, uia.el_cell_at(&pv, tb, 0, 0)), h0), "column header of cell (0, 0) = header 0")
    var hr: [i64; 4] = [0; 4]
    var tq: [i64; 4] = [0; 4]
    uia.el_rect(&pv, h1, &hr)
    uia.el_rect(&pv, tb, &tq)
    var cq: [i64; 4] = [0; 4]
    uia.el_rect(&pv, uia.el_cell_at(&pv, tb, 0, 1), &cq)
    check(hr[2] > 0 && hr[3] > 0 && hr[0] >= tq[0] && hr[1] >= tq[1] && hr[0] + hr[2] <= tq[0] + tq[2], "header 1: rectangle inside the table")
    check(hr[1] + hr[3] <= cq[1] && hr[0] == cq[0], "header 1: above and in line with the first data cell of its column")
    let hh: uia.El = uia.el_from_point(&pv, hr[0] + hr[2] / 2, hr[1] + hr[3] / 2)
    check(uia.el_equal(hh, h1), "ElementFromPoint over the 'Age' header finds that header")
    // Invoke = a click in the middle of the header (what uiacom.do_click does): sorts by 'Age', ascending, then descending
    check(appctl.table_sort_col(a, tbl) != 1, "before the header click: not sorted by 'Age'")
    let hx: f64 = (hr[0] + hr[2] / 2) as f64
    let hy: f64 = (hr[1] + hr[3] / 2) as f64
    let k1: u32 = fuiwirt.host_pointer_move(w, hx, hy)
    let k2: u32 = fuiwirt.host_pointer_down(w, hx, hy, fuiwirt.BTN_LEFT)
    let k3: u32 = fuiwirt.host_pointer_up(w, hx, hy, fuiwirt.BTN_LEFT)
    frame(a, s)
    check(appctl.table_sort_col(a, tbl) == 1 && !appctl.table_sort_desc(a, tbl), "header click (Invoke): sorted by 'Age', ascending")
    let k4: u32 = fuiwirt.host_pointer_down(w, hx, hy, fuiwirt.BTN_LEFT)
    let k5: u32 = fuiwirt.host_pointer_up(w, hx, hy, fuiwirt.BTN_LEFT)
    frame(a, s)
    check(appctl.table_sort_col(a, tbl) == 1 && appctl.table_sort_desc(a, tbl), "second header click: descending")
    let top: uia.El = uia.el_cell_at(&pv, tb, 0, 0)
    let tn: usize = uia.el_name(&pv, top, (&hdb[0]) as u64, 32)
    check(tn == 5 && hdb[0] == 67 as u8, "descending by age: the first row is 'Carla' (41)")
    // the toggle (W40-a): its label is not cut -- the node is as wide as pill + gap + the whole text
    var tgq: [i64; 4] = [0; 4]
    uia.el_rect(&pv, uia.el_from_node(&pv, tg), &tgq)
    check(tgq[2] >= 130, "toggle 'Notifications': wide enough for pill + gap + label (>= 130 px; was ~120 and cut to 'Notifica...')")
    say("UIATAB bad=")
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, BAD as i64)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
    if BAD == 0 {
        say("UIATAB PASSED\n")
        return 0
    }
    return 1
}
