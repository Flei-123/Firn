// SPDX-License-Identifier: MPL-2.0
// tools/fui/ttssent_main.fi -- sentence-wise read aloud (lib/net/ttssent.fi): markdown cleaning + sentence / block splitting, a67.
//     FIRNLIB=$PWD/lib firnc -o /tmp/ttssent tools/fui/ttssent_main.fi && /tmp/ttssent
import std.rt
import net.ttssent

static mut BAD: usize = 0

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }

fn same(a: *mut rt.Buf, b: str) -> bool {
    if (*a).len != b.n { return false }
    return rt.mem_eq((*a).ptr, b.p as u64, b.n)
}

fn show(a: *mut rt.Buf) { rt.write_everything(1, (*a).ptr, (*a).len) }

fn check(ok: bool, what: str) {
    if ok { say("  ok    ") } else { say("  WRONG "); BAD = BAD + 1 }
    say(what)
    say("\n")
}

// markdown -> clean text; compare with `want`
fn t_clean(src: str, want: str, what: str) {
    var out: rt.Buf = rt.buf_new()
    ttssent.clean(src.p as u64, src.n, &out)
    let ok: bool = same(&out, want)
    check(ok, what)
    if !ok {
        say("     got : [")
        show(&out)
        say("]\n     want: [")
        say(want)
        say("]\n")
    }
    rt.buf_free(&out)
}

// all blocks of the (already clean) text `src`, joined with '|' (trailing blanks / line breaks of a block dropped)
fn blocks(src: str, out: *mut rt.Buf) {
    var s: usize = 0
    var first: bool = true
    var guard: usize = 0
    while s < src.n && guard < 1000 {
        while s < src.n && ttssent.is_space(rt.ld8(src.p as u64, s)) { s = s + 1 }
        if s >= src.n { break }
        let e: usize = ttssent.block_end(src.p as u64, src.n, s, first)
        var te: usize = e
        while te > s && ttssent.is_space(rt.ld8(src.p as u64, te - 1)) { te = te - 1 }
        if !first { rt.buf_push(out, 124 as u8) }
        rt.buf_push_bytes(out, (src.p as u64) + s as u64, te - s)
        first = false
        s = e
        guard = guard + 1
    }
}

fn t_blocks(src: str, want: str, what: str) {
    var out: rt.Buf = rt.buf_new()
    blocks(src, &out)
    let ok: bool = same(&out, want)
    check(ok, what)
    if !ok {
        say("     got : [")
        show(&out)
        say("]\n     want: [")
        say(want)
        say("]\n")
    }
    rt.buf_free(&out)
}

// the longest block of a text made of `n` copies of `unit`
fn longest_block(unit: str, copies: usize) -> usize {
    var w: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < copies {
        rt.buf_push_bytes(&w, unit.p as u64, unit.n)
        k = k + 1
    }
    var s: usize = 0
    var longest: usize = 0
    var first: bool = true
    var guard: usize = 0
    while s < w.len && guard < 5000 {
        let e: usize = ttssent.block_end(w.ptr, w.len, s, first)
        if e <= s { longest = 99999; break }
        var te: usize = e
        while te > s && ttssent.is_space(rt.ld8(w.ptr, te - 1)) { te = te - 1 }
        if te - s > longest { longest = te - s }
        s = e
        first = false
        guard = guard + 1
    }
    rt.buf_free(&w)
    return longest
}

fn main() -> i32 {
    say("== ttssent: sentences ==\n")
    t_blocks("Hallo Welt, das ist ein Test. Und noch ein Satz, der lang genug ist, um allein zu stehen. Der dritte Satz kommt hier auch noch dazu. Ende hier im Text.",
        "Hallo Welt, das ist ein Test.|Und noch ein Satz, der lang genug ist, um allein zu stehen.|Der dritte Satz kommt hier auch noch dazu.|Ende hier im Text.",
        "plain sentences: one block each")
    t_blocks("Ja. Nein. Vielleicht doch noch einmal anders. Gut.", "Ja. Nein. Vielleicht doch noch einmal anders.|Gut.", "tiny sentences are joined with the next one")
    t_blocks("Das ist z.B. ein Test mit vielen Worten drin. Dr. Müller kommt auch noch zu uns heute. Ca. 5 Stück sind da.",
        "Das ist z.B. ein Test mit vielen Worten drin.|Dr. Müller kommt auch noch zu uns heute.|Ca. 5 Stück sind da.", "abbreviations z.B. Dr. Ca. do not end a sentence")
    t_blocks("Äpfel, Birnen, Bananen usw. Dann gehen wir weiter zum nächsten Thema im Programm hier.",
        "Äpfel, Birnen, Bananen usw.|Dann gehen wir weiter zum nächsten Thema im Programm hier.", "usw. before a capital ends the sentence")
    t_blocks("Pi ist etwa 3.14 und e ist 2.718 im Betrag, sagt man. Version 1.2.3 ist fertig und online.",
        "Pi ist etwa 3.14 und e ist 2.718 im Betrag, sagt man.|Version 1.2.3 ist fertig und online.", "3.14 / 2.718 / 1.2.3 are no stops")
    t_blocks("Wir treffen uns am 3. Mai im Büro und sprechen dann über alles. Am 12. Juni ist Schluss mit dem Plan.",
        "Wir treffen uns am 3. Mai im Büro und sprechen dann über alles.|Am 12. Juni ist Schluss mit dem Plan.", "day number + month: no stop")
    t_blocks("Das Projekt startete im Frühjahr des Jahres 2024. Danach kam noch viel mehr dazu und auch weniger davon.",
        "Das Projekt startete im Frühjahr des Jahres 2024.|Danach kam noch viel mehr dazu und auch weniger davon.", "a year before a capital ends the sentence")
    t_blocks("Was meinst du dazu eigentlich wirklich? Das ist toll!! Wirklich? Ja, wirklich so gut gelaufen heute.",
        "Was meinst du dazu eigentlich wirklich?|Das ist toll!! Wirklich? Ja, wirklich so gut gelaufen heute.", "? ! !! end sentences (tiny ones joined)")
    t_blocks("Er sagte \"Das geht so nicht mehr.\" Dann ging er weg und kam nicht wieder zurück.",
        "Er sagte \"Das geht so nicht mehr.\"|Dann ging er weg und kam nicht wieder zurück.", "closing quote stays with its sentence")
    t_blocks("Wir warten noch... Dann geht es los mit der großen Aktion für heute Abend.",
        "Wir warten noch... Dann geht es los mit der großen Aktion für heute Abend.", "ellipsis + capital: stop (joined: first piece short)")
    t_blocks("Die Datei heißt app.js und liegt in src/lib.rs, genau da. Fertig mit dem Satz hier.",
        "Die Datei heißt app.js und liegt in src/lib.rs, genau da.|Fertig mit dem Satz hier.", "file names are no stops")
    t_blocks("Zeile eins ohne Punkt hier da\nZeile zwei ohne Punkt aber mit mehr Text drin\nZeile drei ohne Punkt aber auch mit mehr Text",
        "Zeile eins ohne Punkt hier da|Zeile zwei ohne Punkt aber mit mehr Text drin|Zeile drei ohne Punkt aber auch mit mehr Text", "a line break is a stop")
    t_blocks("J. Smith kam. Der Rest war schon lange nicht mehr da, aber das ist egal so.",
        "J. Smith kam. Der Rest war schon lange nicht mehr da, aber das ist egal so.", "one letter + dot: no stop")

    say("== first block ==\n")
    t_blocks("Guten Morgen lieber Justin, heute ist ein schöner Tag, für ein Experiment mit der neuen Stimme auf dem Handy hier.",
        "Guten Morgen lieber Justin,|heute ist ein schöner Tag, für ein Experiment mit der neuen Stimme auf dem Handy hier.", "long first sentence: ends at the first comma after 25")
    t_blocks("Kurz, ok. Und dann kommt noch ein langer zweiter Satz mit vielen Worten.",
        "Kurz, ok. Und dann kommt noch ein langer zweiter Satz mit vielen Worten.", "short first sentence: no comma cut")

    say("== long sentences ==\n")
    check(longest_block("Dies ist ein sehr langer Satz ohne einen Punkt und ohne Komma immer weiter ", 40) <= ttssent.HARD_MAX, "no stop, no comma: blocks <= HARD_MAX")
    check(longest_block("Wort, ", 300) <= ttssent.LONG_SENT + 4, "commas only: blocks <= LONG_SENT")
    check(longest_block("ä", 3000) <= ttssent.HARD_MAX, "one 6000-octet word: hard cut <= HARD_MAX")
    check(longest_block("Ein normaler Satz hier. ", 200) < 300, "normal text: no huge block")
    // a hard cut never lands inside a UTF-8 character
    var w: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < 3000 { rt.buf_push_bytes(&w, "ä".p as u64, 2); k = k + 1 }
    let ce: usize = ttssent.block_end(w.ptr, w.len, 0, false)
    check((rt.ld8(w.ptr, ce) as i32 & 192) != 128 || ce >= w.len, "hard cut at a character boundary")
    rt.buf_free(&w)

    say("== markdown -> speech ==\n")
    t_clean("Hallo **Welt** und `code`.", "Hallo Welt und code.", "bold + inline code")
    t_clean("Text vorher.\n```js\nlet x = 1;\nfoo();\n```\nText nachher.", "Text vorher.\nText nachher.", "code block dropped")
    t_clean("Siehe [die Doku](https://example.com/a?b=1) jetzt.", "Siehe die Doku jetzt.", "[text](url) -> text")
    t_clean("Bild: ![Screenshot](img/a.png) hier.", "Bild: Screenshot hier.", "![alt](url) -> alt")
    t_clean("Geh auf https://example.com/x, dann weiter.", "Geh auf Link, dann weiter.", "bare URL -> Link, comma stays")
    t_clean("# Titel\n\nText.\n\n## Unter", "Titel.\nText.\nUnter.", "headings get a stop, blank lines collapse")
    t_clean("- eins\n- zwei\n* drei\n1. vier\n2) fünf", "eins.\nzwei.\ndrei.\nvier.\nfünf.", "list marks gone, items get a stop")
    t_clean("> Zitat hier\n\n---\n\nEnde", "Zitat hier.\nEnde.", "quote mark + rule gone")
    t_clean("| a | b |\n|---|---|\n| 1 | 2 |", "a, b.\n1, 2.", "table: separator row gone, cells with commas")
    t_clean("Fertig ✅ und 🎉 super → weiter", "Fertig und super weiter.", "emojis + arrows dropped")
    t_clean("snake_case_name und _kursiv_ hier", "snake case name und kursiv hier.", "underscores -> blanks")
    t_clean("- [ ] offen\n- [x] fertig", "offen.\nfertig.", "task boxes gone")
    t_clean("```\nnur code\n```", "", "only code: nothing left")
    t_clean("Zeile mit Doppelpunkt:\n- a\n- b", "Zeile mit Doppelpunkt:\na.\nb.", "colon line keeps no extra stop")
    t_clean("Windows\r\nZeilen\r\nenden", "Windows.\nZeilen.\nenden.", "CRLF")

    say("== clean + blocks (an answer) ==\n")
    {
        let src: str = "## Ergebnis\n\nDas Tool läuft, z.B. mit **Piper**. Siehe [Doku](https://x.y/z).\n\n```py\nprint(1)\n```\n\n- Punkt eins\n- Punkt zwei ist deutlich länger als der erste Punkt\n\nFertig."
        var cl: rt.Buf = rt.buf_new()
        ttssent.clean(src.p as u64, src.n, &cl)
        var bl: rt.Buf = rt.buf_new()
        blocks(rt.buf_str(&cl), &bl)
        let want: str = "Ergebnis.\nDas Tool läuft, z.B. mit Piper.|Siehe Doku.\nPunkt eins.\nPunkt zwei ist deutlich länger als der erste Punkt.|Fertig."
        let ok: bool = same(&bl, want)
        check(ok, "an answer: heading + sentences + code + list")
        if !ok {
            say("     got : [")
            show(&bl)
            say("]\n")
        }
        rt.buf_free(&cl)
        rt.buf_free(&bl)
    }

    if BAD == 0 { say("ALL OK\n"); return 0 }
    say("FAILED\n")
    return 1
}
