import std.rt
import paint.canvas
import font.metrics
import fui.kitcolor
import fui.painter
import fui.render
import fui.style
import fui.theme
import plat.sysfont

static mut BAD: usize = 0
static mut CHECKS: usize = 0

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
}

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn fails() -> usize { return BAD }

fn finish(name: str) -> i32 {
    say(name)
    if BAD == 0 {
        say(" PASSED\n")
        return 0
    }
    say(" FAILED\n")
    return 1
}

fn font_load() -> u64 {
    var fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) { return 0 }
    return fs as u64
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    kitcolor.kit_theme(&(*p).m, dark)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn tok(p: *mut Page, t: u32) -> u32 {
    return theme.opaque(render.color_of(&(*p).c, style.color_token(t)))
}

fn px(p: *mut Page, x: f64, y: f64) -> u32 {
    return canvas.canvas_get(&(*p).cv, x as usize, y as usize)
}

fn clear(p: *mut Page) {
    canvas.canvas_clear(&(*p).cv, tok(p, style.TOK_BASE))
}

fn region_differs(p: *mut Page, x: f64, y: f64, w: f64, h: f64, base: u32) -> usize {
    var n: usize = 0
    var yy: f64 = y
    while yy < y + h {
        var xx: f64 = x
        while xx < x + w {
            if px(p, xx, yy) != base { n = n + 1 }
            xx = xx + 1.0
        }
        yy = yy + 1.0
    }
    return n
}

fn regions_differ(p: *mut Page, x: f64, y: f64, w: f64, h: f64, other: *mut Page) -> usize {
    var n: usize = 0
    var yy: f64 = y
    while yy < y + h {
        var xx: f64 = x
        while xx < x + w {
            if px(p, xx, yy) != px(other, xx, yy) { n = n + 1 }
            xx = xx + 1.0
        }
        yy = yy + 1.0
    }
    return n
}
