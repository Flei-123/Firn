import std.rt
import term.term
import term.termstate
import term.termgrid
import term.terminput
import term.termsel

static mut BAD: usize = 0
static mut TOTAL: usize = 0

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }

fn check(ok: bool, what: str) {
    TOTAL = TOTAL + 1
    if ok { return }
    say("  WRONG ")
    say(what)
    say("\n")
    BAD = BAD + 1
}

fn same(b: *mut rt.Buf, want: str) -> bool {
    var ok: bool = rt.buf_len(b) == want.n
    if ok { ok = rt.mem_eq(rt.buf_ptr(b), want.p as u64, want.n) }
    rt.buf_clear(b)
    return ok
}

fn test_keys() {
    var b: rt.Buf = rt.buf_new()
    terminput.encode_key(false, terminput.TK_UP, 0 as u32, &b)
    check(same(&b, "\x1b[A"), "up")
    terminput.encode_key(true, terminput.TK_UP, 0 as u32, &b)
    check(same(&b, "\x1bOA"), "up in application mode")
    terminput.encode_key(false, terminput.TK_RIGHT, terminput.M_CTRL, &b)
    check(same(&b, "\x1b[1;5C"), "ctrl right")
    terminput.encode_key(false, terminput.TK_DELETE, 0 as u32, &b)
    check(same(&b, "\x1b[3~"), "delete")
    terminput.encode_key(false, terminput.TK_PGDN, terminput.M_SHIFT, &b)
    check(same(&b, "\x1b[6;2~"), "shift page down")
    terminput.encode_key(false, terminput.TK_BACKSPACE, 0 as u32, &b)
    check(same(&b, "\x7f"), "backspace")
    terminput.encode_key(false, terminput.TK_TAB, terminput.M_SHIFT, &b)
    check(same(&b, "\x1b[Z"), "shift tab")
    terminput.encode_key(false, terminput.TK_F1, 0 as u32, &b)
    check(same(&b, "\x1bOP"), "F1")
    terminput.encode_key(false, terminput.TK_F1 + 4 as u32, 0 as u32, &b)
    check(same(&b, "\x1b[15~"), "F5")
    terminput.encode_char(99 as u32, terminput.M_CTRL, &b)
    check(same(&b, "\x03"), "ctrl c")
    terminput.encode_char(120 as u32, terminput.M_ALT, &b)
    check(same(&b, "\x1bx"), "alt x")
    terminput.encode_char(0x20AC as u32, 0 as u32, &b)
    check(same(&b, "\u{20ac}"), "euro sign as UTF-8")
    rt.buf_free(&b)
}

fn test_mouse_and_paste() {
    var b: rt.Buf = rt.buf_new()
    check(terminput.encode_mouse(1000 as u32, true, terminput.MK_PRESS, terminput.BTN_LEFT, 4 as u32, 2 as u32, 0 as u32, &b), "press reported")
    check(same(&b, "\x1b[<0;5;3M"), "SGR press")
    terminput.encode_mouse(1000 as u32, true, terminput.MK_RELEASE, terminput.BTN_LEFT, 4 as u32, 2 as u32, 0 as u32, &b)
    check(same(&b, "\x1b[<0;5;3m"), "SGR release")
    terminput.encode_mouse(1000 as u32, true, terminput.MK_PRESS, terminput.BTN_WHEEL_UP, 0 as u32, 0 as u32, 0 as u32, &b)
    check(same(&b, "\x1b[<64;1;1M"), "SGR wheel up")
    check(!terminput.encode_mouse(1000 as u32, true, terminput.MK_MOVE, terminput.BTN_LEFT, 1 as u32, 1 as u32, 0 as u32, &b), "motion not reported in 1000")
    check(terminput.encode_mouse(1002 as u32, true, terminput.MK_MOVE, terminput.BTN_LEFT, 1 as u32, 1 as u32, 0 as u32, &b), "drag reported in 1002")
    rt.buf_clear(&b)
    terminput.encode_mouse(1000 as u32, false, terminput.MK_PRESS, terminput.BTN_LEFT, 0 as u32, 0 as u32, 0 as u32, &b)
    check(same(&b, "\x1b[M !!"), "X10 press")
    terminput.encode_paste(true, "a\x1bb\nc".p as u64, 5, &b)
    check(same(&b, "\x1b[200~ab\nc\x1b[201~"), "bracketed paste strips ESC")
    terminput.encode_paste(false, "a\nb".p as u64, 3, &b)
    check(same(&b, "a\rb"), "plain paste LF to CR")
    rt.buf_free(&b)
}

fn text_is(s: *mut termsel.Sel, g: *mut termgrid.Grid, want: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    termsel.sel_text(s, g, &b)
    let ok: bool = same(&b, want)
    rt.buf_free(&b)
    return ok
}

fn test_selection() {
    let t: *mut termstate.Term = term.term_new(10, 3, 10)
    term.term_feed_str(t, "foo bar\r\nbaz qux\r\n0123456789AB")
    let g: *mut termgrid.Grid = term.term_grid(t)
    var s: termsel.Sel = termsel.sel_new()
    termsel.sel_begin(&s, g, 0, 1, termsel.SEL_CHAR)
    termsel.sel_drag(&s, g, 1, 2)
    check(text_is(&s, g, "oo bar\nbaz"), "char selection across rows")
    check(termsel.sel_contains(&s, g, 0, 5) && !termsel.sel_contains(&s, g, 1, 3), "contains")
    termsel.sel_begin(&s, g, 0, 5, termsel.SEL_WORD)
    check(text_is(&s, g, "bar"), "word selection")
    termsel.sel_begin(&s, g, 2, 3, termsel.SEL_LINE)
    check(text_is(&s, g, "0123456789AB"), "line selection joins wrapped rows")
    term.term_feed_str(t, "\r\nx")
    termsel.sel_begin(&s, g, 1, 0, termsel.SEL_WORD)
    check(text_is(&s, g, "baz"), "selection survives scrolling")
    termsel.sel_clear(&s)
    check(!termsel.sel_active(&s), "cleared")
    term.term_free(t)
}

fn main() -> i32 {
    test_keys()
    test_mouse_and_paste()
    test_selection()
    say("term_input: ")
    if BAD == 0 { say("all checks passed\n") } else { say("FAILED\n") }
    if BAD > 0 { return 1 }
    return 0
}
