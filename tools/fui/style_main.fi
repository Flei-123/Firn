// SPDX-License-Identifier: MPL-2.0
// tools/fui/style_main.fi -- THE FIVE STYLE CASES, MEASURED AT THE PIXEL.
//
// Justin's point 8: "Automatic check: measure pixels for every
// variant (transparent = background unchanged; red = measured RGB
// value; theme = light/dark measurably different). The build fails
// if a variant does not take effect."
//
// That is exactly what this program does. It paints every variant
// onto a probe patch of known colour and READS THE PIXEL BACK. It is
// not the source that is checked but the result -- the same reason as
// in tools/fui/capicon_main.fi: the same drawing was silently lost
// twice, and both times the source looked fine.
//
// The probe patch is DELIBERATELY not a theme colour but a garish
// magenta. That makes "transparent" stand out: if it were really
// "paint the window colour over it" (Justin's point 4), the window
// colour would be here afterwards and not magenta.
import std.rt
import fui.core
import fui.style
import fui.theme

const W: usize = 200
const H: usize = 60

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, got: u32, want: u32) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var h1: [u8; 5] = " got "
    rt.buf_push_bytes(&t, (&h1[0]) as u64, 5)
    rt.buf_push_hex_u64(&t, got as u64, 6)
    var h2: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&h2[0]) as u64, 6)
    rt.buf_push_hex_u64(&t, want as u64, 6)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// The probe patch: garish magenta that occurs in no theme.
fn PROBE() -> u32 { return 16711935 as u32 }

// Paint a style set onto the probe patch and return the centre pixel.
// This is the one place where a widget paints its background
// -- exactly the way every widget does later.
fn render(p: u64, m: *mut theme.Theme, z: *mut style.StyleSet, state: u32,
    widget_default: u32) -> u32 {
    var zi: core.Target = core.target_new(p, W, H, W * 4)
    core.fill_all(&zi, PROBE())
    let f: u32 = style.resolve_bg(z, state, widget_default)
    // THE RULE: transparent means DO NOT PAINT.
    if style.color_is_visible(f) {
        let rgb: u32 = theme.color_from_style(m, f)
        core.round_fill(&zi, 10, 10, 100, 32, 8, rgb)
    }
    return core.get(&zi, 60, 26)
}

fn main(start: u64) -> i32 {
    let p: u64 = rt.heap_alloc(W * H * 4)
    if p == 0 as u64 {
        return 2
    }
    var m_light: theme.Theme = theme.theme_new(false)   // light
    var m_dark: theme.Theme = theme.theme_new(true)    // dark

    // ================================================== CASE 1
    // NO BACKGROUND. The probe patch must remain UNCHANGED.
    var z1: style.StyleSet = style.styleset_new()
    let s1: *mut style.Style = style.styleset_base(&z1)
    *s1 = style.style_set_bg(*s1, style.color_transparent())
    let r1: u32 = render(p, &m_light, &z1, style.STATE_NORMAL,
        style.color_token(style.TOK_BUTTON))
    var n1: [u8; 27] = "1 no background (unchanged)"
    report((&n1[0]) as u64, 27, r1 == PROBE(), r1, PROBE())

    // ================================================== CASE 2
    // BACKGROUND ONLY ON HOVER. Transparent normally, filled on hover.
    // This is the ONE-LINER Justin asked for.
    var z2: style.StyleSet = style.styleset_new()
    let s2: *mut style.Style = style.styleset_base(&z2)
    *s2 = style.style_set_bg(*s2, style.color_transparent())
    style.styleset_set_override(&z2, style.STATE_HOVER,
        style.override_set_bg(style.override_new(),
            style.color_token(style.TOK_ACCENT)))
    let r2a: u32 = render(p, &m_light, &z2, style.STATE_NORMAL,
        style.color_token(style.TOK_BUTTON))
    let r2b: u32 = render(p, &m_light, &z2, style.STATE_HOVER,
        style.color_token(style.TOK_BUTTON))
    let fh: *mut theme.Colors = theme.theme_colors(&m_light)
    var n2a: [u8; 29] = "2 hover only: normal is empty"
    report((&n2a[0]) as u64, 29, r2a == PROBE(), r2a, PROBE())
    var n2b: [u8; 29] = "2 hover only: hover is accent"
    report((&n2b[0]) as u64, 29, r2b == (*fh).accent, r2b, (*fh).accent)

    // ================================================== CASE 3
    // FIXED RED FILL. A literal, independent of the theme.
    var z3: style.StyleSet = style.styleset_new()
    let s3: *mut style.Style = style.styleset_base(&z3)
    *s3 = style.style_set_bg(*s3, style.color_literal(16711680 as u32))
    let r3h: u32 = render(p, &m_light, &z3, style.STATE_NORMAL,
        style.color_token(style.TOK_BUTTON))
    let r3d: u32 = render(p, &m_dark, &z3, style.STATE_NORMAL,
        style.color_token(style.TOK_BUTTON))
    var n3: [u8; 24] = "3 fixed red fill (light)"
    report((&n3[0]) as u64, 24, r3h == 16711680 as u32, r3h,
        16711680 as u32)
    // And it stays red when the theme changes -- that is the
    // difference between a literal and a token.
    var n3b: [u8; 33] = "3 red stays red in the dark theme"
    report((&n3b[0]) as u64, 33, r3d == 16711680 as u32, r3d,
        16711680 as u32)

    // ================================================== CASE 4
    // THEME DEPENDENT. The same style, two themes, TWO colours --
    // without changing anything on the style.
    var z4: style.StyleSet = style.styleset_new()
    let s4: *mut style.Style = style.styleset_base(&z4)
    *s4 = style.style_set_bg(*s4, style.color_token(style.TOK_BUTTON))
    let r4h: u32 = render(p, &m_light, &z4, style.STATE_NORMAL,
        style.color_transparent())
    let r4d: u32 = render(p, &m_dark, &z4, style.STATE_NORMAL,
        style.color_transparent())
    let fd: *mut theme.Colors = theme.theme_colors(&m_dark)
    var n4a: [u8; 35] = "4 token light = button colour light"
    report((&n4a[0]) as u64, 35, r4h == (*fh).button, r4h, (*fh).button)
    var n4b: [u8; 34] = "4 token dark  = button colour dark"
    report((&n4b[0]) as u64, 34, r4d == (*fd).button, r4d, (*fd).button)
    // THE ACTUAL PROMISE: measurably different.
    var n4c: [u8; 23] = "4 light and dark differ"
    report((&n4c[0]) as u64, 23, r4h != r4d, r4h, r4d)

    // ================================================== CASE 5
    // INHERITANCE: what the caller does NOT set comes from the widget.
    var z5: style.StyleSet = style.styleset_new()
    let r5: u32 = render(p, &m_light, &z5, style.STATE_NORMAL,
        style.color_literal(255 as u32))
    var n5: [u8; 27] = "5 not set -> widget default"
    report((&n5[0]) as u64, 27, r5 == 255 as u32, r5, 255 as u32)

    // And the state beats the base style.
    var z6: style.StyleSet = style.styleset_new()
    let s6: *mut style.Style = style.styleset_base(&z6)
    *s6 = style.style_set_bg(*s6, style.color_literal(65280 as u32))
    style.styleset_set_override(&z6, style.STATE_ACTIVE,
        style.override_set_bg(style.override_new(),
            style.color_literal(255 as u32)))
    let r6a: u32 = render(p, &m_light, &z6, style.STATE_NORMAL,
        style.color_transparent())
    let r6b: u32 = render(p, &m_light, &z6, style.STATE_ACTIVE,
        style.color_transparent())
    var n6a: [u8; 30] = "6 base style applies at normal"
    report((&n6a[0]) as u64, 30, r6a == 65280 as u32, r6a, 65280 as u32)
    var n6b: [u8; 24] = "6 state beats base style"
    report((&n6b[0]) as u64, 24, r6b == 255 as u32, r6b, 255 as u32)

    var t: rt.Buf = rt.buf_new()
    rt.buf_push(&t, 10 as u8)
    if G_ERRORS > 0 {
        var f: [u8; 23] = "STYLE IS NOT IN ORDER.\n"
        rt.buf_push_bytes(&t, (&f[0]) as u64, 23)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
        return 1
    }
    var o: [u8; 14] = "STYLE PASSED.\n"
    rt.buf_push_bytes(&t, (&o[0]) as u64, 14)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 0
}
