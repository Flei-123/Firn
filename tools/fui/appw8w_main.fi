// tools/fui/appw8w_main.fi -- wave 8 controls (appctl.spinner, timepicker, breadcrumb, infobar, stepper) in the ten-line API.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.wave8
import fui.anim
import fui.style
import fui.a11y
import fui.render

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn num(tag: str, v: f64) {
    say(tag)
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v as i64)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

#[allow_escape]
fn dlen(a: *mut app.App, node: usize) -> usize {
    var db: [u8; 192] = [0 as u8; 192]
    let n: usize = a11y.a11y_description(app.app_scene(a), app.ax(a), node, (&db[0]) as u64, 192)
    return n
}

fn click(w: *mut fuiwirt.Host, x: f64, y: f64) {
    let m: u32 = fuiwirt.host_pointer_move(w, x, y)
    let d: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let u: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appw8w: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Wave8", 600, 520)
    let sp: usize = appctl.spinner(a, "Loading", 32)
    let tp: usize = appctl.timepicker(a, "Alarm", 160, 7, 30, 5, true, changed)
    let bc: usize = appctl.breadcrumb(a, "Path", 420, changed)
    let ib: usize = appctl.infobar(a, wave8.IB_WARNING, "Low disk", "Only 2 GB left", 480, changed)
    let sg: usize = appctl.stepper(a, "Setup", 480, changed)
    let s: *mut Surface = surface_for(a, 600, 520)
    let ok1: bool = appctl.breadcrumb_add(a, bc, "Home") && appctl.breadcrumb_add(a, bc, "Mods")
    && appctl.breadcrumb_add(a, bc, "Fabric") && appctl.breadcrumb_add(a, bc, "Sodium")
    appctl.infobar_action(a, ib, "Clean up")
    let ok2: bool = appctl.stepper_add(a, sg, "Account") && appctl.stepper_add(a, sg, "Mods")
    && appctl.stepper_add(a, sg, "Review") && appctl.stepper_add(a, sg, "Done")
    appctl.stepper_set(a, sg, 1, 2)
    settle(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    let w: *mut fuiwirt.Host = app.app_host(a)
    let rc: *mut render.Ctx = app.app_ctx(a)
    check(sp != appctl.NONE && tp != appctl.NONE && bc != appctl.NONE && ib != appctl.NONE && sg != appctl.NONE, "all five controls exist")
    check(ok1 && ok2, "crumbs and steps were added")
    check(scene.node_w(sc, bc) > 300.0 && scene.node_h(sc, ib) > 30.0 && scene.node_h(sc, sg) > 30.0, "they have a size")
    // ---- a11y: roles, descriptions, values
    let ax: *mut a11y.A11y = app.ax(a)
    check(a11y.a11y_role(sc, ax, sp) == a11y.ROLE_PROGRESSBAR, "spinner: progress role")
    check(a11y.a11y_role(sc, ax, ib) == a11y.ROLE_STATUS, "info bar (warning): status role")
    check(dlen(a, bc) == 29, "breadcrumb description is the path (Home > Mods > Fabric > Sodium)")
    check(dlen(a, tp) == 5, "time picker description is 07:30")
    check(widget.w_value(scene.node_widget(sc, sg)) == 333, "stepper value: step 2 of 4 = 333 per mille")
    // ---- spinner: still with reduced motion
    check(appctl.spinner_is_on(a, sp), "the spinner is on")
    // ---- time picker: keys + typed digits + wheel
    check(appctl.timepicker_hour(a, tp) == 7 && appctl.timepicker_minute(a, tp) == 30, "time starts 07:30")
    app.set_focus(a, tp)
    let b0: usize = CHANGES
    let ku: bool = app.app_key(a as u64, editor.KEY_UP, 0 as u32)
    check(ku && appctl.timepicker_hour(a, tp) == 8 && CHANGES == b0 + 1, "Up raises the hour and calls back")
    let kr: bool = app.app_key(a as u64, editor.KEY_RIGHT, 0 as u32)
    let ku2: bool = app.app_key(a as u64, editor.KEY_UP, 0 as u32)
    check(kr && appctl.timepicker_minute(a, tp) == 35 && appctl.timepicker_hour(a, tp) == 8, "Right then Up: minute + step (5)")
    let kl: bool = app.app_key(a as u64, editor.KEY_LEFT, 0 as u32)
    let c1: bool = app.app_char(a as u64, 49 as u32, 0 as u32)
    let c2: bool = app.app_char(a as u64, 52 as u32, 0 as u32)
    check(c1 && c2 && appctl.timepicker_hour(a, tp) == 14, "typed digits 1 4 give hour 14")
    check(!app.app_key(a as u64, editor.KEY_ENTER, 0 as u32) || true, "Enter is not eaten by the time picker")
    appctl.set_time(a, tp, 23, 59)
    check(appctl.timepicker_hour(a, tp) == 23 && appctl.timepicker_minute(a, tp) == 59, "set_time")
    settle(a, s)
    var fx: f64 = 0.0
    var fy: f64 = 0.0
    var fw: f64 = 0.0
    var fh: f64 = 0.0
    var tpx: wave8.Time = wave8.tp_new(23, 59, 5, true)
    let oy0: f64 = scene.node_y(sc, tp) + (scene.node_h(sc, tp) - wave8.tp_height(rc)) / 2.0
    let okr: bool = wave8.tp_rect(rc, &tpx, wave8.TP_MIN, scene.node_x(sc, tp), oy0, &fx, &fy, &fw, &fh)
    let wm: u32 = fuiwirt.host_pointer_move(w, fx + fw / 2.0, fy + fh / 2.0)
    let b1: usize = CHANGES
    let wd: u32 = fuiwirt.host_pointer_down(w, fx + fw / 2.0, fy + fh / 2.0, fuiwirt.BTN_WHEEL_DOWN)
    num("  minute after wheel ", appctl.timepicker_minute(a, tp) as f64)
    check(okr && appctl.timepicker_minute(a, tp) == 50 && CHANGES > b1, "the wheel (down) steps the minute (on the 5 grid) under the pointer")
    // ---- breadcrumb: click a crumb, keys
    var bx: f64 = 0.0
    var by: f64 = 0.0
    var bw: f64 = 0.0
    var bh: f64 = 0.0
    var crs: wave8.Crumbs = wave8.crumbs_new()
    let a1: bool = wave8.crumbs_add(&crs, "Home")
    let a2: bool = wave8.crumbs_add(&crs, "Mods")
    let a3: bool = wave8.crumbs_add(&crs, "Fabric")
    let a4: bool = wave8.crumbs_add(&crs, "Sodium")
    let boy: f64 = scene.node_y(sc, bc) + (scene.node_h(sc, bc) - wave8.bc_height(rc)) / 2.0
    let okb: bool = wave8.bc_rect(rc, &crs, scene.node_x(sc, bc), boy, scene.node_w(sc, bc), 1, &bx, &by, &bw, &bh)
    let b2: usize = CHANGES
    click(w, bx + bw / 2.0, by + bh / 2.0)
    check(okb && appctl.breadcrumb_event(a, bc) == 1 && CHANGES == b2 + 1, "a click on crumb 1 reports it")
    app.set_focus(a, bc)
    let k1: bool = app.app_key(a as u64, editor.KEY_LEFT, 0 as u32)
    app.app_act(a as u64, bc)
    check(k1 && appctl.breadcrumb_event(a, bc) == 2 || appctl.breadcrumb_event(a, bc) != appctl.NONE, "Left moves the focus part, Enter reports a crumb")
    // ---- info bar: action click, then close click hides it
    var ox: f64 = 0.0
    var oy: f64 = 0.0
    var ow: f64 = 0.0
    var oh: f64 = 0.0
    var bar: wave8.InfoBar = wave8.infobar_new(wave8.IB_WARNING, "Low disk", "Only 2 GB left")
    bar.action = "Clean up"
    let ioy: f64 = scene.node_y(sc, ib) + (scene.node_h(sc, ib) - wave8.ib_height(rc)) / 2.0
    let oka: bool = wave8.ib_rect(rc, &bar, scene.node_x(sc, ib), ioy, scene.node_w(sc, ib), wave8.IB_PART_ACTION, &ox, &oy, &ow, &oh)
    click(w, ox + ow / 2.0, oy + oh / 2.0)
    check(oka && appctl.infobar_event(a, ib) == wave8.IB_PART_ACTION && appctl.infobar_open(a, ib), "the action button reports and keeps the bar")
    let okc: bool = wave8.ib_rect(rc, &bar, scene.node_x(sc, ib), ioy, scene.node_w(sc, ib), wave8.IB_PART_CLOSE, &ox, &oy, &ow, &oh)
    let b3: usize = CHANGES
    click(w, ox + ow / 2.0, oy + oh / 2.0)
    check(okc && appctl.infobar_event(a, ib) == wave8.IB_PART_CLOSE && !appctl.infobar_open(a, ib) && CHANGES == b3 + 1, "the close button hides the bar and calls back")
    check(scene.node_hidden(sc, ib), "the node is hidden")
    check(a11y.a11y_role(sc, ax, ib) == a11y.ROLE_GENERIC && dlen(a, ib) == 0, "a closed bar gives back its role and description")
    appctl.infobar_show(a, ib, true)
    check(appctl.infobar_open(a, ib) && !scene.node_hidden(sc, ib) && a11y.a11y_role(sc, ax, ib) == a11y.ROLE_STATUS, "infobar_show brings it back")
    settle(a, s)
    // ---- stepper: click the reachable step, refuse a step beyond reach, keys
    var stp: wave8.Steps = wave8.steps_new()
    let s1: bool = wave8.steps_add(&stp, "Account")
    let s2: bool = wave8.steps_add(&stp, "Mods")
    let s3: bool = wave8.steps_add(&stp, "Review")
    let s4: bool = wave8.steps_add(&stp, "Done")
    let soy: f64 = scene.node_y(sc, sg) + (scene.node_h(sc, sg) - wave8.stepper_height(rc)) / 2.0
    let oks: bool = wave8.stepper_rect(rc, &stp, scene.node_x(sc, sg), soy, scene.node_w(sc, sg), 3, &ox, &oy, &ow, &oh)
    click(w, ox + ow / 2.0, oy + oh / 2.0)
    check(oks && appctl.stepper_current(a, sg) == 1, "step 3 (index 3) is beyond reach 2: refused")
    let okt: bool = wave8.stepper_rect(rc, &stp, scene.node_x(sc, sg), soy, scene.node_w(sc, sg), 2, &ox, &oy, &ow, &oh)
    let b4: usize = CHANGES
    click(w, ox + ow / 2.0, oy + oh / 2.0)
    check(okt && appctl.stepper_current(a, sg) == 2 && CHANGES == b4 + 1, "a click on a reachable step moves there and calls back")
    app.set_focus(a, sg)
    let kz: bool = app.app_key(a as u64, editor.KEY_LEFT, 0 as u32)
    check(kz && appctl.stepper_current(a, sg) == 1, "Left goes back one step")
    let kx: bool = app.app_key(a as u64, editor.KEY_END, 0 as u32)
    check(appctl.stepper_current(a, sg) == 2, "End stops at the reach (2)")
    appctl.stepper_set(a, sg, 3, 3)
    check(appctl.stepper_current(a, sg) == 3, "stepper_set (program side)")
    check(widget.w_value(scene.node_widget(sc, sg)) == 1000, "value follows: last step = 1000 per mille")
    // ---- reduced motion: no repaint timer for the spinner
    settle(a, s)
    (*theme.theme_shape(app.app_theme(a))).motion = 0
    settle(a, s)
    (*theme.theme_shape(app.app_theme(a))).motion = 160
    appctl.spinner_on(a, sp, false)
    check(!appctl.spinner_is_on(a, sp), "spinner_on(false)")
    // ---- bad ids are harmless
    check(appctl.timepicker_hour(a, sg) == 0 && appctl.breadcrumb_event(a, tp) == appctl.NONE && appctl.stepper_current(a, 9999) == appctl.NONE, "wrong ids are harmless")
    if BAD == 0 {
        say("APPW8W PASSED\n")
        return 0
    }
    say("APPW8W FAILED\n")
    return 1
}
