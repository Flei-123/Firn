// SPDX-License-Identifier: MPL-2.0
import std.rt
import fui.uitext

static mut BAD: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn tp(t: str) -> u64 { return t.p as u64 }

fn main() -> i32 {
    let t: str = "hello world\nsecond line\näö end"
    let p: u64 = tp(t)
    let n: usize = t.n
    var s: usize = 0
    var e: usize = 0
    var moved: i64 = 0

    s = 3
    e = 3
    uitext.expand(uitext.U_WORD, p, n, &s, &e)
    check(s == 0 && e == 6, "word expand at 3 -> 'hello ' (trailing space)")
    s = 6
    e = 6
    uitext.expand(uitext.U_WORD, p, n, &s, &e)
    check(s == 6 && e == 11, "word expand at 6 -> 'world'")
    s = 11
    e = 11
    uitext.expand(uitext.U_WORD, p, n, &s, &e)
    check(s == 11 && e == 12, "newline is its own word")
    s = 14
    e = 14
    uitext.expand(uitext.U_LINE, p, n, &s, &e)
    check(s == 12 && e == 24, "line expand -> second line with its newline")
    s = 2
    e = 20
    uitext.expand(uitext.U_PARAGRAPH, p, n, &s, &e)
    check(s == 0 && e == 12, "paragraph expand shortens to the first paragraph")
    s = 5
    e = 5
    uitext.expand(uitext.U_DOCUMENT, p, n, &s, &e)
    check(s == 0 && e == n, "document expand")

    s = 25
    e = 25
    uitext.expand(uitext.U_CHAR, p, n, &s, &e)
    check(s == 24 && e == 26, "char expand over a two byte character")
    s = 26
    e = 26
    uitext.expand(uitext.U_CHAR, p, n, &s, &e)
    check(s == 26 && e == 28, "next two byte character")

    s = 0
    e = 0
    moved = uitext.move_range(uitext.U_CHAR, p, n, &s, &e, 3)
    check(moved == 3 && s == 3 && e == 3, "degenerate move by 3 chars")
    moved = uitext.move_range(uitext.U_CHAR, p, n, &s, &e, 0 - 10)
    check(moved == 0 - 3 && s == 0 && e == 0, "move back clamps at the start")
    s = 0
    e = 5
    moved = uitext.move_range(uitext.U_WORD, p, n, &s, &e, 1)
    check(moved == 1 && s == 6 && e == 11, "range move by one word")
    s = 24
    e = 26
    moved = uitext.move_range(uitext.U_CHAR, p, n, &s, &e, 100)
    check(moved > 0 && e == n && s < e, "non degenerate range never collapses onto the end")
    s = 0
    e = 0
    moved = uitext.move_range(uitext.U_CHAR, p, n, &s, &e, 1000)
    check(s == n && e == n && moved == 30, "degenerate move to the end counts every char")

    s = 2
    e = 8
    moved = uitext.move_endpoint(uitext.U_CHAR, p, n, &s, &e, uitext.EP_END, 2)
    check(moved == 2 && s == 2 && e == 10, "move end by 2 chars")
    moved = uitext.move_endpoint(uitext.U_CHAR, p, n, &s, &e, uitext.EP_START, 20)
    check(moved == 20 && s == 22 && e == 22, "start past end collapses the end along")
    s = 5
    e = 9
    moved = uitext.move_endpoint(uitext.U_CHAR, p, n, &s, &e, uitext.EP_END, 0 - 10)
    check(moved == 0 - 9 && e == 0 && s == 0, "end before start collapses the start along")

    check(uitext.compare_endpoints(1, 5, uitext.EP_START, 1, 9, uitext.EP_START) == 0, "compare starts equal")
    check(uitext.compare_endpoints(1, 5, uitext.EP_END, 1, 9, uitext.EP_END) < 0, "compare ends less")
    check(uitext.compare_endpoints(4, 9, uitext.EP_START, 1, 5, uitext.EP_END) < 0, "compare start vs end")

    var at: usize = 0
    let q: str = "WORLD"
    check(uitext.find_text(p, 0, n, tp(q), q.n, false, true, &at) && at == 6, "find ignoring case")
    check(!uitext.find_text(p, 0, n, tp(q), q.n, false, false, &at), "find case sensitive misses")
    let q2: str = "l"
    check(uitext.find_text(p, 0, n, tp(q2), q2.n, true, false, &at) && at == 19, "find backward gives the last match")
    check(!uitext.find_text(p, 0, 4, tp(q), q.n, false, true, &at), "find outside the range misses")

    check(uitext.is_boundary(uitext.U_CHAR, p, n, 0) && uitext.is_boundary(uitext.U_CHAR, p, n, n), "start and end are boundaries")
    check(!uitext.is_boundary(uitext.U_CHAR, p, n, 25), "inside a two byte character is no boundary")

    say("UITEXT bad=")
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, BAD as i64)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    say("\n")
    if BAD == 0 {
        say("UITEXT PASSED\n")
        return 0
    }
    return 1
}
