// tools/fui/appw5_main.fi -- the wave 5 controls in the ten-line API (appctl.rating / segmented / chips / skeleton / chart / pager).
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.wave5
import fui.render


static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn num(tag: str, v: f64) {
    say(tag)
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v as i64)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

static mut LAST_ID: usize = 0
static mut PAGE_CALLS: usize = 0

fn pdraw(a: *mut app.App, rc: *mut render.Ctx, page: usize, x: f64, y: f64, w: f64, h: f64) {
    PAGE_CALLS = PAGE_CALLS + 1
}

fn changed2(a: *mut app.App, id: usize) {
    LAST_ID = id
    CHANGES = CHANGES + 1
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

fn click(w: *mut fuiwirt.Host, x: f64, y: f64) {
    let m: u32 = fuiwirt.host_pointer_move(w, x, y)
    let d: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let u: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appw5: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Wave5", 600, 700)
    let rt5: usize = appctl.rating(a, "Quality", 5, true, 3, changed2)
    let sg: usize = appctl.segmented(a, "View", 240, changed2)
    let s1: bool = appctl.segment_add(a, sg, "Day")
    let s2: bool = appctl.segment_add(a, sg, "Week")
    let s3: bool = appctl.segment_add(a, sg, "Month")
    let ch: usize = appctl.chips(a, "Tags", 400, 40, changed2)
    let c1: bool = appctl.chip_add(a, ch, "rust", true)
    let c2: bool = appctl.chip_add(a, ch, "firn", true)
    let c3: bool = appctl.chip_add(a, ch, "ui", false)
    let sk: usize = appctl.skeleton(a, 240, 60, 3)
    let gr: usize = appctl.chart(a, "Load", wave5.CH_AREA, 240, 80)
    var vals: [f64; 200] = [0.0; 200]
    var q: usize = 0
    while q < 200 {
        vals[q] = ((q % 17) as f64) + 1.0
        q = q + 1
    }
    appctl.chart_set(a, gr, &vals[0], 200)
    let pg: usize = appctl.pager(a, "Pages", 3, 320, 160, pdraw, changed2)
    let s: *mut Surface = surface_for(a, 600, 700)
    settle(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    let w: *mut fuiwirt.Host = app.app_host(a)
    check(rt5 != appctl.NONE && sg != appctl.NONE && ch != appctl.NONE && sk != appctl.NONE && gr != appctl.NONE && pg != appctl.NONE, "all six controls exist")
    check(s1 && s2 && s3 && c1 && c2 && c3, "segments and chips added")
    check(appctl.rating_value(a, rt5) == 3, "rating starts at 3 steps")
    check(appctl.segmented_selected(a, sg) == 0, "first segment selected")
    check(appctl.chip_count(a, ch) == 3, "three chips")
    check(scene.node_w(sc, rt5) > 100.0 && scene.node_h(sc, rt5) > 20.0, "rating has a size")
    // ---- rating: click on the fourth star (whole step 7 or 8 of 10)
    var rx: f64 = scene.node_x(sc, rt5) + 3.0 * 28.0 + 20.0
    var ry: f64 = scene.node_y(sc, rt5) + scene.node_h(sc, rt5) / 2.0
    click(w, rx, ry)
    settle(a, s)
    num("  rating after click ", appctl.rating_value(a, rt5) as f64)
    check(appctl.rating_value(a, rt5) >= 7 && appctl.rating_value(a, rt5) <= 8, "click on star 4 sets 7..8 half steps")
    check(LAST_ID == rt5, "callback names the rating")
    let before: usize = CHANGES
    app.set_focus(a, rt5)
    let k1: bool = app.app_key(a as u64, editor.KEY_HOME, 0 as u32)
    check(appctl.rating_value(a, rt5) == 0, "Home clears the rating")
    let k2: bool = app.app_key(a as u64, editor.KEY_RIGHT, 0 as u32)
    check(appctl.rating_value(a, rt5) == 1, "Right adds a half star")
    check(CHANGES > before, "keys call back")
    appctl.set_rating_value(a, rt5, 99)
    check(appctl.rating_value(a, rt5) == 10, "set clamps to the maximum")
    // ---- segmented: click on the third segment
    var sx: f64 = scene.node_x(sc, sg) + scene.node_w(sc, sg) * 5.0 / 6.0
    var sy: f64 = scene.node_y(sc, sg) + scene.node_h(sc, sg) / 2.0
    click(w, sx, sy)
    settle(a, s)
    check(appctl.segmented_selected(a, sg) == 2, "click selects the third segment")
    app.set_focus(a, sg)
    let k3: bool = app.app_key(a as u64, editor.KEY_LEFT, 0 as u32)
    check(appctl.segmented_selected(a, sg) == 1, "Left selects the second")
    // ---- chips: select with a click on the body, remove with Delete on a closable chip
    var cx: f64 = scene.node_x(sc, ch) + 24.0
    var cy: f64 = scene.node_y(sc, ch) + 16.0
    click(w, cx, cy)
    settle(a, s)
    check(appctl.chip_selected(a, ch, 0), "click selects the first chip")
    check(!appctl.chip_was_removed(a, ch), "that was not a removal")
    app.set_focus(a, ch)
    let k4: bool = app.app_key(a as u64, editor.KEY_DELETE, 0 as u32)
    check(appctl.chip_count(a, ch) == 2, "Delete removes the focused closable chip")
    check(appctl.chip_was_removed(a, ch), "and says so")
    // ---- chart + skeleton paint
    check(scene.node_w(sc, gr) > 100.0, "chart has a size")
    // ---- pager: keys, glide, drag
    PAGE_CALLS = 0
    settle(a, s)
    check(PAGE_CALLS >= 1, "the visible page is asked for")
    app.set_focus(a, pg)
    let k5: bool = app.app_key(a as u64, editor.KEY_RIGHT, 0 as u32)
    check(appctl.pager_page(a, pg) == 1, "Right shows page 1")
    var t: i64 = fuiwirt.host_now(w)
    var g: usize = 0
    while g < 60 {
        t = t + 16
        fuiwirt.host_tick(w, t)
        g = g + 1
    }
    settle(a, s)
    appctl.pager_show(a, pg, 0)
    g = 0
    while g < 60 {
        t = t + 16
        fuiwirt.host_tick(w, t)
        g = g + 1
    }
    check(appctl.pager_page(a, pg) == 0, "pager_show jumps back")
    var px: f64 = scene.node_x(sc, pg) + scene.node_w(sc, pg) * 0.8
    var py: f64 = scene.node_y(sc, pg) + scene.node_h(sc, pg) * 0.4
    let dm: u32 = fuiwirt.host_pointer_move(w, px, py)
    let dd: u32 = fuiwirt.host_pointer_down(w, px, py, fuiwirt.BTN_LEFT)
    t = t + 16
    fuiwirt.host_tick(w, t)
    let dm2: u32 = fuiwirt.host_pointer_move(w, px - 150.0, py)
    t = t + 16
    fuiwirt.host_tick(w, t)
    let dm3: u32 = fuiwirt.host_pointer_move(w, px - 250.0, py)
    t = t + 16
    fuiwirt.host_tick(w, t)
    let du: u32 = fuiwirt.host_pointer_up(w, px - 250.0, py, fuiwirt.BTN_LEFT)
    check(appctl.pager_page(a, pg) == 1, "a swipe to the left shows page 1")
    // a click on the third dot
    settle(a, s)
    if BAD == 0 {
        say("APPW5 PASSED\n")
        return 0
    }
    say("APPW5 FAILED\n")
    return 1
}
