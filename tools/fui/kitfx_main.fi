// SPDX-License-Identifier: MPL-2.0
// tools/fui/kitfx_main.fi -- CHECK OF lib/fui/kitfx.fi (website look: ground, glow button, pictures, strings), the soft nav look of
// lib/fui/kit.fi, the radial light with a centre outside the box (painter) and the real bold face (plat/sysfont). No window.
//
//     firnc -o /tmp/kitfx tools/fui/kitfx_main.fi && /tmp/kitfx     (last line: KITFX PASSED / KITFX FAILED)
import std.rt
import paint.canvas
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.style
import fui.kit
import fui.kitfx
import fui.kitcolor
import fui.lucide
import plat.sysfont

static mut BAD: usize = 0
static mut CHECKS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    kitcolor.kit_theme(&(*p).m, dark)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn tok(p: *mut Page, t: u32) -> u32 {
    return theme.opaque(render.color_of(&(*p).c, style.color_token(t)))
}

fn px(p: *mut Page, x: f64, y: f64) -> u32 {
    return canvas.canvas_get(&(*p).cv, x as usize, y as usize)
}

fn clear(p: *mut Page) {
    canvas.canvas_clear(&(*p).cv, tok(p, style.TOK_BASE))
}

fn main() -> i32 {
    var fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("no system font\n")
        return 2
    }
    say("== strings\n")
    let s: str = kitfx.cat3("MC ", "1.21.4", "")
    check(s.n == 9 && kitfx.str_eq(s, "MC 1.21.4"), "cat3 joins")
    let s2: str = kitfx.cat3(s, " - ", "0.16.9")
    check(kitfx.str_eq(s2, "MC 1.21.4 - 0.16.9") && kitfx.str_eq(s, "MC 1.21.4"), "cat3 keeps the earlier result")
    check(!kitfx.str_eq("forge", "quilt") && !kitfx.str_eq("fabric", "fab"), "str_eq tells apart same / different length")

    say("== ground (dark)\n")
    let p: *mut Page = page_new(1100, 700, true, fs as u64)
    let c: *mut render.Ctx = &(*p).c
    clear(p)
    let base: u32 = tok(p, style.TOK_BASE)
    kitfx.ground_draw(c, 0.0, 0.0, 1100.0, 700.0, 0x1bd96a as u32, 0x2b78ff as u32)
    check(px(p, 5.0, 5.0) != base, "the green light in the top left corner reaches the box")
    check(px(p, 1095.0, 120.0) != base, "the blue light in from the right")
    check(px(p, 700.0, 690.0) == base, "nothing far from every light")
    var grid: usize = 0
    var gy: f64 = 8.0
    while gy < 60.0 {
        // x = 448 is a vertical line (7 cells of 64), x = 440 is between lines
        if px(p, 448.0, gy) != px(p, 440.0, gy) { grid = grid + 1 }
        gy = gy + 1.0
    }
    check(grid > 20, "a grid line shows near the top (the column of a cell edge differs from the one beside it)")
    // a centre outside the box left of it: must end and paint only inside (regression: a negative span wrapped to a huge usize)
    clear(p)
    painter.round_rect_radial(&(*p).z, 0.0, 0.0, 100.0, 100.0, 0.0, 0x80ffffff as u32, -80.0, 50.0, 100.0, 60.0)
    check(px(p, 3.0, 50.0) != base, "radial light with its centre outside the box paints the edge nearby")
    check(px(p, 40.0, 50.0) == base, "and nothing where it does not reach")

    say("== ground (light page: none)\n")
    let q: *mut Page = page_new(400, 300, false, fs as u64)
    clear(q)
    let lb: u32 = tok(q, style.TOK_BASE)
    kitfx.ground_draw(&(*q).c, 0.0, 0.0, 400.0, 300.0, 0x1bd96a as u32, 0x2b78ff as u32)
    check(px(q, 5.0, 5.0) == lb && px(q, 100.0, 5.0) == lb, "a light page is left alone")

    say("== glow button\n")
    clear(p)
    kitfx.button_glow_draw(c, 100.0, 100.0, 90.0, 50.0, "+ New", "profile", false)
    check(px(p, 105.0, 105.0) != px(p, 185.0, 145.0), "gradient: the corners differ")
    check(px(p, 145.0, 158.0) != base, "glow under the button")
    check(px(p, 145.0, 200.0) == base, "glow ends")
    clear(p)
    kitfx.button_flat_draw(c, 300.0, 100.0, 90.0, 38.0, "Import", false)
    check(px(p, 304.0, 119.0) != base, "flat button has its own ground")

    say("== nav soft look\n")
    var items: [kit.NavItem; 3] = [
        kit.NavItem { icon: lucide.HOUSE, label: "Home", badge: 0, header: false },
        kit.NavItem { icon: lucide.STAR, label: "Mods", badge: 0, header: false },
        kit.NavItem { icon: lucide.SETTINGS, label: "Settings", badge: 0, header: false }]
    let ip: *mut kit.NavItem = (&items[0]) as *mut kit.NavItem
    let dy0: f64 = kit.nav_item_y(c, ip, 0)
    let dh0: f64 = kit.nav_item_h(c, ip)
    kit.nav_look(12, 18, 42, 14, true)
    check(kit.nav_item_y(c, ip, 0) == 18.0 && kit.nav_item_h(c, ip) == 42.0 && kit.nav_item_y(c, ip, 1) == 64.0, "rows start at 18, are 42 high, pitch 46")
    clear(p)
    kit.nav_draw(c, ip, 3, 0, kit.NONE, false, 0.0, 0.0, 218.0, 400.0, false)
    check(px(p, 120.0, 25.0) == tok(p, style.TOK_BUTTON), "active row is a button-colour ground, not the selection fill")
    check(px(p, 13.0, 40.0) == tok(p, style.TOK_ACCENT) || px(p, 13.0, 40.0) != tok(p, style.TOK_BUTTON), "accent bar at the row's left edge")
    check(kit.nav_hit(c, ip, 3, 0.0, 0.0, 218.0, false, 100.0, 70.0) == 1, "hit test follows the new rows")
    kit.nav_look(14, 29, 37, 14, true)
    kit.nav_gap(2)
    check(kit.nav_item_y(c, ip, 1) == 68.0, "nav_gap(2): pitch 39")
    kit.nav_look(8, 8, 40, 12, false)
    check(kit.nav_item_y(c, ip, 1) == 52.0, "nav_look puts the gap back to 4")
    check(kit.nav_item_y(c, ip, 0) == dy0 && kit.nav_item_h(c, ip) == dh0, "nav_look(8, 8, 40, 12, false) is the default again")

    say("== real bold face\n")
    let w0: f64 = kit.text_width(c, 20.0, 700, "Your profiles")
    let bs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if sysfont.sysfont_load_bold(bs) {
        painter.painter_set_weight_face(&(*p).z, 0, 700, bs as u64)
        let w1: f64 = kit.text_width(c, 20.0, 700, "Your profiles")
        check(w1 > w0 + 4.0, "a real bold face is wider than the faux bold")
    } else {
        say("  (no bold sibling of the system font here: skipped)\n")
    }

    say("== picture\n")
    check(!kitfx.pic_ok(kitfx.pic_load("/nonexistent/none.jpg")), "a missing file is not a picture")

    if BAD == 0 {
        say("KITFX PASSED\n")
        return 0
    }
    say("KITFX FAILED\n")
    return 1
}
