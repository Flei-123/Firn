// SPDX-License-Identifier: MPL-2.0
// tools/fui/pagelook_main.fi -- THE PAGE LOOK, PROVEN (30.09.2026).
//
// What a modern web page takes for granted, as fUi building blocks, each
// checked on real pixels of a real canvas with a real font:
//
//   1. background gradient (style.SF_BG_GRAD): both ends, the middle
//   2. light in a box (style.SF_BG_GLOW): bright in the centre, gone at
//      the rim
//   3. box shadow / glow (style.SF_BOX_SHADOW): under the box, not in it
//   4. fluid font size (style.SF_FLUID + scene_set_view): clamp at both
//      ends, linear between
//   5. paragraphs (node_set_text_wrap): break at the column, height =
//      lines x line height, shrink in a row, re-flow when narrower
//   6. group opacity (node_set_opacity): the group is ONE picture -- an
//      overlap shows the top child only, at the group's opacity
//   7. group offset (node_set_offset): painted there, laid out here
//   8. still + live (scene_draw_still / scene_draw_live over a
//      layer.Bake) = everything painted, pixel for pixel
import std.rt
import paint.canvas
import font.metrics
import fui.style
import fui.theme
import fui.widget
import fui.flex
import fui.painter
import fui.render
import fui.sheet
import fui.scene
import fui.layer

const FONTSET_BYTES: usize = 4096
const CW: usize = 400
const CH: usize = 300

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 50 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    var w: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&w[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn ch_r(p: u32) -> i64 { return ((p >> 16) & 255 as u32) as i64 }
fn ch_g(p: u32) -> i64 { return ((p >> 8) & 255 as u32) as i64 }
fn ch_b(p: u32) -> i64 { return (p & 255 as u32) as i64 }

fn absi(v: i64) -> i64 {
    if v < 0 {
        return 0 - v
    }
    return v
}

fn rule(sh: *mut sheet.Sheet, k: u32, st: style.Style) {
    sheet.sheet_rule(sh, sheet.sel_class(k), st)
}

// A scene with one box of `st` at (x, y, w, h) on black, painted.
fn one_box(c: *mut render.Ctx, cv: *mut canvas.Canvas, st: style.Style,
    x: f64, y: f64, w: f64, h: f64) {
    canvas.canvas_clear(cv, theme.opaque(0))
    var sc: scene.Scene = scene.scene_new()
    let root: usize = scene.scene_add(&sc, scene.SCENE_NONE, scene.N_BOX)
    let b: usize = scene.scene_add(&sc, root, scene.N_BOX)
    scene.node_add_class(&sc, b, 7 as u32)
    var sh: sheet.Sheet = sheet.sheet_new()
    rule(&sh, 7 as u32, st)
    scene.scene_style(&sc, &sh)
    scene.scene_measure(&sc, c)
    scene.scene_layout(&sc, c, 0.0, 0.0, CW as f64, CH as f64)
    // placed by hand: the test is about the paint, not the layout
    let nd: *mut scene.Node = scene.scene_node(&sc, b)
    (*nd).x = x
    (*nd).y = y
    (*nd).w = w
    (*nd).h = h
    widget.w_place(scene.node_widget(&sc, b), x, y, w, h)
    scene.scene_draw_subtree(&sc, c, b)
}

// Sum of |a - b| over all pixels of two canvases.
fn diff(a: *mut canvas.Canvas, b: *mut canvas.Canvas) -> i64 {
    var n: i64 = 0
    var y: usize = 0
    while y < CH {
        var x: usize = 0
        while x < CW {
            let p: u32 = canvas.canvas_get(a, x, y)
            let q: u32 = canvas.canvas_get(b, x, y)
            if p != q {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn main(start: u64) -> i32 {
    var fbuf: rt.Buf = rt.buf_new()
    var fpath: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
    let has_font: bool = rt.read_file((&fpath[0]) as u64, &fbuf)
    let fsp: *mut metrics.FontSet =
    rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 || !has_font {
        return 3
    }
    *fsp = metrics.fontset_new()
    if !metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
        return 3
    }
    let fm: u64 = fsp as u64
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, CW, CH) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, CW, CH) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(true)
    var c: render.Ctx = render.ctx_new(&m, &z)

    // ================================================ 1. GRADIENT
    var s1: style.Style = style.style_new()
    s1 = style.style_set_bg_gradient(s1, style.color_literal(16711680 as u32),
        255, style.color_literal(255 as u32), 255, 0, 1000)
    one_box(&c, &cv, s1, 100.0, 50.0, 200.0, 200.0)
    let g_top: u32 = canvas.canvas_get(&cv, 200, 50)
    let g_bot: u32 = canvas.canvas_get(&cv, 200, 249)
    let g_mid: u32 = canvas.canvas_get(&cv, 200, 150)
    let g_out: u32 = canvas.canvas_get(&cv, 50, 150)
    var n1: [u8; 26] = "1 gradient: red at the top"
    report((&n1[0]) as u64, 26, ch_r(g_top) >= 250 && ch_b(g_top) <= 5, (ch_r(g_top)) as i64, (255) as i64)
    var n2: [u8; 30] = "1 gradient: blue at the bottom"
    report((&n2[0]) as u64, 30, ch_b(g_bot) >= 250 && ch_r(g_bot) <= 5, (ch_b(g_bot)) as i64, (255) as i64)
    var n3: [u8; 39] = "1 gradient: half and half in the middle"
    report((&n3[0]) as u64, 39, absi(ch_r(g_mid) - 128) <= 3 && absi(ch_b(g_mid) - 127) <= 3, (ch_r(g_mid)) as i64, (128) as i64)
    var n4: [u8; 35] = "1 gradient: nothing outside the box"
    report((&n4[0]) as u64, 35, g_out == theme.opaque(0), (ch_r(g_out)) as i64, (0) as i64)

    // diagonal, fading out: the lower right end is transparent
    var s1b: style.Style = style.style_new()
    s1b = style.style_set_bg_gradient(s1b, style.color_literal(16777215 as u32),
        255, style.color_literal(16777215 as u32), 0, 1000, 1000)
    s1b = style.style_set_radius(s1b, 20)
    one_box(&c, &cv, s1b, 100.0, 50.0, 200.0, 200.0)
    let d_a: u32 = canvas.canvas_get(&cv, 110, 60)
    let d_b: u32 = canvas.canvas_get(&cv, 290, 240)
    let d_corner: u32 = canvas.canvas_get(&cv, 101, 51)
    var n5: [u8; 34] = "1 diagonal fade: bright upper left"
    report((&n5[0]) as u64, 34, ch_r(d_a) >= 230, (ch_r(d_a)) as i64, (255) as i64)
    var n6: [u8; 33] = "1 diagonal fade: gone lower right"
    report((&n6[0]) as u64, 33, ch_r(d_b) <= 20, (ch_r(d_b)) as i64, (0) as i64)
    var n7: [u8; 28] = "1 the radius cuts the corner"
    report((&n7[0]) as u64, 28, ch_r(d_corner) <= 10, (ch_r(d_corner)) as i64, (0) as i64)

    // ================================================ 2. GLOW
    var s2: style.Style = style.style_new()
    s2 = style.style_set_bg(s2, style.color_literal(0 as u32))
    s2 = style.style_set_bg_glow(s2, style.color_literal(16711680 as u32),
        500, 500, 500, 500, 1000)
    one_box(&c, &cv, s2, 100.0, 50.0, 200.0, 200.0)
    let l_mid: u32 = canvas.canvas_get(&cv, 200, 150)
    let l_half: u32 = canvas.canvas_get(&cv, 250, 150)
    let l_rim: u32 = canvas.canvas_get(&cv, 299, 150)
    let l_corner: u32 = canvas.canvas_get(&cv, 105, 55)
    var n8: [u8; 26] = "2 glow: full in the centre"
    report((&n8[0]) as u64, 26, ch_r(l_mid) >= 250, (ch_r(l_mid)) as i64, (255) as i64)
    var n9: [u8; 38] = "2 glow: (1 - d^2)^2 at half the radius"
    report((&n9[0]) as u64, 38, absi(ch_r(l_half) - 143) <= 3, (ch_r(l_half)) as i64, (143) as i64)
    var n10: [u8; 23] = "2 glow: gone at the rim"
    report((&n10[0]) as u64, 23, ch_r(l_rim) <= 3, (ch_r(l_rim)) as i64, (0) as i64)
    var n11: [u8; 29] = "2 glow: nothing in the corner"
    report((&n11[0]) as u64, 29, ch_r(l_corner) == 0, (ch_r(l_corner)) as i64, (0) as i64)

    // ================================================ 3. BOX SHADOW
    var s3: style.Style = style.style_new()
    s3 = style.style_set_bg(s3, style.color_literal(3355443 as u32))
    s3 = style.style_set_box_shadow(s3, 0, 24, style.color_literal(16711680 as u32), 200)
    s3 = style.style_set_radius(s3, 10)
    one_box(&c, &cv, s3, 150.0, 100.0, 100.0, 100.0)
    let h_in: u32 = canvas.canvas_get(&cv, 200, 150)
    let h_near: u32 = canvas.canvas_get(&cv, 200, 204)
    let h_far: u32 = canvas.canvas_get(&cv, 200, 260)
    var n12: [u8; 35] = "3 shadow: the box is its own colour"
    report((&n12[0]) as u64, 35, ch_r(h_in) == 51 && ch_g(h_in) == 51, (ch_r(h_in)) as i64, (51) as i64)
    var n13: [u8; 34] = "3 shadow: red glow next to the box"
    report((&n13[0]) as u64, 34, ch_r(h_near) >= 40 && ch_g(h_near) == 0, (ch_r(h_near)) as i64, (100) as i64)
    var n14: [u8; 26] = "3 shadow: gone further out"
    report((&n14[0]) as u64, 26, ch_r(h_far) == 0, (ch_r(h_far)) as i64, (0) as i64)

    // ================================================ 4. FLUID FONT SIZE
    // clamp(20, 10 + 4vw, 60)
    var s4: style.Style = style.style_new()
    s4 = style.style_set_font_fluid(s4, 20, 10, 40, 60)
    var sc4: scene.Scene = scene.scene_new()
    let r4: usize = scene.scene_add(&sc4, scene.SCENE_NONE, scene.N_BOX)
    let t4: usize = scene.scene_add(&sc4, r4, scene.N_TEXT)
    let u4: usize = scene.scene_add(&sc4, t4, scene.N_TEXT)
    scene.node_add_class(&sc4, t4, 9 as u32)
    var sh4: sheet.Sheet = sheet.sheet_new()
    rule(&sh4, 9 as u32, s4)
    scene.scene_set_view(&sc4, 1000.0)
    scene.scene_style(&sc4, &sh4)
    let f1000: i64 = (*scene.node_style(&sc4, t4)).font_px as i64
    let f_kid: i64 = (*scene.node_style(&sc4, u4)).font_px as i64
    scene.scene_set_view(&sc4, 200.0)
    scene.scene_style(&sc4, &sh4)
    let f200: i64 = (*scene.node_style(&sc4, t4)).font_px as i64
    scene.scene_set_view(&sc4, 2000.0)
    scene.scene_style(&sc4, &sh4)
    let f2000: i64 = (*scene.node_style(&sc4, t4)).font_px as i64
    scene.scene_set_view(&sc4, 0.0)
    scene.scene_style(&sc4, &sh4)
    let f0: i64 = (*scene.node_style(&sc4, t4)).font_px as i64
    var n15: [u8; 29] = "4 fluid: 10 + 4% of 1000 = 50"
    report((&n15[0]) as u64, 29, f1000 == 50, (f1000) as i64, (50) as i64)
    var n16: [u8; 38] = "4 fluid: the child inherits the result"
    report((&n16[0]) as u64, 38, f_kid == 50, (f_kid) as i64, (50) as i64)
    var n17: [u8; 42] = "4 fluid: narrow view clamps to the minimum"
    report((&n17[0]) as u64, 42, f200 == 20, (f200) as i64, (20) as i64)
    var n18: [u8; 40] = "4 fluid: wide view clamps to the maximum"
    report((&n18[0]) as u64, 40, f2000 == 60, (f2000) as i64, (60) as i64)
    var n19: [u8; 31] = "4 fluid: no view -> the maximum"
    report((&n19[0]) as u64, 31, f0 == 60, (f0) as i64, (60) as i64)

    // ================================================ 5. PARAGRAPHS
    var para: [u8; 120] = "Every modern page has paragraphs that break at the edge of their column and grow downwards as the window gets narrower!."
    var sh5: sheet.Sheet = sheet.sheet_new()
    var s5: style.Style = style.style_new()
    s5 = style.style_set_font(s5, 0, 16)
    s5 = style.style_set_line_height_px(s5, 24)
    s5 = style.style_set_pad(s5, 0, 0)
    rule(&sh5, 11 as u32, s5)
    var sc5: scene.Scene = scene.scene_new()
    let r5: usize = scene.scene_add(&sc5, scene.SCENE_NONE, scene.N_BOX)
    scene.node_set_flex(&sc5, r5, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_START)
    let col5: usize = scene.scene_add(&sc5, r5, scene.N_BOX)
    scene.node_set_flex(&sc5, col5, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_START)
    scene.node_set_padding(&sc5, col5, 10, 0, 10, 0)
    scene.node_set_size(&sc5, col5, 300.0, 0.0)
    let p5: usize = scene.scene_add(&sc5, col5, scene.N_TEXT)
    scene.node_add_class(&sc5, p5, 11 as u32)
    scene.node_set_text(&sc5, p5, (&para[0]) as u64, 120)
    scene.node_set_text_wrap(&sc5, p5, 20)
    let after5: usize = scene.scene_add(&sc5, col5, scene.N_BOX)
    scene.node_set_size(&sc5, after5, 10.0, 10.0)
    scene.scene_style(&sc5, &sh5)
    scene.scene_measure(&sc5, &c)
    scene.scene_layout(&sc5, &c, 0.0, 0.0, CW as f64, CH as f64)
    let lines5: i64 = scene.node_text_lines(&sc5, p5) as i64
    let w5: i64 = scene.node_w(&sc5, p5) as i64
    let h5: i64 = scene.node_h(&sc5, p5) as i64
    let y_after: i64 = scene.node_y(&sc5, after5) as i64
    let reflow5: i64 = scene.scene_reflows(&sc5) as i64
    // what the painter says for 280 pixels
    var run: painter.TextRun = painter.run_new(16.0)
    let want_lines: i64 = painter.run_line_count(&z, &run, (&para[0]) as u64,
        120, 280.0, 20) as i64
    var n20: [u8; 42] = "5 paragraph: breaks at the column (280 px)"
    report((&n20[0]) as u64, 42, w5 <= 280 && w5 >= 200, (w5) as i64, (280) as i64)
    var n21: [u8; 46] = "5 paragraph: as many lines as the painter says"
    report((&n21[0]) as u64, 46, lines5 == want_lines && lines5 >= 3, (lines5) as i64, (want_lines) as i64)
    var n22: [u8; 32] = "5 paragraph: height = lines x 24"
    report((&n22[0]) as u64, 32, h5 == lines5 * 24, (h5) as i64, (lines5 * 24) as i64)
    var n23: [u8; 41] = "5 paragraph: what follows starts below it"
    report((&n23[0]) as u64, 41, y_after == h5, (y_after) as i64, (h5) as i64)
    var n24: [u8; 38] = "5 paragraph: one extra round of layout"
    report((&n24[0]) as u64, 38, reflow5 == 1, (reflow5) as i64, (1) as i64)

    scene.scene_draw(&sc5, &c)
    var n25: [u8; 42] = "5 paragraph: no size drifts while painting"
    report((&n25[0]) as u64, 42, scene.scene_size_drift(&sc5) == 0, (scene.scene_size_drift(&sc5)) as i64, (0) as i64)

    // THE NEXT FRAME describes the same tree anew (scene_reset): the
    // paragraph keeps the width of the last layout as its first guess --
    // no extra round, the same lines, the same place for what follows
    scene.scene_reset(&sc5)
    let r5b: usize = scene.scene_add(&sc5, scene.SCENE_NONE, scene.N_BOX)
    scene.node_set_flex(&sc5, r5b, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_START)
    let col5b: usize = scene.scene_add(&sc5, r5b, scene.N_BOX)
    scene.node_set_flex(&sc5, col5b, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_START)
    scene.node_set_padding(&sc5, col5b, 10, 0, 10, 0)
    scene.node_set_size(&sc5, col5b, 300.0, 0.0)
    let p5b: usize = scene.scene_add(&sc5, col5b, scene.N_TEXT)
    scene.node_add_class(&sc5, p5b, 11 as u32)
    scene.node_set_text(&sc5, p5b, (&para[0]) as u64, 120)
    scene.node_set_text_wrap(&sc5, p5b, 20)
    let after5b: usize = scene.scene_add(&sc5, col5b, scene.N_BOX)
    scene.node_set_size(&sc5, after5b, 10.0, 10.0)
    scene.scene_style(&sc5, &sh5)
    scene.scene_measure(&sc5, &c)
    // measured right before the layout: already the height of its lines
    let h5m: i64 = scene.node_pref_h(&sc5, p5b) as i64
    scene.scene_layout(&sc5, &c, 0.0, 0.0, CW as f64, CH as f64)
    var n25a: [u8; 44] = "5 rebuilt tree: no extra round (width kept) "
    report((&n25a[0]) as u64, 44, scene.scene_reflows(&sc5) == 0, (scene.scene_reflows(&sc5)) as i64, (0) as i64)
    var n25b: [u8; 42] = "5 rebuilt tree: measured height is right  "
    report((&n25b[0]) as u64, 42, h5m == h5, (h5m) as i64, (h5) as i64)
    var n25c: [u8; 40] = "5 rebuilt tree: what follows stays put  "
    report((&n25c[0]) as u64, 40, scene.node_y(&sc5, after5b) as i64 == y_after, (scene.node_y(&sc5, after5b)) as i64, (y_after) as i64)

    // narrower column: more lines, and the tree follows
    scene.node_set_size(&sc5, col5, 160.0, 0.0)
    scene.scene_measure(&sc5, &c)
    scene.scene_layout(&sc5, &c, 0.0, 0.0, CW as f64, CH as f64)
    let lines5b: i64 = scene.node_text_lines(&sc5, p5) as i64
    let y_after_b: i64 = scene.node_y(&sc5, after5) as i64
    var n26: [u8; 22] = "5 narrower: more lines"
    report((&n26[0]) as u64, 22, lines5b > lines5, (lines5b) as i64, (lines5 + 1) as i64)
    var n27: [u8; 35] = "5 narrower: what follows moves down"
    report((&n27[0]) as u64, 35, y_after_b == lines5b * 24, (y_after_b) as i64, (lines5b * 24) as i64)

    // in a row: the paragraph shrinks next to a fixed box
    var sc6: scene.Scene = scene.scene_new()
    let r6: usize = scene.scene_add(&sc6, scene.SCENE_NONE, scene.N_BOX)
    scene.node_set_flex(&sc6, r6, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_START)
    let fix6: usize = scene.scene_add(&sc6, r6, scene.N_BOX)
    scene.node_set_size(&sc6, fix6, 100.0, 20.0)
    let p6: usize = scene.scene_add(&sc6, r6, scene.N_TEXT)
    scene.node_add_class(&sc6, p6, 11 as u32)
    scene.node_set_text(&sc6, p6, (&para[0]) as u64, 120)
    scene.node_set_text_wrap(&sc6, p6, 20)
    scene.scene_style(&sc6, &sh5)
    scene.scene_measure(&sc6, &c)
    scene.scene_layout(&sc6, &c, 0.0, 0.0, 400.0, CH as f64)
    let w6: i64 = scene.node_w(&sc6, p6) as i64
    let x6: i64 = scene.node_x(&sc6, p6) as i64
    let l6: i64 = scene.node_text_lines(&sc6, p6) as i64
    let h6: i64 = scene.node_h(&sc6, p6) as i64
    var n28: [u8; 41] = "6 row: the paragraph takes the rest (300)"
    report((&n28[0]) as u64, 41, w6 == 300 && x6 == 100, (w6) as i64, (300) as i64)
    var n29: [u8; 30] = "6 row: its height is its lines"
    report((&n29[0]) as u64, 30, l6 >= 2 && h6 == l6 * 24, (h6) as i64, (l6 * 24) as i64)

    // ================================================ 7. GROUP OPACITY
    // black ground; a group at 50 %: a red box and a white box over it
    var sh7: sheet.Sheet = sheet.sheet_new()
    var red: style.Style = style.style_new()
    red = style.style_set_bg(red, style.color_literal(16711680 as u32))
    rule(&sh7, 21 as u32, red)
    var wht: style.Style = style.style_new()
    wht = style.style_set_bg(wht, style.color_literal(16777215 as u32))
    rule(&sh7, 22 as u32, wht)
    var sc7: scene.Scene = scene.scene_new()
    let r7: usize = scene.scene_add(&sc7, scene.SCENE_NONE, scene.N_BOX)
    scene.node_set_flex(&sc7, r7, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_START)
    let g7: usize = scene.scene_add(&sc7, r7, scene.N_BOX)
    scene.node_set_size(&sc7, g7, 200.0, 100.0)
    scene.node_set_flex(&sc7, g7, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_START)
    let a7: usize = scene.scene_add(&sc7, g7, scene.N_BOX)
    scene.node_add_class(&sc7, a7, 21 as u32)
    scene.node_set_size(&sc7, a7, 100.0, 100.0)
    let b7: usize = scene.scene_add(&sc7, g7, scene.N_BOX)
    scene.node_add_class(&sc7, b7, 22 as u32)
    scene.node_set_size(&sc7, b7, 100.0, 100.0)
    scene.scene_style(&sc7, &sh7)
    scene.scene_measure(&sc7, &c)
    scene.scene_layout(&sc7, &c, 0.0, 0.0, CW as f64, CH as f64)
    // the white one on top of the red one: move it left by 50
    scene.node_set_offset(&sc7, b7, 0.0 - 50.0, 0.0)
    scene.node_set_opacity(&sc7, g7, 0.5)
    canvas.canvas_clear(&cv, theme.opaque(0))
    scene.scene_draw(&sc7, &c)
    let o_red: u32 = canvas.canvas_get(&cv, 20, 50)
    let o_both: u32 = canvas.canvas_get(&cv, 75, 50)
    let o_white: u32 = canvas.canvas_get(&cv, 125, 50)
    let o_gone: u32 = canvas.canvas_get(&cv, 175, 50)
    var n30: [u8; 34] = "7 group 50%: red alone is half red"
    report((&n30[0]) as u64, 34, absi(ch_r(o_red) - 128) <= 1 && ch_g(o_red) == 0, (ch_r(o_red)) as i64, (128) as i64)
    var n31: [u8; 41] = "7 group 50%: the overlap shows ONLY white"
    report((&n31[0]) as u64, 41, absi(ch_r(o_both) - 128) <= 1 && absi(ch_g(o_both) - 128) <= 1, (ch_g(o_both)) as i64, (128) as i64)
    var n32: [u8; 38] = "7 group 50%: white alone is half white"
    report((&n32[0]) as u64, 38, absi(ch_g(o_white) - 128) <= 1, (ch_g(o_white)) as i64, (128) as i64)
    var n33: [u8; 42] = "7 offset: the white box left its old place"
    report((&n33[0]) as u64, 42, o_gone == theme.opaque(0), (ch_g(o_gone)) as i64, (0) as i64)
    var n34: [u8; 39] = "7 offset: laid out where it was (x 100)"
    report((&n34[0]) as u64, 39, scene.node_x(&sc7, b7) as i64 == 100, (scene.node_x(&sc7, b7) as i64) as i64, (100) as i64)
    var n35: [u8; 27] = "7 no size drifts in a group"
    report((&n35[0]) as u64, 27, scene.scene_size_drift(&sc7) == 0, (scene.scene_size_drift(&sc7)) as i64, (0) as i64)
    var n36: [u8; 38] = "7 no group was painted without opacity"
    report((&n36[0]) as u64, 38, layer.group_overflow() == 0 && layer.group_depth() == 0, (layer.group_overflow() as i64) as i64, (0) as i64)

    // opacity 0: nothing at all; opacity 1: exactly like no group
    scene.node_set_opacity(&sc7, g7, 0.0)
    canvas.canvas_clear(&cv, theme.opaque(0))
    scene.scene_draw(&sc7, &c)
    let o_zero: u32 = canvas.canvas_get(&cv, 20, 50)
    var n37: [u8; 26] = "7 opacity 0 paints nothing"
    report((&n37[0]) as u64, 26, o_zero == theme.opaque(0), (ch_r(o_zero)) as i64, (0) as i64)

    // ================================================ 8. STILL + LIVE
    var cv2: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv2, CW, CH) {
        return 4
    }
    var z2: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z2, &cv2, CW, CH) {
        return 5
    }
    painter.painter_set_font(&z2, fm)
    var c2: render.Ctx = render.ctx_new(&m, &z2)
    // everything, straight
    scene.node_set_opacity(&sc7, g7, 1.0)
    scene.node_set_offset(&sc7, b7, 0.0, 0.0)
    scene.node_set_live(&sc7, b7, true)
    canvas.canvas_clear(&cv, theme.opaque(0))
    scene.scene_draw(&sc7, &c)
    // still into a bake, copied, then the live part over it
    var bk: layer.Bake = layer.bake_new()
    let started: bool = layer.bake_start(&bk, CW, CH, 42 as u64, theme.opaque(0), &z2)
    var cb: render.Ctx = render.ctx_new(&m, layer.bake_painter(&bk))
    scene.scene_draw_still(&sc7, &cb)
    let copied: bool = layer.bake_copy_to(&bk, &z2, 0, CH)
    scene.scene_draw_live(&sc7, &c2)
    let d8: i64 = diff(&cv, &cv2)
    // and the still picture really lacks the live part
    let still_px: u32 = canvas.canvas_get(layer.bake_canvas(&bk), 150, 50)
    var n38: [u8; 26] = "8 bake: started and copied"
    report((&n38[0]) as u64, 26, started && copied, (copied as i64) as i64, (1) as i64)
    var n39: [u8; 46] = "8 still + live = everything (pixels differing)"
    report((&n39[0]) as u64, 46, d8 == 0, (d8) as i64, (0) as i64)
    var n40: [u8; 38] = "8 the still picture lacks the live box"
    report((&n40[0]) as u64, 38, still_px == theme.opaque(0), (ch_g(still_px)) as i64, (0) as i64)
    var n41: [u8; 42] = "8 bake: valid for its key, not for another"
    report((&n41[0]) as u64, 42, layer.bake_valid(&bk, CW, CH, 42 as u64) && !layer.bake_valid(&bk, CW, CH, 43 as u64), (layer.bake_count(&bk) as i64) as i64, (1) as i64)

    layer.bake_free(&bk)
    canvas.canvas_free(&cv)
    canvas.canvas_free(&cv2)
    painter.painter_free(&z)
    painter.painter_free(&z2)
    rt.buf_free(&fbuf)
    var t: rt.Buf = rt.buf_new()
    if G_ERRORS > 0 {
        var f: [u8; 28] = "\nPAGE LOOK IS NOT IN ORDER.\n"
        rt.buf_push_bytes(&t, (&f[0]) as u64, 28)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
        return 1
    }
    var o: [u8; 19] = "\nPAGE LOOK PASSED.\n"
    rt.buf_push_bytes(&t, (&o[0]) as u64, 19)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 0
}
