// SPDX-License-Identifier: MPL-2.0
// tools/fui/effect_main.fi -- THE BLUR IS RE-CALCULATED.
//
// A blur ALWAYS looks soft, even if it is wrong --
// that is why here there are numbers and no glances:
//
//   1. A box pass of width 3 on a single point gives
//      exactly 255/3 = 85 on three pixels. The running sum must deliver
//      the same as the convolution by hand.
//   2. The SUM is preserved (a convolution with a normalised
//      kernel loses no mass, except for rounding).
//   3. Three times box approximates the Gaussian curve: the ratio of
//      middle to neighbour is checked against the cubic B-spline --
//      that is the analytic answer that three times box MUST give.
//   4. The edge stays light: a surface of constant colour stays
//      after blurring the same colour everywhere, also in the
//      corner (the dark fringe arises when averaging with
//      zeros beyond the edge).
//   5. The colour matrix: grey level of red is 0.2126 * 255 = 54.
//   6. The measure: sigma from the radius and back.
//   7. IN TWO DIRECTIONS. A NAIVE convolution is set against the
//      running sum, which adds up the same window point by point --
//      pixel by pixel the same value, otherwise the shortcut is wrong. In addition
//      the 2D answer written down by hand: the outer product of (1,3,6,7,6,3,1)/27 with
//      itself.
//   8. AGAINST THE REAL GAUSSIAN CURVE. Three times box with r = 4 has
//      sigma = sqrt(20) = 4.472; compared sample point by sample point
//      with 255 * exp(-x^2/2sigma^2) / (sigma*sqrt(2pi)).
//   9. THE SEMI-TRANSPARENT EDGE. White with alpha 128 next to
//      nothing: after blurring the colour converted back must
//      everywhere still be white. Whoever does not average premultiplied
//      gets here the dark fringe that you see on the finished shadow.
//  10. THE CONCATENATION of the colour matrix against the hand calculation, in
//      both orders (it is not commutative).
//  11. THE SHADOW falls off SOFTLY: the brightness under the edge
//      rises row by row monotonically, the ramp is dozens of
//      points long, far outside the pure white of the
//      background stands again -- and the spread makes it
//      darker at the same place.
import std.rt
import std.math
import paint.canvas
import fui.painter
import fui.effect

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    var w: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&w[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

const N: usize = 17
const M: usize = 15
const G: usize = 81
const E: usize = 21

fn get(p: *mut u8, i: usize, k: usize) -> i64 {
    return (*((p as u64 + (i * 4 + k) as u64) as *mut u8)) as i64
}

fn set(p: *mut u8, i: usize, k: usize, v: i64) {
    *((p as u64 + (i * 4 + k) as u64) as *mut u8) = v as u8
}

// ------------------------------------------- THE NAIVE COUNTER-CALCULATION
//
// The same window, but added up point by point: O(r) per pixel
// and thereby far too slow for an image, but so simple that it is
// obviously right. Exactly against that the running sum is
// held -- rounding and edge continuation included.
fn naiv_h(src: *mut u8, dst: *mut u8, w: usize, h: usize, r: i64) {
    let divisor: i64 = 2 * r + 1
    var y: i64 = 0
    while y < h as i64 {
        var x: i64 = 0
        while x < w as i64 {
            var k: usize = 0
            while k < 4 {
                var sum: i64 = 0
                var d: i64 = 0 - r
                while d <= r {
                    var q: i64 = x + d
                    if q < 0 { q = 0 }
                    if q > (w - 1) as i64 { q = (w - 1) as i64 }
                    sum = sum + get(src, (y * w as i64 + q) as usize, k)
                    d = d + 1
                }
                set(dst, (y * w as i64 + x) as usize, k,
                    (sum + divisor / 2) / divisor)
                k = k + 1
            }
            x = x + 1
        }
        y = y + 1
    }
}

fn naiv_v(src: *mut u8, dst: *mut u8, w: usize, h: usize, r: i64) {
    let divisor: i64 = 2 * r + 1
    var y: i64 = 0
    while y < h as i64 {
        var x: i64 = 0
        while x < w as i64 {
            var k: usize = 0
            while k < 4 {
                var sum: i64 = 0
                var d: i64 = 0 - r
                while d <= r {
                    var q: i64 = y + d
                    if q < 0 { q = 0 }
                    if q > (h - 1) as i64 { q = (h - 1) as i64 }
                    sum = sum + get(src, (q * w as i64 + x) as usize, k)
                    d = d + 1
                }
                set(dst, (y * w as i64 + x) as usize, k,
                    (sum + divisor / 2) / divisor)
                k = k + 1
            }
            x = x + 1
        }
        y = y + 1
    }
}

// The same order as effect.blur_buffer: three times horizontally,
// three times vertically. The result then stands again in `px`.
fn naiv_blur(px: *mut u8, tmp: *mut u8, w: usize, h: usize, r: i64) {
    naiv_h(px, tmp, w, h, r)
    naiv_h(tmp, px, w, h, r)
    naiv_h(px, tmp, w, h, r)
    naiv_v(tmp, px, w, h, r)
    naiv_v(px, tmp, w, h, r)
    naiv_v(tmp, px, w, h, r)
}

fn copy(src: *mut u8, dst: *mut u8, n: usize) {
    var i: usize = 0
    while i < n * 4 {
        *((dst as u64 + i as u64) as *mut u8) =
        *((src as u64 + i as u64) as *mut u8)
        i = i + 1
    }
}

fn abs(v: f64) -> f64 {
    if v < 0.0 {
        return 0.0 - v
    }
    return v
}

fn empty(p: *mut u8, n: usize) {
    var i: usize = 0
    while i < n * 4 {
        *((p as u64 + i as u64) as *mut u8) = 0 as u8
        i = i + 1
    }
}

fn main(start: u64) -> i32 {
    let a: *mut u8 = rt.heap_alloc(N * 4) as *mut u8
    let b: *mut u8 = rt.heap_alloc(N * 4) as *mut u8
    if a as usize == 0 || b as usize == 0 {
        return 3
    }

    // ========================================= 1. ONE BOX PASS
    empty(a, N)
    set(a, 8, 3, 255) // ein einzelner Punkt, Alphakanal
    effect.box_pass_h(a, b, N, 1, 1)
    var n1: [u8; 35] = "1 box r=1 spreads 255 to 85 = 255/3"
    report((&n1[0]) as u64, 35, get(b, 8, 3) == 85, get(b, 8, 3), 85)
    var n2: [u8; 31] = "1 and the neighbour gets 85 too"
    report((&n2[0]) as u64, 31, get(b, 7, 3) == 85, get(b, 7, 3), 85)
    var n3: [u8; 29] = "1 two away it is already zero"
    report((&n3[0]) as u64, 29, get(b, 6, 3) == 0, get(b, 6, 3), 0)

    // ============================================= 2. DIE MASSE BLEIBT
    var sum: i64 = 0
    var i: usize = 0
    while i < N {
        sum = sum + get(b, i, 3)
        i = i + 1
    }
    var n4: [u8; 29] = "2 the mass stays 255 (3 * 85)"
    report((&n4[0]) as u64, 29, sum == 255, sum, 255)

    // ====================================== 3. THREE TIMES BOX = B-SPLINE
    //
    // The kernel of three times box of width 3 is the one that can be
    // convolved by hand (1,3,6,7,6,3,1)/27 -- that is the discrete cubic
    // B-spline and the analytic answer against which things are checked here. With
    // 255 as the point and integer rounding in every
    // pass the middle stands at 255*7/27 = 66.
    empty(a, N)
    set(a, 8, 3, 255)
    effect.box_pass_h(a, b, N, 1, 1)
    effect.box_pass_h(b, a, N, 1, 1)
    effect.box_pass_h(a, b, N, 1, 1)
    var n5: [u8; 27] = "3 triple box centre is 7/27"
    report((&n5[0]) as u64, 27, get(b, 8, 3) == 66, get(b, 8, 3), 66)
    var n6: [u8; 22] = "3 one off is 6/27 = 57"
    report((&n6[0]) as u64, 22, get(b, 7, 3) == 57, get(b, 7, 3), 57)
    var n7: [u8; 23] = "3 three off is 1/27 = 9"
    report((&n7[0]) as u64, 23, get(b, 5, 3) == 9, get(b, 5, 3), 9)

    // =========================================== 4. THE EDGE STAYS LIGHT
    //
    // A continuously opaque surface must not change --
    // not even in the first pixel. Whoever averages with zeros beyond the edge
    // gets here 170 instead of 255, and that is exactly how the
    // dark fringe around every shadow arises.
    i = 0
    while i < N {
        set(a, i, 0, 200)
        set(a, i, 1, 200)
        set(a, i, 2, 200)
        set(a, i, 3, 255)
        i = i + 1
    }
    effect.box_pass_h(a, b, N, 1, 3)
    var n8: [u8; 41] = "4 a flat area keeps its value at the edge"
    report((&n8[0]) as u64, 41, get(b, 0, 0) == 200, get(b, 0, 0), 200)
    var n9: [u8; 25] = "4 and its alpha stays 255"
    report((&n9[0]) as u64, 25, get(b, 0, 3) == 255, get(b, 0, 3), 255)

    // ============================================== 5. DIE FARBMATRIX
    var cm: effect.ColorMatrix = effect.cm_grayscale()
    let grau: u32 = effect.cm_apply_pixel(&cm, 0xFFFF0000 as u32)
    var n10: [u8; 34] = "5 grey of red is 54 (0.2126 * 255)"
    report((&n10[0]) as u64, 34, ((grau >> 16) & 255 as u32) == 54 as u32,
        ((grau >> 16) & 255 as u32) as i64, 54)
    var n11: [u8; 34] = "5 and all three channels are equal"
    report((&n11[0]) as u64, 34,
        ((grau >> 8) & 255 as u32) == ((grau >> 16) & 255 as u32),
        ((grau >> 8) & 255 as u32) as i64, 54)
    // Saturation 1 is the identity: nothing changes.
    var cs: effect.ColorMatrix = effect.cm_saturate(1.0)
    let equal: u32 = effect.cm_apply_pixel(&cs, 0xFF3366CC as u32)
    var n12: [u8; 29] = "5 saturate(1) changes nothing"
    report((&n12[0]) as u64, 29, equal == 0xFF3366CC as u32,
        (equal & 16777215 as u32) as i64, 3368652)
    // Contrast 1 likewise, and contrast 2 raises 0.75 to 1.0.
    var ck: effect.ColorMatrix = effect.cm_contrast(2.0)
    let hart: u32 = effect.cm_apply_pixel(&ck, 0xFFBFBFBF as u32)
    var n13: [u8; 30] = "5 contrast(2) lifts 191 to 255"
    report((&n13[0]) as u64, 30, ((hart >> 16) & 255 as u32) == 255 as u32,
        ((hart >> 16) & 255 as u32) as i64, 255)

    // ================================================= 6. THE DIMENSIONS
    //
    // sigma from the radius: r = 1 gives three boxes of width 3,
    // so sigma = sqrt(3 * 8/12) = sqrt(2) = 1.414.
    let s: f64 = effect.sigma_for_radius(1)
    var n14: [u8; 31] = "6 sigma for r=1 is 1414 (x1000)"
    report((&n14[0]) as u64, 31, (s * 1000.0 + 0.5) as i64 == 1414,
        (s * 1000.0 + 0.5) as i64, 1414)
    var n15: [u8; 28] = "6 and back again gives r = 1"
    report((&n15[0]) as u64, 28, effect.radius_for_sigma(s) == 1,
        effect.radius_for_sigma(s), 1)

    // ======================== 7. IN TWO DIRECTIONS, AGAINST THE NAIVE ONE
    //
    // A point in the middle of a 15x15 surface, three times box with
    // r = 1 in both directions. First, the running sum must deliver
    // pixel by pixel the same as the naive convolution.
    // Second, the answer stands there by hand: the kernel of three times
    // box is (1,3,6,7,6,3,1)/27, in two directions thus its
    // outer product /729. In the middle that is 255*49/729 = 17.1.
    let f1: *mut u8 = rt.heap_alloc(M * M * 4) as *mut u8
    let f2: *mut u8 = rt.heap_alloc(M * M * 4) as *mut u8
    let f3: *mut u8 = rt.heap_alloc(M * M * 4) as *mut u8
    let f4: *mut u8 = rt.heap_alloc(M * M * 4) as *mut u8
    if f1 as usize == 0 || f2 as usize == 0 || f3 as usize == 0 ||
    f4 as usize == 0 {
        return 3
    }
    empty(f1, M * M)
    set(f1, 7 * M + 7, 3, 255)
    copy(f1, f3, M * M)
    effect.blur_buffer(f1, f2, M, M, 1)
    naiv_blur(f3, f4, M, M, 1)
    var abw: i64 = 0
    var p: usize = 0
    while p < M * M {
        var k: usize = 0
        while k < 4 {
            if get(f1, p, k) != get(f3, p, k) {
                abw = abw + 1
            }
            k = k + 1
        }
        p = p + 1
    }
    var n16: [u8; 43] = "7 running sum = naive convolution, 0 pixels"
    report((&n16[0]) as u64, 43, abw == 0, abw, 0)
    var n17: [u8; 39] = "7 2D centre is 255*49/729 = 17 (7/27)^2"
    report((&n17[0]) as u64, 39, get(f1, 7 * M + 7, 3) == 17,
        get(f1, 7 * M + 7, 3), 17)
    // And the whole 7x7 neighbourhood against the same outer product.
    // Allowed is ONE tone value of distance: each of the six passes
    // rounds to integers, the hand calculation does not.
    var kern: [i64; 7] = [1, 3, 6, 7, 6, 3, 1]
    var schief: i64 = 0
    var jj: usize = 0
    while jj < 7 {
        var ii: usize = 0
        while ii < 7 {
            let should: i64 = (255 * kern[ii] * kern[jj] + 364) / 729
            let ist: i64 = get(f1, (4 + jj) * M + 4 + ii, 3)
            if ist - should > 1 || should - ist > 1 {
                schief = schief + 1
            }
            ii = ii + 1
        }
        jj = jj + 1
    }
    var n18: [u8; 38] = "7 all 49 cells match the outer product"
    report((&n18[0]) as u64, 38, schief == 0, schief, 0)
    var n19: [u8; 36] = "7 one column off is 255*7*6/729 = 15"
    report((&n19[0]) as u64, 36, get(f1, 7 * M + 8, 3) == 15,
        get(f1, 7 * M + 8, 3), 15)

    // ============================ 8. AGAINST THE ANALYTIC GAUSSIAN CURVE
    //
    // r = 4 means three boxes of width 9, so
    // sigma = sqrt(3*(81-1)/12) = sqrt(20) = 4.4721. Compared is
    // with the normal distribution 255 * exp(-x^2/(2 sigma^2)) /
    // (sigma * sqrt(2 pi)) at all sample points up to +-10 (that is
    // more than two sigma; further out there stands almost nothing anyway).
    //
    // TOLERANCE: 2 tone values, and from two nameable sources.
    // First, three times box is only an APPROXIMATION (a cubic
    // B-spline); the difference from the Gaussian curve is at just under one
    // percent of the peak, here so under 0.3 tone values. Second,
    // each of the three passes rounds to integers, which can contribute up to
    // 1.5 tone values. Measured are 1.7 -- that fits
    // exactly to this calculation, and a real error (wrong
    // divisor, shifted kernel) would lie many times above it.
    let g1: *mut u8 = rt.heap_alloc(G * 4) as *mut u8
    let g2: *mut u8 = rt.heap_alloc(G * 4) as *mut u8
    if g1 as usize == 0 || g2 as usize == 0 {
        return 3
    }
    empty(g1, G)
    set(g1, 40, 3, 255)
    effect.blur_buffer(g1, g2, G, 1, 4)
    let sig: f64 = effect.sigma_for_radius(4)
    var maxab: f64 = 0.0
    var xi: i64 = 0 - 10
    while xi <= 10 {
        let gx: f64 = 255.0 * math.exp(0.0 - (xi as f64) * (xi as f64) /
            (2.0 * sig * sig)) / (sig * math.sqrt(2.0 * 3.14159265358979))
        let ab: f64 = abs(get(g1, (40 + xi) as usize, 3) as f64 - gx)
        if ab > maxab {
            maxab = ab
        }
        xi = xi + 1
    }
    var n20: [u8; 46] = "8 max deviation from Gauss is 17 tenths (< 20)"
    report((&n20[0]) as u64, 46, (maxab * 10.0 + 0.5) as i64 <= 20,
        (maxab * 10.0 + 0.5) as i64, 17)
    // And the peak itself: 255 / (sigma * sqrt(2 pi)) = 22.7.
    var n21: [u8; 32] = "8 the peak is 21, the Gauss 22.7"
    report((&n21[0]) as u64, 32, get(g1, 40, 3) == 21, get(g1, 40, 3),
        21)

    // ================================== 9. THE SEMI-TRANSPARENT EDGE
    //
    // On the left ten points of WHITE with alpha 128 -- premultiplied thus
    // 128,128,128,128 -- and on the right eleven points of nothing. After three times
    // box, everywhere where alpha still stands the colour converted back
    // must be exactly white. Whoever averages the colour unweighted and
    // the alpha separately pulls the black of the nothing in here:
    // that is the dark fringe, and it can be caught EXACTLY with this line.
    let e1: *mut u8 = rt.heap_alloc(E * 4) as *mut u8
    let e2: *mut u8 = rt.heap_alloc(E * 4) as *mut u8
    if e1 as usize == 0 || e2 as usize == 0 {
        return 3
    }
    empty(e1, E)
    i = 0
    while i < 10 {
        set(e1, i, 0, 128)
        set(e1, i, 1, 128)
        set(e1, i, 2, 128)
        set(e1, i, 3, 128)
        i = i + 1
    }
    effect.blur_buffer(e1, e2, E, 1, 2)
    var saum: i64 = 0
    var rampe: i64 = 0
    i = 0
    while i < E {
        let av: i64 = get(e1, i, 3)
        if av > 0 {
            // zurueckgerechnet: c * 255 / a, gerundet
            if (get(e1, i, 0) * 255 + av / 2) / av != 255 {
                saum = saum + 1
            }
            if av < 128 {
                rampe = rampe + 1
            }
        }
        i = i + 1
    }
    var n22: [u8; 38] = "9 no pixel of the soft edge turns grey"
    report((&n22[0]) as u64, 38, saum == 0, saum, 0)
    // The ramp itself: three times box with r = 2 carries 3*r = 6 points
    // far to each side, the edge lies between 9 and 10 -- so
    // 12 points at which the alpha stands between 128 and 0.
    var n23: [u8; 32] = "9 and the ramp is 12 pixels long"
    report((&n23[0]) as u64, 32, rampe == 12, rampe, 12)

    // ====================================== 10. THE CONCATENATION CALCULATES
    //
    // First brightness 0.5, then contrast 2: y = 2*(0.5x - 0.5) + 0.5 =
    // x - 0.5. From 204 (0.8) thus becomes 0.3, that is 77.
    // The other way round -- first contrast, then brightness -- it is
    // y = 0.5*(2x - 0.5) = x - 0.25, so 0.55 and thereby 140. The
    // two numbers are different, and exactly that proves that the
    // order is right.
    var ka: effect.ColorMatrix = effect.cm_mul(effect.cm_brightness(0.5),
        effect.cm_contrast(2.0))
    let kv: u32 = effect.cm_apply_pixel(&ka, 0xFFCCCCCC as u32)
    var n24: [u8; 38] = "10 brightness then contrast: 204 -> 77"
    report((&n24[0]) as u64, 38, ((kv >> 16) & 255 as u32) == 77 as u32,
        ((kv >> 16) & 255 as u32) as i64, 77)
    var kb: effect.ColorMatrix = effect.cm_mul(effect.cm_contrast(2.0),
        effect.cm_brightness(0.5))
    let kw: u32 = effect.cm_apply_pixel(&kb, 0xFFCCCCCC as u32)
    var n25: [u8; 34] = "10 the other way round: 204 -> 140"
    report((&n25[0]) as u64, 34, ((kw >> 16) & 255 as u32) == 140 as u32,
        ((kw >> 16) & 255 as u32) as i64, 140)
    // And the factor of the concatenated matrix itself: 2 * 0.5 = 1.
    var n26: [u8; 37] = "10 the chained factor is 1000 (x1000)"
    report((&n26[0]) as u64, 37, (ka.m[0] * 1000.0 + 0.5) as i64 == 1000,
        (ka.m[0] * 1000.0 + 0.5) as i64, 1000)

    // ======================================== 11. THE SHADOW IS SOFT
    //
    // A black shadow under a card on a white background. From the
    // lower edge of the shape downwards the brightness must rise MONOTONICALLY
    // (a hard edge jumps), the ramp must be dozens of
    // points long, and outside 3*blur the
    // pure white must stand again -- a dark fringe would be seen there at once as
    // 254 or less.
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, 200, 160) {
        return 4
    }
    canvas.canvas_clear(&cv, 0xFFFFFFFF as u32)
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, 200, 160) {
        return 5
    }
    effect.drop_shadow_spread(&z, 50.0, 30.0, 100.0, 60.0, 12.0, 0.0,
        0.0, 8, 0.0, 0xFF000000 as u32)
    var before: i64 = 0 - 1
    var monoton: i64 = 0
    var weich: i64 = 0
    var y: usize = 76
    while y < 130 {
        let v: i64 = ((canvas.canvas_get(&cv, 100, y) >> 16) &
            255 as u32) as i64
        if v < before {
            monoton = monoton + 1
        }
        if v > 20 && v < 235 {
            weich = weich + 1
        }
        before = v
        y = y + 1
    }
    var n27: [u8; 41] = "11 the shadow never gets darker downwards"
    report((&n27[0]) as u64, 41, monoton == 0, monoton, 0)
    // Three times box with r = 8 carries 3*8 = 24 points far; exactly so
    // long is the measured ramp between 20 and 235. Demanded
    // are 20 -- a hard edge would have 1 or 2 here.
    var n28: [u8; 38] = "11 and its ramp is at least 20 px long"
    report((&n28[0]) as u64, 38, weich >= 20, weich, 20)
    let fern: i64 = ((canvas.canvas_get(&cv, 100, 125) >> 16) &
        255 as u32) as i64
    var n29: [u8; 39] = "11 far outside the ground is pure white"
    report((&n29[0]) as u64, 39, fern == 255, fern, 255)
    let below: i64 = ((canvas.canvas_get(&cv, 100, 96) >> 16) &
        255 as u32) as i64
    // The same place with spread 10: the shadow stands further
    // out and is there clearly darker.
    canvas.canvas_clear(&cv, 0xFFFFFFFF as u32)
    effect.drop_shadow_spread(&z, 50.0, 30.0, 100.0, 60.0, 12.0, 0.0,
        0.0, 8, 10.0, 0xFF000000 as u32)
    let below2: i64 = ((canvas.canvas_get(&cv, 100, 96) >> 16) &
        255 as u32) as i64
    var n30: [u8; 39] = "11 spread 10 makes the same spot darker"
    report((&n30[0]) as u64, 39, below2 + 40 < below, below - below2, 40)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)

    // ========== 12. THE TWO BOX BLURS OF THE TREE MEET
    //
    // This tree has two: `lib/paint/painter.blur_line` averages
    // OPACITIES (f64, one channel, outside zero), this file
    // averages a PREMULTIPLIED u8 CANVAS (four channels,
    // outside the continued edge value). The head of
    // lib/fui/effect.fi justifies why that is no second place for
    // the same thing -- and a justification is worth only as much as
    // its verification.
    //
    // SO IT IS MEASURED. The same step edge (64 positions, full from
    // 32), the same sigma 4.0, three times box. The table below is
    // the same as in tools/fui/blurref_main.fi, which calculates the other side;
    // two programs they are, because `fui.painter` and
    // `paint.painter` are both called `painter` and do not fit into the same
    // program.
    //
    // ALLOWED IS ONE TONE VALUE OF DIFFERENCE: the u8 side rounds after
    // EACH of the three passes to whole tone values, the f64 side only
    // at the end. Measured it is exactly two positions of 28, and at
    // both the difference is 1.
    var should: [i64; 28] = [
        0, 0, 0, 1, 3, 7, 12, 20, 29, 42, 58, 76, 96, 117,
        138, 159, 179, 197, 213, 226, 235, 243, 248, 252, 254, 255,
        255, 255]
    let rr: i64 = effect.radius_for_sigma(4.0)
    var m1: [u8; 44] = "12 sigma 4 gives a box radius of 4          "
    report((&m1[0]) as u64, 43, rr == 4, rr, 4)
    let nn: usize = 64
    let pu: u64 = rt.heap_alloc(nn * 4)
    if pu == 0 {
        return 6
    }
    let tu: u64 = rt.heap_alloc(nn * 4)
    if tu == 0 {
        rt.heap_free(pu, nn * 4)
        return 6
    }
    var ii: usize = 0
    while ii < nn {
        var u: u8 = 0 as u8
        if ii >= 32 {
            u = 255 as u8
        }
        var kk: usize = 0
        while kk < 4 {
            rt.st8(pu, ii * 4 + kk, u)
            kk = kk + 1
        }
        ii = ii + 1
    }
    // One row high: the three vertical passes are then the
    // identity function (every window sees only this one row), exactly the
    // three horizontal ones remain.
    effect.blur_buffer(pu as *mut u8, tu as *mut u8, nn, 1, rr)
    var q_abw: i64 = 0
    var q_anz: i64 = 0
    var xx: usize = 0
    while xx < 28 {
        let g: i64 = rt.ld8(pu, (xx + 18) * 4) as i64
        var d2: i64 = g - should[xx]
        if d2 < 0 {
            d2 = 0 - d2
        }
        if d2 > q_abw {
            q_abw = d2
        }
        if d2 != 0 {
            q_anz = q_anz + 1
        }
        xx = xx + 1
    }
    var m2: [u8; 44] = "12 the canvas path meets the table (max 1)  "
    report((&m2[0]) as u64, 43, q_abw <= 1, q_abw, 1)
    var m3: [u8; 44] = "12 and it differs at 2 of 28 spots          "
    report((&m3[0]) as u64, 43, q_anz == 2, q_anz, 2)
    // The three positions that blurref_main.fi names individually -- there
    // calculated on the opacity, here measured on the canvas.
    let q_e0: i64 = rt.ld8(pu, 24 * 4) as i64
    var m4: [u8; 44] = "12 at 24 the canvas path gives 12 too       "
    report((&m4[0]) as u64, 43, q_e0 == 12, q_e0, 12)
    let q_e1: i64 = rt.ld8(pu, 32 * 4) as i64
    var m5: [u8; 44] = "12 at the edge itself it gives 138 too      "
    report((&m5[0]) as u64, 43, q_e1 == 138, q_e1, 138)
    let q_e2: i64 = rt.ld8(pu, 40 * 4) as i64
    var m6: [u8; 44] = "12 at 40 it gives 248 too                   "
    report((&m6[0]) as u64, 43, q_e2 == 248, q_e2, 248)
    // AND THE EDGE RULE that distinguishes the two: this side continues the
    // edge value, so the light is fully preserved --
    // 32 full positions of 64, sum 32.00 times 255 = 8160.
    var q_sum: i64 = 0
    var kx: usize = 0
    while kx < nn {
        q_sum = q_sum + (rt.ld8(pu, kx * 4) as i64)
        kx = kx + 1
    }
    var m7: [u8; 44] = "12 continuing the edge keeps all the light  "
    report((&m7[0]) as u64, 43, q_sum == 8160, q_sum, 8160)
    rt.heap_free(tu, nn * 4)
    rt.heap_free(pu, nn * 4)

    var t: rt.Buf = rt.buf_new()
    rt.buf_push(&t, 10 as u8)
    if G_ERRORS > 0 {
        var f: [u8; 24] = "EFFECT IS NOT IN ORDER.\n"
        rt.buf_push_bytes(&t, (&f[0]) as u64, 24)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
        return 1
    }
    var o: [u8; 15] = "EFFECT PASSED.\n"
    rt.buf_push_bytes(&t, (&o[0]) as u64, 15)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 0
}
