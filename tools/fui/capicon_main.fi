// SPDX-License-Identifier: MPL-2.0
// tools/fui/capicon_main.fi -- THE CLOSE CROSS IS COUNTED OUT.
//
// ================================================== WHY THIS EXISTS
//
// The very same drawing has ALREADY BROKEN TWICE in OrientOS:
//
//   1. A vector rasteriser replaced the cross. Two stroke outlines in
//      ONE path, filled by the nonzero rule -- at the crossing the
//      winding numbers add up and a fat extra bar appeared. Measured
//      were 4 doubly covered pixels at scale 1, 12 at 2, 24 at 3: it
//      gets WORSE with scaling.
//
//   2. After the rollback only ONE diagonal was left in the running
//      system -- a slash instead of a cross. The cause was a hard
//      coded 10 instead of `10 * scale` in the caller.
//
// Both times nobody spotted it in the source. That is why this
// program counts, and the build fails if something is off:
//
//   A EVERY ROW has pixels on BOTH sides of the centre. That is the
//     check which tells a slash from a cross -- and it finds exactly
//     the bug that is in the system today.
//   B NO pixel lies outside the box.
//   C The cross is mirror symmetric on BOTH axes.
//   D It SCALES: at twice the size it is twice as large.
//
// The computation runs on its own buffer, without a window and
// without a font -- this check needs no image and no screen.
import std.rt
import fui.core

const W: usize = 128
const H: usize = 128

static mut G_ERRORS: usize = 0

fn num(t: *mut rt.Buf, v: i64) {
    rt.buf_push_dec_i64(t, v)
}

fn report(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 42 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    rt.buf_push(&t, 40 as u8)
    num(&t, a)
    rt.buf_push(&t, 47 as u8)
    num(&t, b)
    rt.buf_push(&t, 41 as u8)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// Paint a cross of size `d` with stroke width `sb` into a fresh box
// and check the four properties.
fn check_capicon(p: u64, d: usize, sb: usize) {
    var z: core.Target = core.target_new(p, W, H, W * 4)
    core.fill_all(&z, 0 as u32)
    // The box sits at (10, 10) so that "outside" is measurable in
    // every direction.
    let ox: usize = 10
    let oy: usize = 10
    core.cap_close(&z, ox, oy, d, sb, 16777215 as u32)

    // ---- B: nothing outside the box
    var outside: usize = 0
    var y: usize = 0
    while y < H {
        var x: usize = 0
        while x < W {
            if core.get(&z, x, y) != 0 as u32 {
                if x < ox || y < oy || x >= ox + d || y >= oy + d {
                    outside = outside + 1
                }
            }
            x = x + 1
        }
        y = y + 1
    }
    var nb: [u8; 25] = "  nothing outside the box"
    report((&nb[0]) as u64, 25, outside == 0, outside as i64, 0)

    // ---- A: EVERY occupied row has pixels LEFT AND RIGHT of centre.
    //
    // This is the check that finds today's bug. A slash has EXACTLY
    // ONE run in every row; a cross has two in almost every row --
    // one left and one right of the centre axis. Only in the one or
    // two rows of the crossing itself do they coincide.
    //
    let centre: usize = ox + d / 2
    var rows: usize = 0
    var both_sides: usize = 0
    var crossing: usize = 0
    var yy: usize = oy
    while yy < oy + d {
        var left: usize = 0
        var right: usize = 0
        var xx: usize = ox
        while xx < ox + d {
            if core.get(&z, xx, yy) != 0 as u32 {
                if xx < centre {
                    left = left + 1
                } else {
                    right = right + 1
                }
            }
            xx = xx + 1
        }
        if left + right > 0 {
            rows = rows + 1
            if left > 0 && right > 0 {
                both_sides = both_sides + 1
            } else {
                // Near the centre both arms may lie in the same
                // half.
                var dm: usize = 0
                if yy > oy + d / 2 {
                    dm = yy - (oy + d / 2)
                } else {
                    dm = (oy + d / 2) - yy
                }
                if dm <= sb {
                    crossing = crossing + 1
                }
            }
        }
        yy = yy + 1
    }
    var na: [u8; 28] = "  every row spans the centre"
    report((&na[0]) as u64, 28, both_sides + crossing == rows,
        both_sides as i64, rows as i64)

    // ---- C: MIRROR SYMMETRIC WITHIN THE OCCUPIED AREA.
    //
    // NOT across the whole box -- and that is not leniency but the
    // geometry the template itself states: the occupied height is
    // `kn = d - (sb - 1)`, so the remainder in the box is `sb - 1`.
    // With an EVEN stroke width that remainder is odd and cannot be
    // split equally on two sides. The template measures the same:
    // "d = 20: sb=1 -> 20x20, sb=2 -> 20x19, sb=3 -> 20x18. That a
    // 2 wide cross occupies only 19 of 20 rows is geometry."
    //
    // So what is required is what MUST really hold: within its own
    // extent the cross is mirror symmetric on both axes, and the
    // margin top/bottom resp. left/right differs by at most one
    // pixel.
    var by0: usize = d
    var by1: usize = 0
    var bx0: usize = d
    var bx1: usize = 0
    var y2: usize = 0
    while y2 < d {
        var x2: usize = 0
        while x2 < d {
            if core.get(&z, ox + x2, oy + y2) != 0 as u32 {
                if y2 < by0 { by0 = y2 }
                if y2 > by1 { by1 = y2 }
                if x2 < bx0 { bx0 = x2 }
                if x2 > bx1 { bx1 = x2 }
            }
            x2 = x2 + 1
        }
        y2 = y2 + 1
    }
    var unequal_x: usize = 0
    var unequal_y: usize = 0
    var y3: usize = by0
    while y3 <= by1 {
        var x3: usize = bx0
        while x3 <= bx1 {
            let a: u32 = core.get(&z, ox + x3, oy + y3)
            let sx: u32 = core.get(&z, ox + bx0 + bx1 - x3, oy + y3)
            let sy: u32 = core.get(&z, ox + x3, oy + by0 + by1 - y3)
            if a != sx {
                unequal_x = unequal_x + 1
            }
            if a != sy {
                unequal_y = unequal_y + 1
            }
            x3 = x3 + 1
        }
        y3 = y3 + 1
    }
    var nc: [u8; 31] = "  mirror symmetric (horizontal)"
    report((&nc[0]) as u64, 31, unequal_x == 0, unequal_x as i64, 0)
    var nd: [u8; 29] = "  mirror symmetric (vertical)"
    report((&nd[0]) as u64, 29, unequal_y == 0, unequal_y as i64, 0)
    // The margin: at most one pixel of difference.
    let r_top: usize = by0
    let r_bottom: usize = d - 1 - by1
    var diff: usize = 0
    if r_top > r_bottom {
        diff = r_top - r_bottom
    } else {
        diff = r_bottom - r_top
    }
    var ne: [u8; 33] = "  centred in the box (margin +-1)"
    report((&ne[0]) as u64, 33, diff <= 1, r_top as i64, r_bottom as i64)
}

// How many pixels does the cross occupy? For the scaling check.
fn count_px(p: u64, d: usize, sb: usize) -> usize {
    var z: core.Target = core.target_new(p, W, H, W * 4)
    core.fill_all(&z, 0 as u32)
    core.cap_close(&z, 10, 10, d, sb, 16777215 as u32)
    var n: usize = 0
    var y: usize = 0
    while y < H {
        var x: usize = 0
        while x < W {
            if core.get(&z, x, y) != 0 as u32 {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn main(start: u64) -> i32 {
    let p: u64 = rt.heap_alloc(W * H * 4)
    if p == 0 as u64 {
        return 2
    }

    var k1: [u8; 26] = "CROSS d=10 sb=1 (scale 1)\n"
    rt.write_everything(1, (&k1[0]) as u64, 26)
    check_capicon(p, 10, 1)

    var k2: [u8; 26] = "CROSS d=20 sb=2 (scale 2)\n"
    rt.write_everything(1, (&k2[0]) as u64, 26)
    check_capicon(p, 20, 2)

    var k3: [u8; 26] = "CROSS d=30 sb=3 (scale 3)\n"
    rt.write_everything(1, (&k3[0]) as u64, 26)
    check_capicon(p, 30, 3)

    // ---- D: IT REALLY SCALES.
    //
    // Exactly the bug in Justin's photo: the button grew, the glyph
    // did not. A cross at d=20 must occupy noticeably more pixels
    // than one at d=10 -- if the same number appears, the scaling
    // has been lost.
    let n1: usize = count_px(p, 10, 1)
    let n2: usize = count_px(p, 20, 2)
    let n3: usize = count_px(p, 30, 3)
    var ns: [u8; 24] = "  grows with the scaling"
    report((&ns[0]) as u64, 24, n2 > n1 && n3 > n2, n1 as i64, n2 as i64)

    var t: rt.Buf = rt.buf_new()
    var z1: [u8; 18] = "\npixels 10/20/30: "
    rt.buf_push_bytes(&t, (&z1[0]) as u64, 18)
    rt.buf_push_dec_i64(&t, n1 as i64)
    rt.buf_push(&t, 47 as u8)
    rt.buf_push_dec_i64(&t, n2 as i64)
    rt.buf_push(&t, 47 as u8)
    rt.buf_push_dec_i64(&t, n3 as i64)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)

    if G_ERRORS > 0 {
        var f: [u8; 23] = "CROSS IS NOT IN ORDER.\n"
        rt.write_everything(1, (&f[0]) as u64, 23)
        return 1
    }
    var o: [u8; 14] = "CROSS PASSED.\n"
    rt.write_everything(1, (&o[0]) as u64, 14)
    return 0
}
