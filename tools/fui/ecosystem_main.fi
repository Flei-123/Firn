// SPDX-License-Identifier: MPL-2.0
// tools/fui/ecosystem_main.fi -- COMPONENT GALLERY of the ecosystem pieces (splitter, ripple).
//
//   ecosystem_main check             paints the sheet twice; the two frames must be identical and not empty
//   ecosystem_main shot <out-dir>    writes <out-dir>/ecosystem.png
//
// One sheet, 640 x 360: side-by-side splitter at rest / hovered / dragged, a stacked one, an RTL one,
// and a ripple on a button at 60 / 180 / 450 ms after the press and 150 ms into the fade.
import std.rt
import paint.canvas
import paint.png
import html.mem
import font.metrics
import fui.painter
import fui.splitter
import fui.ripple
import fui.recorder
import fui.safeout
import plat.sysfont

const W: usize = 640
const H: usize = 360

static mut FONT: u64 = 0
static mut FAILS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if !ok {
        FAILS = FAILS + 1
        say("FAIL: ")
        say(what)
        say("\n")
    }
}

fn caption(z: *mut painter.Painter, x: f64, y: f64, s: str) {
    let n: f64 = painter.text(z, x, y, 300.0, 12.0, 0xFF303030 as u32, s.p as u64, s.n, painter.TEXT_L)
}

// a splitter demo box: pane fills + the divider
fn box_split(z: *mut painter.Painter, sp: *mut splitter.Splitter, x: i64, y: i64, w: i64, h: i64) {
    splitter.layout(sp, x, y, w, h)
    var r: [i64; 4] = [0, 0, 0, 0]
    splitter.pane_a(sp, &r)
    painter.surface(z, r[0] as f64, r[1] as f64, r[2] as f64, r[3] as f64, 0xFFDCE6F5 as u32)
    splitter.pane_b(sp, &r)
    painter.surface(z, r[0] as f64, r[1] as f64, r[2] as f64, r[3] as f64, 0xFFF5E8D8 as u32)
    splitter.draw(z, sp, 0xFFB8B8B8 as u32, 0xFF9AB4E0 as u32, 0xFF4A7FD0 as u32, 0xFF606060 as u32)
}

fn paint_sheet(z: *mut painter.Painter) {
    painter.painter_clear(z, 0xFFFFFFFF as u32)
    caption(z, 16.0, 20.0, "Splitter: rest / hover / drag")
    var s1: splitter.Splitter = splitter.splitter_new(false, 300)
    box_split(z, &s1, 16, 28, 190, 80)
    var s2: splitter.Splitter = splitter.splitter_new(false, 500)
    box_split(z, &s2, 224, 28, 190, 80)
    let h2: bool = splitter.move(&s2, 224 + 95 + 2, 60)
    splitter.draw(z, &s2, 0xFFB8B8B8 as u32, 0xFF9AB4E0 as u32, 0xFF4A7FD0 as u32, 0xFF606060 as u32)
    var s3: splitter.Splitter = splitter.splitter_new(false, 500)
    box_split(z, &s3, 432, 28, 190, 80)
    let d3: bool = splitter.down(&s3, 432 + 95 + 2, 60)
    let m3: bool = splitter.move(&s3, 432 + 130, 60)
    box_split(z, &s3, 432, 28, 190, 80)

    caption(z, 16.0, 136.0, "Stacked / RTL")
    var s4: splitter.Splitter = splitter.splitter_new(true, 400)
    box_split(z, &s4, 16, 144, 190, 100)
    var s5: splitter.Splitter = splitter.splitter_new(false, 300)
    splitter.set_rtl(&s5, true)
    box_split(z, &s5, 224, 144, 190, 100)

    caption(z, 16.0, 270.0, "Ripple: 60 / 180 / 450 ms, 150 ms into the fade")
    var k: i64 = 0
    while k < 4 {
        let bx: f64 = 16.0 + (k * 156) as f64
        painter.round_rect(z, bx, 280.0, 140.0, 56.0, 8.0, 0xFF3F6FD0 as u32)
        var rp: ripple.Ripples = ripple.ripples_new()
        let s: usize = ripple.press(&rp, 0, bx + 40.0, 308.0, bx, 280.0, 140.0, 56.0)
        var t: i64 = 60
        if k == 1 {
            t = 180
        } else if k == 2 {
            t = 450
        } else if k == 3 {
            ripple.release(&rp, 300)
            t = 450
        }
        ripple.paint(z, &rp, t, bx, 280.0, 140.0, 56.0, 8.0, 0x00FFFFFF as u32)
        k = k + 1
    }
}

struct Rig {
    cv: canvas.Canvas,
    z: painter.Painter,
}

fn rig_open(r: *mut Rig) -> bool {
    (*r).cv = canvas.canvas_new()
    (*r).z = painter.painter_new()
    if !canvas.canvas_init(&(*r).cv, W, H) || !painter.painter_init(&(*r).z, &(*r).cv, W, H) {
        return false
    }
    painter.painter_set_font(&(*r).z, FONT)
    return true
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("ecosystem: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    var r: Rig = Rig { cv: canvas.canvas_new(), z: painter.painter_new() }
    if !rig_open(&r) {
        say("ecosystem: no surface\n")
        return 8
    }
    paint_sheet(&r.z)
    if rt.arg_count(start) >= 3 {
        // shot <out-dir>
        let dir: u64 = rt.arg_ptr(start, 2)
        var out: mem.Buf = mem.buf_new()
        mem.buf_init(&out)
        if !png.write_png(&r.cv, &out) {
            say("ecosystem: png failed\n")
            return 7
        }
        var pf: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&pf, dir, rt.c_length(dir))
        var nm: [u8; 15] = "/ecosystem.png\0"
        rt.buf_push_bytes(&pf, (&nm[0]) as u64, 15)
        let ok: bool = safeout.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
        rt.buf_free(&pf)
        if !ok {
            say("ecosystem: write refused\n")
            return 6
        }
        say("ECOSYSTEM SHOT written\n")
        return 0
    }
    let h1: u64 = recorder.hash_pixels(canvas.canvas_pixels(&r.cv), W, H)
    var r2: Rig = Rig { cv: canvas.canvas_new(), z: painter.painter_new() }
    check(rig_open(&r2), "second surface")
    paint_sheet(&r2.z)
    let h2: u64 = recorder.hash_pixels(canvas.canvas_pixels(&r2.cv), W, H)
    check(h1 == h2, "the sheet paints identically twice")
    // not empty: a white sheet would hash like a blank one
    var blank: Rig = Rig { cv: canvas.canvas_new(), z: painter.painter_new() }
    check(rig_open(&blank), "blank surface")
    painter.painter_clear(&blank.z, 0xFFFFFFFF as u32)
    check(recorder.hash_pixels(canvas.canvas_pixels(&blank.cv), W, H) != h1, "the sheet is not blank")
    if FAILS > 0 {
        say("ECOSYSTEM FAILED\n")
        return 1
    }
    say("ECOSYSTEM PASSED\n")
    return 0
}
