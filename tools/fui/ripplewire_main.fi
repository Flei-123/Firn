// tools/fui/ripplewire_main.fi -- the press wave on buttons: theme token Shape.ripple (default 0), appctl.ripple_on.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn clicked(a: *mut app.App) {
}

fn hash_rect(s: *mut Surface, x0: usize, y0: usize, w: usize, h: usize) -> u64 {
    var acc: u64 = 7
    var y: usize = y0
    while y < y0 + h {
        var x: usize = x0
        while x < x0 + w {
            acc = ((acc * 31) % 1000000007) ^ (canvas.canvas_get(&(*s).cv, x, y) as u64)
            x = x + 1
        }
        y = y + 1
    }
    return acc
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("ripplewire: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Ripple", 300, 200)
    let b: usize = app.button(a, "Go", clicked)
    let s: *mut Surface = surface_for(a, 300, 200)
    check((*theme.theme_shape(app.app_theme(a))).ripple == 0, "default: ripple token is 0")
    frame(a, s)
    frame(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    let bx: usize = scene.node_x(sc, b) as usize
    let by: usize = scene.node_y(sc, b) as usize
    let bw: usize = scene.node_w(sc, b) as usize
    let bh: usize = scene.node_h(sc, b) as usize
    check(bw > 10 && bh > 10, "button has a size")
    let w: *mut fuiwirt.Host = app.app_host(a)
    let px: f64 = (bx + bw / 4) as f64
    let py: f64 = (by + bh / 2) as f64
    // phase 1: token off (appctl installed, ripple_on false)
    appctl.ripple_on(a, false)
    check((*theme.theme_shape(app.app_theme(a))).ripple == 0, "ripple_on(false) keeps the token 0")
    fuiwirt.host_tick(w, 0)
    let m0: u32 = fuiwirt.host_pointer_move(w, px, py)
    fuiwirt.host_tick(w, 10)
    let d0: u32 = fuiwirt.host_pointer_down(w, px, py, fuiwirt.BTN_LEFT)
    fuiwirt.host_tick(w, 150)
    frame(a, s)
    frame(a, s)
    let h_off: u64 = hash_rect(s, bx, by, bw, bh)
    let u0: u32 = fuiwirt.host_pointer_up(w, px, py, fuiwirt.BTN_LEFT)
    fuiwirt.host_tick(w, 1000)
    frame(a, s)
    frame(a, s)
    let idle: u64 = hash_rect(s, bx, by, bw, bh)
    // phase 2: token on
    appctl.ripple_on(a, true)
    check((*theme.theme_shape(app.app_theme(a))).ripple == 1, "ripple_on(true) sets the token")
    fuiwirt.host_tick(w, 2000)
    let d1: u32 = fuiwirt.host_pointer_down(w, px, py, fuiwirt.BTN_LEFT)
    fuiwirt.host_tick(w, 2150)
    frame(a, s)
    frame(a, s)
    let h_on: u64 = hash_rect(s, bx, by, bw, bh)
    check(h_on != h_off, "wave changes the held button")
    let u1: u32 = fuiwirt.host_pointer_up(w, px, py, fuiwirt.BTN_LEFT)
    fuiwirt.host_tick(w, 2200)
    frame(a, s)
    let h_fade: u64 = hash_rect(s, bx, by, bw, bh)
    fuiwirt.host_tick(w, 4000)
    frame(a, s)
    frame(a, s)
    let after: u64 = hash_rect(s, bx, by, bw, bh)
    check(after == idle, "after the fade the button is as before")
    // phase 3: off again -> same as phase 1 while held
    appctl.ripple_on(a, false)
    fuiwirt.host_tick(w, 5000)
    let d2: u32 = fuiwirt.host_pointer_down(w, px, py, fuiwirt.BTN_LEFT)
    fuiwirt.host_tick(w, 5150)
    frame(a, s)
    frame(a, s)
    check(hash_rect(s, bx, by, bw, bh) == h_off, "token 0 again: held button as in phase 1")
    let u2: u32 = fuiwirt.host_pointer_up(w, px, py, fuiwirt.BTN_LEFT)
    if BAD == 0 {
        say("RIPPLEWIRE PASSED\n")
        return 0
    }
    say("RIPPLEWIRE FAILED\n")
    return 1
}
