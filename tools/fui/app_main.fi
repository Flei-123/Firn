// SPDX-License-Identifier: MPL-2.0
// tools/fui/app_main.fi -- THE CHECK OF lib/fui/app.fi, WITHOUT A WINDOW.
//
// lib/fui/app.fi promises a tkinter-sized program: a window, a label, a
// button, rows, text fields, callbacks. This run builds the three
// examples of examples/fui/ the way they build themselves -- through the
// public calls only -- paints them into a canvas of their window size,
// and then drives them through the SAME entry points the platform hosts
// call (app_key / app_char / app_act and fuiwirt's pointer and keys), so
// what is checked here is what an X11 window and a browser page do, minus
// the window.
//
//     firnc -o /tmp/app tools/fui/app_main.fi && /tmp/app [dir-for-pngs]
//
// Every check prints one line; the last line is APP PASSED or APP FAILED.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import fui.style
import fui.sheet
import fui.render
import fui.listrow
import fui.event
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.textarea
import fui.textbuf

static mut BAD: usize = 0
static NM_WARM: [u8; 4] = "warm"
static mut CLOSED: usize = 0
static mut COUNT_ID: usize = 0
static mut NAME_ID: usize = 0
static mut MAIL_ID: usize = 0
static mut OUT_ID: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_num(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn same(a: str, b: str) -> bool {
    if a.n != b.n {
        return false
    }
    var i: usize = 0
    while i < a.n {
        if rt.ld8(a.p as u64, i) != rt.ld8(b.p as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// ------------------------------------------------------------ a surface

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

static mut FONT: u64 = 0

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

// The clock of the test: one frame, and then -- like a host that is asked for
// the next frame while a button glides (r126) -- further frames a second apart
// until the host has nothing more to paint. What is saved is the picture the
// user sees AFTER the hover/press glide, which is also what the browser
// shows after its settle time. `SETTLE = false`: exactly one frame.
static mut CLOCK: i64 = 1000
static mut SETTLE: bool = true

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
    var n: usize = 0
    while SETTLE && fuiwirt.host_dirty(app.app_host(a)) && n < 6 {
        CLOCK = CLOCK + 1000
        fuiwirt.host_tick(app.app_host(a), CLOCK)
        app.app_paint(a as u64, (*s).w, (*s).h)
        fuiwirt.host_painted(app.app_host(a))
        n = n + 1
    }
}

fn save(s: *mut Surface, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(&(*s).cv, &out) {
        let ok: bool = rt.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64,
            mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

// What the platform host does after an event: hand the activated node on.
fn settle(a: *mut app.App) {
    let i: usize = fuiwirt.host_take_activated(app.app_host(a))
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
}

fn click(a: *mut app.App, s: *mut Surface, id: usize) {
    let sc: *mut scene.Scene = app.app_scene(a)
    let x: f64 = scene.node_x(sc, id) + scene.node_w(sc, id) / 2.0
    let y: f64 = scene.node_y(sc, id) + scene.node_h(sc, id) / 2.0
    let w: *mut fuiwirt.Host = app.app_host(a)
    let c1: u32 = fuiwirt.host_pointer_move(w, x, y)
    let c2: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let c3: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
    settle(a)
    frame(a, s)
}

fn type_text(a: *mut app.App, t: str) {
    var i: usize = 0
    while i < t.n {
        let b: bool = app.app_char(a as u64, rt.ld8(t.p as u64, i) as u32, 0 as u32)
        i = i + 1
    }
}

fn centre_x(a: *mut app.App, id: usize) -> f64 {
    let sc: *mut scene.Scene = app.app_scene(a)
    return scene.node_x(sc, id) + scene.node_w(sc, id) / 2.0
}

fn inside(a: *mut app.App, id: usize, w: usize, h: usize) -> bool {
    let sc: *mut scene.Scene = app.app_scene(a)
    return scene.node_w(sc, id) > 0.0 && scene.node_h(sc, id) > 0.0
    && scene.node_x(sc, id) >= 0.0 && scene.node_y(sc, id) >= 0.0
    && scene.node_x(sc, id) + scene.node_w(sc, id) <= w as f64 + 0.5
    && scene.node_y(sc, id) + scene.node_h(sc, id) <= h as f64 + 0.5
}

fn near(a: f64, b: f64) -> bool {
    return a - b < 1.01 && b - a < 1.01
}

// ------------------------------------------------------------ the examples

fn close(a: *mut app.App) {
    CLOSED = CLOSED + 1
    app.quit(a)
}

fn plus(a: *mut app.App) {
    app.set_number(a, COUNT_ID, app.number(a, COUNT_ID) + 1)
}

fn minus(a: *mut app.App) {
    app.set_number(a, COUNT_ID, app.number(a, COUNT_ID) - 1)
}

fn send(a: *mut app.App) {
    app.set_text(a, OUT_ID, "Thanks, ")
    app.append_text(a, OUT_ID, app.text(a, NAME_ID))
    app.append_text(a, OUT_ID, "! We will write to ")
    app.append_text(a, OUT_ID, app.text(a, MAIL_ID))
}

fn clear(a: *mut app.App) {
    app.set_text(a, NAME_ID, "")
    app.set_text(a, MAIL_ID, "")
    app.set_text(a, OUT_ID, " ")
}

fn hello(dir: u64) {
    say("== hello_window (the tkinter Test Window)\n")
    let a: *mut app.App = app.window("Test Window", 400, 250)
    let l: usize = app.label(a, "Hello, this is a test window!", 16)
    let b: usize = app.button(a, "Close", close)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 400, 250)
    frame(a, s)
    save(s, dir, "app-hello.png")
    let sc: *mut scene.Scene = app.app_scene(a)
    check(inside(a, l, 400, 250) && inside(a, b, 400, 250),
        "label and button lie inside the 400 x 250 window")
    check(near(centre_x(a, l), 200.0) && near(centre_x(a, b), 200.0),
        "both are centred horizontally (tkinter pack)")
    check(scene.node_y(sc, l) + scene.node_h(sc, l) <= scene.node_y(sc, b),
        "the label stands above the button")
    let bottom: f64 = scene.node_y(sc, b) + scene.node_h(sc, b)
    let mid: f64 = (scene.node_y(sc, l) + bottom) / 2.0
    check(near(mid, 125.0), "the pair is centred vertically")
    check(scene.node_h(sc, l) > scene.node_h(sc, b) / 2.0,
        "the 16 pt label is not smaller than the default text")
    check(same(app.text(a, l), "Hello, this is a test window!"),
        "text(label) gives the label's text back")
    check(!app.app_done(a as u64), "the window is open before the click")
    click(a, s, b)
    check(CLOSED == 1 && app.app_done(a as u64),
        "a click on Close calls the callback and ends the window")

    // the keyboard: Tab to the button, the space bar presses it
    let k: *mut app.App = app.window("Keys", 400, 250)
    let kl: usize = app.label(k, "keys", 0)
    let kb: usize = app.button(k, "Close", close)
    fuiwirt.host_bind(app.app_host(k))
    let ks: *mut Surface = surface_for(k, 400, 250)
    frame(k, ks)
    let t: u32 = fuiwirt.host_key(app.app_host(k), fuiwirt.KEY_TAB, 0 as u32)
    check(app.focus(k) == kb, "Tab puts the focus on the button")
    let sp: bool = app.app_char(k as u64, 32 as u32, 0 as u32)
    check(!sp, "the space bar is not taken while no text field has the focus")
    let c: u32 = fuiwirt.host_char(app.app_host(k), 32 as u32, 0 as u32)
    settle(k)
    check(CLOSED == 2 && app.app_done(k as u64),
        "the space bar on the focused button closes the window")
}

fn counter(dir: u64) {
    say("== counter\n")
    let a: *mut app.App = app.window("Counter", 300, 200)
    COUNT_ID = app.label(a, "0", 32)
    let r: usize = app.row(a)
    let m: usize = app.button(a, "  -  ", minus)
    let p: usize = app.button(a, "  +  ", plus)
    app.end(a)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 300, 200)
    frame(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    check(near(scene.node_y(sc, m), scene.node_y(sc, p))
        && scene.node_x(sc, m) + scene.node_w(sc, m) <= scene.node_x(sc, p),
        "row(): - and + stand side by side")
    check(scene.scene_parent(sc, m) == r && scene.scene_parent(sc, COUNT_ID)
        == scene.scene_root(sc), "end() closes the row; the label is outside")
    click(a, s, p)
    click(a, s, p)
    click(a, s, p)
    click(a, s, m)
    check(app.number(a, COUNT_ID) == 2 && same(app.text(a, COUNT_ID), "2"),
        "three times + and once - shows 2")
    click(a, s, m)
    click(a, s, m)
    click(a, s, m)
    check(same(app.text(a, COUNT_ID), "-1"), "below zero it shows -1")
    click(a, s, p)
    click(a, s, p)
    click(a, s, p)
    save(s, dir, "app-counter.png")
}

fn form(dir: u64) {
    say("== form (text fields)\n")
    let a: *mut app.App = app.window("Sign up", 420, 300)
    let t: usize = app.label(a, "Sign up for the newsletter", 14)
    NAME_ID = app.entry(a, "Your name")
    MAIL_ID = app.entry(a, "you@example.com")
    let r: usize = app.row(a)
    let b: usize = app.button(a, "Send", send)
    let cl: usize = app.button(a, "Clear", clear)
    app.end(a)
    OUT_ID = app.label(a, " ", 0)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 420, 300)
    frame(a, s)
    save(s, dir, "app-form-empty.png")
    click(a, s, NAME_ID)
    check(app.focus(a) == NAME_ID, "a click puts the focus into the field")
    type_text(a, "Justin Fleischerx")
    let bs: bool = app.app_key(a as u64, editor.KEY_BACKSPACE, 0 as u32)
    check(bs && same(app.text(a, NAME_ID), "Justin Fleischer"),
        "typed letters (space included) and Backspace land in the field")
    let tab: bool = app.app_key(a as u64, editor.KEY_TAB, 0 as u32)
    check(!tab, "Tab is not taken by the field ...")
    let t2: u32 = fuiwirt.host_key(app.app_host(a), fuiwirt.KEY_TAB, 0 as u32)
    check(app.focus(a) == MAIL_ID, "... and moves the focus to the next field")
    type_text(a, "justin@fleitec.com")
    frame(a, s)
    click(a, s, b)
    let want: str = "Thanks, Justin Fleischer! We will write to justin@fleitec.com"
    check(same(app.text(a, OUT_ID), want),
        "Send reads both fields and writes the answer")
    check(inside(a, OUT_ID, 420, 300),
        "an answer wider than the window still lies inside it")
    save(s, dir, "app-form-filled.png")
    click(a, s, cl)
    check(app.text(a, NAME_ID).n == 0 && app.text(a, MAIL_ID).n == 0
        && same(app.text(a, OUT_ID), " "), "Clear empties both fields and the answer")
}

static mut BOX_ID: usize = 0
static mut NOTE_ID: usize = 0

// the same two callbacks as examples/fui/notes.fi
fn count_chars(a: *mut app.App) {
    app.set_number(a, NOTE_ID, app.text(a, BOX_ID).n as i64)
    app.append_text(a, NOTE_ID, " characters")
}

fn clear_notes(a: *mut app.App) {
    app.set_text(a, BOX_ID, "")
    app.set_text(a, NOTE_ID, " ")
}

// the picture the browser check compares with: two lines typed, Count pressed
fn notes_pic(dir: u64) {
    say("== notes, the picture for the browser\n")
    let a: *mut app.App = app.window("Notes", 420, 360)
    BOX_ID = app.textarea(a, "Notes", 6)
    let r: usize = app.row(a)
    let b: usize = app.button(a, "Count", count_chars)
    let b2: usize = app.button(a, "Clear", clear_notes)
    app.end(a)
    NOTE_ID = app.label(a, " ", 0)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 420, 360)
    frame(a, s)
    click(a, s, BOX_ID)
    type_text(a, "first line")
    let en: bool = app.app_key(a as u64, editor.KEY_ENTER, 0 as u32)
    type_text(a, "second line")
    click(a, s, b)
    check(same(app.text(a, NOTE_ID), "22 characters"), "Count reports 22 characters for 'first line LF second line'")
    save(s, dir, "app-notes-counted.png")
    click(a, s, b2)
    check(app.text(a, BOX_ID).n == 0 && same(app.text(a, NOTE_ID), " "), "Clear empties the area and the answer")
}

// the caret of the focused text field, from its buffer
fn caret_of(a: *mut app.App) -> i64 {
    let b: u64 = app.app_entry_buf(a as u64)
    if b == 0 {
        return 0 - 1
    }
    return textbuf.tb_caret(b as *mut textbuf.TextBuf) as i64
}

fn notes(dir: u64) {
    say("== notes (a text area)\n")
    let a: *mut app.App = app.window("Notes", 420, 360)
    BOX_ID = app.textarea(a, "Notes", 6)
    let r: usize = app.row(a)
    let b: usize = app.button(a, "Count", count_chars)
    let b2: usize = app.button(a, "Clear", clear_notes)
    app.end(a)
    NOTE_ID = app.label(a, " ", 0)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 420, 360)
    frame(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    save(s, dir, "app-notes-empty.png")
    check(scene.node_h(sc, BOX_ID) > scene.node_w(sc, BOX_ID) * 0.3
        && scene.node_h(sc, BOX_ID) < scene.node_w(sc, BOX_ID),
        "the text area is a box several lines tall")
    let ar: *mut textarea.Lines = app.lines_of(a, BOX_ID)
    check(ar as u64 != 0 && textarea.ta_line_count(ar) == 1, "an empty text area is ONE line")
    check(app.lines_of(a, b) as u64 == 0, "a button is no text area")
    click(a, s, BOX_ID)
    check(app.focus(a) == BOX_ID, "a click puts the focus into the area")
    type_text(a, "first line")
    let en: bool = app.app_key(a as u64, editor.KEY_ENTER, 0 as u32)
    check(en, "Enter is taken by the area (a field would pass it on) ...")
    type_text(a, "second line")
    check(same(app.text(a, BOX_ID), "first line\nsecond line"),
        "... and puts a line break into the text")
    frame(a, s)
    check(textarea.ta_line_count(ar) == 2, "two lines")
    save(s, dir, "app-notes-two.png")
    // a long line wraps at the box
    type_text(a, " and then a very long ending that cannot possibly fit into the width of this box")
    frame(a, s)
    check(textarea.ta_line_count(ar) >= 4, "a long line wraps: four lines or more")
    // Ctrl+Home, then the first line: the mouse puts the caret at the start of the 3rd line's x
    let hm: bool = app.app_key(a as u64, editor.KEY_HOME, editor.MOD_CTRL)
    check(hm && caret_of(a) == 0, "Ctrl+Home puts the caret at the start of the text")
    let dn: bool = app.app_key(a as u64, editor.KEY_DOWN, 0 as u32)
    check(dn && caret_of(a) == 11, "Down goes to the second line (byte 11)")
    // the mouse: a click at the left edge of the box, at the first line
    let w: *mut fuiwirt.Host = app.app_host(a)
    let bx: f64 = scene.node_x(sc, BOX_ID)
    let by: f64 = scene.node_y(sc, BOX_ID)
    let c1: u32 = fuiwirt.host_pointer_move(w, bx + 14.0, by + 10.0)
    let c2: u32 = fuiwirt.host_pointer_down(w, bx + 14.0, by + 10.0, fuiwirt.BTN_LEFT)
    let c3: u32 = fuiwirt.host_pointer_up(w, bx + 14.0, by + 10.0, fuiwirt.BTN_LEFT)
    check(caret_of(a) == 0, "a click at the left edge of line 1 puts the caret at byte 0")
    // a click inside the first word: the caret goes there, not to the end
    let c4: u32 = fuiwirt.host_pointer_down(w, bx + 52.0, by + 10.0, fuiwirt.BTN_LEFT)
    let c5: u32 = fuiwirt.host_pointer_up(w, bx + 52.0, by + 10.0, fuiwirt.BTN_LEFT)
    check(caret_of(a) > 0 && caret_of(a) < 10, "a click inside 'first' puts the caret between its letters")
    // a drag selects
    let c6: u32 = fuiwirt.host_pointer_move(w, bx + 14.0, by + 10.0)
    let c7: u32 = fuiwirt.host_pointer_down(w, bx + 14.0, by + 10.0, fuiwirt.BTN_LEFT)
    let c8: u32 = fuiwirt.host_pointer_move(w, bx + 70.0, by + 10.0)
    let c9: u32 = fuiwirt.host_pointer_up(w, bx + 70.0, by + 10.0, fuiwirt.BTN_LEFT)
    let tb: *mut textbuf.TextBuf = app.app_entry_buf(a as u64) as *mut textbuf.TextBuf
    check(textbuf.tb_has_sel(tb) && textbuf.tb_sel_a(tb) == 0 && textbuf.tb_sel_b(tb) >= 4,
        "dragging across the first word selects it")
    frame(a, s)
    save(s, dir, "app-notes-selected.png")
    let t1: bool = app.app_char(a as u64, 88 as u32, 0 as u32)
    check(app.text(a, BOX_ID).n > 0 && rt.ld8(app.text(a, BOX_ID).p as u64, 0) == 88 as u8,
        "typing replaces the selection")
    // a lot of text: the area scrolls, the wheel moves it
    var i: usize = 0
    while i < 14 {
        let e2: bool = app.app_key(a as u64, editor.KEY_ENTER, 0 as u32)
        type_text(a, "more")
        i = i + 1
    }
    frame(a, s)
    check(textarea.ta_scroll_y(ar) > 0.0, "typing past the bottom scrolls the area")
    let sy: f64 = textarea.ta_scroll_y(ar)
    let c10: u32 = fuiwirt.host_pointer_move(w, bx + 30.0, by + 30.0)
    let c11: u32 = fuiwirt.host_pointer_down(w, bx + 30.0, by + 30.0, fuiwirt.BTN_WHEEL_UP)
    check(textarea.ta_scroll_y(ar) < sy, "the wheel scrolls the area under the pointer (up)")
    frame(a, s)
    save(s, dir, "app-notes-scrolled.png")
    click(a, s, b)
    check(app.number(a, NOTE_ID) == app.text(a, BOX_ID).n as i64, "a button reads the whole text of the area (number before the word)")
    // r127: a FINGER on the area scrolls it (the caret and the selection stay), a
    // tap that did not move puts the caret
    click(a, s, BOX_ID)
    let car0: i64 = caret_of(a)
    let sy0: f64 = textarea.ta_scroll_y(ar)
    let f1: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_DOWN, 7 as u32, event.PT_TOUCH, true, bx + 30.0, by + 80.0, 100)
    let f2: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_MOVE, 7 as u32, event.PT_TOUCH, true, bx + 30.0, by + 60.0, 130)
    let f3: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_MOVE, 7 as u32, event.PT_TOUCH, true, bx + 30.0, by + 20.0, 160)
    let f4: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 7 as u32, event.PT_TOUCH, true, bx + 30.0, by + 20.0, 190)
    check(textarea.ta_scroll_y(ar) > sy0, "a finger dragged UP scrolls the area down (the text follows the finger)")
    check(caret_of(a) == car0 && !textbuf.tb_has_sel(app.app_entry_buf(a as u64) as *mut textbuf.TextBuf),
        "and neither moves the caret nor selects")
    let f5: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_DOWN, 8 as u32, event.PT_TOUCH, true, bx + 52.0, by + 100.0, 300)
    let f6: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 8 as u32, event.PT_TOUCH, true, bx + 52.0, by + 100.0, 330)
    check(caret_of(a) != car0, "a tap without movement puts the caret where it landed")
    let car1: i64 = caret_of(a)
    let f7: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_DOWN, 9 as u32, event.PT_MOUSE, true, bx + 30.0, by + 80.0, 400)
    let f8: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_MOVE, 9 as u32, event.PT_MOUSE, true, bx + 30.0, by + 20.0, 430)
    let f9: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 9 as u32, event.PT_MOUSE, true, bx + 30.0, by + 20.0, 460)
    check(textbuf.tb_has_sel(app.app_entry_buf(a as u64) as *mut textbuf.TextBuf),
        "the same drag with a MOUSE selects, as before")
}

// r70: a merge group in the scene tree -- two buttons in a row whose
// surfaces melt into one shape when closer than k, with their labels on top
fn melt(dir: u64) {
    say("== merge group (scene.node_set_merge)\n")
    let a: *mut app.App = app.window("Melt", 300, 160)
    let r: usize = app.row(a)
    let b1: usize = app.button(a, "One", close)
    let b2: usize = app.button(a, "Two", close)
    app.end(a)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 300, 160)
    let sc: *mut scene.Scene = app.app_scene(a)
    frame(a, s)
    let gx: usize = ((scene.node_x(sc, b1) + scene.node_w(sc, b1)
            +scene.node_x(sc, b2)) / 2.0) as usize
    let gy: usize = (scene.node_y(sc, b1) + scene.node_h(sc, b1) / 2.0) as usize
    let apart: u32 = canvas.canvas_get(&(*s).cv, gx, gy)
    let bgc: u32 = canvas.canvas_get(&(*s).cv, 3, 3)
    check(apart == bgc, "without a merge group the gap between the buttons is background")
    // the same picture of the second button's face, to compare later
    let face: u32 = canvas.canvas_get(&(*s).cv, (scene.node_x(sc, b2) + 6.0) as usize, gy)
    scene.node_set_merge(sc, r, 16)
    frame(a, s)
    let melted: u32 = canvas.canvas_get(&(*s).cv, gx, gy)
    check(melted != bgc, "with node_set_merge(16) the neck between the buttons is filled")
    save(s, dir, "app-melt.png")
    // r72: the second button gets a fill of its own -- the first keeps its
    // colour, the second has the new one, the neck is neither
    let f1: u32 = canvas.canvas_get(&(*s).cv, (scene.node_x(sc, b1) + 6.0) as usize, gy)
    var warm: style.Style = style.style_new()
    warm = style.style_set_bg(warm, 4294095706 as u32)
    let nm: u32 = sheet.sheet_name((&NM_WARM[0]) as u64, 4)
    let rl: usize = sheet.sheet_rule(&(*a).sh, sheet.sel_class(nm), warm)
    let okc: bool = scene.node_add_class(sc, b2, nm)
    frame(a, s)
    let g1: u32 = canvas.canvas_get(&(*s).cv, (scene.node_x(sc, b1) + 6.0) as usize, gy)
    let g2: u32 = canvas.canvas_get(&(*s).cv, (scene.node_x(sc, b2) + scene.node_w(sc, b2) - 6.0) as usize, gy)
    let gn: u32 = canvas.canvas_get(&(*s).cv, gx, gy)
    check(g1 == f1, "per-shape colour: the first button keeps its own colour")
    check(g2 != f1 && g2 != bgc, "per-shape colour: the second button has the colour it was given")
    check(gn != bgc && gn != g1 && gn != g2, "per-shape colour: the neck is a mix of the two, not one of them")
    save(s, dir, "app-melt-colours.png")
    // (the class stays; the checks below look at the neck only, and k = 1 / 0 still apply)
    // far apart: the same group leaves the gap alone
    scene.node_set_merge(sc, r, 1)
    frame(a, s)
    let tight: u32 = canvas.canvas_get(&(*s).cv, gx, gy)
    check(tight == bgc, "k = 1 (gap 10) leaves the gap alone: shapes further apart than the reach stay apart")
    scene.node_set_merge(sc, r, 0)
    frame(a, s)
    check(canvas.canvas_get(&(*s).cv, gx, gy) == bgc, "node_set_merge(0) turns it off again")
}

// r129: a list of rows with symbols (examples/fui/files.fi, lib/fui/listrow.fi)
static mut FILES_INFO: usize = 0

// the same program as examples/fui/files.fi (the browser compares the picture)
fn files_docs(a: *mut app.App) {
    app.set_text(a, FILES_INFO, "Documents: 12 items")
}

fn files_notes(a: *mut app.App) {
    app.set_text(a, FILES_INFO, "notes.txt: 2 KB")
}

fn files_photo(a: *mut app.App) {
    app.set_text(a, FILES_INFO, "photo.png: 1.4 MB")
}

fn files_trash(a: *mut app.App) {
    app.set_text(a, FILES_INFO, "Trash: nothing in it")
}

fn tokc(a: *mut app.App, t: u32) -> u32 {
    return theme.opaque(theme.color_from_token(app.app_theme(a), t))
}

fn files(dir: u64) {
    say("== files (a list of rows with symbols)\n")
    let a: *mut app.App = app.window("Files", 380, 300)
    app.label(a, "Files", 14)
    let l: usize = app.list(a)
    let r1: usize = app.list_item(a, "folder", "Documents", "12 items", "3", files_docs)
    let r2: usize = app.list_item(a, "pencil", "notes.txt", "2 KB", "", files_notes)
    let r3: usize = app.list_item(a, "image", "photo.png", "1.4 MB", "new", files_photo)
    let r4: usize = app.list_item(a, "trash", "Trash", "", "", files_trash)
    app.end(a)
    FILES_INFO = app.label(a, " ", 0)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 380, 300)
    frame(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    check(r1 != app.NONE && r4 != app.NONE && l != app.NONE, "the list and its four rows exist")
    check(scene.node_y(sc, r2) > scene.node_y(sc, r1) && near(scene.node_w(sc, r1), scene.node_w(sc, l)),
        "the rows stand one below the other, each as wide as the list")
    check(scene.scene_child_count(sc, r1) == 4 && scene.scene_child_count(sc, r2) == 3
        && scene.scene_child_count(sc, r4) == 2,
        "row 1 has symbol, text, detail and badge; row 2 has no badge; row 4 only symbol and text")
    let ic: usize = scene.scene_child_at(sc, r1, 0)
    let tx: usize = scene.scene_child_at(sc, r1, 1)
    check(scene.node_x(sc, ic) < scene.node_x(sc, tx), "the symbol is left of the text")
    save(s, dir, "app-files.png")
    // the pointer over row 2: it gets the hover colour
    let w: *mut fuiwirt.Host = app.app_host(a)
    let mx: f64 = scene.node_x(sc, r2) + 40.0
    let my: f64 = scene.node_y(sc, r2) + scene.node_h(sc, r2) / 2.0
    let m1: u32 = fuiwirt.host_pointer_move(w, mx, my)
    frame(a, s)
    let px2: usize = (scene.node_x(sc, r2) + 3.0) as usize
    let py2: usize = (scene.node_y(sc, r2) + 2.0) as usize
    check(canvas.canvas_get(&(*s).cv, px2, py2) == tokc(a, style.TOK_BUTTON_HOVER),
        "the row under the mouse has the hover colour")
    // away again
    let m2: u32 = fuiwirt.host_pointer_move(w, 5.0, 290.0)
    frame(a, s)
    check(canvas.canvas_get(&(*s).cv, px2, py2) != tokc(a, style.TOK_BUTTON_HOVER),
        "and loses it when the mouse leaves the row")
    // a click chooses row 1 and runs its handler
    click(a, s, r1)
    check(same(app.text(a, FILES_INFO), "Documents: 12 items"), "a click on row 1 runs its handler")
    check(app.chosen(a, l) == r1, "and chooses it")
    let px1: usize = (scene.node_x(sc, r1) + 3.0) as usize
    let py1: usize = (scene.node_y(sc, r1) + 2.0) as usize
    check(canvas.canvas_get(&(*s).cv, px1, py1) == tokc(a, style.TOK_SELECTION),
        "the chosen row has the selection colour, also while the mouse is on it")
    click(a, s, r2)
    check(same(app.text(a, FILES_INFO), "notes.txt: 2 KB") && app.chosen(a, l) == r2,
        "a click on row 2 runs ITS handler and chooses it")
    check(canvas.canvas_get(&(*s).cv, px1, py1) != tokc(a, style.TOK_SELECTION),
        "row 1 is no longer chosen")
    save(s, dir, "app-files-chosen.png")
    check(app.audit(a) == 0, "the accessibility audit passes (rows are named)")
}

// r126: a button glides between rest and hover in fui.app (the host gives the
// clock, asks for frames while the transition runs and sleeps when it is done)
fn glide(dir: u64) {
    say("== hover transitions (r126)\n")
    SETTLE = false
    let a: *mut app.App = app.window("Glide", 300, 160)
    let b: usize = app.button(a, "Press", close)
    let w: *mut fuiwirt.Host = app.app_host(a)
    fuiwirt.host_bind(w)
    let s: *mut Surface = surface_for(a, 300, 160)
    let sc: *mut scene.Scene = app.app_scene(a)
    fuiwirt.host_tick(w, 1000)
    frame(a, s)
    let bx: usize = (scene.node_x(sc, b) + 5.0) as usize
    let by: usize = (scene.node_y(sc, b) + scene.node_h(sc, b) / 2.0) as usize
    let rest: u32 = canvas.canvas_get(&(*s).cv, bx, by)
    check(rest == tokc(a, style.TOK_BUTTON), "at rest the button has its rest colour")
    check(!fuiwirt.host_dirty(w), "and the host has nothing more to paint")
    let m: u32 = fuiwirt.host_pointer_move(w, scene.node_x(sc, b) + 20.0, scene.node_y(sc, b) + 10.0)
    fuiwirt.host_tick(w, 2000)
    frame(a, s)
    check(canvas.canvas_get(&(*s).cv, bx, by) == rest, "the frame of the change still shows the rest colour (the glide starts)")
    check(fuiwirt.host_dirty(w), "and the host asks for the next frame")
    fuiwirt.host_tick(w, 2060)
    frame(a, s)
    let mid: u32 = canvas.canvas_get(&(*s).cv, bx, by)
    check(mid != rest && mid != tokc(a, style.TOK_BUTTON_HOVER), "60 ms later the colour is between rest and hover")
    save(s, dir, "app-glide-mid.png")
    fuiwirt.host_tick(w, 2400)
    frame(a, s)
    check(canvas.canvas_get(&(*s).cv, bx, by) == tokc(a, style.TOK_BUTTON_HOVER), "after the duration it is the hover colour")
    // the frame in which it arrives is asked for once more, then the host sleeps
    fuiwirt.host_tick(w, 2416)
    frame(a, s)
    check(canvas.canvas_get(&(*s).cv, bx, by) == tokc(a, style.TOK_BUTTON_HOVER)
        && !fuiwirt.host_dirty(w), "one frame later the host sleeps again (no frame requested)")
    SETTLE = true
}

fn scale(dir: u64) {
    say("== scale 2 (a 192 dpi screen, devicePixelRatio 2)\n")
    let a: *mut app.App = app.window("Test Window", 400, 250)
    let l: usize = app.label(a, "Hello, this is a test window!", 16)
    let b: usize = app.button(a, "Close", close)
    fuiwirt.host_bind(app.app_host(a))
    let s1: *mut Surface = surface_for(a, 400, 250)
    frame(a, s1)
    let sc: *mut scene.Scene = app.app_scene(a)
    let h1: f64 = scene.node_h(sc, b)
    let w1: f64 = scene.node_w(sc, l)
    fuiwirt.host_set_scale(app.app_host(a), app.app_theme(a), 2000)
    let s2: *mut Surface = surface_for(a, 800, 500)
    frame(a, s2)
    let h2: f64 = scene.node_h(sc, b)
    let w2: f64 = scene.node_w(sc, l)
    check(h2 > h1 * 1.9 && h2 < h1 * 2.1 && w2 > w1 * 1.9 && w2 < w1 * 2.1,
        "at scale 2 the button and the label are twice as big")
    check(near(centre_x(a, b), 400.0), "and still centred")
    save(s2, dir, "app-hello-2x.png")
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("app: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    check(apphost.PLATFORM == apphost.PLATFORM_LINUX,
        "a native build gets the Linux host (lib/@linux/fui/apphost.fi)")
    hello(dir)
    counter(dir)
    form(dir)
    notes(dir)
    notes_pic(dir)
    melt(dir)
    files(dir)
    glide(dir)
    scale(dir)
    if BAD == 0 {
        say("APP PASSED\n")
        return 0
    }
    say("APP FAILED (")
    say_num(BAD as i64)
    say(")\n")
    return 1
}
