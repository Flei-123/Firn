import std.rt
import paint.canvas
import font.metrics
import fui.painter
import fui.app
import plat.fuiwirt
import plat.sysfont

static mut BAD: usize = 0
static mut HITS: usize = 0
static mut LAST_W: usize = 0
static mut LAST_H: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h) || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn on_size(a: *mut app.App, w: usize, h: usize) {
    HITS = HITS + 1
    LAST_W = w
    LAST_H = h
}

fn on_click(a: *mut app.App) {}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appresize: no font\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Resize", 1100, 700)
    let b: usize = app.button(a, "One", on_click)
    let b2: usize = app.button(a, "Two", on_click)
    app.on_size(a, on_size)
    fuiwirt.host_bind(app.app_host(a))
    let s1: *mut Surface = surface_for(a, 1100, 700)
    frame(a, s1)
    check(HITS == 1 && LAST_W == 1100 && LAST_H == 700, "first frame reports 1100x700")
    let m1: u32 = fuiwirt.host_pointer_move(app.app_host(a), 40.0, 20.0)
    frame(a, s1)
    check(HITS == 1, "a hover frame (partial repaint) does not report a size")
    let s2: *mut Surface = surface_for(a, 360, 800)
    fuiwirt.host_resize(app.app_host(a))
    frame(a, s2)
    check(HITS == 2 && LAST_W == 360 && LAST_H == 800, "live resize to 360x800 reports the new size")
    let m2: u32 = fuiwirt.host_pointer_move(app.app_host(a), 40.0, 20.0)
    let s3: *mut Surface = surface_for(a, 1100, 700)
    fuiwirt.host_resize(app.app_host(a))
    frame(a, s3)
    check(HITS == 3 && LAST_W == 1100 && LAST_H == 700, "resize with a pending hover back to 1100x700 reports the size")
    let s4: *mut Surface = surface_for(a, 1100, 500)
    fuiwirt.host_resize(app.app_host(a))
    frame(a, s4)
    check(HITS == 4 && LAST_H == 500, "a height-only resize reports the new height")
    frame(a, s4)
    check(HITS == 4, "an unchanged size reports nothing")
    if BAD == 0 {
        say("APPRESIZE PASSED\n")
        return 0
    }
    say("APPRESIZE FAILED\n")
    return 1
}
