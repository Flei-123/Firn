import std.rt
import fui.safeout
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.style
import fui.kit
import fui.kitcolor
import fui.lucide
import fui.action
import fui.nav_route
import fui.nav_layout
import fui.nav_rail
import fui.nav_palette
import plat.sysfont

static mut BAD: usize = 0
static mut CHECKS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
    w: usize,
    h: usize,
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    kitcolor.kit_theme(&(*p).m, dark)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    (*p).w = w
    (*p).h = h
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn tok(p: *mut Page, t: u32) -> u32 {
    return theme.opaque(render.color_of(&(*p).c, style.color_token(t)))
}

fn px(p: *mut Page, x: i32, y: i32) -> u32 {
    return canvas.canvas_get(&(*p).cv, x as usize, y as usize)
}

struct Chat {
    name: str,
    preview: str,
    badge: usize,
}

fn chat_at(i: usize) -> Chat {
    if i == 0 { return Chat { name: "Anna Berger", preview: "See you at the meeting", badge: 2 } }
    if i == 1 { return Chat { name: "Dev Team", preview: "Build is green", badge: 0 } }
    if i == 2 { return Chat { name: "Max Huber", preview: "Sent a file", badge: 5 } }
    if i == 3 { return Chat { name: "Lena Gruber", preview: "Thanks!", badge: 0 } }
    if i == 4 { return Chat { name: "Server News", preview: "Release notes are out", badge: 12 } }
    return Chat { name: "Family", preview: "Dinner at 7?", badge: 0 }
}

fn rail_build() -> nav_rail.Rail {
    var r: nav_rail.Rail = nav_rail.nrail_new()
    nav_rail.nrail_add(&r, "inbox", "Activity", lucide.BELL)
    nav_rail.nrail_add(&r, "chat", "Chat", lucide.MESSAGE_SQUARE)
    nav_rail.nrail_add(&r, "spaces", "Spaces", lucide.HASH)
    nav_rail.nrail_add(&r, "mail", "Mail", lucide.MAIL)
    nav_rail.nrail_add(&r, "cal", "Calendar", lucide.CLOCK)
    nav_rail.nrail_add(&r, "calls", "Calls", lucide.PHONE)
    nav_rail.nrail_add(&r, "files", "Files", lucide.FOLDER)
    nav_rail.nrail_add(&r, "settings", "Settings", lucide.SETTINGS)
    nav_rail.nrail_set_badge(&r, "inbox", 4 as u32)
    nav_rail.nrail_set_badge(&r, "chat", 19 as u32)
    nav_rail.nrail_set_badge(&r, "mail", 130 as u32)
    nav_rail.nrail_set_state(&r, "calls", nav_rail.NR_GREY)
    nav_rail.nrail_set_state(&r, "files", nav_rail.NR_HIDDEN)
    nav_rail.nrail_activate(&r, "chat")
    return r
}

fn draw_rail(p: *mut Page, r: *mut nav_rail.Rail, rc: nav_layout.NavRect) {
    let c: *mut render.Ctx = &(*p).c
    var items: [kit.NavItem; 12] = [kit.NavItem { icon: kit.ICON_NONE, label: "", badge: 0, header: false }; 12]
    var n: usize = 0
    var active: usize = kit.NONE
    var i: usize = 0
    while i < nav_rail.nrail_visible_count(r) {
        let k: usize = nav_rail.nrail_visible_at(r, i)
        items[n] = kit.NavItem { icon: (*r).it[k].icon, label: (*r).it[k].label, badge: (*r).it[k].badge as usize, header: false }
        if k == nav_rail.nrail_active(r) { active = n }
        n = n + 1
        i = i + 1
    }
    kit.nav_draw(c, (&items[0]) as *mut kit.NavItem, n, active, kit.NONE, false, rc.x as f64, rc.y as f64, rc.w as f64, rc.h as f64, true)
}

#[allow_escape]
fn badge_pill(p: *mut Page, x: f64, y: f64, n: usize) {
    let c: *mut render.Ctx = &(*p).c
    let z: *mut painter.Painter = &(*p).z
    var buf: [u8; 8] = [0 as u8; 8]
    let len: usize = nav_rail.nrail_badge_text(n as u32, (&buf[0]) as u64, 8)
    let s: str = str { p: (&buf[0]) as *mut u8, n: len }
    let tw: f64 = kit.text_width(c, 11.0, 700, s)
    var w: f64 = tw + 12.0
    if w < 18.0 { w = 18.0 }
    painter.round_rect(z, x - w, y, w, 18.0, 9.0, kit.tokc(c, style.TOK_ACCENT))
    kit.draw_label(c, x - w + (w - tw) / 2.0, y, 18.0, 11.0, 700, kit.tokc(c, style.TOK_TEXT_ON_ACCENT), s, tw + 4.0)
}

fn draw_list(p: *mut Page, rc: nav_layout.NavRect, active: usize, s: *mut kit.Search) {
    let c: *mut render.Ctx = &(*p).c
    let z: *mut painter.Painter = &(*p).z
    let x: f64 = rc.x as f64
    painter.surface(z, x, rc.y as f64, rc.w as f64, rc.h as f64, kit.tokc(c, style.TOK_SURFACE))
    painter.surface(z, x + rc.w as f64 - 1.0, rc.y as f64, 1.0, rc.h as f64, kit.tokc(c, style.TOK_SEPARATOR))
    kit.search_draw(c, s, x + 12.0, rc.y as f64 + 12.0, rc.w as f64 - 24.0, 36.0, "Search  Ctrl+K", false)
    var i: usize = 0
    while i < 6 {
        let ch: Chat = chat_at(i)
        let ry: f64 = rc.y as f64 + 60.0 + (i as f64) * 64.0
        if ry + 64.0 > (rc.y + rc.h) as f64 { return }
        if i == active {
            painter.round_rect(z, x + 6.0, ry, rc.w as f64 - 12.0, 60.0, 8.0, kit.tokc(c, style.TOK_BUTTON))
        }
        kit.avatar_draw(c, x + 14.0, ry + 10.0, 40.0, i as u32, ch.name, 0.0 as i64 - 1)
        let tw: f64 = rc.w as f64 - 14.0 - 40.0 - 12.0 - 16.0
        kit.draw_label(c, x + 64.0, ry + 8.0, 22.0, 14.0, 600, kit.tokc(c, style.TOK_TEXT), ch.name, tw - 30.0)
        kit.draw_label(c, x + 64.0, ry + 30.0, 20.0, 12.0, 400, kit.tokc(c, style.TOK_TEXT_MUTED), ch.preview, tw - 30.0)
        if ch.badge > 0 { badge_pill(p, x + rc.w as f64 - 14.0, ry + 20.0, ch.badge) }
        i = i + 1
    }
}

fn bubble(p: *mut Page, x: f64, y: f64, w: f64, mine: bool, text: str) {
    let c: *mut render.Ctx = &(*p).c
    let z: *mut painter.Painter = &(*p).z
    var bg: u32 = kit.tokc(c, style.TOK_SURFACE_RAISED)
    var fg: u32 = kit.tokc(c, style.TOK_TEXT)
    if mine {
        bg = kit.tokc(c, style.TOK_ACCENT)
        fg = kit.tokc(c, style.TOK_TEXT_ON_ACCENT)
    }
    painter.round_rect(z, x, y, w, 40.0, 14.0, bg)
    kit.draw_label(c, x + 14.0, y, 40.0, 14.0, 400, fg, text, w - 28.0)
}

#[allow_escape]
fn draw_content(p: *mut Page, rc: nav_layout.NavRect, back: bool, url: str) {
    let c: *mut render.Ctx = &(*p).c
    let z: *mut painter.Painter = &(*p).z
    let x: f64 = rc.x as f64
    let y: f64 = rc.y as f64
    let w: f64 = rc.w as f64
    painter.surface(z, x, y, w, rc.h as f64, kit.tokc(c, style.TOK_BASE))
    painter.surface(z, x, y + 55.0, w, 1.0, kit.tokc(c, style.TOK_SEPARATOR))
    var tx: f64 = x + 16.0
    if back {
        kit.sym(c, lucide.CHEVRON_LEFT, x + 12.0, y + 16.0, 24.0, kit.tokc(c, style.TOK_TEXT))
        tx = x + 44.0
    }
    kit.draw_label(c, tx, y + 8.0, 22.0, 16.0, 700, kit.tokc(c, style.TOK_TEXT), "Anna Berger", w - 120.0)
    kit.draw_label(c, tx, y + 29.0, 18.0, 11.0, 400, kit.tokc(c, style.TOK_TEXT_MUTED), url, w - 120.0)
    kit.sym(c, lucide.PHONE, x + w - 44.0, y + 16.0, 24.0, kit.tokc(c, style.TOK_TEXT_MUTED))
    let bw: f64 = w * 0.6
    bubble(p, x + 16.0, y + 76.0, bw, false, "Are we still on for today?")
    bubble(p, x + w - bw - 16.0, y + 128.0, bw, true, "Yes, 15:00 in the call")
    bubble(p, x + 16.0, y + 180.0, bw, false, "Perfect, I send the invite")
    bubble(p, x + w - bw - 16.0, y + 232.0, bw, true, "Thanks")
    let fy: f64 = (rc.y + rc.h) as f64 - 60.0
    painter.round_rect(z, x + 12.0, fy, w - 24.0, 44.0, 22.0, kit.tokc(c, style.TOK_FIELD))
    kit.draw_label(c, x + 30.0, fy, 44.0, 14.0, 400, kit.tokc(c, style.TOK_TEXT_MUTED), "Message", w - 100.0)
    kit.sym(c, lucide.SEND, x + w - 46.0, fy + 11.0, 22.0, kit.tokc(c, style.TOK_ACCENT))
}

fn draw_detail(p: *mut Page, rc: nav_layout.NavRect, overlay: bool) {
    let c: *mut render.Ctx = &(*p).c
    let z: *mut painter.Painter = &(*p).z
    let x: f64 = rc.x as f64
    var bg: u32 = kit.tokc(c, style.TOK_SURFACE)
    if overlay { bg = kit.tokc(c, style.TOK_SURFACE_RAISED) }
    painter.surface(z, x, rc.y as f64, rc.w as f64, rc.h as f64, bg)
    painter.surface(z, x, rc.y as f64, 1.0, rc.h as f64, kit.tokc(c, style.TOK_SEPARATOR))
    kit.draw_label(c, x + 16.0, rc.y as f64 + 8.0, 40.0, 14.0, 700, kit.tokc(c, style.TOK_TEXT), "Members", rc.w as f64 - 32.0)
    var i: usize = 0
    while i < 4 {
        let ch: Chat = chat_at(i)
        let ry: f64 = rc.y as f64 + 56.0 + (i as f64) * 48.0
        kit.avatar_draw(c, x + 16.0, ry, 32.0, i as u32, ch.name, 0.0 as i64 - 1)
        kit.draw_label(c, x + 60.0, ry, 32.0, 13.0, 400, kit.tokc(c, style.TOK_TEXT), ch.name, rc.w as f64 - 76.0)
        i = i + 1
    }
}

fn draw_tabbar(p: *mut Page, r: *mut nav_rail.Rail, rc: nav_layout.NavRect) {
    let c: *mut render.Ctx = &(*p).c
    let z: *mut painter.Painter = &(*p).z
    painter.surface(z, rc.x as f64, rc.y as f64, rc.w as f64, rc.h as f64, kit.tokc(c, style.TOK_SURFACE))
    painter.surface(z, rc.x as f64, rc.y as f64, rc.w as f64, 1.0, kit.tokc(c, style.TOK_SEPARATOR))
    var idx: [usize; 5] = [0; 5]
    let n: usize = nav_rail.nrail_tabs(r, 5, (&idx[0]) as *mut usize)
    let slots: usize = n + 1
    let sw: f64 = rc.w as f64 / (slots as f64)
    var i: usize = 0
    while i < slots {
        let sx: f64 = rc.x as f64 + (i as f64) * sw
        var col: u32 = kit.tokc(c, style.TOK_TEXT_MUTED)
        var icon: i64 = lucide.ELLIPSIS_VERTICAL
        var label: str = "More"
        var badge: usize = 0
        if i < n {
            let k: usize = idx[i]
            icon = (*r).it[k].icon
            label = (*r).it[k].label
            badge = (*r).it[k].badge as usize
            if k == nav_rail.nrail_active(r) { col = kit.tokc(c, style.TOK_ACCENT) }
            if (*r).it[k].state == nav_rail.NR_GREY { col = kit.tokc(c, style.TOK_TEXT_DISABLED) }
        }
        kit.sym(c, icon, sx + sw / 2.0 - 11.0, rc.y as f64 + 8.0, 22.0, col)
        kit.draw_label(c, sx, rc.y as f64 + 32.0, 18.0, 11.0, 500, col, label, sw)
        if badge > 0 { badge_pill(p, sx + sw / 2.0 + 30.0, rc.y as f64 + 4.0, badge) }
        i = i + 1
    }
}

#[allow_escape]
fn draw_palette(p: *mut Page, pal: *mut nav_palette.NavPal, w: f64, h: f64) {
    let c: *mut render.Ctx = &(*p).c
    let z: *mut painter.Painter = &(*p).z
    painter.surface(z, 0.0, 0.0, w, h, kit.with_alpha(kit.tokc(c, style.TOK_BASE), 160 as u32))
    let pw: f64 = 520.0
    let px0: f64 = (w - pw) / 2.0
    let py0: f64 = 90.0
    let rows: usize = nav_palette.npal_count(pal)
    painter.round_rect(z, px0, py0, pw, 64.0 + (rows as f64) * 44.0, 12.0, kit.tokc(c, style.TOK_SURFACE_RAISED))
    painter.round_rect(z, px0 + 12.0, py0 + 12.0, pw - 24.0, 40.0, 8.0, kit.tokc(c, style.TOK_FIELD))
    kit.sym(c, lucide.SEARCH, px0 + 22.0, py0 + 21.0, 22.0, kit.tokc(c, style.TOK_TEXT_MUTED))
    kit.draw_label(c, px0 + 54.0, py0 + 12.0, 40.0, 15.0, 400, kit.tokc(c, style.TOK_TEXT), nav_palette.npal_query(pal), pw - 80.0)
    var i: usize = 0
    while i < rows {
        let ry: f64 = py0 + 64.0 + (i as f64) * 44.0
        if i == nav_palette.npal_selected(pal) {
            painter.round_rect(z, px0 + 8.0, ry, pw - 16.0, 40.0, 8.0, kit.tokc(c, style.TOK_SELECTION))
        }
        var col: u32 = kit.tokc(c, style.TOK_TEXT)
        if !nav_palette.npal_enabled(pal, i) { col = kit.tokc(c, style.TOK_TEXT_DISABLED) }
        kit.draw_label(c, px0 + 22.0, ry, 40.0, 14.0, 500, col, nav_palette.npal_title(pal, i), pw * 0.6)
        var sc: [u8; 24] = [0 as u8; 24]
        let sn: usize = nav_palette.npal_shortcut_text(pal, i, (&sc[0]) as *mut u8, 24)
        if sn > 0 {
            kit.draw_label(c, px0 + pw - 140.0, ry, 40.0, 12.0, 400, kit.tokc(c, style.TOK_TEXT_MUTED), str { p: (&sc[0]) as *mut u8, n: sn }, 120.0)
        }
        i = i + 1
    }
}

fn open_chat(rs: *mut nav_route.Routes, nav: *mut nav_route.Nav) {
    nav_route.nnav_push(nav, rs, "fleitec://inbox")
    nav_route.nnav_push(nav, rs, "fleitec://chat/anna")
}

#[allow_escape]
fn run_pic(dir: u64, font: u64, name: str, w: usize, h: usize, dark: bool, page: u32, detail: bool, with_palette: bool) -> *mut Page {
    let p: *mut Page = page_new(w, h, dark, font)
    var rs: nav_route.Routes = nav_route.nroute_new()
    nav_route.nroute_add(&rs, "chat", "fleitec", "chat/:id")
    nav_route.nroute_add(&rs, "inbox", "fleitec", "inbox")
    nav_route.nroute_add(&rs, "mail", "app", "mail/:acct/:uid")
    var nav: nav_route.Nav = nav_route.nnav_new()
    open_chat(&rs, &nav)
    var rail: nav_rail.Rail = rail_build()
    var lp: nav_layout.LayoutParams = nav_layout.nlay_params()
    lp.detail_open = detail
    lp.page = page
    let l: nav_layout.Layout = nav_layout.nlay_compute(w as i32, h as i32, &lp)
    painter.surface(&(*p).z, 0.0, 0.0, w as f64, h as f64, tok(p, style.TOK_BASE))
    var s: kit.Search = kit.search_new()
    if l.rail.w > 0 { draw_rail(p, &rail, l.rail) }
    if l.list.w > 0 { draw_list(p, l.list, 0, &s) }
    if l.content.w > 0 { draw_content(p, l.content, l.mode == nav_layout.NL_STACK, nav_route.nnav_top(&nav)) }
    if l.detail.w > 0 { draw_detail(p, l.detail, l.detail_overlay) }
    if l.tabbar.h > 0 { draw_tabbar(p, &rail, l.tabbar) }
    if with_palette {
        var reg: action.Actions = action.actions_new()
        action.act_add(&reg, "new_mail", "New mail", noop, 0)
        action.act_add(&reg, "new_chat", "New chat", noop, 0)
        action.act_add(&reg, "plan_meeting", "Plan meeting", noop, 0)
        action.act_set_shortcut(&reg, 0, 78 as u32, action.MOD_CTRL | action.MOD_SHIFT)
        var cx: action.ActCtx = action.actx_new(0)
        var pal: nav_palette.NavPal = nav_palette.npal_new()
        nav_palette.npal_add_actions(&pal, &reg, &cx)
        nav_palette.npal_add_route(&pal, "Go to Inbox", "", "fleitec://inbox")
        nav_palette.npal_add_route(&pal, "Open chat Anna", "", "fleitec://chat/anna")
        nav_palette.npal_key(&pal, 75 as u32, action.MOD_CTRL)
        nav_palette.npal_type(&pal, 110 as u8)
        nav_palette.npal_type(&pal, 101 as u8)
        draw_palette(p, &pal, w as f64, h as f64)
    }
    kit.search_free(&s)
    save(&(*p).cv, dir, name)
    return p
}

fn noop(ud: u64, cx: *mut action.ActCtx) {
}

#[allow_escape]
fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("navmock: no font (DejaVu Sans)\n")
        return 9
    }
    let f: u64 = fs as u64
    let wd: *mut Page = run_pic(dir, f, "navmock-wide-dark.png", 1280, 640, true, nav_layout.NL_PAGE_LIST, true, false)
    let wl: *mut Page = run_pic(dir, f, "navmock-wide-light.png", 1280, 640, false, nav_layout.NL_PAGE_LIST, true, false)
    let md: *mut Page = run_pic(dir, f, "navmock-mid-dark.png", 900, 600, true, nav_layout.NL_PAGE_LIST, false, false)
    let nd: *mut Page = run_pic(dir, f, "navmock-narrow-list-dark.png", 390, 720, true, nav_layout.NL_PAGE_LIST, false, false)
    let nl: *mut Page = run_pic(dir, f, "navmock-narrow-list-light.png", 390, 720, false, nav_layout.NL_PAGE_LIST, false, false)
    let nc: *mut Page = run_pic(dir, f, "navmock-narrow-chat-dark.png", 390, 720, true, nav_layout.NL_PAGE_CONTENT, false, false)
    let pd: *mut Page = run_pic(dir, f, "navmock-palette-dark.png", 1280, 640, true, nav_layout.NL_PAGE_LIST, true, true)

    check(px(wd, 10, 300) == tok(wd, style.TOK_SURFACE), "wide dark: the rail has the surface ground")
    check(px(wd, 700, 600) == tok(wd, style.TOK_BASE) || px(wd, 700, 560) == tok(wd, style.TOK_BASE), "wide dark: the content has the base ground")
    check(px(wd, 1200, 400) == tok(wd, style.TOK_SURFACE), "wide dark: the detail column has the surface ground")
    check(px(wl, 10, 300) == tok(wl, style.TOK_SURFACE) && tok(wl, style.TOK_SURFACE) != tok(wd, style.TOK_SURFACE), "light and dark differ by tokens")
    check(px(md, 10, 300) == tok(md, style.TOK_SURFACE) && px(md, 800, 590) == tok(md, style.TOK_BASE), "mid: rail + list + content, no detail column")
    check(px(nd, 5, 300) == tok(nd, style.TOK_SURFACE) && px(nd, 195, 700) == tok(nd, style.TOK_SURFACE), "narrow list: full width list and a tab bar")
    check(px(nc, 5, 300) == tok(nc, style.TOK_BASE) && px(nc, 195, 716) == tok(nc, style.TOK_BASE), "narrow chat: content takes the full window, no tab bar")
    check(px(pd, 5, 5) != tok(pd, style.TOK_BASE), "palette: the scrim dims the window")
    check(px(nl, 5, 300) == tok(nl, style.TOK_SURFACE), "narrow light: tokens as well")

    if BAD == 0 {
        say("NAVMOCK PASSED\n")
        return 0
    }
    say("NAVMOCK FAILED\n")
    return 1
}
