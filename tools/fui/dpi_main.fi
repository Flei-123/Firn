// SPDX-License-Identifier: MPL-2.0
// tools/fui/dpi_main.fi -- W5: DPI SCALING AND PIXEL SHARPNESS (headless).
//
//   1. theme_px against a table calculated by hand: 100 / 125 / 150 / 175 / 200 % and
//      fractional steps (112.5, 137.5, 225 %)
//   2. a text field painted at every scale: its box has the scaled size; the left and
//      right edge are crisp (one colour, same on every row = no blur) and the
//      border is theme_px(1) pixels wide
//
//     firnc -o /tmp/dpi tools/fui/dpi_main.fi && /tmp/dpi
import std.rt
import paint.canvas
import font.metrics
import fui.theme
import fui.widget
import fui.painter
import fui.render

static mut BAD: usize = 0
static mut OKS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_num(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
        OKS = OKS + 1
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

// hand-made table: the device length of the design lengths 1, 2, 4, 8, 16, 32 at scale `s`
fn expect_px(m: *mut theme.Theme, s: usize, a: usize, b: usize, c: usize, d: usize, e: usize, f: usize, what: str) {
    theme.theme_set_scale(m, s)
    check(theme.theme_px(m, 1) == a && theme.theme_px(m, 2) == b && theme.theme_px(m, 4) == c
        && theme.theme_px(m, 8) == d && theme.theme_px(m, 16) == e && theme.theme_px(m, 32) == f, what)
}

// run of pixels from x0 on (row y) that have colour `col`
fn run_len(cv: *mut canvas.Canvas, x0: usize, y: usize, col: u32, maxn: usize) -> usize {
    var n: usize = 0
    while n < maxn && canvas.canvas_get(cv, x0 + n, y) == col {
        n = n + 1
    }
    return n
}

fn measure(scale: usize, fm: u64, what: str) {
    var cv: canvas.Canvas = canvas.canvas_new()
    canvas.canvas_init(&cv, 400, 200)
    var z: painter.Painter = painter.painter_new()
    painter.painter_init(&z, &cv, 400, 200)
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(false)
    theme.theme_set_scale(&m, scale)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let bg: u32 = canvas.canvas_get(&cv, 0, 0)
    var e: widget.Widget = widget.widget_new(widget.KIND_TEXTBOX)
    let bw: usize = theme.theme_px(&m, 100)
    let bh: usize = theme.theme_px(&m, 32)
    widget.w_place(&e, 20.0, 20.0, bw as f64, bh as f64)
    painter.painter_clear(&z, bg)
    render.draw_widget(&c, &e)
    // the bounding box of everything that is not the ground
    var x0: usize = 400
    var x1: usize = 0
    var y0: usize = 200
    var y1: usize = 0
    var y: usize = 0
    while y < 200 {
        var x: usize = 0
        while x < 400 {
            if canvas.canvas_get(&cv, x, y) != canvas.canvas_get(&cv, 399, 199) {
                if x < x0 { x0 = x }
                if x > x1 { x1 = x }
                if y < y0 { y0 = y }
                if y > y1 { y1 = y }
            }
            x = x + 1
        }
        y = y + 1
    }
    say("  scale ")
    say_num(scale as i64)
    say(": box ")
    say_num(x0 as i64)
    say(",")
    say_num(y0 as i64)
    say(" .. ")
    say_num(x1 as i64)
    say(",")
    say_num(y1 as i64)
    say(" want ")
    say_num(20)
    say(" w ")
    say_num(bw as i64)
    say(" h ")
    say_num(bh as i64)
    say("\n")
    check(x0 == 20 && y0 == 20 && x1 == 20 + bw - 1 && y1 == 20 + bh - 1, "the box has exactly the scaled size, on whole pixels")
    // crisp edges: in the middle band the left edge column is ONE colour on every row
    // (a blurred or fractional edge would vary or be a mix), and just outside it is the ground
    let top: usize = y0 + bh / 3
    let bot: usize = y1 - bh / 3
    let edge: u32 = canvas.canvas_get(&cv, x0, (top + bot) / 2)
    var same: bool = true
    var same_r: bool = true
    var yy: usize = top
    while yy <= bot {
        if canvas.canvas_get(&cv, x0, yy) != edge { same = false }
        if canvas.canvas_get(&cv, x1, yy) != canvas.canvas_get(&cv, x1, (top + bot) / 2) { same_r = false }
        yy = yy + 1
    }
    check(same && same_r, "left and right edge: one colour on every row (crisp)")
    check(canvas.canvas_get(&cv, x0 - 1, (top + bot) / 2) == bg && canvas.canvas_get(&cv, x1 + 1, (top + bot) / 2) == bg, "no halo outside the box")
    // the border: a run of the edge colour, theme_px(1) wide
    let bwid: usize = run_len(&cv, x0, (top + bot) / 2, edge, 8)
    say("    border width measured ")
    say_num(bwid as i64)
    say(" want ")
    say_num(theme.theme_px(&m, 1) as i64)
    say("\n")
    check(bwid == theme.theme_px(&m, 1), "the border is theme_px(1) pixels wide")
    canvas.canvas_free(&cv)
    painter.painter_free(&z)
}

fn main(start: u64) -> i32 {
    var m: theme.Theme = theme.theme_new(false)
    say("-- theme_px against the hand table\n")
    expect_px(&m, 1000, 1, 2, 4, 8, 16, 32, "100 %")
    expect_px(&m, 1250, 1, 3, 5, 10, 20, 40, "125 %")
    expect_px(&m, 1500, 2, 3, 6, 12, 24, 48, "150 %")
    expect_px(&m, 1750, 2, 4, 7, 14, 28, 56, "175 %")
    expect_px(&m, 2000, 2, 4, 8, 16, 32, 64, "200 %")
    expect_px(&m, 1125, 1, 2, 5, 9, 18, 36, "112.5 %")
    expect_px(&m, 1375, 1, 3, 6, 11, 22, 44, "137.5 %")
    expect_px(&m, 2250, 2, 5, 9, 18, 36, 72, "225 %")
    theme.theme_set_scale(&m, 100)
    check(theme.theme_scale(&m) == 500, "scale below 50 % is clamped to 50 %")
    theme.theme_set_scale(&m, 9000)
    check(theme.theme_scale(&m) == 4000, "scale above 400 % is clamped to 400 %")
    theme.theme_set_scale(&m, 500)
    check(theme.theme_px(&m, 1) == 1, "a 1-point line never vanishes (50 %)")

    var fbuf: rt.Buf = rt.buf_new()
    var fpath: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
    let has_font: bool = rt.read_file((&fpath[0]) as u64, &fbuf)
    let fsp: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if has_font {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    say("-- a painted text field at every scale\n")
    measure(1000, fm, "100")
    measure(1250, fm, "125")
    measure(1500, fm, "150")
    measure(2000, fm, "200")
    measure(1375, fm, "137.5")
    say("checks ok: ")
    say_num(OKS as i64)
    say("\n")
    if BAD > 0 {
        say("DPI FAILED\n")
        return 1
    }
    say("DPI PASSED\n")
    return 0
}
