static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

fn has_text(buf: *mut u8, n: usize, t: str) -> bool {
    if t.n == 0 || n < t.n {
        return false
    }
    var i: usize = 0
    while i + t.n <= n {
        var j: usize = 0
        while j < t.n && *(buf + i + j) == *((t.p as u64 + j as u64) as *mut u8) {
            j = j + 1
        }
        if j == t.n {
            return true
        }
        i = i + 1
    }
    return false
}

fn dump_has(a: *mut app.App, t: str) -> bool {
    let cap: usize = 16384
    let buf: *mut u8 = rt.heap_alloc(cap) as *mut u8
    let n: usize = a11y.a11y_dump(app.app_scene(a), app.ax(a), buf as u64, cap)
    var m: usize = n
    if m > cap {
        m = cap
    }
    return has_text(buf, m, t)
}

fn click(w: *mut fuiwirt.Host, x: f64, y: f64) {
    let m: u32 = fuiwirt.host_pointer_move(w, x, y)
    let d: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let u: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
}

fn streq(a: str, b: str) -> bool {
    if a.n != b.n { return false }
    var i: usize = 0
    while i < a.n {
        if *((a.p as u64 + i as u64) as *mut u8) != *((b.p as u64 + i as u64) as *mut u8) { return false }
        i = i + 1
    }
    return true
}

fn type_text(a: *mut app.App, s: str) {
    var i: usize = 0
    while i < s.n {
        let ch: u8 = *((s.p as u64 + i as u64) as *mut u8)
        let r: bool = app.app_char(a as u64, ch as u32, 0 as u32)
        i = i + 1
    }
}

fn key(a: *mut app.App, k: u32) -> bool {
    return app.app_key(a as u64, k, 0 as u32)
}

static mut DROPS: usize = 0
static mut ACTS: usize = 0
fn activated(a: *mut app.App, id: usize, row: usize) {
    ACTS = ACTS + 1
}
static mut STARTS: usize = 0
static mut LAST_TGT: usize = 0
fn dropped(a: *mut app.App, target: usize) {
    DROPS = DROPS + 1
    LAST_TGT = target
}

fn started(a: *mut app.App, node: usize) {
    STARTS = STARTS + 1
}

fn row_of(ud: u64, i: usize, out: *mut vlist.VRow) {
    vlist.vrow_text(out, "Row ")
    vlist.vrow_text(out, "Item")
}

fn noop(a: *mut app.App) {
}

// the centre of row r of list node n (window pixels)
fn row_y(a: *mut app.App, n: usize, r: usize) -> f64 {
    let v: *mut vlist.Vlist = app.vlist_model(a, n)
    return vlist.vl_body_y(v) - vlist.vl_scroll_y(v) + vlist.vl_row_top(v, r) + vlist.vl_height_of(v, r) / 2.0
}

fn col_x(a: *mut app.App, n: usize) -> f64 {
    let sc: *mut scene.Scene = app.app_scene(a)
    return scene.node_x(sc, n) + scene.node_w(sc, n) / 3.0
}

// every gesture gets its own host turn (the host swallows more than 6 moves per turn)
fn next_turn(w: *mut fuiwirt.Host) {
    fuiwirt.host_tick(w, fuiwirt.host_now(w) + 16)
}

fn drag_to(a: *mut app.App, w: *mut fuiwirt.Host, x0: f64, y0: f64, x1: f64, y1: f64) {
    next_turn(w)
    let m0: u32 = fuiwirt.host_pointer_move(w, x0, y0)
    let d0: u32 = fuiwirt.host_pointer_down(w, x0, y0, fuiwirt.BTN_LEFT)
    let m1: u32 = fuiwirt.host_pointer_move(w, x0 + 2.0, y0 + 1.0)
    let m2: u32 = fuiwirt.host_pointer_move(w, (x0 + x1) / 2.0, (y0 + y1) / 2.0)
    let m3: u32 = fuiwirt.host_pointer_move(w, x1, y1)
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

#[allow_escape]
fn desc_has(a: *mut app.App, node: usize, what: str) -> bool {
    var db: [u8; 192] = [0 as u8; 192]
    let n: usize = a11y.a11y_description(app.app_scene(a), app.ax(a), node, (&db[0]) as u64, 192)
    if what.n > n {
        return false
    }
    var i: usize = 0
    while i + what.n <= n {
        var j: usize = 0
        while j < what.n && db[i + j] == *((what.p as u64 + j as u64) as *mut u8) {
            j = j + 1
        }
        if j == what.n {
            return true
        }
        i = i + 1
    }
    return false
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appw10: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Wave10", 700, 600)
    let la: usize = app.vlist_new(a, "List A", 640, 150, 10, row_of, 0)
    let lb: usize = app.vlist_new(a, "List B", 640, 150, 40, row_of, 0)
    let lc: usize = app.vlist_new(a, "Tree C", 640, 150, 12, row_of, 0)
    let tr: usize = app.button(a, "Trash", noop)
    check(la != app.NONE && lb != app.NONE && tr != app.NONE, "two lists and a button")
    check(appctl.dnd_source(a, la, dnd.KIND_ROW, dnd.OP_MOVE | dnd.OP_COPY), "list A is a source")
    check(appctl.dnd_target(a, la, dnd.KIND_ROW, dnd.OP_MOVE | dnd.OP_COPY, false), "list A is a target")
    check(appctl.dnd_target(a, lb, dnd.KIND_ROW, dnd.OP_MOVE | dnd.OP_COPY, false), "list B is a target")
    check(appctl.dnd_target(a, tr, dnd.KIND_ROW, dnd.OP_MOVE, false), "the button is a target")
    check(lc != app.NONE && appctl.dnd_target(a, lc, dnd.KIND_ROW, dnd.OP_MOVE, true), "list C is a tree target")
    appctl.dnd_on_drop(a, dropped)
    app.vlist_on_activate(a, la, activated)
    appctl.dnd_on_start(a, started)
    appctl.dnd_ghost(a, "Row")
    let s: *mut Surface = surface_for(a, 700, 600)
    settle(a, s)
    let w: *mut fuiwirt.Host = app.app_host(a)
    let sc: *mut scene.Scene = app.app_scene(a)
    check(!appctl.dnd_busy(a) && appctl.dnd_drops(a) == 0, "idle at the start")
    // ---- what a screen reader hears of sources and targets
    check(desc_has(a, la, "Draggable: rows (move, copy)") && desc_has(a, la, "Ctrl+Space grabs"), "a source says it is draggable, with kinds and operations")
    check(desc_has(a, la, "Drop target: rows (move, copy)."), "a node that is both says both")
    check(desc_has(a, lb, "Drop target: rows (move, copy).") && !desc_has(a, lb, "Draggable"), "a target that is no source is no 'Draggable'")
    check(desc_has(a, lc, "onto rows too") && desc_has(a, tr, "Drop target: rows (move)."), "a tree target says rows can take drops, the button lists its operation")
    // ---- a press and release without moving far: no drag
    let ax: f64 = col_x(a, la)
    let ay2: f64 = row_y(a, la, 2)
    let q0: u32 = fuiwirt.host_pointer_move(w, ax, ay2)
    let q1: u32 = fuiwirt.host_pointer_down(w, ax, ay2, fuiwirt.BTN_LEFT)
    let q2: u32 = fuiwirt.host_pointer_move(w, ax + 2.0, ay2)
    check(!appctl.dnd_busy(a), "2 px: the drag has not started")
    let q3: u32 = fuiwirt.host_pointer_up(w, ax + 2.0, ay2, fuiwirt.BTN_LEFT)
    check(DROPS == 0 && STARTS == 0 && !appctl.dnd_busy(a), "a click is not a drag")
    // ---- drag row 2 of A onto list B (between its rows 0 and 1)
    let bx: f64 = col_x(a, lb)
    let by0: f64 = row_y(a, lb, 0)
    let byb: f64 = by0 + 12.0
    drag_to(a, w, ax, ay2, bx, byb)
    check(appctl.dnd_busy(a) && STARTS == 1, "past the threshold the drag runs and calls on_start")
    frame(a, s)
    let u0: u32 = fuiwirt.host_pointer_up(w, bx, byb, fuiwirt.BTN_LEFT)
    check(DROPS == 1 && !appctl.dnd_busy(a), "the release drops")
    check(LAST_TGT == lb && appctl.dnd_to(a) == lb && appctl.dnd_from(a) == la && appctl.dnd_from_row(a) == 2, "from A row 2 to B")
    check(appctl.dnd_effect(a) == dnd.OP_MOVE, "the effect is move")
    check(appctl.dnd_gap(a) == 1 || appctl.dnd_gap(a) == 0, "the gap is next to B row 0")
    check(wave10.move_index(5, 2) == 2 && wave10.move_index(2, 5) == 4, "move_index maps gap to final index")
    // ---- copy with Ctrl
    fuiwirt.host_set_mods(w, editor.MOD_CTRL)
    drag_to(a, w, ax, ay2, bx, byb)
    frame(a, s)
    let u1: u32 = fuiwirt.host_pointer_up(w, bx, byb, fuiwirt.BTN_LEFT)
    check(DROPS == 2 && appctl.dnd_effect(a) == dnd.OP_COPY, "Ctrl drops as a copy")
    fuiwirt.host_set_mods(w, 0 as u32)
    // ---- onto the button (a plain node target)
    var tx: f64 = scene.node_x(sc, tr) + scene.node_w(sc, tr) / 2.0
    var ty: f64 = scene.node_y(sc, tr) + scene.node_h(sc, tr) / 2.0
    drag_to(a, w, ax, ay2, tx, ty)
    let u2: u32 = fuiwirt.host_pointer_up(w, tx, ty, fuiwirt.BTN_LEFT)
    check(DROPS == 3 && appctl.dnd_to(a) == tr && appctl.dnd_zone(a) == dnd.SLOT_ON, "drop on the button node")
    // ---- released over nothing: no drop
    drag_to(a, w, ax, ay2, 690.0, 595.0)
    let u3: u32 = fuiwirt.host_pointer_up(w, 690.0, 595.0, fuiwirt.BTN_LEFT)
    check(DROPS == 3 && !appctl.dnd_busy(a), "released over no target: no drop")
    // ---- the drag does not disturb the row selection: the pressed row is the selected one, no double click
    ACTS = 0
    app.vlist_select(a, la, 5)
    drag_to(a, w, ax, ay2, bx, byb)
    check(appctl.dnd_busy(a) && app.vlist_selected(a, la) == 2, "the press chose the dragged row (as a click)")
    let u6: u32 = fuiwirt.host_pointer_up(w, bx, byb, fuiwirt.BTN_LEFT)
    check(app.vlist_selected(a, la) == 2, "the release leaves the selection of A")
    let q4: u32 = fuiwirt.host_pointer_down(w, ax, ay2, fuiwirt.BTN_LEFT)
    let q5: u32 = fuiwirt.host_pointer_up(w, ax, ay2, fuiwirt.BTN_LEFT)
    check(ACTS == 0, "press, drag, click on the same row: no double click activation")
    DROPS = DROPS - 1
    // ---- Esc cancels
    drag_to(a, w, ax, ay2, bx, byb)
    check(appctl.dnd_busy(a), "running again")
    let ke: bool = app.app_key(a as u64, editor.KEY_ESC, 0 as u32)
    check(ke && !appctl.dnd_busy(a), "Esc cancels the drag")
    let u4: u32 = fuiwirt.host_pointer_up(w, bx, byb, fuiwirt.BTN_LEFT)
    check(DROPS == 3, "the release after Esc drops nothing")
    // ---- edge scroll of the long list B
    let vb: *mut vlist.Vlist = app.vlist_model(a, lb)
    let top0: f64 = vlist.vl_scroll_y(vb)
    let ey: f64 = vlist.vl_body_y(vb) + vlist.vl_body_h(vb) - 3.0
    drag_to(a, w, ax, ay2, bx, ey)
    var t: i64 = fuiwirt.host_now(w)
    var g: usize = 0
    while g < 10 {
        t = t + 16
        fuiwirt.host_tick(w, t)
        g = g + 1
    }
    check(vlist.vl_scroll_y(vb) > top0 + 10.0, "the pointer at the lower edge scrolls the target list")
    let u5: u32 = fuiwirt.host_pointer_up(w, bx, ey, fuiwirt.BTN_LEFT)
    check(DROPS == 4, "dropped into the scrolled list")
    // ---- a tree target: the middle of a row is ON the row, its edge is a gap
    let cx: f64 = col_x(a, lc)
    let cy3: f64 = row_y(a, lc, 3)
    drag_to(a, w, ax, ay2, cx, cy3)
    let uc0: u32 = fuiwirt.host_pointer_up(w, cx, cy3, fuiwirt.BTN_LEFT)
    check(LAST_TGT == lc && appctl.dnd_zone(a) == dnd.SLOT_ON && appctl.dnd_to_row(a) == 3, "tree target: the middle of row 3 is ON row 3")
    let vc: *mut vlist.Vlist = app.vlist_model(a, lc)
    let cy4: f64 = row_y(a, lc, 4) - vlist.vl_height_of(vc, 4) / 2.0 + 2.0
    drag_to(a, w, ax, ay2, cx, cy4)
    let uc1: u32 = fuiwirt.host_pointer_up(w, cx, cy4, fuiwirt.BTN_LEFT)
    check(appctl.dnd_zone(a) != dnd.SLOT_ON && appctl.dnd_gap(a) >= 3 && appctl.dnd_gap(a) <= 4, "tree target: the edge of row 4 is a gap next to it")
    // a copy asked of a move-only tree target gives nothing
    fuiwirt.host_set_mods(w, editor.MOD_CTRL)
    let dtree: usize = DROPS
    drag_to(a, w, ax, ay2, cx, cy3)
    let uc2: u32 = fuiwirt.host_pointer_up(w, cx, cy3, fuiwirt.BTN_LEFT)
    check(DROPS == dtree, "Ctrl (copy) on a move-only tree target: no drop")
    fuiwirt.host_set_mods(w, 0 as u32)
    // ---- the picture in the middle of a drag: drop marker in list B and the ghost at the pointer
    let ghy: f64 = byb + 2.0
    drag_to(a, w, ax, ay2, bx, ghy)
    frame(a, s)
    frame(a, s)
    save(&(*s).cv, dir, "dnd-light.png")
    app.set_dark(a, true)
    frame(a, s)
    frame(a, s)
    save(&(*s).cv, dir, "dnd-dark.png")
    app.set_dark(a, false)
    let ud: u32 = fuiwirt.host_pointer_up(w, bx, ghy, fuiwirt.BTN_LEFT)
    frame(a, s)
    // ---- the keyboard way
    app.vlist_select(a, la, 3)
    app.set_focus(a, la)
    let before: usize = DROPS
    let kc: bool = app.app_char(a as u64, 32 as u32, editor.MOD_CTRL)
    check(kc && appctl.dnd_keyboard(a), "Ctrl+Space grabs the current row")
    check(STARTS >= 5, "on_start ran for the grab")
    let k1: bool = app.app_key(a as u64, editor.KEY_DOWN, 0 as u32)
    let k2: bool = app.app_key(a as u64, editor.KEY_DOWN, 0 as u32)
    frame(a, s)
    check(k1 && k2 && appctl.dnd_busy(a), "Down walks the gaps")
    var db: [u8; 96] = [0 as u8; 96]
    let dn: usize = a11y.a11y_description(sc, app.ax(a), la, (&db[0]) as u64, 96)
    check(dn > 10, "the grabbed node says where the drop would go")
    let k3: bool = app.app_key(a as u64, editor.KEY_ENTER, 0 as u32)
    check(k3 && DROPS == before + 1 && !appctl.dnd_busy(a), "Enter drops")
    check(desc_has(a, la, "Draggable: rows") && !desc_has(a, la, "Drop at position"), "after the drop the node has its hint again, not the grab text")
    check(appctl.dnd_from_row(a) == 3 && appctl.dnd_effect(a) != dnd.OP_NONE, "the dropped row is the grabbed one")
    // Esc on the keyboard way
    let kc2: bool = app.app_char(a as u64, 32 as u32, editor.MOD_CTRL)
    let k4: bool = app.app_key(a as u64, editor.KEY_ESC, 0 as u32)
    check(kc2 && k4 && !appctl.dnd_busy(a) && DROPS == before + 1, "Esc ends the keyboard drag without a drop")
    check(desc_has(a, la, "Draggable: rows"), "after Esc the node has its hint again")
    // a node that is no source cannot be grabbed
    app.set_focus(a, tr)
    let kc3: bool = app.app_char(a as u64, 32 as u32, editor.MOD_CTRL)
    check(!appctl.dnd_keyboard(a), "a node that is not a source is not grabbed")
    check(appctl.dnd_effect(a) != dnd.OP_NONE, "the last result stays readable")
    if BAD == 0 {
        say("APPW10 PASSED\n")
        return 0
    }
    say("APPW10 FAILED\n")
    return 1
}
