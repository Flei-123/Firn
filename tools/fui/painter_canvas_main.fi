import std.rt
import paint.canvas
import font.raster
import fui.painter

static mut BAD: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn main(start: u64) -> i32 {
    var a: canvas.Canvas = canvas.canvas_new()
    var b: canvas.Canvas = canvas.canvas_new()
    var z: painter.Painter = painter.painter_new()
    let ok: bool = canvas.canvas_init(&a, 64, 48) && canvas.canvas_init(&b, 64, 48)
        && painter.painter_init(&z, &a, 64, 48)
    check(ok, "canvases and painter init")
    canvas.canvas_clear(&a, 0xFF000000 as u32)
    canvas.canvas_clear(&b, 0xFF000000 as u32)
    check(painter.painter_canvas(&z) == &a, "painter starts on the first canvas")
    painter.surface(&z, 4.0, 4.0, 10.0, 10.0, 0xFFFF0000 as u32)
    painter.painter_set_canvas(&z, &b)
    check(painter.painter_canvas(&z) == &b, "set_canvas switches the target")
    painter.surface(&z, 20.0, 20.0, 10.0, 10.0, 0xFF00FF00 as u32)
    check(canvas.canvas_get(&a, 6, 6) == 0xFFFF0000 as u32, "first canvas got the red square")
    check(canvas.canvas_get(&a, 22, 22) == 0xFF000000 as u32, "first canvas untouched by the second paint")
    check(canvas.canvas_get(&b, 22, 22) == 0xFF00FF00 as u32, "second canvas got the green square")
    check(canvas.canvas_get(&b, 6, 6) == 0xFF000000 as u32, "second canvas untouched by the first paint")
    let ra: *mut raster.Raster = painter.painter_raster(&z)
    check(ra as usize != 0, "raster accessor is not null")
    check(painter.painter_raster(&z) == ra, "raster accessor is stable")
    painter.round_rect(&z, 30.0, 4.0, 20.0, 20.0, 6.0, 0xFF0000FF as u32)
    check(canvas.canvas_get(&b, 40, 14) == 0xFF0000FF as u32, "round_rect still paints via the shared raster")
    painter.painter_free(&z)
    if BAD != 0 {
        say("painter_canvas: FAIL\n")
        return 1
    }
    say("painter_canvas: all ok\n")
    return 0
}
