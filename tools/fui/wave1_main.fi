// tools/fui/welle1_main.fi -- DIE ABNAHME VON WELLE 1, AM BILDPUNKT.
//
// ====================================================== WARUM ES SIE GIBT
//
// JARVIS' Bedingung: "EINE PRUEFUNG JE ELEMENT, die den Bau scheitern
// laesst, wenn die Darstellung kaputtgeht. Dieselbe Zeichnung ist heute
// zweimal still verlorengegangen; das darf strukturell nicht mehr
// moeglich sein."
//
// Dieses Programm malt dieselben Elemente how die Schauseite und LIEST
// DIE BILDPUNKTE ZURUECK. Es hat beim ersten Lauf drei echte Fehler
// gefunden, die im Quelltext alle drei unsichtbar waren:
//
//   1. Alle fuenf Knopfzustaende waren GLEICH GRAU. `def_bg` gab die
//      Ruhefarbe fuer jeden Zustand zurueck, und `style.resolve_bg` faellt
//      genau darauf zurueck, wenn der Aufrufer nichts sagt -- also
//      immer. Uebersetzt sauber, gelaufen sauber, nur eben ohne
//      Zustaende.
//   2. Die Fensterknoepfe align dem Kern standen in FALSCHFARBEN
//      (0xFEFBFB statt 0xFBFBFE): der Kern schreibt BGRX (Vertrag F3
//      von lib/fenster/fenster.fi), die Leinwand haelt RGBA.
//   3. Die Tafel unter den Stilvarianten wurde gar nicht gemalt, weil
//      das Rasterfenster des Zeichners schmaler war als sie -- und
//      damit war der Beweis fuer "transparent" wertlos.
//
// Keiner der drei haette sich durch Lesen finden lassen.
import std.rt
import paint.canvas
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.core

const FONTSET_BYTES: usize = 4096
const W: usize = 600
const H: usize = 200

static mut G_FEHLER: usize = 0

fn sag(nm: u64, nn: usize, ok: bool, got: u32, want: u32) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 44 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "FALSCH  "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_FEHLER = G_FEHLER + 1
    }
    var h1: [u8; 5] = " ist "
    rt.buf_push_bytes(&t, (&h1[0]) as u64, 5)
    rt.buf_push_hex_u64(&t, got as u64, 6)
    var h2: [u8; 6] = " soll "
    rt.buf_push_bytes(&t, (&h2[0]) as u64, 6)
    rt.buf_push_hex_u64(&t, want as u64, 6)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// Einen Knopf in einem Zustand malen und die Flaeche zurueckgeben.
// Gemessen wird an einer TEXTFREIEN Stelle -- knapp unter der
// Oberkante, wo nie ein Buchstabe steht.
fn cap_surface(cv: *mut canvas.Canvas, c: *mut render.Ctx,
    m: *mut theme.Theme, bits: u32) -> u32 {
    let f: *mut theme.Colors = theme.theme_colors(m)
    canvas.canvas_clear(cv, theme.opaque((*f).base))
    var t: [u8; 4] = "Text"
    var e: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&e, 20.0, 20.0, 200.0, 40.0)
    widget.w_set_text(&e, (&t[0]) as u64, 4)
    widget.w_set_state_bits(&e, bits)
    render.draw_widget(c, &e)
    // MITTE DER LINKEN HAELFTE, nicht die Naehe der Kante: bei einem
    // Knopf von 40 Bildpunkten Hoehe liegt y = 26 nur sechs unter der
    // Oberkante, und dort verlaeuft der zwei Bildpunkte starke
    // Fokusring samt Kantenglaettung. Die erste Fassung dieser Pruefung
    // hat genau deshalb "Fokus faerbt die Flaeche" gemeldet -- ein
    // Fehler der MESSUNG und nicht der Zeichnung. Die Mitte ist von
    // jedem Rand weit genug weg und trifft trotzdem keinen Buchstaben
    // (der Text steht mittig ab x = 20 + 200/2 - Textbreite/2).
    return canvas.canvas_get(cv, 40, 40) & 16777215 as u32
}

fn main(start: u64) -> i32 {
    // ---- Schrift (fuer die Textpruefung; ohne sie geht der Rest auch)
    var fbuf: rt.Buf = rt.buf_new()
    var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
    let have: bool = rt.read_file((&f1[0]) as u64, &fbuf)
    let fsp: *mut metrics.FontSet =
        rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }

    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 2
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 120) {
        return 3
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(true)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)

    // ==================================================================
    // 1. DIE FUENF ZUSTAENDE SIND WIRKLICH FUENF
    // ==================================================================
    let z_norm: u32 = cap_surface(&cv, &c, &m, 0 as u32)
    let z_ueb: u32 = cap_surface(&cv, &c, &m, 1 as u32)
    let z_dru: u32 = cap_surface(&cv, &c, &m, 2 as u32)
    let z_fok: u32 = cap_surface(&cv, &c, &m, 4 as u32)
    let z_spe: u32 = cap_surface(&cv, &c, &m, 8 as u32)

    var n1: [u8; 30] = "1 normal ist die Knopffarbe   "
    sag((&n1[0]) as u64, 30, z_norm == (*f).button, z_norm, (*f).button)
    var n2: [u8; 30] = "1 ueber ist heller            "
    sag((&n2[0]) as u64, 30, z_ueb == (*f).button_hover, z_ueb,
        (*f).button_hover)
    var n3: [u8; 30] = "1 druck ist noch heller       "
    sag((&n3[0]) as u64, 30, z_dru == (*f).button_active, z_dru,
        (*f).button_active)
    // DER FEHLER, DEN DIESE PRUEFUNG GEFUNDEN HAT: vorher waren alle
    // drei gleich.
    var n4: [u8; 30] = "1 die drei sind verschieden   "
    sag((&n4[0]) as u64, 30,
        z_norm != z_ueb && z_ueb != z_dru && z_norm != z_dru,
        z_norm, z_ueb)
    // Fokus faerbt die FLAECHE nicht -- er ist ein Ring.
    var n5: [u8; 30] = "1 fokus laesst Flaeche in Ruhe"
    sag((&n5[0]) as u64, 30, z_fok == (*f).button, z_fok, (*f).button)
    var n6: [u8; 30] = "1 sperr laesst Flaeche in Ruhe"
    sag((&n6[0]) as u64, 30, z_spe == (*f).button, z_spe, (*f).button)

    // ==================================================================
    // 2. DER FOKUSRING IST DA, UND ZWAR IM AKZENT
    // ==================================================================
    canvas.canvas_clear(&cv, theme.opaque((*f).base))
    var tf: [u8; 4] = "Text"
    var ef: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&ef, 20.0, 20.0, 200.0, 40.0)
    widget.w_set_text(&ef, (&tf[0]) as u64, 4)
    widget.w_set_focus(&ef, true)
    render.draw_widget(&c, &ef)
    // Die linke Kante auf halber Hoehe: dort liegt der Ring.
    let round_ring: u32 = canvas.canvas_get(&cv, 20, 40) & 16777215 as u32
    var n7: [u8; 30] = "2 Fokusring im Akzent         "
    sag((&n7[0]) as u64, 30, round_ring == (*f).accent, round_ring, (*f).accent)
    // Zwei Bildpunkte stark (theme.Shape.focus_w = 2 bei Skala 1).
    let ring2: u32 = canvas.canvas_get(&cv, 21, 40) & 16777215 as u32
    let inner: u32 = canvas.canvas_get(&cv, 23, 40) & 16777215 as u32
    var n8: [u8; 30] = "2 Ring ist zwei Punkte stark  "
    sag((&n8[0]) as u64, 30, ring2 == (*f).accent && inner != (*f).accent,
        ring2, (*f).accent)

    // ==================================================================
    // 3. TRANSPARENT HEISST NICHT MALEN
    // ==================================================================
    // Auf einen Prueffleck, der KEINE Themenfarbe ist: waere
    // `transparent` in Wahrheit "male Fensterfarbe drueber", stuende
    // hier die Fensterfarbe.
    let probe: u32 = 16711935 as u32
    canvas.canvas_clear(&cv, theme.opaque(probe))
    var et: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&et, 20.0, 20.0, 200.0, 40.0)
    let st: *mut style.Style = widget.w_style(&et)
    *st = style.style_set_bg(*st, style.color_transparent())
    render.draw_widget(&c, &et)
    let durch: u32 = canvas.canvas_get(&cv, 40, 26) & 16777215 as u32
    var n9: [u8; 30] = "3 transparent malt nicht      "
    sag((&n9[0]) as u64, 30, durch == probe, durch, probe)

    // Und eine Beschriftung ist VON HAUS AUS transparent.
    canvas.canvas_clear(&cv, theme.opaque(probe))
    var eb: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&eb, 20.0, 20.0, 200.0, 40.0)
    render.draw_widget(&c, &eb)
    let durch2: u32 = canvas.canvas_get(&cv, 40, 26) & 16777215 as u32
    var n10: [u8; 30] = "3 Beschriftung ohne Flaeche   "
    sag((&n10[0]) as u64, 30, durch2 == probe, durch2, probe)

    // ==================================================================
    // 4. DAS THEMA ZIEHT MIT, DIE LITERALE NICHT
    // ==================================================================
    var mh: theme.Theme = theme.theme_new(false)
    var ch2: render.Ctx = render.ctx_new(&mh, &z)
    let fh: *mut theme.Colors = theme.theme_colors(&mh)
    let light_button: u32 = cap_surface(&cv, &ch2, &mh, 0 as u32)
    var n11: [u8; 30] = "4 hell und dunkel verschieden "
    sag((&n11[0]) as u64, 30, light_button != z_norm, light_button, z_norm)

    // Ein LITERAL bleibt, was es ist -- in beiden Themen.
    canvas.canvas_clear(&cv, theme.opaque((*fh).base))
    var er: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&er, 20.0, 20.0, 200.0, 40.0)
    let sr: *mut style.Style = widget.w_style(&er)
    *sr = style.style_set_bg(*sr, style.color_literal(16711680 as u32))
    render.draw_widget(&ch2, &er)
    let rot: u32 = canvas.canvas_get(&cv, 40, 26) & 16777215 as u32
    var n12: [u8; 30] = "4 literal rot bleibt rot      "
    sag((&n12[0]) as u64, 30, rot == 16711680 as u32, rot,
        16711680 as u32)

    // ==================================================================
    // 5. DER KERN MALT IN BGRX -- UND ZWAR RICHTIGHERUM
    // ==================================================================
    // Fehler 2 dieser Runde. Ein Zeichen in einer eindeutigen Farbe:
    // 0xFF0000 (rot) muss als rot ankommen, nicht als blau.
    let kb: usize = 40 * 40 * 4
    let kp: u64 = rt.heap_alloc(kb)
    if kp == 0 as u64 {
        return 4
    }
    rt.mem_set(kp, 0 as u8, kb)
    var zi: core.Target = core.target_new(kp, 40, 40, 40 * 4)
    core.cap_close(&zi, 10, 10, 20, 2, 16711680 as u32)
    // Der Kern legt B,G,R ab. Ein rotes Zeichen hat also R=255 im
    // DRITTEN Oktett.
    var rot_gefunden: usize = 0
    var falsch: usize = 0
    var iy: usize = 0
    while iy < 40 {
        var ix: usize = 0
        while ix < 40 {
            let o: u64 = ((iy * 40 + ix) * 4) as u64
            let b: u8 = *((kp + o) as *mut u8)
            let r: u8 = *((kp + o + 2 as u64) as *mut u8)
            if r == 255 as u8 && b == 0 as u8 {
                rot_gefunden = rot_gefunden + 1
            }
            if b == 255 as u8 && r == 0 as u8 {
                falsch = falsch + 1
            }
            ix = ix + 1
        }
        iy = iy + 1
    }
    var n13: [u8; 30] = "5 Kern legt R an Stelle 2 ab  "
    sag((&n13[0]) as u64, 30, rot_gefunden > 0 && falsch == 0,
        rot_gefunden as u32, 0 as u32)

    var t: rt.Buf = rt.buf_new()
    rt.buf_push(&t, 10 as u8)
    if G_FEHLER > 0 {
        var ff: [u8; 28] = "WELLE 1 NICHT IN ORDNUNG.\n\0\0"
        rt.buf_push_bytes(&t, (&ff[0]) as u64, 26)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
        return 1
    }
    var o: [u8; 22] = "WELLE 1 BESTANDEN.\n\0\0\0"
    rt.buf_push_bytes(&t, (&o[0]) as u64, 19)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 0
}
