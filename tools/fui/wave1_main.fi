// SPDX-License-Identifier: GPL-2.0-only
// tools/fui/wave1_main.fi -- THE ACCEPTANCE OF WAVE 1, AT THE PIXEL.
//
// ====================================================== WHY IT EXISTS
//
// JARVIS' condition: "ONE CHECK PER ELEMENT that fails the build when
// the rendering breaks. The same drawing was silently lost twice
// today; that must become structurally impossible."
//
// This program paints the same elements as the gallery and READS THE
// PIXELS BACK. On its first run it found three real bugs, all three
// invisible in the source:
//
//   1. All five button states were THE SAME GREY. `def_bg` returned
//      the resting colour for every state, and `style.resolve_bg`
//      falls back to exactly that when the caller says nothing -- so
//      always. Compiled clean, ran clean, only without states.
//   2. The window buttons from the core came out in THE WRONG COLOURS
//      (0xFEFBFB instead of 0xFBFBFE): the core writes BGRX (contract
//      F3 of lib/window/window.fi), the canvas holds RGBA.
//   3. The panel below the style variants was not painted at all
//      because the painter's clip window was narrower than it -- and
//      so the proof for "transparent" was worthless.
//
// None of the three could have been found by reading.
import std.rt
import paint.canvas
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.core

const FONTSET_BYTES: usize = 4096
const W: usize = 600
const H: usize = 200

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, got: u32, want: u32) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 44 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var h1: [u8; 5] = " got "
    rt.buf_push_bytes(&t, (&h1[0]) as u64, 5)
    rt.buf_push_hex_u64(&t, got as u64, 6)
    var h2: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&h2[0]) as u64, 6)
    rt.buf_push_hex_u64(&t, want as u64, 6)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// Paint a button in one state and return its surface colour.
// Measured at a TEXT FREE spot -- just below the top edge, where a
// letter never sits.
fn cap_surface(cv: *mut canvas.Canvas, c: *mut render.Ctx,
    m: *mut theme.Theme, bits: u32) -> u32 {
    let f: *mut theme.Colors = theme.theme_colors(m)
    canvas.canvas_clear(cv, theme.opaque((*f).base))
    var t: [u8; 4] = "Text"
    var e: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&e, 20.0, 20.0, 200.0, 40.0)
    widget.w_set_text(&e, (&t[0]) as u64, 4)
    widget.w_set_state_bits(&e, bits)
    render.draw_widget(c, &e)
    // CENTRE OF THE LEFT HALF, not near the edge: on a button 40
    // pixels high, y = 26 is only six below the top edge, and that is
    // where the two pixel wide focus ring runs, antialiasing and all.
    // The first version of this check reported "focus tints the
    // surface" for exactly that reason -- a bug in the MEASUREMENT,
    // not in the drawing. The centre is far enough from every edge
    // and still hits no letter (the text is centred from
    // x = 20 + 200/2 - text_width/2).
    return canvas.canvas_get(cv, 40, 40) & 16777215 as u32
}

fn main(start: u64) -> i32 {
    // ---- Font (for the text check; the rest works without it too)
    var fbuf: rt.Buf = rt.buf_new()
    var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
    let have: bool = rt.read_file((&f1[0]) as u64, &fbuf)
    let fsp: *mut metrics.FontSet =
        rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }

    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 2
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 120) {
        return 3
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(true)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)

    // ==================================================================
    // 1. THE FIVE STATES REALLY ARE FIVE
    // ==================================================================
    let z_norm: u32 = cap_surface(&cv, &c, &m, 0 as u32)
    let z_hover: u32 = cap_surface(&cv, &c, &m, 1 as u32)
    let z_pressed: u32 = cap_surface(&cv, &c, &m, 2 as u32)
    let z_focus: u32 = cap_surface(&cv, &c, &m, 4 as u32)
    let z_disabled: u32 = cap_surface(&cv, &c, &m, 8 as u32)

    var n1: [u8; 29] = "1 normal is the button colour"
    report((&n1[0]) as u64, 29, z_norm == (*f).button, z_norm, (*f).button)
    var n2: [u8; 18] = "1 hover is lighter"
    report((&n2[0]) as u64, 18, z_hover == (*f).button_hover, z_hover,
        (*f).button_hover)
    var n3: [u8; 26] = "1 pressed is lighter still"
    report((&n3[0]) as u64, 26, z_pressed == (*f).button_active, z_pressed,
        (*f).button_active)
    // THE BUG THIS CHECK FOUND: before, all three were the same.
    //
    var n4: [u8; 18] = "1 the three differ"
    report((&n4[0]) as u64, 18,
        z_norm != z_hover && z_hover != z_pressed && z_norm != z_pressed,
        z_norm, z_hover)
    // Focus does not tint the SURFACE -- it is a ring.
    var n5: [u8; 32] = "1 focus leaves the surface alone"
    report((&n5[0]) as u64, 32, z_focus == (*f).button, z_focus, (*f).button)
    var n6: [u8; 31] = "1 disabled leaves surface alone"
    report((&n6[0]) as u64, 31, z_disabled == (*f).button, z_disabled, (*f).button)

    // ==================================================================
    // 2. THE FOCUS RING IS THERE, AND IN THE ACCENT COLOUR
    // ==================================================================
    canvas.canvas_clear(&cv, theme.opaque((*f).base))
    var tf: [u8; 4] = "Text"
    var ef: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&ef, 20.0, 20.0, 200.0, 40.0)
    widget.w_set_text(&ef, (&tf[0]) as u64, 4)
    widget.w_set_focus(&ef, true)
    render.draw_widget(&c, &ef)
    // The left edge at half height: that is where the ring is.
    let round_ring: u32 = canvas.canvas_get(&cv, 20, 40) & 16777215 as u32
    var n7: [u8; 26] = "2 focus ring in the accent"
    report((&n7[0]) as u64, 26, round_ring == (*f).accent, round_ring, (*f).accent)
    // Two pixels wide (theme.Shape.focus_w = 2 at scale 1).
    let ring2: u32 = canvas.canvas_get(&cv, 21, 40) & 16777215 as u32
    let inner: u32 = canvas.canvas_get(&cv, 23, 40) & 16777215 as u32
    var n8: [u8; 25] = "2 ring is two pixels wide"
    report((&n8[0]) as u64, 25, ring2 == (*f).accent && inner != (*f).accent,
        ring2, (*f).accent)

    // ==================================================================
    // 3. TRANSPARENT MEANS DO NOT PAINT
    // ==================================================================
    // Onto a probe patch that is NO theme colour: if `transparent`
    // really meant "paint the window colour over it", the window
    // colour would be here.
    let probe: u32 = 16711935 as u32
    canvas.canvas_clear(&cv, theme.opaque(probe))
    var et: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&et, 20.0, 20.0, 200.0, 40.0)
    let st: *mut style.Style = widget.w_style(&et)
    *st = style.style_set_bg(*st, style.color_transparent())
    render.draw_widget(&c, &et)
    let through: u32 = canvas.canvas_get(&cv, 40, 26) & 16777215 as u32
    var n9: [u8; 28] = "3 transparent does not paint"
    report((&n9[0]) as u64, 28, through == probe, through, probe)

    // And a label is transparent BY DEFAULT.
    canvas.canvas_clear(&cv, theme.opaque(probe))
    var eb: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&eb, 20.0, 20.0, 200.0, 40.0)
    render.draw_widget(&c, &eb)
    let through2: u32 = canvas.canvas_get(&cv, 40, 26) & 16777215 as u32
    var n10: [u8; 25] = "3 label without a surface"
    report((&n10[0]) as u64, 25, through2 == probe, through2, probe)

    // ==================================================================
    // 4. THE THEME FOLLOWS ALONG, THE LITERALS DO NOT
    // ==================================================================
    var m_light: theme.Theme = theme.theme_new(false)
    var ch2: render.Ctx = render.ctx_new(&m_light, &z)
    let f_light: *mut theme.Colors = theme.theme_colors(&m_light)
    let light_button: u32 = cap_surface(&cv, &ch2, &m_light, 0 as u32)
    var n11: [u8; 23] = "4 light and dark differ"
    report((&n11[0]) as u64, 23, light_button != z_norm, light_button, z_norm)

    // A LITERAL stays what it is -- in both themes.
    canvas.canvas_clear(&cv, theme.opaque((*f_light).base))
    var er: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&er, 20.0, 20.0, 200.0, 40.0)
    let sr: *mut style.Style = widget.w_style(&er)
    *sr = style.style_set_bg(*sr, style.color_literal(16711680 as u32))
    render.draw_widget(&ch2, &er)
    let red: u32 = canvas.canvas_get(&cv, 40, 26) & 16777215 as u32
    var n12: [u8; 23] = "4 literal red stays red"
    report((&n12[0]) as u64, 23, red == 16711680 as u32, red,
        16711680 as u32)

    // ==================================================================
    // 5. THE CORE PAINTS IN BGRX -- AND THE RIGHT WAY ROUND
    // ==================================================================
    // Bug 2 of this round. A glyph in an unambiguous colour:
    // 0xFF0000 (red) must arrive as red, not as blue.
    let kb: usize = 40 * 40 * 4
    let kp: u64 = rt.heap_alloc(kb)
    if kp == 0 as u64 {
        return 4
    }
    rt.mem_set(kp, 0 as u8, kb)
    var zi: core.Target = core.target_new(kp, 40, 40, 40 * 4)
    core.cap_close(&zi, 10, 10, 20, 2, 16711680 as u32)
    // The core stores B,G,R. So a red glyph has R=255 in the THIRD
    // octet.
    var red_found: usize = 0
    var wrong: usize = 0
    var iy: usize = 0
    while iy < 40 {
        var ix: usize = 0
        while ix < 40 {
            let o: u64 = ((iy * 40 + ix) * 4) as u64
            let b: u8 = *((kp + o) as *mut u8)
            let r: u8 = *((kp + o + 2 as u64) as *mut u8)
            if r == 255 as u8 && b == 0 as u8 {
                red_found = red_found + 1
            }
            if b == 255 as u8 && r == 0 as u8 {
                wrong = wrong + 1
            }
            ix = ix + 1
        }
        iy = iy + 1
    }
    var n13: [u8; 27] = "5 core stores R at offset 2"
    report((&n13[0]) as u64, 27, red_found > 0 && wrong == 0,
        red_found as u32, 0 as u32)

    var t: rt.Buf = rt.buf_new()
    rt.buf_push(&t, 10 as u8)
    if G_ERRORS > 0 {
        var ff: [u8; 24] = "WAVE 1 IS NOT IN ORDER.\n"
        rt.buf_push_bytes(&t, (&ff[0]) as u64, 24)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
        return 1
    }
    var o: [u8; 15] = "WAVE 1 PASSED.\n"
    rt.buf_push_bytes(&t, (&o[0]) as u64, 15)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 0
}
