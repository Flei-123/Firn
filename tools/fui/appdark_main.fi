// SPDX-License-Identifier: MPL-2.0
// tools/fui/appdark_main.fi -- a theme switch must reach every resting widget: after app.set_dark the button face and its text keep WCAG AA contrast (4.5:1), in both directions, repeated.
// Regression: the transition registry only re-targeted on a STATE change, so a resting button kept the old theme's face colour (light face + light text in dark).
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.grid
import fui.inspect
import fui.safeout
import fui.sheet
import fui.anim
import fui.style
import fui.a11y
import fui.render

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn num(tag: str, v: f64) {
    say(tag)
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v as i64)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

#[allow_escape]
fn dlen(a: *mut app.App, node: usize) -> usize {
    var db: [u8; 192] = [0 as u8; 192]
    let n: usize = a11y.a11y_description(app.app_scene(a), app.ax(a), node, (&db[0]) as u64, 192)
    return n
}

fn click(w: *mut fuiwirt.Host, x: f64, y: f64) {
    let m: u32 = fuiwirt.host_pointer_move(w, x, y)
    let d: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let u: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

fn pressed(a: *mut app.App) {
    CHANGES = CHANGES + 1
}

fn has(buf: u64, n: usize, what: str) -> bool {
    if what.n > n {
        return false
    }
    var i: usize = 0
    while i + what.n <= n {
        var j: usize = 0
        while j < what.n && *((buf + (i + j) as u64) as *mut u8) == *((what.p as u64 + j as u64) as *mut u8) {
            j = j + 1
        }
        if j == what.n {
            return true
        }
        i = i + 1
    }
    return false
}

fn sample_face(s: *mut Surface, sc: *mut scene.Scene, n: usize) -> u32 {
    let x: usize = (scene.node_x(sc, n) + 4.0) as usize
    let y: usize = (scene.node_y(sc, n) + scene.node_h(sc, n) / 2.0) as usize
    return canvas.canvas_get(&(*s).cv, x, y) & 16777215 as u32
}

fn hex(v: u32) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v as i64)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// One scheme: every button face equals the scheme's button token and reads
// against the scheme's text colour at AA.
fn check_scheme(a: *mut app.App, s: *mut Surface, sc: *mut scene.Scene, btns: *mut usize, n: usize, dark: bool, tag: str) {
    let m: *mut theme.Theme = app.app_theme(a)
    let f: *mut theme.Colors = theme.theme_colors(m)
    let want: u32 = theme.opaque(theme.color_from_style(m, style.color_token(style.TOK_BUTTON))) & 16777215 as u32
    var k: usize = 0
    var faces: bool = true
    var worst: f64 = 21.0
    while k < n {
        let px: u32 = sample_face(s, sc, *((btns as u64 + (k * 8) as u64) as *mut usize))
        if px != want {
            faces = false
        }
        let cr: f64 = theme.contrast(px, (*f).text)
        if cr < worst {
            worst = cr
        }
        k = k + 1
    }
    check(faces, tag)
    num("  worst contrast x100 = ", worst * 100.0)
    check(worst >= 4.5, "button text vs face >= 4.5:1 (WCAG AA)")
    check(theme.theme_is_dark(m) == dark, "theme scheme is the one asked for")
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appdark: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Dark", 360, 200)
    var btns: [usize; 3] = [0; 3]
    btns[0] = app.button(a, "One", pressed)
    btns[1] = app.button(a, "Two", pressed)
    btns[2] = app.button(a, "Three", pressed)
    let s: *mut Surface = surface_for(a, 360, 200)
    let sc: *mut scene.Scene = app.app_scene(a)
    app.set_dark(a, false)
    settle(a, s)
    check_scheme(a, s, sc, &btns[0], 3, false, "light: button faces are the light button token")
    app.set_dark(a, true)
    settle(a, s)
    check_scheme(a, s, sc, &btns[0], 3, true, "dark: button faces are the dark button token (was: stale light face)")
    app.set_dark(a, false)
    settle(a, s)
    check_scheme(a, s, sc, &btns[0], 3, false, "back to light: faces follow again")
    app.set_dark(a, true)
    settle(a, s)
    check_scheme(a, s, sc, &btns[0], 3, true, "dark again")
    if BAD == 0 {
        say("APPDARK PASSED\n")
        return 0
    }
    say("APPDARK FAILED\n")
    return 1
}
