// SPDX-License-Identifier: MPL-2.0
// tools/fui/kitrtl_main.fi -- THE CHECK OF THE KIT'S RIGHT-TO-LEFT MIRRORING
// (kit.kit_set_rtl).
//
// Every part is drawn in the default direction and in RTL and the two are compared: the hit
// functions must answer for the mirrored picture (a point P in the left-to-right bar and the
// mirrored point in the right-to-left bar find the same tab / tile / part), and the pixels of
// the decorations (the accent underline of a tab, the fill of a progress bar, the separator
// of the sidebar, the active mark, the close buttons) stand where the mirror says. The
// default direction must be untouched: with kit_set_rtl(false) everything is as before
// (tools/fui/kit_main.fi is the proof of that; here the flag is toggled back and forth and
// the first picture must come out again).
//
//     firnc -o /tmp/kitrtl tools/fui/kitrtl_main.fi && /tmp/kitrtl [dir]
import std.rt
import std.io
import paint.canvas
import paint.png
import html.mem
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.style
import fui.editor
import fui.viewport
import fui.kit
import fui.kitcolor
import plat.sysfont

static mut BAD: usize = 0
static mut CHECKS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: io.Fmt) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    io.fmt_print_line(what)
}

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
    w: usize,
    h: usize,
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    kitcolor.kit_theme(&(*p).m, dark)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    (*p).w = w
    (*p).h = h
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn tok(p: *mut Page, t: u32) -> u32 {
    return theme.opaque(render.color_of(&(*p).c, style.color_token(t)))
}

fn clear(p: *mut Page) {
    canvas.canvas_clear(&(*p).cv, tok(p, style.TOK_BASE))
}

fn px(p: *mut Page, x: f64, y: f64) -> u32 {
    return canvas.canvas_get(&(*p).cv, x as usize, y as usize)
}

// the first and last x in the band [y0, y1) where the pixel is exactly `col`; false if none
fn col_span(p: *mut Page, x0: f64, x1: f64, y0: f64, y1: f64, col: u32, lo: *mut f64, hi: *mut f64) -> bool {
    var a: f64 = 100000.0
    var b: f64 = 0.0 - 1.0
    var y: f64 = y0
    while y < y1 {
        var x: f64 = x0
        while x < x1 {
            if px(p, x, y) == col {
                if x < a { a = x }
                if x > b { b = x }
            }
            x = x + 1.0
        }
        y = y + 1.0
    }
    *lo = a
    *hi = b
    return b >= a
}

fn ink_span(p: *mut Page, x0: f64, x1: f64, y0: f64, y1: f64, ground: u32, lo: *mut f64, hi: *mut f64) -> bool {
    var a: f64 = 100000.0
    var b: f64 = 0.0 - 1.0
    var y: f64 = y0
    while y < y1 {
        var x: f64 = x0
        while x < x1 {
            if px(p, x, y) != ground {
                if x < a { a = x }
                if x > b { b = x }
            }
            x = x + 1.0
        }
        y = y + 1.0
    }
    *lo = a
    *hi = b
    return b >= a
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    return d <= tol
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = rt.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

fn hash_of(p: *mut Page) -> u32 {
    var h: u32 = 2166136261 as u32
    var y: usize = 0
    while y < (*p).h {
        var x: usize = 0
        while x < (*p).w {
            h = (h ^ canvas.canvas_get(&(*p).cv, x, y)) *% 16777619 as u32
            x = x + 1
        }
        y = y + 1
    }
    return h
}

fn run_tabs(p: *mut Page, tag: str) {
    let c: *mut render.Ctx = &(*p).c
    var tabs: [kit.Tab; 3] = [kit.Tab { icon: kit.ICON_NONE, label: "Installed", badge: 12 },
        kit.Tab { icon: kit.ICON_NONE, label: "Browse", badge: 0 }, kit.Tab { icon: kit.ICON_NONE, label: "Updates", badge: 3 }]
    let tp: *mut kit.Tab = (&tabs[0]) as *mut kit.Tab
    let bx: f64 = 20.0
    let bw: f64 = 600.0
    // left to right
    kit.kit_set_rtl(false)
    clear(p)
    kit.tabbar_draw(c, tp, 3, 1, kit.NONE, false, bx, 10.0, bw)
    let h_ltr: u32 = hash_of(p)
    var l0: f64 = 0.0
    var h0: f64 = 0.0
    let accent: u32 = theme.opaque(kitcolor.accent_ui(&(*p).m, tok(p, style.TOK_BASE) & 16777215 as u32))
    check(col_span(p, 0.0, 640.0, 10.0 + kit.tabbar_height(c) - 2.0, 10.0 + kit.tabbar_height(c), accent, &l0, &h0),
        f"{tag}: the active tab has its accent underline (x {l0} .. {h0})")
    var tx1: f64 = 0.0
    var tw1: f64 = 0.0
    kit.tab_rect(c, tp, 3, 1, bx, bw, &tx1, &tw1)
    // right to left
    kit.kit_set_rtl(true)
    clear(p)
    kit.tabbar_draw(c, tp, 3, 1, kit.NONE, false, bx, 10.0, bw)
    var l1: f64 = 0.0
    var h1: f64 = 0.0
    check(col_span(p, 0.0, 640.0, 10.0 + kit.tabbar_height(c) - 2.0, 10.0 + kit.tabbar_height(c), accent, &l1, &h1), f"{tag}: the RTL underline is there")
    // the underline spans the tab minus 8 on both sides; mirrored in the bar
    check(near(l1, bx + bw - (h0 - bx) - 1.0, 2.0) && near(h1, bx + bw - (l0 - bx) - 1.0, 2.0),
        f"{tag}: the underline is the mirror image of the left-to-right one ({l1} .. {h1} against {l0} .. {h0})")
    save(&(*p).cv, 0, "x")
    // hit functions: the mirrored point finds the same tab
    var ok: bool = true
    var i: usize = 0
    while i < 3 {
        var ax: f64 = 0.0
        var aw: f64 = 0.0
        kit.kit_set_rtl(false)
        kit.tab_rect(c, tp, 3, i, bx, bw, &ax, &aw)
        let pl: f64 = ax + aw / 2.0
        kit.kit_set_rtl(true)
        let hit_r: usize = kit.tabbar_hit(c, tp, 3, bx, 10.0, bw, bx + bw - (pl - bx), 12.0)
        if hit_r != i {
            ok = false
        }
        i = i + 1
    }
    check(ok, f"{tag}: the mirrored point of every tab finds the same tab")
    // the first tab is at the right end
    var f0: f64 = 0.0
    var fw: f64 = 0.0
    var f2: f64 = 0.0
    var fw2: f64 = 0.0
    kit.tab_rect(c, tp, 3, 0, bx, bw, &f0, &fw)
    kit.tab_rect(c, tp, 3, 2, bx, bw, &f2, &fw2)
    check(f0 > f2 && f0 + fw <= bx + bw + 0.5, f"{tag}: tab 0 stands right of tab 2 and ends at the bar's right edge")
    // the keys are swapped
    check(kit.tabbar_key(3, 1, editor.KEY_LEFT) == 2 && kit.tabbar_key(3, 1, editor.KEY_RIGHT) == 0, f"{tag}: Left goes on, Right goes back")
    // and back again: the left-to-right picture is exactly the first
    kit.kit_set_rtl(false)
    clear(p)
    kit.tabbar_draw(c, tp, 3, 1, kit.NONE, false, bx, 10.0, bw)
    check(hash_of(p) == h_ltr, f"{tag}: switching back gives the left-to-right picture again, pixel for pixel")
    check(kit.tabbar_key(3, 1, editor.KEY_LEFT) == 0, f"{tag}: and the keys are the old ones")
}

fn run_progress(p: *mut Page, tag: str) {
    let c: *mut render.Ctx = &(*p).c
    kit.kit_set_rtl(false)
    clear(p)
    kit.progress_draw(c, 20.0, 20.0, 400.0, 24.0, 400 as i64, "", 0, kit.PB_NORMAL)
    let m: *mut theme.Theme = render.ctx_theme(c)
    let f: *mut theme.Colors = theme.theme_colors(m)
    let track: u32 = tok(p, style.TOK_BUTTON)
    let fill: u32 = theme.opaque(kitcolor.tone(m, (*f).accent, track & 16777215 as u32, kitcolor.MIN_UI_CONTRAST))
    check(px(p, 20.0 + 40.0, 20.0 + 4.0) == fill && px(p, 20.0 + 360.0, 20.0 + 4.0) == track, f"{tag}: 40 % fills the left 40 % of the bar")
    kit.kit_set_rtl(true)
    clear(p)
    kit.progress_draw(c, 20.0, 20.0, 400.0, 24.0, 400 as i64, "", 0, kit.PB_NORMAL)
    check(px(p, 20.0 + 360.0, 20.0 + 4.0) == fill && px(p, 20.0 + 40.0, 20.0 + 4.0) == track, f"{tag}: in RTL it fills the right 40 %")
    // the label still reads on both grounds: its ink is in the middle
    kit.kit_set_rtl(false)
}

#[allow_escape]
fn run_search(p: *mut Page, tag: str) {
    let c: *mut render.Ctx = &(*p).c
    var s: kit.Search = kit.search_new()
    kit.search_set_text(&s, "abc")
    let x: f64 = 20.0
    let y: f64 = 20.0
    let w: f64 = 360.0
    let h: f64 = 40.0
    kit.kit_set_rtl(false)
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    var cd: f64 = 0.0
    kit.search_clear_rect(c, x, y, w, h, &cx, &cy, &cd)
    check(cx > x + w / 2.0, f"{tag}: the clear button is at the right")
    kit.kit_set_rtl(true)
    var cx2: f64 = 0.0
    kit.search_clear_rect(c, x, y, w, h, &cx2, &cy, &cd)
    check(cx2 < x + w / 2.0 && near(cx2 - x, w - (cx - x) - cd, 0.5), f"{tag}: in RTL the clear button is at the left, the mirror of the other")
    // pressing the mirrored place clears the field; the old place does not
    let r1: u32 = kit.search_press(c, &s, x, y, w, h, cx + 2.0, cy + 2.0, 1000000 as u64)
    check(r1 == kit.SEARCH_HIT_FIELD && kit.search_text_len(&s) == 3, f"{tag}: a press where the button was does not clear in RTL")
    let r2: u32 = kit.search_press(c, &s, x, y, w, h, cx2 + 2.0, cy + 2.0, 2000000 as u64)
    check(r2 == kit.SEARCH_HIT_CLEAR && kit.search_text_len(&s) == 0, f"{tag}: a press on the mirrored button clears the field")
    // the magnifier is on the right: ink at the right end, none at the left end
    kit.search_set_text(&s, "")
    clear(p)
    kit.search_draw(c, &s, x, y, w, h, "", false)
    let ground: u32 = px(p, x + w / 2.0, y + h / 2.0)
    var lo: f64 = 0.0
    var hi: f64 = 0.0
    check(ink_span(p, x + 4.0, x + 36.0, y + 8.0, y + h - 8.0, ground, &lo, &hi) == false, f"{tag}: RTL: no symbol at the left end")
    check(ink_span(p, x + w - 36.0, x + w - 4.0, y + 8.0, y + h - 8.0, ground, &lo, &hi), f"{tag}: RTL: the magnifier at the right end")
    kit.kit_set_rtl(false)
    kit.search_free(&s)
}

fn run_nav(p: *mut Page, tag: str) {
    let c: *mut render.Ctx = &(*p).c
    var items: [kit.NavItem; 3] = [kit.NavItem { icon: kit.ICON_NONE, label: "Mods", badge: 5, header: false },
        kit.NavItem { icon: kit.ICON_NONE, label: "Worlds", badge: 0, header: false },
        kit.NavItem { icon: kit.ICON_NONE, label: "Settings", badge: 0, header: false }]
    let ip: *mut kit.NavItem = (&items[0]) as *mut kit.NavItem
    let x: f64 = 20.0
    let w: f64 = 240.0
    let sep: u32 = tok(p, style.TOK_SEPARATOR)
    kit.kit_set_rtl(false)
    clear(p)
    kit.nav_draw(c, ip, 3, 0, kit.NONE, false, x, 10.0, w, 300.0, false)
    check(px(p, x + w - 1.0, 200.0) == sep && px(p, x, 200.0) != sep, f"{tag}: the separator is on the right edge")
    var l0: f64 = 0.0
    var h0: f64 = 0.0
    let accent: u32 = theme.opaque(kitcolor.accent_ui(&(*p).m, tok(p, style.TOK_SURFACE) & 16777215 as u32))
    check(col_span(p, x, x + 10.0, 10.0, 80.0, accent, &l0, &h0), f"{tag}: the active mark is on the left edge")
    kit.kit_set_rtl(true)
    clear(p)
    kit.nav_draw(c, ip, 3, 0, kit.NONE, false, x, 10.0, w, 300.0, false)
    check(px(p, x, 200.0) == sep && px(p, x + w - 1.0, 200.0) != sep, f"{tag}: in RTL the separator is on the left edge")
    var l1: f64 = 0.0
    var h1: f64 = 0.0
    check(col_span(p, x + w - 10.0, x + w, 10.0, 80.0, accent, &l1, &h1), f"{tag}: and the active mark on the right edge")
    // the label of the first item is at the right half, its badge at the left
    let gnd: u32 = tok(p, style.TOK_SELECTION)
    var il: f64 = 0.0
    var ih: f64 = 0.0
    check(ink_span(p, x + 12.0, x + w - 12.0, 10.0 + 12.0, 10.0 + 8.0 + 24.0, gnd, &il, &ih), f"{tag}: the first row has ink")
    kit.kit_set_rtl(false)
}

fn run_grid(p: *mut Page, tag: str) {
    let c: *mut render.Ctx = &(*p).c
    var tiles: [kit.Tile; 5] = [kit.Tile { title: "Sodium", sub: "Rendering", badge: "Mod", icon: kit.ICON_NONE, seed: 0 as u32, px: 0, w: 0, h: 0, stride: 0 }; 5]
    let tp: *mut kit.Tile = (&tiles[0]) as *mut kit.Tile
    var g: kit.TileGrid = kit.grid_new()
    kit.grid_set_rect(&g, 0.0, 0.0, 640.0, 400.0)
    kit.kit_set_rtl(false)
    kit.grid_layout(c, &g, 5)
    var a0: f64 = 0.0
    var ay: f64 = 0.0
    var aw: f64 = 0.0
    var ah: f64 = 0.0
    var b0: f64 = 0.0
    var by: f64 = 0.0
    var bw: f64 = 0.0
    var bh: f64 = 0.0
    kit.grid_tile_rect(&g, 0, &a0, &ay, &aw, &ah)
    kit.grid_tile_rect(&g, 1, &b0, &by, &bw, &bh)
    check(a0 < b0, f"{tag}: tile 0 left of tile 1")
    let cols: usize = g.cols
    kit.kit_set_rtl(true)
    var a1: f64 = 0.0
    var b1: f64 = 0.0
    kit.grid_tile_rect(&g, 0, &a1, &ay, &aw, &ah)
    kit.grid_tile_rect(&g, 1, &b1, &by, &bw, &bh)
    check(a1 > b1, f"{tag}: in RTL tile 0 stands right of tile 1")
    // mirrored within the content width: x' = W - x - w with W the inner content width
    let wtot: f64 = g.pad * 2.0 + (cols as f64) * aw + ((cols - 1) as f64) * g.gap
    check(near(a1, wtot - a0 - aw, 0.5) && near(b1, wtot - b0 - bw, 0.5), f"{tag}: every tile is the mirror of its left-to-right place")
    // hit
    kit.grid_paint(c, &g, tp, 5)
    let ox: f64 = viewport_ox(&g)
    var okh: bool = true
    var i: usize = 0
    while i < 5 {
        var tx: f64 = 0.0
        var ty: f64 = 0.0
        var tw: f64 = 0.0
        var th: f64 = 0.0
        kit.grid_tile_rect(&g, i, &tx, &ty, &tw, &th)
        if kit.grid_hit(&g, ox + tx + tw / 2.0, viewport_oy(&g) + ty + th / 2.0, 5) != i {
            okh = false
        }
        i = i + 1
    }
    check(okh, f"{tag}: the hit of every tile's middle is that tile")
    // keys: Right goes back in RTL
    kit.grid_select(&g, 2)
    kit.grid_key(&g, editor.KEY_RIGHT, 5)
    check(kit.grid_selected(&g) == 1, f"{tag}: RTL: the Right arrow selects the previous tile")
    kit.grid_key(&g, editor.KEY_LEFT, 5)
    check(kit.grid_selected(&g) == 2, f"{tag}: and Left the next")
    kit.kit_set_rtl(false)
}

fn viewport_ox(g: *mut kit.TileGrid) -> f64 {
    return viewport.viewport_content_x(&(*g).vp)
}

fn viewport_oy(g: *mut kit.TileGrid) -> f64 {
    return viewport.viewport_content_y(&(*g).vp)
}

#[allow_escape]
fn run_toasts_modal(p: *mut Page, tag: str) {
    let c: *mut render.Ctx = &(*p).c
    var q: kit.Toasts = kit.toasts_new()
    kit.toast_push(&q, kit.TK_INFO, "Saved", "Undo", 1000, 0)
    var id: u32 = 0
    var part: u32 = 0
    var x: f64 = 0.0
    var y: f64 = 0.0
    var w: f64 = 0.0
    var h: f64 = 0.0
    kit.kit_set_rtl(false)
    kit.toasts_geometry(c, &q, 640.0, 480.0, 0, &x, &y, &w, &h)
    check(kit.toasts_hit(c, &q, 640.0, 480.0, x + w - 20.0, y + h / 2.0, &id, &part) && part == kit.TOAST_PART_CLOSE, f"{tag}: the close button is at the right")
    kit.kit_set_rtl(true)
    check(kit.toasts_hit(c, &q, 640.0, 480.0, x + 20.0, y + h / 2.0, &id, &part) && part == kit.TOAST_PART_CLOSE, f"{tag}: in RTL at the left")
    check(kit.toasts_hit(c, &q, 640.0, 480.0, x + w - 20.0, y + h / 2.0, &id, &part) && part == kit.TOAST_PART_BODY, f"{tag}: and the right end is the body")
    var ok_act: bool = false
    var px0: f64 = x + 20.0
    while px0 < x + w {
        if kit.toasts_hit(c, &q, 640.0, 480.0, px0, y + h / 2.0, &id, &part) && part == kit.TOAST_PART_ACTION {
            ok_act = px0 < x + w / 2.0
        }
        px0 = px0 + 4.0
    }
    check(ok_act, f"{tag}: the action stands beside the close button, at the left half")
    kit.kit_set_rtl(false)
    // the dialog
    var m: kit.Modal = kit.modal_new()
    kit.modal_open(&m, "Delete?", 400, 200, 2, 0)
    var mx: f64 = 0.0
    var my: f64 = 0.0
    var mw: f64 = 0.0
    var mh: f64 = 0.0
    kit.modal_rect(c, &m, 640.0, 480.0, &mx, &my, &mw, &mh)
    check(kit.modal_hit(c, &m, 640.0, 480.0, mx + mw - 20.0, my + 20.0) == kit.MODAL_HIT_CLOSE, f"{tag}: the dialog's close button is at the top right")
    kit.kit_set_rtl(true)
    check(kit.modal_hit(c, &m, 640.0, 480.0, mx + 20.0, my + 20.0) == kit.MODAL_HIT_CLOSE, f"{tag}: in RTL at the top left")
    check(kit.modal_hit(c, &m, 640.0, 480.0, mx + mw - 20.0, my + 20.0) == kit.MODAL_HIT_PANEL, f"{tag}: the old place is the panel")
    kit.kit_set_rtl(false)
}

fn run_label(p: *mut Page, tag: str) {
    let c: *mut render.Ctx = &(*p).c
    let ground: u32 = tok(p, style.TOK_BASE)
    var lo: f64 = 0.0
    var hi: f64 = 0.0
    kit.kit_set_rtl(false)
    clear(p)
    kit.label_in(c, 100.0, 20.0, 24.0, 14.0, 400, tok(p, style.TOK_TEXT), "Hello", 200.0)
    check(ink_span(p, 0.0, 640.0, 20.0, 44.0, ground, &lo, &hi) && lo < 110.0, f"{tag}: a label starts at the left of its box (ink {lo} .. {hi})")
    kit.kit_set_rtl(true)
    clear(p)
    kit.label_in(c, 100.0, 20.0, 24.0, 14.0, 400, tok(p, style.TOK_TEXT), "Hello", 200.0)
    check(ink_span(p, 0.0, 640.0, 20.0, 44.0, ground, &lo, &hi) && hi > 290.0 && hi <= 301.0, f"{tag}: in RTL it ends at the right of its box (ink {lo} .. {hi})")
    kit.kit_set_rtl(false)
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("kitrtl: no font (DejaVu Sans)\n")
        return 9
    }
    check(!kit.kit_rtl(), f"the default direction is left to right")
    var d: usize = 0
    while d < 2 {
        let dark: bool = d == 1
        var tag: str = "light"
        if dark {
            tag = "dark"
        }
        let p: *mut Page = page_new(640, 480, dark, fs as u64)
        run_tabs(p, tag)
        run_progress(p, tag)
        run_search(p, tag)
        run_nav(p, tag)
        run_grid(p, tag)
        run_toasts_modal(p, tag)
        run_label(p, tag)
        d = d + 1
    }
    // a picture of the whole RTL kit for the eye
    let pp: *mut Page = page_new(640, 480, false, fs as u64)
    kit.kit_set_rtl(true)
    clear(pp)
    var items: [kit.NavItem; 3] = [kit.NavItem { icon: kit.ICON_NONE, label: "Mods", badge: 5, header: false },
        kit.NavItem { icon: kit.ICON_NONE, label: "Worlds", badge: 0, header: false },
        kit.NavItem { icon: kit.ICON_NONE, label: "Settings", badge: 0, header: false }]
    kit.nav_draw(&(*pp).c, (&items[0]) as *mut kit.NavItem, 3, 0, kit.NONE, false, 380.0, 0.0, 240.0, 200.0, false)
    var tabs: [kit.Tab; 3] = [kit.Tab { icon: kit.ICON_NONE, label: "Installed", badge: 12 },
        kit.Tab { icon: kit.ICON_NONE, label: "Browse", badge: 0 }, kit.Tab { icon: kit.ICON_NONE, label: "Updates", badge: 3 }]
    kit.tabbar_draw(&(*pp).c, (&tabs[0]) as *mut kit.Tab, 3, 0, kit.NONE, false, 20.0, 220.0, 600.0)
    kit.progress_draw(&(*pp).c, 20.0, 280.0, 600.0, 24.0, 420 as i64, "", 0, kit.PB_NORMAL)
    save(&(*pp).cv, dir, "kitrtl.png")
    kit.kit_set_rtl(false)
    say("checks: ")
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&nb, CHECKS as u64)
    rt.write_everything(1, rt.buf_ptr(&nb), rt.buf_len(&nb))
    rt.buf_free(&nb)
    say("\n")
    if BAD == 0 {
        say("KITRTL PASSED\n")
        return 0
    }
    say("KITRTL FAILED\n")
    return 1
}
