import ds_testpage
import fui.ds_appcard
import fui.ds_tpl_files
import fui.ds_tpl_files_model
import fui.ds_tpl_store
import fui.render
import fui.screenax
import fui.ds_icons
import fui.ds_icons_full
import fui.ds_icons_names

static mut LAST_QN: usize = 99
static mut LAST_ACTION: u32 = 0
static mut PARENTS: [i64; 4] = [0 as i64; 4]

fn parent(ud: u64, node: i64) -> i64 { return PARENTS[node as usize] }
fn name_of(ud: u64, node: i64) -> str {
    if node == 0 { return "Root" }
    if node == 1 { return "Docs" }
    if node == 2 { return "Pics" }
    return "Deep"
}
fn count(ud: u64, node: i64) -> usize {
    if node == 0 { return 4 }
    if node == 1 { return 2 }
    return 0
}
fn entry(ud: u64, node: i64, i: usize, out: *mut ds_tpl_files_model.Entry) {
    if node == 0 {
        if i == 0 { *out = ds_tpl_files_model.Entry { name: "zeta.txt", id: 0 - 1, size: 10 as i64, modified: "2026-01-01", icon: 0 - 1 } }
        if i == 1 { *out = ds_tpl_files_model.Entry { name: "Docs", id: 1, size: 0 as i64, modified: "2026-02-01", icon: 0 - 1 } }
        if i == 2 { *out = ds_tpl_files_model.Entry { name: "alpha.txt", id: 0 - 1, size: 99 as i64, modified: "2026-03-01", icon: 0 - 1 } }
        if i == 3 { *out = ds_tpl_files_model.Entry { name: "Pics", id: 2, size: 0 as i64, modified: "2026-04-01", icon: 0 - 1 } }
    } else {
        if i == 0 { *out = ds_tpl_files_model.Entry { name: "Deep", id: 3, size: 0 as i64, modified: "2026-05-01", icon: 0 - 1 } }
        if i == 1 { *out = ds_tpl_files_model.Entry { name: "b.txt", id: 0 - 1, size: 5 as i64, modified: "2026-06-01", icon: 0 - 1 } }
    }
}

fn scount(ud: u64, cat: usize, q: str) -> usize {
    LAST_QN = q.n
    if q.n > 0 { return 2 }
    return 6
}
fn sitem(ud: u64, cat: usize, q: str, i: usize, out: *mut ds_tpl_store.Item) {
    (*out).name = "App"
    (*out).sub = "Sub"
}
fn sact(ud: u64, cat: usize, q: str, i: usize, a: u32) { LAST_ACTION = a }

fn files_spec() -> ds_tpl_files_model.Spec {
    let h: i64 = ds_icons.gid(ds_icons_names.HOME)
    return ds_tpl_files_model.Spec { ud: 0, title: "Files", places: "Root|Docs", place_nodes: [0, 1, 0, 0, 0, 0, 0, 0],
        place_icons: [h, h, 0, 0, 0, 0, 0, 0], root: 0, parent: parent, name_of: name_of, count: count, entry: entry }
}

fn main() -> i32 {
    ds_icons_full.install()
    let font: u64 = ds_testpage.font_load()
    if font == 0 {
        ds_testpage.say("no system font\n")
        return 2
    }
    screenax.install()
    PARENTS[0] = 0 - 1
    PARENTS[1] = 0
    PARENTS[2] = 0
    PARENTS[3] = 1
    let pg: *mut ds_testpage.Page = ds_testpage.page_new(1100, 700, false, font)
    let c: *mut render.Ctx = &(*pg).c

    ds_testpage.say("== files navigation\n")
    let f: *mut ds_tpl_files.Files = ds_tpl_files.files_new(files_spec())
    ds_tpl_files.go(f, 0 as i64, true)
    ds_testpage.check(ds_tpl_files.entry_count(f) == 4 && ds_tpl_files.current(f) == 0 as i64, "root lists 4 entries")
    ds_tpl_files.select_item(f, 0)
    ds_testpage.check(ds_tpl_files.selected_name(f) == "Docs", "directories sort first, then by name")
    ds_tpl_files.select_item(f, 3)
    ds_testpage.check(ds_tpl_files.selected_name(f) == "zeta.txt", "last entry is zeta.txt")
    ds_tpl_files.open_item(f, 3)
    ds_testpage.check(ds_tpl_files.current(f) == 0 as i64, "opening a file does not navigate")
    ds_tpl_files.open_item(f, 0)
    ds_testpage.check(ds_tpl_files.current(f) == 1 as i64 && ds_tpl_files.entry_count(f) == 2, "opening a directory navigates into it")
    ds_testpage.check(ds_tpl_files.crumb_list(f) == "Root|Docs", "breadcrumb lists the chain")
    ds_tpl_files.go_up(f)
    ds_testpage.check(ds_tpl_files.current(f) == 0 as i64 && ds_tpl_files.history_len(f) == 3, "up navigates to the parent and records history")
    ds_tpl_files.go_back(f)
    ds_testpage.check(ds_tpl_files.current(f) == 1 as i64 && ds_tpl_files.history_pos(f) == 1, "back returns to the previous folder")
    ds_tpl_files.go_forward(f)
    ds_testpage.check(ds_tpl_files.current(f) == 0 as i64, "forward goes to the next folder")
    ds_tpl_files.go_back(f)
    ds_tpl_files.go(f, 2 as i64, true)
    ds_testpage.check(ds_tpl_files.history_len(f) == 3 && ds_tpl_files.current(f) == 2 as i64 && ds_tpl_files.entry_count(f) == 0, "new navigation drops the forward history")
    ds_tpl_files.go(f, 0 as i64, true)
    ds_tpl_files.set_sort(f, ds_tpl_files_model.SORT_SIZE)
    ds_tpl_files.select_item(f, 2)
    ds_testpage.check(ds_tpl_files.selected_name(f) == "zeta.txt", "size sort puts the smaller file before the larger")
    ds_tpl_files.set_sort(f, ds_tpl_files_model.SORT_SIZE)
    ds_tpl_files.select_item(f, 2)
    ds_testpage.check(ds_tpl_files.sort_desc(f) && ds_tpl_files.selected_name(f) == "alpha.txt", "same key again reverses the order")
    ds_tpl_files.toggle_view(f)
    ds_testpage.check(ds_tpl_files.grid_mode(f), "view toggles to grid")
    ds_tpl_files.toggle_view(f)
    ds_tpl_files.place_select(f, 1)
    ds_testpage.check(ds_tpl_files.current(f) == 1 as i64, "sidebar place navigates")

    ds_testpage.say("== files pointer\n")
    let g: *mut ds_tpl_files.Files = ds_tpl_files.files_new(files_spec())
    ds_tpl_files.go(g, 0 as i64, true)
    ds_testpage.clear(pg)
    ds_tpl_files.paint(g as u64, c, 1100.0, 700.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_tpl_files.press(g as u64, 100.0, 125.0)
    ds_testpage.check(ds_tpl_files.current(g) == 1 as i64, "click on a sidebar place navigates")
    ds_testpage.clear(pg)
    ds_tpl_files.paint(g as u64, c, 1100.0, 700.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_tpl_files.press(g as u64, 280.0, 32.0)
    ds_testpage.check(ds_tpl_files.current(g) == 0 as i64, "click on the back button goes back")
    ds_testpage.clear(pg)
    ds_tpl_files.paint(g as u64, c, 1100.0, 700.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_tpl_files.press(g as u64, 400.0, 110.0)
    ds_testpage.check(ds_tpl_files.selected_name(g) == "Docs", "click on a row selects it")
    ds_tpl_files.press(g as u64, 400.0, 110.0)
    ds_testpage.check(ds_tpl_files.current(g) == 1 as i64, "second click on the row opens the folder")

    ds_testpage.say("== store\n")
    let spec: ds_tpl_store.Spec = ds_tpl_store.Spec { ud: 0, title: "Store", cats: "Home|Apps", icons: [0, 0, 0, 0, 0, 0, 0, 0], foot: "", foot_icon: 0 - 1,
        hint: "Search", shots: 2, count: scount, item: sitem, act: sact }
    let s: *mut ds_tpl_store.Store = ds_tpl_store.store_new(spec)
    ds_testpage.clear(pg)
    ds_tpl_store.paint(s as u64, c, 1100.0, 700.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(LAST_QN == 0 && ds_tpl_store.category(s) == 0, "starts on the first category without a query")
    ds_tpl_store.set_query(s, "ab")
    ds_testpage.clear(pg)
    ds_tpl_store.paint(s as u64, c, 1100.0, 700.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(LAST_QN == 2, "search text reaches the item source")
    ds_tpl_store.set_query(s, "")
    ds_tpl_store.select_cat(s, 1)
    ds_testpage.check(ds_tpl_store.category(s) == 1, "category switch")
    ds_tpl_store.open_detail(s, 2)
    ds_testpage.check(ds_tpl_store.in_detail(s) && ds_tpl_store.detail_index(s) == 2, "detail opens for an item")
    ds_testpage.clear(pg)
    ds_tpl_store.paint(s as u64, c, 1100.0, 700.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_tpl_store.press(s as u64, 60.0, 29.0)
    ds_testpage.check(!ds_tpl_store.in_detail(s), "back item leaves the detail page")
    ds_tpl_store.open_detail(s, 1)
    ds_testpage.check(ds_tpl_store.key(s as u64, 8 as u32, 0 as u32) && !ds_tpl_store.in_detail(s), "escape leaves the detail page")
    ds_testpage.clear(pg)
    ds_tpl_store.paint(s as u64, c, 1100.0, 700.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_tpl_store.press(s as u64, 330.0, 196.0)
    ds_testpage.check(LAST_ACTION == ds_appcard.ACT_INSTALL, "install button fires the action callback")
    return ds_testpage.finish("ds_tpl_logic")
}
