import std.rt
import paint.canvas
import font.metrics
import fui.painter
import fui.scene
import fui.widget
import fui.a11y
import fui.app
import fui.appicon
import fui.ds_icons_full
import fui.ds_icons_names
import plat.fuiwirt
import plat.sysfont

static mut BAD: usize = 0
static mut CLICKS: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h) || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn settle(a: *mut app.App) {
    let i: usize = fuiwirt.host_take_activated(app.app_host(a))
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
}

fn center_x(sc: *mut scene.Scene, id: usize) -> f64 {
    return scene.node_x(sc, id) + scene.node_w(sc, id) / 2.0
}

fn center_y(sc: *mut scene.Scene, id: usize) -> f64 {
    return scene.node_y(sc, id) + scene.node_h(sc, id) / 2.0
}

fn click(a: *mut app.App, s: *mut Surface, id: usize) {
    let h: *mut fuiwirt.Host = app.app_host(a)
    let sc: *mut scene.Scene = app.app_scene(a)
    let x: f64 = center_x(sc, id)
    let y: f64 = center_y(sc, id)
    let moved: u32 = fuiwirt.host_pointer_move(h, x, y)
    let down: u32 = fuiwirt.host_pointer_down(h, x, y, fuiwirt.BTN_LEFT)
    let up: u32 = fuiwirt.host_pointer_up(h, x, y, fuiwirt.BTN_LEFT)
    settle(a)
    frame(a, s)
}

fn clicked(a: *mut app.App) {
    CLICKS = CLICKS + 1
}

fn pixel_hash(s: *mut Surface, node_x: usize, node_y: usize, size: usize) -> u64 {
    let p: *mut u8 = canvas.canvas_pixels(&(*s).cv)
    var h: u64 = 2166136261
    var y: usize = node_y
    while y < node_y + size {
        var x: usize = node_x
        while x < node_x + size {
            let v: u32 = *((p as u64 + ((y * (*s).w + x) * 4) as u64) as *mut u32)
            h = (h ^ (v as u64)) * 16777619 % 4294967296
            x = x + 1
        }
        y = y + 1
    }
    return h
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appicon: no font\n")
        return 9
    }
    FONT = fs as u64
    ds_icons_full.install()
    let a: *mut app.App = app.window("Icons", 320, 200)
    let up: usize = appicon.icon_button(a, ds_icons_names.UP, "Up", clicked)
    let other: usize = app.button(a, "Other", clicked)
    let unnamed: usize = appicon.icon_button(a, ds_icons_names.UP, "", clicked)
    let bad_icon: usize = appicon.icon_button(a, 0 - 1, "Broken", clicked)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 320, 200)
    frame(a, s)
    frame(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    check(up != app.NONE && other != app.NONE, "icon button and text button are created")
    check(unnamed == app.NONE, "an empty label is refused")
    check(bad_icon == app.NONE, "a missing icon is refused")
    check(widget.w_kind(scene.node_widget(sc, up)) == widget.KIND_BUTTON, "icon button is a button node")
    check(scene.node_w(sc, up) == scene.node_h(sc, up) && scene.node_w(sc, up) > 0.0, "icon button is square")
    check(a11y.a11y_role(sc, app.ax(a), up) == a11y.ROLE_BUTTON, "a11y role is button")
    check(a11y.a11y_name(sc, app.ax(a), up, rt.heap_alloc(64), 64) == 2, "a11y name is the label")
    check(app.audit(a) >= 0, "audit accepts the window")
    let ux: usize = scene.node_x(sc, up) as usize
    let uy: usize = scene.node_y(sc, up) as usize
    let size: usize = scene.node_w(sc, up) as usize
    let idle: u64 = pixel_hash(s, ux, uy, size)
    let h: *mut fuiwirt.Host = app.app_host(a)
    let moved: u32 = fuiwirt.host_pointer_move(h, center_x(sc, up), center_y(sc, up))
    frame(a, s)
    frame(a, s)
    let hover: u64 = pixel_hash(s, ux, uy, size)
    check(hover != idle, "hover changes the pixels")
    click(a, s, up)
    check(CLICKS == 1, "a click runs the callback")
    click(a, s, other)
    check(CLICKS == 2, "text button still works next to it")
    if BAD > 0 {
        say("appicon: FAILED\n")
        return 1
    }
    say("appicon: all ok\n")
    return 0
}
