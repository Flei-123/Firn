// SPDX-License-Identifier: GPL-2.0-only
// tools/fui/stil_main.fi -- DIE FUENF STILFAELLE, AM BILDPUNKT GEMESSEN.
//
// Justins Punkt 8: "Automatische Pruefung: fuer jede Variante Pixel
// messen (transparent = Hintergrund unveraendert; rot = gemessener
// RGB-Wert; theme = hell/dunkel messbar verschieden). Bau scheitert,
// wenn eine Variante nicht greift."
//
// Genau das tut dieses Programm. Es malt jede Variante auf einen
// Prueffleck bekannter Farbe und LIEST DEN BILDPUNKT ZURUECK. Nicht der
// Quelltext wird geprueft, sondern das Ergebnis -- derselbe Grund wie
// bei tools/fui/kreuz_main.fi: dieselbe Zeichnung ist zweimal still
// verlorengegangen, und beide Male hat der Quelltext gut ausgesehen.
//
// Der Prueffleck ist ABSICHTLICH nicht die Themenfarbe, sondern ein
// grelles Magenta. Damit faellt "transparent" auf: waere es in
// Wahrheit "male die Fensterfarbe drueber" (Justins Punkt 4), stuende
// hier hinterher die Fensterfarbe und nicht Magenta.
import std.rt
import fui.kern
import fui.stil
import fui.marke

const W: usize = 200
const H: usize = 60

static mut G_FEHLER: usize = 0

fn sag(nm: u64, nn: usize, ok: bool, ist: u32, soll: u32) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "FALSCH  "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_FEHLER = G_FEHLER + 1
    }
    var h1: [u8; 5] = " ist "
    rt.buf_push_bytes(&t, (&h1[0]) as u64, 5)
    rt.buf_push_hex_u64(&t, ist as u64, 6)
    var h2: [u8; 6] = " soll "
    rt.buf_push_bytes(&t, (&h2[0]) as u64, 6)
    rt.buf_push_hex_u64(&t, soll as u64, 6)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// Der Prueffleck: grelles Magenta, das in keinem Thema vorkommt.
fn PROBE() -> u32 { return 16711935 as u32 }

// Einen Stilsatz auf den Prueffleck malen und die Mitte zurueckgeben.
// Das ist die eine Stelle, an der ein Element seinen Hintergrund malt
// -- so, wie es jedes Widget spaeter tut.
fn male(p: u64, m: *mut marke.Marke, z: *mut stil.Satz, zustand: u32,
    wid_vorgabe: u32) -> u32 {
    var zi: kern.Ziel = kern.ziel_neu(p, W, H, W * 4)
    kern.fuellen(&zi, PROBE())
    let f: u32 = stil.loese_hg(z, zustand, wid_vorgabe)
    // DIE REGEL: transparent heisst NICHT MALEN.
    if stil.farb_ist_sichtbar(f) {
        let rgb: u32 = marke.farbe_von_stilwert(m, f)
        kern.rund_flaeche(&zi, 10, 10, 100, 32, 8, rgb)
    }
    return kern.hole(&zi, 60, 26)
}

fn main(start: u64) -> i32 {
    let p: u64 = rt.heap_alloc(W * H * 4)
    if p == 0 as u64 {
        return 2
    }
    var mh: marke.Marke = marke.marke_neu(false)   // hell
    var md: marke.Marke = marke.marke_neu(true)    // dunkel

    // ================================================== FALL 1
    // KEIN HINTERGRUND. Der Prueffleck muss UNVERAENDERT bleiben.
    var z1: stil.Satz = stil.satz_neu()
    let s1: *mut stil.Stil = stil.satz_stil(&z1)
    *s1 = stil.stil_setz_hg(*s1, stil.farb_transparent())
    let r1: u32 = male(p, &mh, &z1, stil.ZU_NORMAL,
        stil.farb_token(stil.TK_KNOPF))
    var n1: [u8; 34] = "1 kein Hintergrund (unveraendert) "
    sag((&n1[0]) as u64, 34, r1 == PROBE(), r1, PROBE())

    // ================================================== FALL 2
    // HINTERGRUND NUR BEI HOVER. Normal transparent, ueberfahren gefuellt.
    // Das ist der EINZEILER, den Justin verlangt.
    var z2: stil.Satz = stil.satz_neu()
    let s2: *mut stil.Stil = stil.satz_stil(&z2)
    *s2 = stil.stil_setz_hg(*s2, stil.farb_transparent())
    stil.satz_setz_ueber(&z2, stil.ZU_UEBER,
        stil.ueber_setz_hg(stil.ueber_neu(),
            stil.farb_token(stil.TK_AKZENT)))
    let r2a: u32 = male(p, &mh, &z2, stil.ZU_NORMAL,
        stil.farb_token(stil.TK_KNOPF))
    let r2b: u32 = male(p, &mh, &z2, stil.ZU_UEBER,
        stil.farb_token(stil.TK_KNOPF))
    let fh: *mut marke.Farben = marke.marke_farben(&mh)
    var n2a: [u8; 34] = "2 nur bei hover: normal ist leer  "
    sag((&n2a[0]) as u64, 34, r2a == PROBE(), r2a, PROBE())
    var n2b: [u8; 34] = "2 nur bei hover: hover ist Akzent "
    sag((&n2b[0]) as u64, 34, r2b == (*fh).akzent, r2b, (*fh).akzent)

    // ================================================== FALL 3
    // FESTE ROTE FUELLUNG. Literal, unabhaengig vom Thema.
    var z3: stil.Satz = stil.satz_neu()
    let s3: *mut stil.Stil = stil.satz_stil(&z3)
    *s3 = stil.stil_setz_hg(*s3, stil.farb_literal(16711680 as u32))
    let r3h: u32 = male(p, &mh, &z3, stil.ZU_NORMAL,
        stil.farb_token(stil.TK_KNOPF))
    let r3d: u32 = male(p, &md, &z3, stil.ZU_NORMAL,
        stil.farb_token(stil.TK_KNOPF))
    var n3: [u8; 34] = "3 feste Fuellung rot (hell)       "
    sag((&n3[0]) as u64, 34, r3h == 16711680 as u32, r3h,
        16711680 as u32)
    // Und sie bleibt rot, wenn das Thema wechselt -- das ist der
    // Unterschied zwischen literal und token.
    var n3b: [u8; 34] = "3 rot bleibt rot im dunklen Thema "
    sag((&n3b[0]) as u64, 34, r3d == 16711680 as u32, r3d,
        16711680 as u32)

    // ================================================== FALL 4
    // THEMEABHAENGIG. Derselbe Stil, zwei Themen, ZWEI Farben --
    // ohne dass am Stil irgendetwas geaendert wird.
    var z4: stil.Satz = stil.satz_neu()
    let s4: *mut stil.Stil = stil.satz_stil(&z4)
    *s4 = stil.stil_setz_hg(*s4, stil.farb_token(stil.TK_KNOPF))
    let r4h: u32 = male(p, &mh, &z4, stil.ZU_NORMAL,
        stil.farb_transparent())
    let r4d: u32 = male(p, &md, &z4, stil.ZU_NORMAL,
        stil.farb_transparent())
    let fd: *mut marke.Farben = marke.marke_farben(&md)
    var n4a: [u8; 34] = "4 token hell  = Knopffarbe hell   "
    sag((&n4a[0]) as u64, 34, r4h == (*fh).knopf, r4h, (*fh).knopf)
    var n4b: [u8; 34] = "4 token dunkel= Knopffarbe dunkel "
    sag((&n4b[0]) as u64, 34, r4d == (*fd).knopf, r4d, (*fd).knopf)
    // DIE EIGENTLICHE ZUSAGE: messbar verschieden.
    var n4c: [u8; 34] = "4 hell und dunkel verschieden     "
    sag((&n4c[0]) as u64, 34, r4h != r4d, r4h, r4d)

    // ================================================== FALL 5
    // VERERBUNG: was der Aufrufer NICHT setzt, kommt vom Widget.
    var z5: stil.Satz = stil.satz_neu()
    let r5: u32 = male(p, &mh, &z5, stil.ZU_NORMAL,
        stil.farb_literal(255 as u32))
    var n5: [u8; 34] = "5 nicht gesetzt -> Widget-Vorgabe "
    sag((&n5[0]) as u64, 34, r5 == 255 as u32, r5, 255 as u32)

    // Und der Zustand schlaegt den Grundstil.
    var z6: stil.Satz = stil.satz_neu()
    let s6: *mut stil.Stil = stil.satz_stil(&z6)
    *s6 = stil.stil_setz_hg(*s6, stil.farb_literal(65280 as u32))
    stil.satz_setz_ueber(&z6, stil.ZU_DRUCK,
        stil.ueber_setz_hg(stil.ueber_neu(),
            stil.farb_literal(255 as u32)))
    let r6a: u32 = male(p, &mh, &z6, stil.ZU_NORMAL,
        stil.farb_transparent())
    let r6b: u32 = male(p, &mh, &z6, stil.ZU_DRUCK,
        stil.farb_transparent())
    var n6a: [u8; 34] = "6 Grundstil gilt bei normal       "
    sag((&n6a[0]) as u64, 34, r6a == 65280 as u32, r6a, 65280 as u32)
    var n6b: [u8; 34] = "6 Zustand schlaegt Grundstil      "
    sag((&n6b[0]) as u64, 34, r6b == 255 as u32, r6b, 255 as u32)

    var t: rt.Buf = rt.buf_new()
    rt.buf_push(&t, 10 as u8)
    if G_FEHLER > 0 {
        var f: [u8; 24] = "STIL NICHT IN ORDNUNG.\n\0"
        rt.buf_push_bytes(&t, (&f[0]) as u64, 23)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
        return 1
    }
    var o: [u8; 18] = "STIL BESTANDEN.\n\0\0"
    rt.buf_push_bytes(&t, (&o[0]) as u64, 16)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 0
}
