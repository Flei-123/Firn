// SPDX-License-Identifier: MPL-2.0
// tools/fui/bidiconf_main.fi -- lib/fui/bidi.fi GEGEN DIE PRUEFFAELLE DER
// UNICODE-SPEZIFIKATION.
//
// ====================================================== WARUM ES DAS GIBT
//
// tools/fui/bidi_main.fi rechnet ausgesuchte Faelle gegen Sollwerte nach,
// die ein Mensch von Hand bestimmt hat -- das zeigt, dass die Regeln so
// gemeint sind, wie sie hier stehen. Ob sie auch in den Ecken stimmen, an
// die beim Schreiben niemand gedacht hat (Klammern in ueberschriebenen
// Einbettungen, ein FSI ohne PDI, 125 verschachtelte Ebenen), zeigt nur
// die Datei, mit der das Unicode-Konsortium jede Umsetzung prueft:
// BidiCharacterTest.txt, 91.707 Zeilen, jede mit Codepunkten,
// Absatzrichtung, erwarteter Absatzebene, erwarteten Ebenen je Zeichen und
// erwarteter Reihenfolge auf dem Schirm.
//
// Die Datei liegt GEPACKT unter tools/ucd/BidiCharacterTest.txt.gz (6,9 MB
// ausgepackt, 0,4 MB gepackt), ihre Summe steht in
// tools/ucd/UCD_BIDI.sha256, und tools/fui/run.sh reicht sie ausgepackt auf
// die Standardeingabe. Jede Zeile wird gerechnet; das Programm nennt die
// ersten Abweichungen woertlich und endet mit 1, wenn es auch nur eine
// gibt.
//
// Die Felder einer Zeile (Kopf der Datei):
//   0  Codepunkte, hexadezimal
//   1  Absatzrichtung: 0 = LTR, 1 = RTL, 2 = automatisch (P2/P3)
//   2  die erwartete Absatzebene
//   3  die erwarteten Ebenen, "x" fuer die von X9 entfernten Zeichen
//   4  die erwartete Reihenfolge auf dem Schirm, ohne die entfernten
// Die Zeile ist ein ganzer Absatz und EINE Schirmzeile -- L1 gilt also
// fuer ihr Ende.
import std.rt
import str.ucd_bidi
import fui.bidi

const CAP: usize = 256

struct Rd {
    p: u64,
    n: usize,
    i: usize,
}

fn at(r: *mut Rd) -> u8 {
    if (*r).i >= (*r).n {
        return 0 as u8
    }
    return *(((*r).p + (*r).i as u64) as *mut u8)
}

fn skip_sp(r: *mut Rd) {
    while at(r) == 32 as u8 {
        (*r).i = (*r).i + 1
    }
}

fn hexv(c: u8) -> i64 {
    if c >= 48 as u8 && c <= 57 as u8 { return c as i64 - 48 }
    if c >= 65 as u8 && c <= 70 as u8 { return c as i64 - 55 }
    if c >= 97 as u8 && c <= 102 as u8 { return c as i64 - 87 }
    return 0 - 1
}

fn num(r: *mut Rd, base: i64) -> i64 {
    var v: i64 = 0
    var k: usize = 0
    while true {
        var d: i64 = hexv(at(r))
        if base == 10 && d > 9 {
            d = 0 - 1
        }
        if d < 0 {
            break
        }
        v = v * base + d
        k = k + 1
        (*r).i = (*r).i + 1
    }
    if k == 0 {
        return 0 - 1
    }
    return v
}

fn to_eol(r: *mut Rd) {
    while (*r).i < (*r).n && at(r) != 10 as u8 {
        (*r).i = (*r).i + 1
    }
    if (*r).i < (*r).n {
        (*r).i = (*r).i + 1
    }
}

fn ld8(p: u64, i: usize) -> u8 { return *((p + i as u64) as *mut u8) }
fn st8(p: u64, i: usize, v: u8) { *((p + i as u64) as *mut u8) = v }
fn ld32(p: u64, i: usize) -> u32 { return *((p + (i * 4) as u64) as *mut u32) }
fn st32(p: u64, i: usize, v: u32) { *((p + (i * 4) as u64) as *mut u32) = v }

fn say_line(ln: usize, what: u64, wn: usize, got: i64, want: i64) {
    var t: rt.Buf = rt.buf_new()
    var z: [u8; 8] = "  Zeile "
    rt.buf_push_bytes(&t, (&z[0]) as u64, 8)
    rt.buf_push_dec_u64(&t, ln as u64)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_bytes(&t, what, wn)
    var g: [u8; 5] = " got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 5)
    rt.buf_push_dec_i64(&t, got)
    var w: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&w[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, want)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn main() -> i32 {
    let t: u64 = ucd_bidi.ucd_bidi_map()
    if t == 0 {
        return 2
    }
    var inp: rt.Buf = rt.buf_new()
    if !rt.read_stdin(&inp) {
        return 2
    }
    var r: Rd = Rd { p: rt.buf_ptr(&inp), n: rt.buf_len(&inp), i: 0 }

    let cp: u64 = rt.heap_alloc(CAP * 4)
    let c0: u64 = rt.heap_alloc(CAP)
    let c1: u64 = rt.heap_alloc(CAP)
    let lv: u64 = rt.heap_alloc(CAP)
    let pl: u64 = rt.heap_alloc(CAP)
    let wk: u64 = rt.heap_alloc(bidi.bidi_work_bytes(CAP))
    let ll: u64 = rt.heap_alloc(CAP)
    let want_lv: u64 = rt.heap_alloc(CAP)
    let keep: u64 = rt.heap_alloc(CAP * 4)
    let kl: u64 = rt.heap_alloc(CAP)
    let ord: u64 = rt.heap_alloc(CAP * 4)

    var lines: usize = 0
    var cases: usize = 0
    var bad: usize = 0
    var shown: usize = 0
    var levels_checked: usize = 0
    var order_checked: usize = 0
    while r.i < r.n {
        lines = lines + 1
        let c: u8 = at(&r)
        if c == 35 as u8 || c == 10 as u8 {
            to_eol(&r)
            continue
        }
        // Feld 0
        var n: usize = 0
        while at(&r) != 59 as u8 {
            skip_sp(&r)
            let v: i64 = num(&r, 16)
            if v < 0 {
                break
            }
            if n < CAP {
                st32(cp, n, v as u32)
            }
            n = n + 1
        }
        r.i = r.i + 1
        let dir_in: i64 = num(&r, 10)
        r.i = r.i + 1
        let want_para: i64 = num(&r, 10)
        r.i = r.i + 1
        // Feld 3: Ebenen, 255 fuer "x"
        var k: usize = 0
        while at(&r) != 59 as u8 {
            skip_sp(&r)
            if at(&r) == 120 as u8 {
                r.i = r.i + 1
                if k < CAP {
                    st8(want_lv, k, 255 as u8)
                }
                k = k + 1
            } else {
                let v2: i64 = num(&r, 10)
                if v2 < 0 {
                    break
                }
                if k < CAP {
                    st8(want_lv, k, v2 as u8)
                }
                k = k + 1
            }
        }
        r.i = r.i + 1
        if n > CAP || k != n {
            say_line(lines, 0, 0, n as i64, k as i64)
            return 3
        }
        cases = cases + 1
        var dir: u32 = bidi.DIR_AUTO
        if dir_in == 0 {
            dir = bidi.DIR_LTR
        } else if dir_in == 1 {
            dir = bidi.DIR_RTL
        }
        var bp: bidi.BidiPara = bidi.bidi_new(t, cp, n, c0, c1, lv, pl, wk)
        let got_para: u8 = bidi.bidi_run(&bp, dir)
        bidi.bidi_line_levels(&bp, 0, n, ll)
        var ok: bool = got_para as i64 == want_para
        var first_bad: i64 = 0 - 1
        var j: usize = 0
        var m: usize = 0
        while j < n {
            let wl: u8 = ld8(want_lv, j)
            if wl != 255 as u8 {
                levels_checked = levels_checked + 1
                if ld8(ll, j) != wl {
                    if ok {
                        first_bad = j as i64
                    }
                    ok = false
                }
                st32(keep, m, j as u32)
                st8(kl, m, ld8(ll, j))
                m = m + 1
            }
            j = j + 1
        }
        // Feld 4: die Reihenfolge der nicht entfernten Zeichen
        bidi.bidi_reorder(kl, m, ord)
        var q: usize = 0
        var order_ok: bool = true
        while at(&r) != 10 as u8 && r.i < r.n {
            skip_sp(&r)
            let v3: i64 = num(&r, 10)
            if v3 < 0 {
                break
            }
            if q >= m || ld32(keep, ld32(ord, q) as usize) as i64 != v3 {
                order_ok = false
            }
            q = q + 1
        }
        order_checked = order_checked + q
        if q != m {
            order_ok = false
        }
        if !order_ok {
            ok = false
        }
        if !ok {
            bad = bad + 1
            if shown < 12 {
                shown = shown + 1
                var s1: [u8; 21] = "Absatzebene          "
                say_line(lines, (&s1[0]) as u64, 11, got_para as i64,
                    want_para)
                if first_bad >= 0 {
                    var s2: [u8; 21] = "Ebene an Stelle      "
                    say_line(lines, (&s2[0]) as u64, 15,
                        ld8(ll, first_bad as usize) as i64,
                        ld8(want_lv, first_bad as usize) as i64)
                }
                if !order_ok {
                    var s3: [u8; 21] = "Reihenfolge falsch   "
                    say_line(lines, (&s3[0]) as u64, 18, q as i64, m as i64)
                }
            }
        }
        to_eol(&r)
    }
    var o: rt.Buf = rt.buf_new()
    var h1: [u8; 31] = "  BidiCharacterTest.txt: Faelle"
    rt.buf_push_bytes(&o, (&h1[0]) as u64, 31)
    rt.buf_push(&o, 32 as u8)
    rt.buf_push_dec_u64(&o, cases as u64)
    var h2: [u8; 18] = ", davon richtig   "
    rt.buf_push_bytes(&o, (&h2[0]) as u64, 16)
    rt.buf_push(&o, 32 as u8)
    rt.buf_push_dec_u64(&o, (cases - bad) as u64)
    var h3: [u8; 22] = ", Ebenen verglichen   "
    rt.buf_push_bytes(&o, (&h3[0]) as u64, 19)
    rt.buf_push(&o, 32 as u8)
    rt.buf_push_dec_u64(&o, levels_checked as u64)
    var h4: [u8; 24] = ", Schirmstellen         "
    rt.buf_push_bytes(&o, (&h4[0]) as u64, 15)
    rt.buf_push(&o, 32 as u8)
    rt.buf_push_dec_u64(&o, order_checked as u64)
    rt.buf_push(&o, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
    if bad != 0 || cases < 90000 {
        var f: [u8; 21] = "\nBIDICONF FAILED.\n   "
        rt.write_everything(1, (&f[0]) as u64, 18)
        return 1
    }
    var p2: [u8; 21] = "\nBIDICONF PASSED.\n   "
    rt.write_everything(1, (&p2[0]) as u64, 18)
    return 0
}
