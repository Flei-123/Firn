// SPDX-License-Identifier: MPL-2.0
// tools/fui/screenanim_main.fi -- motion of immediate-mode screens (lib/fui/screenanim.fi): hover fade, card lift,
// focus ring fade, caret blink + wake-up, page fade-up. A simulated clock drives a Ctx with a bound registry.
import std.rt
import paint.canvas
import fui.theme
import fui.painter
import fui.render
import fui.anim
import fui.editor
import fui.screenanim

static mut G_ERRORS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_int(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(name: str, ok: bool, got: i64) {
    say("  ")
    say(name)
    var k: usize = name.n
    while k < 66 {
        say(" ")
        k = k + 1
    }
    if ok {
        say("OK    got ")
    } else {
        say("WRONG got ")
        G_ERRORS = G_ERRORS + 1
    }
    say_int(got)
    say("\n")
}

fn pm(v: f64) -> i64 {
    return (v * 1000.0) as i64
}

fn frame(c: *mut render.Ctx, r: *mut anim.TransReg, ms: i64) {
    render.ctx_set_time(c, ms)
    anim.transreg_new_frame(r)
    screenanim.begin_frame()
}

#[allow_escape]
fn main(start: u64) -> i32 {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, 64, 64) { return 4 }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, 64, 64) { return 5 }
    var m: theme.Theme = theme.theme_new(true)
    var c: render.Ctx = render.ctx_new(&m, &z)
    var reg: anim.TransReg = anim.transreg_new()
    anim.transreg_bind(&reg, &c)
    let cp: *mut render.Ctx = &c
    let rp: *mut anim.TransReg = &reg

    say("hover\n")
    frame(cp, rp, 0)
    check("rest: 0", pm(screenanim.hover(cp, 40.0, 50.0, false)) == 0, 0)
    frame(cp, rp, 10)
    let h10: f64 = screenanim.hover(cp, 40.0, 50.0, true)
    check("10 ms after the pointer arrived: started, not there", h10 >= 0.0 && h10 < 0.5, pm(h10))
    check("a moving fade asks for another frame", anim.transreg_dirty(rp), 1)
    frame(cp, rp, 85)
    let h85: f64 = screenanim.hover(cp, 40.0, 50.0, true)
    check("half way: between 0.3 and 0.95", h85 > 0.3 && h85 < 0.95, pm(h85))
    frame(cp, rp, 400)
    check("arrived: 1", pm(screenanim.hover(cp, 40.0, 50.0, true)) == 1000, 1000)
    check("at rest the registry does not ask for frames", !anim.transreg_dirty(rp), 0)
    frame(cp, rp, 500)
    check("pointer left: still 1 in that very frame", pm(screenanim.hover(cp, 40.0, 50.0, false)) == 1000, 1000)
    frame(cp, rp, 560)
    let d: f64 = screenanim.hover(cp, 40.0, 50.0, false)
    check("pointer left: glides down, not at once", d > 0.02 && d < 0.95, pm(d))
    frame(cp, rp, 900)
    check("down again: 0", pm(screenanim.hover(cp, 40.0, 50.0, false)) == 0, 0)
    check("another control is independent", pm(screenanim.hover(cp, 90.0, 50.0, false)) == 0, 0)
    frame(cp, rp, 910)
    let lf: f64 = screenanim.lift(cp, 40.0, 50.0, true)
    check("lift: starts upwards (negative)", lf <= 0.0, pm(lf))
    frame(cp, rp, 1300)
    let lf2: f64 = screenanim.lift(cp, 40.0, 50.0, true)
    check("lift at full hover = -3 pt", lf2 == 0.0 - render.len_of(cp, 3), pm(lf2))
    check("mix ends: t=0 is a, t=1 is b", screenanim.mix(cp, 100 as u32, 200 as u32, 0.0) == 100 as u32 && screenanim.mix(cp, 100 as u32, 200 as u32, 1.0) == 200 as u32, 0)

    say("static ctx\n")
    var c2: render.Ctx = render.ctx_new(&m, &z)
    check("no registry: the target at once", pm(screenanim.hover(&c2, 40.0, 50.0, true)) == 1000, 1000)
    check("no registry: ring at once", pm(screenanim.ring(&c2, 5.0, 5.0)) == 1000, 1000)

    say("focus ring\n")
    frame(cp, rp, 2000)
    check("ring: starts transparent", pm(screenanim.ring(cp, 10.0, 10.0)) == 0, 0)
    frame(cp, rp, 2060)
    let r1: f64 = screenanim.ring(cp, 10.0, 10.0)
    check("ring: half way", r1 > 0.1 && r1 < 0.99, pm(r1))
    frame(cp, rp, 2400)
    check("ring: arrived", pm(screenanim.ring(cp, 10.0, 10.0)) == 1000, 1000)
    frame(cp, rp, 7000)
    check("ring: still there after a long idle, no new fade", pm(screenanim.ring(cp, 10.0, 10.0)) == 1000, 1000)
    frame(cp, rp, 7010)
    check("ring: not drawn for one frame ...", true, 0)
    frame(cp, rp, 7020)
    check("ring: ... fades in again", pm(screenanim.ring(cp, 10.0, 10.0)) == 0, 0)

    say("page fade-up\n")
    frame(cp, rp, 8000)
    check("first page shows at once", pm(screenanim.page(cp, 1)) == 1000, 1000)
    frame(cp, rp, 9000)
    check("page change: restarts at 0", pm(screenanim.page(cp, 2)) == 0, 0)
    frame(cp, rp, 9100)
    let p1: f64 = screenanim.page(cp, 2)
    check("page: half way", p1 > 0.1 && p1 < 0.99, pm(p1))
    check("rise shrinks with progress", screenanim.rise(cp, 0.0) > screenanim.rise(cp, p1) && screenanim.rise(cp, 1.0) == 0.0, pm(screenanim.rise(cp, 0.0)))
    frame(cp, rp, 9600)
    check("page: arrived", pm(screenanim.page(cp, 2)) == 1000, 1000)
    frame(cp, rp, 9700)
    check("same page again: no new fade", pm(screenanim.page(cp, 2)) == 1000, 1000)

    say("caret\n")
    var ed: editor.Editor = editor.editor_new()
    let buf: u64 = rt.heap_alloc(256)
    editor.editor_init(&ed, buf, 256)
    frame(cp, rp, 20000)
    check("caret: visible when the field gets the focus", screenanim.caret_on(cp, &ed, true), 1)
    check("caret: a wake-up is asked for", screenanim.wake_wait(0, 20000) > 0 && screenanim.wake_wait(0, 20000) <= 531, screenanim.wake_wait(0, 20000))
    check("caret: not due yet", !screenanim.wake_tick(0, 20100), 0)
    check("caret: due at the flip", screenanim.wake_tick(0, 20531), 1)
    frame(cp, rp, 20300)
    check("caret: still visible at 300 ms", screenanim.caret_on(cp, &ed, true), 1)
    frame(cp, rp, 20600)
    check("caret: hidden after ~530 ms", !screenanim.caret_on(cp, &ed, true), 0)
    editor.editor_caret_wake(&ed)
    frame(cp, rp, 20700)
    check("caret: typing makes it visible at once", screenanim.caret_on(cp, &ed, true), 1)
    frame(cp, rp, 21000)
    check("caret: and it stays for the next blink period", screenanim.caret_on(cp, &ed, true), 1)
    frame(cp, rp, 21400)
    check("caret: no focus = no caret and no wake-up", !screenanim.caret_on(cp, &ed, false) && screenanim.wake_wait(0, 21400) < 0, screenanim.wake_wait(0, 21400))
    check("idle: no animation running, no wake-up wanted", !anim.transreg_dirty(rp), 0)

    say("\n")
    if G_ERRORS == 0 {
        say("SCREENANIM PASSED.\n")
        return 0
    }
    say("SCREENANIM FAILED: ")
    say_int(G_ERRORS as i64)
    say("\n")
    return 1
}
