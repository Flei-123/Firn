// SPDX-License-Identifier: MPL-2.0
// tools/fui/gallery9_main.fi -- THE DESCRIBED SURFACE AS A PICTURE.
//
// ===================================================== WHY IT EXISTS
//
// lib/fui/scene.fi, lib/fui/sheet.fi and lib/fui/viewport.fi each have
// their own check with re-calculated numbers. What none of
// these checks shows is what the description is about in the first place:
// that in the end a SURFACE stands there that looks
// like an application -- and that its source is shorter than
// the same screen, painted call for call.
//
// So here stands a whole page, written the way a user would
// write it: a TREE (`baue_baum`) and a STYLE SHEET
// (`baue_blatt`). No coordinate is calculated by hand in this sheet
// -- no x, no y, no row height. flex.fi (through scene.fi)
// and the style sheet do that.
//
// =============================================== WHAT THE PICTURE PROVES
//
//   1. THE PANE BOX CARRIES MORE THAN ITS HEIGHT. On the left stands
//      a list of 28 entries in a viewport 528
//      points high on 1130 points of content. The scroll position stands
//      deliberately IN THE MIDDLE of a row (217), so that you SEE the
//      cutting off at the top and bottom.
//   2. THE CUTTING OFF IS MEASURED, not claimed, and over
//      the WHOLE canvas: every point below the toolbar
//      and left of the cards that does not lie in the viewport must
//      carry the colour of the sheet -- the gap above it, the margin
//      below it and the narrow strips beside it. Without a clip there lay
//      there 217 points of list above the toolbar and the rest
//      below the viewport. The RED COUNTER-CHECK stands here: the same
//      pane box is drawn on a second canvas once more,
//      once with and once without its viewport; without
//      it more than 20000 points must run out, otherwise
//      this program reports itself red and writes no picture.
//   3. THE LENGTH OF THE THUMB comes from the ratio
//      viewport/content and is read off the CANVAS.
//   4. THE PRECEDENCE OF THE STYLE SHEET is in the picture: all rows carry
//      the class rule `zeile`, every second one additionally `gerade`
//      (two classes, rank 200), and EXACTLY ONE carries an id
//      (rank 10000) and is therefore the highlighted one. Whoever reverses the
//      precedence sees it at once: then either no
//      row is highlighted or all of them.
//   5. INHERITANCE: font family, size and text colour stand ONCE
//      on the card or the viewport and arrive at the children.
//      The background of the card does NOT arrive there -- otherwise every
//      row would be a second box.
//   6. NO TEXT RUNS OUT OF ITS BOX: for EVERY node of the tree
//      the preferred width from render.pref_of is calculated against the arranged
//      width.
//   7. THE SCROLLBAR CAN BE SEEN. Its track gets from
//      render.def_bg the same colour that a calm surface carries --
//      if the viewport also stood on it, the thumb would be invisible at
//      1.11:1. The viewport background is therefore derived from the
//      track colour (theme.mix) and calculated against the 3:1 from WCAG
//      1.4.11 for controls -- on the colours AND on
//      the pixels of the proof, in light as in dark.
//  10. EVERY CONTROL HAS A ROLE AND A NAME. lib/fui/a11y.fi runs
//      over exactly this tree: all 56 nodes have a role, all
//      12 operable ones a name, and all 12 stand in the tab
//      order. The check found a GAP in doing so
//      that cannot be seen in the picture: the search field carries only its
//      content ("Im Baum suchen ..."), and that is its VALUE, not its
//      name -- as soon as someone types, it would be nameless. It is closed
//      in `beschreibe_barrierefrei` (an explicit name, like
//      aria-label). There also stand headings, toolbar,
//      list and the two cards as named groups. With a
//      sixth argument this program writes the whole tree in
//      the text form of a11y_dump into a file.
//
// ========================================== THE SAVING IN LINES
//
// What is compared is what can REALLY be compared: THE SAME
// piece of surface, once painted call for call and once
// described. The piece is the toolbar -- three buttons, a
// search field that takes the rest, a button in the accent:
//
//     demos/fuidemo/main.fi, fn toolbar_painted 64 lines
//     here, the marks TOOLBAR (the tree)              17 lines
//       + the marks BAR RULES (its appearance)        13 lines
//                                                    -----------
//                                                     30 lines
//
// That is just under HALF, and exactly that is what
// tools/fui/run.sh demands again in section 19c -- the same limit as
// before 22.09.2026. The description got shorter through the short forms that
// lib/fui/scene.fi and lib/fui/sheet.fi have had since:
// scene_box, scene_widget, node_set_space, node_set_flexitem,
// scene_run and sheet_rule -- and since 23.09.2026 the
// SIZE also stands in the style sheet (style_set_height), instead of as a number at every
// node. None of these short forms calculates anything new; each
// calls exactly the calls that previously stood there individually (proven in
// tools/fui/scene_main.fi section 17 and sheet_main.fi 12).
//
// Counted are lines with code, without comments and without blank lines.
// THE CUT IS DELIBERATELY UNCOMFORTABLE: the two helpers `setze` and
// `item_von_widget` from fuidemo are NOT counted (they are also called by
// `titelzeile` and `dialog`, so they are shared), and
// conversely the described page counts its whole appearance --
// also the rule for the class `leiste`, which at the same time
// colours the header row. Whoever counts shared lines only on one side
// flatters the saving.
//
// tools/fui/run.sh (section 19c) re-counts both sides itself, in
// three cuts, and aborts if a limit breaks:
//
//     raw                            57  against  42   (74 %)
//     without the labels             47  against  40   (85 %)
//     without labels and appearance  39  against  21   (54 %)
//
// The third line is the actual statement: what makes work in the painted
// version is the STRUCTURE -- five FlexItems, a
// rectangle, a frame, a distribution loop of its own and the setting of
// every rectangle by hand. That drops out completely in the description.
// The appearance, on the other hand, costs in a style sheet about the same as in
// painting -- with the difference that it stands ONCE for the whole page
// and not per place.
//
// The whole page here (baue_blatt + baue_baum, 223 lines of code) is
// NOT shorter than the surface of demos/fuidemo (191 lines:
// titelzeile, werkzeugleiste, dialog, quellenkarte and the three
// helpers label/item_von_widget/setze, without the phase band) -- but it
// also carries a scrolling list of 28 rows with zebra stripes,
// two cards and five more controls. An honest number is
// better than a flattering one.
//
// The width is the FOURTH argument (default 1240, at least 900):
// the same description carries two canvas widths, and the run paints
// both.
//
//     gallery9_main <out.png> [light|dark] [<font.ttf>] [<width>]
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.layout
import fui.flex
import fui.render
import fui.viewport
import fui.sheet
import fui.scene
import fui.wave2
import fui.a11y

const FONTSET_BYTES: usize = 4096
// THE CANVAS. The width comes in as the fourth argument (default
// 1240), so that the same page comes out in two widths: a
// described surface that stands at only ONE width is no
// description, but a drawing with a detour. All numbers of this
// sheet apply to every width -- it is calculated by flex.fi.
const W_STD: usize = 1240
const W_MIN: usize = 900
const H: usize = 720

// The sheet: margin, gap, and the two bars at the top. From these four
// numbers every other follows -- it is calculated by flex.fi.
const RAND: i64 = 24
const GAP: i64 = 16
const BAR_H: f64 = 56.0

// The list: 28 entries of 34 points, gap 6, inner margin 8. The
// content is thereby 8 + 28*34 + 27*6 + 8 = 1130 points high, the
// viewport 528 -- so it scrolls.
const LINES: usize = 28
const LINE_H: f64 = 34.0
const LINE_GAP: i64 = 6
const LIST_W: f64 = 520.0
const BAR: usize = 12
// THE PADDING OF THE VIEWPORT. Without it the cut lay exactly on the
// edge of the box: at the top a row disappeared under the
// toolbar, at the bottom half of one stood on the sheet edge, and in the
// picture you could not see whether that was intended. With 10 points
// a strip of box background remains all around -- the cut lies
// visibly INSIDE the card. This is checked below in section
// 2c, point by point.
const PADDING: f64 = 10.0
const CONTENT_W: f64 = 508.0
const CONTENT_H: f64 = 1130.0
// The offset stands IN THE MIDDLE of a row: so at the top and bottom
// a cut-off row is to be seen, and the cutting off is in the picture
// and not only in the number.
const ROLL_Y: f64 = 217.0
// The id of the one highlighted row. It is the 11th -- one
// that is really visible at this scroll position.
const ID_ACTIVE: u32 = 4711 as u32
const ACTIVE_NR: usize = 11
// Every entry stands in a field of fixed length; so the text stays
// valid until the picture is written.
const STEP: usize = 40
const LINE_N: usize = 37

static mut G_ERROR: usize = 0

// A demand on the picture itself. If it is violated, the
// message goes to fd 2 and the program ends with an error -- a
// proof that does not fulfil its own statement is not even
// written.
fn request(nm: u64, nn: usize, ok: bool, ist: i64, should: i64) {
    var t: rt.Buf = rt.buf_new()
    var p1: [u8; 11] = "gallery9:  "
    rt.buf_push_bytes(&t, (&p1[0]) as u64, 10)
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 44 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERROR = G_ERROR + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, ist)
    var w2: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&w2[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, should)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// THE EXPECTED RED DEMAND. It MUST fail: the same measurement
// as next to it, only under conditions in which it cannot pass.
// If it fails, RED-OK stands in the log and all is
// well; if it passes, the measurement measures nothing -- and THAT is the
// failure that prevents this picture.
fn request_red(nm: u64, nn: usize, ok: bool, ist: i64, should: i64) {
    var t: rt.Buf = rt.buf_new()
    var p1: [u8; 11] = "gallery9:  "
    rt.buf_push_bytes(&t, (&p1[0]) as u64, 10)
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 44 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERROR = G_ERROR + 1
    } else {
        var o: [u8; 8] = "ROT-OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 8)
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, ist)
    var w2: [u8; 18] = " want NICHT genau "
    rt.buf_push_bytes(&t, (&w2[0]) as u64, 18)
    rt.buf_push_dec_i64(&t, should)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn copy(dst: u64, off: usize, src: u64, n: usize) -> usize {
    var i: usize = 0
    while i < n {
        rt.st8(dst, off + i, rt.ld8(src, i))
        i = i + 1
    }
    return off + n
}

// The labels of the list, written into ONE field, e.g.
// `Eintrag 07 -- Zeile im Scheibenkasten`. They must stay valid the whole run,
// because a node holds only the POINTER to its text -- like every
// widget of this library.
fn write_lines(field: u64) {
    var pre: [u8; 8] = "Eintrag "
    var suf: [u8; 27] = " -- Zeile im Scheibenkasten"
    var i: usize = 0
    while i < LINES {
        let nr: usize = i + 1
        var off: usize = copy(field, i * STEP, (&pre[0]) as u64, 8)
        rt.st8(field, off, (48 + nr / 10) as u8)
        rt.st8(field, off + 1, (48 + nr % 10) as u8)
        off = copy(field, off + 2, (&suf[0]) as u64, 27)
        i = i + 1
    }
}

// ======================================================================
// THE STYLE SHEET
// ======================================================================
//
// Rules, nothing but rules: selector -> style values. No rule names
// a coordinate, none names a node by name except the
// one that is meant to show exactly that (the id of the active row).
// The precedence is calculated by sheet.sheet_resolve; here it only stands,
// and in the picture you see that it is right.
fn rule(sh: *mut sheet.Sheet, s: sheet.Sel, d: sheet.Decl) {
    sheet.sheet_add(sh, s, d)
}

fn build_leaf(sh: *mut sheet.Sheet, k_bar: u32, k_titel: u32,
    k_karte: u32, k_over: u32, k_notiz: u32, k_list: u32,
    k_line: u32, k_even: u32, k_accent: u32, basic_list: u32) {
    // The two bars and the cards: raised surface, a point
    // of border, rounded.
    //
    // THE MARKS ARE NO DECORATION. tools/fui/run.sh (section 19c)
    // counts the lines of the described toolbar, and its appearance
    // belongs to it TOO: the surface of the bar, the radius
    // of its buttons and the accent of the last one. On the painted side
    // exactly that stands in the middle of `fn toolbar_painted`, so it must
    // be counted here too -- also the rule for the class
    // `leiste`, which at the same time colours the header row. Whoever counts shared
    // lines only on one side flatters the saving.
    // >>> BAR RULES
    var s1: style.Style = style.style_new()
    s1 = style.style_set_bg(s1, style.color_token(style.TOK_SURFACE_RAISED))
    s1 = style.style_set_border(s1, style.color_token(style.TOK_BORDER), 1)
    s1 = style.style_set_radius(s1, 10)
    s1 = style.style_set_height(s1, BAR_H as usize)
    sheet.sheet_rule(sh, sheet.sel_class(k_bar), s1)
    // <<< LEISTENREGELN
    var d2: sheet.Decl = sheet.decl_new()
    // The card looks like the bar -- only its fixed height
    // belongs to the bar alone, so it is released again.
    var s2: style.Style = style.style_unset(s1, style.SF_HEIGHT)
    s2 = style.style_set_radius(s2, 12)
    // Font and text colour stand ONCE on the card -- its children
    // inherit them (sheet.INHERIT_MASK), they do not inherit its background.
    s2 = style.style_set_fg(s2, style.color_token(style.TOK_TEXT))
    s2 = style.style_set_font(s2, 0, 13)
    sheet.decl_set_style(&d2, s2)
    rule(sh, sheet.sel_class(k_karte), d2)
    // THE VIEWPORT: A SUNKEN SURFACE, so that the rows stand on it
    // AND the scrollbar can be seen on it. Until
    // 21.09.2026 it carried TOK_SURFACE -- the same colour that
    // render.def_bg gives the TRACK of a scrollbar. Both surfaces
    // were thereby congruent, the thumb (TOK_BUTTON) stood at
    // 1.11:1 on it, and in the proof image nothing of the bar was to be seen
    // except three grip dots. A control that you cannot
    // find does not exist.
    //
    // The colour therefore comes NOT from a token, but from the
    // track colour itself: `theme.mix` shifts it towards the main text
    // until track and background carry the 3:1 that WCAG 1.4.11 demands for
    // controls. It is calculated in main (there the
    // theme is known) and in section 9 re-checked against `theme.contrast`
    // -- in light AND in dark.
    var d3: sheet.Decl = sheet.decl_new()
    var s3: style.Style = style.style_new()
    s3 = style.style_set_bg(s3, basic_list)
    s3 = style.style_set_border(s3, style.color_token(style.TOK_BORDER), 1)
    s3 = style.style_set_radius(s3, 12)
    s3 = style.style_set_fg(s3, style.color_token(style.TOK_TEXT))
    s3 = style.style_set_font(s3, 0, 13)
    sheet.decl_set_style(&d3, s3)
    rule(sh, sheet.sel_class(k_list), d3)
    // The headings and the body texts.
    var d4: sheet.Decl = sheet.decl_new()
    var s4: style.Style = style.style_new()
    s4 = style.style_set_font(s4, 0, 17)
    s4 = style.style_set_fg(s4, style.color_token(style.TOK_TEXT))
    s4 = style.style_set_pad(s4, 0, 0)
    sheet.decl_set_style(&d4, s4)
    rule(sh, sheet.sel_class(k_titel), d4)
    var d5: sheet.Decl = sheet.decl_new()
    var s5: style.Style = style.style_new()
    s5 = style.style_set_font(s5, 0, 14)
    s5 = style.style_set_pad(s5, 0, 0)
    sheet.decl_set_style(&d5, s5)
    rule(sh, sheet.sel_class(k_over), d5)
    var d6: sheet.Decl = sheet.decl_new()
    var s6: style.Style = style.style_new()
    s6 = style.style_set_fg(s6, style.color_token(style.TOK_TEXT_MUTED))
    s6 = style.style_set_font(s6, 0, 12)
    s6 = style.style_set_pad(s6, 0, 0)
    sheet.decl_set_style(&d6, s6)
    rule(sh, sheet.sel_class(k_notiz), d6)
    // THE THREE RULES ON WHICH THE PRECEDENCE HANGS. They contradict
    // each other on purpose: every row fits the first, every second one
    // additionally the second, and exactly one the third.
    // Rank 100 < 200 < 10000 -- in the picture those are three backgrounds.
    var d7: sheet.Decl = sheet.decl_new()
    var s7: style.Style = style.style_new()
    s7 = style.style_set_bg(s7, style.color_token(style.TOK_SURFACE))
    s7 = style.style_set_radius(s7, 8)
    s7 = style.style_set_pad(s7, 12, 0)
    s7 = style.style_set_height(s7, LINE_H as usize)
    sheet.decl_set_style(&d7, s7)
    rule(sh, sheet.sel_class(k_line), d7)
    var d8: sheet.Decl = sheet.decl_new()
    var s8: style.Style = style.style_new()
    s8 = style.style_set_bg(s8, style.color_token(style.TOK_FIELD))
    sheet.decl_set_style(&d8, s8)
    rule(sh, sheet.sel_with_class(sheet.sel_class(k_line), k_even), d8)
    var d9: sheet.Decl = sheet.decl_new()
    var s9: style.Style = style.style_new()
    s9 = style.style_set_bg(s9, style.color_token(style.TOK_ACCENT))
    s9 = style.style_set_fg(s9, style.color_token(style.TOK_TEXT_ON_ACCENT))
    sheet.decl_set_style(&d9, s9)
    rule(sh, sheet.sel_id(ID_ACTIVE), d9)
    // The buttons -- selected by KIND, not by a class.
    // >>> BAR RULES
    sheet.sheet_rule(sh, sheet.sel_kind(widget.KIND_BUTTON),
        style.style_set_radius(style.style_new(), 8))
    var s11: style.Style = style.style_new()
    s11 = style.style_set_bg(s11, style.color_token(style.TOK_ACCENT))
    s11 = style.style_set_fg(s11,
        style.color_token(style.TOK_TEXT_ON_ACCENT))
    sheet.sheet_rule(sh, sheet.sel_class(k_accent), s11)
    // <<< LEISTENREGELN
}

// ======================================================================
// THE TREE
// ======================================================================
//
// It is built ONCE. What stands here is the structure of the page
// and nothing else: header row, toolbar, below it the body of
// list and cards. The numbers are sizes and gaps, not
// coordinates.
fn build_tree(sc: *mut scene.Scene, v: *mut viewport.Viewport, field: u64,
    k_bar: u32, k_titel: u32, k_karte: u32, k_over: u32,
    k_notiz: u32, k_list: u32, k_line: u32, k_even: u32,
    k_accent: u32, t: u64) -> usize {
    let root: usize = scene.scene_add(sc, scene.SCENE_NONE, scene.N_BOX)
    scene.node_set_flex(sc, root, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    scene.node_set_padding(sc, root, RAND, RAND, RAND, RAND)
    scene.node_set_gap(sc, root, GAP, 0)

    // ---- die Kopfzeile: Titel links, drei Knoepfe rechts
    let header: usize = scene.scene_add(sc, root, scene.N_BOX)
    scene.node_add_class(sc, header, k_bar)
    scene.node_set_flex(sc, header, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_CENTER)
    scene.node_set_padding(sc, header, 16, 10, 16, 10)
    scene.node_set_gap(sc, header, 10, 0)
    scene.node_set_size(sc, header, 0.0, BAR_H)
    let titel: usize = scene.scene_add(sc, header, scene.N_TEXT)
    scene.node_add_class(sc, titel, k_titel)
    scene.node_set_text(sc, titel, t, 30)
    scene.node_set_grow(sc, titel, 1000, 1000)
    var i: usize = 0
    while i < 3 {
        let b: usize = scene.scene_add(sc, header, scene.N_WIDGET)
        scene.node_set_widget_kind(sc, b, widget.KIND_BUTTON)
        scene.node_set_text(sc, b, t + (40 + i * 16) as u64, 7)
        scene.node_set_size(sc, b, 0.0, 34.0)
        if i == 2 {
            scene.node_add_class(sc, b, k_accent)
        }
        i = i + 1
    }

    // ---- the toolbar: three buttons, a search field, an accent
    //
    // The two marks are no decoration: tools/fui/run.sh counts
    // the lines between them and holds them against `fn
    // werkzeugleiste` in demos/fuidemo/main.fi (see header).
    // >>> TOOLBAR
    let bar: usize = scene.scene_box(sc, root, k_bar,
        flex.FLEX_ROW, flex.JUSTIFY_START, flex.AL_CENTER)
    scene.node_set_space(sc, bar, 10, 10, 10, 10, 10, 0)
    var j: usize = 0
    while j < 5 {
        let b: usize = scene.scene_widget(sc, bar, widget.KIND_BUTTON,
            t + (88 + j * 16) as u64, 8)
        if j == 3 {
            scene.node_set_widget_kind(sc, b, widget.KIND_TEXTBOX)
            scene.node_set_flexitem(sc, b, 1000, 1000, 140, 0)
            scene.node_set_text(sc, b, t + 184 as u64, 22)
        }
        if j == 4 {
            scene.node_add_class(sc, b, k_accent)
        }
        j = j + 1
    }
    // <<< WERKZEUGLEISTE

    // ---- the body: on the left the viewport, on the right the cards
    let body: usize = scene.scene_add(sc, root, scene.N_BOX)
    scene.node_set_flex(sc, body, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    scene.node_set_gap(sc, body, GAP, 0)
    scene.node_set_grow(sc, body, 1000, 1000)

    let frame_box: usize = scene.scene_add(sc, body, scene.N_VIEWPORT)
    scene.node_add_class(sc, frame_box, k_list)
    scene.node_set_viewport(sc, frame_box, v)
    scene.node_set_flex(sc, frame_box, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    scene.node_set_padding(sc, frame_box, 8, 8, 8, 8)
    scene.node_set_gap(sc, frame_box, LINE_GAP, 0)
    var z: usize = 0
    while z < LINES {
        let r: usize = scene.scene_add(sc, frame_box, scene.N_TEXT)
        scene.node_add_class(sc, r, k_line)
        if z % 2 == 0 {
            scene.node_add_class(sc, r, k_even)
        }
        if z == ACTIVE_NR - 1 {
            scene.node_set_id(sc, r, ID_ACTIVE)
        }
        scene.node_set_text(sc, r, field + (z * STEP) as u64, LINE_N)
        z = z + 1
    }

    let right: usize = scene.scene_add(sc, body, scene.N_BOX)
    scene.node_set_flex(sc, right, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    scene.node_set_gap(sc, right, GAP, 0)
    scene.node_set_grow(sc, right, 1000, 1000)

    let karte1: usize = scene.scene_add(sc, right, scene.N_BOX)
    scene.node_add_class(sc, karte1, k_karte)
    scene.node_set_flex(sc, karte1, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    scene.node_set_padding(sc, karte1, 20, 18, 20, 18)
    scene.node_set_gap(sc, karte1, 10, 0)
    let u1: usize = scene.scene_add(sc, karte1, scene.N_TEXT)
    scene.node_add_class(sc, u1, k_over)
    scene.node_set_text(sc, u1, t + 216 as u64, 28)
    scene.node_set_size(sc, u1, 0.0, 22.0)
    var n: usize = 0
    while n < 4 {
        let e: usize = scene.scene_add(sc, karte1, scene.N_TEXT)
        scene.node_add_class(sc, e, k_notiz)
        scene.node_set_text(sc, e, t + (256 + n * 48) as u64, 44)
        scene.node_set_size(sc, e, 0.0, 18.0)
        n = n + 1
    }

    let karte2: usize = scene.scene_add(sc, right, scene.N_BOX)
    scene.node_add_class(sc, karte2, k_karte)
    scene.node_set_flex(sc, karte2, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    scene.node_set_padding(sc, karte2, 20, 18, 20, 18)
    scene.node_set_gap(sc, karte2, 14, 0)
    scene.node_set_grow(sc, karte2, 1000, 1000)
    let u2: usize = scene.scene_add(sc, karte2, scene.N_TEXT)
    scene.node_add_class(sc, u2, k_over)
    scene.node_set_text(sc, u2, t + 448 as u64, 26)
    scene.node_set_size(sc, u2, 0.0, 22.0)
    var w: usize = 0
    while w < 5 {
        let e: usize = scene.scene_add(sc, karte2, scene.N_WIDGET)
        scene.node_set_size(sc, e, 0.0, 30.0)
        scene.node_set_text(sc, e, t + (480 + w * 24) as u64, 20)
        // Tick, switch and dot take only as much width as they
        // need (`align-self: flex-start`) -- otherwise the cross
        // axis of the box would pull them across the whole card, and a
        // switch 600 points wide is no longer a switch.
        // Its "on" is the VALUE, the same number that wave2 reads.
        if w < 3 {
            scene.node_set_align_self(sc, e, flex.AL_START)
        }
        if w == 0 {
            scene.node_set_widget_kind(sc, e, widget.KIND_CHECKBOX)
            widget.w_set_value(scene.node_widget(sc, e), 1)
        }
        if w == 1 {
            scene.node_set_widget_kind(sc, e, widget.KIND_TOGGLE)
            widget.w_set_value(scene.node_widget(sc, e), 1)
        }
        if w == 2 {
            scene.node_set_widget_kind(sc, e, widget.KIND_RADIO)
            widget.w_set_value(scene.node_widget(sc, e), 1)
        }
        if w == 3 {
            scene.node_set_widget_kind(sc, e, widget.KIND_SLIDER)
            widget.w_set_value(scene.node_widget(sc, e), 620)
        }
        if w == 4 {
            scene.node_set_widget_kind(sc, e, widget.KIND_PROGRESS)
            widget.w_set_value(scene.node_widget(sc, e), 450)
        }
        w = w + 1
    }
    return frame_box
}

// ======================================================================
// THE ACCESSIBILITY OF THE PAGE
// ======================================================================
//
// What a screen reader has to know about this page and the tree
// does not say by itself -- the counterpart to the aria attributes on
// the web. It stands NEXT TO `baue_baum` and not in it, because the marks
// TOOLBAR there count the lines of the structure (tools/fui/
// run.sh, section 19c) and these statements are no structure.
//
// THE GAP that a11y.a11y_unnamed found here: the search field.
// Its text "Im Baum suchen ..." is its content, so its VALUE; it had
// no name. Now it is called explicitly what it does.
const ID_OVER1: u32 = 4801 as u32
const ID_OVER2: u32 = 4802 as u32

fn beschreibe_barrierefrei(ax: *mut a11y.A11y, sc: *mut scene.Scene,
    frame_box: usize, t: u64) {
    let root: usize = scene.scene_root(sc)
    let header: usize = scene.scene_child_at(sc, root, 0)
    a11y.a11y_set_role(ax, scene.scene_child_at(sc, header, 0),
        a11y.ROLE_HEADING)
    let bar: usize = scene.scene_child_at(sc, root, 1)
    a11y.a11y_set_role(ax, bar, a11y.ROLE_TOOLBAR)
    let such: usize = scene.scene_child_at(sc, bar, 3)
    a11y.a11y_set_name(ax, such, t + 608 as u64, 14)
    a11y.a11y_set_role(ax, frame_box, a11y.ROLE_LIST)
    let right: usize = scene.scene_next_sibling(sc, frame_box)
    var k: usize = 0
    while k < 2 {
        let karte: usize = scene.scene_child_at(sc, right, k)
        let over: usize = scene.scene_child_at(sc, karte, 0)
        var id: u32 = ID_OVER1
        if k == 1 {
            id = ID_OVER2
        }
        scene.node_set_id(sc, over, id)
        a11y.a11y_set_role(ax, over, a11y.ROLE_HEADING)
        a11y.a11y_set_role(ax, karte, a11y.ROLE_GROUP)
        a11y.a11y_set_labelled_by(ax, karte, id)
        k = k + 1
    }
}

// The fixed labels of the page, in ONE field. They lie in
// the same order in which `baue_baum` fetches them -- one line per
// text, so that you can read both side by side.
fn write_texts(t: u64) {
    var a0: [u8; 30] = "fUi -- eine beschriebene Seite"
    var a1: [u8; 7] = "Ablage "
    var a2: [u8; 7] = "Ansicht"
    var a3: [u8; 7] = "Sichern"
    var b0: [u8; 8] = "Neu     "
    var b1: [u8; 8] = "Oeffnen "
    var b2: [u8; 8] = "Drucken "
    var b3: [u8; 8] = "        "
    var b4: [u8; 8] = "Starten "
    var b5: [u8; 22] = "Im Baum suchen ...    "
    var c0: [u8; 28] = "Was diese Seite beschreibt: "
    var c1: [u8; 44] = "scene.fi -- Baum, Messen, Anordnen, Zeichnen"
    var c2: [u8; 44] = "sheet.fi -- Auswahl, Rangfolge, Vererbung   "
    var c3: [u8; 44] = "viewport.fi -- Ausschnitt, Clip, Rollbalken "
    var c4: [u8; 44] = "flex.fi -- jede Koordinate in diesem Bild   "
    var d0: [u8; 26] = "Einstellungen dieser Seite"
    var e0: [u8; 20] = "Zebrastreifen       "
    var e1: [u8; 20] = "Weich auslaufen     "
    var e2: [u8; 20] = "Balken immer zeigen "
    var e3: [u8; 20] = "Rollgeschwindigkeit "
    var e4: [u8; 20] = "Aufbau der Liste    "
    var f0: [u8; 14] = "Im Baum suchen"
    copy(t, 0, (&a0[0]) as u64, 30)
    copy(t, 40, (&a1[0]) as u64, 7)
    copy(t, 56, (&a2[0]) as u64, 7)
    copy(t, 72, (&a3[0]) as u64, 7)
    copy(t, 88, (&b0[0]) as u64, 8)
    copy(t, 104, (&b1[0]) as u64, 8)
    copy(t, 120, (&b2[0]) as u64, 8)
    copy(t, 136, (&b3[0]) as u64, 8)
    copy(t, 152, (&b4[0]) as u64, 8)
    copy(t, 184, (&b5[0]) as u64, 22)
    copy(t, 216, (&c0[0]) as u64, 28)
    copy(t, 256, (&c1[0]) as u64, 44)
    copy(t, 304, (&c2[0]) as u64, 44)
    copy(t, 352, (&c3[0]) as u64, 44)
    copy(t, 400, (&c4[0]) as u64, 44)
    copy(t, 448, (&d0[0]) as u64, 26)
    copy(t, 480, (&e0[0]) as u64, 20)
    copy(t, 504, (&e1[0]) as u64, 20)
    copy(t, 528, (&e2[0]) as u64, 20)
    copy(t, 552, (&e3[0]) as u64, 20)
    copy(t, 576, (&e4[0]) as u64, 20)
    copy(t, 608, (&f0[0]) as u64, 14)
}

// How many pixels in this band do NOT carry the colour of the sheet.
// With it we count that painting really happened IN the viewport
// -- the cheapest way to pass a clipping check is to paint nothing.
fn points(cv: *mut canvas.Canvas, x0: usize, x1: usize, y0: usize,
    y1: usize, basic: u32) -> usize {
    var n: usize = 0
    var y: usize = y0
    while y < y1 {
        var x: usize = x0
        while x < x1 {
            if canvas.canvas_get(cv, x, y) != basic {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

// THE CUTTING OFF, MEASURED OVER THE WHOLE CANVAS.
//
// Counted is EVERY pixel of an area that does NOT carry the colour of the
// sheet and does NOT lie in the viewport -- row by row,
// column by column, so also the narrow strips left and right
// and the edge rows immediately above and below the box. Formerly
// this check looked at only two bands; a point that ran out
// sideways would have escaped it.
//
// The area is the whole canvas MINUS what belongs to the rest of the page:
// everything above `ymin` (header row and toolbar) and
// everything right of `xmax` (the two cards). Both limits are
// not guessed, but read off the arranged tree -- otherwise
// the number 0 would be 0 only because the area is chosen small enough.
//
// The FULL rectangle of the viewport is excluded, not only
// its inner surface: the scrollbar lies in its right track,
// and it belongs there.
fn foreign(cv: *mut canvas.Canvas, xmax: usize, ymin: usize, height: usize,
    vx: usize, vy: usize, vw: usize, vh: usize, basic: u32) -> usize {
    var n: usize = 0
    var y: usize = ymin
    while y < height {
        var x: usize = 0
        while x < xmax {
            let inside: bool = x >= vx && x < vx + vw && y >= vy
            && y < vy + vh
            if !inside {
                if canvas.canvas_get(cv, x, y) != basic {
                    n = n + 1
                }
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

// THE TREE OF THE COUNTER-CHECK. Only the pane box with its rows,
// nothing else -- so that the count above can run over the WHOLE canvas
// without bars and cards disturbing it. It is drawn
// twice: once with its viewport (then no point may stand
// outside) and once after the viewport has been taken from it
// (then points MUST stand there, otherwise the first
// measurement would be zero only because nobody paints across the edge).
fn build_list(sc: *mut scene.Scene, v: *mut viewport.Viewport, field: u64,
    k_list: u32, k_line: u32, k_even: u32) -> usize {
    let frame_box: usize = scene.scene_add(sc, scene.SCENE_NONE,
        scene.N_VIEWPORT)
    scene.node_add_class(sc, frame_box, k_list)
    scene.node_set_viewport(sc, frame_box, v)
    scene.node_set_flex(sc, frame_box, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    scene.node_set_padding(sc, frame_box, 8, 8, 8, 8)
    scene.node_set_gap(sc, frame_box, LINE_GAP, 0)
    var z: usize = 0
    while z < LINES {
        let r: usize = scene.scene_add(sc, frame_box, scene.N_TEXT)
        scene.node_add_class(sc, r, k_line)
        if z % 2 == 0 {
            scene.node_add_class(sc, r, k_even)
        }
        scene.node_set_text(sc, r, field + (z * STEP) as u64, LINE_N)
        scene.node_set_size(sc, r, 0.0, LINE_H)
        z = z + 1
    }
    return frame_box
}

// A number from an argument. Whatever is not a digit ends it --
// the same short version as in tools/fui/belegpruef_main.fi.
fn number_of(p: u64) -> usize {
    var v: usize = 0
    var i: usize = 0
    while rt.ld8(p, i) >= 48 as u8 && rt.ld8(p, i) <= 57 as u8 {
        v = v * 10 + (rt.ld8(p, i) - 48 as u8) as usize
        i = i + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 57] = "gallery9_main <out.png> [light|dark] [font.ttf] [breite]\n"
        rt.write_everything(2, (&u[0]) as u64, 57)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    var dark: bool = true
    if rt.arg_count(start) >= 3 {
        if rt.ld8(rt.arg_ptr(start, 2), 0) == 108 as u8 {
            dark = false
        }
    }
    // ---- THE WIDTH. Fourth argument, default 1240. Narrower than
    // W_MIN is not possible: under this width less room would remain for the cards
    // on the right than their texts need, and the page
    // would no longer keep its own promise (section 7).
    var width: usize = W_STD
    if rt.arg_count(start) >= 5 {
        width = number_of(rt.arg_ptr(start, 4))
        if width < W_MIN {
            width = W_MIN
        }
    }

    // ---- THE FONT. Without it the picture would be a collection of
    // rectangles and would prove nothing.
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
    rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    if fm == 0 {
        var ks: [u8; 60] = "gallery9: keine Schrift gefunden -- ohne Schrift kein Beleg\n"
        rt.write_everything(2, (&ks[0]) as u64, 60)
        return 9
    }

    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, width, H) {
        return 4
    }
    // The raster buffer gets the WHOLE canvas. Here there once stood
    // a 560 -- a height that happened to suffice as long as nothing
    // below it was painted with soft edges. A second number
    // for the same thing is exactly the kind of error that stays silent
    // until someone changes H.
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, width, H) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(dark)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque((*f).base))

    // ---- THE TEXTS AND THE NAMES OF THE CLASSES
    //
    // A class name is a NUMBER (sheet.sheet_name), formed from
    // the string -- exactly like `class="karte"` on the web, except that
    // the name is translated once here and afterwards is a comparison of
    // two numbers.
    let texts: u64 = rt.heap_alloc(640)
    let field: u64 = rt.heap_alloc(LINES * STEP)
    if texts == 0 || field == 0 {
        return 3
    }
    write_texts(texts)
    write_lines(field)
    var nleiste: [u8; 6] = "leiste"
    var ntitel: [u8; 5] = "titel"
    var nkarte: [u8; 5] = "karte"
    var nueber: [u8; 5] = "ueber"
    var nnotiz: [u8; 5] = "notiz"
    var nliste: [u8; 5] = "liste"
    var nzeile: [u8; 5] = "zeile"
    var ngerade: [u8; 6] = "gerade"
    var nakzent: [u8; 6] = "akzent"
    let k_bar: u32 = sheet.sheet_name((&nleiste[0]) as u64, 6)
    let k_titel: u32 = sheet.sheet_name((&ntitel[0]) as u64, 5)
    let k_karte: u32 = sheet.sheet_name((&nkarte[0]) as u64, 5)
    let k_over: u32 = sheet.sheet_name((&nueber[0]) as u64, 5)
    let k_notiz: u32 = sheet.sheet_name((&nnotiz[0]) as u64, 5)
    let k_list: u32 = sheet.sheet_name((&nliste[0]) as u64, 5)
    let k_line: u32 = sheet.sheet_name((&nzeile[0]) as u64, 5)
    let k_even: u32 = sheet.sheet_name((&ngerade[0]) as u64, 6)
    let k_accent: u32 = sheet.sheet_name((&nakzent[0]) as u64, 6)

    // ---- THE PANE BOX. It gets its size when arranging
    // from the tree; what it already knows here is its CONTENT -- and that is
    // twice as high as the viewport.
    var v: viewport.Viewport = viewport.viewport_new(0.0, 0.0, LIST_W,
        400.0, CONTENT_W, CONTENT_H)
    viewport.viewport_set_bar(&v, BAR)
    viewport.viewport_set_inset(&v, PADDING)
    viewport.viewport_set_offset(&v, 0.0, ROLL_Y)

    var sh: sheet.Sheet = sheet.sheet_new()
    // THE COLOUR OF THE VIEWPORT BACKGROUND. It is the track colour of the
    // scrollbar (TOK_SURFACE, that is how render.def_bg gives it to it), shifted by
    // half towards the main text. Thereby it carries in
    // both themes the 3:1 from WCAG 1.4.11, without a
    // second colour table arising here: it is calculated with theme.mix,
    // checked in section 9.
    let spurfarbe: u32 = theme.color_from_token(&m, style.TOK_SURFACE)
    let schieberfarbe: u32 = theme.color_from_token(&m, style.TOK_BUTTON)
    let basic_list: u32 = theme.mix(spurfarbe,
        theme.color_from_token(&m, style.TOK_TEXT), 500)
    build_leaf(&sh, k_bar, k_titel, k_karte, k_over, k_notiz,
        k_list, k_line, k_even, k_accent,
        style.color_literal(basic_list))
    var sc: scene.Scene = scene.scene_new()
    let frame_box: usize = build_tree(&sc, &v, field, k_bar, k_titel,
        k_karte, k_over, k_notiz, k_list, k_line, k_even,
        k_accent, texts)
    // How many names are missing BEFORE the page is described -- the
    // number with which section 10 shows that the check really finds the
    // gap.
    var ax: a11y.A11y = a11y.a11y_new()
    let fehlte: usize = a11y.a11y_unnamed(&sc, &ax)
    beschreibe_barrierefrei(&ax, &sc, frame_box, texts)

    // ---- DIE VIER DURCHGAENGE, IN IHRER REIHENFOLGE
    scene.scene_style(&sc, &sh)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 0.0, 0.0, width as f64, H as f64)
    scene.scene_draw(&sc, &c)

    // ==================================================================
    // WHAT THE PICTURE MUST PROVE
    // ==================================================================
    let vx: f64 = viewport.viewport_x(&v)
    let vy: f64 = viewport.viewport_y(&v)
    let vw: f64 = viewport.viewport_w(&v)
    let vh: f64 = viewport.viewport_h(&v)
    let basic: u32 = canvas.canvas_get(&cv, 2, 2)

    var q0: [u8; 44] = "1 keine Groesse driftet beim Zeichnen       "
    request((&q0[0]) as u64, 43, scene.scene_size_drift(&sc) == 0,
        scene.scene_size_drift(&sc) as i64, 0)
    // AND THE TREE IS COMPLETE. `scene_add` returns
    // SCENE_NONE when the tree is full, and nobody who creates seventy nodes in loops
    // looks at exactly this return value.
    // `scene_overflow_reason` sums up all four limits in ONE number;
    // if it is not zero, something is missing in the picture, and then this
    // program must not deliver a proof that claims the opposite.
    var q0b: [u8; 44] = "1 der Baum ist vollstaendig (Grund 0)       "
    request((&q0b[0]) as u64, 43,
        scene.scene_overflow_reason(&sc) == scene.OF_NONE,
        scene.scene_overflow_reason(&sc) as i64, 0)
    // The viewport stands where the flexbox has put it: the
    // body begins under two bars of 56 points each and two
    // gaps of 16, so at 24 + 56 + 16 + 56 + 16 = 168, and is
    // 720 - 168 - 24 = 528 high.
    var q1: [u8; 44] = "1 der Ausschnitt beginnt bei y = 168        "
    request((&q1[0]) as u64, 43, (vy as i64) == 168, vy as i64, 168)
    var q2: [u8; 43] = "1 und ist 528 hoch                         "
    request((&q2[0]) as u64, 43, (vh as i64) == 528, vh as i64, 528)

    // ---- 2. THE CUTTING OFF, MEASURED OVER THE WHOLE CANVAS
    //
    // The area in which NO point of the list may stand is read off the
    // arranged tree and not guessed: below the
    // toolbar (whose bottom edge the tree knows) and left of
    // the cards (whose left edge it likewise knows). In it lie
    // the gap above the viewport, the margin under it AND the
    // narrow strips left and right of it -- every single row
    // and column is looked at. Without a clip there would stand here 217 points of
    // list at the top and the overhang at the bottom.
    let root: usize = scene.scene_root(&sc)
    let bar_i: usize = scene.scene_child_at(&sc, root, 1)
    let unterkante: usize = (scene.node_y(&sc, bar_i)
        +scene.node_h(&sc, bar_i)) as usize
    let body_i: usize = scene.scene_child_at(&sc, root, 2)
    let right_i: usize = scene.scene_child_at(&sc, body_i, 1)
    let maps_x: usize = scene.node_x(&sc, right_i) as usize
    let outside: usize = foreign(&cv, maps_x, unterkante, H, vx as usize,
        vy as usize, vw as usize, vh as usize, basic)
    var q3: [u8; 44] = "2 neben dem Ausschnitt kein fremder Punkt   "
    request((&q3[0]) as u64, 43, outside == 0, outside as i64, 0)
    var q4: [u8; 43] = "2 der Bereich reicht bis unter die Leiste  "
    request((&q4[0]) as u64, 43, unterkante == 152 && maps_x > 0,
        unterkante as i64, 152)
    // And so that this does not turn green because nothing at all
    // was painted: IN the viewport there stand over 100000 points that do not have the
    // colour of the sheet.
    let inside: usize = points(&cv, (vx + 2.0) as usize,
        (vx + vw - 2.0) as usize, (vy + 2.0) as usize,
        (vy + vh - 2.0) as usize, basic)
    var q5: [u8; 43] = "2 im Ausschnitt ist wirklich gemalt        "
    request((&q5[0]) as u64, 43, inside > 100000, inside as i64, 100000)

    // ---- 2c. THE PADDING OF THE VIEWPORT
    //
    // The cut lies PADDING points inside the box. So the
    // strip between box edge and cut edge must carry everywhere
    // the colour of the box background -- at the top and bottom, across the
    // whole width between the roundings. If even ONE foreign point is found there,
    // either the padding is not effective or
    // a row runs into it, and the cut-off in the picture would again
    // not be recognisable as intended.
    // Read off at the MIDDLE of the top edge, not in the corner:
    // the box is rounded (radius 12), in the corner therefore stands the
    // sheet and not its background.
    let box_basic: u32 = canvas.canvas_get(&cv,
        (vx + vw / 2.0) as usize, (vy + 3.0) as usize)
    let x_von: usize = (vx + 14.0) as usize
    let x_bis: usize = (vx + vw - (BAR as f64) - 14.0) as usize
    let top: usize = points(&cv, x_von, x_bis, (vy + 2.0) as usize,
        (vy + PADDING - 1.0) as usize, box_basic)
    var q2a: [u8; 44] = "2c oben nur Kastengrund bis zum Schnitt     "
    request((&q2a[0]) as u64, 43, top == 0, top as i64, 0)
    let below: usize = points(&cv, x_von, x_bis,
        (vy + vh - PADDING + 1.0) as usize, (vy + vh - 2.0) as usize,
        box_basic)
    var q2b: [u8; 44] = "2c unten ebenso                             "
    request((&q2b[0]) as u64, 43, below == 0, below as i64, 0)
    // And the counter-check to the padding itself: JUST behind the
    // cut edge there stands content again. Otherwise the zero above
    // would be explained by there being nothing at all in this box.
    let equal_behind: usize = points(&cv, x_von, x_bis,
        (vy + PADDING + 1.0) as usize, (vy + PADDING + 12.0) as usize,
        box_basic)
    var q2c: [u8; 44] = "2c gleich hinter dem Schnitt steht Inhalt   "
    request((&q2c[0]) as u64, 43, equal_behind > 200,
        equal_behind as i64, 200)

    // ---- 2b. THE RED COUNTER-CHECK
    //
    // A count that reports 0 is a proof only when it
    // does NOT report 0 without a clip. That is why the same
    // content stands here once more: a tree that consists ONLY of the pane box and
    // its 28 rows, on a canvas of its own, at
    // the same place and with the same scroll position. It is drawn twice
    // -- once with the viewport (no point may go out) and
    // once after the viewport has been taken from it, so entirely without
    // viewport_begin/viewport_end (then points MUST run out).
    // If the second number stays at zero, the clipping is not the
    // cause of the first at all, and this program reports it red.
    //
    // FOR THAT THE SAME ZERO MEASUREMENT RUNS TWICE, not two different ones:
    // first "no point outside" with a clip (it must pass), then
    // word for word without a clip (it MUST fail, and its failure is printed
    // as RED-OK). A log in which only the passed
    // version stands does not prove that the measurement can measure anything at all.
    var cv2: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv2, width, H) {
        return 4
    }
    var z2: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z2, &cv2, width, H) {
        return 5
    }
    painter.painter_set_font(&z2, fm)
    var c2: render.Ctx = render.ctx_new(&m, &z2)
    var v2: viewport.Viewport = viewport.viewport_new(vx, vy, vw, vh,
        CONTENT_W, CONTENT_H)
    viewport.viewport_set_bar(&v2, BAR)
    viewport.viewport_set_inset(&v2, PADDING)
    viewport.viewport_set_offset(&v2, 0.0, ROLL_Y)
    var sc2: scene.Scene = scene.scene_new()
    let box2: usize = build_list(&sc2, &v2, field, k_list, k_line,
        k_even)
    scene.scene_style(&sc2, &sh)
    scene.scene_measure(&sc2, &c2)
    scene.scene_layout(&sc2, &c2, vx, vy, vw, vh)
    canvas.canvas_clear(&cv2, theme.opaque((*f).base))
    scene.scene_draw(&sc2, &c2)
    let mit_clip: usize = foreign(&cv2, width, 0, H, vx as usize,
        vy as usize, vw as usize, vh as usize, basic)
    var q3b: [u8; 44] = "2 allein: mit Clip bleibt alles im Kasten   "
    request((&q3b[0]) as u64, 43, mit_clip == 0, mit_clip as i64, 0)
    scene.node_set_viewport(&sc2, box2, (0 as u64)
        as *mut viewport.Viewport)
    canvas.canvas_clear(&cv2, theme.opaque((*f).base))
    scene.scene_draw(&sc2, &c2)
    let without_clip: usize = foreign(&cv2, width, 0, H, vx as usize,
        vy as usize, vw as usize, vh as usize, basic)
    var q3c: [u8; 43] = "2 ohne Clip laufen Punkte hinaus (>20000)  "
    request((&q3c[0]) as u64, 43, without_clip > 20000, without_clip as i64,
        20000)
    // AND THE SAME ZERO MEASUREMENT ONCE MORE, WORD FOR WORD THE SAME AS ABOVE --
    // only without a viewport. It MUST fail, and its failure stands
    // as RED-OK in the log: only with that is it proven that the zero in
    // "with a clip everything stays in the box" does not come from this
    // count looking at nothing at all.
    var q3d: [u8; 43] = "2 allein: dieselbe Messung ohne Clip (ROT) "
    request_red((&q3d[0]) as u64, 43, without_clip == 0, without_clip as i64, 0)
    painter.painter_free(&z2)
    canvas.canvas_free(&cv2)

    // ---- 3. THE LENGTH OF THE THUMB, READ OFF THE CANVAS
    //
    // The share is 528/1130. The track is as long as the viewport
    // (528), of which 2 points of padding each at the top and bottom are subtracted: 524.
    // 524 * 528/1130 = 244.8 -- so roughly 245 points of thumb. The
    // calculation for it stands in ONE place (wave2.scrollbar_thumb), and
    // exactly that is held against the picture here.
    var bx: f64 = 0.0
    var by: f64 = 0.0
    var bw: f64 = 0.0
    var bh: f64 = 0.0
    let hat: bool = viewport.viewport_bar_rect_v(&v, &bx, &by, &bw, &bh)
    var e: widget.Widget = widget.widget_new(widget.KIND_SCROLLBAR)
    widget.w_place(&e, bx, by, bw, bh)
    widget.w_set_pref(&e, 0.0,
        viewport.viewport_share_v(&v) * (wave2.VAL_MAX as f64))
    widget.w_set_value(&e, viewport.viewport_value_v(&v))
    var tr: layout.Rect = wave2.scrollbar_thumb(&c, &e)
    var q6: [u8; 43] = "3 der senkrechte Balken ist da             "
    request((&q6[0]) as u64, 43, hat && (bh as i64) == 528, bh as i64,
        528)
    var q7: [u8; 43] = "3 wave2.scrollbar_thumb sagt 245           "
    request((&q7[0]) as u64, 43, layout.rect_h(&tr) == 245,
        layout.rect_h(&tr), 245)
    // And the same length on the picture: in the middle of the track the
    // thumb is the only long piece that deviates from the track
    // colour.
    let sx: usize = (bx + bw / 2.0) as usize
    let trace: u32 = canvas.canvas_get(&cv, sx, (by + 1.0) as usize)
    var length: usize = 0
    var run: usize = 0
    var yy: usize = by as usize
    while yy < (by + bh) as usize {
        if canvas.canvas_get(&cv, sx, yy) != trace {
            run = run + 1
            if run > length {
                length = run
            }
        } else {
            run = 0
        }
        yy = yy + 1
    }
    var q8: [u8; 43] = "3 Schieberlaenge auf der Leinwand 243..247 "
    request((&q8[0]) as u64, 43, length >= 243 && length <= 247,
        length as i64, 245)

    // ---- 4. THE PRECEDENCE STANDS IN THE PICTURE
    //
    // The highlighted row carries the id (rank 10000) and thereby
    // beats the class rule `zeile` (100) and the two
    // classes `zeile gerade` (200). What is asked is not the sheet,
    // but the node AFTER pass 1 -- that is, what was really
    // painted.
    let active: usize = scene.scene_find_id(&sc, ID_ACTIVE)
    let akz: u32 = style.color_token(style.TOK_ACCENT)
    var q9: [u8; 44] = "4 die Zeile mit Kennung traegt den Akzent   "
    request((&q9[0]) as u64, 43,
        active != scene.SCENE_NONE
        && (*scene.node_style(&sc, active)).bg == akz,
        (*scene.node_style(&sc, active)).bg as i64, akz as i64)
    // Its neighbour is an odd row: only the class rule.
    let nachbar: usize = scene.scene_child_at(&sc, frame_box, ACTIVE_NR)
    let tokf: u32 = style.color_token(style.TOK_SURFACE)
    var q10: [u8; 43] = "4 die Nachbarin traegt die Klassenregel    "
    request((&q10[0]) as u64, 43,
        (*scene.node_style(&sc, nachbar)).bg == tokf,
        (*scene.node_style(&sc, nachbar)).bg as i64, tokf as i64)
    // And the even row above it the rule with TWO classes. The
    // highlighted row incidentally carries `gerade` TOO -- exactly
    // that is why it is the proof: 10000 beats 200.
    let even: usize = scene.scene_child_at(&sc, frame_box, ACTIVE_NR - 3)
    let tokg: u32 = style.color_token(style.TOK_FIELD)
    var q11: [u8; 43] = "4 die gerade Zeile die Zwei-Klassen-Regel  "
    request((&q11[0]) as u64, 43,
        (*scene.node_style(&sc, even)).bg == tokg,
        (*scene.node_style(&sc, even)).bg as i64, tokg as i64)
    // INHERITANCE and its limit: the row has inherited the font size
    // of the viewport (13), but not its background.
    var q12: [u8; 43] = "5 die Zeile erbt die Schriftgroesse 13     "
    request((&q12[0]) as u64, 43,
        (*scene.node_style(&sc, nachbar)).font_px == 13,
        (*scene.node_style(&sc, nachbar)).font_px as i64, 13)

    // ---- 6. THE HIT TEST UNDER OFFSET
    //
    // With an offset of 217 the first fully visible
    // row no longer stands at the top. A point just below the top edge of the
    // viewport therefore does NOT hit the first row -- and a point
    // in the gap above the viewport hits none at all.
    let hit: usize = scene.scene_hit(&sc, vx + 40.0, vy + 4.0)
    let first: usize = scene.scene_child_at(&sc, frame_box, 0)
    var q13: [u8; 43] = "6 oben trifft nicht mehr die erste Zeile   "
    request((&q13[0]) as u64, 43, hit != first,
        hit as i64, first as i64)
    let daneben: usize = scene.scene_hit(&sc, vx + 40.0, vy - 6.0)
    var q14: [u8; 43] = "6 in der Luecke trifft keine Zeile         "
    request((&q14[0]) as u64, 43,
        daneben == scene.SCENE_NONE
        || scene.node_has_class(&sc, daneben, k_line) == false,
        (daneben == scene.SCENE_NONE) as i64, 0)

    // ---- 7. NO TEXT RUNS OUT OF ITS BOX
    //
    // For EVERY node the preferred width from render.pref_of is held against
    // the arranged width. A node whose text is wider
    // than its box would be noticed here -- and not only by whoever
    // looks at the picture.
    var too_wide: usize = 0
    var k: usize = 0
    while k < scene.scene_count(&sc) {
        if scene.node_kind(&sc, k) == scene.N_TEXT
        || scene.node_kind(&sc, k) == scene.N_WIDGET {
            var pw: f64 = 0.0
            var ph: f64 = 0.0
            render.pref_of(&c, scene.node_widget(&sc, k), &pw, &ph)
            if pw > scene.node_w(&sc, k) + 0.5 {
                too_wide = too_wide + 1
            }
        }
        k = k + 1
    }
    var q15: [u8; 43] = "7 kein Knoten ist zu schmal fuer den Text  "
    request((&q15[0]) as u64, 43, too_wide == 0, too_wide as i64, 0)

    // ---- 8. READABLE IN LIGHT AND DARK
    //
    // The text of the card against its background, in hundredths: 4.5:1 is
    // the threshold from tools/fui/contrast_main.fi.
    let tf: u32 = theme.opaque(theme.color_from_token(&m, style.TOK_TEXT))
    let tg: u32 = theme.opaque(theme.color_from_token(&m,
            style.TOK_SURFACE_RAISED))
    let kk: i64 = (theme.contrast(tf, tg) * 100.0 + 0.5) as i64
    var q16: [u8; 43] = "8 Karte: Text gegen Grund 4.5:1            "
    request((&q16[0]) as u64, 43, kk >= 450, kk, 450)

    // ---- 9. THE SCROLLBAR STANDS OUT FROM THE VIEWPORT
    //
    // Section 8 measures the TEXT against its background and demands 4.5:1.
    // A scrollbar is no text, but a CONTROL, and
    // for that WCAG 1.4.11 sets the threshold 3:1 -- calculated with
    // the same function (theme.contrast) and against the same kind of background.
    //
    // It is measured TWICE: once on the colours that the theme
    // issues (the track gets TOK_SURFACE from render.def_bg, the
    // thumb TOK_BUTTON from wave2.draw_scrollbar), and once on the
    // pixels that really stand in the proof -- a point from the
    // track, one from the thumb and one from the viewport background
    // right next to it. The second measurement is the more important one: it also fails
    // when someone later colours the background again through a rule.
    let kspur: i64 = (theme.contrast(theme.opaque(spurfarbe),
            theme.opaque(basic_list)) * 100.0 + 0.5) as i64
    var q17: [u8; 43] = "9 Spur gegen Ausschnittgrund 3:1           "
    request((&q17[0]) as u64, 43, kspur >= 300, kspur, 300)
    let kschieber: i64 = (theme.contrast(theme.opaque(schieberfarbe),
            theme.opaque(basic_list)) * 100.0 + 0.5) as i64
    var q18: [u8; 43] = "9 Schieber gegen Ausschnittgrund 3:1       "
    request((&q18[0]) as u64, 43, kschieber >= 300, kschieber, 300)
    // And the same on the canvas. `spur` already stands above: the point
    // in the middle of the track, just under its top edge, where the
    // thumb does not yet lie at this scroll position. The background
    // next to it lies four points left of the bar -- where the
    // inner margin of the viewport stands and no row reaches.
    let grundpunkt: u32 = canvas.canvas_get(&cv, (bx - 4.0) as usize,
        (by + bh / 2.0) as usize)
    let schieberpunkt: u32 = canvas.canvas_get(&cv, sx,
        (by + bh / 2.0) as usize)
    let kbild: i64 = (theme.contrast(trace, grundpunkt) * 100.0
        +0.5) as i64
    var q19: [u8; 43] = "9 im Bild: Spur gegen Grund 3:1            "
    request((&q19[0]) as u64, 43, kbild >= 300, kbild, 300)
    let kbild2: i64 = (theme.contrast(schieberpunkt, grundpunkt) * 100.0
        +0.5) as i64
    var q20: [u8; 43] = "9 im Bild: Schieber gegen Grund 3:1        "
    request((&q20[0]) as u64, 43, kbild2 >= 300, kbild2, 300)

    // ---- 10. EVERY CONTROL HAS A ROLE AND A NAME
    //
    // Counted by hand: 56 nodes (root, header row with title and 3
    // buttons = 5, toolbar with 5 = 6, body, viewport with 28
    // rows = 29, right column, card 1 with heading and 4 rows =
    // 6, card 2 with heading and 5 elements = 7; 1+5+6+1+29+1+6+7).
    // Operable are 12: 3 buttons at the top, 4 buttons and the search field in
    // the bar, tick, switch, dot and thumb. The progress bar
    // is none -- you see it, you do not operate it.
    var rollen: usize = 0
    var rk: usize = 0
    while rk < scene.scene_count(&sc) {
        if a11y.a11y_role(&sc, &ax, rk) != a11y.ROLE_NONE {
            rollen = rollen + 1
        }
        rk = rk + 1
    }
    var q21: [u8; 43] = "10 alle 56 Knoten haben eine Rolle         "
    request((&q21[0]) as u64, 43,
        rollen == 56 && scene.scene_count(&sc) == 56, rollen as i64, 56)
    let bedienbar: usize = a11y.a11y_widgets(&sc, &ax)
    var q22: [u8; 43] = "10 bedienbar sind 12                       "
    request((&q22[0]) as u64, 43, bedienbar == 12, bedienbar as i64, 12)
    let named: usize = bedienbar - a11y.a11y_unnamed(&sc, &ax)
    var q23: [u8; 43] = "10 alle 12 haben Rolle und Namen           "
    request((&q23[0]) as u64, 43, named == 12, named as i64, 12)
    var q24: [u8; 43] = "10 vorher fehlte 1 Name (das Suchfeld)     "
    request((&q24[0]) as u64, 43, fehlte == 1, fehlte as i64, 1)
    let such_i: usize = scene.scene_child_at(&sc, bar_i, 3)
    var q25: [u8; 43] = "10 das Suchfeld heisst jetzt ausdr. (1)    "
    request((&q25[0]) as u64, 43,
        a11y.a11y_name_source(&sc, &ax, such_i) == a11y.NAME_EXPLICIT,
        a11y.a11y_name_source(&sc, &ax, such_i) as i64, 1)
    let tabs: usize = a11y.a11y_order(&sc, &ax)
    var q26: [u8; 43] = "10 alle 12 stehen in der Tab-Reihenfolge   "
    request((&q26[0]) as u64, 43, tabs == 12, tabs as i64, 12)
    var q27: [u8; 43] = "10 Zeile 11 ist Eintrag 11 von 28          "
    request((&q27[0]) as u64, 43,
        a11y.a11y_pos(&sc, &ax, active) == 11
        && a11y.a11y_set_size(&sc, &ax, active) == 28,
        a11y.a11y_pos(&sc, &ax, active) as i64, 11)
    // The whole tree as text, if a sixth argument names a file.
    // So beside the picture lies what a screen reader would learn about
    // the same page.
    if rt.arg_count(start) >= 6 {
        let dcap: usize = 16384
        let dbuf: u64 = rt.heap_alloc(dcap)
        if dbuf == 0 {
            return 3
        }
        let dn: usize = a11y.a11y_dump(&sc, &ax, dbuf, dcap)
        var q28: [u8; 43] = "10 Baum als Text: Bytes, hoechstens 16384  "
        request((&q28[0]) as u64, 43, dn <= dcap, dn as i64, 16384)
        if dn <= dcap {
            if !rt.write_file(rt.arg_ptr(start, 5), dbuf, dn) {
                return 7
            }
        }
    }

    if G_ERROR > 0 {
        var gf: [u8; 62] = "gallery9: die Seite haelt ihre Zusage nicht -- kein Beleg\n\0\0\0\0"
        rt.write_everything(2, (&gf[0]) as u64, 58)
        return 10
    }

    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&cv, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var pk: usize = 0
    while pk < rt.c_length(path) {
        rt.buf_push(&pf, rt.ld8(path, pk))
        pk = pk + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 10] = "GALLERY 9\n"
    rt.write_everything(1, (&okm[0]) as u64, 10)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    return 0
}
