// SPDX-License-Identifier: MPL-2.0
// tools/fui/gallery9_main.fi -- DIE BESCHRIEBENE OBERFLAECHE ALS BILD.
//
// ===================================================== WARUM ES DAS GIBT
//
// lib/fui/scene.fi, lib/fui/sheet.fi und lib/fui/viewport.fi haben
// jedes seine eigene Pruefung mit nachgerechneten Zahlen. Was keine
// dieser Pruefungen zeigt, ist das, worum es bei der Beschreibung
// ueberhaupt geht: dass am Ende eine OBERFLAECHE dasteht, die aussieht
// wie eine Anwendung -- und dass ihr Quelltext kuerzer ist als
// derselbe Bildschirm, Aufruf fuer Aufruf gemalt.
//
// Also steht hier eine ganze Seite, und zwar so, wie ein Anwender sie
// schreiben wuerde: ein BAUM (`baue_baum`) und ein STILBLATT
// (`baue_blatt`). Keine Koordinate wird in diesem Blatt von Hand
// gerechnet -- kein x, kein y, keine Zeilenhoehe. Das tun flex.fi
// (ueber scene.fi) und das Stilblatt.
//
// =============================================== WAS DAS BILD BELEGT
//
//   1. DER SCHEIBENKASTEN TRAEGT MEHR, ALS ER HOCH IST. Links steht
//      eine Liste aus 28 Eintraegen in einem Ausschnitt von 528
//      Punkten Hoehe auf 1130 Punkten Inhalt. Die Rollposition steht
//      absichtlich MITTEN in einer Zeile (217), damit man das
//      Abschneiden oben und unten SIEHT.
//   2. DAS ABSCHNEIDEN WIRD GEMESSEN, nicht behauptet, und zwar ueber
//      die GANZE Leinwand: jeder Punkt unterhalb der Werkzeugleiste
//      und links von den Karten, der nicht im Ausschnitt liegt, muss
//      die Farbe des Blattes tragen -- die Luecke darueber, der Rand
//      darunter und die schmalen Streifen daneben. Ohne Clip lagen
//      dort 217 Punkte Liste ueber der Werkzeugleiste und der Rest
//      unter dem Ausschnitt. Die ROTE GEGENPROBE steht hier: derselbe
//      Scheibenkasten wird auf einer zweiten Leinwand noch einmal
//      gezeichnet, einmal mit und einmal ohne seinen Ausschnitt; ohne
//      ihn muessen ueber 20000 Punkte hinauslaufen, sonst meldet
//      dieses Programm sich rot und schreibt kein Bild.
//   3. DIE LAENGE DES SCHIEBERS kommt aus dem Verhaeltnis
//      Ausschnitt/Inhalt und wird von der LEINWAND abgelesen.
//   4. DIE RANGFOLGE DES STILBLATTES steht im Bild: alle Zeilen tragen
//      die Klassenregel `zeile`, jede zweite zusaetzlich `gerade`
//      (zwei Klassen, Rang 200), und GENAU EINE traegt eine Kennung
//      (Rang 10000) und ist darum die hervorgehobene. Wer die
//      Rangfolge umdreht, sieht es sofort: dann ist entweder keine
//      Zeile hervorgehoben oder alle.
//   5. VERERBUNG: Schriftfamilie, -groesse und Textfarbe stehen EINMAL
//      an der Karte bzw. am Ausschnitt und kommen bei den Kindern an.
//      Der Grund der Karte kommt dort NICHT an -- sonst waere jede
//      Zeile ein zweiter Kasten.
//   6. KEIN TEXT LAEUFT AUS SEINEM KASTEN: fuer JEDEN Knoten des Baums
//      wird die Wunschbreite aus render.pref_of gegen die angeordnete
//      Breite gerechnet.
//
// ========================================== DIE ERSPARNIS IN ZEILEN
//
// Verglichen wird, was sich WIRKLICH vergleichen laesst: DASSELBE
// Stueck Oberflaeche, einmal Aufruf fuer Aufruf gemalt und einmal
// beschrieben. Das Stueck ist die Werkzeugleiste -- drei Knoepfe, ein
// Suchfeld, das den Rest nimmt, ein Knopf im Akzent:
//
//     demos/fuidemo/main.fi, fn werkzeugleiste_gemalt 57 Zeilen
//     hier, die Marken WERKZEUGLEISTE (der Baum)      23 Zeilen
//       + die Marken LEISTENREGELN (ihr Aussehen)     19 Zeilen
//                                                    -----------
//                                                     42 Zeilen
//
// Gezaehlt werden Zeilen mit Code, ohne Kommentar und ohne Leerzeilen.
// DER ZUSCHNITT IST ABSICHTLICH UNBEQUEM: die beiden Helfer `setze` und
// `item_von_widget` aus fuidemo sind NICHT mitgezaehlt (sie werden von
// `titelzeile` und `dialog` ebenfalls gerufen, sind also geteilt), und
// umgekehrt zaehlt die beschriebene Seite ihr ganzes Aussehen mit --
// auch die Regel fuer die Klasse `leiste`, die zugleich die Kopfzeile
// einfaerbt. Wer geteilte Zeilen nur auf einer Seite zaehlt, rechnet
// sich die Ersparnis schoen.
//
// tools/fui/run.sh (Abschnitt 19c) zaehlt beide Seiten selbst nach, in
// drei Zuschnitten, und bricht ab, wenn eine Grenze bricht:
//
//     roh                            57  gegen  42   (74 %)
//     ohne die Beschriftungen        47  gegen  40   (85 %)
//     ohne Beschriftung und Aussehen 39  gegen  21   (54 %)
//
// Die dritte Zeile ist die eigentliche Aussage: was an der gemalten
// Fassung Arbeit macht, ist die GLIEDERUNG -- fuenf FlexItems, ein
// Rechteck, ein Rahmen, eine eigene Verteilschleife und das Setzen
// jedes Rechtecks von Hand. Das faellt in der Beschreibung ganz weg.
// Das Aussehen dagegen kostet in einem Stilblatt etwa dasselbe wie im
// Malen -- mit dem Unterschied, dass es EINMAL fuer die ganze Seite
// dasteht und nicht je Stelle.
//
// Die ganze Seite hier (baue_blatt + baue_baum, 223 Zeilen Code) ist
// NICHT kuerzer als die Oberflaeche von demos/fuidemo (191 Zeilen:
// titelzeile, werkzeugleiste, dialog, quellenkarte und die drei
// Helfer label/item_von_widget/setze, ohne das Phasenband) -- sie
// traegt aber auch eine rollende Liste aus 28 Zeilen mit Zebrastreifen,
// zwei Karten und fuenf Bedienelemente mehr. Eine ehrliche Zahl ist
// besser als eine schmeichelhafte.
//
// Die Breite ist das VIERTE Argument (Vorgabe 1240, mindestens 900):
// dieselbe Beschreibung traegt zwei Leinwandbreiten, und der Lauf malt
// beide.
//
//     gallery9_main <out.png> [light|dark] [<font.ttf>] [<breite>]
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.layout
import fui.flex
import fui.render
import fui.viewport
import fui.sheet
import fui.scene
import fui.wave2

const FONTSET_BYTES: usize = 4096
// DIE LEINWAND. Die Breite kommt als viertes Argument herein (Vorgabe
// 1240), damit dieselbe Seite in zwei Breiten entsteht: eine
// beschriebene Oberflaeche, die nur bei EINER Breite steht, ist keine
// Beschreibung, sondern eine Zeichnung mit Umweg. Alle Zahlen dieses
// Blattes gelten fuer jede Breite -- gerechnet wird sie von flex.fi.
const W_STD: usize = 1240
const W_MIN: usize = 900
const H: usize = 720

// Das Blatt: Rand, Luecke, und die beiden Leisten oben. Aus diesen vier
// Zahlen folgt jede andere -- gerechnet wird sie von flex.fi.
const RAND: i64 = 24
const LUECKE: i64 = 16
const LEISTE_H: f64 = 56.0

// Die Liste: 28 Eintraege zu 34 Punkten, Luecke 6, Innenrand 8. Der
// Inhalt ist damit 8 + 28*34 + 27*6 + 8 = 1130 Punkte hoch, der
// Ausschnitt 528 -- also rollt er.
const ZEILEN: usize = 28
const ZEILE_H: f64 = 34.0
const ZEILE_LUECKE: i64 = 6
const LISTE_W: f64 = 520.0
const BALKEN: usize = 12
const INHALT_W: f64 = 508.0
const INHALT_H: f64 = 1130.0
// Die Verschiebung steht MITTEN in einer Zeile: so ist oben und unten
// eine angeschnittene Zeile zu sehen, und das Abschneiden ist im Bild
// und nicht nur in der Zahl.
const ROLL_Y: f64 = 217.0
// Die Kennung der einen hervorgehobenen Zeile. Sie ist die 11. -- eine,
// die bei dieser Rollposition wirklich zu sehen ist.
const ID_AKTIV: u32 = 4711 as u32
const AKTIV_NR: usize = 11
// Jeder Eintrag steht in einem Feld fester Laenge; so bleibt der Text
// gueltig, bis das Bild geschrieben ist.
const SCHRITT: usize = 40
const ZEILE_N: usize = 37

static mut G_FEHLER: usize = 0

// Eine Forderung an das eigene Bild. Wird sie verletzt, geht die
// Meldung auf fd 2 und das Programm endet mit einem Fehler -- ein
// Beleg, der seine eigene Aussage nicht erfuellt, wird gar nicht erst
// geschrieben.
fn fordere(nm: u64, nn: usize, ok: bool, ist: i64, soll: i64) {
    var t: rt.Buf = rt.buf_new()
    var p1: [u8; 11] = "gallery9:  "
    rt.buf_push_bytes(&t, (&p1[0]) as u64, 10)
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 44 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_FEHLER = G_FEHLER + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, ist)
    var w2: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&w2[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, soll)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn kopiere(dst: u64, off: usize, src: u64, n: usize) -> usize {
    var i: usize = 0
    while i < n {
        rt.st8(dst, off + i, rt.ld8(src, i))
        i = i + 1
    }
    return off + n
}

// Die Beschriftungen der Liste, in EIN Feld geschrieben: "Eintrag 07 --
// Zeile im Scheibenkasten". Sie muessen den ganzen Lauf ueber gueltig
// bleiben, denn ein Knoten haelt nur den ZEIGER auf seinen Text -- wie
// jedes Widget dieser Bibliothek.
fn schreibe_zeilen(feld: u64) {
    var pre: [u8; 8] = "Eintrag "
    var suf: [u8; 27] = " -- Zeile im Scheibenkasten"
    var i: usize = 0
    while i < ZEILEN {
        let nr: usize = i + 1
        var off: usize = kopiere(feld, i * SCHRITT, (&pre[0]) as u64, 8)
        rt.st8(feld, off, (48 + nr / 10) as u8)
        rt.st8(feld, off + 1, (48 + nr % 10) as u8)
        off = kopiere(feld, off + 2, (&suf[0]) as u64, 27)
        i = i + 1
    }
}

// ======================================================================
// DAS STILBLATT
// ======================================================================
//
// Regeln, nichts als Regeln: Auswahl -> Stilwerte. Keine Regel nennt
// eine Koordinate, keine nennt einen Knoten beim Namen ausser der
// einen, die genau das zeigen soll (die Kennung der aktiven Zeile).
// Die Rangfolge rechnet sheet.sheet_resolve aus; hier steht sie nur da,
// und im Bild sieht man, dass sie stimmt.
fn regel(sh: *mut sheet.Sheet, s: sheet.Sel, d: sheet.Decl) {
    sheet.sheet_add(sh, s, d)
}

fn baue_blatt(sh: *mut sheet.Sheet, k_leiste: u32, k_titel: u32,
    k_karte: u32, k_ueber: u32, k_notiz: u32, k_liste: u32,
    k_zeile: u32, k_gerade: u32, k_akzent: u32) {
    // Die beiden Leisten und die Karten: gehobene Flaeche, ein Punkt
    // Rand, gerundet.
    //
    // DIE MARKEN SIND KEINE VERZIERUNG. tools/fui/run.sh (Abschnitt 19c)
    // zaehlt die Zeilen der beschriebenen Werkzeugleiste, und dazu
    // gehoert AUCH ihr Aussehen: die Flaeche der Leiste, der Radius
    // ihrer Knoepfe und der Akzent des letzten. Auf der gemalten Seite
    // steht genau das mitten in `fn werkzeugleiste_gemalt`, also muss es
    // hier mitgezaehlt werden -- auch die Regel fuer die Klasse
    // `leiste`, die zugleich die Kopfzeile einfaerbt. Wer geteilte
    // Zeilen nur auf einer Seite zaehlt, rechnet sich die Ersparnis
    // schoen.
    // >>> LEISTENREGELN
    var d1: sheet.Decl = sheet.decl_new()
    var s1: style.Style = style.style_new()
    s1 = style.style_set_bg(s1, style.color_token(style.TOK_SURFACE_RAISED))
    s1 = style.style_set_border(s1, style.color_token(style.TOK_BORDER), 1)
    s1 = style.style_set_radius(s1, 10)
    sheet.decl_set_style(&d1, s1)
    regel(sh, sheet.sel_class(k_leiste), d1)
    // <<< LEISTENREGELN
    var d2: sheet.Decl = sheet.decl_new()
    var s2: style.Style = s1
    s2 = style.style_set_radius(s2, 12)
    // Schrift und Textfarbe stehen EINMAL an der Karte -- ihre Kinder
    // erben sie (sheet.INHERIT_MASK), ihren Grund erben sie nicht.
    s2 = style.style_set_fg(s2, style.color_token(style.TOK_TEXT))
    s2 = style.style_set_font(s2, 0, 13)
    sheet.decl_set_style(&d2, s2)
    regel(sh, sheet.sel_class(k_karte), d2)
    // Der Ausschnitt: ruhige Flaeche, damit die Zeilen darauf stehen.
    var d3: sheet.Decl = sheet.decl_new()
    var s3: style.Style = style.style_new()
    s3 = style.style_set_bg(s3, style.color_token(style.TOK_TEXT_MUTED))
    s3 = style.style_set_border(s3, style.color_token(style.TOK_BORDER), 1)
    s3 = style.style_set_radius(s3, 12)
    s3 = style.style_set_fg(s3, style.color_token(style.TOK_TEXT))
    s3 = style.style_set_font(s3, 0, 13)
    sheet.decl_set_style(&d3, s3)
    regel(sh, sheet.sel_class(k_liste), d3)
    // Die Ueberschriften und die Fliesstexte.
    var d4: sheet.Decl = sheet.decl_new()
    var s4: style.Style = style.style_new()
    s4 = style.style_set_font(s4, 0, 17)
    s4 = style.style_set_fg(s4, style.color_token(style.TOK_TEXT))
    s4 = style.style_set_pad(s4, 0, 0)
    sheet.decl_set_style(&d4, s4)
    regel(sh, sheet.sel_class(k_titel), d4)
    var d5: sheet.Decl = sheet.decl_new()
    var s5: style.Style = style.style_new()
    s5 = style.style_set_font(s5, 0, 14)
    s5 = style.style_set_pad(s5, 0, 0)
    sheet.decl_set_style(&d5, s5)
    regel(sh, sheet.sel_class(k_ueber), d5)
    var d6: sheet.Decl = sheet.decl_new()
    var s6: style.Style = style.style_new()
    s6 = style.style_set_fg(s6, style.color_token(style.TOK_TEXT_MUTED))
    s6 = style.style_set_font(s6, 0, 12)
    s6 = style.style_set_pad(s6, 0, 0)
    sheet.decl_set_style(&d6, s6)
    regel(sh, sheet.sel_class(k_notiz), d6)
    // DIE DREI REGELN, AN DENEN DIE RANGFOLGE HAENGT. Sie widersprechen
    // sich mit Absicht: jede Zeile passt auf die erste, jede zweite
    // zusaetzlich auf die zweite, und genau eine auf die dritte.
    // Rang 100 < 200 < 10000 -- im Bild sind das drei Gruende.
    var d7: sheet.Decl = sheet.decl_new()
    var s7: style.Style = style.style_new()
    s7 = style.style_set_bg(s7, style.color_token(style.TOK_SURFACE))
    s7 = style.style_set_radius(s7, 8)
    s7 = style.style_set_pad(s7, 12, 0)
    sheet.decl_set_style(&d7, s7)
    regel(sh, sheet.sel_class(k_zeile), d7)
    var d8: sheet.Decl = sheet.decl_new()
    var s8: style.Style = style.style_new()
    s8 = style.style_set_bg(s8, style.color_token(style.TOK_FIELD))
    sheet.decl_set_style(&d8, s8)
    regel(sh, sheet.sel_with_class(sheet.sel_class(k_zeile), k_gerade), d8)
    var d9: sheet.Decl = sheet.decl_new()
    var s9: style.Style = style.style_new()
    s9 = style.style_set_bg(s9, style.color_token(style.TOK_ACCENT))
    s9 = style.style_set_fg(s9, style.color_token(style.TOK_TEXT_ON_ACCENT))
    sheet.decl_set_style(&d9, s9)
    regel(sh, sheet.sel_id(ID_AKTIV), d9)
    // Die Knoepfe -- nach der ART ausgewaehlt, nicht nach einer Klasse.
    // >>> LEISTENREGELN
    var d10: sheet.Decl = sheet.decl_new()
    var s10: style.Style = style.style_new()
    s10 = style.style_set_radius(s10, 8)
    sheet.decl_set_style(&d10, s10)
    regel(sh, sheet.sel_kind(widget.KIND_BUTTON), d10)
    var d11: sheet.Decl = sheet.decl_new()
    var s11: style.Style = style.style_new()
    s11 = style.style_set_bg(s11, style.color_token(style.TOK_ACCENT))
    s11 = style.style_set_fg(s11,
        style.color_token(style.TOK_TEXT_ON_ACCENT))
    sheet.decl_set_style(&d11, s11)
    regel(sh, sheet.sel_class(k_akzent), d11)
    // <<< LEISTENREGELN
}

// ======================================================================
// DER BAUM
// ======================================================================
//
// Er wird EINMAL gebaut. Was hier steht, ist die Gliederung der Seite
// und sonst nichts: Kopfzeile, Werkzeugleiste, darunter der Rumpf aus
// Liste und Karten. Die Zahlen sind Groessen und Luecken, keine
// Koordinaten.
fn baue_baum(sc: *mut scene.Scene, v: *mut viewport.Viewport, feld: u64,
    k_leiste: u32, k_titel: u32, k_karte: u32, k_ueber: u32,
    k_notiz: u32, k_liste: u32, k_zeile: u32, k_gerade: u32,
    k_akzent: u32, t: u64) -> usize {
    let wurzel: usize = scene.scene_add(sc, scene.SCENE_NONE, scene.N_BOX)
    scene.node_set_flex(sc, wurzel, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    scene.node_set_padding(sc, wurzel, RAND, RAND, RAND, RAND)
    scene.node_set_gap(sc, wurzel, LUECKE, 0)

    // ---- die Kopfzeile: Titel links, drei Knoepfe rechts
    let kopf: usize = scene.scene_add(sc, wurzel, scene.N_BOX)
    scene.node_add_class(sc, kopf, k_leiste)
    scene.node_set_flex(sc, kopf, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_CENTER)
    scene.node_set_padding(sc, kopf, 16, 10, 16, 10)
    scene.node_set_gap(sc, kopf, 10, 0)
    scene.node_set_size(sc, kopf, 0.0, LEISTE_H)
    let titel: usize = scene.scene_add(sc, kopf, scene.N_TEXT)
    scene.node_add_class(sc, titel, k_titel)
    scene.node_set_text(sc, titel, t, 30)
    scene.node_set_grow(sc, titel, 1000, 1000)
    var i: usize = 0
    while i < 3 {
        let b: usize = scene.scene_add(sc, kopf, scene.N_WIDGET)
        scene.node_set_widget_kind(sc, b, widget.KIND_BUTTON)
        scene.node_set_text(sc, b, t + (40 + i * 16) as u64, 7)
        scene.node_set_size(sc, b, 0.0, 34.0)
        if i == 2 {
            scene.node_add_class(sc, b, k_akzent)
        }
        i = i + 1
    }

    // ---- die Werkzeugleiste: drei Knoepfe, ein Suchfeld, ein Akzent
    //
    // Die beiden Marken sind keine Verzierung: tools/fui/run.sh zaehlt
    // die Zeilen zwischen ihnen und haelt sie gegen `fn
    // werkzeugleiste` in demos/fuidemo/main.fi (siehe Kopf).
    // >>> WERKZEUGLEISTE
    let leiste: usize = scene.scene_add(sc, wurzel, scene.N_BOX)
    scene.node_add_class(sc, leiste, k_leiste)
    scene.node_set_flex(sc, leiste, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_CENTER)
    scene.node_set_padding(sc, leiste, 10, 10, 10, 10)
    scene.node_set_gap(sc, leiste, 10, 0)
    scene.node_set_size(sc, leiste, 0.0, LEISTE_H)
    var j: usize = 0
    while j < 5 {
        let b: usize = scene.scene_add(sc, leiste, scene.N_WIDGET)
        scene.node_set_widget_kind(sc, b, widget.KIND_BUTTON)
        scene.node_set_size(sc, b, 0.0, 34.0)
        scene.node_set_text(sc, b, t + (88 + j * 16) as u64, 8)
        if j == 3 {
            scene.node_set_widget_kind(sc, b, widget.KIND_TEXTBOX)
            scene.node_set_grow(sc, b, 1000, 1000)
            scene.node_set_text(sc, b, t + 184 as u64, 22)
        }
        if j == 4 {
            scene.node_add_class(sc, b, k_akzent)
        }
        j = j + 1
    }
    // <<< WERKZEUGLEISTE

    // ---- der Rumpf: links der Scheibenkasten, rechts die Karten
    let rumpf: usize = scene.scene_add(sc, wurzel, scene.N_BOX)
    scene.node_set_flex(sc, rumpf, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    scene.node_set_gap(sc, rumpf, LUECKE, 0)
    scene.node_set_grow(sc, rumpf, 1000, 1000)

    let kasten: usize = scene.scene_add(sc, rumpf, scene.N_VIEWPORT)
    scene.node_add_class(sc, kasten, k_liste)
    scene.node_set_viewport(sc, kasten, v)
    scene.node_set_flex(sc, kasten, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    scene.node_set_padding(sc, kasten, 8, 8, 8, 8)
    scene.node_set_gap(sc, kasten, ZEILE_LUECKE, 0)
    var z: usize = 0
    while z < ZEILEN {
        let r: usize = scene.scene_add(sc, kasten, scene.N_TEXT)
        scene.node_add_class(sc, r, k_zeile)
        if z % 2 == 0 {
            scene.node_add_class(sc, r, k_gerade)
        }
        if z == AKTIV_NR - 1 {
            scene.node_set_id(sc, r, ID_AKTIV)
        }
        scene.node_set_text(sc, r, feld + (z * SCHRITT) as u64, ZEILE_N)
        scene.node_set_size(sc, r, 0.0, ZEILE_H)
        z = z + 1
    }

    let rechts: usize = scene.scene_add(sc, rumpf, scene.N_BOX)
    scene.node_set_flex(sc, rechts, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    scene.node_set_gap(sc, rechts, LUECKE, 0)
    scene.node_set_grow(sc, rechts, 1000, 1000)

    let karte1: usize = scene.scene_add(sc, rechts, scene.N_BOX)
    scene.node_add_class(sc, karte1, k_karte)
    scene.node_set_flex(sc, karte1, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    scene.node_set_padding(sc, karte1, 20, 18, 20, 18)
    scene.node_set_gap(sc, karte1, 10, 0)
    let u1: usize = scene.scene_add(sc, karte1, scene.N_TEXT)
    scene.node_add_class(sc, u1, k_ueber)
    scene.node_set_text(sc, u1, t + 216 as u64, 28)
    scene.node_set_size(sc, u1, 0.0, 22.0)
    var n: usize = 0
    while n < 4 {
        let e: usize = scene.scene_add(sc, karte1, scene.N_TEXT)
        scene.node_add_class(sc, e, k_notiz)
        scene.node_set_text(sc, e, t + (256 + n * 48) as u64, 44)
        scene.node_set_size(sc, e, 0.0, 18.0)
        n = n + 1
    }

    let karte2: usize = scene.scene_add(sc, rechts, scene.N_BOX)
    scene.node_add_class(sc, karte2, k_karte)
    scene.node_set_flex(sc, karte2, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    scene.node_set_padding(sc, karte2, 20, 18, 20, 18)
    scene.node_set_gap(sc, karte2, 14, 0)
    scene.node_set_grow(sc, karte2, 1000, 1000)
    let u2: usize = scene.scene_add(sc, karte2, scene.N_TEXT)
    scene.node_add_class(sc, u2, k_ueber)
    scene.node_set_text(sc, u2, t + 448 as u64, 26)
    scene.node_set_size(sc, u2, 0.0, 22.0)
    var w: usize = 0
    while w < 5 {
        let e: usize = scene.scene_add(sc, karte2, scene.N_WIDGET)
        scene.node_set_size(sc, e, 0.0, 30.0)
        scene.node_set_text(sc, e, t + (480 + w * 24) as u64, 20)
        // Haken, Schalter und Punkt nehmen nur so viel Breite, wie sie
        // brauchen (`align-self: flex-start`) -- sonst zoege die
        // Querachse des Kastens sie ueber die ganze Karte, und ein
        // Schalter von 600 Punkten Breite ist kein Schalter mehr.
        // Ihr "an" ist der WERT, dieselbe Zahl, die wave2 liest.
        if w < 3 {
            scene.node_set_align_self(sc, e, flex.AL_START)
        }
        if w == 0 {
            scene.node_set_widget_kind(sc, e, widget.KIND_CHECKBOX)
            widget.w_set_value(scene.node_widget(sc, e), 1)
        }
        if w == 1 {
            scene.node_set_widget_kind(sc, e, widget.KIND_TOGGLE)
            widget.w_set_value(scene.node_widget(sc, e), 1)
        }
        if w == 2 {
            scene.node_set_widget_kind(sc, e, widget.KIND_RADIO)
            widget.w_set_value(scene.node_widget(sc, e), 1)
        }
        if w == 3 {
            scene.node_set_widget_kind(sc, e, widget.KIND_SLIDER)
            widget.w_set_value(scene.node_widget(sc, e), 620)
        }
        if w == 4 {
            scene.node_set_widget_kind(sc, e, widget.KIND_PROGRESS)
            widget.w_set_value(scene.node_widget(sc, e), 450)
        }
        w = w + 1
    }
    return kasten
}

// Die festen Beschriftungen der Seite, in EIN Feld. Sie liegen in
// derselben Ordnung, in der `baue_baum` sie abholt -- eine Zeile je
// Text, damit man beides nebeneinander lesen kann.
fn schreibe_texte(t: u64) {
    var a0: [u8; 30] = "fUi -- eine beschriebene Seite"
    var a1: [u8; 7] = "Ablage "
    var a2: [u8; 7] = "Ansicht"
    var a3: [u8; 7] = "Sichern"
    var b0: [u8; 8] = "Neu     "
    var b1: [u8; 8] = "Oeffnen "
    var b2: [u8; 8] = "Drucken "
    var b3: [u8; 8] = "        "
    var b4: [u8; 8] = "Starten "
    var b5: [u8; 22] = "Im Baum suchen ...    "
    var c0: [u8; 28] = "Was diese Seite beschreibt: "
    var c1: [u8; 44] = "scene.fi -- Baum, Messen, Anordnen, Zeichnen"
    var c2: [u8; 44] = "sheet.fi -- Auswahl, Rangfolge, Vererbung   "
    var c3: [u8; 44] = "viewport.fi -- Ausschnitt, Clip, Rollbalken "
    var c4: [u8; 44] = "flex.fi -- jede Koordinate in diesem Bild   "
    var d0: [u8; 26] = "Einstellungen dieser Seite"
    var e0: [u8; 20] = "Zebrastreifen       "
    var e1: [u8; 20] = "Weich auslaufen     "
    var e2: [u8; 20] = "Balken immer zeigen "
    var e3: [u8; 20] = "Rollgeschwindigkeit "
    var e4: [u8; 20] = "Aufbau der Liste    "
    kopiere(t, 0, (&a0[0]) as u64, 30)
    kopiere(t, 40, (&a1[0]) as u64, 7)
    kopiere(t, 56, (&a2[0]) as u64, 7)
    kopiere(t, 72, (&a3[0]) as u64, 7)
    kopiere(t, 88, (&b0[0]) as u64, 8)
    kopiere(t, 104, (&b1[0]) as u64, 8)
    kopiere(t, 120, (&b2[0]) as u64, 8)
    kopiere(t, 136, (&b3[0]) as u64, 8)
    kopiere(t, 152, (&b4[0]) as u64, 8)
    kopiere(t, 184, (&b5[0]) as u64, 22)
    kopiere(t, 216, (&c0[0]) as u64, 28)
    kopiere(t, 256, (&c1[0]) as u64, 44)
    kopiere(t, 304, (&c2[0]) as u64, 44)
    kopiere(t, 352, (&c3[0]) as u64, 44)
    kopiere(t, 400, (&c4[0]) as u64, 44)
    kopiere(t, 448, (&d0[0]) as u64, 26)
    kopiere(t, 480, (&e0[0]) as u64, 20)
    kopiere(t, 504, (&e1[0]) as u64, 20)
    kopiere(t, 528, (&e2[0]) as u64, 20)
    kopiere(t, 552, (&e3[0]) as u64, 20)
    kopiere(t, 576, (&e4[0]) as u64, 20)
}

// Wie viele Bildpunkte in diesem Band NICHT die Farbe des Blattes
// tragen. Damit wird gezaehlt, dass IM Ausschnitt wirklich gemalt wurde
// -- die billigste Art, ein Clipping zu bestehen, ist, nichts zu malen.
fn punkte(cv: *mut canvas.Canvas, x0: usize, x1: usize, y0: usize,
    y1: usize, grund: u32) -> usize {
    var n: usize = 0
    var y: usize = y0
    while y < y1 {
        var x: usize = x0
        while x < x1 {
            if canvas.canvas_get(cv, x, y) != grund {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

// DAS ABSCHNEIDEN, UEBER DIE GANZE LEINWAND GEMESSEN.
//
// Gezaehlt wird JEDER Bildpunkt eines Bereichs, der NICHT die Farbe des
// Blattes traegt und NICHT im Ausschnitt liegt -- Zeile fuer Zeile,
// Spalte fuer Spalte, also auch die schmalen Streifen links und rechts
// und die Randzeilen unmittelbar ueber und unter dem Kasten. Frueher
// sah diese Pruefung nur zwei Baender an; ein Punkt, der seitlich
// hinauslief, waere ihr entgangen.
//
// Der Bereich ist die ganze Leinwand MINUS dem, was der uebrigen Seite
// gehoert: alles oberhalb von `ymin` (Kopfzeile und Werkzeugleiste) und
// alles rechts von `xmax` (die beiden Karten). Beide Grenzen werden
// nicht geraten, sondern am angeordneten Baum abgelesen -- sonst waere
// die Zahl 0 nur deshalb 0, weil der Bereich klein genug gewaehlt ist.
//
// Ausgeklammert wird das VOLLE Rechteck des Ausschnitts, nicht nur
// seine Innenflaeche: der Rollbalken liegt in seiner rechten Spur, und
// er gehoert dorthin.
fn fremd(cv: *mut canvas.Canvas, xmax: usize, ymin: usize, hoehe: usize,
    vx: usize, vy: usize, vw: usize, vh: usize, grund: u32) -> usize {
    var n: usize = 0
    var y: usize = ymin
    while y < hoehe {
        var x: usize = 0
        while x < xmax {
            let drin: bool = x >= vx && x < vx + vw && y >= vy
            && y < vy + vh
            if !drin {
                if canvas.canvas_get(cv, x, y) != grund {
                    n = n + 1
                }
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

// DER BAUM DER GEGENPROBE. Nur der Scheibenkasten mit seinen Zeilen,
// sonst nichts -- damit die Zaehlung oben ueber die GANZE Leinwand
// laufen kann, ohne dass Leisten und Karten sie stoeren. Gezeichnet
// wird er zweimal: einmal mit seinem Ausschnitt (dann darf ausserhalb
// kein Punkt stehen) und einmal, nachdem ihm der Ausschnitt genommen
// wurde (dann MUESSEN dort Punkte stehen, sonst waere die erste
// Messung nur deshalb null, weil niemand ueber die Kante malt).
fn baue_liste(sc: *mut scene.Scene, v: *mut viewport.Viewport, feld: u64,
    k_liste: u32, k_zeile: u32, k_gerade: u32) -> usize {
    let kasten: usize = scene.scene_add(sc, scene.SCENE_NONE,
        scene.N_VIEWPORT)
    scene.node_add_class(sc, kasten, k_liste)
    scene.node_set_viewport(sc, kasten, v)
    scene.node_set_flex(sc, kasten, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    scene.node_set_padding(sc, kasten, 8, 8, 8, 8)
    scene.node_set_gap(sc, kasten, ZEILE_LUECKE, 0)
    var z: usize = 0
    while z < ZEILEN {
        let r: usize = scene.scene_add(sc, kasten, scene.N_TEXT)
        scene.node_add_class(sc, r, k_zeile)
        if z % 2 == 0 {
            scene.node_add_class(sc, r, k_gerade)
        }
        scene.node_set_text(sc, r, feld + (z * SCHRITT) as u64, ZEILE_N)
        scene.node_set_size(sc, r, 0.0, ZEILE_H)
        z = z + 1
    }
    return kasten
}

// Eine Zahl aus einem Argument. Was keine Ziffer ist, beendet sie --
// dieselbe knappe Fassung wie in tools/fui/belegpruef_main.fi.
fn zahl_von(p: u64) -> usize {
    var v: usize = 0
    var i: usize = 0
    while rt.ld8(p, i) >= 48 as u8 && rt.ld8(p, i) <= 57 as u8 {
        v = v * 10 + (rt.ld8(p, i) - 48 as u8) as usize
        i = i + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 57] = "gallery9_main <out.png> [light|dark] [font.ttf] [breite]\n"
        rt.write_everything(2, (&u[0]) as u64, 57)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    var dark: bool = true
    if rt.arg_count(start) >= 3 {
        if rt.ld8(rt.arg_ptr(start, 2), 0) == 108 as u8 {
            dark = false
        }
    }
    // ---- DIE BREITE. Viertes Argument, Vorgabe 1240. Schmaler als
    // W_MIN geht nicht: unter dieser Breite bliebe fuer die Karten
    // rechts weniger Platz, als ihre Texte brauchen, und die Seite
    // haelte ihre eigene Zusage (Abschnitt 7) nicht mehr.
    var breite: usize = W_STD
    if rt.arg_count(start) >= 5 {
        breite = zahl_von(rt.arg_ptr(start, 4))
        if breite < W_MIN {
            breite = W_MIN
        }
    }

    // ---- DIE SCHRIFT. Ohne sie waere das Bild eine Sammlung von
    // Rechtecken und belegte nichts.
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
    rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    if fm == 0 {
        var ks: [u8; 60] = "gallery9: keine Schrift gefunden -- ohne Schrift kein Beleg\n"
        rt.write_everything(2, (&ks[0]) as u64, 60)
        return 9
    }

    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, breite, H) {
        return 4
    }
    // Der Rasterpuffer bekommt die GANZE Leinwand. Hier stand einmal
    // eine 560 -- eine Hoehe, die zufaellig reichte, solange nichts
    // unterhalb davon mit weichen Kanten gemalt wurde. Eine zweite Zahl
    // fuer dieselbe Sache ist genau die Art Fehler, die still bleibt,
    // bis jemand H aendert.
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, breite, H) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(dark)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque((*f).base))

    // ---- DIE TEXTE UND DIE NAMEN DER KLASSEN
    //
    // Ein Klassenname ist eine ZAHL (sheet.sheet_name), gebildet aus
    // der Zeichenkette -- genau wie `class="karte"` im Web, nur dass
    // der Name hier einmal uebersetzt wird und danach ein Vergleich von
    // zwei Zahlen ist.
    let texte: u64 = rt.heap_alloc(640)
    let feld: u64 = rt.heap_alloc(ZEILEN * SCHRITT)
    if texte == 0 || feld == 0 {
        return 3
    }
    schreibe_texte(texte)
    schreibe_zeilen(feld)
    var nleiste: [u8; 6] = "leiste"
    var ntitel: [u8; 5] = "titel"
    var nkarte: [u8; 5] = "karte"
    var nueber: [u8; 5] = "ueber"
    var nnotiz: [u8; 5] = "notiz"
    var nliste: [u8; 5] = "liste"
    var nzeile: [u8; 5] = "zeile"
    var ngerade: [u8; 6] = "gerade"
    var nakzent: [u8; 6] = "akzent"
    let k_leiste: u32 = sheet.sheet_name((&nleiste[0]) as u64, 6)
    let k_titel: u32 = sheet.sheet_name((&ntitel[0]) as u64, 5)
    let k_karte: u32 = sheet.sheet_name((&nkarte[0]) as u64, 5)
    let k_ueber: u32 = sheet.sheet_name((&nueber[0]) as u64, 5)
    let k_notiz: u32 = sheet.sheet_name((&nnotiz[0]) as u64, 5)
    let k_liste: u32 = sheet.sheet_name((&nliste[0]) as u64, 5)
    let k_zeile: u32 = sheet.sheet_name((&nzeile[0]) as u64, 5)
    let k_gerade: u32 = sheet.sheet_name((&ngerade[0]) as u64, 6)
    let k_akzent: u32 = sheet.sheet_name((&nakzent[0]) as u64, 6)

    // ---- DER SCHEIBENKASTEN. Seine Groesse bekommt er beim Anordnen
    // vom Baum; was er hier schon weiss, ist sein INHALT -- und der ist
    // doppelt so hoch wie der Ausschnitt.
    var v: viewport.Viewport = viewport.viewport_new(0.0, 0.0, LISTE_W,
        400.0, INHALT_W, INHALT_H)
    viewport.viewport_set_bar(&v, BALKEN)
    viewport.viewport_set_offset(&v, 0.0, ROLL_Y)

    var sh: sheet.Sheet = sheet.sheet_new()
    baue_blatt(&sh, k_leiste, k_titel, k_karte, k_ueber, k_notiz,
        k_liste, k_zeile, k_gerade, k_akzent)
    var sc: scene.Scene = scene.scene_new()
    let kasten: usize = baue_baum(&sc, &v, feld, k_leiste, k_titel,
        k_karte, k_ueber, k_notiz, k_liste, k_zeile, k_gerade,
        k_akzent, texte)

    // ---- DIE VIER DURCHGAENGE, IN IHRER REIHENFOLGE
    scene.scene_style(&sc, &sh)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 0.0, 0.0, breite as f64, H as f64)
    scene.scene_draw(&sc, &c)

    // ==================================================================
    // WAS DAS BILD BELEGEN MUSS
    // ==================================================================
    let vx: f64 = viewport.viewport_x(&v)
    let vy: f64 = viewport.viewport_y(&v)
    let vw: f64 = viewport.viewport_w(&v)
    let vh: f64 = viewport.viewport_h(&v)
    let grund: u32 = canvas.canvas_get(&cv, 2, 2)

    var q0: [u8; 44] = "1 keine Groesse driftet beim Zeichnen       "
    fordere((&q0[0]) as u64, 43, scene.scene_size_drift(&sc) == 0,
        scene.scene_size_drift(&sc) as i64, 0)
    // Der Ausschnitt steht dort, wo die Flexbox ihn hingelegt hat: der
    // Rumpf beginnt unter zwei Leisten von je 56 Punkten und zwei
    // Luecken von 16, also bei 24 + 56 + 16 + 56 + 16 = 168, und ist
    // 720 - 168 - 24 = 528 hoch.
    var q1: [u8; 44] = "1 der Ausschnitt beginnt bei y = 168        "
    fordere((&q1[0]) as u64, 43, (vy as i64) == 168, vy as i64, 168)
    var q2: [u8; 43] = "1 und ist 528 hoch                         "
    fordere((&q2[0]) as u64, 43, (vh as i64) == 528, vh as i64, 528)

    // ---- 2. DAS ABSCHNEIDEN, UEBER DIE GANZE LEINWAND GEMESSEN
    //
    // Der Bereich, in dem KEIN Punkt der Liste stehen darf, wird am
    // angeordneten Baum abgelesen und nicht geraten: unterhalb der
    // Werkzeugleiste (deren Unterkante der Baum kennt) und links von
    // den Karten (deren linke Kante er ebenfalls kennt). Darin liegen
    // die Luecke ueber dem Ausschnitt, der Rand unter ihm UND die
    // schmalen Streifen links und rechts davon -- jede einzelne Zeile
    // und Spalte wird angesehen. Ohne Clip stuenden hier 217 Punkte
    // Liste oben und der Ueberhang unten.
    let wurzel: usize = scene.scene_root(&sc)
    let leiste_i: usize = scene.scene_child_at(&sc, wurzel, 1)
    let unterkante: usize = (scene.node_y(&sc, leiste_i)
        +scene.node_h(&sc, leiste_i)) as usize
    let rumpf_i: usize = scene.scene_child_at(&sc, wurzel, 2)
    let rechts_i: usize = scene.scene_child_at(&sc, rumpf_i, 1)
    let karten_x: usize = scene.node_x(&sc, rechts_i) as usize
    let ausserhalb: usize = fremd(&cv, karten_x, unterkante, H, vx as usize,
        vy as usize, vw as usize, vh as usize, grund)
    var q3: [u8; 44] = "2 neben dem Ausschnitt kein fremder Punkt   "
    fordere((&q3[0]) as u64, 43, ausserhalb == 0, ausserhalb as i64, 0)
    var q4: [u8; 43] = "2 der Bereich reicht bis unter die Leiste  "
    fordere((&q4[0]) as u64, 43, unterkante == 152 && karten_x > 0,
        unterkante as i64, 152)
    // Und damit das nicht dadurch gruen wird, dass gar nichts gemalt
    // wurde: IM Ausschnitt stehen ueber 100000 Punkte, die nicht die
    // Farbe des Blattes haben.
    let drin: usize = punkte(&cv, (vx + 2.0) as usize,
        (vx + vw - 2.0) as usize, (vy + 2.0) as usize,
        (vy + vh - 2.0) as usize, grund)
    var q5: [u8; 43] = "2 im Ausschnitt ist wirklich gemalt        "
    fordere((&q5[0]) as u64, 43, drin > 100000, drin as i64, 100000)

    // ---- 2b. DIE ROTE GEGENPROBE
    //
    // Eine Zaehlung, die 0 meldet, ist erst dann ein Beleg, wenn sie
    // bei fehlendem Clip NICHT 0 meldet. Darum steht hier derselbe
    // Inhalt noch einmal: ein Baum, der NUR aus dem Scheibenkasten und
    // seinen 28 Zeilen besteht, auf einer eigenen Leinwand, an
    // derselben Stelle und mit derselben Rollposition. Er wird zweimal
    // gezeichnet -- einmal mit Ausschnitt (kein Punkt darf hinaus) und
    // einmal, nachdem ihm der Ausschnitt genommen wurde, also ganz ohne
    // viewport_begin/viewport_end (dann MUESSEN Punkte hinauslaufen).
    // Bleibt die zweite Zahl bei null, ist das Clipping gar nicht die
    // Ursache der ersten, und dieses Programm meldet es rot.
    var cv2: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv2, breite, H) {
        return 4
    }
    var z2: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z2, &cv2, breite, H) {
        return 5
    }
    painter.painter_set_font(&z2, fm)
    var c2: render.Ctx = render.ctx_new(&m, &z2)
    var v2: viewport.Viewport = viewport.viewport_new(vx, vy, vw, vh,
        INHALT_W, INHALT_H)
    viewport.viewport_set_bar(&v2, BALKEN)
    viewport.viewport_set_offset(&v2, 0.0, ROLL_Y)
    var sc2: scene.Scene = scene.scene_new()
    let kasten2: usize = baue_liste(&sc2, &v2, feld, k_liste, k_zeile,
        k_gerade)
    scene.scene_style(&sc2, &sh)
    scene.scene_measure(&sc2, &c2)
    scene.scene_layout(&sc2, &c2, vx, vy, vw, vh)
    canvas.canvas_clear(&cv2, theme.opaque((*f).base))
    scene.scene_draw(&sc2, &c2)
    let mit_clip: usize = fremd(&cv2, breite, 0, H, vx as usize,
        vy as usize, vw as usize, vh as usize, grund)
    var q3b: [u8; 44] = "2 allein: mit Clip bleibt alles im Kasten   "
    fordere((&q3b[0]) as u64, 43, mit_clip == 0, mit_clip as i64, 0)
    scene.node_set_viewport(&sc2, kasten2, (0 as u64)
        as *mut viewport.Viewport)
    canvas.canvas_clear(&cv2, theme.opaque((*f).base))
    scene.scene_draw(&sc2, &c2)
    let ohne_clip: usize = fremd(&cv2, breite, 0, H, vx as usize,
        vy as usize, vw as usize, vh as usize, grund)
    var q3c: [u8; 43] = "2 ohne Clip laufen Punkte hinaus (>20000)  "
    fordere((&q3c[0]) as u64, 43, ohne_clip > 20000, ohne_clip as i64,
        20000)
    painter.painter_free(&z2)
    canvas.canvas_free(&cv2)

    // ---- 3. DIE LAENGE DES SCHIEBERS, VON DER LEINWAND ABGELESEN
    //
    // Der Anteil ist 528/1130. Die Spur ist so lang wie der Ausschnitt
    // (528), davon gehen oben und unten je 2 Punkte Polster ab: 524.
    // 524 * 528/1130 = 244.8 -- also rund 245 Punkte Schieber. Die
    // Rechnung dazu steht an EINER Stelle (wave2.scrollbar_thumb), und
    // genau die wird hier gegen das Bild gehalten.
    var bx: f64 = 0.0
    var by: f64 = 0.0
    var bw: f64 = 0.0
    var bh: f64 = 0.0
    let hat: bool = viewport.viewport_bar_rect_v(&v, &bx, &by, &bw, &bh)
    var e: widget.Widget = widget.widget_new(widget.KIND_SCROLLBAR)
    widget.w_place(&e, bx, by, bw, bh)
    widget.w_set_pref(&e, 0.0,
        viewport.viewport_share_v(&v) * (wave2.VAL_MAX as f64))
    widget.w_set_value(&e, viewport.viewport_value_v(&v))
    var tr: layout.Rect = wave2.scrollbar_thumb(&c, &e)
    var q6: [u8; 43] = "3 der senkrechte Balken ist da             "
    fordere((&q6[0]) as u64, 43, hat && (bh as i64) == 528, bh as i64,
        528)
    var q7: [u8; 43] = "3 wave2.scrollbar_thumb sagt 245           "
    fordere((&q7[0]) as u64, 43, layout.rect_h(&tr) == 245,
        layout.rect_h(&tr), 245)
    // Und dieselbe Laenge auf dem Bild: in der Mitte der Spur ist der
    // Schieber das einzige lange Stueck, das von der Spurfarbe
    // abweicht.
    let sx: usize = (bx + bw / 2.0) as usize
    let spur: u32 = canvas.canvas_get(&cv, sx, (by + 1.0) as usize)
    var laenge: usize = 0
    var lauf: usize = 0
    var yy: usize = by as usize
    while yy < (by + bh) as usize {
        if canvas.canvas_get(&cv, sx, yy) != spur {
            lauf = lauf + 1
            if lauf > laenge {
                laenge = lauf
            }
        } else {
            lauf = 0
        }
        yy = yy + 1
    }
    var q8: [u8; 43] = "3 Schieberlaenge auf der Leinwand 243..247 "
    fordere((&q8[0]) as u64, 43, laenge >= 243 && laenge <= 247,
        laenge as i64, 245)

    // ---- 4. DIE RANGFOLGE STEHT IM BILD
    //
    // Die hervorgehobene Zeile traegt die Kennung (Rang 10000) und
    // schlaegt damit die Klassenregel `zeile` (100) und die beiden
    // Klassen `zeile gerade` (200). Gefragt wird nicht das Blatt,
    // sondern der Knoten NACH Durchgang 1 -- also das, was wirklich
    // gemalt wurde.
    let aktiv: usize = scene.scene_find_id(&sc, ID_AKTIV)
    let akz: u32 = style.color_token(style.TOK_ACCENT)
    var q9: [u8; 44] = "4 die Zeile mit Kennung traegt den Akzent   "
    fordere((&q9[0]) as u64, 43,
        aktiv != scene.SCENE_NONE
        && (*scene.node_style(&sc, aktiv)).bg == akz,
        (*scene.node_style(&sc, aktiv)).bg as i64, akz as i64)
    // Ihre Nachbarin ist eine ungerade Zeile: nur die Klassenregel.
    let nachbar: usize = scene.scene_child_at(&sc, kasten, AKTIV_NR)
    let tokf: u32 = style.color_token(style.TOK_SURFACE)
    var q10: [u8; 43] = "4 die Nachbarin traegt die Klassenregel    "
    fordere((&q10[0]) as u64, 43,
        (*scene.node_style(&sc, nachbar)).bg == tokf,
        (*scene.node_style(&sc, nachbar)).bg as i64, tokf as i64)
    // Und die gerade Zeile darueber die Regel mit ZWEI Klassen. Die
    // hervorgehobene Zeile traegt uebrigens `gerade` AUCH -- genau
    // deshalb ist sie der Nachweis: 10000 schlaegt 200.
    let gerade: usize = scene.scene_child_at(&sc, kasten, AKTIV_NR - 3)
    let tokg: u32 = style.color_token(style.TOK_FIELD)
    var q11: [u8; 43] = "4 die gerade Zeile die Zwei-Klassen-Regel  "
    fordere((&q11[0]) as u64, 43,
        (*scene.node_style(&sc, gerade)).bg == tokg,
        (*scene.node_style(&sc, gerade)).bg as i64, tokg as i64)
    // Die VERERBUNG und ihre Grenze: die Zeile hat die Schriftgroesse
    // des Ausschnitts geerbt (13), seinen Grund aber nicht.
    var q12: [u8; 43] = "5 die Zeile erbt die Schriftgroesse 13     "
    fordere((&q12[0]) as u64, 43,
        (*scene.node_style(&sc, nachbar)).font_px == 13,
        (*scene.node_style(&sc, nachbar)).font_px as i64, 13)

    // ---- 6. DIE TREFFERPRUEFUNG UNTER VERSCHIEBUNG
    //
    // Bei einer Verschiebung von 217 steht die erste ganz sichtbare
    // Zeile nicht mehr oben. Ein Punkt dicht unter der Oberkante des
    // Ausschnitts trifft darum NICHT die erste Zeile -- und ein Punkt
    // in der Luecke ueber dem Ausschnitt trifft ueberhaupt keine.
    let getroffen: usize = scene.scene_hit(&sc, vx + 40.0, vy + 4.0)
    let erste: usize = scene.scene_child_at(&sc, kasten, 0)
    var q13: [u8; 43] = "6 oben trifft nicht mehr die erste Zeile   "
    fordere((&q13[0]) as u64, 43, getroffen != erste,
        getroffen as i64, erste as i64)
    let daneben: usize = scene.scene_hit(&sc, vx + 40.0, vy - 6.0)
    var q14: [u8; 43] = "6 in der Luecke trifft keine Zeile         "
    fordere((&q14[0]) as u64, 43,
        daneben == scene.SCENE_NONE
        || scene.node_has_class(&sc, daneben, k_zeile) == false,
        (daneben == scene.SCENE_NONE) as i64, 0)

    // ---- 7. KEIN TEXT LAEUFT AUS SEINEM KASTEN
    //
    // Fuer JEDEN Knoten wird die Wunschbreite aus render.pref_of gegen
    // die angeordnete Breite gehalten. Ein Knoten, dessen Text breiter
    // ist als sein Kasten, wuerde hier auffallen -- und nicht erst dem,
    // der das Bild ansieht.
    var zu_breit: usize = 0
    var k: usize = 0
    while k < scene.scene_count(&sc) {
        if scene.node_kind(&sc, k) == scene.N_TEXT
        || scene.node_kind(&sc, k) == scene.N_WIDGET {
            var pw: f64 = 0.0
            var ph: f64 = 0.0
            render.pref_of(&c, scene.node_widget(&sc, k), &pw, &ph)
            if pw > scene.node_w(&sc, k) + 0.5 {
                zu_breit = zu_breit + 1
            }
        }
        k = k + 1
    }
    var q15: [u8; 43] = "7 kein Knoten ist zu schmal fuer den Text  "
    fordere((&q15[0]) as u64, 43, zu_breit == 0, zu_breit as i64, 0)

    // ---- 8. LESBAR IN HELL UND DUNKEL
    //
    // Der Text der Karte gegen ihren Grund, in Hundertsteln: 4.5:1 ist
    // die Schwelle aus tools/fui/contrast_main.fi.
    let tf: u32 = theme.opaque(theme.color_from_token(&m, style.TOK_TEXT))
    let tg: u32 = theme.opaque(theme.color_from_token(&m,
            style.TOK_SURFACE_RAISED))
    let kk: i64 = (theme.contrast(tf, tg) * 100.0 + 0.5) as i64
    var q16: [u8; 43] = "8 Karte: Text gegen Grund 4.5:1            "
    fordere((&q16[0]) as u64, 43, kk >= 450, kk, 450)

    if G_FEHLER > 0 {
        var gf: [u8; 62] = "gallery9: die Seite haelt ihre Zusage nicht -- kein Beleg\n\0\0\0\0"
        rt.write_everything(2, (&gf[0]) as u64, 58)
        return 10
    }

    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&cv, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var pk: usize = 0
    while pk < rt.c_length(path) {
        rt.buf_push(&pf, rt.ld8(path, pk))
        pk = pk + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 10] = "GALLERY 9\n"
    rt.write_everything(1, (&okm[0]) as u64, 10)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    return 0
}
