// SPDX-License-Identifier: GPL-2.0-only
// tools/fui/icon_main.fi -- THE ICONS AT THE PIXEL.
//
// The icons in lib/fui/icon.fi are GEOMETRY, not text. That makes
// them checkable like any other drawing: paint, read back, count.
//
// What is checked is what can really go wrong:
//   * An icon paints NOTHING AT ALL (the most common way to lose a
//     symbol -- it only shows if you look).
//   * An icon paints OUTSIDE its square (then it overlaps the text
//     next to it in a menu).
//   * The four triangle directions all point THE SAME WAY (the
//     mistake one makes when copying them out).
import std.rt
import paint.canvas
import fui.painter
import fui.icon

const W: usize = 120
const H: usize = 120

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, got: i64, want: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 44 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var h1: [u8; 5] = " got "
    rt.buf_push_bytes(&t, (&h1[0]) as u64, 5)
    rt.buf_push_dec_i64(&t, got)
    var h2: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&h2[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, want)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// How many pixels in this rectangle are NOT the background?
fn count_px(cv: *mut canvas.Canvas, x: usize, y: usize, w: usize,
    h: usize, base: u32) -> i64 {
    var n: i64 = 0
    var j: usize = 0
    while j < h {
        var i: usize = 0
        while i < w {
            if (canvas.canvas_get(cv, x + i, y + j) & 16777215 as u32)
                != base {
                n = n + 1
            }
            i = i + 1
        }
        j = j + 1
    }
    return n
}

// The centroid of the painted pixels -- it tells you where a
// triangle points without knowing its shape.
fn centroid_y(cv: *mut canvas.Canvas, x: usize, y: usize, w: usize,
    h: usize, base: u32) -> i64 {
    var s: i64 = 0
    var n: i64 = 0
    var j: usize = 0
    while j < h {
        var i: usize = 0
        while i < w {
            if (canvas.canvas_get(cv, x + i, y + j) & 16777215 as u32)
                != base {
                s = s + (j as i64)
                n = n + 1
            }
            i = i + 1
        }
        j = j + 1
    }
    if n == 0 {
        return -1
    }
    return s / n
}

fn centroid_x(cv: *mut canvas.Canvas, x: usize, y: usize, w: usize,
    h: usize, base: u32) -> i64 {
    var s: i64 = 0
    var n: i64 = 0
    var j: usize = 0
    while j < h {
        var i: usize = 0
        while i < w {
            if (canvas.canvas_get(cv, x + i, y + j) & 16777215 as u32)
                != base {
                s = s + (i as i64)
                n = n + 1
            }
            i = i + 1
        }
        j = j + 1
    }
    if n == 0 {
        return -1
    }
    return s / n
}

fn main(start: u64) -> i32 {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 2
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, H) {
        return 3
    }
    let base: u32 = 0 as u32
    let white: u32 = 16777215 as u32

    // ==================================================================
    // 1. EVERY ICON PAINTS SOMETHING AT ALL
    // ==================================================================
    //
    // The silent death of a symbol: it paints nothing and nobody
    // notices, because the surface underneath looks right.
    canvas.canvas_clear(&cv, opaque_px(base))
    icon.check(&z, 20.0, 20.0, 40.0, 3.0, white)
    let n_check: i64 = count_px(&cv, 20, 20, 40, 40, base)
    var t1: [u8; 26] = "1 check mark paints pixels"
    report((&t1[0]) as u64, 26, n_check > 40, n_check, 40)

    canvas.canvas_clear(&cv, opaque_px(base))
    icon.dot(&z, 20.0, 20.0, 20.0, white)
    let n_dot: i64 = count_px(&cv, 20, 20, 20, 20, base)
    var t2: [u8; 19] = "1 dot paints pixels"
    report((&t2[0]) as u64, 19, n_dot > 200, n_dot, 200)

    canvas.canvas_clear(&cv, opaque_px(base))
    icon.cross(&z, 20.0, 20.0, 20.0, 2.0, white)
    let n_cross: i64 = count_px(&cv, 18, 18, 26, 26, base)
    var t3: [u8; 21] = "1 cross paints pixels"
    report((&t3[0]) as u64, 21, n_cross > 40, n_cross, 40)

    canvas.canvas_clear(&cv, opaque_px(base))
    icon.dash(&z, 20.0, 20.0, 20.0, 2.0, white)
    let n_dash: i64 = count_px(&cv, 20, 20, 20, 20, base)
    var t4: [u8; 20] = "1 dash paints pixels"
    report((&t4[0]) as u64, 20, n_dash > 10, n_dash, 10)

    // ==================================================================
    // 2. THE FOUR TRIANGLES POINT IN FOUR DIRECTIONS
    // ==================================================================
    //
    // THE BUG THIS CHECK CATCHES: four directions out of one
    // function are four chances to hit the same one. A triangle
    // "up" that looks like "down" is invisible in the source -- the
    // centroid gives it away at once.
    //
    // A triangle pointing DOWN is wide at the top: its centroid sits
    // above the middle. Pointing UP it is the other way round.
    canvas.canvas_clear(&cv, opaque_px(base))
    icon.triangle(&z, 20.0, 20.0, 20.0, icon.DIR_DOWN, white)
    let sy_down: i64 = centroid_y(&cv, 20, 20, 20, 20, base)

    canvas.canvas_clear(&cv, opaque_px(base))
    icon.triangle(&z, 20.0, 20.0, 20.0, icon.DIR_UP, white)
    let sy_up: i64 = centroid_y(&cv, 20, 20, 20, 20, base)

    canvas.canvas_clear(&cv, opaque_px(base))
    icon.triangle(&z, 20.0, 20.0, 20.0, icon.DIR_LEFT, white)
    let sx_left: i64 = centroid_x(&cv, 20, 20, 20, 20, base)

    canvas.canvas_clear(&cv, opaque_px(base))
    icon.triangle(&z, 20.0, 20.0, 20.0, icon.DIR_RIGHT, white)
    let sx_right: i64 = centroid_x(&cv, 20, 20, 20, 20, base)

    var t5: [u8; 30] = "2 triangle down: centroid high"
    report((&t5[0]) as u64, 30, sy_down >= 0 && sy_down < 5, sy_down, 5)
    var t6: [u8; 29] = "2 triangle up: centroid lower"
    report((&t6[0]) as u64, 29, sy_up > sy_down, sy_up, sy_down)
    // CAREFUL, THE SIGN IS THE OTHER WAY ROUND THAN ONE EXPECTS, AND
    // THE FIRST VERSION OF THIS CHECK GOT IT WRONG.
    //
    // The centroid does not sit at the TIP but at the heavy BASE. A
    // triangle pointing LEFT has its tip at small x and its full
    // height base at large x -- so its centroid is the LARGER one.
    // Measured at d=20: left 6, right 3.
    //
    // The first version demanded `sx_left < 5` and reported the
    // correct icon as broken. The icon was right, the expectation was
    // wrong.
    var t7: [u8; 31] = "2 triangle left: centroid right"
    report((&t7[0]) as u64, 31, sx_left > sx_right, sx_left, sx_right)
    var t8: [u8; 31] = "2 triangle right: centroid left"
    report((&t8[0]) as u64, 31, sx_right >= 0 && sx_right < 5,
        sx_right, 5)

    // ==================================================================
    // 3. NO ICON PAINTS OUTSIDE ITS SQUARE
    // ==================================================================
    //
    // WHY THIS MATTERS: in a menu the check mark sits left and the
    // text right next to it. A check mark painting past its square
    // tints letters -- and that looks like a font bug, not like an
    // icon bug. You then search in the wrong place.
    //
    //
    // What is checked is the FRAME around the square: anything that
    // lands there has leaked out.
    canvas.canvas_clear(&cv, opaque_px(base))
    icon.check(&z, 30.0, 30.0, 20.0, 3.0, white)
    // A frame of 6 pixels around the square 30..50.
    let out_check: i64 = count_px(&cv, 24, 24, 32, 6, base)
        + count_px(&cv, 24, 50, 32, 6, base)
        + count_px(&cv, 24, 30, 6, 20, base)
        + count_px(&cv, 50, 30, 6, 20, base)
    var t9: [u8; 32] = "3 check mark stays in the square"
    report((&t9[0]) as u64, 32, out_check == 0, out_check, 0)

    canvas.canvas_clear(&cv, opaque_px(base))
    icon.triangle(&z, 30.0, 30.0, 20.0, icon.DIR_DOWN, white)
    let out_tri: i64 = count_px(&cv, 24, 24, 32, 6, base)
        + count_px(&cv, 24, 50, 32, 6, base)
        + count_px(&cv, 24, 30, 6, 20, base)
        + count_px(&cv, 50, 30, 6, 20, base)
    var t10: [u8; 30] = "3 triangle stays in the square"
    report((&t10[0]) as u64, 30, out_tri == 0, out_tri, 0)

    canvas.canvas_clear(&cv, opaque_px(base))
    icon.dot(&z, 30.0, 30.0, 20.0, white)
    let out_dot: i64 = count_px(&cv, 24, 24, 32, 6, base)
        + count_px(&cv, 24, 50, 32, 6, base)
        + count_px(&cv, 24, 30, 6, 20, base)
        + count_px(&cv, 50, 30, 6, 20, base)
    var t11: [u8; 25] = "3 dot stays in the square"
    report((&t11[0]) as u64, 25, out_dot == 0, out_dot, 0)

    // ==================================================================
    // 4. THE CHECK MARK IS A HOOK AND NOT A STROKE
    // ==================================================================
    //
    // A check mark has a SHORT arm going down and a LONG one going
    // up. If both strokes are the same length it is a v -- and a v
    // does not read as "on" in a checkbox.
    //
    // Measured: the lowest painted pixel is in the lower half, the
    // highest in the upper. A horizontal stroke would have both in
    // the middle.
    canvas.canvas_clear(&cv, opaque_px(base))
    icon.check(&z, 20.0, 20.0, 40.0, 3.0, white)
    var top: i64 = -1
    var bottom: i64 = -1
    var j: usize = 0
    while j < 40 {
        var i: usize = 0
        while i < 40 {
            if (canvas.canvas_get(&cv, 20 + i, 20 + j)
                & 16777215 as u32) != base {
                if top < 0 {
                    top = j as i64
                }
                bottom = j as i64
            }
            i = i + 1
        }
        j = j + 1
    }
    var t12: [u8; 29] = "4 check mark spans the middle"
    report((&t12[0]) as u64, 29, top < 15 && bottom > 24, bottom - top, 10)

    // ==================================================================
    // RESULT
    // ==================================================================
    if G_ERRORS == 0 {
        var g: [u8; 15] = "\nICONS PASSED.\n"
        rt.write_everything(1, (&g[0]) as u64, 15)
        return 0
    }
    var b: [u8; 15] = "\nICONS FAILED.\n"
    rt.write_everything(2, (&b[0]) as u64, 15)
    return 1
}

// The canvas holds RGBA; `canvas_clear` wants the full value with
// alpha. The same arithmetic as `theme.opaque`, here without loading
// the theme -- this check needs no theme.
fn opaque_px(c: u32) -> u32 {
    return c | 4278190080 as u32
}
