// SPDX-License-Identifier: GPL-2.0-only
// tools/fui/schau_main.fi -- fUi MALT SICH SELBST, ALS PNG.
//
// Ein Bedienelement, das man nicht sieht, ist nicht geprueft. Dieses
// Programm malt die Elemente von fUi in allen Zustaenden auf eine
// Leinwand und schreibt sie als PNG -- ohne Fenster, ohne X11, ohne
// Wine. Damit kann jede Aenderung an der Zeichenschicht ANGESEHEN
// werden, und zwar in Justins Aufloesung.
//
//     schau_main <ausgabe.png> [hell|dunkel] [<schrift.ttf>]
//
// Der Grund, warum es das gibt und nicht nur ein Bildschirmfoto:
// dieselbe Zeichnung ist in OrientOS heute schon ZWEIMAL kaputtgegangen
// (erst ein zerfranstes Kreuz, dann nur noch eine Diagonale), und beide
// Male ist es niemandem im Quelltext aufgefallen. Im Bild faellt es
// sofort auf.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.marke
import fui.zeichnen

const FONTSET_BYTES: usize = 4096

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 46] = "schau_main <aus.png> [hell|dunkel] [font.ttf]\n"
        rt.write_everything(2, (&u[0]) as u64, 45)
        return 2
    }
    let pfad: u64 = rt.arg_ptr(start, 1)

    // hell oder dunkel
    var dunkel: bool = true
    if rt.arg_count(start) >= 3 {
        let p2: u64 = rt.arg_ptr(start, 2)
        // "hell" -- vier Oktett, erstes 'h'
        if rt.ld8(p2, 0) == 104 as u8 {
            dunkel = false
        }
    }

    // ---- DIE SCHRIFT. Ohne sie malt alles ausser dem Text.
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
        rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }

    // ---- DIE LEINWAND
    let W: usize = 760
    let H: usize = 420
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: zeichnen.Zeichner = zeichnen.zeichner_neu()
    // Das Rasterfenster: so gross wie das groesste Element mit Luft.
    if !zeichnen.zeichner_init(&z, &cv, 320, 120) {
        return 5
    }
    zeichnen.zeichner_setz_schrift(&z, fm)

    var m: marke.Marke = marke.marke_neu(dunkel)
    let f: *mut marke.Farben = marke.marke_farben(&m)
    let fo: *mut marke.Form = marke.marke_form(&m)
    canvas.canvas_clear(&cv, marke.deck((*f).grund))

    let px: f64 = marke.marke_px(&m, 1) as f64
    let r_knopf: f64 = marke.marke_px(&m, (*fo).r_knopf) as f64
    let r_feld: f64 = marke.marke_px(&m, (*fo).r_feld) as f64
    let ch: f64 = marke.marke_px(&m, (*fo).ctrl_h) as f64
    let padx: f64 = marke.marke_px(&m, (*fo).pad_x) as f64
    let gap: f64 = marke.marke_px(&m, (*fo).gap) as f64
    let spl: f64 = marke.marke_px(&m, (*fo).sp_l) as f64
    let spm: f64 = marke.marke_px(&m, (*fo).sp_m) as f64
    let fokus: f64 = marke.marke_px(&m, (*fo).fokus) as f64
    let size: f64 = marke.marke_px(&m, (*fo).font) as f64

    // ============================ REIHE 1: DIE FUENF KNOPFZUSTAENDE
    var t_norm: [u8; 6] = "Normal"
    var t_ueb: [u8; 5] = "Ueber"
    var t_dru: [u8; 8] = "Gedrueck"
    var t_fok: [u8; 6] = "Fokus "
    var t_sperr: [u8; 8] = "Gesperrt"
    var y: f64 = spl
    var x: f64 = spl
    let bw: f64 = 128.0

    // Normal
    zeichnen.rund(&z, x, y, bw, ch, r_knopf,
        marke.flaeche_fuer(&m, marke.ZU_NORMAL))
    let by1: f64 = zeichnen.text_mitte_y(&z, y, ch, size)
    let e1: f64 = zeichnen.text(&z, x, by1, bw, size,
        marke.text_fuer(&m, marke.ZU_NORMAL), (&t_norm[0]) as u64, 6,
        zeichnen.text_M)
    x = x + bw + gap
    // Ueberfahren
    zeichnen.rund(&z, x, y, bw, ch, r_knopf,
        marke.flaeche_fuer(&m, marke.ZU_UEBER))
    let e2: f64 = zeichnen.text(&z, x, by1, bw, size,
        marke.text_fuer(&m, marke.ZU_UEBER), (&t_ueb[0]) as u64, 5,
        zeichnen.text_M)
    x = x + bw + gap
    // Gedrueckt
    zeichnen.rund(&z, x, y, bw, ch, r_knopf,
        marke.flaeche_fuer(&m, marke.ZU_DRUCK))
    let e3: f64 = zeichnen.text(&z, x, by1, bw, size,
        marke.text_fuer(&m, marke.ZU_DRUCK), (&t_dru[0]) as u64, 8,
        zeichnen.text_M)
    x = x + bw + gap
    // Fokussiert -- Flaeche wie normal, dazu der RING
    zeichnen.rund(&z, x, y, bw, ch, r_knopf,
        marke.flaeche_fuer(&m, marke.ZU_FOKUS))
    let e4: f64 = zeichnen.text(&z, x, by1, bw, size,
        marke.text_fuer(&m, marke.ZU_FOKUS), (&t_fok[0]) as u64, 5,
        zeichnen.text_M)
    zeichnen.ring(&z, x, y, bw, ch, r_knopf, fokus, (*f).akzent)
    x = x + bw + gap
    // Gesperrt
    zeichnen.rund(&z, x, y, bw, ch, r_knopf,
        marke.flaeche_fuer(&m, marke.ZU_SPERR))
    let e5: f64 = zeichnen.text(&z, x, by1, bw, size,
        marke.text_fuer(&m, marke.ZU_SPERR), (&t_sperr[0]) as u64, 8,
        zeichnen.text_M)

    // ================================ REIHE 2: DIE TEXTFELDER
    y = y + ch + spm
    x = spl
    let fw: f64 = 300.0
    var t_url: [u8; 21] = "https://de.wikipedia."
    // Feld in Ruhe
    zeichnen.rund(&z, x, y, fw, ch, r_feld, (*f).feld)
    zeichnen.ring(&z, x, y, fw, ch, r_feld, px, (*f).linie)
    let by2: f64 = zeichnen.text_mitte_y(&z, y, ch, size)
    let te: f64 = zeichnen.text(&z, x + padx, by2, fw - 2.0 * padx,
        size, (*f).text, (&t_url[0]) as u64, 21, zeichnen.text_L)

    // Feld mit Fokus, Auswahl und Marke -- das ist der Fall, den Justin
    // heute NICHT hat: markierter Text mit sichtbarer Auswahlfarbe.
    x = x + fw + spm
    zeichnen.rund(&z, x, y, fw, ch, r_feld, (*f).feld_fokus)
    // Der Auswahlbalken LIEGT UNTER dem Text.
    let tx: f64 = x + padx
    let awb: f64 = zeichnen.text_breite(&z, (&t_url[0]) as u64, 21, size)
    let ah: f64 = size * 1.3
    let ay: f64 = by2 - zeichnen.hoehe_ascent(&z, size) - 1.0
    zeichnen.flaeche(&z, tx, ay, awb, ah, (*f).auswahl)
    let te2: f64 = zeichnen.text(&z, tx, by2, fw - 2.0 * padx, size,
        (*f).auswahl_text, (&t_url[0]) as u64, 21, zeichnen.text_L)
    zeichnen.marke_strich(&z, te2, ay, ah, px, (*f).text)
    zeichnen.ring(&z, x, y, fw, ch, r_feld, fokus, (*f).akzent)

    // ================== REIHE 3: DIE FORM IST EINE MARKE, KEIN CODE
    // Dieselben fuenf Knoepfe mit `form_klassisch`. Sehen sie gleich
    // aus, hat jemand seine Zahlen hineingeschrieben statt sie zu holen.
    y = y + ch + spl
    var fk: marke.Form = marke.form_klassisch()
    marke.marke_setz_form(&m, &fk)
    let fo2: *mut marke.Form = marke.marke_form(&m)
    let ch2: f64 = marke.marke_px(&m, (*fo2).ctrl_h) as f64
    let rk2: f64 = marke.marke_px(&m, (*fo2).r_knopf) as f64
    let gap2: f64 = marke.marke_px(&m, (*fo2).gap) as f64
    x = spl
    var i: usize = 0
    while i < 5 {
        var zu: u32 = marke.ZU_NORMAL
        if i == 1 { zu = marke.ZU_UEBER }
        if i == 2 { zu = marke.ZU_DRUCK }
        if i == 3 { zu = marke.ZU_FOKUS }
        if i == 4 { zu = marke.ZU_SPERR }
        zeichnen.rund(&z, x, y, bw, ch2, rk2, marke.flaeche_fuer(&m, zu))
        let byk: f64 = zeichnen.text_mitte_y(&z, y, ch2, size)
        let ek: f64 = zeichnen.text(&z, x, byk, bw, size,
            marke.text_fuer(&m, zu), (&t_norm[0]) as u64, 6,
            zeichnen.text_M)
        if i == 3 {
            zeichnen.ring(&z, x, y, bw, ch2, rk2,
                marke.marke_px(&m, (*fo2).fokus) as f64, (*f).akzent)
        }
        x = x + bw + gap2
        i = i + 1
    }

    // =================== REIHE 4: DIE SKALIERUNG (150 %)
    // Justins Schirm ist 3440x1440. Ein Element, das nicht mitwaechst,
    // ist genau der Fehler aus dem Kopf von lib/fenster/fenster.fi.
    y = y + ch2 + spl
    var fosum: marke.Form = marke.form_osum()
    marke.marke_setz_form(&m, &fosum)
    marke.marke_setz_skala(&m, 1500)
    let fo3: *mut marke.Form = marke.marke_form(&m)
    let ch3: f64 = marke.marke_px(&m, (*fo3).ctrl_h) as f64
    let rk3: f64 = marke.marke_px(&m, (*fo3).r_knopf) as f64
    let size3: f64 = marke.marke_px(&m, (*fo3).font) as f64
    let bw3: f64 = 192.0
    x = spl
    var j: usize = 0
    while j < 3 {
        var zu3: u32 = marke.ZU_NORMAL
        if j == 1 { zu3 = marke.ZU_UEBER }
        if j == 2 { zu3 = marke.ZU_DRUCK }
        zeichnen.rund(&z, x, y, bw3, ch3, rk3,
            marke.flaeche_fuer(&m, zu3))
        let by3: f64 = zeichnen.text_mitte_y(&z, y, ch3, size3)
        let e3b: f64 = zeichnen.text(&z, x, by3, bw3, size3,
            marke.text_fuer(&m, zu3), (&t_norm[0]) as u64, 6,
            zeichnen.text_M)
        x = x + bw3 + marke.marke_px(&m, (*fo3).gap) as f64
        j = j + 1
    }

    // ---- HERAUSSCHREIBEN
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&cv, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < rt.c_length(pfad) {
        rt.buf_push(&pf, rt.ld8(pfad, k))
        k = k + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 10] = "PNG OK\n\0\0\0"
    rt.write_everything(1, (&okm[0]) as u64, 7)
    zeichnen.zeichner_frei(&z)
    canvas.canvas_free(&cv)
    return 0
}
