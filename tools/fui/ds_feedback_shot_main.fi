import std.rt
import fui.safeout
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.painter
import fui.render
import fui.theme
import fui.kit
import fui.kitcolor
import fui.ds_combo
import fui.ds_fbtok
import fui.ds_infobar
import fui.ds_swatch
import fui.ds_toast
import plat.sysfont

const W: usize = 640
const H: usize = 560

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
}

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) -> bool {
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    var ok: bool = false
    if png.write_png(cv, &out) {
        ok = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
    return ok
}

fn page_new(dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    kitcolor.kit_theme(&(*p).m, dark)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    if !canvas.canvas_init(&(*p).cv, W, H) || !painter.painter_init(&(*p).z, &(*p).cv, W, H) { return 0 as u64 as *mut Page }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn paint_page(p: *mut Page, dark: bool) {
    let c: *mut render.Ctx = &(*p).c
    var bg: u32 = 0xfff3f3f3 as u32
    if dark { bg = 0xff202020 as u32 }
    canvas.canvas_clear(&(*p).cv, bg)
    let b: *mut ds_infobar.Bar = ds_infobar.bar_new()
    var y: f64 = 16.0
    y = y + ds_infobar.draw(b, c, 16.0, y, 400.0, ds_fbtok.INFO, "Update ready", "Restart to finish.", "Restart", true, 0.0 - 1.0, 0.0 - 1.0) + 8.0
    y = y + ds_infobar.draw(b, c, 16.0, y, 400.0, ds_fbtok.SUCCESS, "Saved", "Profile stored.", "", true, 0.0 - 1.0, 0.0 - 1.0) + 8.0
    y = y + ds_infobar.draw(b, c, 16.0, y, 400.0, ds_fbtok.WARNING, "Low disk space", "Free 2 GB left.", "Clean up", true, 0.0 - 1.0, 0.0 - 1.0) + 8.0
    y = y + ds_infobar.draw(b, c, 16.0, y, 400.0, ds_fbtok.ERROR, "Upload failed", "The server did not answer, check the network.", "Retry", true, 0.0 - 1.0, 0.0 - 1.0) + 16.0
    let s: *mut ds_swatch.Swatch = ds_swatch.swatch_new()
    ds_swatch.set_custom(s, true)
    ds_swatch.set_rgb(s, 0x0078d4 as u32)
    ds_swatch.draw(s, c, 16.0, y, 400.0, "Accent", 0.0 - 1.0, 0.0 - 1.0)
    let cb: *mut ds_combo.Combo = ds_combo.combo_new()
    ds_combo.set_items(cb, "Apple|Apricot|Banana|Blueberry|Cherry|Grape|Lemon|Mango|Orange|Peach|Pear|Plum")
    ds_combo.draw(cb, c, 432.0, 16.0, 192.0, "Fruit", "Search", 0.0 - 1.0, 0.0 - 1.0, 560.0)
    ds_combo.press(cb, 460.0, 34.0)
    ds_combo.text(cb, 112 as u32, 0 as u32)
    ds_combo.end(cb, c)
    let f: *mut ds_toast.Feed = ds_toast.feed_new()
    ds_toast.push(f, ds_fbtok.INFO, "Saved", "Profile stored", "Undo", 1000, 60000)
    ds_toast.push(f, ds_fbtok.WARNING, "Battery", "15 percent left", "", 1000, 60000)
    ds_toast.push(f, ds_fbtok.ERROR, "Failed", "Disk full", "Details", 1000, 60000)
    ds_toast.draw(f, c, 640.0, 560.0, 2000)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 { return 2 }
    let dir: u64 = rt.arg_ptr(start, 1)
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("no system font\n")
        return 9
    }
    var d: usize = 0
    while d < 2 {
        let dark: bool = d == 1
        let p: *mut Page = page_new(dark, fs as u64)
        if p as u64 == 0 { return 3 }
        paint_page(p, dark)
        var ok: bool = false
        if dark { ok = save(&(*p).cv, dir, "ds_feedback-dark.png") } else { ok = save(&(*p).cv, dir, "ds_feedback-light.png") }
        if !ok { return 4 }
        d = d + 1
    }
    say("DS_FEEDBACK_SHOT OK\n")
    return 0
}
