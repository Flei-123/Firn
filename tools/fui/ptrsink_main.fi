import std.rt
import fui.theme
import fui.painter
import fui.render
import fui.scene
import plat.fuiwirt

static mut BAD: usize = 0
static mut SEEN: usize = 0
static mut LAST_KIND: u32 = 0
static mut LAST_ID: u32 = 0
static mut LAST_TYPE: u32 = 0
static mut LAST_PRESSURE_MILLI: i64 = 0
static mut CONSUME: bool = true
static mut HOOKED: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn sink(ud: u64, kind: u32, id: u32, ptype: u32, x: f64, y: f64, pressure: f64) -> bool {
    SEEN = SEEN + 1
    LAST_KIND = kind
    LAST_ID = id
    LAST_TYPE = ptype
    LAST_PRESSURE_MILLI = (pressure * 1000.0) as i64
    return CONSUME
}

fn hook(ud: u64, kind: u32, x: f64, y: f64) -> bool {
    HOOKED = HOOKED + 1
    return false
}

fn main() -> i32 {
    var m: theme.Theme = theme.theme_new(false)
    var sc: scene.Scene = scene.scene_new()
    var z: painter.Painter = painter.painter_new()
    var c: render.Ctx = render.ctx_new(&m, &z)
    var w: fuiwirt.Host = fuiwirt.host_new(&sc, &c)
    fuiwirt.host_bind(&w)
    fuiwirt.host_set_hook(&w, 0, hook)
    check(!fuiwirt.host_has_pointer_sink(&w), "no sink by default")
    let a: u32 = fuiwirt.host_pointer_p(&w, fuiwirt.PE_DOWN, 1 as u32, 2 as u32, true, 10.0, 20.0, 0.4, 5)
    check(SEEN == 0, "without a sink nothing is delivered")
    let hooked0: usize = HOOKED
    check(hooked0 > 0, "without a sink the host handling reaches the hook")
    fuiwirt.host_set_pointer_sink(&w, 0, sink)
    check(fuiwirt.host_has_pointer_sink(&w), "sink installed")
    let b: u32 = fuiwirt.host_pointer_p(&w, fuiwirt.PE_DOWN, 3 as u32, 3 as u32, true, 10.0, 20.0, 0.625, 6)
    check(SEEN == 1 && LAST_KIND == fuiwirt.PE_DOWN && LAST_ID == 3 as u32 && LAST_TYPE == 3 as u32, "pen down delivered with id and type")
    check(LAST_PRESSURE_MILLI == 625, "pressure delivered")
    check(HOOKED == hooked0, "a consumed record never reaches the host handling")
    let d: u32 = fuiwirt.host_pointer_p(&w, fuiwirt.PE_MOVE, 4 as u32, 2 as u32, false, 30.0, 40.0, 0.0, 7)
    check(SEEN == 2 && LAST_ID == 4 as u32, "second finger delivered too")
    let e: u32 = fuiwirt.host_pointer(&w, fuiwirt.PE_UP, 3 as u32, 3 as u32, true, 10.0, 20.0, 8)
    check(SEEN == 3 && LAST_KIND == fuiwirt.PE_UP && LAST_PRESSURE_MILLI == 0, "plain host_pointer delivers pressure 0 (unknown)")
    CONSUME = false
    let hooked1: usize = HOOKED
    let f: u32 = fuiwirt.host_pointer_p(&w, fuiwirt.PE_MOVE, 1 as u32, 1 as u32, true, 50.0, 60.0, 0.0, 9)
    check(SEEN == 4 && HOOKED > hooked1, "not consumed: the host handles it as before")
    if BAD == 0 {
        say("PTRSINK PASSED\n")
        return 0
    }
    say("PTRSINK FAILED\n")
    return 1
}
