// SPDX-License-Identifier: MPL-2.0
// tools/fui/uisvg_main.fi -- DAS PORTIERTE lib/svg, IM FIRN-BAUM GEPRUEFT.
//
// Diese Pruefung gehoert NICHT zu Certus, sondern zur Portierung: sie
// beweist, dass `lib/svg` im Firn-Baum dasselbe tut wie dort, und dass die
// beiden Stellen, die dabei angefasst wurden, richtig sind:
//
//   * `raster.raster_finish_evenodd` wurde in die NEUERE Fassung von
//     lib/font/raster.fi nachgetragen (die Certus-Fassung kennt die
//     Buchfuehrung ueber die geschriebenen Zellen nicht). Wenn dabei etwas
//     schiefgegangen ist, hat ein `fill-rule="evenodd"` kein Loch -- also
//     wird genau das nachgemessen.
//   * `ttf.font_outline_m` wurde als Huelle ergaenzt.
//   * `svg.fontsel` ersetzt die Schriftauswahl von css-fonts-4.
//
// Und die Zusatzforderung von Justin (13.09.2026): eingefaerbte Flaechen
// muessen die AKZENTFARBE aus theme.fi annehmen koennen. In SVG ist das
// `currentColor`, und Pruefung 4 rechnet die Kanaele dagegen nach.
import std.rt
import paint.canvas
import paint.png
import fui.painter
import fui.uiimage
import fui.uisvg

const W: usize = 96
const H: usize = 96

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, got: i64, want: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 52 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var h1: [u8; 5] = " got "
    rt.buf_push_bytes(&t, (&h1[0]) as u64, 5)
    rt.buf_push_dec_i64(&t, got)
    var h2: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&h2[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, want)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn say(s: u64, n: usize) { rt.write_everything(1, s, n) }

// Ein Bildpunkt des gerasterten Symbols, gerades RGBA.
fn ch(ic: *mut uisvg.Icon, x: usize, y: usize, which: usize) -> i64 {
    var v: uiimage.Image = uisvg.icon_view(ic)
    let c: u32 = uiimage.image_pixel_at(&v, x, y)
    if which == 3 { return ((c >> 24) & 255 as u32) as i64 }
    if which == 0 { return ((c >> 16) & 255 as u32) as i64 }
    if which == 1 { return ((c >> 8) & 255 as u32) as i64 }
    return (c & 255 as u32) as i64
}

fn near(a: i64, b: i64, tol: i64) -> bool {
    var d: i64 = a - b
    if d < 0 { d = 0 - d }
    return d <= tol
}

// Wieviele Punkte tragen ueberhaupt Deckung.
fn ink(ic: *mut uisvg.Icon, w: usize, h: usize) -> i64 {
    var n: i64 = 0
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            if ch(ic, x, y, 3) > 60 { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

// Teilweise gedeckte Punkte -- das Mass fuer die Kantenglaettung.
fn soft(ic: *mut uisvg.Icon, w: usize, h: usize) -> i64 {
    var n: i64 = 0
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            let a: i64 = ch(ic, x, y, 3)
            if a > 12 && a < 243 { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn main() -> i32 {
    // ================================================================
    var t1: [u8; 50] = "== 1. DAS PORTIERTE lib/svg RASTERT UEBERHAUPT ==\n"
    say((&t1[0]) as u64, 50)

    var d1: [u8; 88] = "<svg viewBox='0 0 10 10'><rect x='0' y='0' width='10' height='10' fill='#c86432'/></svg>"
    var ic1: uisvg.Icon = uisvg.icon_new()
    let ok1: bool = uisvg.icon_render(&ic1, (&d1[0]) as u64, 88, 32, 32,
        0 as u32, 0)
    var n1: [u8; 28] = "1 ein Quadrat wird gerastert"
    report((&n1[0]) as u64, 28, ok1, ok1 as i64, 1)
    var n1b: [u8; 24] = "1 und es ist 32x32 gross"
    report((&n1b[0]) as u64, 24, uisvg.icon_w(&ic1) == 32,
        uisvg.icon_w(&ic1) as i64, 32)

    // ================================================================
    var t2: [u8; 44] = "\n== 2. DIE KANAELE SIND NICHT VERTAUSCHT ==\n"
    say((&t2[0]) as u64, 44)

    // #c86432 hat drei VERSCHIEDENE Kanaele -- ein Grau oder ein reines
    // Rot wuerde eine Vertauschung ueberleben, ohne aufzufallen.
    var n2r: [u8; 20] = "2 #c86432 -> rot 200"
    report((&n2r[0]) as u64, 20, near(ch(&ic1, 16, 16, 0), 200, 2),
        ch(&ic1, 16, 16, 0), 200)
    var n2g: [u8; 22] = "2 #c86432 -> gruen 100"
    report((&n2g[0]) as u64, 22, near(ch(&ic1, 16, 16, 1), 100, 2),
        ch(&ic1, 16, 16, 1), 100)
    var n2b: [u8; 20] = "2 #c86432 -> blau 50"
    report((&n2b[0]) as u64, 20, near(ch(&ic1, 16, 16, 2), 50, 2),
        ch(&ic1, 16, 16, 2), 50)

    // ================================================================
    var t3: [u8; 68] = "\n== 3. fill-rule evenodd LAESST DAS LOCH (raster_finish_evenodd) ==\n"
    say((&t3[0]) as u64, 68)

    // Grosses Quadrat mit kleinem darin, GLEICHE Richtung. Unter
    // even-odd ist das Innere ein Loch, unter nonzero gefuellt. Das ist
    // die Gegenprobe fuer die nachgetragene Rasterfunktion.
    var d3a: [u8; 111] = "<svg viewBox='0 0 20 20'><path fill-rule='evenodd' fill='black' d='M2 2 H18 V18 H2 Z M7 7 H13 V13 H7 Z'/></svg>"
    var ic3: uisvg.Icon = uisvg.icon_new()
    uisvg.icon_render(&ic3, (&d3a[0]) as u64, 111, 40, 40, 0 as u32, 0)
    var n3a: [u8; 33] = "3 evenodd: die Mitte ist ein LOCH"
    report((&n3a[0]) as u64, 33, ch(&ic3, 20, 20, 3) < 20,
        ch(&ic3, 20, 20, 3), 0)
    var n3b: [u8; 38] = "3 evenodd: der Ring selbst ist gedeckt"
    report((&n3b[0]) as u64, 38, ch(&ic3, 9, 20, 3) > 235,
        ch(&ic3, 9, 20, 3), 255)

    var d3b: [u8; 111] = "<svg viewBox='0 0 20 20'><path fill-rule='nonzero' fill='black' d='M2 2 H18 V18 H2 Z M7 7 H13 V13 H7 Z'/></svg>"
    var ic3b: uisvg.Icon = uisvg.icon_new()
    uisvg.icon_render(&ic3b, (&d3b[0]) as u64, 111, 40, 40, 0 as u32, 0)
    var n3c: [u8; 33] = "3 nonzero: derselbe Pfad ist VOLL"
    report((&n3c[0]) as u64, 33, ch(&ic3b, 20, 20, 3) > 235,
        ch(&ic3b, 20, 20, 3), 255)

    // ================================================================
    var t4: [u8; 48] = "\n== 4. currentColor NIMMT DIE AKZENTFARBE AN ==\n"
    say((&t4[0]) as u64, 48)

    // So liefern Lucide, Feather und Material ihre Symbole aus.
    var d4: [u8; 93] = "<svg viewBox='0 0 10 10'><rect x='0' y='0' width='10' height='10' fill='currentColor'/></svg>"
    var ic4: uisvg.Icon = uisvg.icon_new()
    // 0xFF3264C8 = 4281492680 -- rot 50, gruen 100, blau 200. Wieder drei
    // verschiedene Kanaele, damit eine Vertauschung auffaellt.
    uisvg.icon_render(&ic4, (&d4[0]) as u64, 93, 24, 24,
        4281492680 as u32, 0)
    var n4r: [u8; 24] = "4 currentColor -> rot 50"
    report((&n4r[0]) as u64, 24, near(ch(&ic4, 12, 12, 0), 50, 2),
        ch(&ic4, 12, 12, 0), 50)
    var n4g: [u8; 27] = "4 currentColor -> gruen 100"
    report((&n4g[0]) as u64, 27, near(ch(&ic4, 12, 12, 1), 100, 2),
        ch(&ic4, 12, 12, 1), 100)
    var n4b: [u8; 26] = "4 currentColor -> blau 200"
    report((&n4b[0]) as u64, 26, near(ch(&ic4, 12, 12, 2), 200, 2),
        ch(&ic4, 12, 12, 2), 200)

    // ================================================================
    var t5: [u8; 48] = "\n== 5. JE GROESSE NEU GERASTERT, ALSO SCHARF ==\n"
    say((&t5[0]) as u64, 48)

    // Ein Kreis hat bei JEDER Groesse eine gekruemmte Kante. Waere das
    // Symbol einmal gerastert und dann vergroessert, haette die grosse
    // Fassung nicht mehr weiche Punkte als die kleine.
    var d5: [u8; 76] = "<svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='11' fill='black'/></svg>"
    var s16: uisvg.Icon = uisvg.icon_new()
    uisvg.icon_render(&s16, (&d5[0]) as u64, 76, 16, 16, 0 as u32, 0)
    var s64: uisvg.Icon = uisvg.icon_new()
    uisvg.icon_render(&s64, (&d5[0]) as u64, 76, 64, 64, 0 as u32, 0)
    let a16: i64 = soft(&s16, 16, 16)
    let a64: i64 = soft(&s64, 64, 64)
    var n5a: [u8; 33] = "5 bei 16 ist die Kante geglaettet"
    report((&n5a[0]) as u64, 33, a16 > 10, a16, 10)
    var n5b: [u8; 44] = "5 bei 64 sind es deutlich mehr weiche Punkte"
    report((&n5b[0]) as u64, 44, a64 > a16 * 2, a64, a16 * 2)
    // Die Flaeche skaliert mit dem Quadrat: 64/16 = 4, also etwa 16x.
    let i16: i64 = ink(&s16, 16, 16)
    let i64v: i64 = ink(&s64, 64, 64)
    var n5c: [u8; 38] = "5 und die Flaeche waechst etwa 16-fach"
    report((&n5c[0]) as u64, 38, i64v > i16 * 13 && i64v < i16 * 19,
        i64v, i16 * 16)

    // ================================================================
    var t6: [u8; 48] = "\n== 6. DER BOGEN A UND DIE GRUPPEN-VERERBUNG ==\n"
    say((&t6[0]) as u64, 48)

    // Ein Viertelkreis als Bogen, gegen denselben als Kubik. Die
    // Bogenrechnung (Mitte aus den Endpunkten, SVG F.6.5) ist die
    // Stelle, an der die meisten Fassungen falsch sind.
    var d6a: [u8; 87] = "<svg viewBox='0 0 20 20'><path fill='black' d='M2 18 L2 2 A16 16 0 0 1 18 18 Z'/></svg>"
    var ic6a: uisvg.Icon = uisvg.icon_new()
    uisvg.icon_render(&ic6a, (&d6a[0]) as u64, 87, 80, 80, 0 as u32, 0)
    var d6b: [u8; 95] = "<svg viewBox='0 0 20 20'><path fill='black' d='M2 18 L2 2 C10.8365 2 18 9.1635 18 18 Z'/></svg>"
    var ic6b: uisvg.Icon = uisvg.icon_new()
    uisvg.icon_render(&ic6b, (&d6b[0]) as u64, 95, 80, 80, 0 as u32, 0)
    let ia: i64 = ink(&ic6a, 80, 80)
    let ib: i64 = ink(&ic6b, 80, 80)
    var diff: i64 = ia - ib
    if diff < 0 { diff = 0 - diff }
    var n6a: [u8; 41] = "6 Bogen und Kubik decken dieselbe Flaeche"
    report((&n6a[0]) as u64, 41, diff * 100 < ib, diff, 0)

    // Die Gruppe gibt ihre Fuellung an das Kind weiter.
    var d6c: [u8; 95] = "<svg viewBox='0 0 20 10'><g fill='#c86432'><rect x='0' y='0' width='10' height='10'/></g></svg>"
    var ic6c: uisvg.Icon = uisvg.icon_new()
    uisvg.icon_render(&ic6c, (&d6c[0]) as u64, 95, 40, 20, 0 as u32, 0)
    var n6b: [u8; 39] = "6 das Kind erbt die Fuellung der Gruppe"
    report((&n6b[0]) as u64, 39, near(ch(&ic6c, 10, 10, 0), 200, 3),
        ch(&ic6c, 10, 10, 0), 200)

    uisvg.icon_free(&ic1)
    uisvg.icon_free(&ic3)
    uisvg.icon_free(&ic3b)
    uisvg.icon_free(&ic4)
    uisvg.icon_free(&s16)
    uisvg.icon_free(&s64)
    uisvg.icon_free(&ic6a)
    uisvg.icon_free(&ic6b)
    uisvg.icon_free(&ic6c)

    if G_ERRORS != 0 {
        var bad: [u8; 15] = "\nUISVG FAILED.\n"
        say((&bad[0]) as u64, 15)
        return 1
    }
    var good: [u8; 15] = "\nUISVG PASSED.\n"
    say((&good[0]) as u64, 15)
    return 0
}
