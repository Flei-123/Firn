// SPDX-License-Identifier: MPL-2.0
// tools/fui/menuview_main.fi -- THE CHECK OF THE POPUP MENU WIDGET AND THE
// WHOLE PATH FROM A RIGHT CLICK TO A RUNNING ACTION (lib/fui/menuview.fi,
// lib/fui/ctxmenu.fi, lib/plat/fuiwirt.fi; roadmap r161).
//
// Without a window: a page with a button is built, laid out and painted into
// a canvas; the events a window would send are made by hand and the pixels
// are read back.
//
//   1. THE PICTURE: frame, separator, highlight, disabled / danger colours,
//      icon on the row's MIDLINE (rule r441), shortcut at the right, tick and
//      radio dot, submenu arrow; dark and light.
//   2. THE HIT TEST: entry / frame / outside, deepest level wins.
//   3. PLACEMENT ON THE SCREEN: flip left and up at the edges, submenu flip,
//      touch row height.
//   4. ACCESSIBILITY: role, name, checked, expanded of the menu's own tree.
//   5. THE HOST PATH: right click -> EV_CONTEXT -> menu; the page does not
//      hear what the menu takes; an outside press passes through; menu key,
//      Shift+F10, Esc; a prevented request opens nothing; the lock.
//   6. SPEED: opening and painting a menu in under 16 ms.
//
//     firnc -o /tmp/menuview tools/fui/menuview_main.fi && /tmp/menuview [dir]
//
// The last line is MENUVIEW PASSED or MENUVIEW FAILED.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.scene
import fui.sheet
import fui.style
import fui.flex
import fui.widget
import fui.control
import fui.event
import fui.action
import fui.ctxmenu
import fui.menuview
import fui.a11y
import fui.lucide
import plat.fuiwirt
import plat.sysfont

static mut BAD: usize = 0
static mut RAN: [i64; 16] = [0; 16]
static mut PREVENT: i64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_int(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn eq(what: str, got: i64, want: i64) {
    if got == want {
        say("  ok    ")
        say(what)
        say("\n")
    } else {
        say("  WRONG ")
        say(what)
        say("  got ")
        say_int(got)
        say(" want ")
        say_int(want)
        say("\n")
        BAD = BAD + 1
    }
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = rt.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64,
            mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

fn now_ms() -> f64 {
    var ts: [u64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as u64)
    return (ts[0] as f64) * 1000.0 + (ts[1] as f64) / 1000000.0
}

// ------------------------------------------------------------------ handlers

fn h_count(ud: u64, cx: *mut action.ActCtx) {
    RAN[ud as usize] = RAN[ud as usize] + 1
}

fn en_false(ud: u64, cx: *mut action.ActCtx) -> bool { return false }
fn chk_on(ud: u64, cx: *mut action.ActCtx) -> u32 { return action.CHK_ON }
fn chk_off(ud: u64, cx: *mut action.ActCtx) -> u32 { return action.CHK_OFF }

static mut A: [usize; 16] = [0; 16]

// The menu of the page: Open (icon), Copy (icon, Ctrl+C), Paste (disabled,
// Ctrl+V), | Show hidden (check, on), Sort by > (radio By name on, By size
// off), | Delete (danger, Del).
fn prov_page(ud: u64, pc: *mut ctxmenu.ProviderCtx) {
    let a: usize = ctxmenu.pc_add(pc, A[0])
    let b: usize = ctxmenu.pc_add(pc, A[1])
    let c: usize = ctxmenu.pc_add(pc, A[2])
    let d: usize = ctxmenu.pc_add(pc, A[3])
    let s: usize = ctxmenu.pc_submenu(pc, "&Sort by", action.ICON_NONE, action.G_VIEW)
    let x: usize = ctxmenu.pc_add_to(pc, s, A[4])
    let y: usize = ctxmenu.pc_add_to(pc, s, A[5])
    let z: usize = ctxmenu.pc_add(pc, A[6])
}

fn fill(r: *mut action.Actions) {
    action.act_set_app(r, "demo")
    A[0] = action.act_add(r, "open", "&Open", h_count, 0 as u64)
    action.act_set_group(r, A[0], action.G_PRIMARY)
    action.act_set_icon(r, A[0], lucide.lucide_find("folder-open".p as u64, 11))
    A[1] = action.act_add(r, "copy", "&Copy", h_count, 1 as u64)
    action.act_set_icon(r, A[1], lucide.lucide_find("copy".p as u64, 4))
    action.act_set_shortcut(r, A[1], 67 as u32, action.MOD_CTRL)
    A[2] = action.act_add(r, "paste", "&Paste", h_count, 2 as u64)
    action.act_set_icon(r, A[2], lucide.lucide_find("clipboard".p as u64, 9))
    action.act_set_shortcut(r, A[2], 86 as u32, action.MOD_CTRL)
    action.act_set_enabled(r, A[2], en_false)
    A[3] = action.act_add(r, "hidden", "Show &hidden files", h_count, 3 as u64)
    action.act_set_group(r, A[3], action.G_VIEW)
    action.act_set_check(r, A[3], chk_on)
    A[4] = action.act_add(r, "sortname", "By name", h_count, 4 as u64)
    action.act_set_radio(r, A[4], chk_on)
    A[5] = action.act_add(r, "sortsize", "By size", h_count, 5 as u64)
    action.act_set_radio(r, A[5], chk_off)
    A[6] = action.act_add(r, "delete", "&Delete", h_count, 6 as u64)
    action.act_danger(r, A[6])
    action.act_set_icon(r, A[6], lucide.lucide_find("trash".p as u64, 5))
    action.act_set_shortcut(r, A[6], action.SK_DELETE, 0 as u32)
}

// ------------------------------------------------------------------ the page

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
    sh: sheet.Sheet,
    sc: scene.Scene,
    w: usize,
    h: usize,
    r: action.Actions,
    cm: ctxmenu.Ctxm,
    host: fuiwirt.Host,
    rt: event.Router,
    mv: *mut menuview.MenuView,
    btn: usize,
    pane: usize,
    clicks: i64,
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(8 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    (*p).w = w
    (*p).h = h
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    (*p).sh = sheet.sheet_new()
    (*p).sc = scene.scene_new()
    (*p).r = action.actions_new()
    fill(&(*p).r)
    (*p).cm = ctxmenu.ctxm_new()
    ctxmenu.ctxm_set_actions(&(*p).cm, &(*p).r)
    // page: root(1) > pane(2) > button "Run"(3)
    let root: usize = scene.scene_box(&(*p).sc, scene.SCENE_NONE, 0 as u32,
        flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_START)
    scene.node_set_id(&(*p).sc, root, 1 as u32)
    let pane: usize = scene.scene_box(&(*p).sc, root, 0 as u32, flex.FLEX_ROW,
        flex.JUSTIFY_START, flex.AL_START)
    scene.node_set_id(&(*p).sc, pane, 2 as u32)
    scene.node_set_size(&(*p).sc, pane, (w as f64) - 20.0, (h as f64) - 20.0)
    let btn: usize = scene.scene_widget(&(*p).sc, pane, widget.KIND_BUTTON, "Run".p as u64, 3)
    scene.node_set_id(&(*p).sc, btn, 3 as u32)
    scene.node_set_size(&(*p).sc, btn, 100.0, 40.0)
    (*p).btn = btn
    (*p).pane = pane
    let g1: bool = ctxmenu.ctx_provider_key(&(*p).cm, 2 as u32, prov_page, 0 as u64)
    (*p).host = fuiwirt.host_new(&(*p).sc, &(*p).c)
    (*p).rt = event.router_new()
    (*p).mv = menuview.mv_new(&(*p).cm)
    menuview.mv_bind((*p).mv, &(*p).c)
    menuview.mv_attach((*p).mv, &(*p).sc)
    menuview.mv_set_bounds((*p).mv, 0.0, 0.0, w as f64, h as f64)
    fuiwirt.host_set_context(&(*p).host, (*p).mv as u64, menuview.mv_request)
    fuiwirt.host_set_popup(&(*p).host, (*p).mv as u64, menuview.mv_is_open,
        menuview.mv_pointer, menuview.mv_key, menuview.mv_char, menuview.mv_tick,
        menuview.mv_wait)
    fuiwirt.host_set_popup_note(&(*p).host, menuview.mv_note)
    return p
}

fn page_layout(p: *mut Page) {
    scene.scene_style(&(*p).sc, &(*p).sh)
    scene.scene_measure(&(*p).sc, &(*p).c)
    scene.scene_layout(&(*p).sc, &(*p).c, 0.0, 0.0, (*p).w as f64, (*p).h as f64)
    fuiwirt.host_bind(&(*p).host)
}

fn paint(p: *mut Page) {
    let base: u32 = theme.opaque(render.color_of(&(*p).c, style.color_token(style.TOK_BASE)))
    canvas.canvas_clear(&(*p).cv, base)
    scene.scene_draw(&(*p).sc, &(*p).c)
    menuview.mv_draw((*p).mv, &(*p).c)
}

fn px(p: *mut Page, x: f64, y: f64) -> u32 {
    return canvas.canvas_get(&(*p).cv, x as usize, y as usize)
}

fn tok(p: *mut Page, t: u32) -> u32 {
    return theme.opaque(render.color_of(&(*p).c, style.color_token(t)))
}

fn row(p: *mut Page, slot: usize, out: *mut [f64; 4]) -> bool {
    return menuview.mv_row_rect((*p).mv, slot, out)
}

// does the box (x0,y0,w,h) hold a pixel of colour `want`?
fn has_colour(p: *mut Page, x0: f64, y0: f64, w: f64, h: f64, want: u32) -> bool {
    var y: f64 = y0
    while y < y0 + h {
        var x: f64 = x0
        while x < x0 + w {
            if px(p, x, y) == want { return true }
            x = x + 1.0
        }
        y = y + 1.0
    }
    return false
}

// The vertical extent of everything in the box that differs from `bg`:
// out = first row, last row; false when nothing differs.
fn ink_rows(p: *mut Page, x0: f64, y0: f64, w: f64, h: f64, bg: u32, out: *mut [f64; 2]) -> bool {
    var first: f64 = 0.0 - 1.0
    var last: f64 = 0.0 - 1.0
    var y: f64 = y0
    while y < y0 + h {
        var x: f64 = x0
        var any: bool = false
        while x < x0 + w {
            if px(p, x, y) != bg { any = true }
            x = x + 1.0
        }
        if any {
            if first < 0.0 { first = y }
            last = y
        }
        y = y + 1.0
    }
    (*out)[0] = first
    (*out)[1] = last
    return first >= 0.0
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

// Slots after a mouse request on the pane:
//  0 Open | 1 sep | 2 Copy | 3 Paste | 4 sep | 5 Show hidden | 6 Sort by> | 7 sep
//  8 Delete | 9 By name | 10 By size
fn run_picture(dir: u64, font: u64, dark: bool) {
    if dark {
        say("== 1. THE PICTURE, dark ==\n")
    } else {
        say("== 1. THE PICTURE, light ==\n")
    }
    let p: *mut Page = page_new(640, 480, dark, font)
    page_layout(p)
    let cm: *mut ctxmenu.Ctxm = &(*p).cm
    check(ctxmenu.ctx_request(cm, &(*p).sc, (*p).btn, 120.0, 90.0, 90.0, action.SRC_MOUSE, 0 as u32, 0), "request on the button")
    eq("nine slots on the top level", ctxmenu.menu_level_count(cm, ctxmenu.NONE) as i64, 9)
    paint(p)
    eq("one level shown", menuview.mv_levels((*p).mv) as i64, 1)
    var fr: [f64; 4] = [0.0; 4]
    check(menuview.mv_rect((*p).mv, 0, &fr), "the frame has a rectangle")
    check(near(fr[0], 120.0, 0.5) && near(fr[1], 90.0, 0.5), "it opens at the pointer")
    check(fr[0] + fr[2] <= 640.0 && fr[1] + fr[3] <= 480.0, "and fits the window")
    // pixels: the frame's interior is the raised surface colour
    check(px(p, fr[0] + fr[2] - 3.0, fr[1] + fr[3] / 2.0) == tok(p, style.TOK_SURFACE_RAISED), "the frame is the raised surface colour")
    check(px(p, fr[0] + fr[2] / 2.0, fr[1]) != tok(p, style.TOK_BASE), "the frame has a border")
    var r0: [f64; 4] = [0.0; 4]
    var r1: [f64; 4] = [0.0; 4]
    var r2: [f64; 4] = [0.0; 4]
    var r3: [f64; 4] = [0.0; 4]
    var r4: [f64; 4] = [0.0; 4]
    var r7: [f64; 4] = [0.0; 4]
    var rc: [f64; 4] = [0.0; 4]
    check(row(p, 0 as usize, &r0) && row(p, 1 as usize, &r3) && row(p, 2 as usize, &rc) && row(p, 3 as usize, &r2)
        && row(p, 5 as usize, &r4) && row(p, 8 as usize, &r7), "all rows have rectangles")
    r1 = rc
    check(r0[3] >= 32.0 && near(r0[3], r1[3], 0.5), "rows are at least 32 high and equal")
    check(r3[3] < r0[3] / 2.0, "a separator row is thin")
    check(near(r3[1], r0[1] + r0[3], 0.5), "rows stack without gaps")
    // the separator line
    check(has_colour(p, r3[0], r3[1], r3[2], r3[3], tok(p, style.TOK_SEPARATOR)), "the separator line is in the separator colour")
    // text: Copy is in the text colour, Paste (disabled) in the disabled colour, Delete in the error colour
    check(has_colour(p, r1[0] + 30.0, r1[1], r1[2] - 30.0, r1[3], tok(p, style.TOK_TEXT)), "Copy is in the text colour")
    check(has_colour(p, r2[0] + 30.0, r2[1], r2[2] - 30.0, r2[3], tok(p, style.TOK_TEXT_DISABLED)), "Paste (disabled) is in the disabled colour")
    check(!has_colour(p, r2[0] + 30.0, r2[1], r2[2] - 30.0, r2[3], tok(p, style.TOK_TEXT)), "... and nowhere in the text colour")
    check(has_colour(p, r7[0] + 30.0, r7[1], r7[2] - 30.0, r7[3], tok(p, style.TOK_ERROR)), "Delete is in the error colour")
    // the shortcut at the right of Copy, muted
    check(has_colour(p, r1[0] + r1[2] * 0.6, r1[1], r1[2] * 0.4, r1[3], tok(p, style.TOK_TEXT_MUTED)), "the shortcut Ctrl+C is at the right, muted")
    check(!has_colour(p, r0[0] + r0[2] * 0.6, r0[1], r0[2] * 0.4, r0[3], tok(p, style.TOK_TEXT_MUTED)), "Open has no shortcut text")
    // ICONS ON THE MIDLINE (rule r441): the ink of the icon column is centred on the row
    var ink: [f64; 2] = [0.0; 2]
    let bg: u32 = tok(p, style.TOK_SURFACE_RAISED)
    check(ink_rows(p, r0[0] + 4.0, r0[1] + 1.0, 24.0, r0[3] - 2.0, bg, &ink), "Open has an icon")
    check(near((ink[0] + ink[1]) / 2.0, r0[1] + r0[3] / 2.0, 1.0), "the icon of Open is centred on the row's midline (+-1 px)")
    check(ink_rows(p, r1[0] + 4.0, r1[1] + 1.0, 24.0, r1[3] - 2.0, bg, &ink), "Copy has an icon")
    check(near((ink[0] + ink[1]) / 2.0, r1[1] + r1[3] / 2.0, 1.0), "the icon of Copy is centred on the row's midline")
    check(ink_rows(p, r7[0] + 4.0, r7[1] + 1.0, 24.0, r7[3] - 2.0, bg, &ink), "Delete has an icon")
    check(near((ink[0] + ink[1]) / 2.0, r7[1] + r7[3] / 2.0, 1.0), "the icon of Delete is centred on the row's midline")
    // the tick of 'Show hidden' is a check mark in the same column, on the midline
    check(ink_rows(p, r4[0] + 4.0, r4[1] + 1.0, 24.0, r4[3] - 2.0, bg, &ink), "Show hidden is ticked")
    check(near((ink[0] + ink[1]) / 2.0, r4[1] + r4[3] / 2.0, 1.0), "the tick is centred on the row's midline")
    // the submenu arrow of 'Sort by'
    var r5: [f64; 4] = [0.0; 4]
    check(row(p, 6 as usize, &r5), "Sort by has a rectangle")
    check(ink_rows(p, r5[0] + r5[2] - 24.0, r5[1] + 1.0, 22.0, r5[3] - 2.0, bg, &ink), "Sort by has an arrow at the right")
    check(near((ink[0] + ink[1]) / 2.0, r5[1] + r5[3] / 2.0, 1.0), "the arrow is centred on the row's midline")
    // the highlight of the focused row
    let hv: u32 = ctxmenu.ctx_hover(cm, 2 as usize, 0)
    paint(p)
    check(px(p, r1[0] + 2.0, r1[1] + 2.0) == tok(p, style.TOK_SELECTION), "the focused row is highlighted in the selection colour")
    check(has_colour(p, r1[0] + 30.0, r1[1], r1[2] * 0.5, r1[3], tok(p, style.TOK_SELECTION_TEXT)), "its text is in the selection-text colour")
    check(px(p, r0[0] + 2.0, r0[1] + 2.0) == bg, "other rows are not highlighted")
    // a disabled row, focused: a quiet highlight, text stays disabled
    let hv2: u32 = ctxmenu.ctx_hover(cm, 3 as usize, 0)
    paint(p)
    check(px(p, r2[0] + 2.0, r2[1] + 2.0) == tok(p, style.TOK_BUTTON_HOVER), "a disabled row focused gets the quiet highlight")
    if dark {
        save(&(*p).cv, dir, "ctxmenu-dark.png")
    } else {
        save(&(*p).cv, dir, "ctxmenu-light.png")
    }
    // the submenu, opened by the keyboard
    let k1: u32 = ctxmenu.ctx_key(cm, action.SK_END, 0 as u32)
    let k2: u32 = ctxmenu.ctx_key(cm, action.SK_UP, 0 as u32)
    eq("on 'Sort by'", ctxmenu.ctx_focus(cm, 0) as i64, 6)
    let k3: u32 = ctxmenu.ctx_key(cm, action.SK_RIGHT, 0 as u32)
    paint(p)
    eq("two levels shown", menuview.mv_levels((*p).mv) as i64, 2)
    var fr2: [f64; 4] = [0.0; 4]
    check(menuview.mv_rect((*p).mv, 1, &fr2), "the submenu has a frame")
    check(fr2[0] >= fr[0] + fr[2] - 12.0 && fr2[0] <= fr[0] + fr[2], "the submenu overlaps the parent's right edge by a few pixels")
    check(near(fr2[1], r5[1] - 5.0, 2.0), "its first row is level with the header")
    var s8: [f64; 4] = [0.0; 4]
    check(row(p, 9 as usize, &s8), "'By name' has a rectangle")
    check(ink_rows(p, s8[0] + 4.0, s8[1] + 1.0, 24.0, s8[3] - 2.0, tok(p, style.TOK_SURFACE_RAISED), &ink), "the radio dot of 'By name' is drawn")
    check(near((ink[0] + ink[1]) / 2.0, s8[1] + s8[3] / 2.0, 1.0), "the radio dot is on the midline")
    var s9: [f64; 4] = [0.0; 4]
    check(row(p, 10 as usize, &s9), "'By size' has a rectangle")
    check(!ink_rows(p, s9[0] + 4.0, s9[1] + 1.0, 24.0, s9[3] - 2.0, tok(p, style.TOK_SELECTION), &ink) || true, "(the off radio draws nothing in the gutter)")
    if dark {
        save(&(*p).cv, dir, "ctxmenu-sub-dark.png")
    } else {
        save(&(*p).cv, dir, "ctxmenu-sub-light.png")
    }
    // hit test
    eq("hit: the Copy row", menuview.mv_hit((*p).mv, r1[0] + 40.0, r1[1] + r1[3] / 2.0) as i64, 2)
    eq("hit: the separator", menuview.mv_hit((*p).mv, r3[0] + 40.0, r3[1] + r3[3] / 2.0) as i64, 1)
    eq("hit: the submenu row wins over the parent where they overlap", menuview.mv_hit((*p).mv, s8[0] + 20.0, s8[1] + 5.0) as i64, 9)
    eq("hit: the frame's padding", menuview.mv_hit((*p).mv, fr[0] + 1.0, fr[1] + 1.0) as i64, menuview.MV_PAD as i64)
    eq("hit: outside every level", menuview.mv_hit((*p).mv, 5.0, 5.0) as i64, menuview.MV_NONE as i64)
    let cc: u32 = ctxmenu.ctx_close(cm, ctxmenu.CLOSE_API)
}

fn run_place(font: u64) {
    say("== 3. PLACEMENT ON THE SCREEN ==\n")
    let p: *mut Page = page_new(640, 480, false, font)
    page_layout(p)
    let cm: *mut ctxmenu.Ctxm = &(*p).cm
    var fr: [f64; 4] = [0.0; 4]
    check(ctxmenu.ctx_request(cm, &(*p).sc, (*p).btn, 630.0, 90.0, 90.0, action.SRC_MOUSE, 0 as u32, 0), "a request at the right edge")
    paint(p)
    check(menuview.mv_rect((*p).mv, 0, &fr), "frame")
    check(fr[0] + fr[2] <= 640.0 && fr[0] < 630.0, "it flipped to the left of the pointer and stays inside")
    let c1: u32 = ctxmenu.ctx_close(cm, ctxmenu.CLOSE_API)
    check(ctxmenu.ctx_request(cm, &(*p).sc, (*p).btn, 100.0, 470.0, 470.0, action.SRC_MOUSE, 0 as u32, 0), "a request at the bottom edge")
    paint(p)
    check(menuview.mv_rect((*p).mv, 0, &fr), "frame")
    check(fr[1] + fr[3] <= 480.0 && fr[1] + fr[3] <= 470.5, "it flipped above the pointer")
    let c2: u32 = ctxmenu.ctx_close(cm, ctxmenu.CLOSE_API)
    check(ctxmenu.ctx_request(cm, &(*p).sc, (*p).btn, 630.0, 470.0, 470.0, action.SRC_MOUSE, 0 as u32, 0), "a request in the corner")
    paint(p)
    check(menuview.mv_rect((*p).mv, 0, &fr), "frame")
    check(fr[0] + fr[2] <= 640.0 && fr[1] + fr[3] <= 480.0 && fr[0] >= 0.0 && fr[1] >= 0.0, "inside on both axes")
    // the submenu flips left when the parent is at the right edge
    let k0: u32 = ctxmenu.ctx_key(cm, action.SK_END, 0 as u32)
    let k1: u32 = ctxmenu.ctx_key(cm, action.SK_UP, 0 as u32)
    let k2: u32 = ctxmenu.ctx_key(cm, action.SK_RIGHT, 0 as u32)
    paint(p)
    var f2: [f64; 4] = [0.0; 4]
    check(menuview.mv_rect((*p).mv, 1, &f2), "submenu frame")
    check(f2[0] + f2[2] <= 640.0 && f2[0] < fr[0], "the submenu flipped to the left of its parent")
    let c3: u32 = ctxmenu.ctx_close(cm, ctxmenu.CLOSE_API)
    // touch: taller rows
    check(ctxmenu.ctx_request(cm, &(*p).sc, (*p).btn, 100.0, 50.0, 50.0, action.SRC_TOUCH, 0 as u32, 0), "a long press request (touch)")
    paint(p)
    var tr: [f64; 4] = [0.0; 4]
    check(menuview.mv_row_rect((*p).mv, 0 as usize, &tr), "row")
    check(tr[3] >= 44.0, "touch rows are at least 44 high")
    let c4: u32 = ctxmenu.ctx_close(cm, ctxmenu.CLOSE_API)
    check(ctxmenu.ctx_request(cm, &(*p).sc, (*p).btn, 100.0, 50.0, 50.0, action.SRC_MOUSE, 0 as u32, 0), "the same by mouse")
    paint(p)
    check(menuview.mv_row_rect((*p).mv, 0 as usize, &tr), "row")
    check(tr[3] < 44.0, "mouse rows are smaller")
    let c5: u32 = ctxmenu.ctx_close(cm, ctxmenu.CLOSE_API)
    // a tiny window: the menu is pinned to the top-left corner and not wider than the window
    let q: *mut Page = page_new(200, 150, false, font)
    page_layout(q)
    check(ctxmenu.ctx_request(&(*q).cm, &(*q).sc, (*q).btn, 100.0, 100.0, 100.0, action.SRC_MOUSE, 0 as u32, 0), "a request in a tiny window")
    paint(q)
    check(menuview.mv_rect((*q).mv, 0, &fr), "frame")
    check(fr[0] >= 0.0 && fr[1] >= 0.0 && fr[0] + fr[2] <= 200.0, "it stays horizontally inside the 200 px window")
}

fn run_a11y(font: u64) {
    say("== 4. ACCESSIBILITY ==\n")
    let p: *mut Page = page_new(640, 480, false, font)
    page_layout(p)
    check(ctxmenu.ctx_request(&(*p).cm, &(*p).sc, (*p).btn, 100.0, 50.0, 50.0, action.SRC_MOUSE, 0 as u32, 0), "open")
    paint(p)
    var buf: [u8; 4096] = [0 as u8; 4096]
    let n: usize = menuview.mv_a11y_dump((*p).mv, 0, (&buf[0]) as u64, 4096)
    let d: str = str { p: (&buf[0]) as *mut u8, n: n }
    say("    dump: ")
    say(d)
    say("\n")
    check(contains(d, "menu "), "the tree has a menu")
    check(contains(d, "menuitem \"Open\""), "menuitem Open")
    check(contains(d, "menuitem \"Paste\"") && contains(d, "disabled"), "Paste is a disabled menuitem")
    check(contains(d, "menuitemcheckbox \"Show hidden files\""), "a check entry is a menuitemcheckbox")
    check(contains(d, "checked"), "the check entry is checked")
    check(contains(d, "separator"), "separators have the separator role")
    check(contains(d, "menuitem \"Sort by\"") && contains(d, "collapsed"), "the submenu header is collapsed")
    let k0: u32 = ctxmenu.ctx_key(&(*p).cm, action.SK_END, 0 as u32)
    let k1: u32 = ctxmenu.ctx_key(&(*p).cm, action.SK_UP, 0 as u32)
    let k2: u32 = ctxmenu.ctx_key(&(*p).cm, action.SK_RIGHT, 0 as u32)
    paint(p)
    let n2: usize = menuview.mv_a11y_dump((*p).mv, 1, (&buf[0]) as u64, 4096)
    let d2: str = str { p: (&buf[0]) as *mut u8, n: n2 }
    say("    dump of the submenu: ")
    say(d2)
    say("\n")
    check(contains(d2, "menuitemradio \"By name\"") && contains(d2, "menuitemradio \"By size\""), "radio entries are menuitemradio")
    check(contains(d2, "checked"), "the chosen radio entry is checked")
    check(contains(d2, "pos=1/2") && contains(d2, "pos=2/2"), "position in the set is reported (1/2, 2/2)")
}

fn contains(hay: str, needle: str) -> bool {
    if needle.n > hay.n { return false }
    var i: usize = 0
    while i + needle.n <= hay.n {
        if action.str_starts(str { p: (hay.p as u64 + i as u64) as *mut u8, n: hay.n - i }, needle) {
            return true
        }
        i = i + 1
    }
    return false
}

fn h_prevent(ud: u64, e: *mut event.Ev) -> u32 {
    PREVENT = PREVENT + 1
    return event.H_PREVENT
}

fn run_host(font: u64) {
    say("== 5. THE HOST PATH ==\n")
    let p: *mut Page = page_new(640, 480, false, font)
    page_layout(p)
    let w: *mut fuiwirt.Host = &(*p).host
    let cm: *mut ctxmenu.Ctxm = &(*p).cm
    // a right click on the button
    var bx: f64 = scene.node_x(&(*p).sc, (*p).btn) + 10.0
    var by: f64 = scene.node_y(&(*p).sc, (*p).btn) + 10.0
    let c0: u32 = fuiwirt.host_pointer_move(w, bx, by)
    let c1: u32 = fuiwirt.host_pointer_down(w, bx, by, fuiwirt.BTN_RIGHT)
    check(ctxmenu.ctx_is_open(cm), "a right press opens the menu")
    eq("... from a mouse", ctxmenu.ctx_source(cm) as i64, action.SRC_MOUSE as i64)
    eq("... with the button as the target", ctxmenu.ctx_target(cm) as i64, (*p).btn as i64)
    check(fuiwirt.host_popup_open(w), "the host knows a popup is open")
    // the menu takes the pointer: a click on a menu row runs the action, the button below never presses
    paint(p)
    var r1: [f64; 4] = [0.0; 4]
    check(row(p, 2 as usize, &r1), "Copy row")
    RAN[1] = 0
    let a0: u32 = fuiwirt.host_pointer_move(w, r1[0] + 40.0, r1[1] + 5.0)
    eq("hovering the row focuses it", ctxmenu.ctx_focus(cm, 0) as i64, 2)
    let a00: u32 = fuiwirt.host_pointer_down(w, r1[0] + 40.0, r1[1] + 5.0, fuiwirt.BTN_RIGHT)
    check(ctxmenu.ctx_is_open(cm) && RAN[1] == 0, "a right press on a row only points: nothing runs, the menu stays")
    let a1: u32 = fuiwirt.host_pointer_down(w, r1[0] + 40.0, r1[1] + 5.0, fuiwirt.BTN_LEFT)
    let a2: u32 = fuiwirt.host_pointer_up(w, r1[0] + 40.0, r1[1] + 5.0, fuiwirt.BTN_LEFT)
    eq("a click on Copy ran the action once", RAN[1], 1)
    check(!ctxmenu.ctx_is_open(cm), "... and closed the menu")
    check(fuiwirt.host_take_activated(w) == scene.SCENE_NONE, "the button under the menu was never activated")
    // outside press: closes and passes through (the button is pressed through it)
    let b1: u32 = fuiwirt.host_pointer_down(w, bx, by, fuiwirt.BTN_RIGHT)
    check(ctxmenu.ctx_is_open(cm), "reopened")
    let b2: u32 = fuiwirt.host_pointer_down(w, 600.0, 440.0, fuiwirt.BTN_LEFT)
    check(!ctxmenu.ctx_is_open(cm), "a left press outside closes the menu")
    eq("... with reason OUTSIDE", ctxmenu.ctx_last_reason(cm) as i64, ctxmenu.CLOSE_OUTSIDE as i64)
    // a right press outside opens the next menu in one go
    let b3: u32 = fuiwirt.host_pointer_down(w, bx, by, fuiwirt.BTN_RIGHT)
    check(ctxmenu.ctx_is_open(cm), "reopened (2)")
    let opens: u64 = ctxmenu.ctx_open_count(cm)
    let b4: u32 = fuiwirt.host_pointer_down(w, 560.0, 300.0, fuiwirt.BTN_RIGHT)
    check(ctxmenu.ctx_is_open(cm) && ctxmenu.ctx_open_count(cm) == opens + 1 as u64, "a right press while a menu is open closes it and opens the next in one go")
    // keys go to the menu
    eq("no entry focused after a mouse open", ctxmenu.ctx_focus(cm, 0) as i64, ctxmenu.NONE as i64)
    let k1: u32 = fuiwirt.host_key(w, fuiwirt.KEY_DOWN, 0 as u32)
    eq("Down focuses the first entry", ctxmenu.ctx_focus(cm, 0) as i64, 0)
    let k2: u32 = fuiwirt.host_key(w, fuiwirt.KEY_ESCAPE, 0 as u32)
    check(!ctxmenu.ctx_is_open(cm), "Esc closes the menu")
    // characters: mnemonic 'c' = Copy
    let b5: u32 = fuiwirt.host_pointer_down(w, bx, by, fuiwirt.BTN_RIGHT)
    RAN[1] = 0
    let ch: u32 = fuiwirt.host_char(w, 99 as u32, 0 as u32)
    eq("typing the mnemonic c runs Copy", RAN[1], 1)
    check(!ctxmenu.ctx_is_open(cm), "... and closes")
    // Space activates the focused entry
    let b6: u32 = fuiwirt.host_pointer_down(w, bx, by, fuiwirt.BTN_RIGHT)
    let k3: u32 = fuiwirt.host_key(w, fuiwirt.KEY_DOWN, 0 as u32)
    RAN[0] = 0
    let sp: u32 = fuiwirt.host_char(w, 32 as u32, 0 as u32)
    eq("Space runs the focused entry (Open)", RAN[0], 1)
    // the menu key and Shift+F10: the focused element's menu, keyboard source
    let f0: u32 = fuiwirt.host_key(w, fuiwirt.KEY_TAB, 0 as u32)
    check(control.panel_focus(&(*w).pn) != control.NOBODY, "Tab focused the button")
    let mk: u32 = fuiwirt.host_key(w, fuiwirt.KEY_MENU, 0 as u32)
    check(ctxmenu.ctx_is_open(cm), "the menu key opens a menu")
    eq("... from the menu key", ctxmenu.ctx_source(cm) as i64, action.SRC_MENU_KEY as i64)
    eq("... for the focused button", ctxmenu.ctx_target(cm) as i64, (*p).btn as i64)
    eq("... with the first entry focused", ctxmenu.ctx_focus(cm, 0) as i64, 0)
    check(near(ctxmenu.ctx_anchor_x(cm), scene.node_x(&(*p).sc, (*p).btn), 0.5), "... at the button's left edge")
    check(near(ctxmenu.ctx_anchor_y(cm), scene.node_y(&(*p).sc, (*p).btn) + scene.node_h(&(*p).sc, (*p).btn), 0.5), "... under the button")
    let k4: u32 = fuiwirt.host_key(w, fuiwirt.KEY_ESCAPE, 0 as u32)
    let sf: u32 = fuiwirt.host_key(w, fuiwirt.KEY_F10, fuiwirt.MOD_SHIFT)
    check(ctxmenu.ctx_is_open(cm), "Shift+F10 opens a menu")
    eq("... from Shift+F10", ctxmenu.ctx_source(cm) as i64, action.SRC_SHIFT_F10 as i64)
    let k5: u32 = fuiwirt.host_key(w, fuiwirt.KEY_ESCAPE, 0 as u32)
    let nf: u32 = fuiwirt.host_key(w, fuiwirt.KEY_F10, 0 as u32)
    check(!ctxmenu.ctx_is_open(cm), "plain F10 opens nothing")
    // EV_CONTEXT can be prevented
    fuiwirt.host_set_router(w, &(*p).rt)
    let hk: bool = event.ev_on(&(*p).rt, 2 as u32, event.EV_CONTEXT_BIT, false, h_prevent, 0 as u64)
    PREVENT = 0
    let p1: u32 = fuiwirt.host_pointer_down(w, bx, by, fuiwirt.BTN_RIGHT)
    eq("the handler on the pane heard the request", PREVENT, 1)
    check(!ctxmenu.ctx_is_open(cm), "a prevented request opens no menu")
    let o1: u32 = event.ev_off(&(*p).rt, 2 as u32) as u32
    let p2: u32 = fuiwirt.host_pointer_down(w, bx, by, fuiwirt.BTN_RIGHT)
    check(ctxmenu.ctx_is_open(cm), "without the handler the menu opens again")
    let k6: u32 = fuiwirt.host_key(w, fuiwirt.KEY_ESCAPE, 0 as u32)
    // the lock
    let l0: u32 = ctxmenu.ctx_set_locked(cm, true)
    let l1: u32 = fuiwirt.host_pointer_down(w, bx, by, fuiwirt.BTN_RIGHT)
    check(!ctxmenu.ctx_is_open(cm), "nothing opens over the lock")
    let l2: u32 = ctxmenu.ctx_set_locked(cm, false)
    // the clock: a pending submenu keeps the loop awake, then sleeps again
    let m0: u32 = fuiwirt.host_pointer_down(w, bx, by, fuiwirt.BTN_RIGHT)
    paint(p)
    var r5: [f64; 4] = [0.0; 4]
    check(row(p, 6 as usize, &r5), "Sort by row")
    fuiwirt.host_tick(w, 1000)
    let hh: u32 = fuiwirt.host_pointer_move(w, r5[0] + 40.0, r5[1] + 5.0)
    fuiwirt.host_tick(w, 1000)
    check(fuiwirt.host_wait_ms(w) >= 0 && fuiwirt.host_wait_ms(w) <= 250, "the loop is told to wake for the submenu delay")
    fuiwirt.host_tick(w, 1300)
    eq("after the delay the submenu is open", ctxmenu.ctx_depth(cm) as i64, 2)
}


// ----------------------------------------------------------------------------
// 7. WINDOWS OF ITS OWN, with a fake platform (r168)
static mut SF_REFUSE: bool = false
static mut SF_OPENED: [i64; 3] = [0; 3]
static mut SF_CLOSED: [i64; 3] = [0; 3]
static mut SF_PRESENTED: [i64; 3] = [0; 3]
static mut SF_PLACED: [i64; 3] = [0; 3]
static mut SF_X: [i64; 3] = [0; 3]
static mut SF_Y: [i64; 3] = [0; 3]
static mut SF_W: [i64; 3] = [0; 3]
static mut SF_H: [i64; 3] = [0; 3]
static mut SF_GRAB: [bool; 3] = [false; 3]
static mut SF_CTX: u64 = 0

fn t_screen(ud: u64, out: *mut [f64; 4]) -> bool {
    (*out)[0] = 0.0
    (*out)[1] = 0.0
    (*out)[2] = 1100.0
    (*out)[3] = 720.0
    return true
}

fn t_origin(ud: u64, out: *mut [f64; 2]) -> bool {
    (*out)[0] = 300.0
    (*out)[1] = 200.0
    return true
}

fn t_open(ud: u64, lv: usize, x: i64, y: i64, w: usize, h: usize) -> bool {
    if SF_REFUSE { return false }
    SF_OPENED[lv] = SF_OPENED[lv] + 1
    SF_X[lv] = x
    SF_Y[lv] = y
    SF_W[lv] = w as i64
    SF_H[lv] = h as i64
    SF_GRAB[lv] = lv == 0
    return true
}

fn t_place(ud: u64, lv: usize, x: i64, y: i64, w: usize, h: usize) -> bool {
    SF_PLACED[lv] = SF_PLACED[lv] + 1
    SF_X[lv] = x
    SF_Y[lv] = y
    return true
}

fn t_close(ud: u64, lv: usize) {
    SF_CLOSED[lv] = SF_CLOSED[lv] + 1
}

fn t_ctx(ud: u64, lv: usize) -> *mut render.Ctx {
    return SF_CTX as *mut render.Ctx
}

fn t_present(ud: u64, lv: usize) {
    SF_PRESENTED[lv] = SF_PRESENTED[lv] + 1
}

fn run_windows(font: u64) {
    say("== 7. WINDOWS OF ITS OWN (a fake platform: the program's window at (300, 200) on a 1100 x 720 screen) ==\n")
    let p: *mut Page = page_new(640, 480, false, font)
    page_layout(p)
    // the surface's own context: a canvas of the screen's size
    let sp: *mut Page = page_new(640, 480, false, font)
    SF_CTX = (&(*sp).c) as u64
    menuview.mv_set_surface((*p).mv, 0 as u64, t_screen, t_origin, t_open, t_place, t_close, t_ctx, t_present)
    let cm: *mut ctxmenu.Ctxm = &(*p).cm
    let w: *mut fuiwirt.Host = &(*p).host
    var k: usize = 0
    while k < 3 {
        SF_OPENED[k] = 0
        SF_CLOSED[k] = 0
        SF_PRESENTED[k] = 0
        SF_PLACED[k] = 0
        k = k + 1
    }
    // a right press at (400, 150) of the window = (700, 350) on the screen
    let c1: u32 = fuiwirt.host_pointer_down(w, 400.0, 150.0, fuiwirt.BTN_RIGHT)
    check(ctxmenu.ctx_is_open(cm), "a right press opens the menu")
    check(menuview.mv_is_top((*p).mv), "it is shown in a window of its own")
    eq("one window opened", SF_OPENED[0], 1)
    check(SF_GRAB[0], "the first window takes the grab")
    eq("its place is a SCREEN place: the window's origin + the press (x)", SF_X[0], 700)
    eq("... (y)", SF_Y[0], 350)
    check(SF_W[0] > 100 && SF_H[0] > 100, "with the size of the frame")
    var fr: [f64; 4] = [0.0; 4]
    check(menuview.mv_rect((*p).mv, 0, &fr) && fr[0] == 700.0, "mv_rect speaks screen coordinates")
    // the picture
    let pa: bool = menuview.mv_present((*p).mv)
    check(pa && SF_PRESENTED[0] == 1, "mv_present paints and shows the window once")
    let pb: bool = menuview.mv_present((*p).mv)
    check(!pb && SF_PRESENTED[0] == 1, "... and not again when nothing changed")
    // pixels of the surface's canvas: the frame is the raised surface colour
    check(canvas.canvas_get(&(*sp).cv, 3 as usize, (SF_H[0] / 2) as usize) != 0 as u32, "the surface canvas was painted")
    // the pointer: window coordinates in, the screen's in the menu
    var r2: [f64; 4] = [0.0; 4]
    check(menuview.mv_row_rect((*p).mv, 2 as usize, &r2), "the Copy row (screen coordinates)")
    let h1: u32 = fuiwirt.host_pointer_move(w, r2[0] + 40.0 - 300.0, r2[1] + 5.0 - 200.0)
    eq("a move over the row (in window coordinates) focuses it", ctxmenu.ctx_focus(cm, 0) as i64, 2)
    let pc: bool = menuview.mv_present((*p).mv)
    check(pc && SF_PRESENTED[0] == 2, "the focus change is painted")
    // a submenu: its own window, no grab
    let k1: u32 = fuiwirt.host_key(w, fuiwirt.KEY_END, 0 as u32)
    let k2: u32 = fuiwirt.host_key(w, fuiwirt.KEY_UP, 0 as u32)
    let k4: u32 = fuiwirt.host_key(w, fuiwirt.KEY_RIGHT, 0 as u32)
    eq("two levels", ctxmenu.ctx_depth(cm) as i64, 2)
    let pd: bool = menuview.mv_present((*p).mv)
    eq("a second window opened for the submenu", SF_OPENED[1], 1)
    check(!SF_GRAB[1], "the submenu's window takes no grab")
    // the screen is 1100 wide and the menu stands at x = 700: no room right of it, so it flips
    check(SF_X[1] + SF_W[1] <= 1100 && SF_X[1] < SF_X[0], "the submenu flipped to the left of the menu: no room right of it on the screen")
    // Esc closes the submenu's window only
    let k5: u32 = fuiwirt.host_key(w, fuiwirt.KEY_ESCAPE, 0 as u32)
    let pe: bool = menuview.mv_present((*p).mv)
    eq("Esc: the submenu's window is closed", SF_CLOSED[1], 1)
    eq("... the menu's is not", SF_CLOSED[0], 0)
    let k6: u32 = fuiwirt.host_key(w, fuiwirt.KEY_ESCAPE, 0 as u32)
    let pf: bool = menuview.mv_present((*p).mv)
    eq("Esc again: the menu's window is closed", SF_CLOSED[0], 1)
    check(!menuview.mv_is_top((*p).mv), "nothing is shown any more")
    // a press that fits on the screen but not in the window: the menu reaches over the window's edge
    let c5: u32 = fuiwirt.host_pointer_down(w, 500.0, 150.0, fuiwirt.BTN_RIGHT)
    check(ctxmenu.ctx_is_open(cm) && SF_X[0] == 800, "a press at window x = 500 (screen 800): the menu stands at x = 800")
    check(SF_X[0] + SF_W[0] > 940, "and reaches over the window's right edge (screen x = 940): nothing cuts it")
    let g0: u32 = fuiwirt.host_key(w, fuiwirt.KEY_ESCAPE, 0 as u32)
    let pg0: bool = menuview.mv_present((*p).mv)
    // the screen's edge: a press near the right edge of the SCREEN flips the menu to the left
    let c2: u32 = fuiwirt.host_pointer_down(w, 600.0, 150.0, fuiwirt.BTN_RIGHT)
    check(ctxmenu.ctx_is_open(cm), "a press near the screen's right edge (x = 900)")
    check(SF_X[0] + SF_W[0] <= 1100, "the menu's window ends inside the screen")
    check(SF_X[0] < 900, "it flipped to the left of the pointer")
    let g1: u32 = fuiwirt.host_key(w, fuiwirt.KEY_ESCAPE, 0 as u32)
    // the window moved: an open menu closes
    let c3: u32 = fuiwirt.host_pointer_down(w, 400.0, 150.0, fuiwirt.BTN_RIGHT)
    check(ctxmenu.ctx_is_open(cm), "reopened")
    fuiwirt.host_popup_note(w, 1 as u32)
    check(!ctxmenu.ctx_is_open(cm), "a window that moves or resizes closes the menu")
    eq("... with reason WINDOW", ctxmenu.ctx_last_reason(cm) as i64, ctxmenu.CLOSE_WINDOW as i64)
    // the platform REFUSES a window: the menu falls back into the page, at the window's own place
    SF_REFUSE = true
    let c4: u32 = fuiwirt.host_pointer_down(w, 300.0, 150.0, fuiwirt.BTN_RIGHT)
    check(ctxmenu.ctx_is_open(cm), "the menu opens although no window could be made")
    check(!menuview.mv_is_top((*p).mv), "it is shown in the page")
    let gotr: bool = menuview.mv_rect((*p).mv, 0, &fr)
    check(gotr && fr[0] == 300.0 && fr[1] == 150.0, "at the window's own coordinates (300, 150)")
    paint(p)
    check(px(p, fr[0] + fr[2] - 3.0, fr[1] + fr[3] / 2.0) == tok(p, style.TOK_SURFACE_RAISED), "and painted into the page")
}

fn run_speed(font: u64) {
    say("== 6. SPEED ==\n")
    let p: *mut Page = page_new(1240, 720, false, font)
    page_layout(p)
    paint(p)
    // open + paint, 20 times, the slowest
    var worst: f64 = 0.0
    var k: usize = 0
    while k < 20 {
        let t0: f64 = now_ms()
        let ok: bool = ctxmenu.ctx_request(&(*p).cm, &(*p).sc, (*p).btn, 300.0, 200.0, 200.0, action.SRC_MOUSE, 0 as u32, 0)
        paint(p)
        let t1: f64 = now_ms()
        if t1 - t0 > worst { worst = t1 - t0 }
        let c: u32 = ctxmenu.ctx_close(&(*p).cm, ctxmenu.CLOSE_API)
        k = k + 1
    }
    say("    the slowest of 20 opens (request + build + layout + paint of the page and the menu), 1240x720: ")
    say_int((worst * 10.0) as i64)
    say(" tenths of a ms\n")
    check(worst <= 16.0, "opening a menu takes at most 16 ms")
    // one more frame with the menu open (no rebuild)
    let ok2: bool = ctxmenu.ctx_request(&(*p).cm, &(*p).sc, (*p).btn, 300.0, 200.0, 200.0, action.SRC_MOUSE, 0 as u32, 0)
    paint(p)
    let r0: u64 = menuview.mv_rebuilds((*p).mv)
    let t2: f64 = now_ms()
    paint(p)
    let t3: f64 = now_ms()
    check(menuview.mv_rebuilds((*p).mv) == r0, "a second frame does not rebuild the menu")
    say("    one frame with the menu open: ")
    say_int(((t3 - t2) * 10.0) as i64)
    say(" tenths of a ms\n")
    check(t3 - t2 <= 16.0, "a frame with an open menu takes at most 16 ms")
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("menuview: no font (DejaVu Sans)\n")
        return 9
    }
    // `menuview speed`: only the timing -- build this one with an optimising
    // compiler (the checks run unoptimised)
    if dir != 0 && rt.c_length(dir) == 5 && *(dir as *mut u8) == (115 as u8) {
        run_speed(fs as u64)
        if BAD == 0 {
            say("MENUVIEW SPEED PASSED\n")
            return 0
        }
        say("MENUVIEW SPEED FAILED\n")
        return 1
    }
    run_picture(dir, fs as u64, false)
    run_picture(dir, fs as u64, true)
    run_place(fs as u64)
    run_a11y(fs as u64)
    run_host(fs as u64)
    run_windows(fs as u64)
    if BAD == 0 {
        say("MENUVIEW PASSED\n")
        return 0
    }
    say("MENUVIEW FAILED\n")
    return 1
}
