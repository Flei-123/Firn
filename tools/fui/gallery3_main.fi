// SPDX-License-Identifier: MPL-2.0
// tools/fui/gallery3_main.fi -- WAVE 3/4 SHOWS ITSELF.
//
// ====================================================== WHY IT EXISTS
//
// The same rule as the wave 1 and wave 2 galleries: a control that
// does not show up here counts as unfinished. Justin checks the
// pictures himself, so every control of wave 3 stands in here in the
// states it can be in.
//
//     gallery3_main <out.png> [light|dark] [<font.ttf>]
//
// The controls of this wave need DATA, not just a state -- a table
// without rows shows nothing. So this gallery fills them with real
// rows, real columns and a real month, and that is why it is longer
// than the wave 2 one.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.wave2
import fui.wave3
import fui.layout

const FONTSET_BYTES: usize = 4096
const W: usize = 1240
// H IST DIE HOECHSTHOEHE, NICHT DIE BILDHOEHE. Womit gerechnet wird,
// muss vor dem ersten Strich feststehen; wie hoch das Bild wirklich
// wird, weiss erst das letzte gezeichnete Band. Frueher stand H auch
// im Bild, und darum hing unter dem Inhalt ein leeres Drittel -- im
// dunklen Schema ein schwarzer Block. Jetzt wird am Ende auf das
// tatsaechlich erreichte y zugeschnitten (`zuschnitt`).
const H: usize = 1320
// Der Rand, der unter dem letzten Band stehen bleibt: dasselbe Mass,
// mit dem das Bild oben anfaengt.
const BORDER_BELOW: f64 = 20.0

// DIE LEINWAND ENDET, WO DER INHALT ENDET.
//
// Eine zweite Leinwand der wahren Hoehe, Punkt fuer Punkt kopiert. Es
// wird das ROH-Pixel uebernommen (`canvas_get` / `canvas_set_raw`) und
// nicht gemischt: Kopieren ist kein Malen, und ein Alphawert, der
// zweimal durch die Mischung laeuft, kommt heller heraus als er war.
fn zuschnitt(src: *mut canvas.Canvas, dst: *mut canvas.Canvas,
    height: f64) -> bool {
    var h: usize = (height + 0.5) as usize
    if h > canvas.canvas_height(src) {
        h = canvas.canvas_height(src)
    }
    if h == 0 {
        return false
    }
    let w: usize = canvas.canvas_width(src)
    if !canvas.canvas_init(dst, w, h) {
        return false
    }
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            canvas.canvas_set_raw(dst, x, y,
                canvas.canvas_get(src, x, y))
            x = x + 1
        }
        y = y + 1
    }
    return true
}

// DER TONWERT EINES PIXELS -- die Helligkeit, die das Auge sieht.
//
// Rec.601 in Tausendsteln (0.299 / 0.587 / 0.114), ganzzahlig
// gerechnet: fuer einen ABSTAND zweier Flaechen ist das die richtige
// Groesse, weil eine Aenderung im Gruenkanal schwerer wiegt als
// dieselbe Aenderung im Blaukanal. Der Rueckgabewert liegt zwischen
// 0 (schwarz) und 255 (weiss).
fn tonwert(c: u32) -> i64 {
    let r: i64 = ((c >> 16) & 255 as u32) as i64
    let g: i64 = ((c >> 8) & 255 as u32) as i64
    let b: i64 = (c & 255 as u32) as i64
    return (299 * r + 587 * g + 114 * b) / 1000
}

const S_NORMAL: u32 = 0
const S_HOVER: u32 = 1
const S_ACTIVE: u32 = 2
const S_FOCUS: u32 = 4
const S_DISABLED: u32 = 8

fn heading(c: *mut render.Ctx, x: f64, y: f64, p: u64, n: usize) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, 800.0, 18.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(style.TOK_TEXT_MUTED))
    *s = style.style_set_font(*s, 0, 12)
    render.draw_label(c, &e)
}

fn caption(c: *mut render.Ctx, x: f64, y: f64, p: u64, n: usize) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, 200.0, 14.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(style.TOK_TEXT_MUTED))
    *s = style.style_set_font(*s, 0, 11)
    render.draw_label(c, &e)
}

fn row_label(c: *mut render.Ctx, y: f64, p: u64, n: usize) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, 24.0, y, 120.0, 32.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_font(*s, 0, 13)
    render.draw_label(c, &e)
}

// A LIST in one state, filled with rows. `hot` is the row that is
// hovered, `sel` the one that is selected -- so the picture shows that
// they are not the same row.
fn one_list(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64,
    bits: u32, hot: i64, sel: i64, ra: u64, rb: u64, rc: u64,
    la: usize, lb: usize, lc: usize) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LIST)
    widget.w_place(&e, x, y, w, h)
    widget.w_set_state_bits(&e, bits)
    wave3.draw_any(c, &e)
    let off: bool = (bits & S_DISABLED) != 0 as u32
    wave3.draw_list_row(c, &e, 0, ra, la, hot == 0 as i64,
        sel == 0 as i64, off)
    wave3.draw_list_row(c, &e, 1, rb, lb, hot == 1 as i64,
        sel == 1 as i64, off)
    wave3.draw_list_row(c, &e, 2, rc, lc, hot == 2 as i64,
        sel == 2 as i64, off)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 48] = "gallery3_main <out.png> [light|dark] [font.ttf]\n"
        rt.write_everything(2, (&u[0]) as u64, 47)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    var dark: bool = true
    if rt.arg_count(start) >= 3 {
        if rt.ld8(rt.arg_ptr(start, 2), 0) == 108 as u8 {
            dark = false
        }
    }

    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
        rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    // OHNE SCHRIFT KEIN BELEG. Ein Bild ohne einen einzigen
    // Buchstaben sieht von weitem aus wie ein Bild, und genau so ist
    // in OrientOS eine textlose Oberflaeche durch die Abnahme
    // gekommen. Ein Beleg ohne Beschriftung belegt nichts -- also
    // Fehler auf fd 2 und ein Rueckgabewert, an dem der Lauf
    // haengenbleibt, statt ein stummes PNG zu schreiben.
    if fm == 0 {
        var ks: [u8; 60] = "gallery3: keine Schrift gefunden -- ohne Schrift kein Beleg\n"
        rt.write_everything(2, (&ks[0]) as u64, 60)
        return 9
    }

    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 300) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(dark)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque((*f).base))

    // ---- the texts every control shares
    var ra: [u8; 9] = "Documents"
    var rb: [u8; 8] = "Pictures"
    var rc: [u8; 5] = "Music"
    var pa: u64 = (&ra[0]) as u64
    var pb: u64 = (&rb[0]) as u64
    var pc: u64 = (&rc[0]) as u64

    var y: f64 = 20.0

    // ==================================================================
    // THE LIST IN ALL FIVE STATES
    // ==================================================================
    var h1: [u8; 46] = "WAVE 3 -- list view, all five states          "
    heading(&c, 24.0, y, (&h1[0]) as u64, 44)
    y = y + 22.0
    var cn: [u8; 6] = "normal"
    var chv: [u8; 5] = "hover"
    var cpr: [u8; 7] = "pressed"
    var cfo: [u8; 7] = "focused"
    var cdi: [u8; 8] = "disabled"
    caption(&c, 150.0, y, (&cn[0]) as u64, 6)
    caption(&c, 372.0, y, (&chv[0]) as u64, 5)
    caption(&c, 594.0, y, (&cpr[0]) as u64, 7)
    caption(&c, 816.0, y, (&cfo[0]) as u64, 7)
    caption(&c, 1038.0, y, (&cdi[0]) as u64, 8)
    y = y + 18.0

    var lt: [u8; 4] = "List"
    row_label(&c, y + 30.0, (&lt[0]) as u64, 4)
    // normal, then one with a hovered row, one with a pressed look,
    // one focused, one disabled -- and the selected row is row 2
    // throughout, so it can be compared across the five.
    one_list(&c, 150.0, y, 200.0, 100.0, S_NORMAL, -1 as i64,
        2 as i64, pa, pb, pc, 9, 8, 5)
    one_list(&c, 372.0, y, 200.0, 100.0, S_NORMAL, 1 as i64,
        2 as i64, pa, pb, pc, 9, 8, 5)
    one_list(&c, 594.0, y, 200.0, 100.0, S_ACTIVE, 1 as i64,
        2 as i64, pa, pb, pc, 9, 8, 5)
    one_list(&c, 816.0, y, 200.0, 100.0, S_FOCUS, -1 as i64,
        2 as i64, pa, pb, pc, 9, 8, 5)
    one_list(&c, 1038.0, y, 180.0, 100.0, S_DISABLED, -1 as i64,
        2 as i64, pa, pb, pc, 9, 8, 5)
    y = y + 120.0

    // ==================================================================
    // THE TABLE
    // ==================================================================
    var h2: [u8; 46] = "Table -- header, rows, selection and hover    "
    heading(&c, 24.0, y, (&h2[0]) as u64, 44)
    y = y + 24.0

    var cols: [u64; 3] = [0 as u64, 0 as u64, 0 as u64]
    var lens: [usize; 3] = [0, 0, 0]
    var hn: [u8; 4] = "Name"
    var hs: [u8; 4] = "Size"
    var hk: [u8; 4] = "Kind"
    cols[0] = (&hn[0]) as u64
    lens[0] = 4
    cols[1] = (&hs[0]) as u64
    lens[1] = 4
    cols[2] = (&hk[0]) as u64
    lens[2] = 4

    var cells: [u64; 3] = [0 as u64, 0 as u64, 0 as u64]
    var clen: [usize; 3] = [0, 0, 0]
    var v1: [u8; 6] = "12 kB "
    var v2: [u8; 6] = "Folder"

    var tbl: widget.Widget = widget.widget_new(widget.KIND_TABLE)
    widget.w_place(&tbl, 150.0, y, 420.0, 150.0)
    wave3.draw_any(&c, &tbl)
    wave3.draw_table_header(&c, &tbl, &cols[0], &lens[0], 3)
    var tt: [u8; 5] = "Table"
    row_label(&c, y + 60.0, (&tt[0]) as u64, 5)

    var r: usize = 0
    while r < 4 {
        if r == 0 {
            cells[0] = pa
            clen[0] = 9
        }
        if r == 1 {
            cells[0] = pb
            clen[0] = 8
        }
        if r == 2 {
            cells[0] = pc
            clen[0] = 5
        }
        if r == 3 {
            cells[0] = pa
            clen[0] = 9
        }
        cells[1] = (&v1[0]) as u64
        clen[1] = 5
        cells[2] = (&v2[0]) as u64
        clen[2] = 6
        // row 1 hovered, row 2 selected -- the picture has to show that
        // these are two different rows.
        wave3.draw_table_row(&c, &tbl, r, &cells[0], &clen[0], 3,
            r == 1, r == 2, r == 3)
        r = r + 1
    }

    // A LONG NAME, so the cut-off can be SEEN and not only measured.
    var lng: [u8; 45] = "A very long file name that will not fit here "
    var tbl2: widget.Widget = widget.widget_new(widget.KIND_TABLE)
    widget.w_place(&tbl2, 620.0, y, 420.0, 150.0)
    wave3.draw_any(&c, &tbl2)
    wave3.draw_table_header(&c, &tbl2, &cols[0], &lens[0], 3)
    cells[0] = (&lng[0]) as u64
    clen[0] = 43
    cells[1] = (&v1[0]) as u64
    clen[1] = 5
    cells[2] = (&v2[0]) as u64
    clen[2] = 6
    wave3.draw_table_row(&c, &tbl2, 0, &cells[0], &clen[0], 3, false,
        false, false)
    cells[0] = pb
    clen[0] = 8
    wave3.draw_table_row(&c, &tbl2, 1, &cells[0], &clen[0], 3, false,
        true, false)
    var lc2: [u8; 30] = "long name -- cut at the cell  "
    caption(&c, 620.0, y - 16.0, (&lc2[0]) as u64, 28)
    y = y + 170.0

    // ==================================================================
    // THE TREE
    // ==================================================================
    var h3: [u8; 46] = "Tree view -- indent, twisty, selection        "
    heading(&c, 24.0, y, (&h3[0]) as u64, 44)
    y = y + 24.0
    var trt: [u8; 4] = "Tree"
    row_label(&c, y + 50.0, (&trt[0]) as u64, 4)

    var tre: widget.Widget = widget.widget_new(widget.KIND_TREE)
    widget.w_place(&tre, 150.0, y, 300.0, 140.0)
    wave3.draw_any(&c, &tre)
    wave3.draw_tree_row(&c, &tre, 0, pa, 9, 0, true, true, false,
        false, false)
    wave3.draw_tree_row(&c, &tre, 1, pb, 8, 1, true, false, false,
        false, false)
    wave3.draw_tree_row(&c, &tre, 2, pc, 5, 2, false, false, true,
        false, false)
    wave3.draw_tree_row(&c, &tre, 3, pa, 9, 2, false, false, false,
        true, false)
    wave3.draw_tree_row(&c, &tre, 4, pb, 8, 1, false, false, false,
        false, true)

    // ---- CARDS next to it
    var cdl: [u8; 4] = "Card"
    caption(&c, 480.0, y - 16.0, (&cdl[0]) as u64, 4)
    var ca: widget.Widget = widget.widget_new(widget.KIND_CARD)
    var cat: [u8; 8] = "Overview"
    widget.w_place(&ca, 480.0, y, 170.0, 64.0)
    widget.w_set_text(&ca, (&cat[0]) as u64, 8)
    wave3.draw_any(&c, &ca)
    var cb: widget.Widget = widget.widget_new(widget.KIND_CARD)
    widget.w_place(&cb, 480.0, y + 74.0, 170.0, 64.0)
    widget.w_set_text(&cb, (&cat[0]) as u64, 8)
    widget.w_set_state_bits(&cb, S_HOVER)
    wave3.draw_any(&c, &cb)

    // ---- BADGES, one of each tone
    var bdl: [u8; 6] = "Badges"
    caption(&c, 680.0, y - 16.0, (&bdl[0]) as u64, 6)
    var bt1: [u8; 3] = "NEW"
    var bt2: [u8; 5] = "ERROR"
    var bt3: [u8; 4] = "WARN"
    var bt4: [u8; 2] = "OK"
    var bt5: [u8; 2] = "12"
    var tones: [u32; 5] = [wave3.BADGE_ACCENT, wave3.BADGE_ERROR,
        wave3.BADGE_WARNING, wave3.BADGE_SUCCESS, wave3.BADGE_NEUTRAL]
    var bps: [u64; 5] = [0 as u64, 0 as u64, 0 as u64, 0 as u64,
        0 as u64]
    var bls: [usize; 5] = [0, 0, 0, 0, 0]
    bps[0] = (&bt1[0]) as u64
    bls[0] = 3
    bps[1] = (&bt2[0]) as u64
    bls[1] = 5
    bps[2] = (&bt3[0]) as u64
    bls[2] = 4
    bps[3] = (&bt4[0]) as u64
    bls[3] = 2
    bps[4] = (&bt5[0]) as u64
    bls[4] = 2
    var bi: usize = 0
    var by: f64 = y
    while bi < 5 {
        var bw: f64 = 0.0
        var bh: f64 = 0.0
        wave3.badge_size(&c, bps[bi], bls[bi], &bw, &bh)
        var bg: widget.Widget = widget.widget_new(widget.KIND_BADGE)
        widget.w_place(&bg, 680.0, by, bw, bh)
        widget.w_set_text(&bg, bps[bi], bls[bi])
        widget.w_set_value(&bg, tones[bi] as i64)
        wave3.draw_any(&c, &bg)
        by = by + bh + 6.0
        bi = bi + 1
    }

    // ---- THE DATE PICKER
    var dpl: [u8; 11] = "Date picker"
    caption(&c, 800.0, y - 16.0, (&dpl[0]) as u64, 11)
    var wd: [u8; 20] = "Mo Tu We Th Fr Sa Su"
    var wdp: [u64; 7] = [0 as u64, 0 as u64, 0 as u64, 0 as u64,
        0 as u64, 0 as u64, 0 as u64]
    var wdn: [usize; 7] = [0, 0, 0, 0, 0, 0, 0]
    var wi: usize = 0
    while wi < 7 {
        wdp[wi] = (&wd[0]) as u64 + (wi * 3) as u64
        wdn[wi] = 2
        wi = wi + 1
    }
    // the day numbers 1..31 as text
    var dnum: [u8; 64] = " 1 2 3 4 5 6 7 8 9101112131415161718192021222324252627282930 31 "
    var dp_p: [u64; 32] = [0 as u64; 32]
    var dp_n: [usize; 32] = [0; 32]
    var di: usize = 1
    while di <= 31 {
        dp_p[di] = (&dnum[0]) as u64 + ((di - 1) * 2) as u64
        dp_n[di] = 2
        di = di + 1
    }
    var dpk: widget.Widget = widget.widget_new(widget.KIND_NONE)
    widget.w_place(&dpk, 800.0, y, 230.0, 190.0)
    // September 2026 -- the month this was built in.
    widget.w_set_value(&dpk, wave3.datepicker_value(2026 as i64,
        9 as i64))
    wave3.draw_datepicker(&c, &dpk, 11 as i64, 3 as i64, 18 as i64,
        &wdp[0], &wdn[0], &dp_p[0], &dp_n[0])

    // ---- THE COLOUR PICKER
    var cpl: [u8; 13] = "Colour picker"
    caption(&c, 1060.0, y - 16.0, (&cpl[0]) as u64, 13)
    var cpk: widget.Widget = widget.widget_new(widget.KIND_NONE)
    widget.w_place(&cpk, 1060.0, y, 150.0, 130.0)
    widget.w_set_value(&cpk, 210)
    wave3.draw_colorpicker(&c, &cpk)
    y = y + 220.0

    // ==================================================================
    // THE MODAL DIALOG, OVER A SCRIM
    // ==================================================================
    //
    // This is the one that has to be LOOKED at: the scrim must darken
    // the whole strip and the dialog must stand out from it, in both
    // themes.
    var h4: [u8; 46] = "Modal dialog and file dialog, over the scrim  "
    heading(&c, 24.0, y, (&h4[0]) as u64, 44)
    y = y + 24.0

    // something to darken: a row of cards
    var sc: usize = 0
    while sc < 5 {
        var bgc: widget.Widget = widget.widget_new(widget.KIND_CARD)
        widget.w_place(&bgc, 150.0 + (sc as f64) * 200.0, y, 180.0,
            70.0)
        widget.w_set_text(&bgc, (&cat[0]) as u64, 8)
        wave3.draw_any(&c, &bgc)
        sc = sc + 1
    }
    // the scrim over the whole strip
    wave3.draw_scrim(&c, 0.0, y - 8.0, W as f64, 290.0)

    // the dialog
    var dlg: widget.Widget = widget.widget_new(widget.KIND_NONE)
    var dgt: [u8; 13] = "Save changes?"
    widget.w_place(&dlg, 150.0, y + 20.0, 380.0, 230.0)
    widget.w_set_text(&dlg, (&dgt[0]) as u64, 13)
    wave3.draw_dialog(&c, &dlg)
    // its body gets a label and its buttons are real buttons
    let bo: wave3.FRect = wave3.dialog_body_rect(&c, &dlg)
    var msg: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    var mgt: [u8; 34] = "The document has been changed.    "
    widget.w_place(&msg, bo.x, bo.y, bo.w, 24.0)
    widget.w_set_text(&msg, (&mgt[0]) as u64, 30)
    render.draw_label(&c, &msg)

    // Die Knopfzeile wird NICHT von Hand gesetzt, sondern von
    // lib/fui/flex.fi verteilt: gemessen mit render.pref_of, rechts
    // ausgerichtet, Luecke sp_s. Frueher stand hier "rechte Kante
    // minus 200, dann minus 100" -- und genau diese Rechnung ist
    // falsch, sobald aus "Cancel" ein "Abbrechen" wird.
    var b1: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    var b1t: [u8; 6] = "Cancel"
    widget.w_set_text(&b1, (&b1t[0]) as u64, 6)
    var b2: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    var b2t: [u8; 4] = "Save"
    widget.w_set_text(&b2, (&b2t[0]) as u64, 4)
    widget.w_set_state_bits(&b2, S_FOCUS)
    var knoepfe: [u64; 2] = [0 as u64, 0 as u64]
    knoepfe[0] = (&b1) as u64
    knoepfe[1] = (&b2) as u64
    if !wave3.draw_dialog_buttons(&c, &dlg, (&knoepfe[0]) as *mut u64,
        2) {
        return 9
    }

    // the file dialog next to it, in SAVE mode (list + name field)
    var fd: widget.Widget = widget.widget_new(widget.KIND_NONE)
    var fdt: [u8; 12] = "Export as..."
    widget.w_place(&fd, 580.0, y + 20.0, 400.0, 230.0)
    // 12, nicht 11: "Export as..." hat drei Punkte, und eine um eins
    // zu kurze Laenge macht daraus lautlos "Export as..".
    widget.w_set_text(&fd, (&fdt[0]) as u64, 12)
    wave3.draw_filedialog(&c, &fd, wave3.FILE_SAVE)
    // real rows in its list
    let flr: wave3.FRect = wave3.filedialog_list_rect(&c, &fd,
        wave3.FILE_SAVE)
    var fl: widget.Widget = widget.widget_new(widget.KIND_LIST)
    widget.w_place(&fl, flr.x, flr.y, flr.w, flr.h)
    wave3.draw_list_row(&c, &fl, 0, pa, 9, false, false, false)
    wave3.draw_list_row(&c, &fl, 1, pb, 8, true, false, false)
    wave3.draw_list_row(&c, &fl, 2, pc, 5, false, true, false)

    // ============ DER SCHLEIER WIRD AM FERTIGEN BILD NACHGEMESSEN
    //
    // Das Band mit den beiden Dialogen ist der einzige Ort, an dem
    // dieses Blatt eine Aussage ueber den Schleier macht -- und die
    // Aussage lautet: das Fenster dahinter ist AUSSER REICHWEITE. Im
    // dunklen Schema stimmte das lange nicht. Dort ist der Grund
    // 0x1C1B22, und ein Schleier, der wie im hellen Schema abdunkelt,
    // landet bei 0x0D0C0F: fuenfzehn Tonwerte unter dem Grund, auf
    // einem Flachbildschirm nicht mehr als eine Ahnung. Seit
    // `theme.scrim_color` im Dunklen AUFHELLT, ist der Abstand da --
    // aber ein Abstand, den niemand nachrechnet, ist genau die Sorte
    // Zusage, die in diesem Baum schon zweimal lautlos verschwunden
    // ist. Also wird er hier an den PIXELN des eben gemalten Bildes
    // gemessen, in beiden Schemata, mit demselben Sollwert: mindestens
    // 20 Tonwerte zwischen Schleier und Seitengrund. Gemessen wird am
    // linken Rand, wo weder eine Karte noch ein Dialog liegt.
    let t_schleier: i64 = tonwert(canvas.canvas_get(&cv, 8,
        (y + 100.0) as usize))
    let t_basic: i64 = tonwert(canvas.canvas_get(&cv, 8,
        (y - 40.0) as usize))
    var d_schleier: i64 = t_schleier - t_basic
    if d_schleier < 0 {
        d_schleier = 0 - d_schleier
    }
    if d_schleier < 20 {
        var sm: [u8; 55] = "gallery3: scrim and page differ by too few tone steps: "
        rt.write_everything(2, (&sm[0]) as u64, 55)
        var sb: rt.Buf = rt.buf_new()
        rt.buf_push_dec_i64(&sb, d_schleier)
        var sw: [u8; 10] = ", want 20\n"
        rt.buf_push_bytes(&sb, (&sw[0]) as u64, 10)
        rt.write_everything(2, rt.buf_ptr(&sb), rt.buf_len(&sb))
        rt.buf_free(&sb)
        return 10
    }

    // ---- WRITING IT OUT
    //
    // Erst zuschneiden. Das letzte Band ist der Verdunkler mit den
    // beiden Dialogen darauf: er beginnt bei y - 8 und ist 290 hoch,
    // also endet der Inhalt bei y + 282. Diese Zahl kommt aus dem
    // Zeichnen und nicht aus einer Konstanten -- wer hier H einsetzt,
    // liefert das leere Drittel wieder mit aus.
    let end: f64 = y - 8.0 + 290.0 + BORDER_BELOW
    var image: canvas.Canvas = canvas.canvas_new()
    if !zuschnitt(&cv, &image, end) {
        return 8
    }
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&image, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < rt.c_length(path) {
        rt.buf_push(&pf, rt.ld8(path, k))
        k = k + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 10] = "GALLERY 3\n"
    rt.write_everything(1, (&okm[0]) as u64, 10)
    painter.painter_free(&z)
    canvas.canvas_free(&image)
    canvas.canvas_free(&cv)
    return 0
}
