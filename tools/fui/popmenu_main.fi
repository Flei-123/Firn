// SPDX-License-Identifier: MPL-2.0
// tools/fui/popmenu_main.fi -- test for lib/fui/popmenu.fi (the geometry of the popup menu card: layout, clamping, hit test, pop-in)
//
//     popmenu_main      prints POPMENU PASSED / FAILED
import std.rt
import fui.popmenu
import fui.lucide

static mut FAILS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if !ok {
        FAILS = FAILS + 1
        say("FAIL: ")
        say(what)
        say("\n")
    }
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.01
}

fn main(start: u64) -> i32 {
    var m: popmenu.PopMenu = popmenu.pm_new()
    check(!popmenu.pm_is_open(&m), "starts closed")
    popmenu.pm_open(&m, 10.0, 100.0, true, false, 0)
    check(!popmenu.pm_is_open(&m), "an empty menu does not open")
    check(popmenu.pm_add(&m, "Image", lucide.IMAGE, false), "add 1")
    check(popmenu.pm_add(&m, "File", lucide.FILE_TEXT, true), "add 2")
    check(popmenu.pm_count(&m) == 2, "count")
    var i: usize = 0
    while i < popmenu.PM_MAX - 2 { let b: bool = popmenu.pm_add(&m, "x", lucide.PLUS, false); i = i + 1 }
    check(!popmenu.pm_add(&m, "full", lucide.PLUS, false), "full at PM_MAX")
    popmenu.pm_clear(&m)
    let a1: bool = popmenu.pm_add(&m, "Image", lucide.IMAGE, false)
    let a2: bool = popmenu.pm_add(&m, "File", lucide.FILE_TEXT, false)

    // unit 1, window 400 x 800, label width 40: content = max(18 + 10 + 40, 148) = 148; card w = 148 + 24 + 12 = 184; h = 2 * 41 + 2 + 12 = 96
    popmenu.pm_open(&m, 20.0, 700.0, true, false, 1000)
    check(popmenu.pm_is_open(&m), "open")
    popmenu.pm_layout(&m, 1.0, 400.0, 800.0, 40.0)
    check(near(m.w, 184.0) && near(m.h, 96.0), "card size")
    check(near(m.x, 20.0) && near(m.y, 700.0 - 96.0 - 8.0), "opens above the anchor")
    // rows: the first row starts PAD (6) under the card top
    check(popmenu.pm_hit(&m, 30.0, m.y + 10.0) == 0, "hit row 0")
    check(popmenu.pm_hit(&m, 30.0, m.y + 6.0 + 41.0 + 2.0 + 5.0) == 1, "hit row 1")
    check(popmenu.pm_hit(&m, 30.0, m.y + 2.0) == popmenu.PM_CARD, "card padding is not a row")
    check(popmenu.pm_hit(&m, 5.0, m.y + 10.0) == popmenu.PM_OUTSIDE, "left of the card = outside")
    check(popmenu.pm_hit(&m, 30.0, m.y - 3.0) == popmenu.PM_OUTSIDE, "above the card = outside")

    // a wide label widens the card
    popmenu.pm_layout(&m, 1.0, 400.0, 800.0, 200.0)
    check(near(m.w, 28.0 + 200.0 + 24.0 + 12.0), "wide label")
    popmenu.pm_layout(&m, 1.0, 400.0, 800.0, 40.0)

    // clamped to the window: anchored near the right edge -> pushed in by MARGIN (4)
    popmenu.pm_open(&m, 380.0, 700.0, true, false, 0)
    popmenu.pm_layout(&m, 1.0, 400.0, 800.0, 40.0)
    check(near(m.x + m.w, 396.0), "clamped at the right edge")
    // right aligned, opening below
    popmenu.pm_open(&m, 390.0, 50.0, false, true, 0)
    popmenu.pm_layout(&m, 1.0, 400.0, 800.0, 40.0)
    check(near(m.x + m.w, 390.0) && near(m.y, 58.0), "right aligned, below the anchor")
    // too high: pushed down to the margin
    popmenu.pm_open(&m, 20.0, 30.0, true, false, 0)
    popmenu.pm_layout(&m, 1.0, 400.0, 800.0, 40.0)
    check(near(m.y, 4.0), "clamped at the top")
    // label font: design points (default 15), scaled to device px by the unit -- never raw px (a65: text was 1/3.25 size on the phone)
    check(near(popmenu.pm_label_px(&m, 1.0), 15.0), "default label 15 pt at unit 1")
    check(near(popmenu.pm_label_px(&m, 3.25), 48.75), "label scales with the unit (density 3.25)")
    popmenu.pm_set_font(&m, 16.0, 600)
    check(near(popmenu.pm_label_px(&m, 3.25), 52.0) && m.fw == 600, "pm_set_font 16 / 600")
    popmenu.pm_clear(&m)
    check(near(popmenu.pm_label_px(&m, 2.0), 30.0) && m.fw == 400, "pm_clear resets the font")
    let c1: bool = popmenu.pm_add(&m, "Image", lucide.IMAGE, false)
    let c2: bool = popmenu.pm_add(&m, "File", lucide.FILE_TEXT, false)
    // unit 3.25 geometry (1220 x 2712 px window): card w = (148 + 24 + 12) * 3.25 with a short label
    popmenu.pm_open(&m, 20.0, 2000.0, true, false, 0)
    popmenu.pm_layout(&m, 3.25, 1220.0, 2712.0, 40.0)
    check(near(m.w, (148.0 + 36.0) * 3.25) && near(m.h, 96.0 * 3.25), "unit 3.25 card size")
    // unit 2 doubles everything
    popmenu.pm_open(&m, 20.0, 1400.0, true, false, 0)
    popmenu.pm_layout(&m, 2.0, 800.0, 1600.0, 80.0)
    check(near(m.w, 368.0) && near(m.h, 192.0), "unit 2 size")

    // the pop-in: 0 at the start, 1 after PM_ANIM_MS, rising monotonic
    popmenu.pm_open(&m, 20.0, 700.0, true, false, 5000)
    check(near(popmenu.pm_progress(&m, 5000), 0.0), "progress 0")
    check(near(popmenu.pm_progress(&m, 5000 + popmenu.PM_ANIM_MS), 1.0), "progress 1")
    check(popmenu.pm_progress(&m, 5030) < popmenu.pm_progress(&m, 5070), "progress rises")
    check(near(popmenu.pm_progress(&m, 9000), 1.0), "progress stays 1")

    popmenu.pm_close(&m)
    check(!popmenu.pm_is_open(&m), "closed")
    check(popmenu.pm_hit(&m, 30.0, 650.0) == popmenu.PM_OUTSIDE, "closed menu hits nothing")

    if FAILS == 0 {
        say("POPMENU PASSED\n")
        return 0
    }
    say("POPMENU FAILED\n")
    return 1
}
