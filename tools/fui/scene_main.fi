// SPDX-License-Identifier: MPL-2.0
// tools/fui/scene_main.fi -- THE TREE IS RE-CALCULATED.
//
// What is checked here is not "it looks good", but the
// properties without which a description would not be a description:
//
//   1. The tree stands there as it was built: order of the
//      children, parent, number of children.
//   2. The style sheet arrives at the right node -- and what the
//      parent inherits stands at the child, what it does not inherit
//      does not.
//   3. The hit test hits the TOPMOST node under the point
//      and not the first.
//   4. The passes are separate: after painting
//      `scene_size_drift` reports ZERO -- no node has still
//      changed its size while painting.
//
//   5. Measuring and arranging is done with a REAL drawing context
//      (font, canvas, theme), and every number is calculated by
//      hand -- a row of three buttons with gap and
//      inner margin, as in tools/fui/flex_main.fi.
//   6. A pane box with FORTY children: what lies outside the
//      section cannot be clicked, and after scrolling
//      the same point hits a DIFFERENT child.
//   7. The drift guard is sharp: a deliberately wrong painter that
//      changes the size of its node while painting brings
//      `scene_size_drift` to exactly 1. The wrong painter stands HERE
//      and not in the library -- a guard that never trips
//      is none.
//   8. Inheritance goes through THREE levels, and `scene_desc`
//      shifts the node kinds by 1000: a rule on
//      widget.KIND_LABEL must NOT hit an N_TEXT node.
//   9. The FULL tree: 129 calls of `scene_add` create 128 nodes,
//      the 129th returns SCENE_NONE, and no setter on this
//      place writes anything. In addition the two strides
//      (sheet.sheet_desc_stride, flex.flex_item_stride) against the
//      REAL address difference of two array elements -- not against a
//      constant that would stand here a second time.
//  10. A box with 65 children: `scene_kid_overflow` reports EXACTLY 1
//      (with the counter-test at 64: there zero), the 65th child gets
//      no rectangle -- and at (0,0) afterwards the background
//      still stands on the canvas, so it is not painted into the corner.
//  11. A tree with 17 levels: `scene_depth_overflow` reports EXACTLY 1
//      (counter-test at 16: zero), the aborted node really stays
//      without background and its parent is still styled.
//  12. The three limits (KIDS_MAX, the length of the work arrays,
//      flex.FLEX_MAX) fit together -- and a pane box WITHOUT
//      children gets its rectangle nevertheless: all four numbers of the
//      section are re-calculated.
//  13. The FULL tree counts: SCENE_MAX + 3 calls of `scene_add`
//      create 128 nodes and report EXACTLY 3 via
//      `scene_node_overflow` (counter-test at SCENE_MAX: zero), and
//      `scene_overflow_reason` names the reason as ONE number.
//  14. `node_set_bounds` really clamps -- and in flex.fi: without
//      a bound a child does not give up its measured width, with a
//      bound it clamps at 140 and the redistribution gives the rest
//      to its sibling (60).
//  15. THE TRANSFORMATION DOES NOT REPLACE THE KIND. A rotated button stands
//      really crooked (points left of its straight rectangle),
//      a rotated checkbox keeps its CHECK MARK and reports
//      the skipped transformation -- with the counter-test that the old
//      way (`render.draw_widget_xf` for every kind) loses the check mark.
//  16. An image node and an SVG node: measured preferred size
//      (56 x 40), position of the image area at ART_ONLY, ART_LEFT and
//      ART_RIGHT, and the colour channels on the canvas.
//
// Sections 1 to 4 do not depend on the font; if it is missing, only
// the text widths in section 5 are zero, and the check there
// compares tree against render.pref_of, so two numbers from the same
// source.
import std.rt
import paint.canvas
import font.metrics
import fui.style
import fui.theme
import fui.widget
import fui.flex
import fui.painter
import fui.render
import fui.viewport
import fui.transform
import fui.uiimage
import fui.uisvg
import fui.sheet
import fui.scene

const FONTSET_BYTES: usize = 4096
const CW: usize = 420
const CH: usize = 260

// THE DELIBERATELY WRONG PAINTER. It does exactly what a node must not do
// while painting: it changes its size. Thereby the
// counter-test to the drift guard is a REAL one -- it lies in the test, the
// library has no switch for it.
fn painter_wrong(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    widget.w_set_pref(e, widget.w_pref_w(e) + 7.0, widget.w_pref_h(e))
}

// And the well-behaved one: it paints (here: nothing) and leaves the size alone.
fn painter_good(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    render.draw_base(c, e)
}

// ======================================================================
// WHAT STANDS ON THE CANVAS -- THREE COUNTS
// ======================================================================
//
// Sections 14 and 15 claim nothing about images, they COUNT
// pixels. For that this program needs exactly three tools: how
// many points are set in a rectangle, what a rectangle looked like before
// a change, and how many points have changed afterwards. The comparison via a snapshot is
// the most reliable there is: it depends on NO colour of the theme --
// two images of the same node, once with and once without a check mark,
// differ exactly where the check mark stands.
const SCHNAPP_MAX: usize = 2048

fn count_set(cv: *mut canvas.Canvas, x0: usize, y0: usize,
    w: usize, h: usize) -> usize {
    var n: usize = 0
    var y: usize = y0
    while y < y0 + h {
        var x: usize = x0
        while x < x0 + w {
            if canvas.color_a(canvas.canvas_get(cv, x, y)) != 0 as u32 {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn schnappe(cv: *mut canvas.Canvas, x0: usize, y0: usize, w: usize,
    h: usize, out: *mut u32) {
    var i: usize = 0
    var y: usize = y0
    while y < y0 + h {
        var x: usize = x0
        while x < x0 + w {
            if i < SCHNAPP_MAX {
                *((out as u64 + (i * 4) as u64) as *mut u32) =
                canvas.canvas_get(cv, x, y)
            }
            i = i + 1
            x = x + 1
        }
        y = y + 1
    }
}

fn count_other(cv: *mut canvas.Canvas, x0: usize, y0: usize, w: usize,
    h: usize, alt: *mut u32) -> usize {
    var n: usize = 0
    var i: usize = 0
    var y: usize = y0
    while y < y0 + h {
        var x: usize = x0
        while x < x0 + w {
            if i < SCHNAPP_MAX {
                let a: u32 = *((alt as u64 + (i * 4) as u64) as *mut u32)
                if canvas.canvas_get(cv, x, y) != a {
                    n = n + 1
                }
            }
            i = i + 1
            x = x + 1
        }
        y = y + 1
    }
    return n
}

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    var w: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&w[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn main(start: u64) -> i32 {
    var c_karte: [u8; 5] = "karte"
    var c_titel: [u8; 5] = "titel"
    let K: u32 = sheet.sheet_name((&c_karte[0]) as u64, 5)
    let T: u32 = sheet.sheet_name((&c_titel[0]) as u64, 5)

    // ==================================================== 1. THE TREE
    var sc: scene.Scene = scene.scene_new()
    let root: usize = scene.scene_add(&sc, scene.SCENE_NONE,
        scene.N_BOX)
    let karte: usize = scene.scene_add(&sc, root, scene.N_BOX)
    let titel: usize = scene.scene_add(&sc, karte, scene.N_TEXT)
    let line: usize = scene.scene_add(&sc, karte, scene.N_TEXT)
    scene.node_add_class(&sc, karte, K)
    scene.node_add_class(&sc, titel, T)

    var n1: [u8; 30] = "1 die Wurzel hat ein Kind     "
    report((&n1[0]) as u64, 30,
        scene.scene_child_count(&sc, root) == 1,
        scene.scene_child_count(&sc, root) as i64, 1)
    var n2: [u8; 30] = "1 die Karte hat zwei Kinder   "
    report((&n2[0]) as u64, 30,
        scene.scene_child_count(&sc, karte) == 2,
        scene.scene_child_count(&sc, karte) as i64, 2)
    var n3: [u8; 34] = "1 das zweite Kind ist die Zeile   "
    report((&n3[0]) as u64, 34,
        scene.scene_child_at(&sc, karte, 1) == line,
        scene.scene_child_at(&sc, karte, 1) as i64, line as i64)
    var n4: [u8; 35] = "1 der Titel kennt seinen Elternteil"
    report((&n4[0]) as u64, 35, scene.scene_parent(&sc, titel) == karte,
        scene.scene_parent(&sc, titel) as i64, karte as i64)

    // ============================ 2. THE SHEET AND THE INHERITANCE
    //
    // The card gets background AND font colour. At the title the
    // font colour may arrive, the background must NOT -- otherwise every child
    // paints the background of its parent once more.
    var leaf: sheet.Sheet = sheet.sheet_new()
    var d_karte: sheet.Decl = sheet.decl_new()
    var s: style.Style = style.style_new()
    s = style.style_set_bg(s, style.color_literal(17 as u32))
    s = style.style_set_fg(s, style.color_literal(33 as u32))
    sheet.decl_set_style(&d_karte, s)
    sheet.sheet_add(&leaf, sheet.sel_class(K), d_karte)

    scene.scene_style(&sc, &leaf)
    let t_fg: i64 =
    style.color_value((*scene.node_style(&sc, titel)).fg) as i64
    let t_hat_bg: bool = sheet.decl_has(scene.node_decl(&sc, titel),
        style.SF_BG, false)
    let k_bg: i64 =
    style.color_value((*scene.node_style(&sc, karte)).bg) as i64
    var n5: [u8; 34] = "2 die Karte hat ihren Grund       "
    report((&n5[0]) as u64, 34, k_bg == 17, k_bg, 17)
    var n6: [u8; 34] = "2 der Titel erbt die Schriftfarbe "
    report((&n6[0]) as u64, 34, t_fg == 33, t_fg, 33)
    var n7: [u8; 34] = "2 der Titel erbt den Grund NICHT  "
    report((&n7[0]) as u64, 34, !t_hat_bg, t_hat_bg as i64, 0)

    // ============================== 3. THE HIT TEST
    //
    // Without a font nothing is measured, so the rectangles are set by
    // hand -- what is checked is the SELECTION, not the arranging.
    let w_root: *mut scene.Node = scene.scene_node(&sc, root)
    let w_karte: *mut scene.Node = scene.scene_node(&sc, karte)
    let w_titel: *mut scene.Node = scene.scene_node(&sc, titel)
    (*w_root).x = 0.0
    (*w_root).y = 0.0
    (*w_root).w = 400.0
    (*w_root).h = 300.0
    (*w_karte).x = 20.0
    (*w_karte).y = 20.0
    (*w_karte).w = 200.0
    (*w_karte).h = 100.0
    (*w_titel).x = 30.0
    (*w_titel).y = 30.0
    (*w_titel).w = 80.0
    (*w_titel).h = 20.0

    let tr1: usize = scene.scene_hit(&sc, 35.0, 35.0)
    var n8: [u8; 34] = "3 der Punkt im Titel trifft ihn   "
    report((&n8[0]) as u64, 34, tr1 == titel, tr1 as i64, titel as i64)
    let tr2: usize = scene.scene_hit(&sc, 150.0, 90.0)
    var n9: [u8; 34] = "3 daneben trifft die Karte        "
    report((&n9[0]) as u64, 34, tr2 == karte, tr2 as i64, karte as i64)
    let tr3: usize = scene.scene_hit(&sc, 390.0, 290.0)
    var n10: [u8; 34] = "3 ganz aussen trifft die Wurzel   "
    report((&n10[0]) as u64, 34, tr3 == root, tr3 as i64,
        root as i64)

    // ======================================== 4. DIE DURCHGAENGE
    var n11: [u8; 34] = "4 nach dem Stil steht Durchgang 1 "
    report((&n11[0]) as u64, 34,
        scene.scene_phase(&sc) == scene.PHASE_STYLE,
        scene.scene_phase(&sc) as i64, scene.PHASE_STYLE as i64)
    var n12: [u8; 34] = "4 keine Groesse driftet beim Malen"
    report((&n12[0]) as u64, 34, scene.scene_size_drift(&sc) == 0,
        scene.scene_size_drift(&sc) as i64, 0)

    // ==================================================================
    // THE REAL DRAWING CONTEXT
    // ==================================================================
    //
    // From here on, calculation is done with font, canvas and theme -- that is,
    // exactly with what a gallery paints with. None of it is imitated:
    // the font comes from lib/font, the canvas from
    // lib/paint, the measuring from lib/fui/render.fi.
    var fbuf: rt.Buf = rt.buf_new()
    var fpfad: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
    let has_font: bool = rt.read_file((&fpfad[0]) as u64, &fbuf)
    let fsp: *mut metrics.FontSet =
    rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if has_font {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, CW, CH) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, CW, 200) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(true)
    var c: render.Ctx = render.ctx_new(&m, &z)
    var empty: sheet.Sheet = sheet.sheet_new()

    // ================== 5. MEASURING AND ARRANGING, CALCULATED BY HAND
    //
    // A row of three buttons with fixed size (60, 80, 40 wide,
    // each 30 high), gap 12, inner margin left/right 10 and top/bottom
    // 8. Thereby every number is fixed beforehand:
    //
    //     width   = 10 + 60 + 12 + 80 + 12 + 40 + 10 = 224
    //     height  =  8 + 30 +  8                     =  46
    //     x of the three children: 10, 82, 174; y: 8; height 30 each.
    //
    // The fixed size is deliberate: this way the calculation does NOT depend on
    // the font of the machine on which this run happens -- the
    // font is checked in section 5b.
    scene.scene_reset(&sc)
    let row: usize = scene.scene_add(&sc, scene.SCENE_NONE,
        scene.N_BOX)
    scene.node_set_flex(&sc, row, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    scene.node_set_gap(&sc, row, 12, 0)
    scene.node_set_padding(&sc, row, 10, 8, 10, 8)
    let kn1: usize = scene.scene_add(&sc, row, scene.N_WIDGET)
    let kn2: usize = scene.scene_add(&sc, row, scene.N_WIDGET)
    let kn3: usize = scene.scene_add(&sc, row, scene.N_WIDGET)
    scene.node_set_widget_kind(&sc, kn1, widget.KIND_BUTTON)
    scene.node_set_widget_kind(&sc, kn2, widget.KIND_BUTTON)
    scene.node_set_widget_kind(&sc, kn3, widget.KIND_BUTTON)
    scene.node_set_size(&sc, kn1, 60.0, 30.0)
    scene.node_set_size(&sc, kn2, 80.0, 30.0)
    scene.node_set_size(&sc, kn3, 40.0, 30.0)
    scene.scene_style(&sc, &empty)
    scene.scene_measure(&sc, &c)

    var n13: [u8; 34] = "5 die Zeile misst sich 224 breit  "
    report((&n13[0]) as u64, 34,
        scene.node_pref_w(&sc, row) as i64 == 224,
        scene.node_pref_w(&sc, row) as i64, 224)
    var n14: [u8; 34] = "5 und 46 hoch                     "
    report((&n14[0]) as u64, 34,
        scene.node_pref_h(&sc, row) as i64 == 46,
        scene.node_pref_h(&sc, row) as i64, 46)

    scene.scene_layout(&sc, &c, 0.0, 0.0, 224.0, 46.0)
    var n15: [u8; 34] = "5 der erste Knopf steht bei x=10  "
    report((&n15[0]) as u64, 34, scene.node_x(&sc, kn1) as i64 == 10,
        scene.node_x(&sc, kn1) as i64, 10)
    var n16: [u8; 34] = "5 der zweite bei x=82             "
    report((&n16[0]) as u64, 34, scene.node_x(&sc, kn2) as i64 == 82,
        scene.node_x(&sc, kn2) as i64, 82)
    var n17: [u8; 34] = "5 der dritte bei x=174            "
    report((&n17[0]) as u64, 34, scene.node_x(&sc, kn3) as i64 == 174,
        scene.node_x(&sc, kn3) as i64, 174)
    var n18: [u8; 34] = "5 alle drei sitzen bei y=8        "
    report((&n18[0]) as u64, 34, scene.node_y(&sc, kn2) as i64 == 8,
        scene.node_y(&sc, kn2) as i64, 8)
    var n19: [u8; 34] = "5 und sind 30 hoch (stretch)      "
    report((&n19[0]) as u64, 34, scene.node_h(&sc, kn3) as i64 == 30,
        scene.node_h(&sc, kn3) as i64, 30)
    var n20: [u8; 34] = "5 der dritte ist 40 breit         "
    report((&n20[0]) as u64, 34, scene.node_w(&sc, kn3) as i64 == 40,
        scene.node_w(&sc, kn3) as i64, 40)

    // 100 points more room, and ONLY the middle one grows: 80 + 100 =
    // 180, the third slides to 10+60+12+180+12 = 274.
    scene.node_set_grow(&sc, kn2, 1000, 1000)
    scene.scene_layout(&sc, &c, 0.0, 0.0, 324.0, 46.0)
    var n21: [u8; 34] = "5 der wachsende wird 180 breit    "
    report((&n21[0]) as u64, 34, scene.node_w(&sc, kn2) as i64 == 180,
        scene.node_w(&sc, kn2) as i64, 180)
    var n22: [u8; 34] = "5 der erste bleibt 60 breit       "
    report((&n22[0]) as u64, 34, scene.node_w(&sc, kn1) as i64 == 60,
        scene.node_w(&sc, kn1) as i64, 60)
    var n23: [u8; 34] = "5 der dritte rutscht auf x=274    "
    report((&n23[0]) as u64, 34, scene.node_x(&sc, kn3) as i64 == 274,
        scene.node_x(&sc, kn3) as i64, 274)

    // And the image for it: painting is done with render.fi and wave3.fi,
    // and NO size changes any more in the process.
    canvas.canvas_clear(&cv, theme.opaque((*theme.theme_colors(&m)).base))
    scene.scene_draw(&sc, &c)
    var n24: [u8; 39] = "5 echtes Malen treibt keine Groesse    "
    report((&n24[0]) as u64, 39, scene.scene_size_drift(&sc) == 0,
        scene.scene_size_drift(&sc) as i64, 0)
    var n25: [u8; 39] = "5 nach dem Malen steht Durchgang 4     "
    report((&n25[0]) as u64, 39,
        scene.scene_phase(&sc) == scene.PHASE_DRAW,
        scene.scene_phase(&sc) as i64, scene.PHASE_DRAW as i64)

    // ---- 5b. THE TREE MEASURES LIKE render.pref_of, NOT DIFFERENTLY
    //
    // A text node and a widget with the same text must arrive at the
    // same value. If there were a second measurement in scene.fi, the
    // difference would stand here.
    scene.scene_reset(&sc)
    let nur_text: usize = scene.scene_add(&sc, scene.SCENE_NONE,
        scene.N_TEXT)
    var tx: [u8; 11] = "Datenschutz"
    scene.node_set_text(&sc, nur_text, (&tx[0]) as u64, 11)
    scene.scene_style(&sc, &empty)
    scene.scene_measure(&sc, &c)
    var probe: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_set_text(&probe, (&tx[0]) as u64, 11)
    var ppw: f64 = 0.0
    var pph: f64 = 0.0
    render.pref_of(&c, &probe, &ppw, &pph)
    var n26: [u8; 39] = "5b der Textknoten misst wie pref_of    "
    report((&n26[0]) as u64, 39,
        scene.node_pref_w(&sc, nur_text) == ppw,
        scene.node_pref_w(&sc, nur_text) as i64, ppw as i64)
    var n27: [u8; 39] = "5b und in der Hoehe ebenso             "
    report((&n27[0]) as u64, 39,
        scene.node_pref_h(&sc, nur_text) == pph,
        scene.node_pref_h(&sc, nur_text) as i64, pph as i64)

    // ================== 6. FORTY ROWS IN A PANE BOX
    //
    // The section sits at (50,50) and is 200 x 100 large; the
    // content is 180 x 1000 -- so forty rows of 25 points.
    // 180 instead of 200, so that NO horizontal bar becomes necessary: the
    // vertical one takes 12 points, 180 fits into the remaining 188.
    // Thus rows 0 to 3 are visible.
    var vp: viewport.Viewport =
    viewport.viewport_new(50.0, 50.0, 200.0, 100.0, 180.0, 1000.0)
    scene.scene_reset(&sc)
    let list: usize = scene.scene_add(&sc, scene.SCENE_NONE,
        scene.N_VIEWPORT)
    scene.node_set_viewport(&sc, list, &vp)
    scene.node_set_flex(&sc, list, flex.FLEX_COLUMN,
        flex.JUSTIFY_START, flex.AL_STRETCH)
    var lines: [usize; 40] = [0; 40]
    var zi: usize = 0
    while zi < 40 {
        lines[zi] = scene.scene_add(&sc, list, scene.N_BOX)
        scene.node_set_size(&sc, lines[zi], 0.0, 25.0)
        zi = zi + 1
    }
    scene.scene_style(&sc, &empty)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 50.0, 50.0, 200.0, 100.0)

    var n28: [u8; 39] = "6 vierzig Kinder haengen im Kasten     "
    report((&n28[0]) as u64, 39,
        scene.scene_child_count(&sc, list) == 40,
        scene.scene_child_count(&sc, list) as i64, 40)
    var n29: [u8; 44] = "6 der Kasten misst SEINEN Ausschnitt (100)  "
    report((&n29[0]) as u64, 44,
        scene.node_pref_h(&sc, list) as i64 == 100,
        scene.node_pref_h(&sc, list) as i64, 100)
    var n30: [u8; 44] = "6 die vierte Zeile sitzt bei y=125          "
    report((&n30[0]) as u64, 44,
        scene.node_y(&sc, lines[3]) as i64 == 125,
        scene.node_y(&sc, lines[3]) as i64, 125)
    var n31: [u8; 44] = "6 die Zeile ist 180 breit (Inhalt)          "
    report((&n31[0]) as u64, 44,
        scene.node_w(&sc, lines[3]) as i64 == 180,
        scene.node_w(&sc, lines[3]) as i64, 180)

    let h1: usize = scene.scene_hit(&sc, 60.0, 130.0)
    var n32: [u8; 44] = "6 der Punkt (60,130) trifft die vierte      "
    report((&n32[0]) as u64, 44, h1 == lines[3], h1 as i64,
        lines[3] as i64)
    // Row 20 stands at y = 550 -- far below the section. Its
    // rectangle says so too; it cannot be clicked nevertheless.
    var n33: [u8; 44] = "6 Zeile 20 steht bei y=550 (ausserhalb)     "
    report((&n33[0]) as u64, 44,
        scene.node_y(&sc, lines[20]) as i64 == 550,
        scene.node_y(&sc, lines[20]) as i64, 550)
    let h2: usize = scene.scene_hit(&sc, 60.0, 560.0)
    var n34: [u8; 44] = "6 und ist NICHT anklickbar                  "
    report((&n34[0]) as u64, 44, h2 == scene.SCENE_NONE, h2 as i64,
        scene.SCENE_NONE as i64)
    // Under the vertical bar (x >= 50 + 188) nothing is hit
    // either -- otherwise one clicks through the bar.
    let h3: usize = scene.scene_hit(&sc, 244.0, 60.0)
    var n35: [u8; 44] = "6 durch den Rollbalken klickt niemand       "
    report((&n35[0]) as u64, 44, h3 == scene.SCENE_NONE, h3 as i64,
        scene.SCENE_NONE as i64)

    // ---- AND NOW IT IS SCROLLED. 200 points downwards, then a
    // renewed scene_layout -- nothing is pushed afterwards while painting.
    viewport.viewport_set_offset(&vp, 0.0, 200.0)
    scene.scene_layout(&sc, &c, 50.0, 50.0, 200.0, 100.0)
    let h4: usize = scene.scene_hit(&sc, 60.0, 130.0)
    // THE NUMBER IN THE LABEL IS THE ONE THAT IS PRINTED. What is hit
    // is `zeilen[11]`, so the TWELFTH row -- and because the pane
    // box itself is node 0, its node index is 12. Exactly
    // these 12 stand in "got X want Y"; a label that says 11
    // and compares 12 makes the reader do the calculation twice.
    var n36: [u8; 44] = "6 nach dem Rollen trifft derselbe Punkt 12  "
    report((&n36[0]) as u64, 44, h4 == lines[11], h4 as i64,
        lines[11] as i64)
    var n37: [u8; 44] = "6 und das ist ein ANDERER Knoten als vorher "
    report((&n37[0]) as u64, 44, h4 != h1, (h4 != h1) as i64, 1)
    var n38: [u8; 44] = "6 Zeile 11 steht nun bei y=125              "
    report((&n38[0]) as u64, 44,
        scene.node_y(&sc, lines[11]) as i64 == 125,
        scene.node_y(&sc, lines[11]) as i64, 125)
    // Row 0 has scrolled out upwards: its rectangle lies at
    // y = -150, and there the check hits nothing any more.
    let h5: usize = scene.scene_hit(&sc, 60.0, 40.0)
    var n39: [u8; 44] = "6 die herausgerollte Zeile 0 trifft nicht   "
    report((&n39[0]) as u64, 44, h5 == scene.SCENE_NONE, h5 as i64,
        scene.SCENE_NONE as i64)

    canvas.canvas_clear(&cv, theme.opaque((*theme.theme_colors(&m)).base))
    scene.scene_draw(&sc, &c)
    var n40: [u8; 44] = "6 auch der Kasten malt ohne Groessendrift   "
    report((&n40[0]) as u64, 44, scene.scene_size_drift(&sc) == 0,
        scene.scene_size_drift(&sc) as i64, 0)

    // ====================== 7. THE DRIFT GUARD, WITH COUNTER-TEST
    //
    // First the well-behaved painter: it paints and leaves the size standing --
    // the guard reports nothing. Then the same tree with the wrong
    // painter at ONE node: the guard reports exactly one deviation,
    // not zero and not two.
    scene.scene_reset(&sc)
    let guard: usize = scene.scene_add(&sc, scene.SCENE_NONE,
        scene.N_BOX)
    scene.node_set_flex(&sc, guard, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    let good: usize = scene.scene_add(&sc, guard, scene.N_BOX)
    let boese: usize = scene.scene_add(&sc, guard, scene.N_BOX)
    scene.node_set_size(&sc, good, 40.0, 20.0)
    scene.node_set_size(&sc, boese, 40.0, 20.0)
    scene.node_set_draw(&sc, good, 0, painter_good)
    scene.scene_style(&sc, &empty)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 0.0, 0.0, 80.0, 20.0)
    canvas.canvas_clear(&cv, theme.opaque((*theme.theme_colors(&m)).base))
    scene.scene_draw(&sc, &c)
    var n41: [u8; 44] = "7 der brave Maler treibt nichts             "
    report((&n41[0]) as u64, 44, scene.scene_size_drift(&sc) == 0,
        scene.scene_size_drift(&sc) as i64, 0)

    scene.node_set_draw(&sc, boese, 0, painter_wrong)
    canvas.canvas_clear(&cv, theme.opaque((*theme.theme_colors(&m)).base))
    scene.scene_draw(&sc, &c)
    var n42: [u8; 44] = "7 der falsche Maler wird gemeldet: genau 1  "
    report((&n42[0]) as u64, 44, scene.scene_size_drift(&sc) == 1,
        scene.scene_size_drift(&sc) as i64, 1)

    // ============ 8. INHERITANCE THROUGH THREE LEVELS AND THE KINDS
    //
    // The root carries font colour, font size AND inner margin.
    // Through two levels the first two arrive at the text,
    // the inner margin does NOT -- that is the limit that sheet.fi draws.
    var c_page: [u8; 5] = "seite"
    var c_kart2: [u8; 5] = "kart2"
    let S: u32 = sheet.sheet_name((&c_page[0]) as u64, 5)
    let K2: u32 = sheet.sheet_name((&c_kart2[0]) as u64, 5)
    var sheet3: sheet.Sheet = sheet.sheet_new()
    var d_page: sheet.Decl = sheet.decl_new()
    var s3: style.Style = style.style_new()
    s3 = style.style_set_fg(s3, style.color_literal(77 as u32))
    s3 = style.style_set_font(s3, 0, 19)
    s3 = style.style_set_pad(s3, 13, 13)
    sheet.decl_set_style(&d_page, s3)
    sheet.sheet_add(&sheet3, sheet.sel_class(S), d_page)
    // A rule on the KIND "label" (widget.KIND_LABEL = 1).
    // An N_TEXT node carries this widget, but `scene_desc` reports
    // its kind as 1000 + N_TEXT -- so the rule must NOT
    // hit it. Without the shift by 1000 it would hit it, and every
    // rule on a button would hit N_IMAGE at the same time.
    var d_label: sheet.Decl = sheet.decl_new()
    var s4: style.Style = style.style_new()
    s4 = style.style_set_bg(s4, style.color_literal(42 as u32))
    sheet.decl_set_style(&d_label, s4)
    sheet.sheet_add(&sheet3, sheet.sel_kind(widget.KIND_LABEL), d_label)
    // And the rule on the NODE KIND does hit it, very much so.
    var d_ntext: sheet.Decl = sheet.decl_new()
    var s5: style.Style = style.style_new()
    s5 = style.style_set_bg(s5, style.color_literal(99 as u32))
    sheet.decl_set_style(&d_ntext, s5)
    sheet.sheet_add(&sheet3, sheet.sel_kind(1000 as u32 + scene.N_TEXT),
        d_ntext)

    scene.scene_reset(&sc)
    let e1: usize = scene.scene_add(&sc, scene.SCENE_NONE, scene.N_BOX)
    let e2: usize = scene.scene_add(&sc, e1, scene.N_BOX)
    let e3: usize = scene.scene_add(&sc, e2, scene.N_TEXT)
    scene.node_add_class(&sc, e1, S)
    scene.node_add_class(&sc, e2, K2)
    scene.scene_style(&sc, &sheet3)

    let e3_fg: i64 =
    style.color_value((*scene.node_style(&sc, e3)).fg) as i64
    var n43: [u8; 44] = "8 die Farbe kommt drei Ebenen tief an       "
    report((&n43[0]) as u64, 44, e3_fg == 77, e3_fg, 77)
    let e3_px: i64 = (*scene.node_style(&sc, e3)).font_px as i64
    var n44: [u8; 44] = "8 die Schriftgroesse ebenso                 "
    report((&n44[0]) as u64, 44, e3_px == 19, e3_px, 19)
    let e3_pad: bool = sheet.decl_has(scene.node_decl(&sc, e3),
        style.SF_PAD_X, false)
    var n45: [u8; 44] = "8 der Innenrand kommt NICHT an              "
    report((&n45[0]) as u64, 44, !e3_pad, e3_pad as i64, 0)
    let e2_fg: i64 =
    style.color_value((*scene.node_style(&sc, e2)).fg) as i64
    var n46: [u8; 44] = "8 die mittlere Ebene erbt sie auch          "
    report((&n46[0]) as u64, 44, e2_fg == 77, e2_fg, 77)

    var desc_text: sheet.NodeDesc = scene.scene_desc(&sc, e3)
    var n47: [u8; 44] = "8 scene_desc meldet 1002 fuer N_TEXT        "
    report((&n47[0]) as u64, 44, desc_text.kind == 1002 as u32,
        desc_text.kind as i64, 1002)
    let e3_bg: i64 =
    style.color_value((*scene.node_style(&sc, e3)).bg) as i64
    var n48: [u8; 44] = "8 die Regel auf die Knotenart trifft (99)   "
    report((&n48[0]) as u64, 44, e3_bg == 99, e3_bg, 99)
    var n49: [u8; 44] = "8 die Regel auf KIND_LABEL trifft NICHT     "
    report((&n49[0]) as u64, 44, e3_bg != 42, e3_bg, 99)
    // A widget node, on the other hand, reports the kind OF ITS widget.
    let knopf: usize = scene.scene_add(&sc, e2, scene.N_WIDGET)
    scene.node_set_widget_kind(&sc, knopf, widget.KIND_BUTTON)
    var desc_knopf: sheet.NodeDesc = scene.scene_desc(&sc, knopf)
    var n50: [u8; 44] = "8 ein Widget-Knoten meldet KIND_BUTTON      "
    report((&n50[0]) as u64, 44,
        desc_knopf.kind == widget.KIND_BUTTON,
        desc_knopf.kind as i64, widget.KIND_BUTTON as i64)

    // ================= 9. THE FULL TREE AND THE STRIDES
    //
    // A TREE HAS AN END, and what comes after must be honestly
    // rejected. Formerly `scene_add` returned SCENE_MAX when the array was
    // full -- a number that looks like a place; whoever called
    // `node_set_text` with it wrote behind the last
    // array element. Now SCENE_NONE comes, and EVERY setter checks
    // its place. Both are re-calculated here: 129 calls, 128
    // nodes, and the mark that the 129th wanted to set stands at
    // not a single node.
    scene.scene_reset(&sc)
    let stem: usize = scene.scene_add(&sc, scene.SCENE_NONE, scene.N_BOX)
    var gebaut: usize = 1
    while gebaut < scene.SCENE_MAX {
        scene.scene_add(&sc, stem, scene.N_BOX)
        gebaut = gebaut + 1
    }
    var n51: [u8; 44] = "9 der Baum fasst genau 128 Knoten           "
    report((&n51[0]) as u64, 44, scene.scene_count(&sc) == 128,
        scene.scene_count(&sc) as i64, 128)
    let full: usize = scene.scene_add(&sc, stem, scene.N_BOX)
    var n52: [u8; 44] = "9 der 129. Aufruf liefert SCENE_NONE        "
    report((&n52[0]) as u64, 44, full == scene.SCENE_NONE, full as i64,
        scene.SCENE_NONE as i64)
    var n53: [u8; 44] = "9 und legt keinen 129. Knoten an            "
    report((&n53[0]) as u64, 44, scene.scene_count(&sc) == 128,
        scene.scene_count(&sc) as i64, 128)
    // The setters on the non-existent node: they must do NOTHING.
    // That is measured by the mark 4242 -- it must appear at none
    // of the 128 nodes -- and by the class that `node_add_class`
    // must reject.
    let MARK: u32 = 4242 as u32
    scene.node_set_id(&sc, full, MARK)
    scene.node_set_size(&sc, full, 99.0, 99.0)
    scene.node_set_text(&sc, full, (&c_page[0]) as u64, 5)
    scene.node_set_widget_kind(&sc, full, widget.KIND_BUTTON)
    let took_class: bool = scene.node_add_class(&sc, full, S)
    var n54: [u8; 44] = "9 node_add_class weist den Platz zurueck    "
    report((&n54[0]) as u64, 44, !took_class, took_class as i64, 0)
    var marks: usize = 0
    var last_classes: usize = 0
    var q: usize = 0
    while q < scene.scene_count(&sc) {
        if scene.node_id(&sc, q) == MARK {
            marks = marks + 1
        }
        if q == scene.scene_count(&sc) - 1 {
            last_classes = scene.node_class_count(&sc, q)
        }
        q = q + 1
    }
    var n55: [u8; 44] = "9 kein Knoten traegt die Marke des 129.     "
    report((&n55[0]) as u64, 44, marks == 0, marks as i64, 0)
    var n56: [u8; 44] = "9 der letzte Knoten blieb ohne Klasse       "
    report((&n56[0]) as u64, 44, last_classes == 0,
        last_classes as i64, 0)
    // THE STRIDES. scene.fi lays out two arrays as pointers --
    // the chain of NodeDesc (sheet.fi) and the FlexItems (flex.fi) --
    // and calculates the address of the i-th member. The number for that
    // stands in none of the three modules as a digit; it comes from
    // sheet.sheet_desc_stride or flex.flex_item_stride. It is checked
    // against the REAL address difference of two neighbours of an array
    // -- not against a constant that would stand here again.
    var chain_list: [sheet.NodeDesc; 2] = [sheet.desc_new(0 as u32, 0 as u32); 2]
    let diff_desc: i64 = ((&chain_list[1]) as u64 - (&chain_list[0]) as u64) as i64
    var n57: [u8; 44] = "9 sheet_desc_stride ist die Adressdifferenz "
    report((&n57[0]) as u64, 44,
        sheet.sheet_desc_stride() as i64 == diff_desc,
        sheet.sheet_desc_stride() as i64, diff_desc)
    var children: [flex.FlexItem; 2] = [flex.flex_item(0, 0); 2]
    let diff_item: i64 = ((&children[1]) as u64 - (&children[0]) as u64) as i64
    var n58: [u8; 44] = "9 flex_item_stride ist die Adressdifferenz  "
    report((&n58[0]) as u64, 44,
        flex.flex_item_stride() as i64 == diff_item,
        flex.flex_item_stride() as i64, diff_item)

    // ============ 10. MORE CHILDREN THAN A BOX CAN DISTRIBUTE
    //
    // A box distributes KIDS_MAX = 64 children. Whoever gives it 65 has
    // one too many -- and until this round the tree swallowed it
    // silently: it got no rectangle, stayed at (0,0) with
    // size zero and was painted there. Now the box counts up
    // ONCE, and `draw_node` leaves out nodes without area.
    //
    // First the counter-test with exactly 64 children: there the number may be
    // zero, otherwise the counter would report every box.
    scene.scene_reset(&sc)
    let k64: usize = scene.scene_add(&sc, scene.SCENE_NONE, scene.N_BOX)
    scene.node_set_flex(&sc, k64, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    var g64: usize = 0
    while g64 < 64 {
        let kk: usize = scene.scene_add(&sc, k64, scene.N_BOX)
        scene.node_set_size(&sc, kk, 40.0, 2.0)
        g64 = g64 + 1
    }
    scene.scene_style(&sc, &empty)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 10.0, 10.0, 400.0, 180.0)
    var n59: [u8; 44] = "10 vierundsechzig Kinder laufen nicht ueber "
    report((&n59[0]) as u64, 44, scene.scene_kid_overflow(&sc) == 0,
        scene.scene_kid_overflow(&sc) as i64, 0)

    // And now 65. The 65th node is the last that `scene_add`
    // returned; it gets no rectangle.
    scene.scene_reset(&sc)
    let k65: usize = scene.scene_add(&sc, scene.SCENE_NONE, scene.N_BOX)
    scene.node_set_flex(&sc, k65, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    var last: usize = scene.SCENE_NONE
    var g65: usize = 0
    while g65 < 65 {
        last = scene.scene_add(&sc, k65, scene.N_BOX)
        scene.node_set_size(&sc, last, 40.0, 2.0)
        g65 = g65 + 1
    }
    scene.scene_style(&sc, &empty)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 10.0, 10.0, 400.0, 180.0)
    var n60: [u8; 44] = "10 das 65. Kind wird gemeldet: genau 1      "
    report((&n60[0]) as u64, 44, scene.scene_kid_overflow(&sc) == 1,
        scene.scene_kid_overflow(&sc) as i64, 1)
    var n61: [u8; 44] = "10 es hat 65 Kinder am Kasten               "
    report((&n61[0]) as u64, 44,
        scene.scene_child_count(&sc, k65) == 65,
        scene.scene_child_count(&sc, k65) as i64, 65)
    // It has no rectangle: width and height are zero. Exactly because of that
    // it must never be painted.
    let ueberw: i64 = scene.node_w(&sc, last) as i64
    let ueberh: i64 = scene.node_h(&sc, last) as i64
    var n62: [u8; 44] = "10 und bekommt kein Rechteck (Breite 0)     "
    report((&n62[0]) as u64, 44, ueberw == 0, ueberw, 0)
    var n63: [u8; 44] = "10 auch keine Hoehe                         "
    report((&n63[0]) as u64, 44, ueberh == 0, ueberh, 0)
    // AND THE PROOF ON THE CANVAS: at (0,0) the background still stands
    // after painting. The box begins at (10,10), so
    // ONLY the overflowed node would get there -- it is not
    // painted, and that is here no claim, but a
    // pixel.
    let ground65: u32 = theme.opaque((*theme.theme_colors(&m)).base)
    canvas.canvas_clear(&cv, ground65)
    scene.scene_draw(&sc, &c)
    let corner: u32 = canvas.canvas_get(&cv, 0, 0)
    var n64: [u8; 44] = "10 bei (0,0) steht kein Knoten im Bild      "
    report((&n64[0]) as u64, 44, corner == ground65, corner as i64,
        ground65 as i64)

    // ================= 11. DEEPER THAN THE CHAIN THAT EXISTS
    //
    // A chain is sheet.CHAIN_MAX = 16 levels long. A tree with 17
    // levels thus has a node for which there is no chain any more:
    // it stays UNSTYLED. Until this round that happened silently.
    //
    // First the counter-test with 16 levels -- they fit, the number stays
    // zero.
    var d_box: sheet.Decl = sheet.decl_new()
    var s_box: style.Style = style.style_new()
    s_box = style.style_set_bg(s_box, style.color_literal(55 as u32))
    sheet.decl_set_style(&d_box, s_box)
    var sheet4: sheet.Sheet = sheet.sheet_new()
    sheet.sheet_add(&sheet4, sheet.sel_kind(1000 as u32 + scene.N_BOX),
        d_box)

    scene.scene_reset(&sc)
    var vor: usize = scene.scene_add(&sc, scene.SCENE_NONE, scene.N_BOX)
    var e16: usize = 1
    while e16 < 16 {
        vor = scene.scene_add(&sc, vor, scene.N_BOX)
        e16 = e16 + 1
    }
    scene.scene_style(&sc, &sheet4)
    var n65: [u8; 44] = "11 sechzehn Ebenen passen in die Kette      "
    report((&n65[0]) as u64, 44, scene.scene_depth_overflow(&sc) == 0,
        scene.scene_depth_overflow(&sc) as i64, 0)
    let deep16: bool = sheet.decl_has(scene.node_decl(&sc, vor),
        style.SF_BG, false)
    var n66: [u8; 44] = "11 die 16. Ebene bekommt ihren Grund        "
    report((&n66[0]) as u64, 44, deep16, deep16 as i64, 1)

    // And now 17 levels: the 17th node lies at depth 16, there
    // `style_walk` aborts -- ONCE, not zero times and not
    // twice.
    scene.scene_reset(&sc)
    var chain17: usize = scene.scene_add(&sc, scene.SCENE_NONE,
        scene.N_BOX)
    var e17: usize = 1
    while e17 < 17 {
        chain17 = scene.scene_add(&sc, chain17, scene.N_BOX)
        e17 = e17 + 1
    }
    scene.scene_style(&sc, &sheet4)
    var n67: [u8; 44] = "11 die 17. Ebene wird gemeldet: genau 1     "
    report((&n67[0]) as u64, 44, scene.scene_depth_overflow(&sc) == 1,
        scene.scene_depth_overflow(&sc) as i64, 1)
    var n68: [u8; 44] = "11 der Baum hat 17 Knoten                   "
    report((&n68[0]) as u64, 44, scene.scene_count(&sc) == 17,
        scene.scene_count(&sc) as i64, 17)
    // The aborted node really has NO background -- that is the
    // consequence that the counter reports.
    let deep17: bool = sheet.decl_has(scene.node_decl(&sc, chain17),
        style.SF_BG, false)
    var n69: [u8; 44] = "11 und bleibt ohne Grund (ungestylt)        "
    report((&n69[0]) as u64, 44, !deep17, deep17 as i64, 0)
    // Its parent at depth 15, on the other hand, is styled: the abort
    // hits exactly one level and not half the tree.
    let parents17: usize = scene.scene_parent(&sc, chain17)
    let tief16b: bool = sheet.decl_has(scene.node_decl(&sc, parents17),
        style.SF_BG, false)
    var n70: [u8; 44] = "11 sein Elternteil ist noch gestylt         "
    report((&n70[0]) as u64, 44, tief16b, tief16b as i64, 1)

    // ======== 12. THE LIMITS AND THE EMPTY PANE BOX
    //
    // TWO THINGS THAT ONE DOES NOT SEE UNTIL THEY HURT.
    //
    // The first are the array lengths. In `measure_node` and
    // `layout_node` there lie four work arrays, and their length stands
    // there as a DIGIT -- Firn accepts no name for an array length
    // ("expected an integer array length"). So the number exists
    // twice, and here it is re-calculated that the three limits
    // fit together: KIDS_MAX (64) at most as large as the
    // array length (scene_work_max) and at most as large as
    // flex.FLEX_MAX. If that does not hold, `scene_measure` does not
    // calculate at all, but REPORTS (`scene_limit_break`) -- a
    // write access behind the array would be the alternative.
    //
    // The second is a pane box WITHOUT children. Until
    // 21.09.2026 `layout_node` returned at `nkids == 0` BEFORE
    // the section got its rectangle: an emptily filtered list
    // kept the rectangle from creation, its bars sat elsewhere than
    // its background, and the clip cut off an area that no longer
    // existed. So here an empty box is arranged and each of
    // its four numbers is re-calculated.
    var n71: [u8; 44] = "12 die drei Schranken passen zusammen       "
    report((&n71[0]) as u64, 44, scene.scene_limits_ok(),
        scene.scene_limits_ok() as i64, 1)
    var n72: [u8; 44] = "12 KIDS_MAX ist die Laenge der Felder: 64   "
    report((&n72[0]) as u64, 44,
        scene.KIDS_MAX == scene.scene_work_max(),
        scene.scene_work_max() as i64, scene.KIDS_MAX as i64)
    var n73: [u8; 44] = "12 und nicht groesser als flex.FLEX_MAX     "
    report((&n73[0]) as u64, 44, scene.KIDS_MAX <= flex.FLEX_MAX,
        flex.FLEX_MAX as i64, scene.KIDS_MAX as i64)

    // The empty pane box. Its content is 400 x 900, its
    // section becomes 200 x 120 large on arranging -- so it needs
    // both bars (12 points thick), and the scroll position 300 lies
    // within the 792 that it yields vertically (900 - (120 - 12)).
    var leerv: viewport.Viewport = viewport.viewport_new(0.0, 0.0, 10.0,
        10.0, 400.0, 900.0)
    viewport.viewport_set_bar(&leerv, 12)
    scene.scene_reset(&sc)
    let leerk: usize = scene.scene_add(&sc, scene.SCENE_NONE,
        scene.N_VIEWPORT)
    scene.node_set_viewport(&sc, leerk, &leerv)
    scene.scene_style(&sc, &empty)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 30.0, 20.0, 200.0, 120.0)
    viewport.viewport_set_offset(&leerv, 0.0, 300.0)
    var n74: [u8; 44] = "12 der leere Ausschnitt steht bei x = 30    "
    report((&n74[0]) as u64, 44,
        viewport.viewport_x(&leerv) as i64 == 30,
        viewport.viewport_x(&leerv) as i64, 30)
    var n75: [u8; 44] = "12 und bei y = 20                           "
    report((&n75[0]) as u64, 44,
        viewport.viewport_y(&leerv) as i64 == 20,
        viewport.viewport_y(&leerv) as i64, 20)
    var n76: [u8; 44] = "12 seine Breite ist 200                     "
    report((&n76[0]) as u64, 44,
        viewport.viewport_w(&leerv) as i64 == 200,
        viewport.viewport_w(&leerv) as i64, 200)
    var n77: [u8; 44] = "12 seine Hoehe ist 120                      "
    report((&n77[0]) as u64, 44,
        viewport.viewport_h(&leerv) as i64 == 120,
        viewport.viewport_h(&leerv) as i64, 120)
    // And the consequences: the vertical bar takes 12 points of
    // width away (188 remain), the horizontal one 12 points of height (108),
    // and the content at scroll position 300 stands higher by exactly these 300
    // points: 20 - 300 = -280.
    var n78: [u8; 44] = "12 innen bleiben 188 Punkte Breite          "
    report((&n78[0]) as u64, 44,
        viewport.viewport_inner_w(&leerv) as i64 == 188,
        viewport.viewport_inner_w(&leerv) as i64, 188)
    var n79: [u8; 44] = "12 und 108 Punkte Hoehe                     "
    report((&n79[0]) as u64, 44,
        viewport.viewport_inner_h(&leerv) as i64 == 108,
        viewport.viewport_inner_h(&leerv) as i64, 108)
    var n80: [u8; 44] = "12 der Inhalt beginnt bei y = -280          "
    report((&n80[0]) as u64, 44,
        viewport.viewport_content_y(&leerv) as i64 == 0 - 280,
        viewport.viewport_content_y(&leerv) as i64, 0 - 280)
    var n81: [u8; 44] = "12 kein Durchgang ist an einer Schranke aus "
    report((&n81[0]) as u64, 44, scene.scene_limit_break(&sc) == 0,
        scene.scene_limit_break(&sc) as i64, 0)

    // ============ 13. THE TREE IS FULL, AND NOW IT SAYS SO
    //
    // `scene_add` returns SCENE_NONE on a full tree (section 9)
    // -- that is honest, but nobody looks at a return value that
    // stands in a loop over two hundred list rows. Since
    // this round the tree COUNTS the rejected nodes, and
    // `scene_node_overflow` hands out the number. Here stand
    // SCENE_MAX + 3 calls: 128 nodes, 3 reports -- with the
    // counter-test at exactly SCENE_MAX, where the number stays zero.
    scene.scene_reset(&sc)
    var geb: usize = 0
    while geb < scene.SCENE_MAX {
        scene.scene_add(&sc, scene.SCENE_NONE, scene.N_BOX)
        geb = geb + 1
    }
    var n82: [u8; 44] = "13 SCENE_MAX Knoten laufen nicht ueber      "
    report((&n82[0]) as u64, 44, scene.scene_node_overflow(&sc) == 0,
        scene.scene_node_overflow(&sc) as i64, 0)
    var geb2: usize = 0
    while geb2 < 3 {
        scene.scene_add(&sc, scene.SCENE_NONE, scene.N_BOX)
        geb2 = geb2 + 1
    }
    var n83: [u8; 44] = "13 drei Knoten zu viel werden gemeldet      "
    report((&n83[0]) as u64, 44, scene.scene_node_overflow(&sc) == 3,
        scene.scene_node_overflow(&sc) as i64, 3)
    var n84: [u8; 44] = "13 und der Baum hat trotzdem 128 Knoten     "
    report((&n84[0]) as u64, 44, scene.scene_count(&sc) == scene.SCENE_MAX,
        scene.scene_count(&sc) as i64, scene.SCENE_MAX as i64)
    // AND THE REASON STANDS IN ONE NUMBER. Five counters are individually
    // right and together unwieldy; `scene_overflow_reason` hands out the
    // heaviest present reason, and exactly that is what
    // tools/fui/gallery9_main.fi and demos/fuidemo/main.fi print, instead of
    // delivering half an image.
    var n84b: [u8; 44] = "13 der Grund heisst OF_NODES (1)            "
    report((&n84b[0]) as u64, 44,
        scene.scene_overflow_reason(&sc) == scene.OF_NODES,
        scene.scene_overflow_reason(&sc) as i64,
        scene.OF_NODES as i64)
    // `scene_reset` sets the number back -- it belongs to the BUILD-UP
    // and not to the program run.
    scene.scene_reset(&sc)
    var n85: [u8; 44] = "13 scene_reset setzt die Zahl zurueck       "
    report((&n85[0]) as u64, 44, scene.scene_node_overflow(&sc) == 0,
        scene.scene_node_overflow(&sc) as i64, 0)
    var n85b: [u8; 44] = "13 und danach ist der Grund OF_NONE (0)     "
    report((&n85b[0]) as u64, 44,
        scene.scene_overflow_reason(&sc) == scene.OF_NONE,
        scene.scene_overflow_reason(&sc) as i64, scene.OF_NONE as i64)

    // ============ 14. THE CLAMPING COMES FROM flex.fi, NOT FROM HERE
    //
    // `node_set_bounds` passes minimum and maximum size on to
    // `flex.item_set_bounds`. Calculation is done in flex.fi
    // (css-flexbox-1, 9.7), and here it is RE-CALCULATED:
    //
    //     Row 200 wide, two children of 100 and 200 points, both
    //     shrinkable. WITHOUT an own bound neither gives way: the
    //     measured size IS the minimum size
    //     (flex.flex_item_from_pref) -- the row overflows, and that is
    //     right so, because shrinking must not cut off text.
    //
    //     WITH bounds (the first from 40, the second from 140) -100
    //     are to be distributed, weighted by the basis: 100/300 and 200/300,
    //     so -33 and -67. The second would thereby arrive at 133 and clamps
    //     at 140; the redistribution gives the freed-up
    //     rest TO THE FIRST, which thereby arrives at 200 - 140 = 60.
    //
    // Exactly this clamping is needed by the toolbar in
    // demos/fuidemo/main.fi for its search field.
    scene.scene_reset(&sc)
    let row2: usize = scene.scene_add(&sc, scene.SCENE_NONE,
        scene.N_BOX)
    scene.node_set_flex(&sc, row2, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    let kl_a: usize = scene.scene_add(&sc, row2, scene.N_BOX)
    let kl_b: usize = scene.scene_add(&sc, row2, scene.N_BOX)
    scene.node_set_size(&sc, kl_a, 100.0, 20.0)
    scene.node_set_size(&sc, kl_b, 200.0, 20.0)
    scene.node_set_grow(&sc, kl_a, 0, 1000)
    scene.node_set_grow(&sc, kl_b, 0, 1000)
    scene.scene_style(&sc, &empty)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 0.0, 0.0, 200.0, 20.0)
    var n86: [u8; 44] = "14 ohne Schranke bleibt das zweite bei 200  "
    report((&n86[0]) as u64, 44,
        scene.node_w(&sc, kl_b) as i64 == 200,
        scene.node_w(&sc, kl_b) as i64, 200)
    var n87: [u8; 44] = "14 und das erste bei 100                    "
    report((&n87[0]) as u64, 44,
        scene.node_w(&sc, kl_a) as i64 == 100,
        scene.node_w(&sc, kl_a) as i64, 100)
    scene.node_set_bounds(&sc, kl_a, 40, 0)
    scene.node_set_bounds(&sc, kl_b, 140, 0)
    scene.scene_layout(&sc, &c, 0.0, 0.0, 200.0, 20.0)
    var n88: [u8; 44] = "14 mit Schranke klemmt das zweite bei 140   "
    report((&n88[0]) as u64, 44,
        scene.node_w(&sc, kl_b) as i64 == 140,
        scene.node_w(&sc, kl_b) as i64, 140)
    var n89: [u8; 44] = "14 und das erste bekommt den Rest: 60       "
    report((&n89[0]) as u64, 44,
        scene.node_w(&sc, kl_a) as i64 == 60,
        scene.node_w(&sc, kl_a) as i64, 60)
    var n90: [u8; 44] = "14 zusammen sind das wieder 200             "
    report((&n90[0]) as u64, 44,
        (scene.node_w(&sc, kl_a) + scene.node_w(&sc, kl_b)) as i64 == 200,
        (scene.node_w(&sc, kl_a) + scene.node_w(&sc, kl_b)) as i64, 200)

    // ============ 15. THE TRANSFORMATION DOES NOT REPLACE THE KIND OF THE NODE
    //
    // Until 21.09.2026 in `draw_self` the transformation branch stood BEFORE
    // the kind distinction: every node with a matrix was painted as a
    // box with surface, border and font. A rotated
    // checkbox thereby lost its check mark -- invisible in the
    // source text and to be seen only in the image. So it is checked here in the IMAGE.
    //
    // (a) THE ROTATED BUTTON REALLY ROTATES. A button of 60 x 40
    // at (100,60) has its centre at (130,80). Rotated by 45 degrees
    // it reaches (30 + 20) * cos 45 = 35.4 points to the left and right
    // beyond the centre, so from x = 94.6 to x = 165.4. In the
    // strip x = 90..100 to the left BEFORE the button only a
    // rotation can therefore set points -- unrotated it is empty.
    var c_dreh: [u8; 4] = "dreh"
    let D: u32 = sheet.sheet_name((&c_dreh[0]) as u64, 4)
    var sheet5: sheet.Sheet = sheet.sheet_new()
    var d_dreh: sheet.Decl = sheet.decl_new()
    sheet.decl_set_rotate(&d_dreh, 45.0)
    sheet.sheet_add(&sheet5, sheet.sel_class(D), d_dreh)

    scene.scene_reset(&sc)
    let knopf2: usize = scene.scene_add(&sc, scene.SCENE_NONE,
        scene.N_WIDGET)
    scene.node_set_widget_kind(&sc, knopf2, widget.KIND_BUTTON)
    scene.node_set_size(&sc, knopf2, 60.0, 40.0)
    scene.scene_style(&sc, &empty)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 100.0, 60.0, 60.0, 40.0)
    canvas.canvas_clear(&cv, 0 as u32)
    scene.scene_draw(&sc, &c)
    let even_left: usize = count_set(&cv, 90, 60, 10, 40)
    var n91: [u8; 44] = "15a ungedreht bleibt der Streifen links leer"
    report((&n91[0]) as u64, 44, even_left == 0,
        even_left as i64, 0)
    scene.node_add_class(&sc, knopf2, D)
    scene.scene_style(&sc, &sheet5)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 100.0, 60.0, 60.0, 40.0)
    canvas.canvas_clear(&cv, 0 as u32)
    scene.scene_draw(&sc, &c)
    let rotated_left: usize = count_set(&cv, 90, 60, 10, 40)
    var n92: [u8; 44] = "15a gedreht steht der Knopf im Streifen     "
    report((&n92[0]) as u64, 44, rotated_left > 0,
        rotated_left as i64, 1)
    var n93: [u8; 44] = "15a der Knopf geht den gedrehten Weg (0)    "
    report((&n93[0]) as u64, 44, scene.scene_xform_skipped(&sc) == 0,
        scene.scene_xform_skipped(&sc) as i64, 0)

    // (b) THE ROTATED CHECKBOX KEEPS ITS CHECK MARK.
    // `wave3.kind_xf_ready` does not name KIND_CHECKBOX: sending box, check mark and
    // label individually through the matrix would be the second
    // drawing path. So it is painted STRAIGHT -- completely, with
    // check mark -- and the skipped transformation is counted.
    //
    // Measured without any colour of the theme: the same box
    // twice, once without and once with a check mark. The points that
    // differ ARE the check mark.
    scene.scene_reset(&sc)
    let hook: usize = scene.scene_add(&sc, scene.SCENE_NONE,
        scene.N_WIDGET)
    scene.node_set_widget_kind(&sc, hook, widget.KIND_CHECKBOX)
    scene.node_add_class(&sc, hook, D)
    scene.node_set_size(&sc, hook, 40.0, 40.0)
    scene.scene_style(&sc, &sheet5)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 100.0, 60.0, 40.0, 40.0)
    let he: *mut widget.Widget = scene.node_widget(&sc, hook)
    var image_without: [u32; 2048] = [0 as u32; 2048]
    widget.w_set_value(he, 0)
    canvas.canvas_clear(&cv, 0 as u32)
    scene.scene_draw(&sc, &c)
    schnappe(&cv, 100, 60, 40, 40, (&image_without[0]) as *mut u32)
    let box_present: usize = count_set(&cv, 100, 60, 40, 40)
    var n94: [u8; 44] = "15b das Kaestchen selbst ist gemalt         "
    report((&n94[0]) as u64, 44, box_present > 100,
        box_present as i64, 100)
    var n95: [u8; 44] = "15b die uebergangene Umformung wird gezaehlt"
    report((&n95[0]) as u64, 44, scene.scene_xform_skipped(&sc) == 1,
        scene.scene_xform_skipped(&sc) as i64, 1)
    widget.w_set_value(he, 1)
    canvas.canvas_clear(&cv, 0 as u32)
    scene.scene_draw(&sc, &c)
    let mark_new: usize = count_other(&cv, 100, 60, 40, 40,
        (&image_without[0]) as *mut u32)
    var n96: [u8; 44] = "15b der Haken steht im Bild (Punkte > 0)    "
    report((&n96[0]) as u64, 44, mark_new > 0,
        mark_new as i64, 1)
    // AND THE COUNTER-TEST THAT UNMASKS THE OLD WAY. The same node,
    // the same matrix -- but through `render.draw_widget_xf`, so through
    // the branch that until this round ran for EVERY kind. It paints
    // surface, border and font: with and without a check mark the SAME image
    // comes out, the difference is zero. Exactly this zero is the reason
    // why the branch must ask for the kind.
    var xf_hook: transform.Xform = transform.xf_new()
    sheet.decl_apply_transform_at(scene.node_decl(&sc, hook), &xf_hook,
        120.0, 80.0)
    widget.w_set_value(he, 0)
    canvas.canvas_clear(&cv, 0 as u32)
    render.draw_widget_xf(&c, he, &xf_hook)
    schnappe(&cv, 100, 60, 40, 40, (&image_without[0]) as *mut u32)
    widget.w_set_value(he, 1)
    canvas.canvas_clear(&cv, 0 as u32)
    render.draw_widget_xf(&c, he, &xf_hook)
    let mark_old: usize = count_other(&cv, 100, 60, 40, 40,
        (&image_without[0]) as *mut u32)
    var n97: [u8; 44] = "15b der alte Weg zeigt den Haken NICHT (0)  "
    report((&n97[0]) as u64, 44, mark_old == 0,
        mark_old as i64, 0)

    // (c) THE ROTATED IMAGE ROTATES TOO.
    //
    // Here until 22.09.2026 stood the justification that an image area
    // under a matrix would be a second sampling. That was a
    // missing wire and no reason: the sampling stands in
    // uiimage.sample_bilinear, the path to it in
    // transform.tf_draw_image, and render.draw_widget_art_xf attaches
    // both to the same decomposition that the straight way uses.
    //
    // THE NUMBERS. The node is 56 x 40 large and lies at (100,60),
    // its image area thus 24 x 24 at (116,68), centre (128,80).
    // Unrotated the image reaches from x = 116 to 140. Rotated by 45 degrees
    // its corner lies 12 * sqrt(2) = 16.97 points left of the
    // centre, so at x = 111. The strip x = 111..115 is therefore
    // EMPTY unrotated and painted rotated -- and that is the whole
    // proof.
    var bpx2: [u32; 64] = [4291322930 as u32; 64]
    var image2: uiimage.Image = uiimage.image_wrap((&bpx2[0]) as u64, 8,
        8, 0)
    scene.scene_reset(&sc)
    let bdreh: usize = scene.scene_add(&sc, scene.SCENE_NONE,
        scene.N_IMAGE)
    scene.node_set_image(&sc, bdreh, &image2, 24, 24)
    scene.node_set_art_align(&sc, bdreh, widget.ART_ONLY)
    scene.scene_style(&sc, &empty)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 100.0, 60.0, 56.0, 40.0)
    canvas.canvas_clear(&cv, 0 as u32)
    scene.scene_draw(&sc, &c)
    let image_even: usize = count_set(&cv, 111, 78, 4, 4)
    var n97b: [u8; 44] = "15c ungedreht ist der Streifen links leer   "
    report((&n97b[0]) as u64, 44, image_even == 0,
        image_even as i64, 0)
    scene.node_add_class(&sc, bdreh, D)
    scene.scene_style(&sc, &sheet5)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 100.0, 60.0, 56.0, 40.0)
    canvas.canvas_clear(&cv, 0 as u32)
    scene.scene_draw(&sc, &c)
    let image_rotated: usize = count_set(&cv, 111, 78, 4, 4)
    var n97c: [u8; 44] = "15c gedreht steht das Bild im Streifen      "
    report((&n97c[0]) as u64, 44, image_rotated > 0,
        image_rotated as i64, 1)
    var n97d: [u8; 44] = "15c das Bild geht den gedrehten Weg (0)     "
    report((&n97d[0]) as u64, 44, scene.scene_xform_skipped(&sc) == 0,
        scene.scene_xform_skipped(&sc) as i64, 0)
    // And it stays an IMAGE: the points in its centre carry the
    // colour of the image and not that of a surface.
    let mid: u32 = canvas.canvas_get(&cv, 128, 80)
    var n97e: [u8; 44] = "15c und es ist das Bild, nicht ein Kasten   "
    report((&n97e[0]) as u64, 44,
        canvas.color_a(mid) != 0 as u32, canvas.color_a(mid) as i64,
        255)

    // ============ 16. AN IMAGE AND A SYMBOL AS NODES
    //
    // `node_set_image`, `node_set_svg` and `node_set_art_align` stood
    // in the export block without a check calling them. Now
    // the numbers stand there, and they are calculated by hand: the theme gives
    // pad_x = 16, pad_y = 8, the gap between image and text sp_s = 8,
    // and the minimum height of a control is ctrl_h = 32.
    //
    //     Image node, image area 24 x 24, ART_ONLY (no text):
    //         width  = 24 + 2 * 16 = 56
    //         height = 24 + 2 *  8 = 40   (more than ctrl_h = 32)
    //
    // The image itself is 8 x 8 points in red 200 / green 100 /
    // blue 50 -- three different channels, so that a swap
    // is noticed (the same rule as in tools/fui/image_main.fi). The
    // order in memory is R, G, B, A (lib/fui/uiimage.fi), so a
    // 32-bit number on this machine is 0xAABBGGRR: 4281492680 is
    // exactly red 200, green 100, blue 50, fully opaque.
    var bpx: [u32; 64] = [4281492680 as u32; 64]
    var image: uiimage.Image = uiimage.image_wrap((&bpx[0]) as u64, 8, 8, 0)
    scene.scene_reset(&sc)
    let bknoten: usize = scene.scene_add(&sc, scene.SCENE_NONE,
        scene.N_IMAGE)
    scene.node_set_image(&sc, bknoten, &image, 24, 24)
    scene.node_set_art_align(&sc, bknoten, widget.ART_ONLY)
    scene.scene_style(&sc, &empty)
    scene.scene_measure(&sc, &c)
    var n98: [u8; 44] = "16 der Bildknoten misst 56 breit            "
    report((&n98[0]) as u64, 44, scene.node_pref_w(&sc, bknoten) as i64 == 56,
        scene.node_pref_w(&sc, bknoten) as i64, 56)
    var n99: [u8; 44] = "16 und 40 hoch                              "
    report((&n99[0]) as u64, 44, scene.node_pref_h(&sc, bknoten) as i64 == 40,
        scene.node_pref_h(&sc, bknoten) as i64, 40)
    // The position of the image area: at ART_ONLY it stands CENTRED in the
    // content box. Arranged at (100,60) with 56 x 40 the
    // content box is (116, 68, 24, 24) -- the image fills it exactly, so
    // its upper left corner lies at (116, 68).
    scene.scene_layout(&sc, &c, 100.0, 60.0, 56.0, 40.0)
    var ax: f64 = 0.0
    var ay: f64 = 0.0
    var aw: f64 = 0.0
    var ah: f64 = 0.0
    var ttx: f64 = 0.0
    var ttw: f64 = 0.0
    render.art_text_split(&c, scene.node_widget(&sc, bknoten), 116.0,
        68.0, 24.0, 24.0, &ax, &ay, &aw, &ah, &ttx, &ttw)
    var n100: [u8; 44] = "16 die Bildflaeche beginnt bei x=116        "
    report((&n100[0]) as u64, 44, ax as i64 == 116,
        ax as i64, 116)
    var n101: [u8; 44] = "16 und bei y=68                             "
    report((&n101[0]) as u64, 44, ay as i64 == 68,
        ay as i64, 68)
    var n102: [u8; 44] = "16 sie ist 24 x 24 gross                    "
    report((&n102[0]) as u64, 44, aw as i64 == 24 && ah as i64 == 24,
        aw as i64, 24)
    // AND THE IMAGE REALLY STANDS IN THE IMAGE. Counted is the area
    // that was set, and the red channel in its centre: 8 x 8
    // points stretched to 24 x 24 are 576 points, and their centre is
    // red 200.
    canvas.canvas_clear(&cv, 0 as u32)
    scene.scene_draw(&sc, &c)
    let image_points: usize = count_set(&cv, 116, 68, 24, 24)
    var n103: [u8; 44] = "16 das Bild deckt seine Flaeche (>500)      "
    report((&n103[0]) as u64, 44, image_points > 500,
        image_points as i64, 500)
    var n104: [u8; 44] = "16 und sein roter Kanal ist 200             "
    report((&n104[0]) as u64, 44, canvas.color_r(canvas.canvas_get(&cv, 128, 80)) == 200 as u32,
        canvas.color_r(canvas.canvas_get(&cv, 128, 80)) as i64, 200)

    // ---- THE SYMBOL. The same once more with a rasterised SVG
    // and a text beside it. Here the POSITION counts: at ART_LEFT the
    // symbol stands at the left edge of the content box, at ART_RIGHT at the
    // right. The node is fixed at 200 x 40, its
    // content box thus (116, 68, 168, 24):
    //
    //     ART_LEFT   x = 116
    //     ART_RIGHT  x = 116 + 168 - 16 = 268
    //     y (always centred) = 68 + (24 - 16) / 2 = 72
    var svgq: [u8; 88] = "<svg viewBox='0 0 10 10'><rect x='0' y='0' width='10' height='10' fill='#3264c8'/></svg>"
    var sym: uisvg.Icon = uisvg.icon_new()
    let hat_sym: bool = uisvg.icon_render(&sym, (&svgq[0]) as u64, 88,
        16, 16, 0 as u32, fm)
    var n105: [u8; 44] = "16 das Symbol wird gerastert                "
    report((&n105[0]) as u64, 44, hat_sym,
        hat_sym as i64, 1)
    var t_sym: [u8; 4] = "Save"
    scene.scene_reset(&sc)
    let sknoten: usize = scene.scene_add(&sc, scene.SCENE_NONE,
        scene.N_SVG)
    scene.node_set_svg(&sc, sknoten, &sym, 16, 16)
    scene.node_set_text(&sc, sknoten, (&t_sym[0]) as u64, 4)
    scene.node_set_art_align(&sc, sknoten, widget.ART_LEFT)
    scene.node_set_size(&sc, sknoten, 200.0, 40.0)
    scene.scene_style(&sc, &empty)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 100.0, 60.0, 200.0, 40.0)
    render.art_text_split(&c, scene.node_widget(&sc, sknoten), 116.0,
        68.0, 168.0, 24.0, &ax, &ay, &aw, &ah, &ttx, &ttw)
    var n106: [u8; 44] = "16 das Symbol steht links bei x=116         "
    report((&n106[0]) as u64, 44, ax as i64 == 116,
        ax as i64, 116)
    var n107: [u8; 44] = "16 mittig bei y=72                          "
    report((&n107[0]) as u64, 44, ay as i64 == 72,
        ay as i64, 72)
    var n108: [u8; 44] = "16 und der Text beginnt dahinter: 140       "
    report((&n108[0]) as u64, 44, ttx as i64 == 140,
        ttx as i64, 140)
    scene.node_set_art_align(&sc, sknoten, widget.ART_RIGHT)
    render.art_text_split(&c, scene.node_widget(&sc, sknoten), 116.0,
        68.0, 168.0, 24.0, &ax, &ay, &aw, &ah, &ttx, &ttw)
    var n109: [u8; 44] = "16 rechts ausgerichtet steht es bei x=268   "
    report((&n109[0]) as u64, 44, ax as i64 == 268,
        ax as i64, 268)
    // And the symbol is painted too: 16 x 16 points at its place,
    // with blue 200 in the centre.
    canvas.canvas_clear(&cv, 0 as u32)
    scene.scene_draw(&sc, &c)
    let sym_points: usize = count_set(&cv, 268, 72, 16, 16)
    var n110: [u8; 44] = "16 das Symbol deckt seine Flaeche (>200)    "
    report((&n110[0]) as u64, 44, sym_points > 200,
        sym_points as i64, 200)
    var n111: [u8; 44] = "16 und sein blauer Kanal ist 200            "
    report((&n111[0]) as u64, 44, canvas.color_b(canvas.canvas_get(&cv, 276, 80)) == 200 as u32,
        canvas.color_b(canvas.canvas_get(&cv, 276, 80)) as i64, 200)
    uisvg.icon_free(&sym)

    // ============================== 17. THE SHORT FORMS OF THE TREE
    //
    // scene_box, scene_widget, node_set_space, node_set_flexitem and
    // scene_run write down the same as the individual calls -- that
    // is no claim, but here a measurement: TWO trees,
    // on the left long form, on the right short form, same numbers in, and
    // afterwards the arranged rectangles must agree
    // point for point. If one of the short forms went a different way,
    // two different numbers would stand here.
    var kt: [u8; 3] = "Run"
    var kf_leaf: sheet.Sheet = sheet.sheet_new()
    var lang: scene.Scene = scene.scene_new()
    let l_root: usize = scene.scene_add(&lang, scene.SCENE_NONE,
        scene.N_BOX)
    scene.node_add_class(&lang, l_root, 7 as u32)
    scene.node_set_flex(&lang, l_root, flex.FLEX_ROW,
        flex.JUSTIFY_START, flex.AL_CENTER)
    scene.node_set_padding(&lang, l_root, 10, 10, 10, 10)
    scene.node_set_gap(&lang, l_root, 8, 0)
    let l_kind: usize = scene.scene_add(&lang, l_root, scene.N_WIDGET)
    scene.node_set_widget_kind(&lang, l_kind, widget.KIND_BUTTON)
    scene.node_set_text(&lang, l_kind, (&kt[0]) as u64, 3)
    scene.node_set_grow(&lang, l_kind, 1000, 1000)
    scene.node_set_bounds(&lang, l_kind, 140, 0)
    scene.scene_style(&lang, &kf_leaf)
    scene.scene_measure(&lang, &c)
    scene.scene_layout(&lang, &c, 0.0, 0.0, 400.0, 60.0)
    scene.scene_draw(&lang, &c)

    var short: scene.Scene = scene.scene_new()
    let k_root: usize = scene.scene_box(&short, scene.SCENE_NONE,
        7 as u32, flex.FLEX_ROW, flex.JUSTIFY_START, flex.AL_CENTER)
    scene.node_set_space(&short, k_root, 10, 10, 10, 10, 8, 0)
    let k_kind: usize = scene.scene_widget(&short, k_root,
        widget.KIND_BUTTON, (&kt[0]) as u64, 3)
    scene.node_set_flexitem(&short, k_kind, 1000, 1000, 140, 0)
    scene.scene_run(&short, &c, &kf_leaf, 0.0, 0.0, 400.0, 60.0)

    var n120: [u8; 44] = "17 die Kurzform setzt dieselbe Klasse       "
    report((&n120[0]) as u64, 43,
        scene.node_has_class(&short, k_root, 7 as u32),
        scene.node_class_count(&short, k_root) as i64, 1)
    var n121: [u8; 44] = "17 und dieselbe Art (N_WIDGET = 5)          "
    report((&n121[0]) as u64, 43,
        scene.node_kind(&short, k_kind) == scene.N_WIDGET,
        scene.node_kind(&short, k_kind) as i64,
        scene.N_WIDGET as i64)
    var n122: [u8; 44] = "17 das Kind steht bei x = 10                "
    report((&n122[0]) as u64, 43,
        scene.node_x(&short, k_kind) as i64
        == scene.node_x(&lang, l_kind) as i64,
        scene.node_x(&short, k_kind) as i64,
        scene.node_x(&lang, l_kind) as i64)
    var n123: [u8; 44] = "17 gleiche Breite wie in der Langform       "
    report((&n123[0]) as u64, 43,
        scene.node_w(&short, k_kind) as i64
        == scene.node_w(&lang, l_kind) as i64,
        scene.node_w(&short, k_kind) as i64,
        scene.node_w(&lang, l_kind) as i64)
    var n124: [u8; 44] = "17 gleiche Hoehe und gleiches y             "
    report((&n124[0]) as u64, 43,
        scene.node_y(&short, k_kind) as i64
        == scene.node_y(&lang, l_kind) as i64
        && scene.node_h(&short, k_kind) as i64
        == scene.node_h(&lang, l_kind) as i64,
        scene.node_h(&short, k_kind) as i64,
        scene.node_h(&lang, l_kind) as i64)
    // scene_run runs ALL four passes: afterwards the tree stands
    // at PHASE_DRAW, and no size has wandered while painting.
    var n125: [u8; 44] = "17 scene_run endet in PHASE_DRAW (4)        "
    report((&n125[0]) as u64, 43,
        scene.scene_phase(&short) == scene.PHASE_DRAW,
        scene.scene_phase(&short) as i64, scene.PHASE_DRAW as i64)
    var n126: [u8; 44] = "17 und nichts driftet dabei                 "
    report((&n126[0]) as u64, 43, scene.scene_size_drift(&short) == 0,
        scene.scene_size_drift(&short) as i64, 0)
    // And the zero as "no class": scene_box with 0 attaches none.
    let without: usize = scene.scene_box(&short, k_root, 0 as u32,
        flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_STRETCH)
    var n127: [u8; 44] = "17 Klasse 0 heisst: gar keine Klasse        "
    report((&n127[0]) as u64, 43,
        scene.node_class_count(&short, without) == 0,
        scene.node_class_count(&short, without) as i64, 0)

    // ====================== 18. THE SIZE COMES FROM THE STYLE SHEET
    //
    // A rule sets the height of a CLASS of rows; in the tree
    // not a single number stands for it. Measured is that the node
    // is afterwards really arranged this high -- and that
    // node_set_size as an EXCEPTION is stronger than the rule.
    var gt: [u8; 5] = "Zeile"
    var gblatt: sheet.Sheet = sheet.sheet_new()
    var gst: style.Style = style.style_new()
    gst = style.style_set_size(gst, 120, 30)
    sheet.sheet_rule(&gblatt, sheet.sel_class(9 as u32), gst)
    var gsc: scene.Scene = scene.scene_new()
    let g_root: usize = scene.scene_box(&gsc, scene.SCENE_NONE, 0 as u32,
        flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_START)
    let g_a: usize = scene.scene_add(&gsc, g_root, scene.N_TEXT)
    scene.node_add_class(&gsc, g_a, 9 as u32)
    scene.node_set_text(&gsc, g_a, (&gt[0]) as u64, 5)
    let g_b: usize = scene.scene_add(&gsc, g_root, scene.N_TEXT)
    scene.node_add_class(&gsc, g_b, 9 as u32)
    scene.node_set_text(&gsc, g_b, (&gt[0]) as u64, 5)
    scene.node_set_size(&gsc, g_b, 0.0, 50.0)
    scene.scene_run(&gsc, &c, &gblatt, 0.0, 0.0, 400.0, 200.0)
    var n130: [u8; 44] = "18 die Regel gibt der Zeile die Hoehe 30    "
    report((&n130[0]) as u64, 43, scene.node_h(&gsc, g_a) as i64 == 30,
        scene.node_h(&gsc, g_a) as i64, 30)
    var n131: [u8; 44] = "18 und die Breite 120                       "
    report((&n131[0]) as u64, 43, scene.node_w(&gsc, g_a) as i64 == 120,
        scene.node_w(&gsc, g_a) as i64, 120)
    var n132: [u8; 44] = "18 die zweite steht darunter bei y = 30     "
    report((&n132[0]) as u64, 43, scene.node_y(&gsc, g_b) as i64 == 30,
        scene.node_y(&gsc, g_b) as i64, 30)
    var n133: [u8; 44] = "18 node_set_size schlaegt die Regel (50)    "
    report((&n133[0]) as u64, 43, scene.node_h(&gsc, g_b) as i64 == 50,
        scene.node_h(&gsc, g_b) as i64, 50)
    // The counter-test: WITHOUT a rule the same node measures its text,
    // and that is a different number than 30.
    var lblatt: sheet.Sheet = sheet.sheet_new()
    var lsc: scene.Scene = scene.scene_new()
    let l_w: usize = scene.scene_box(&lsc, scene.SCENE_NONE, 0 as u32,
        flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_START)
    let l_a: usize = scene.scene_add(&lsc, l_w, scene.N_TEXT)
    scene.node_set_text(&lsc, l_a, (&gt[0]) as u64, 5)
    scene.scene_run(&lsc, &c, &lblatt, 0.0, 0.0, 400.0, 200.0)
    var n134: [u8; 44] = "18 ohne Regel misst er seinen Text: nicht 30"
    report((&n134[0]) as u64, 43, scene.node_h(&lsc, l_a) as i64 != 30,
        scene.node_h(&lsc, l_a) as i64, 30)

    canvas.canvas_free(&cv)
    painter.painter_free(&z)
    rt.buf_free(&fbuf)

    var t: rt.Buf = rt.buf_new()
    rt.buf_push(&t, 10 as u8)
    if G_ERRORS > 0 {
        var f: [u8; 23] = "SCENE IS NOT IN ORDER.\n"
        rt.buf_push_bytes(&t, (&f[0]) as u64, 23)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
        return 1
    }
    var o: [u8; 14] = "SCENE PASSED.\n"
    rt.buf_push_bytes(&t, (&o[0]) as u64, 14)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 0
}
