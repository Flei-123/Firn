// SPDX-License-Identifier: MPL-2.0
// tools/fui/webtheme_main.fi -- lib/fui/webtheme.fi: the web app's tokens (checked against the literal CSS values), the type scale,
// dark / light / system, accent, contrast, shadows, text nodes with the text scale, and the picture `appmobile_tokens`.
//
//     webtheme            checks only
//     webtheme <dir>      also writes appmobile_tokens-light.png / -dark.png into <dir>
//
// The expected values below are COPIED from public/style.css on purpose (a second witness next to gen_webtheme.py --check).
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.sheet
import fui.style
import fui.syspref
import fui.flex
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.webtheme
import fui.webtheme_gen
import fui.safeout

static mut BAD: usize = 0
static mut TOTAL: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    TOTAL = TOTAL + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn num(tag: str, v: i64) {
    say(tag)
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
}

// two colours within `tol` per channel
fn near_rgb(a: u32, b: u32, tol: i64) -> bool {
    var s: u32 = 0
    while s <= 16 {
        let x: i64 = ((a >> s) & 255 as u32) as i64
        let y: i64 = ((b >> s) & 255 as u32) as i64
        var d: i64 = x - y
        if d < 0 { d = 0 - d }
        if d > tol { return false }
        s = s + 8
    }
    return true
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

// ============================================================ the tokens against the CSS
fn token_checks() {
    say("-- tokens == public/style.css\n")
    check(webtheme_gen.FLEITEC_BG == 0x0c0e1f && webtheme_gen.FLEITEC_BG_SIDEBAR == 0x0a0b18 && webtheme_gen.FLEITEC_PANEL == 0x15172b, ":root bg / bg-sidebar / panel")
    check(webtheme_gen.FLEITEC_TXT == 0xe9ebf5 && webtheme_gen.FLEITEC_DIM == 0x9aa0bb, ":root txt / dim")
    check(webtheme_gen.FLEITEC_ACCENT == 0x2f86ff && webtheme_gen.FLEITEC_ACCENT2 == 0x36c5ff, ":root accent / accent2")
    check(webtheme_gen.FLEITEC_WARN == 0xff5d5d && webtheme_gen.FLEITEC_OK == 0x2ee6a6 && webtheme_gen.FLEITEC_CODE_BG == 0x0b0d1c, ":root warn / ok / code-bg")
    check(webtheme_gen.FLEITEC_USER_GRAD_G0 == 0x1b2447 && webtheme_gen.FLEITEC_USER_GRAD_G1 == 0x2a4488 && webtheme_gen.FLEITEC_USER_GRAD_GDEG == 135, "user-grad 135deg #1b2447 -> #2a4488")
    check(webtheme_gen.FLEITEC_ACCENT_GRAD_G0 == 0x2f80ff && webtheme_gen.FLEITEC_ACCENT_GRAD_G1 == 0x36c5ff, "accent-grad #2f80ff -> #36c5ff")
    check(webtheme_gen.FLEITEC_LINE == 0xffffff && webtheme_gen.FLEITEC_LINE_A == 20, "line = rgba(255,255,255,.08)")
    check(webtheme_gen.FLEITEC_BG_HOVER_A == 15 && webtheme_gen.FLEITEC_FIELD_BG_A == 13 && webtheme_gen.FLEITEC_FIELD_LINE_A == 36, "hover .06, field-bg .05, field-line .14")
    check(webtheme_gen.FLEITEC_RING == 0x3696ff && webtheme_gen.FLEITEC_RING_A == 128, "ring = rgba(54,150,255,.5)")
    check(webtheme_gen.CLAUDE_BG == 0x262624 && webtheme_gen.CLAUDE_PANEL == 0x30302e && webtheme_gen.CLAUDE_ACCENT == 0xc96442 && webtheme_gen.CLAUDE_ACCENT2 == 0xd97757, "theme claude: bg / panel / accent / accent2")
    check(webtheme_gen.CLAUDE_WARN == webtheme_gen.FLEITEC_WARN && webtheme_gen.CLAUDE_OK == webtheme_gen.FLEITEC_OK, "theme claude inherits warn / ok from :root")
    check(webtheme_gen.CLAUDE_USER_GRAD_G0 == 0x393937 && webtheme_gen.CLAUDE_USER_GRAD_G1 == 0x45423e, "theme claude: user-grad")
    check(webtheme_gen.CSS_RADIUS_SM == 8 && webtheme_gen.CSS_RADIUS == 12 && webtheme_gen.CSS_RADIUS_CARD == 16 && webtheme_gen.CSS_RADIUS_PILL == 999, "radii 8 / 12 / 16 / 999")
    check(webtheme_gen.FLEITEC_SHADOW_SM_Y == 1 && webtheme_gen.FLEITEC_SHADOW_SM_BLUR == 2 && webtheme_gen.FLEITEC_SHADOW_SM_A == 89, "shadow-sm 0 1px 2px .35")
    check(webtheme_gen.FLEITEC_SHADOW_Y == 8 && webtheme_gen.FLEITEC_SHADOW_BLUR == 24 && webtheme_gen.FLEITEC_SHADOW_A == 102, "shadow 0 8px 24px .40")
    check(webtheme_gen.FLEITEC_SHADOW_LG_Y == 18 && webtheme_gen.FLEITEC_SHADOW_LG_BLUR == 48 && webtheme_gen.FLEITEC_SHADOW_LG_A == 140, "shadow-lg 0 18px 48px .55")
    check(webtheme_gen.CSS_BODY_PX == 14 && webtheme_gen.CSS_PILL_PX == 12 && webtheme_gen.CSS_HEADER_H == 56, "phone body 14, pill 12, header 56")
    check(webtheme_gen.CSS_BRAND_WEIGHT == 800 && webtheme_gen.CSS_BRAND_TRACKING == 2 && webtheme_gen.CSS_BRAND_PX_X100 == 1632, "brand 800, +2 px, 1.02rem")
    check(webtheme_gen.CSS_BUBBLE_R == 18 && webtheme_gen.CSS_BUBBLE_R_TAIL == 6 && webtheme_gen.CSS_SEND_BTN == 38 && webtheme_gen.CSS_ICON_BTN == 36, "bubble 18 / tail 6, send 38, phone icon button 36")
    check(webtheme.S4 == 4 && webtheme.S6 == 6 && webtheme.S8 == 8 && webtheme.S10 == 10 && webtheme.S12 == 12 && webtheme.S16 == 16 && webtheme.S24 == 24, "spacing scale 4 / 6 / 8 / 10 / 12 / 16 / 24")
}

fn palette_checks() {
    say("-- palettes\n")
    let d: webtheme.Pal = webtheme.palette(webtheme.FLAVOR_FLEITEC, true)
    let l: webtheme.Pal = webtheme.palette(webtheme.FLAVOR_FLEITEC, false)
    let cd: webtheme.Pal = webtheme.palette(webtheme.FLAVOR_CLAUDE, true)
    let cl: webtheme.Pal = webtheme.palette(webtheme.FLAVOR_CLAUDE, false)
    check(d.bg == 0x0c0e1f && d.panel == 0x15172b && d.txt == 0xe9ebf5 && d.accent == 0x2f86ff, "dark fleitec palette is the CSS")
    check(d.line == 0x1f2131, "line flattened over bg: 0x1f2131")
    check(near_rgb(d.field_line, 0x2e303e, 1) && near_rgb(d.field_bg, 0x212336, 1) && near_rgb(d.hover, 0x232538, 1), "field-line / field-bg / hover flattened (+-1 of the browser blend)")
    check(webtheme.over(0xffffff, 0, 0x123456) == 0x123456 && webtheme.over(0xffffff, 255, 0x123456) == 0xffffff, "over(): alpha 0 and 255")
    check(cd.bg == 0x262624 && cd.accent == 0xc96442 && near_rgb(cd.warn, 0xff5d5d, 24) && d.warn == 0xff5d5d, "dark claude palette is the CSS (warn: lifted <= 24 to reach 4.5 on the raised panel)")
    check(theme.luminance(l.bg) > 0.8 && theme.luminance(d.bg) < 0.02, "light page is light, dark page is dark")
    check((l.bg & 255 as u32) > (l.bg >> 16), "light fleitec stays blue-ish (same hue family)")
    check((cl.bg >> 16) >= (cl.bg & 255 as u32), "light claude stays warm (red >= blue)")
    check(theme.luminance(l.txt) < 0.05 && theme.luminance(d.txt) > 0.7, "text flips with the look")
    check(l.accent != d.accent && theme.contrast(l.accent, l.bg) >= 4.5, "light accent is darkened and reads on the page")
    check(theme.contrast(l.on_accent, l.accent) >= 4.5, "light: white on the accent button reaches 4.5")
    check(theme.contrast(d.on_accent, d.accent) >= 3.0 && d.on_accent == 0xffffff, "dark: the web's white on accent (>= 3:1, large bold)")
    check(webtheme.contrast_failures(webtheme.FLAVOR_FLEITEC, true) == 0, "contrast: fleitec dark, every text pair >= 4.5")
    check(webtheme.contrast_failures(webtheme.FLAVOR_FLEITEC, false) == 0, "contrast: fleitec light")
    check(webtheme.contrast_failures(webtheme.FLAVOR_CLAUDE, true) == 0, "contrast: claude dark")
    check(webtheme.contrast_failures(webtheme.FLAVOR_CLAUDE, false) == 0, "contrast: claude light")
    var pd: webtheme.Pal = d
    var pl: webtheme.Pal = l
    num("  min contrast fleitec dark  x100: ", webtheme.pal_contrast_min(&pd))
    num("  min contrast fleitec light x100: ", webtheme.pal_contrast_min(&pl))
    check(l.shadow_scale < d.shadow_scale && d.shadow_scale == 100, "the light look shows the shadows weaker")
    let fit: u32 = webtheme.fit_text(0x9aa0bb, 0xffffff, 0xf4f6fc, false)
    check(theme.contrast(fit, 0xffffff) >= 4.5 && theme.contrast(fit, 0xf4f6fc) >= 4.5, "fit_text darkens until both pairs reach 4.5")
    check(webtheme.fit_text(0x000000, 0xffffff, 0xffffff, false) == 0x000000, "fit_text keeps a colour that already fits")
}

fn type_checks() {
    say("-- type scale\n")
    check(webtheme.ty_px(webtheme.TY_BODY) == 14 && webtheme.ty_px(webtheme.TY_BODY_STRONG) == 14, "body 14")
    check(webtheme.ty_px(webtheme.TY_CAPTION) == 12 && webtheme.ty_px(webtheme.TY_TITLE) == 20 && webtheme.ty_px(webtheme.TY_SECTION) == 16, "caption 12, title 20, section 16")
    check(webtheme.ty_px(webtheme.TY_BRAND) == 16 && webtheme.ty_weight(webtheme.TY_BRAND) == 800 && webtheme.ty_tracking(webtheme.TY_BRAND) == 2, "brand 16 / 800 / +2")
    check(webtheme.ty_px(webtheme.TY_TITLE) > webtheme.ty_px(webtheme.TY_SECTION) && webtheme.ty_px(webtheme.TY_SECTION) > webtheme.ty_px(webtheme.TY_BODY) && webtheme.ty_px(webtheme.TY_BODY) > webtheme.ty_px(webtheme.TY_CAPTION), "the steps are ordered title > section > body > caption")
    check(webtheme.ty_weight(webtheme.TY_BODY) == 400 && webtheme.ty_weight(webtheme.TY_BODY_STRONG) == 600 && webtheme.ty_weight(webtheme.TY_TITLE) == 700, "web weights 400 / 600 / 700")
    check(webtheme.ty_weight_render(webtheme.TY_BODY_STRONG) == 700 && webtheme.ty_weight_render(webtheme.TY_BODY) == 400 && webtheme.ty_weight_render(webtheme.TY_BRAND) == 800, "render weight: 600 snaps to 700, the rest as is")
    check(webtheme.ty_line_px(webtheme.TY_BODY) == 21 && webtheme.ty_line_px(webtheme.TY_TITLE) == 25 && webtheme.ty_line_px(webtheme.TY_CAPTION) == 17, "line boxes 21 / 25 / 17")
    check(webtheme.ty_token(webtheme.TY_BRAND) == style.TOK_ACCENT && webtheme.ty_token(webtheme.TY_CAPTION) == style.TOK_TEXT_MUTED && webtheme.ty_token(webtheme.TY_BODY) == style.TOK_TEXT, "colour roles: brand accent, caption muted, body text")
    check(webtheme.ty_font(webtheme.TY_MONO) == 1 && webtheme.ty_font(webtheme.TY_BODY) == 0, "mono uses font slot 1")
    let st: style.Style = webtheme.style_for(webtheme.TY_BRAND)
    check(st.font_px == 16 && st.weight == 800 && st.tracking == 2 && st.line_height == 1200, "style_for(brand): size, weight, tracking, line height")
    let sb: style.Style = webtheme.style_for(webtheme.TY_BODY_STRONG)
    check(sb.weight == 700 && sb.font_px == 14, "style_for(body strong): 14 px, weight handed to the painter 700")
}

fn shadow_checks() {
    say("-- shadows / elevation\n")
    check(webtheme.shadow_blur(webtheme.SH_SM) < webtheme.shadow_blur(webtheme.SH_MD) && webtheme.shadow_blur(webtheme.SH_MD) < webtheme.shadow_blur(webtheme.SH_LG), "sm < md < lg by blur")
    check(webtheme.elev_level(webtheme.SH_SM) == 1 && webtheme.elev_level(webtheme.SH_MD) == 3 && webtheme.elev_level(webtheme.SH_LG) == 4, "elevation levels 1 / 3 / 4")
    check(webtheme.shadow_alpha(webtheme.SH_MD, true) == 102 && webtheme.shadow_alpha(webtheme.SH_MD, false) < 102, "alpha: CSS value in dark, weaker in light")
    let s2: style.Style = webtheme.set_shadow(style.style_new(), webtheme.SH_LG, true)
    check(s2.bs_lift == 18 && s2.bs_blur == 48 && s2.bs_a == 140, "set_shadow(lg) = 0 18 48 .55")
    var p: webtheme.Pal = webtheme.palette(webtheme.FLAVOR_FLEITEC, true)
    let b: style.Style = webtheme.bubble_style(&p)
    check(b.bg == 0x1b2447 && b.bg2 == 0x2a4488 && b.g_dx == 1000 && b.g_dy == 1000, "bubble: gradient 135deg (to the lower right)")
    check(b.radius == 18, "bubble radius 18")
}

// ============================================================ the running theme
static mut PIC: u64 = 0

fn node_label(a: *mut app.App, s: str, ty: usize) -> usize {
    return webtheme.text(a, s, ty)
}

fn swatch_rule(a: *mut app.App, k: u32, tk: u32) {
    var st: style.Style = style.style_new()
    st = style.style_set_bg(st, style.color_token(tk))
    st = style.style_set_border(st, style.color_token(style.TOK_SEPARATOR), 1)
    st = style.style_set_radius(st, 8)
    let r: usize = sheet.sheet_rule(&(*a).sh, sheet.sel_class(k), st)
}

fn swatch(a: *mut app.App, k: u32, name: str) {
    let c: usize = app.column(a)
    let b: usize = app.spacer(a, 36, 28)
    scene.node_add_class(app.app_scene(a), b, k)
    let t: usize = node_label(a, name, webtheme.TY_CAPTION)
    app.end(a)
}

fn radius_box(a: *mut app.App, k: u32, w: usize, name: str) {
    let c: usize = app.column(a)
    let b: usize = app.spacer(a, w, 32)
    scene.node_add_class(app.app_scene(a), b, k)
    let t: usize = node_label(a, name, webtheme.TY_CAPTION)
    app.end(a)
}

fn shadow_box(a: *mut app.App, k: u32, name: str) {
    let c: usize = app.column(a)
    let b: usize = app.spacer(a, 88, 52)
    scene.node_add_class(app.app_scene(a), b, webtheme.K_CARD)
    scene.node_add_class(app.app_scene(a), b, k)
    let t: usize = node_label(a, name, webtheme.TY_CAPTION)
    app.end(a)
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    token_checks()
    palette_checks()
    type_checks()
    shadow_checks()

    say("-- the running theme\n")
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("webtheme: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Mobile tokens", 360, 760)
    let rules0: usize = sheet.sheet_count(&(*a).sh)
    webtheme.install(a, webtheme.MODE_DARK)
    check(webtheme.rules_installed() && sheet.sheet_count(&(*a).sh) == rules0 + webtheme.RULE_COUNT, "install adds exactly RULE_COUNT rules")
    check(sheet.sheet_rule_overflow(&(*a).sh) == 0, "no rule rejected")
    let m: *mut theme.Theme = app.app_theme(a)
    let f: *mut theme.Colors = theme.theme_colors(m)
    check((*f).base == 0x0c0e1f && (*f).surface == 0x15172b && (*f).text == 0xe9ebf5 && (*f).accent == 0x2f86ff && theme.theme_is_dark(m), "install(dark): theme colours are the web's")
    check((*f).err_col == 0xff5d5d && (*f).success == 0x2ee6a6 && (*f).text_muted == 0x9aa0bb, "error / success / muted")
    let sh: *mut theme.Shape = theme.theme_shape(m)
    check((*sh).r_panel == 16 && (*sh).r_button == 12 && (*sh).r_field == 12 && (*sh).font == 14, "shape: radii 16 / 12 / 12, font 14")

    // --- the page of the picture
    let hd: usize = app.row(a)
    scene.node_add_class(app.app_scene(a), hd, webtheme.K_HEADER)
    let t0: usize = node_label(a, "JARVIS", webtheme.TY_BRAND)
    let t0b: usize = node_label(a, "online", webtheme.TY_CAPTION)
    scene.node_add_class(app.app_scene(a), t0b, webtheme.K_PILL)
    scene.node_set_align_self(app.app_scene(a), t0b, flex.AL_CENTER)
    app.end(a)
    let t1: usize = node_label(a, "Title 20 / 700", webtheme.TY_TITLE)
    let t2: usize = node_label(a, "Section 16 / 600", webtheme.TY_SECTION)
    let t3: usize = node_label(a, "Body 14 / 400. A long line wraps at the width of its container, like the web.", webtheme.TY_BODY)
    let t4: usize = node_label(a, "Body strong 14 / 600", webtheme.TY_BODY_STRONG)
    let t5: usize = node_label(a, "Caption 12 / 400 muted", webtheme.TY_CAPTION)
    let t6: usize = node_label(a, "mono 13 let x = 1", webtheme.TY_MONO)
    swatch_rule(a, 0x9001, style.TOK_BASE)
    swatch_rule(a, 0x9002, style.TOK_SURFACE)
    swatch_rule(a, 0x9003, style.TOK_SURFACE_RAISED)
    swatch_rule(a, 0x9004, style.TOK_FIELD)
    swatch_rule(a, 0x9005, style.TOK_BUTTON_HOVER)
    swatch_rule(a, 0x9006, style.TOK_SEPARATOR)
    swatch_rule(a, 0x9007, style.TOK_TEXT)
    swatch_rule(a, 0x9008, style.TOK_TEXT_MUTED)
    swatch_rule(a, 0x9009, style.TOK_ACCENT)
    swatch_rule(a, 0x900a, style.TOK_ERROR)
    swatch_rule(a, 0x900b, style.TOK_SUCCESS)
    swatch_rule(a, 0x900c, style.TOK_SELECTION)
    let r1: usize = app.row(a)
    swatch(a, 0x9001, "bg")
    swatch(a, 0x9002, "panel")
    swatch(a, 0x9003, "up")
    swatch(a, 0x9004, "field")
    swatch(a, 0x9005, "hover")
    swatch(a, 0x9006, "line")
    app.end(a)
    let r2: usize = app.row(a)
    swatch(a, 0x9007, "txt")
    swatch(a, 0x9008, "dim")
    swatch(a, 0x9009, "accent")
    swatch(a, 0x900a, "warn")
    swatch(a, 0x900b, "ok")
    swatch(a, 0x900c, "sel")
    app.end(a)
    var rs: style.Style = style.style_new()
    rs = style.style_set_border(rs, style.color_token(style.TOK_ACCENT), 2)
    rs = style.style_set_radius(rs, 8)
    let q0: usize = sheet.sheet_rule(&(*a).sh, sheet.sel_class(0x9101), rs)
    rs = style.style_set_radius(rs, 12)
    let q1: usize = sheet.sheet_rule(&(*a).sh, sheet.sel_class(0x9102), rs)
    rs = style.style_set_radius(rs, 16)
    let q2: usize = sheet.sheet_rule(&(*a).sh, sheet.sel_class(0x9103), rs)
    rs = style.style_set_radius(rs, 999)
    let q3: usize = sheet.sheet_rule(&(*a).sh, sheet.sel_class(0x9104), rs)
    let r3: usize = app.row(a)
    radius_box(a, 0x9101, 64, "8")
    radius_box(a, 0x9102, 64, "12")
    radius_box(a, 0x9103, 64, "16")
    radius_box(a, 0x9104, 64, "999")
    app.end(a)
    let r4: usize = app.row(a)
    scene.node_set_gap(app.app_scene(a), r4, 40, 40)
    shadow_box(a, webtheme.K_SH_SM, "sm")
    shadow_box(a, webtheme.K_SH_MD, "md")
    shadow_box(a, webtheme.K_SH_LG, "lg")
    app.end(a)
    let bub: usize = app.spacer(a, 240, 44)
    scene.node_add_class(app.app_scene(a), bub, webtheme.K_BUBBLE)
    let t7: usize = node_label(a, "user bubble: gradient 135deg, radius 18", webtheme.TY_CAPTION)

    let s: *mut Surface = surface_for(a, 360, 760)
    check(s != 0 as u64 as *mut Surface, "surface")
    settle(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    check(t0 != app.NONE && t1 != app.NONE && t6 != app.NONE, "text nodes exist")
    check(scene.node_h(sc, t1) > scene.node_h(sc, t3) / 2.0 && scene.node_h(sc, t1) > scene.node_h(sc, t5), "title is taller than caption")
    check(scene.node_h(sc, t3) > scene.node_h(sc, t4) * 1.5, "a long body text wraps to several lines (container width)")
    check(scene.node_w(sc, t3) <= 360.0, "wrapped text stays inside the window")
    let h14: f64 = scene.node_h(sc, t4)
    // --- text scale: every step grows
    check(webtheme.text_px(a, webtheme.TY_BODY) == 14, "text_px at scale 1.0: 14")
    app.set_text_scale(a, 1500)
    settle(a, s)
    check(webtheme.text_px(a, webtheme.TY_BODY) == 21 && webtheme.text_px(a, webtheme.TY_TITLE) == 30, "text_px at scale 1.5: 21 / 30")
    check(scene.node_h(sc, t4) > h14 * 1.3, "text scale 1.5: the body line grows")
    app.set_text_scale(a, 1000)
    settle(a, s)
    check(scene.node_h(sc, t4) > h14 - 0.5 && scene.node_h(sc, t4) < h14 + 0.5, "text scale back to 1.0: bit for bit the old height")
    save(&(*s).cv, dir, "appmobile_tokens-dark.png")

    // --- light
    webtheme.set_mode(a, webtheme.MODE_LIGHT)
    settle(a, s)
    check(!webtheme.is_dark() && !theme.theme_is_dark(m) && (*f).base == 0xf4f6fc && (*f).surface == 0xffffff, "set_mode(light): light palette in the theme")
    let bd: *mut sheet.Decl = sheet.sheet_decl(&(*a).sh, rules0 + webtheme.TY_COUNT + 2)
    var pl: webtheme.Pal = webtheme.palette(webtheme.FLAVOR_FLEITEC, false)
    check((*bd).s.bg == pl.bubble0 && (*bd).s.bg2 == pl.bubble1, "the bubble rule was refreshed with the light gradient")
    let kd: *mut sheet.Decl = sheet.sheet_decl(&(*a).sh, rules0 + webtheme.TY_COUNT)
    check((*kd).s.bs_a == (webtheme.shadow_alpha(webtheme.SH_SM, false) as u8), "the card shadow was refreshed (weaker in light)")
    check(sheet.sheet_count(&(*a).sh) == rules0 + webtheme.RULE_COUNT + 16, "switching adds no rules")
    save(&(*s).cv, dir, "appmobile_tokens-light.png")

    // --- system
    webtheme.set_mode(a, webtheme.MODE_SYSTEM)
    check(webtheme.mode() == webtheme.MODE_SYSTEM && webtheme.is_dark(), "system without a report: dark (the web app's default)")
    webtheme.set_system_dark(a, false)
    check(!webtheme.is_dark() && (*f).base == 0xf4f6fc, "system says light: light")
    webtheme.set_system_dark(a, true)
    check(webtheme.is_dark() && (*f).base == 0x0c0e1f, "system says dark: dark (live)")
    var sp: syspref.SysPref = syspref.syspref_new()
    syspref.portal_scheme(2, &sp)
    webtheme.follow_syspref(a, &sp)
    check(!webtheme.is_dark(), "follow_syspref: portal says light")
    var sp2: syspref.SysPref = syspref.syspref_new()
    webtheme.follow_syspref(a, &sp2)
    check(!webtheme.is_dark(), "follow_syspref: unknown scheme changes nothing")
    webtheme.set_mode(a, webtheme.MODE_DARK)
    webtheme.set_system_dark(a, false)
    check(webtheme.is_dark(), "MODE_DARK ignores the system")
    webtheme.set_mode(a, webtheme.MODE_LIGHT)
    webtheme.set_system_dark(a, true)
    check(!webtheme.is_dark(), "MODE_LIGHT ignores the system")

    // --- flavour and accent
    webtheme.set_mode(a, webtheme.MODE_DARK)
    webtheme.set_flavor(a, webtheme.FLAVOR_CLAUDE)
    check((*f).base == 0x262624 && (*f).accent == 0xc96442, "flavour claude: the claude palette")
    webtheme.set_flavor(a, webtheme.FLAVOR_FLEITEC)
    webtheme.set_accent(a, 0x22aa55)
    check((*f).accent != 0x2f86ff && theme.contrast((*f).accent, (*f).base) >= 4.5, "set_accent: own accent, still readable")
    webtheme.set_mode(a, webtheme.MODE_LIGHT)
    check(theme.contrast((*f).accent, (*f).base) >= 4.5, "set_accent in light: darkened to 4.5")
    webtheme.set_accent(a, 0)
    webtheme.set_mode(a, webtheme.MODE_DARK)
    check((*f).accent == 0x2f86ff, "set_accent(0): the web accent again")
    let t8: usize = webtheme.text(a, "later", webtheme.TY_BODY)
    webtheme.set_ty(a, t8, webtheme.TY_TITLE)
    check(t8 != app.NONE, "set_ty on a node")

    if BAD == 0 {
        num("WEBTHEME checks: ", TOTAL as i64)
        say("WEBTHEME PASSED\n")
        return 0
    }
    say("WEBTHEME FAILED\n")
    return 1
}
