// SPDX-License-Identifier: MPL-2.0
// tools/fui/editor_main.fi -- THE OPERATION OF THE TEXT FIELD, RE-CALCULATED.
//
// ====================================================== WHY IT EXISTS
//
// lib/fui/editor.fi had stood in the tree since its first day and could
// NOT BE TRANSLATED: in the branch for the backspace key the line
// `if ctrl && !tb_has_sel(t) {` was missing, the curly brace below it
// thereby closed the function, and the translator broke off at the next
// `if` at the top level. Nobody noticed, because the file was
// included by no program and the acceptance run did not know it -- exactly the way
// in which in this tree something has already been lost SILENTLY twice.
//
// So from now on it is built AND calculated. No window, no
// font, no image: only keys in and the numbers back.
import std.rt
import fui.textbuf
import fui.editor

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, got: i64, want: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var h1: [u8; 5] = " got "
    rt.buf_push_bytes(&t, (&h1[0]) as u64, 5)
    rt.buf_push_dec_i64(&t, got)
    var h2: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&h2[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, want)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn b2i(b: bool) -> i64 {
    if b { return 1 }
    return 0
}

// The text in the field against an expected string. Compared are
// length AND bytes -- a string of equal length that is wrong is the
// error that a pure length check lets through.
fn text_is(e: *mut editor.Editor, p: u64, n: usize) -> bool {
    let t: *mut textbuf.TextBuf = editor.editor_buf(e)
    if textbuf.tb_len(t) != n {
        return false
    }
    var i: usize = 0
    while i < n {
        let a: u8 = *((textbuf.tb_ptr(t) + i as u64) as *mut u8)
        let b: u8 = *((p + i as u64) as *mut u8)
        if a != b {
            return false
        }
        i = i + 1
    }
    return true
}

// Sets the field to "hello world" and the write pointer to the end.
// The byte positions to which all numbers below refer:
//   h0 e1 l2 l3 o4 _5 w6 o7 r8 l9 d10, length 11.
fn fill(e: *mut editor.Editor) {
    var s: [u8; 11] = "hello world"
    let t: *mut textbuf.TextBuf = editor.editor_buf(e)
    textbuf.tb_set_text(t, (&s[0]) as u64, 11)
    textbuf.tb_set_range(t, 11, 11)
}

fn main(start: u64) -> i32 {
    var raw: [u8; 512] = [0; 512]
    var ed: editor.Editor = editor.editor_new()
    if !editor.editor_init(&ed, (&raw[0]) as u64, 512) {
        var oom: [u8; 24] = "editor_init: no memory\n\n"
        rt.write_everything(2, (&oom[0]) as u64, 23)
        return 2
    }

    // ==================================================================
    // 1. CTRL+A -- JUSTIN'S ERROR FROM THE ADDRESS BAR
    // ==================================================================
    // Selection over everything, then a character: it REPLACES the selection.
    // Appended it would be the old address plus the new one, so 12 bytes.
    fill(&ed)
    let r1: u32 = editor.editor_char(&ed, 97 as u32, editor.MOD_CTRL)
    let tb: *mut textbuf.TextBuf = editor.editor_buf(&ed)
    var a1: [u8; 40] = "1 Strg+A waehlt von 0 ...               "
    report((&a1[0]) as u64, 38, textbuf.tb_sel_a(tb) == 0,
        textbuf.tb_sel_a(tb) as i64, 0)
    var a2: [u8; 40] = "1 ... bis 11                            "
    report((&a2[0]) as u64, 38, textbuf.tb_sel_b(tb) == 11,
        textbuf.tb_sel_b(tb) as i64, 11)
    var a3: [u8; 40] = "1 und meldet nur Bewegung               "
    report((&a3[0]) as u64, 38, r1 == editor.RES_MOVED,
        r1 as i64, editor.RES_MOVED as i64)
    let r1b: u32 = editor.editor_char(&ed, 88 as u32, 0 as u32)
    var x1: [u8; 1] = "X"
    var a4: [u8; 40] = "1 das Zeichen ERSETZT die Auswahl       "
    report((&a4[0]) as u64, 38, text_is(&ed, (&x1[0]) as u64, 1),
        textbuf.tb_len(tb) as i64, 1)

    // ==================================================================
    // 2. CTRL+BACKSPACE DELETES THE WORD TO THE LEFT
    // ==================================================================
    // The branch in which the missing line sat. From 11 word_left
    // goes over "world" to 6, deleted is 6..11 -- what remains is
    // "hello " with 6 bytes, the pointer stands at 6.
    fill(&ed)
    let r2: u32 = editor.editor_key(&ed, editor.KEY_BACKSPACE,
        editor.MOD_CTRL)
    var h6: [u8; 6] = "hello "
    var b1: [u8; 40] = "2 Strg+Rueck loescht das Wort links     "
    report((&b1[0]) as u64, 38, text_is(&ed, (&h6[0]) as u64, 6),
        textbuf.tb_len(tb) as i64, 6)
    var b2: [u8; 40] = "2 der Schreibzeiger steht auf 6         "
    report((&b2[0]) as u64, 38, textbuf.tb_caret(tb) == 6,
        textbuf.tb_caret(tb) as i64, 6)
    var b3: [u8; 40] = "2 gemeldet wird: der Text hat sich ges. "
    report((&b3[0]) as u64, 38, r2 == editor.RES_CHANGED,
        r2 as i64, editor.RES_CHANGED as i64)

    // ==================================================================
    // 3. WITH A SELECTION CTRL+BACKSPACE ALSO ACTS ONLY ON THE SELECTION
    // ==================================================================
    // That is the claim that the missing `if` head carried.
    // Selected is 3..7 ("lo w"). Correct remains "hel" + "orld" =
    // "helorld", 7 bytes. Without the condition the word jump would run: it
    // would delete only "w" and leave 10 bytes standing.
    fill(&ed)
    textbuf.tb_set_range(tb, 7, 3)
    let r3: u32 = editor.editor_key(&ed, editor.KEY_BACKSPACE,
        editor.MOD_CTRL)
    var hw: [u8; 7] = "helorld"
    var c1: [u8; 40] = "3 mit Auswahl faellt genau die Auswahl  "
    report((&c1[0]) as u64, 38, text_is(&ed, (&hw[0]) as u64, 7),
        textbuf.tb_len(tb) as i64, 7)
    var c2: [u8; 40] = "3 nicht der Wortsprung (waeren 10)      "
    report((&c2[0]) as u64, 38, textbuf.tb_len(tb) != 10,
        b2i(textbuf.tb_len(tb) != 10), 1)
    var c3: [u8; 40] = "3 danach steht keine Auswahl mehr       "
    report((&c3[0]) as u64, 38, !textbuf.tb_has_sel(tb),
        b2i(!textbuf.tb_has_sel(tb)), 1)

    // ==================================================================
    // 4. CTRL+DELETE IS THE MIRROR IMAGE
    // ==================================================================
    // Pointer at 0, Ctrl+Delete: word_right runs over "hello" and the
    // space to 6, deleted is 0..6 -- "world", 5 bytes.
    fill(&ed)
    textbuf.tb_set_range(tb, 0, 0)
    let r4: u32 = editor.editor_key(&ed, editor.KEY_DELETE,
        editor.MOD_CTRL)
    var w5: [u8; 5] = "world"
    var d1: [u8; 40] = "4 Strg+Entf loescht das Wort rechts     "
    report((&d1[0]) as u64, 38, text_is(&ed, (&w5[0]) as u64, 5),
        textbuf.tb_len(tb) as i64, 5)

    // ==================================================================
    // 5. THE WORD JUMPS WITHOUT DELETING
    // ==================================================================
    // From 11 to the left: 6 (start of "world"), then 0. To the right
    // from 0: 6 (over "hello" and the space), then 11.
    fill(&ed)
    editor.editor_key(&ed, editor.KEY_LEFT, editor.MOD_CTRL)
    var e1: [u8; 40] = "5 Strg+Links auf den Wortanfang         "
    report((&e1[0]) as u64, 38, textbuf.tb_caret(tb) == 6,
        textbuf.tb_caret(tb) as i64, 6)
    editor.editor_key(&ed, editor.KEY_LEFT, editor.MOD_CTRL)
    var e2: [u8; 40] = "5 noch einmal: an den Anfang            "
    report((&e2[0]) as u64, 38, textbuf.tb_caret(tb) == 0,
        textbuf.tb_caret(tb) as i64, 0)
    editor.editor_key(&ed, editor.KEY_RIGHT, editor.MOD_CTRL)
    var e3: [u8; 40] = "5 Strg+Rechts ueber Wort und Luecke     "
    report((&e3[0]) as u64, 38, textbuf.tb_caret(tb) == 6,
        textbuf.tb_caret(tb) as i64, 6)
    editor.editor_key(&ed, editor.KEY_RIGHT, editor.MOD_CTRL)
    var e4: [u8; 40] = "5 und ans Ende                          "
    report((&e4[0]) as u64, 38, textbuf.tb_caret(tb) == 11,
        textbuf.tb_caret(tb) as i64, 11)

    // ==================================================================
    // 6. CTRL+Z AND CTRL+Y
    // ==================================================================
    // "hello world", then Ctrl+Backspace with Ctrl: 6 bytes. Ctrl+Z brings the
    // 11 back, Ctrl+Y restores the 6.
    fill(&ed)
    editor.editor_key(&ed, editor.KEY_BACKSPACE, editor.MOD_CTRL)
    let z1: bool = editor.editor_undo(&ed)
    var f1: [u8; 40] = "6 Strg+Z stellt die 11 Bytes wieder her "
    report((&f1[0]) as u64, 38, textbuf.tb_len(tb) == 11,
        textbuf.tb_len(tb) as i64, 11)
    var f1b: [u8; 40] = "6 und meldet, dass es etwas tat         "
    report((&f1b[0]) as u64, 38, z1, b2i(z1), 1)
    let z2: bool = editor.editor_redo(&ed)
    var f2: [u8; 40] = "6 Strg+Y nimmt sie wieder weg           "
    report((&f2[0]) as u64, 38, textbuf.tb_len(tb) == 6,
        textbuf.tb_len(tb) as i64, 6)
    var f2b: [u8; 40] = "6 und meldet es ebenfalls               "
    report((&f2b[0]) as u64, 38, z2, b2i(z2), 1)
    // Via the key path (Ctrl+Z as control character 26) just the same.
    let r6: u32 = editor.editor_char(&ed, 26 as u32, editor.MOD_CTRL)
    var f3: [u8; 40] = "6 Strg+Z als Steuerzeichen 26 wirkt auch"
    report((&f3[0]) as u64, 38, textbuf.tb_len(tb) == 11,
        textbuf.tb_len(tb) as i64, 11)
    var f4: [u8; 40] = "6 und meldet eine Textaenderung         "
    report((&f4[0]) as u64, 38, r6 == editor.RES_CHANGED,
        r6 as i64, editor.RES_CHANGED as i64)

    // ==================================================================
    // 7. WHAT DOES NOT BELONG TO THE FIELD IS PASSED ON
    // ==================================================================
    // Without this answer a field with focus swallows every key sequence
    // of the whole program -- no Ctrl+T, no tab switch.
    fill(&ed)
    var g1: [u8; 40] = "7 Eingabetaste -> COMMIT                "
    let k1: u32 = editor.editor_key(&ed, editor.KEY_ENTER, 0 as u32)
    report((&g1[0]) as u64, 38, k1 == editor.RES_COMMIT,
        k1 as i64, editor.RES_COMMIT as i64)
    var g2: [u8; 40] = "7 Esc -> CANCEL                         "
    let k2: u32 = editor.editor_key(&ed, editor.KEY_ESC, 0 as u32)
    report((&g2[0]) as u64, 38, k2 == editor.RES_CANCEL,
        k2 as i64, editor.RES_CANCEL as i64)
    var g3: [u8; 40] = "7 Tabulator gehoert dem Programm        "
    let k3: u32 = editor.editor_key(&ed, editor.KEY_TAB, 0 as u32)
    report((&g3[0]) as u64, 38, k3 == editor.RES_PASS,
        k3 as i64, editor.RES_PASS as i64)
    var g4: [u8; 40] = "7 Strg+T ebenso -- und nicht als Text   "
    let k4: u32 = editor.editor_char(&ed, 116 as u32, editor.MOD_CTRL)
    report((&g4[0]) as u64, 38, k4 == editor.RES_PASS,
        k4 as i64, editor.RES_PASS as i64)
    var g5: [u8; 40] = "7 der Text blieb dabei 11 Bytes lang    "
    report((&g5[0]) as u64, 38, textbuf.tb_len(tb) == 11,
        textbuf.tb_len(tb) as i64, 11)

    editor.editor_free(&ed)

    // ---- the verdict
    var end: [u8; 16] = "\nEDITOR PASSED.\n"
    if G_ERRORS != 0 {
        var bad: [u8; 16] = "\nEDITOR FAILED.\n"
        rt.write_everything(2, (&bad[0]) as u64, 16)
        return 1
    }
    rt.write_everything(1, (&end[0]) as u64, 16)
    return 0
}
