// SPDX-License-Identifier: MPL-2.0
// tools/fui/syspref_main.fi -- THE CHECK OF lib/fui/syspref.fi (system dark mode / accent / high contrast).
// Pure: no window, no bus. Exit 1 on any WRONG.
import std.rt
import fui.theme
import fui.syspref
import fui.anim

static mut BAD: usize = 0

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }

fn check(ok: bool, what: str) {
    if ok { say("  ok    ") } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn main(start: u64) -> i32 {
    say("== syspref ==\n")
    var sp: syspref.SysPref = syspref.syspref_new()
    check(!sp.dark_known && !sp.accent_known && !sp.contrast, "fresh preferences know nothing")
    syspref.portal_scheme(0 as u32, &sp)
    check(!sp.dark_known, "portal color-scheme 0 (no preference) leaves dark unknown")
    syspref.portal_scheme(1 as u32, &sp)
    check(sp.dark_known && sp.dark, "portal color-scheme 1 = dark")
    syspref.portal_scheme(2 as u32, &sp)
    check(sp.dark_known && !sp.dark, "portal color-scheme 2 = light")
    var t2: syspref.SysPref = syspref.syspref_new()
    check(syspref.scheme_from_text("'prefer-dark'", &t2) && t2.dark, "gsettings 'prefer-dark'")
    check(syspref.scheme_from_text("Adwaita-dark", &t2) && t2.dark, "GTK theme Adwaita-dark")
    check(syspref.scheme_from_text("'default'", &t2) && !t2.dark, "gsettings 'default' = light")
    var t3: syspref.SysPref = syspref.syspref_new()
    check(!syspref.scheme_from_text("'xyz'", &t3) && !t3.dark_known, "unknown text says nothing")
    var a: syspref.SysPref = syspref.syspref_new()
    syspref.accent_from_unit(0, 500, 1000, &a)
    check(a.accent_known && a.accent == 33023 as u32, "portal accent (0, .5, 1) = 0x0080FF")
    syspref.accent_from_unit(2000, 0 - 5, 1000, &a)
    check(a.accent == 16711935 as u32, "out-of-range components are clamped (0xFF00FF)")
    syspref.accent_from_abgr(0xFFCC6600 as u32, &a)
    check(a.accent == 0x0066CC as u32, "registry ABGR 0xFFCC6600 = 0x0066CC")
    syspref.accent_from_argb(0xFF3584E4 as u32, &a)
    check(a.accent == 0x3584E4 as u32, "DWM ARGB drops the alpha")
    check(syspref.accent_from_name("'blue'", &a) && a.accent == 0x3584E4 as u32, "GNOME accent 'blue'")
    check(syspref.accent_from_name("'orange'", &a) && a.accent == 0xED5B00 as u32, "GNOME accent 'orange'")
    check(!syspref.accent_from_name("'mauve'", &a), "unknown accent name is refused")
    var h: syspref.SysPref = syspref.syspref_new()
    syspref.hc_from_flags(1 as u32, &h)
    check(h.contrast, "HCF_HIGHCONTRASTON -> contrast")
    syspref.hc_from_flags(0x80 as u32, &h)
    check(!h.contrast, "other flags only -> no contrast")
    syspref.portal_contrast(1 as u32, &h)
    check(h.contrast, "portal contrast 1 = more contrast")

    // ---- onto a theme
    var th: theme.Theme = theme.theme_new(false)
    var base: theme.Shape = *theme.theme_shape(&th)
    var sd: syspref.SysPref = syspref.syspref_new()
    check(syspref.syspref_apply(&th, &sd, &base) == 0 as u32, "nothing known -> nothing applied")
    syspref.portal_scheme(1 as u32, &sd)
    syspref.accent_from_unit(1000, 830, 0, &sd) // yellow-orange, the hard case for white text
    let ch: u32 = syspref.syspref_apply(&th, &sd, &base)
    check(ch == (syspref.CH_DARK | syspref.CH_ACCENT), "dark + accent applied")
    check(theme.theme_is_dark(&th), "theme is dark")
    check((*theme.theme_colors(&th)).accent == sd.accent, "theme accent = the system accent")
    check(theme.contrast((*theme.theme_colors(&th)).accent, (*theme.theme_colors(&th)).text_on_accent) >= 4.5,
        "text on the system accent keeps 4.5:1")
    syspref.portal_contrast(1 as u32, &sd)
    let ch2: u32 = syspref.syspref_apply(&th, &sd, &base)
    check((ch2 & syspref.CH_CONTRAST) != 0 as u32, "high contrast applied")
    check((*theme.theme_colors(&th)).base == 0 as u32 && (*theme.theme_colors(&th)).text == 16777215 as u32,
        "high contrast: black ground, white text")
    check(theme.contrast((*theme.theme_colors(&th)).base, (*theme.theme_colors(&th)).text) >= 7.0,
        "high contrast text pair is 7:1 or better")
    check((*theme.theme_shape(&th)).focus_w != base.focus_w, "high contrast widens the focus ring")
    syspref.portal_contrast(0 as u32, &sd)
    syspref.portal_scheme(2 as u32, &sd)
    let ch3: u32 = syspref.syspref_apply(&th, &sd, &base)
    check((ch3 & syspref.CH_CONTRAST) == 0 as u32 && !theme.theme_is_dark(&th), "leaving high contrast: light again")
    check((*theme.theme_shape(&th)).focus_w == base.focus_w, "leaving high contrast restores the program's shape")
    check((*theme.theme_colors(&th)).accent == sd.accent, "the system accent survives")
    // reduced motion (gap list #71)
    var mo: syspref.SysPref = syspref.syspref_new()
    check(!syspref.motion_reduced(&mo), "fresh: motion not reduced")
    var rg: anim.TransReg = anim.transreg_new()
    check(!syspref.motion_apply(&rg, &mo), "unknown motion preference changes nothing")
    syspref.motion_from_gsettings(false, &mo)
    check(syspref.motion_reduced(&mo), "gsettings enable-animations=false = reduced")
    syspref.motion_from_gsettings(true, &mo)
    check(!syspref.motion_reduced(&mo), "gsettings enable-animations=true = normal")
    syspref.motion_from_spi(false, &mo)
    check(syspref.motion_reduced(&mo), "SPI client-area animation FALSE = reduced")
    syspref.motion_from_scale(0, &mo)
    check(syspref.motion_reduced(&mo), "Android animator scale 0 = reduced")
    syspref.motion_from_scale(1000, &mo)
    check(!syspref.motion_reduced(&mo), "Android animator scale 1.0 = normal")
    syspref.motion_from_scale(0, &mo)
    check(syspref.motion_apply(&rg, &mo), "reduced is applied to the registry")
    check(rg.dur == 1 && rg.lead == 0 && rg.dstate[1] == 1, "reduced: 1 ms transitions, no lead-in")
    syspref.motion_from_scale(1000, &mo)
    check(syspref.motion_apply(&rg, &mo) && rg.dur > 50 && rg.lead > 0, "normal puts the Fluent feel back")
    say("SYSPREF bad=")
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, BAD as u64)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    say("\n")
    if BAD > 0 { return 1 }
    return 0
}
