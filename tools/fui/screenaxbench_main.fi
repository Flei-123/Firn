import std.io
import std.rt
import std.time
import fui.kit
import fui.screenax
import fui.widget

fn main() -> i32 {
    screenax.install()
    var f: usize = 0
    let t0: u64 = time.monotonic_ns()
    while f < 20000 {
        screenax.begin()
        var i: usize = 0
        while i < 120 {
            screenax.note(widget.KIND_BUTTON, 0 as u32, "Install the selected profile", 10.0 + i as f64, 20.0, 80.0, 30.0, 0)
            i = i + 1
        }
        f = f + 1
    }
    let t1: u64 = time.monotonic_ns()
    let per_frame_us: u64 = (t1 - t0) / 20000 / 1000
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, per_frame_us as i64)
    io.print("registry us per frame (120 notes): ")
    io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
    io.print("\n")
    if per_frame_us > 1000 { return 1 }
    return 0
}
