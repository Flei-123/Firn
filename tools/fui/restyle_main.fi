// SPDX-License-Identifier: MPL-2.0
// tools/fui/restyle_main.fi -- A CLASS TOGGLED LATER SHOWS (r98, the active chip / tab).
//
// The transition registry used to remember the style a widget had in its FIRST
// frame and put it back before every frame. A program that resolves its style
// sheet again in every frame (fui.app) toggles a class -- the active chip, the
// active tab -- and the registry painted the old style for ever. Measured from
// the painted pixel inside a button:
//   * the button rests; a class with a background is added; some frames later
//     the pixel has the class's colour (registry with `transreg_set_fresh_style`);
//   * COUNTER-CHECK: the same without it stays at the old colour.
import std.rt
import font.metrics
import paint.canvas
import fui.theme
import fui.widget
import fui.painter
import fui.render
import fui.control
import fui.scene
import fui.query
import fui.style
import fui.sheet
import fui.anim

static mut G_ERRORS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_int(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(name: str, ok: bool, got: i64, want: i64) {
    say("  ")
    say(name)
    var k: usize = name.n
    while k < 66 {
        say(" ")
        k = k + 1
    }
    if ok {
        say("OK    got ")
    } else {
        say("WRONG got ")
        G_ERRORS = G_ERRORS + 1
    }
    say_int(got)
    say(" want ")
    say_int(want)
    say("\n")
}

fn eq(name: str, got: i64, want: i64) {
    check(name, got == want, got, want)
}

fn key(s: str) -> u32 {
    return query.query_key(s.p as u64, s.n)
}

fn build(sc: *mut scene.Scene, k: u32) {
    scene.scene_reset(sc)
    let root: usize = scene.scene_add(sc, scene.SCENE_NONE, scene.N_BOX)
    let t: str = "Chip"
    let b: usize = scene.scene_widget(sc, root, widget.KIND_BUTTON, t.p as u64, t.n)
    scene.node_set_size(sc, b, 160.0, 50.0)
    scene.node_add_class(sc, b, k)
}

fn find_button(sc: *mut scene.Scene) -> usize { return 1 }

fn lay(sc: *mut scene.Scene, c: *mut render.Ctx, sh: *mut sheet.Sheet) {
    scene.scene_style(sc, sh)
    scene.scene_measure(sc, c)
    scene.scene_layout(sc, c, 0.0, 0.0, 480.0, 800.0)
}

fn frame(cv: *mut canvas.Canvas, sc: *mut scene.Scene, c: *mut render.Ctx,
    sh: *mut sheet.Sheet, reg: *mut anim.TransReg, ms: i64) {
    anim.transreg_new_frame(reg)
    scene.scene_style(sc, sh)
    render.ctx_set_time(c, ms)
    canvas.canvas_clear(cv, (255 as u32 << 24) | 16777215 as u32)
    scene.scene_draw(sc, c)
}

fn px(cv: *mut canvas.Canvas, sc: *mut scene.Scene, i: usize) -> i64 {
    let p: u32 = canvas.canvas_get(cv, (scene.node_x(sc, i) + 8.0) as usize,
        (scene.node_y(sc, i) + scene.node_h(sc, i) / 2.0) as usize)
    return ((canvas.color_r(p) << 16) | (canvas.color_g(p) << 8) | canvas.color_b(p)) as i64
}

static mut R_REST: i64 = 0
static mut R_AFTER: i64 = 0

#[allow_escape]
fn scenario(sc: *mut scene.Scene, cv: *mut canvas.Canvas, c: *mut render.Ctx, fresh: bool) {
    let K: u32 = 77 as u32
    var sh: sheet.Sheet = sheet.sheet_new()
    var st: style.Style = style.style_new()
    st = style.style_set_bg(st, style.color_literal(16711680 as u32))
    let r: usize = sheet.sheet_rule(&sh, sheet.sel_class(K), st)
    var reg: anim.TransReg = anim.transreg_new()
    anim.transreg_set_duration(&reg, 100)
    anim.transreg_set_easing(&reg, anim.easing_linear())
    if fresh { anim.transreg_set_fresh_style(&reg) }
    anim.transreg_bind(&reg, c)
    // a plain button first (no class), painted at rest
    build(sc, 5 as u32)
    lay(sc, c, &sh)
    let b: usize = find_button(sc)
    frame(cv, sc, c, &sh, &reg, 0)
    frame(cv, sc, c, &sh, &reg, 20)
    R_REST = px(cv, sc, b)
    // the class is added later (the chip becomes the active one)
    scene.node_add_class(sc, b, K)
    frame(cv, sc, c, &sh, &reg, 1000)
    frame(cv, sc, c, &sh, &reg, 1050)
    frame(cv, sc, c, &sh, &reg, 1200)
    frame(cv, sc, c, &sh, &reg, 1400)
    R_AFTER = px(cv, sc, b)
    anim.transreg_unbind(&reg, c)
}

fn main(start: u64) -> i32 {
    var fbuf: rt.Buf = rt.buf_new()
    var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
    if !rt.read_file((&f1[0]) as u64, &fbuf) {
        say("restyle: no font\n")
        return 9
    }
    let fsp: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    *fsp = metrics.fontset_new()
    if !metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
        return 9
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, 480, 800) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, 480, 800) {
        return 5
    }
    painter.painter_set_font(&z, fsp as u64)
    var m: theme.Theme = theme.theme_new(true)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let sc: *mut scene.Scene = rt.heap_alloc(1048576) as *mut scene.Scene
    *sc = scene.scene_new()

    say("== 1. a registry that follows the resolved style\n")
    scenario(sc, &cv, &c, true)
    let rest: i64 = R_REST
    check("the class colour (red) shows after the change", ((R_AFTER >> 16) & 255) > 200 && (R_AFTER & 255) < 60, R_AFTER, 16711680)
    check("the rest colour was not red", ((rest >> 16) & 255) < 200 || (rest & 255) > 100, rest, 0)
    say("== 2. COUNTER-CHECK: the old behaviour (no fresh style) never shows it\n")
    scenario(sc, &cv, &c, false)
    check("without it the pixel stays at the rest colour", R_AFTER == rest, R_AFTER, rest)
    if G_ERRORS == 0 {
        say("RESTYLE PASSED\n")
        return 0
    }
    say("RESTYLE FAILED: ")
    say_int(G_ERRORS as i64)
    say("\n")
    return 1
}
