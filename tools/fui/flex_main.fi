// SPDX-License-Identifier: MPL-2.0
// tools/fui/flex_main.fi -- THE FLEX DISTRIBUTION IS RE-CALCULATED.
//
// Every claim here is a pixel value calculated by HAND, no
// "looks plausible":
//
//   1. Without growing and shrinking the children stand at their basis,
//      with the gap in between.
//   2. Free space goes by `flex-grow`, and the sum of the parts
//      fills the width EXACTLY (the remainder of the division is not
//      lost).
//   3. Missing space goes by `flex-shrink` TIMES BASIS.
//   4. Whoever clamps at its minimum width accepts nothing any more --
//      and the remaining space is distributed ANEW. That is the point at
//      which a half-finished flexbox leaves a gap at the edge.
//   5. justify-content distributes the air at the right places.
//   6. Wrapping makes the right number of lines.
//   7. A FlexItem is 64 octets large -- the stride with which
//      `item_at` calculates is MEASURED and not believed.
//   8. Shrinking with UNEQUAL basis weighs with shrink TIMES BASIS.
//   9. Two children clamp in the same round, and what they do not
//      accept goes in the next round to the third.
//  10. The remainder of the integer division is not lost.
//  11. Wrapping with align-content: start, center, space-between and
//      stretch -- the lines themselves grow and fill the box.
//  12. Column and column reversed.
//  13. row-reverse packs at `flex-start` RIGHT, not left.
//  14. AL_BASELINE brings three children of different height onto ONE
//      baseline.
//  15. The bridge to the measuring protocol: `flex_px` rounds up,
//      `flex_item_from_pref` turns basis and cross size the right way
//      round depending on the direction.
//  16. The measuring of the container including gaps and inner margin.
//  17. Shrinking with shrink 0.5 and three unequal bases.
//  18. Shrinking with shrink 0.25 -- the case that the division
//      IN THE MIDDLE of the weighting calculated wrongly (the weight is kept in
//      thousandths, division happens only at the share).
import std.rt
import fui.flex
import fui.layout

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    var w: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&w[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn main(start: u64) -> i32 {
    var out: [layout.Rect; 8] = [layout.rect_new(0, 0, 0, 0); 8]
    var gr: [i64; 8] = [0; 8]
    var fz: [i64; 8] = [0; 8]

    // ============================================ 1. ONLY THE BASIS
    var s: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_gap(&s, 10, 0)
    var k: [flex.FlexItem; 3] = [flex.flex_item(100, 20); 3]
    flex.flex_layout(&s, layout.rect_new(0, 0, 400, 40),
        (&k[0]) as *mut flex.FlexItem, 3, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n1: [u8; 32] = "1 the second child starts at 110"
    report((&n1[0]) as u64, 32, layout.rect_x(&out[1]) == 110,
        layout.rect_x(&out[1]), 110)
    var n2: [u8; 28] = "1 and keeps its basis of 100"
    report((&n2[0]) as u64, 28, layout.rect_w(&out[1]) == 100,
        layout.rect_w(&out[1]), 100)

    // ================================================== 2. GROWING
    //
    // 400 space, 20 gap, 300 basis -> 80 free, all to the middle
    // child: 100 / 180 / 100, starts 0 / 110 / 300.
    flex.item_set_flex(&k[1], 1000, 1000, 100)
    flex.flex_layout(&s, layout.rect_new(0, 0, 400, 40),
        (&k[0]) as *mut flex.FlexItem, 3, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n3: [u8; 35] = "2 the stretchy one becomes 180 wide"
    report((&n3[0]) as u64, 35, layout.rect_w(&out[1]) == 180,
        layout.rect_w(&out[1]), 180)
    var n4: [u8; 30] = "2 the last one ends exactly at"
    let end: i64 = layout.rect_x(&out[2]) + layout.rect_w(&out[2])
    report((&n4[0]) as u64, 30, end == 400, end, 400)

    // ================================= 3. GROWING WITH MAXIMUM WIDTH
    //
    // The same, but the middle child may become at most 130. It
    // clamps at 130, the remaining 50 go to the third, which
    // may also grow: 100 / 130 / 150.
    flex.item_set_bounds(&k[1], 0, 130)
    flex.item_set_flex(&k[2], 1000, 1000, 100)
    flex.flex_layout(&s, layout.rect_new(0, 0, 400, 40),
        (&k[0]) as *mut flex.FlexItem, 3, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n5: [u8; 31] = "3 the clamped one stops at 130 "
    report((&n5[0]) as u64, 31, layout.rect_w(&out[1]) == 130,
        layout.rect_w(&out[1]), 130)
    var n6: [u8; 34] = "3 and the rest is handed on: 150  "
    report((&n6[0]) as u64, 34, layout.rect_w(&out[2]) == 150,
        layout.rect_w(&out[2]), 150)

    // ================================================ 4. SHRINKING
    //
    // 200 space, 20 gap, 300 basis -> 120 missing. All three
    // shrink with equal weighting (shrink 1, same basis),
    // so 40 each: 60 / 60 / 60.
    var m: [flex.FlexItem; 3] = [flex.flex_item(100, 20); 3]
    flex.flex_layout(&s, layout.rect_new(0, 0, 200, 40),
        (&m[0]) as *mut flex.FlexItem, 3, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n7: [u8; 29] = "4 each shrinks by 40, to 60  "
    report((&n7[0]) as u64, 29, layout.rect_w(&out[0]) == 60,
        layout.rect_w(&out[0]), 60)
    let end2: i64 = layout.rect_x(&out[2]) + layout.rect_w(&out[2])
    var n8: [u8; 35] = "4 and the row still ends at exactly"
    report((&n8[0]) as u64, 35, end2 == 200, end2, 200)

    // ============================================== 5. JUSTIFY
    //
    // Three children of 100, no growing, 400 space, no gap:
    // 100 free. space-between lays 50 between every two: 0 / 150 / 300.
    var j: [flex.FlexItem; 3] = [flex.flex_item(100, 20); 3]
    var sj: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_justify(&sj, flex.JUSTIFY_BETWEEN)
    flex.flex_layout(&sj, layout.rect_new(0, 0, 400, 40),
        (&j[0]) as *mut flex.FlexItem, 3, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n9: [u8; 35] = "5 space-between puts the 2nd at 150"
    report((&n9[0]) as u64, 35, layout.rect_x(&out[1]) == 150,
        layout.rect_x(&out[1]), 150)
    var n10: [u8; 34] = "5 and the last one flush right at "
    report((&n10[0]) as u64, 34, layout.rect_x(&out[2]) == 300,
        layout.rect_x(&out[2]), 300)

    // ================================================== 6. WRAPPING
    //
    // Five children of 100 with 10 gap in 350 space: 100+10+100 = 210,
    // +10+100 = 320 still fits, the fourth no longer. So 3 + 2.
    var w: [flex.FlexItem; 5] = [flex.flex_item(100, 20); 5]
    var sw: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_wrap(&sw, flex.WRAP_WRAP)
    flex.flex_set_gap(&sw, 10, 10)
    let lines: usize = flex.flex_line_count(&sw,
        (&w[0]) as *mut flex.FlexItem, 5, layout.rect_new(0, 0, 350, 100))
    var n11: [u8; 26] = "6 five in 350 make 2 lines"
    report((&n11[0]) as u64, 26, lines == 2, lines as i64, 2)

    // ======================================== 7. THE STRIDE
    //
    // `item_at` calculates with 64 octets per child. If that no longer holds,
    // the distribution reads nonsense from the second child on -- and
    // silently. That is why the distance of two neighbours in the array is
    // MEASURED, not believed.
    let step: i64 = ((&k[1]) as u64 - (&k[0]) as u64) as i64
    var n12: [u8; 31] = "7 one FlexItem is this wide    "
    report((&n12[0]) as u64, 31, step == 64, step, 64)

    // ============================ 8. SHRINKING, UNEQUAL BASIS
    //
    // 240 space, no gap, bases 200 and 100 -> 60 missing. CSS
    // weighs with shrink TIMES BASIS: 200 to 100. So -40 and -20:
    // 160 and 80.
    var u: [flex.FlexItem; 2] = [flex.flex_item(200, 20); 2]
    u[1] = flex.flex_item(100, 20)
    var su: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_layout(&su, layout.rect_new(0, 0, 240, 40),
        (&u[0]) as *mut flex.FlexItem, 2, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n13: [u8; 34] = "8 the wide one gives up 40, to 160"
    report((&n13[0]) as u64, 34, layout.rect_w(&out[0]) == 160,
        layout.rect_w(&out[0]), 160)
    var n14: [u8; 34] = "8 the narrow one only 20, to 80   "
    report((&n14[0]) as u64, 34, layout.rect_w(&out[1]) == 80,
        layout.rect_w(&out[1]), 80)

    // ====================== 9. TWO CHILDREN CLAMP AT THE SAME TIME
    //
    // 400 space, three bases of 100, all grow equally, but the
    // first two may be at most 120. Round 1: 100/3 = 33 each,
    // both clamp at 120 and freeze. Round 2: there are still missing
    // 400 - (120+120+133) = 27, and those go entirely to the third:
    // 120 / 120 / 160, together exactly 400.
    var c2: [flex.FlexItem; 3] = [flex.flex_item(100, 20); 3]
    flex.item_set_flex(&c2[0], 1000, 1000, 100)
    flex.item_set_flex(&c2[1], 1000, 1000, 100)
    flex.item_set_flex(&c2[2], 1000, 1000, 100)
    flex.item_set_bounds(&c2[0], 0, 120)
    flex.item_set_bounds(&c2[1], 0, 120)
    var sc: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_layout(&sc, layout.rect_new(0, 0, 400, 40),
        (&c2[0]) as *mut flex.FlexItem, 3, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n15: [u8; 34] = "9 both clamped children stop at   "
    report((&n15[0]) as u64, 34,
        layout.rect_w(&out[0]) == 120 && layout.rect_w(&out[1]) == 120,
        layout.rect_w(&out[1]), 120)
    var n16: [u8; 34] = "9 the free one takes all the rest "
    report((&n16[0]) as u64, 34, layout.rect_w(&out[2]) == 160,
        layout.rect_w(&out[2]), 160)
    let end3: i64 = layout.rect_x(&out[2]) + layout.rect_w(&out[2])
    var n17: [u8; 34] = "9 and the row is full to the pixel"
    report((&n17[0]) as u64, 34, end3 == 400, end3, 400)

    // ================ 10. THE REMAINDER OF THE INTEGER DIVISION IS NOT
    //                     LOST
    //
    // 400 space, three bases of 100, all grow: 100 free, 100/3 = 33
    // per child. 33+33+33 = 99 -- the ONE remaining pixel goes to the
    // last movable child: 133 / 133 / 134.
    var r3: [flex.FlexItem; 3] = [flex.flex_item(100, 20); 3]
    flex.item_set_flex(&r3[0], 1000, 1000, 100)
    flex.item_set_flex(&r3[1], 1000, 1000, 100)
    flex.item_set_flex(&r3[2], 1000, 1000, 100)
    flex.flex_layout(&sc, layout.rect_new(0, 0, 400, 40),
        (&r3[0]) as *mut flex.FlexItem, 3, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n18: [u8; 34] = "10 100/3 gives the first child    "
    report((&n18[0]) as u64, 34, layout.rect_w(&out[0]) == 133,
        layout.rect_w(&out[0]), 133)
    var n19: [u8; 34] = "10 and the odd pixel the last one "
    report((&n19[0]) as u64, 34, layout.rect_w(&out[2]) == 134,
        layout.rect_w(&out[2]), 134)

    // ====================================== 11. WRAPPING + ALIGN-CONTENT
    //
    // Five children of 100 across 30, gaps 10/10, box 350 x 200:
    // lines 3 + 2, line heights 30, one cross gap 10.
    // Free across: 200 - 60 - 10 = 130.
    //   start   -> line 1 at y = 0, line 2 at y = 40
    //   center  -> 130/2 = 65 before: y = 65 and y = 105
    //   between -> the whole 130 in between: y = 0 and y = 170
    //   stretch -> 65 each onto the lines: height 95, y = 0 and y = 105
    var wz: [flex.FlexItem; 5] = [flex.flex_item(100, 30); 5]
    var sz: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_wrap(&sz, flex.WRAP_WRAP)
    flex.flex_set_gap(&sz, 10, 10)
    flex.flex_set_align_content(&sz, flex.AC_START)
    flex.flex_layout(&sz, layout.rect_new(0, 0, 350, 200),
        (&wz[0]) as *mut flex.FlexItem, 5, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n20: [u8; 34] = "11 align-content:start, 2nd row at"
    report((&n20[0]) as u64, 34, layout.rect_y(&out[3]) == 40,
        layout.rect_y(&out[3]), 40)
    var n21: [u8; 34] = "11 and the 4th child starts over  "
    report((&n21[0]) as u64, 34, layout.rect_x(&out[3]) == 0,
        layout.rect_x(&out[3]), 0)
    flex.flex_set_align_content(&sz, flex.AC_CENTER)
    flex.flex_layout(&sz, layout.rect_new(0, 0, 350, 200),
        (&wz[0]) as *mut flex.FlexItem, 5, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n22: [u8; 34] = "11 align-content:center, 1st row  "
    report((&n22[0]) as u64, 34, layout.rect_y(&out[0]) == 65,
        layout.rect_y(&out[0]), 65)
    flex.flex_set_align_content(&sz, flex.AC_BETWEEN)
    flex.flex_layout(&sz, layout.rect_new(0, 0, 350, 200),
        (&wz[0]) as *mut flex.FlexItem, 5, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n23: [u8; 34] = "11 align-content:between, 2nd row "
    report((&n23[0]) as u64, 34, layout.rect_y(&out[3]) == 170,
        layout.rect_y(&out[3]), 170)
    flex.flex_set_align_content(&sz, flex.AC_STRETCH)
    flex.flex_layout(&sz, layout.rect_new(0, 0, 350, 200),
        (&wz[0]) as *mut flex.FlexItem, 5, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n24: [u8; 34] = "11 stretch makes each row 95 high "
    report((&n24[0]) as u64, 34, layout.rect_h(&out[0]) == 95,
        layout.rect_h(&out[0]), 95)
    let below: i64 = layout.rect_y(&out[3]) + layout.rect_h(&out[3])
    var n25: [u8; 34] = "11 and the rows fill the box down "
    report((&n25[0]) as u64, 34, below == 200, below, 200)

    // ================================ 12. COLUMN AND COLUMN REVERSED
    //
    // Three children with basis 100 in a box 100 x 400: in the
    // column they stand at y = 0 / 100 / 200 and are stretched across
    // 100 wide. REVERSED the start of the axis lies at the BOTTOM, so
    // the first child stands at y = 300 and the last at y = 100.
    var sp: [flex.FlexItem; 3] = [flex.flex_item(100, 40); 3]
    var ss: flex.FlexBox = flex.flexbox_new(flex.FLEX_COLUMN)
    flex.flex_layout(&ss, layout.rect_new(0, 0, 100, 400),
        (&sp[0]) as *mut flex.FlexItem, 3, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n26: [u8; 34] = "12 column puts the 2nd child at y "
    report((&n26[0]) as u64, 34, layout.rect_y(&out[1]) == 100,
        layout.rect_y(&out[1]), 100)
    var n27: [u8; 34] = "12 and stretch makes it that wide "
    report((&n27[0]) as u64, 34, layout.rect_w(&out[1]) == 100,
        layout.rect_w(&out[1]), 100)
    var sr: flex.FlexBox = flex.flexbox_new(flex.FLEX_COLUMN_REVERSE)
    flex.flex_layout(&sr, layout.rect_new(0, 0, 100, 400),
        (&sp[0]) as *mut flex.FlexItem, 3, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n28: [u8; 34] = "12 column-reverse: 1st child at y "
    report((&n28[0]) as u64, 34, layout.rect_y(&out[0]) == 300,
        layout.rect_y(&out[0]), 300)
    var n29: [u8; 34] = "12 and the last one sits at y     "
    report((&n29[0]) as u64, 34, layout.rect_y(&out[2]) == 100,
        layout.rect_y(&out[2]), 100)

    // ============================================ 13. ROW REVERSED
    //
    // Three of 100 in 400, justify-content: start. With row-reverse
    // START IS RIGHT: 300 / 200 / 100 -- whoever only reverses the order
    // gets 0 / 100 / 200 and sticks to the wrong side.
    var rr: [flex.FlexItem; 3] = [flex.flex_item(100, 20); 3]
    var srr: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW_REVERSE)
    flex.flex_layout(&srr, layout.rect_new(0, 0, 400, 40),
        (&rr[0]) as *mut flex.FlexItem, 3, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n30: [u8; 34] = "13 row-reverse starts on the right"
    report((&n30[0]) as u64, 34, layout.rect_x(&out[0]) == 300,
        layout.rect_x(&out[0]), 300)
    var n31: [u8; 34] = "13 and runs leftwards to x        "
    report((&n31[0]) as u64, 34, layout.rect_x(&out[2]) == 100,
        layout.rect_x(&out[2]), 100)

    // =============================================== 14. THE BASELINE
    //
    // Three children with baselines 20 / 35 / 10. The deepest is 35,
    // so each child stands lower by (35 - its baseline):
    // y = 15 / 0 / 25 -- and y + baseline is 35 for all three.
    var bl: [flex.FlexItem; 3] = [flex.flex_item(100, 30); 3]
    bl[1] = flex.flex_item(100, 50)
    bl[2] = flex.flex_item(100, 40)
    flex.item_set_baseline(&bl[0], 20)
    flex.item_set_baseline(&bl[1], 35)
    flex.item_set_baseline(&bl[2], 10)
    var sb: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_align_items(&sb, flex.AL_BASELINE)
    flex.flex_layout(&sb, layout.rect_new(0, 0, 400, 100),
        (&bl[0]) as *mut flex.FlexItem, 3, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n32: [u8; 34] = "14 baseline drops the 1st child by"
    report((&n32[0]) as u64, 34, layout.rect_y(&out[0]) == 15,
        layout.rect_y(&out[0]), 15)
    var n33: [u8; 34] = "14 the tallest one stays on top   "
    report((&n33[0]) as u64, 34, layout.rect_y(&out[1]) == 0,
        layout.rect_y(&out[1]), 0)
    let g3: i64 = layout.rect_y(&out[2]) + 10
    var n34: [u8; 34] = "14 and all three lines meet at y  "
    report((&n34[0]) as u64, 34, g3 == 35, g3, 35)

    // ============================= 15. THE BRIDGE TO THE MEASURING PROTOCOL
    //
    // `render.pref_of` measures in f64. `flex_px` rounds UPWARDS, so that
    // half a pixel does not cut off the last letter,
    // and `flex_item_from_pref` lays basis and cross size the right way
    // round depending on the direction.
    var n35: [u8; 34] = "15 flex_px(12.0) stays            "
    report((&n35[0]) as u64, 34, flex.flex_px(12.0) == 12,
        flex.flex_px(12.0), 12)
    var n36: [u8; 34] = "15 flex_px(12.3) rounds up to     "
    report((&n36[0]) as u64, 34, flex.flex_px(12.3) == 13,
        flex.flex_px(12.3), 13)
    var n37: [u8; 34] = "15 flex_px(-3.0) is clamped to    "
    report((&n37[0]) as u64, 34, flex.flex_px(-3.0) == 0,
        flex.flex_px(-3.0), 0)
    var mi: flex.FlexItem = flex.flex_item_from_pref(80.5, 24.2, true)
    var n38: [u8; 34] = "15 a measured row child has basis "
    report((&n38[0]) as u64, 34, mi.basis == 81, mi.basis, 81)
    var n39: [u8; 34] = "15 its cross size is              "
    report((&n39[0]) as u64, 34, mi.cross == 25, mi.cross, 25)
    var n40: [u8; 34] = "15 and it will not shrink below   "
    report((&n40[0]) as u64, 34, mi.min_main == 81, mi.min_main, 81)
    var mj: flex.FlexItem = flex.flex_item_from_pref(80.5, 24.2, false)
    var n41: [u8; 34] = "15 in a column the basis is height"
    report((&n41[0]) as u64, 34, mj.basis == 25, mj.basis, 25)

    // ================================================= 16. THE MEASURING
    //
    // Three bases of 100, two gaps of 10, 8 margin left and right:
    // 300 + 20 + 16 = 336. Across: the largest child 20 plus 8 at the top and
    // 8 at the bottom = 36.
    var mm: [flex.FlexItem; 3] = [flex.flex_item(100, 20); 3]
    var sm: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_gap(&sm, 10, 10)
    flex.flex_set_padding(&sm, 8, 8, 8, 8)
    let mw: i64 = flex.flex_measure_main(&sm,
        (&mm[0]) as *mut flex.FlexItem, 3)
    var n42: [u8; 34] = "16 the row wants to be this wide  "
    report((&n42[0]) as u64, 34, mw == 336, mw, 336)
    let mh: i64 = flex.flex_measure_cross(&sm,
        (&mm[0]) as *mut flex.FlexItem, 3)
    var n43: [u8; 34] = "16 and this high                  "
    report((&n43[0]) as u64, 34, mh == 36, mh, 36)

    // ============ 17. SHRINKING WITH shrink 0.5 AND UNEQUAL BASIS
    //
    // Three children with basis 240 / 130 / 54, all with shrink 500
    // (= flex-shrink: 0.5), no gap, 384 space. By hand:
    //
    //   Bases together 424, so 40 are missing.
    //   Weights (shrink TIMES basis, in thousandths):
    //     120000 / 65000 / 27000, together 212000.
    //   Shares (integer, towards zero):
    //     -40*120000/212000 = -22.64 -> -22  ->  218
    //     -40* 65000/212000 = -12.26 -> -12  ->  118
    //     -40* 27000/212000 =  -5.09 ->  -5  ->   49
    //   Thereby -39 are assigned, ONE pixel is missing; it goes to
    //   the last movable child: 48.
    //   Together 218 + 118 + 48 = 384, so exactly the space.
    var s5: [flex.FlexItem; 3] = [flex.flex_item(100, 20); 3]
    flex.item_set_flex(&s5[0], 0, 500, 240)
    flex.item_set_flex(&s5[1], 0, 500, 130)
    flex.item_set_flex(&s5[2], 0, 500, 54)
    var sf5: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_layout(&sf5, layout.rect_new(0, 0, 384, 40),
        (&s5[0]) as *mut flex.FlexItem, 3, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n44: [u8; 40] = "17 shrink 0.5: the wide one becomes 218 "
    report((&n44[0]) as u64, 40, layout.rect_w(&out[0]) == 218,
        layout.rect_w(&out[0]), 218)
    var n45: [u8; 40] = "17 the middle one 118                   "
    report((&n45[0]) as u64, 40, layout.rect_w(&out[1]) == 118,
        layout.rect_w(&out[1]), 118)
    var n46: [u8; 40] = "17 the narrow one 48 (it keeps the rest)"
    report((&n46[0]) as u64, 40, layout.rect_w(&out[2]) == 48,
        layout.rect_w(&out[2]), 48)
    let e17: i64 = layout.rect_x(&out[2]) + layout.rect_w(&out[2])
    var n47: [u8; 40] = "17 and the row is full to the pixel     "
    report((&n47[0]) as u64, 40, e17 == 384, e17, 384)

    // =========== 18. SHRINKING WITH shrink 0.25 -- THE CASE AT WHICH
    //                 THE OLD CALCULATION WAS WRONG
    //
    // The same bases, but shrink 250, and 364 space. By hand:
    //
    //   60 are missing. Weights in thousandths:
    //     60000 / 32500 / 13500, together 106000.
    //     -60* 60000/106000 = -33.96 -> -33  ->  207
    //     -60* 32500/106000 = -18.39 -> -18  ->  112
    //     -60* 13500/106000 =  -7.64 ->  -7  ->   47
    //   Assigned -58, TWO pixels are missing, they go to the
    //   last movable child: 45. Together 207 + 112 + 45 = 364.
    //
    // WHY THIS CASE: until 20.09.2026 there stood in the weight a
    // division `shrink * basis / 1000`. It cut 32500 down to 32 and
    // 13500 to 13, and the distribution thereby fell to
    // 206 / 112 / 46 -- the narrowest child kept a pixel
    // that it should have given up, and the widest gave one too
    // many. A child with shrink 250 and basis 3 even had the
    // weight 0 and did not shrink at all any more.
    var s6: [flex.FlexItem; 3] = [flex.flex_item(100, 20); 3]
    flex.item_set_flex(&s6[0], 0, 250, 240)
    flex.item_set_flex(&s6[1], 0, 250, 130)
    flex.item_set_flex(&s6[2], 0, 250, 54)
    flex.flex_layout(&sf5, layout.rect_new(0, 0, 364, 40),
        (&s6[0]) as *mut flex.FlexItem, 3, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n48: [u8; 40] = "18 shrink 0.25: the wide one becomes 207"
    report((&n48[0]) as u64, 40, layout.rect_w(&out[0]) == 207,
        layout.rect_w(&out[0]), 207)
    var n49: [u8; 40] = "18 the middle one 112                   "
    report((&n49[0]) as u64, 40, layout.rect_w(&out[1]) == 112,
        layout.rect_w(&out[1]), 112)
    var n50: [u8; 40] = "18 the narrow one 45, not 46            "
    report((&n50[0]) as u64, 40, layout.rect_w(&out[2]) == 45,
        layout.rect_w(&out[2]), 45)
    let e18: i64 = layout.rect_x(&out[2]) + layout.rect_w(&out[2])
    var n51: [u8; 40] = "18 and the row is full to the pixel     "
    report((&n51[0]) as u64, 40, e18 == 364, e18, 364)

    // And the limit that makes the error visible at all: a
    // child with shrink 250 and basis 3 has a weight greater than zero.
    // 105 basis into 55 space, weights 1250 / 25000, together 26250:
    //   -50* 1250/26250 = -2.38 -> -2 ->  3
    //   -50*25000/26250 = -47.6 -> -47 -> 53, of which the one missing
    //   pixel is subtracted: 52. Together 55.
    var s7: [flex.FlexItem; 2] = [flex.flex_item(100, 20); 2]
    flex.item_set_flex(&s7[0], 0, 250, 5)
    flex.item_set_flex(&s7[1], 0, 250, 100)
    flex.flex_layout(&sf5, layout.rect_new(0, 0, 55, 40),
        (&s7[0]) as *mut flex.FlexItem, 2, (&out[0]) as *mut layout.Rect,
        (&gr[0]) as *mut i64, (&fz[0]) as *mut i64)
    var n52: [u8; 40] = "18 a 5 px child does shrink, to 3       "
    report((&n52[0]) as u64, 40, layout.rect_w(&out[0]) == 3,
        layout.rect_w(&out[0]), 3)
    var n53: [u8; 40] = "18 and its neighbour keeps 52           "
    report((&n53[0]) as u64, 40, layout.rect_w(&out[1]) == 52,
        layout.rect_w(&out[1]), 52)

    var t: rt.Buf = rt.buf_new()
    rt.buf_push(&t, 10 as u8)
    if G_ERRORS > 0 {
        var f: [u8; 22] = "FLEX IS NOT IN ORDER.\n"
        rt.buf_push_bytes(&t, (&f[0]) as u64, 22)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
        return 1
    }
    var o: [u8; 13] = "FLEX PASSED.\n"
    rt.buf_push_bytes(&t, (&o[0]) as u64, 13)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 0
}
