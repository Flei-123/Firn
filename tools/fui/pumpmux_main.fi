// SPDX-License-Identifier: MPL-2.0
import std.rt
import fui.pumpmux

static mut BAD: usize = 0
static mut STEPS_A: u64 = 0
static mut STEPS_B: u64 = 0

const FD_A: i32 = 7
const FD_B: i32 = 9
const MS_A: i64 = 50
const POLL_CAP: i64 = 10

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }

fn check(ok: bool, what: str) {
    if ok { say("  ok    ") } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn fd_a(ud: u64) -> i32 { return FD_A }
fn fd_b(ud: u64) -> i32 { return FD_B }
fn fd_none(ud: u64) -> i32 { return 0 - 1 }
fn ms_pass(ud: u64, wanted: i64) -> i64 { return wanted }
fn ms_cap(ud: u64, wanted: i64) -> i64 { return MS_A }
fn step_a(ud: u64) -> bool {
    STEPS_A = STEPS_A + 1
    return true
}
fn step_b(ud: u64) -> bool {
    STEPS_B = STEPS_B + 1
    return false
}

fn main() -> i32 {
    var one: pumpmux.PumpMux = pumpmux.mux_blank()
    check(pumpmux.mux_count(&one) == 0, "blank mux is empty")
    check(pumpmux.mux_fd((&one) as u64) == 0 - 1, "empty mux watches nothing")
    pumpmux.mux_add(&one, 0 as u64, fd_a, ms_pass, step_a)
    check(pumpmux.mux_fd((&one) as u64) == FD_A, "one pump: its descriptor")
    check(pumpmux.mux_ms((&one) as u64, 0 - 1) == 0 - 1, "one pump: no timer, unbounded wait")
    var two: pumpmux.PumpMux = pumpmux.mux_blank()
    pumpmux.mux_add(&two, 0 as u64, fd_a, ms_cap, step_a)
    pumpmux.mux_add(&two, 0 as u64, fd_b, ms_pass, step_b)
    check(pumpmux.mux_count(&two) == 2, "two pumps counted")
    check(pumpmux.mux_fd((&two) as u64) == FD_B, "two pumps: one descriptor is watched")
    check(pumpmux.mux_ms((&two) as u64, 1000) == POLL_CAP, "two descriptors: polled every 10 ms")
    check(pumpmux.mux_ms((&two) as u64, 0 - 1) == POLL_CAP, "two descriptors: never an unbounded wait")
    check(pumpmux.mux_step((&two) as u64), "step reports work of any pump")
    check(STEPS_A == 1 && STEPS_B == 1, "every pump is stepped once")
    var timers: pumpmux.PumpMux = pumpmux.mux_blank()
    pumpmux.mux_add(&timers, 0 as u64, fd_none, ms_cap, step_b)
    pumpmux.mux_add(&timers, 0 as u64, fd_none, ms_pass, step_b)
    check(pumpmux.mux_fd((&timers) as u64) == 0 - 1, "no descriptor: none")
    check(pumpmux.mux_ms((&timers) as u64, 1000) == MS_A, "timer bounds the sleep")
    check(pumpmux.mux_ms((&timers) as u64, 20) == 20, "smaller host wait wins")
    if BAD != 0 { return 1 }
    say("pumpmux OK\n")
    return 0
}
