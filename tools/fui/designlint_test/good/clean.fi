import fui.app

fn build(a: *mut app.App) {
    app.label(a, "Settings")
    app.button(a, "Save", on_save)
    app.button(a, "Show files", on_files)
    app.button(a, "Import", on_import)
    app.button(a, "Next", on_next)
    iconbtn.draw(c, lucide.ARROW_LEFT, "Back")
    ds_iconbtn.icon_button(a, lucide.CHEVRON_RIGHT, "Forward", on_fwd)
    appctl.toggle(a, "Wi-Fi", on_wifi)
    app.label(a, "Network")
    app.label(a, "3 items")
    app.label(a, "1240x720")
    let n: kit.NavItem = kit.NavItem { icon: lucide.HOUSE, label: "Home", badge: 0, header: false }
    kit.draw_icon(c, 0, 0, lucide.STAR)
    kit.draw_label(c, 0, 0, "Overview of the last 7 days")
}
