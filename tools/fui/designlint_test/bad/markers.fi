fn build(a: *mut App) {
    app.button(a, "<", on_prev)
    // designlint: ignore NAV_TEXT_BUTTON
    app.button(a, ">", on_next)
    app.button(a, "Back", on_back) // designlint: ignore NAV_TEXT_BUTTON
    app.button(a, "Up", on_up) // designlint: ignore PAGING
    app.button(a, "Hoch", on_up) // designlint: ignore
}
