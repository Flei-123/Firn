fn build(a: *mut App) {
    app.label(a, "Colour #ff8800")
    app.label(a, "id=42")
    kit.draw_label(c, 0, 0, "Pointer 0x7ffd1234")
    app.label(a, kitfmt.join("size ", "12px"))
    app.label(a, debug_line)
    app.label(a, to_hex(value))
    app.label(a, "debug mode")
    app.label(a, "r=3 w=4")
    app.label(a, "Plain text")
    app.label(a, "settings.debug.fps")
    var c: u32 = kitchat.hex_color("#336699")
}
