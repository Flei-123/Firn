fn wifi(a: *mut App) {
    appctl.toggle(a, "Wi-Fi", on_wifi)
    app.label(a, "On")
}

fn status(a: *mut App) {
    app.label(a, "Connected")
    app.button(a, "Disconnected", on_toggle)
}

fn expr(a: *mut App) {
    app.label(a, status_text)
    app.label(a, status_text)
}

fn branched(a: *mut App) {
    if x {
        app.label(a, status_text)
        return
    }
    app.label(a, status_text)
}

fn fine(a: *mut App) {
    appctl.toggle(a, "Wi-Fi", on_wifi)
    app.label(a, "Network")
}
