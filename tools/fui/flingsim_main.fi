// SPDX-License-Identifier: MPL-2.0
// tools/fui/flingsim_main.fi -- a64: the android fling curve (OverScroller spline) in fUi's viewport against the reference numbers of
// android.widget.OverScroller on a 440 ppi screen (distance and duration of a fling of v px/s; reference computed by the Python port
// of SplineOverScroller in tmp/a64/scroll/ref.py). A simulated clock ticks a tall viewport every 8 ms; the run-out must end at the
// reference distance (+-1.5 %) after the reference duration (+-40 ms), start at the finger speed, and carry on over a viewport_shift.
import std.rt
import fui.viewport

static mut G_BAD: usize = 0

fn put(b: *mut rt.Buf, s: str) { rt.buf_push_bytes(b, s.p as u64, s.n) }

fn check(b: *mut rt.Buf, name: str, got: i64, want: i64, tol: i64) {
    var d: i64 = got - want
    if d < 0 { d = 0 - d }
    put(b, "  ")
    put(b, name)
    put(b, ": got ")
    rt.buf_push_dec_i64(b, got)
    put(b, " want ")
    rt.buf_push_dec_i64(b, want)
    if d <= tol { put(b, "  OK\n") } else { put(b, "  FAIL\n"); G_BAD = G_BAD + 1 }
}

// fling of `v` px/s upwards-scrolling (content moves: offset grows); returns the end distance, writes the end time
fn run(v: f64, end_ms: *mut i64, first_px: *mut f64) -> f64 {
    var vp: viewport.Viewport = viewport.viewport_new(0.0, 0.0, 400.0, 800.0, 400.0, 10000000.0)
    viewport.viewport_set_offset(&vp, 0.0, 100000.0)
    viewport.viewport_fling_android(&vp, 0.0, v / 1000.0, 0 as i64, 440.0)
    var t: i64 = 0
    var last: f64 = 100000.0
    *end_ms = 0
    *first_px = 0.0
    while t < 6000 {
        t = t + 8
        let moved: bool = viewport.viewport_tick(&vp, t)
        let o: f64 = viewport.viewport_off_y(&vp)
        if t == 8 { *first_px = o - 100000.0 }
        if o != last { *end_ms = t }
        last = o
        if !viewport.viewport_moving(&vp) { return o - 100000.0 }
    }
    return last - 100000.0
}

fn main(start: u64) -> i32 {
    var b: rt.Buf = rt.buf_new()
    put(&b, "fling sim (440 ppi): distance px / duration ms vs android OverScroller\n")
    var end: i64 = 0
    var f8: f64 = 0.0
    var d: f64 = run(2000.0, &end, &f8)
    check(&b, "2000 px/s distance", d as i64, 307, 5)
    check(&b, "2000 px/s duration", end, 439, 40)
    check(&b, "2000 px/s first 8 ms (v*dt=16)", f8 as i64, 16, 2)
    d = run(6000.0, &end, &f8)
    check(&b, "6000 px/s distance", d as i64, 2071, 31)
    check(&b, "6000 px/s duration", end, 986, 40)
    check(&b, "6000 px/s first 8 ms (v*dt=48)", f8 as i64, 48, 4)
    d = run(12000.0, &end, &f8)
    check(&b, "12000 px/s distance", d as i64, 6899, 104)
    check(&b, "12000 px/s duration", end, 1643, 40)
    d = run(22000.0, &end, &f8)
    check(&b, "22000 px/s distance", d as i64, 19762, 297)
    check(&b, "22000 px/s duration", end, 2567, 40)
    // a shift in the middle (older text put in front) must not stop or bend the run-out
    var vp: viewport.Viewport = viewport.viewport_new(0.0, 0.0, 400.0, 800.0, 400.0, 10000000.0)
    viewport.viewport_set_offset(&vp, 0.0, 100000.0)
    viewport.viewport_fling_android(&vp, 0.0, 6.0, 0 as i64, 440.0)
    var t: i64 = 0
    while t < 400 { t = t + 8; let m: bool = viewport.viewport_tick(&vp, t) }
    viewport.viewport_shift(&vp, 5000.0)
    while viewport.viewport_moving(&vp) && t < 6000 { t = t + 8; let m: bool = viewport.viewport_tick(&vp, t) }
    check(&b, "6000 px/s with a +5000 shift: distance incl. shift", (viewport.viewport_off_y(&vp) - 100000.0) as i64, 2071 + 5000, 31)
    if G_BAD > 0 { put(&b, "FLINGSIM FAILED.\n") } else { put(&b, "FLINGSIM PASSED.\n") }
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    if G_BAD > 0 { return 1 }
    return 0
}
