// SPDX-License-Identifier: MPL-2.0
// tools/fui/transgc_main.fi -- ORPHANED TRANSITION ENTRIES ARE GIVEN BACK
// (roadmap r115, a note on r110).
//
// The registry of lib/fui/anim.fi holds 32 entries. A widget WITHOUT a key
// is found by its address; a rebuild that puts it elsewhere leaves its old
// entry behind, and after 32 such rebuilds no widget got an entry any
// more (every hover jumped). Now an entry nobody has asked for during
// STALE_MS (2 s) may be taken over by a newcomer when the registry is full.
//
//   1. 32 widgets fill the registry (slots 0..31);
//   2. a 33rd right after is refused (TRANS_MAX): nothing is stale yet --
//      the COUNTER-CHECK, a registry that always evicts would break the
//      32 live widgets;
//   3. five seconds later ten of the widgets are asked for again (they are
//      alive), and a newcomer arrives: it gets a slot among the 22 that
//      were not asked for, and the ten live ones keep THEIR slots;
//   4. the evicted slot starts on the newcomer's true values.
import std.rt
import fui.theme
import fui.widget
import fui.painter
import fui.render
import fui.anim

static mut G_ERRORS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(name: str, ok: bool, got: i64, want: i64) {
    say("  ")
    say(name)
    var k: usize = name.n
    while k < 66 {
        say(" ")
        k = k + 1
    }
    var t: rt.Buf = rt.buf_new()
    if ok {
        rt.buf_push_bytes(&t, "OK    ".p as u64, 6)
    } else {
        rt.buf_push_bytes(&t, "WRONG ".p as u64, 6)
        G_ERRORS = G_ERRORS + 1
    }
    rt.buf_push_dec_i64(&t, got)
    rt.buf_push_bytes(&t, " / ".p as u64, 3)
    rt.buf_push_dec_i64(&t, want)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn main(start: u64) -> i32 {
    var m: theme.Theme = theme.theme_new(true)
    var z: painter.Painter = painter.painter_new()
    var c: render.Ctx = render.ctx_new(&m, &z)
    var reg: anim.TransReg = anim.transreg_new()
    var ws: [widget.Widget; 40] = [widget.widget_new(widget.KIND_BUTTON); 40]
    var i: usize = 0
    var wrong: i64 = 0
    while i < 32 {
        if anim.transreg_index(&reg, &c, &ws[i], 0) != i {
            wrong = wrong + 1
        }
        i = i + 1
    }
    check("1 32 widgets take slots 0..31 in order", wrong == 0, wrong, 0)
    check("1 the registry is full", anim.transreg_count(&reg) == 32, anim.transreg_count(&reg) as i64, 32)
    let early: usize = anim.transreg_index(&reg, &c, &ws[32], 100)
    check("2 a newcomer 100 ms later is refused (nothing is stale)", early == anim.TRANS_MAX, early as i64, anim.TRANS_MAX as i64)
    i = 0
    wrong = 0
    while i < 10 {
        if anim.transreg_index(&reg, &c, &ws[i], 5000) != i {
            wrong = wrong + 1
        }
        i = i + 1
    }
    check("3 ten live widgets asked again at 5 s keep their slots", wrong == 0, wrong, 0)
    let late: usize = anim.transreg_index(&reg, &c, &ws[32], 5000)
    check("3 a newcomer at 5 s gets a slot of an orphan (10..31)", late >= 10 && late < 32, late as i64, 10)
    check("3 ... and the registry is still 32 entries", anim.transreg_count(&reg) == 32, anim.transreg_count(&reg) as i64, 32)
    check("3 ... it is found again at the same slot", anim.transreg_find(&reg, &ws[32]) == late, anim.transreg_find(&reg, &ws[32]) as i64, late as i64)
    check("3 ... and the evicted widget is gone", anim.transreg_find(&reg, &ws[late]) == anim.TRANS_MAX, anim.transreg_find(&reg, &ws[late]) as i64, anim.TRANS_MAX as i64)
    wrong = 0
    i = 0
    while i < 10 {
        if anim.transreg_find(&reg, &ws[i]) != i {
            wrong = wrong + 1
        }
        i = i + 1
    }
    check("3 the ten live ones are untouched", wrong == 0, wrong, 0)
    // a second newcomer in the same frame takes ANOTHER orphan
    let late2: usize = anim.transreg_index(&reg, &c, &ws[33], 5000)
    check("4 a second newcomer takes another orphan slot", late2 >= 10 && late2 < 32 && late2 != late, late2 as i64, late as i64)
    // if EVERY slot was asked for at this very time, a newcomer is refused
    i = 0
    while i < 32 {
        let key: usize = anim.transreg_index(&reg, &c, &ws[i], 9000)
        i = i + 1
    }
    let busy: usize = anim.transreg_index(&reg, &c, &ws[35], 9100)
    check("5 counter-check: 32 live entries (all asked at 9 s): refused", busy == anim.TRANS_MAX, busy as i64, anim.TRANS_MAX as i64)
    if G_ERRORS != 0 {
        say("TRANSGC FAILED\n")
        return 1
    }
    say("TRANSGC PASSED\n")
    return 0
}
