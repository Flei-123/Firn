// SPDX-License-Identifier: MPL-2.0
// tools/fui/gallery5_main.fi -- TIME AS A PICTURE.
//
// A movement can be shown on a still image in only one way:
// as a PHASE ROW. Every row is an easing, every column a point
// in time; the tile wanders to the right and changes its colour in doing so. That the rows look
// DIFFERENT -- the linear one even, ease-in-out pushed together at the
// ends, the spring beyond the target -- is the proof that the curves really
// calculate differently.
//
// The LOWER HALF is the actual proof for `transition`: there
// stand REAL buttons (widget.Widget, painted by render.draw_button)
// in the intermediate states of the changes normal -> hover, normal ->
// pressed, normal -> focus and of a fade. Every tile is
// the same button, only read off at a different point in time of the transition:
// the colour wanders, the corner becomes rounder or tighter, the
// border grows, the tile rises or sinks, the opacity
// falls. Whoever looks only at the first and the last column sees the
// two states that exist today already; the seven in between
// are what this round added.
//
//     gallery5_main <out.png> [light|dark] [<font.ttf>]
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.anim

const FONTSET_BYTES: usize = 4096
const W: usize = 1240
const H: usize = 764
const PHASES: usize = 9

// The dimensions of the lower half. Nine columns of 100 points with 11
// points of distance begin at 236 and end at 1224 -- 16 points before
// the right edge, so that nothing bumps.
const KX: f64 = 236.0
const KS: f64 = 111.0
const KW: f64 = 100.0
const KH: f64 = 36.0
const UEB_MS: i64 = 400
// The mark of a phase: 14 points wide, and each phase stands 2.5
// points lower than the previous one. Both numbers stand exactly like this in
// tools/fui/anim_main.fi section 13, which re-calculates the positions.
//
// 20.09.2026 -- WHY THE TRACK IS LONGER AND THE MARK NARROWER.
// What is demanded is no longer merely that two phases do not
// touch (one mark width of distance), but that between them
// VISIBLE BACKGROUND stays standing: MARKE_W + 6. With the spring the
// two narrowest phases lie 2.26 % of the track apart; with the
// old track (940 points, mark 18) that was 20.2 points and thereby
// only 2 points of background. The track therefore now begins at 150 instead of 260
// (the row label needs no 236 points) and is 1066
// instead of 940 points long, the mark is 14 instead of 18 points wide: from
// 20.2 become 23.2 points of distance at a mark of 14 points -- 9 points
// of background between the two narrowest marks of the whole page.
const MARK_W: f64 = 14.0
const STAGE: f64 = 2.5
const BAHN_X: f64 = 150.0
const BAHN_W: f64 = 1066.0

// THE WIDEST OVERHANG OF THE WHOLE PAGE, IN POINTS.
//
// Every label of this proof goes through `label`, and `label` measures
// it by THE SAME way that the layout takes (`render.pref_of`), against
// the field into which it is painted. If at the end a positive
// number stands here, then a text has needed more room than its band gives --
// and then the image is NOT written. Exactly this kind of error
// made "red fixe" out of "red fixed": nobody calculated the target width
// against the field, and in the picture it looked like a word.
static mut G_UEBERHANG: f64 = -100000.0

// A label, and what comes back is the TARGET WIDTH in points (what the
// text really needs at this size). The overhang against the
// field is carried along in G_UEBERHANG, so that `main` can re-calculate
// ONE number at the end instead of at thirty places.
fn label(c: *mut render.Ctx, x: f64, y: f64, w: f64, px: usize, p: u64,
    n: usize, tok: u32) -> f64 {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, w, 18.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(tok))
    *s = style.style_set_font(*s, 0, px)
    *s = style.style_set_pad(*s, 0, 0)
    var pw: f64 = 0.0
    var ph: f64 = 0.0
    render.pref_of(c, &e, &pw, &ph)
    if pw - w > G_UEBERHANG {
        G_UEBERHANG = pw - w
    }
    render.draw_label(c, &e)
    return pw
}

// The smaller of two distances -- the narrowest place of the page
// arises from six rows, and it is demanded for each.
fn enger(a: f64, b: f64) -> f64 {
    if b < a {
        return b
    }
    return a
}

// A row: the same animation, read off at nine points in time.
//
// WHAT COMES BACK IS THE SMALLEST DISTANCE THAT THIS ROW REALLY PAINTED
// (in points, phases at the same value do not count). Not
// the calculated one, but the PAINTED one: `main` thereby checks that
// between every two marks visible background stays standing, and aborts
// otherwise with an error -- exactly as demos/fuidemo/main.fi does that with
// its phases. A proof on which two phases merge into one block
// claims nine and shows eight.
fn row(c: *mut render.Ctx, m: *mut theme.Theme, y: f64, e: anim.Easing,
    nm: u64, nn: usize) -> f64 {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let f: *mut theme.Colors = theme.theme_colors(m)
    label(c, 24.0, y, 120.0, 12, nm, nn, style.TOK_TEXT)
    var a: anim.Animation = anim.anim_new(0, 1000, 0.0, 1.0, e)
    let bahn_x: f64 = BAHN_X
    let bahn_w: f64 = BAHN_W
    // The track, so that the way is visible and not only the tiles.
    painter.round_rect(z, bahn_x, y + 22.0, bahn_w, 2.0, 1.0,
        theme.opaque((*f).separator))
    // FIRST READ, THEN DRAW. A spring shoots beyond 1,
    // and formerly this overshoot was CUT OFF at 1.12 --
    // three phases thereby landed on the same point and lay on top of each other
    // in the picture, so the row proved exactly what it was
    // meant to show not. Now first the whole value range of the
    // row is determined and the track scaled afterwards: the overshoot
    // stays visible, and every phase gets its own position.
    // This is re-calculated in tools/fui/anim_main.fi section 8 --
    // there stands the same calculation and demands that the nine positions
    // lie pairwise at least one mark width apart.
    var lo: f64 = 0.0
    var hi: f64 = 1.0
    var k: usize = 0
    while k < PHASES {
        let vk: f64 = anim.anim_value(&a, ((k * 1000) / (PHASES - 1)) as i64)
        if vk < lo {
            lo = vk
        }
        if vk > hi {
            hi = vk
        }
        k = k + 1
    }
    let span: f64 = hi - lo
    // The positions and the values of the nine phases, as they are about to be
    // painted -- from THESE numbers the smallest distance is determined
    // below, not from a second calculation next to it.
    var lage: [f64; 9] = [0.0; 9]
    var value: [f64; 9] = [0.0; 9]
    var i: usize = 0
    while i < PHASES {
        let t: i64 = ((i * 1000) / (PHASES - 1)) as i64
        let v: f64 = anim.anim_value(&a, t)
        let anteil: f64 = (v - lo) / span
        let kx: f64 = bahn_x + 12.0 + anteil * (bahn_w - MARK_W - 24.0)
        lage[i] = kx
        value[i] = v
        // And in addition each phase stands one step lower than the
        // previous one. With `steps(5)` two phases fall onto the same value
        // -- that is the statement of a staircase and must not be
        // calculated away; both stay visible nevertheless, because
        // they differ in height.
        let ky: f64 = y + 4.0 + (i as f64) * STAGE
        let col: u32 = anim.mix_oklab(theme.opaque((*f).button),
            theme.opaque((*f).accent), (i as f64) / ((PHASES - 1) as f64))
        // The later phases cover more strongly: the row reads
        // from left to right like a movement.
        let al: f64 = 0.25 + 0.75 * ((i as f64) / ((PHASES - 1) as f64))
        let a8: u32 = ((al * 255.0) as i64) as u32
        painter.round_rect(z, kx, ky, MARK_W, 26.0, 6.0,
            (a8 << 24) | (col & 16777215 as u32))
        i = i + 1
    }
    // The smallest distance of ANY TWO marks of this row. Two
    // phases at the same value rightly stand at the same place -- that
    // is the statement of a staircase (`steps(5)` stands still three times),
    // and they stay visible, because each phase stands one step lower
    // than the previous one.
    var small: f64 = 100000.0
    var p: usize = 0
    while p < PHASES {
        var q: usize = p + 1
        while q < PHASES {
            if value[p] != value[q] {
                var d: f64 = lage[q] - lage[p]
                if d < 0.0 {
                    d = 0.0 - d
                }
                if d < small {
                    small = d
                }
            }
            q = q + 1
        }
        p = p + 1
    }
    return small
}

// A ROW OF REAL BUTTONS THROUGH A STATE CHANGE.
//
// `ziel` is the state that is being run towards. For hover and
// pressed the state bits are set on the widget, and the transition
// fetches its target values itself (`anim.trans_from_widget`) -- that
// is the way that an application goes. For the focus the bits stay off
// and the target values are fetched individually: otherwise
// `render.draw_focus_ring` would paint the finished ring into EVERY phase, and
// the soft run-up of the border would no longer be visible.
fn uebergang(c: *mut render.Ctx, m: *mut theme.Theme, y: f64, nm: u64,
    nn: usize, target: u32) -> usize {
    label(c, 24.0, y + 9.0, 200.0, 12, nm, nn, style.TOK_TEXT)
    var e: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    var bt: [u8; 6] = "Button"
    widget.w_set_text(&e, (&bt[0]) as u64, 6)
    widget.w_place(&e, KX, y, KW, KH)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_font(*s, 0, 13)
    if target == style.STATE_FOCUS {
        // The border is zero points wide at rest; it becomes visible
        // only by the transition pulling it to focus_w.
        // The colour for it is the accent -- the same as that of the ring.
        *s = style.style_set_border(*s, style.color_token(style.TOK_ACCENT), 0)
    }
    var tr: anim.Transition = anim.trans_new(
        anim.widget_target_bg(c, &e, style.STATE_NORMAL),
        anim.widget_target_radius(c, &e, style.STATE_NORMAL),
        anim.widget_target_border(c, &e, style.STATE_NORMAL), 1.0)
    anim.trans_set_duration(&tr, UEB_MS)
    anim.trans_set_easing(&tr, anim.easing_named(anim.EASE_OUT))
    if target == style.STATE_HOVER {
        widget.w_set_hover(&e, true)
        anim.trans_from_widget(&tr, c, &e, 0)
    } else if target == style.STATE_ACTIVE {
        widget.w_set_active(&e, true)
        anim.trans_from_widget(&tr, c, &e, 0)
    } else {
        anim.trans_to_state(&tr, 0, target,
            anim.widget_target_bg(c, &e, target),
            anim.widget_target_radius(c, &e, target),
            anim.widget_target_border(c, &e, target),
            anim.widget_target_alpha(c, &e, target),
            anim.state_dx(target), anim.state_dy(target))
    }
    var i: usize = 0
    while i < PHASES {
        let t: i64 = ((i as i64) * UEB_MS) / ((PHASES - 1) as i64)
        anim.trans_tick(&tr, t)
        anim.trans_apply(&tr, &e)
        anim.trans_place(&tr, &e, KX + (i as f64) * KS, y, KW, KH)
        render.draw_button(c, &e)
        i = i + 1
    }
    // The ONE that this row contributes to the header row: the number in the
    // title is ADDED and not claimed.
    return 1
}

// THE FADE. Colour AND opacity at once, and the colour runs in
// OKLab -- from the accent to the success colour, so right across the colour wheel.
// In sRGB this path would go through a dead grey; here every
// intermediate step stays colourful.
//
// The opacity is CHARGED against the background, because `render` paints a
// surface opaque: `anim.mix_srgb(background, colour, opacity)` is
// exactly what an alpha job on this single-colour background
// yields -- the same calculation, only one step earlier.
fn verblassen(c: *mut render.Ctx, m: *mut theme.Theme, y: f64, nm: u64,
    nn: usize) -> usize {
    label(c, 24.0, y + 9.0, 200.0, 12, nm, nn, style.TOK_TEXT)
    let f: *mut theme.Colors = theme.theme_colors(m)
    let basic: u32 = theme.opaque((*f).base)
    var e: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&e, KX, y, KW, KH)
    var tr: anim.Transition = anim.trans_new(theme.opaque((*f).accent),
        10.0, 0.0, 1.0)
    anim.trans_set_duration(&tr, UEB_MS)
    anim.trans_set_easing(&tr, anim.easing_linear())
    anim.trans_set_oklab(&tr, true)
    anim.trans_to_state(&tr, 0, style.STATE_NORMAL,
        theme.opaque((*f).success), 18.0, 0.0, 0.35, 0.0, 0.0)
    var i: usize = 0
    while i < PHASES {
        let t: i64 = ((i as i64) * UEB_MS) / ((PHASES - 1) as i64)
        anim.trans_tick(&tr, t)
        anim.trans_apply(&tr, &e)
        let s: *mut style.Style = widget.w_style(&e)
        *s = style.style_set_bg(*s, style.color_literal(
                anim.mix_srgb(basic, anim.trans_color(&tr),
                    anim.trans_alpha(&tr)) & 16777215 as u32))
        anim.trans_place(&tr, &e, KX + (i as f64) * KS, y, KW, KH)
        render.draw_button(c, &e)
        i = i + 1
    }
    return 1
}

// ============ THE GRID IS RE-CALCULATED (like gallery7/gallery8)
//
// The proof check from outside sees only THAT colour stands somewhere.
// Whether a label really stands in ITS row or has slipped into the band
// above it is known only by this program.
static mut G_ERROR: usize = 0

fn verlange(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 44 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "FALSCH  "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERROR = G_ERROR + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    var w: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&w[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// How many pixels in y0..y1 differ from the background.
fn band_has_color(cv: *mut canvas.Canvas, y0: usize, y1: usize,
    bg: u32) -> i64 {
    let w: usize = canvas.canvas_width(cv)
    var n: i64 = 0
    var y: usize = y0
    while y <= y1 && y < canvas.canvas_height(cv) {
        var x: usize = 0
        while x < w {
            if canvas.canvas_get(cv, x, y) != bg {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 47] = "gallery5_main <out.png> [light|dark] [font.ttf]"
        rt.write_everything(2, (&u[0]) as u64, 47)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    var dark: bool = true
    if rt.arg_count(start) >= 3 {
        if rt.ld8(rt.arg_ptr(start, 2), 0) == 108 as u8 {
            dark = false
        }
    }
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
    rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    // NO FONT, NO PROOF. A picture without a single
    // letter looks like a picture from afar, and that is exactly how
    // a text-less surface got through the acceptance in OrientOS. A proof without a label proves nothing -- so
    // an error on fd 2 and a return value on which the run
    // gets stuck, instead of writing a silent PNG.
    if fm == 0 {
        var ks: [u8; 60] = "gallery5: keine Schrift gefunden -- ohne Schrift kein Beleg\n"
        rt.write_everything(2, (&ks[0]) as u64, 60)
        return 9
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 300) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(dark)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque((*f).base))

    // The four header rows stand at the END of this function: they name
    // how many curves and how many state changes the sheet shows,
    // and these numbers arise only while painting.
    var kurven: usize = 0
    var wechsel: usize = 0

    var y: f64 = 90.0
    // THE NARROWEST PLACE OF THE WHOLE PAGE. Every row reports how close
    // its two densest marks have come; demanded is
    // MARKE_W + 2, so the width of a mark PLUS two points of background
    // in between. The narrowest places are the spring (it turns round and
    // lays two phases close side by side) and the run-out of
    // ease-out. Calculation is done with the PAINTED positions, and a proof
    // that violates the condition is not written.
    var eng: f64 = 100000.0
    var l1: [u8; 6] = "linear"
    eng = enger(eng, row(&c, &m, y, anim.easing_linear(),
            (&l1[0]) as u64, 6))
    kurven = kurven + 1
    y = y + 66.0
    var l2: [u8; 7] = "ease-in"
    eng = enger(eng, row(&c, &m, y, anim.easing_named(anim.EASE_IN),
            (&l2[0]) as u64, 7))
    kurven = kurven + 1
    y = y + 66.0
    var l3: [u8; 8] = "ease-out"
    eng = enger(eng, row(&c, &m, y, anim.easing_named(anim.EASE_OUT),
            (&l3[0]) as u64, 8))
    kurven = kurven + 1
    y = y + 66.0
    var l4: [u8; 11] = "ease-in-out"
    eng = enger(eng, row(&c, &m, y, anim.easing_named(anim.EASE_IN_OUT),
            (&l4[0]) as u64, 11))
    kurven = kurven + 1
    y = y + 66.0
    var l5: [u8; 8] = "steps(5)"
    eng = enger(eng, row(&c, &m, y, anim.easing_steps(5),
            (&l5[0]) as u64, 8))
    kurven = kurven + 1
    y = y + 66.0
    var l6: [u8; 18] = "spring(1, 30, 4.5)"
    eng = enger(eng, row(&c, &m, y, anim.easing_spring(1.0, 30.0, 4.5),
            (&l6[0]) as u64, 18))
    kurven = kurven + 1
    if eng < MARK_W + 2.0 {
        var pm: [u8; 57] = "gallery5: zwei Phasenmarken stehen zu dicht beieinander.\n"
        rt.write_everything(2, (&pm[0]) as u64, 57)
        return 8
    }

    // ============================ DIE ZUSTANDSWECHSEL AM ECHTEN WIDGET
    var u1: [u8; 25] = "normal -> hover (rises 1)"
    wechsel = wechsel + uebergang(&c, &m, 540.0, (&u1[0]) as u64, 25,
        style.STATE_HOVER)
    var u2: [u8; 27] = "normal -> pressed (sinks 1)"
    wechsel = wechsel + uebergang(&c, &m, 596.0, (&u2[0]) as u64, 27,
        style.STATE_ACTIVE)
    var u3: [u8; 26] = "normal -> focus (border 2)"
    wechsel = wechsel + uebergang(&c, &m, 652.0, (&u3[0]) as u64, 26,
        style.STATE_FOCUS)
    var u4: [u8; 24] = "OKLab blue->green, a .35"
    wechsel = wechsel + verblassen(&c, &m, 708.0, (&u4[0]) as u64, 24)

    // ========================================== NOW THE HEADER ROWS
    //
    // EVERY ROW A WHOLE SENTENCE. Formerly a single sentence ran over
    // title and subline ("ANIMATION -- the same tween, six" /
    // "curves, nine phases each"), and whoever read only the bold line
    // got a torn-off piece of language. Now the title carries
    // the subject, the grey line the measuring set-up -- and both
    // name the numbers that were really painted above.
    var h1: rt.Buf = rt.buf_new()
    var h1a: [u8; 13] = "ANIMATION -- "
    var h1b: [u8; 15] = " easing curves."
    rt.buf_push_bytes(&h1, (&h1a[0]) as u64, 13)
    rt.buf_push_dec_u64(&h1, kurven as u64)
    rt.buf_push_bytes(&h1, (&h1b[0]) as u64, 15)
    let w1: f64 = label(&c, 24.0, 22.0, 900.0, 15, rt.buf_ptr(&h1),
        rt.buf_len(&h1), style.TOK_TEXT)
    rt.buf_free(&h1)

    var h2: rt.Buf = rt.buf_new()
    var h2a: [u8; 46] = "The same tween runs through each, read off at "
    var h2b: [u8; 39] = " phases from 0 ms to 1000 ms per curve."
    rt.buf_push_bytes(&h2, (&h2a[0]) as u64, 46)
    rt.buf_push_dec_u64(&h2, PHASES as u64)
    rt.buf_push_bytes(&h2, (&h2b[0]) as u64, 39)
    let w2: f64 = label(&c, 24.0, 44.0, 900.0, 12, rt.buf_ptr(&h2),
        rt.buf_len(&h2), style.TOK_TEXT_MUTED)
    rt.buf_free(&h2)

    var h3: rt.Buf = rt.buf_new()
    var h3a: [u8; 14] = "TRANSITION -- "
    var h3b: [u8; 15] = " state changes."
    rt.buf_push_bytes(&h3, (&h3a[0]) as u64, 14)
    rt.buf_push_dec_u64(&h3, wechsel as u64)
    rt.buf_push_bytes(&h3, (&h3b[0]) as u64, 15)
    let w3: f64 = label(&c, 24.0, 490.0, 900.0, 15, rt.buf_ptr(&h3),
        rt.buf_len(&h3), style.TOK_TEXT)
    rt.buf_free(&h3)

    var h4: rt.Buf = rt.buf_new()
    var h4a: [u8; 31] = "The same button is read off at "
    var h4b: [u8; 13] = " points of a "
    var h4c: [u8; 46] = " ms ease-out: colour, radius, border and lift."
    rt.buf_push_bytes(&h4, (&h4a[0]) as u64, 31)
    rt.buf_push_dec_u64(&h4, PHASES as u64)
    rt.buf_push_bytes(&h4, (&h4b[0]) as u64, 13)
    rt.buf_push_dec_u64(&h4, UEB_MS as u64)
    rt.buf_push_bytes(&h4, (&h4c[0]) as u64, 46)
    let w4: f64 = label(&c, 24.0, 512.0, 1000.0, 12, rt.buf_ptr(&h4),
        rt.buf_len(&h4), style.TOK_TEXT_MUTED)
    rt.buf_free(&h4)

    // NO HEADER ROW MAY RUN OUT OF ITS BAND. Measuring is done with
    // the target width that `label` returns anyway (it comes
    // from `render.pref_of`, the measuring protocol of the library). If a
    // line does not fit, no image is written: a hard
    // cut-off word in the proof is exactly the error that this
    // sheet is meant to uncover.
    if w1 > 900.0 || w2 > 900.0 || w3 > 900.0 || w4 > 1000.0 {
        var zb: [u8; 51] = "gallery5: eine Kopfzeile ist breiter als ihr Band.\n"
        rt.write_everything(2, (&zb[0]) as u64, 51)
        return 10
    }
    // AND NO OTHER LABEL EITHER. The four header rows
    // are the most conspicuous, but a row label is just as readily
    // cut off. `label` has carried along the widest overhang of the
    // whole page (target width minus field, over EVERY painted
    // line); if it is positive, a text has needed more room
    // than its field gives, and then no image arises.
    if G_UEBERHANG > 0.0 {
        var zc: [u8; 54] = "gallery5: eine Beschriftung ist breiter als ihr Feld: "
        rt.write_everything(2, (&zc[0]) as u64, 54)
        var zt: rt.Buf = rt.buf_new()
        rt.buf_push_dec_i64(&zt, (G_UEBERHANG + 0.5) as i64)
        rt.buf_push(&zt, 10 as u8)
        rt.write_everything(2, rt.buf_ptr(&zt), rt.buf_len(&zt))
        rt.buf_free(&zt)
        return 11
    }

    // ---- THE FOUR HEADER ROWS REALLY STAND IN THEIR ROW.
    //
    // They are set at y 22, 44, 490 and 512; their ascents
    // thus lie in the rows below. If nothing stands there, the
    // line was painted into the void or has slipped into another band --
    // an error that the band check from outside does not see, because
    // in the bands the images stand, after all.
    let pgrund: u32 = canvas.canvas_get(&cv, 2, 2)
    var q1: [u8; 44] = "1 the EASING headline is really there       "
    verlange((&q1[0]) as u64, 43,
        band_has_color(&cv, 25, 38, pgrund) > 200,
        band_has_color(&cv, 25, 38, pgrund), 200)
    var q2: [u8; 44] = "1 its subline is really there               "
    verlange((&q2[0]) as u64, 43,
        band_has_color(&cv, 47, 58, pgrund) > 200,
        band_has_color(&cv, 47, 58, pgrund), 200)
    var q3: [u8; 44] = "2 the TRANSITION headline is really there   "
    verlange((&q3[0]) as u64, 43,
        band_has_color(&cv, 493, 506, pgrund) > 200,
        band_has_color(&cv, 493, 506, pgrund), 200)
    var q4: [u8; 44] = "2 its subline is really there               "
    verlange((&q4[0]) as u64, 43,
        band_has_color(&cv, 515, 526, pgrund) > 200,
        band_has_color(&cv, 515, 526, pgrund), 200)
    if G_ERROR > 0 {
        var gf: [u8; 60] = "gallery5: das Raster stimmt nicht -- kein Beleg geschrieben\n"
        rt.write_everything(2, (&gf[0]) as u64, 60)
        return 12
    }
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&cv, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < rt.c_length(path) {
        rt.buf_push(&pf, rt.ld8(path, k))
        k = k + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 10] = "GALLERY 5\n"
    rt.write_everything(1, (&okm[0]) as u64, 10)
    // THE MEASURED NUMBERS INTO THE LOG. A proof that says only "in
    // order" cannot be re-calculated afterwards: here stands
    // what the four header rows needed in points and how much
    // room the narrowest label of the page had left.
    var zl: rt.Buf = rt.buf_new()
    var zk: [u8; 28] = "  Kopfzeilen (Bedarf/Band): "
    rt.buf_push_bytes(&zl, (&zk[0]) as u64, 28)
    rt.buf_push_dec_i64(&zl, (w1 + 0.5) as i64)
    var zs: [u8; 5] = "/900 "
    rt.buf_push_bytes(&zl, (&zs[0]) as u64, 5)
    rt.buf_push_dec_i64(&zl, (w2 + 0.5) as i64)
    rt.buf_push_bytes(&zl, (&zs[0]) as u64, 5)
    rt.buf_push_dec_i64(&zl, (w3 + 0.5) as i64)
    rt.buf_push_bytes(&zl, (&zs[0]) as u64, 5)
    rt.buf_push_dec_i64(&zl, (w4 + 0.5) as i64)
    var zr: [u8; 31] = "/1000, engste Beschriftung hat "
    rt.buf_push_bytes(&zl, (&zr[0]) as u64, 31)
    rt.buf_push_dec_i64(&zl, (0.0 - G_UEBERHANG + 0.5) as i64)
    var zp: [u8; 16] = " Punkt Luft  OK\n"
    rt.buf_push_bytes(&zl, (&zp[0]) as u64, 16)
    rt.write_everything(1, rt.buf_ptr(&zl), rt.buf_len(&zl))
    rt.buf_free(&zl)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    return 0
}
