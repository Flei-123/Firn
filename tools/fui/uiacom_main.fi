// SPDX-License-Identifier: MPL-2.0
// tools/fui/uiacom_main.fi -- THE CHECK OF lib/fui/uiacom.windows.fi (the UIA COM glue), WITHOUT A WINDOW.
// Windows target (Wine): walks the COM objects through their OWN vtables (the way UIA would call them).
// Build+run: sh tools/fui/uiacom.sh
// Builds the same settings window as atspi_main.fi, paints it and asks the UIA model: control types,
// patterns, states, navigation consistency, runtime ids, rectangles, hit test; the element count must equal
// the AT-SPI bridge's (same tree). Run:  FIRNLIB=lib firnc --opt-level=dev -o X tools/fui/uia_main.fi && X
import std.rt
import fui.safeout
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.a11y
import fui.uiacom
import gpu.wgl
import fui.uia
import fui.control
import fui.vlist
import std.env

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut LAST_ID: usize = 0

static mut MAIL_ID: usize = 0
static mut OUT_ID: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_num(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

static mut FONT: u64 = 0

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn settle(a: *mut app.App) {
    let i: usize = fuiwirt.host_take_activated(app.app_host(a))
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
}

fn click_at(a: *mut app.App, s: *mut Surface, x: f64, y: f64) {
    let w: *mut fuiwirt.Host = app.app_host(a)
    let c1: u32 = fuiwirt.host_pointer_move(w, x, y)
    let c2: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let c3: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
    settle(a)
    frame(a, s)
}

fn click(a: *mut app.App, s: *mut Surface, id: usize) {
    let sc: *mut scene.Scene = app.app_scene(a)
    click_at(a, s, scene.node_x(sc, id) + scene.node_w(sc, id) / 2.0,
        scene.node_y(sc, id) + scene.node_h(sc, id) / 2.0)
}

fn key(a: *mut app.App, s: *mut Surface, k: u32) {
    let used: bool = app.app_key(a as u64, k, 0 as u32)
    if !used {
        let h: u32 = fuiwirt.host_key(app.app_host(a), 0 as u32, 0 as u32)
    }
    frame(a, s)
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
    LAST_ID = id
}

fn focus_on(a: *mut app.App, id: usize) {
    let r: u32 = fuiwirt.host_pointer_move(app.app_host(a), 1.0, 1.0)
    let f: bool = false
}

static mut WALKED: usize = 0
static mut NAV_BAD: usize = 0
static mut RID_BAD: usize = 0
static mut RIDS: [u64; 256] = [0; 256]

fn rid_key(e: uia.El) -> u64 {
    var r: [i32; 3] = [0; 3]
    uia.el_runtime_id(e, &r)
    return ((r[1] as u64) * 100000) + (r[2] as u64)
}

fn walk(pv: *mut uia.Provider, e: uia.El, depth: usize) {
    if WALKED < 256 {
        let key: u64 = rid_key(e)
        var j: usize = 0
        while j < WALKED {
            if RIDS[j] == key { RID_BAD = RID_BAD + 1 }
            j = j + 1
        }
        RIDS[WALKED] = key
    }
    WALKED = WALKED + 1
    if depth > 30 { return }
    let kc: usize = uia.el_child_count(pv, e)
    let f: uia.El = uia.el_first_child(pv, e)
    let l: uia.El = uia.el_last_child(pv, e)
    if kc == 0 {
        if !uia.el_is_none(f) || !uia.el_is_none(l) { NAV_BAD = NAV_BAD + 1 }
    } else {
        if !uia.el_equal(uia.el_parent(pv, f), e) { NAV_BAD = NAV_BAD + 1 }
        if !uia.el_equal(uia.el_parent(pv, l), e) { NAV_BAD = NAV_BAD + 1 }
        if !uia.el_is_none(uia.el_prev(pv, f)) { NAV_BAD = NAV_BAD + 1 }
        if !uia.el_is_none(uia.el_next(pv, l)) { NAV_BAD = NAV_BAD + 1 }
    }
    var c: uia.El = f
    var k: usize = 0
    while !uia.el_is_none(c) && k < kc + 1 {
        let nx: uia.El = uia.el_next(pv, c)
        if !uia.el_is_none(nx) && !uia.el_equal(uia.el_prev(pv, nx), c) { NAV_BAD = NAV_BAD + 1 }
        walk(pv, c, depth + 1)
        c = nx
        k = k + 1
    }
    if k != kc { NAV_BAD = NAV_BAD + 1 }
}

fn on_quit(a: *mut app.App) {}

// COM call: p->vtbl[i](p, a, b, c)
fn vc(p: u64, i: usize, a: u64, b: u64, c: u64) -> u64 {
    return wgl.call4(rt.ld64(rt.ld64(p, 0), i), p, a, b, c)
}

fn hr(x: u64) -> u64 { return x & 4294967295 }

// QueryInterface with GUID words; returns the interface pointer or 0
fn qi(p: u64, w0: u64, w1: u64) -> u64 {
    var g: [u64; 2] = [w0, w1]
    var out: [u64; 1] = [0; 1]
    let r: u64 = hr(vc(p, 0, (&g[0]) as u64, (&out[0]) as u64, 0))
    if r != 0 {
        return 0
    }
    return out[0]
}

fn release(p: u64) -> u64 { return hr(vc(p, 2, 0, 0, 0)) }

fn prop_i32(simple: u64, id: u64) -> i64 {
    var v: [u64; 3] = [0; 3]
    let r: u64 = hr(vc(simple, 5, id, (&v[0]) as u64, 0))
    if r != 0 || (v[0] & 65535) != 3 {
        return 0 - 1
    }
    return (v[1] & 4294967295) as i64
}

// BSTR property compared with an ASCII string
fn prop_str_is(simple: u64, id: u64, want: str) -> bool {
    var v: [u64; 3] = [0; 3]
    let r: u64 = hr(vc(simple, 5, id, (&v[0]) as u64, 0))
    if r != 0 || (v[0] & 65535) != 8 || v[1] == 0 {
        return false
    }
    var i: usize = 0
    while i < want.n {
        if (rt.ld16(v[1], i) as u64) != (want.chars(i) as u64) {
            return false
        }
        i = i + 1
    }
    return rt.ld16(v[1], i) == 0 as u16
}

static mut WALK_N: usize = 0
static mut WALK_BAD: usize = 0
static mut FOUND_CB: u64 = 0
static mut FOUND_BTN: u64 = 0
static mut FOUND_SL: u64 = 0
static mut FOUND_TB: u64 = 0
static mut FOUND_EN: u64 = 0
static mut FOUND_CELL: u64 = 0

// the bits of a double
fn bits_of(x: f64) -> u64 {
    var t: [f64; 1] = [x]
    return rt.ld64((&t[0]) as u64, 0)
}

// was an event of `kind` / `id` logged since sequence number `from`?
fn seen(from: u64, kind: u64, id: u64) -> bool {
    var q: u64 = from
    while q < uiacom.event_count() {
        if uiacom.event_at(q, 0) == kind && uiacom.event_at(q, 1) == id {
            return true
        }
        q = q + 1
    }
    return false
}

// vtable word `i` of the COM object `p`
fn vword(p: u64, i: usize) -> u64 {
    return rt.ld64(rt.ld64(p, 0), i)
}

fn walk_com(frag: u64, parent: u64, depth: usize) {
    WALK_N = WALK_N + 1
    if depth > 20 { return }
    // Navigate(Parent) must return the parent (same pointer: same entry, same slot)
    var o: [u64; 1] = [0; 1]
    let rp: u64 = hr(vc(frag, 3, 0, (&o[0]) as u64, 0))
    if rp != 0 { WALK_BAD = WALK_BAD + 1 }
    if parent == 0 {
        if o[0] != 0 { WALK_BAD = WALK_BAD + 1 }
    } else {
        if o[0] != parent { WALK_BAD = WALK_BAD + 1 }
    }
    if o[0] != 0 { let q: u64 = release(o[0]) }
    let simple: u64 = qi(frag, 0x433286fdd6dd68d1, 0x4cd2a2debe9a6686)
    if simple == 0 { WALK_BAD = WALK_BAD + 1 } else {
        if prop_str_is(simple, 30005, "Dark mode") { FOUND_CB = simple }
        if prop_str_is(simple, 30005, "Quit") { FOUND_BTN = simple }
        if prop_str_is(simple, 30005, "Volume") { FOUND_SL = simple }
        if prop_str_is(simple, 30005, "People") { FOUND_TB = simple }
        if prop_str_is(simple, 30005, "Search") { FOUND_EN = simple }
        if prop_str_is(simple, 30005, "25") { FOUND_CELL = simple }
    }
    var c: [u64; 1] = [0; 1]
    let rc: u64 = hr(vc(frag, 3, 3, (&c[0]) as u64, 0))
    if rc != 0 { WALK_BAD = WALK_BAD + 1 }
    var cur: u64 = c[0]
    while cur != 0 {
        walk_com(cur, frag, depth + 1)
        var nx: [u64; 1] = [0; 1]
        let rn: u64 = hr(vc(cur, 3, 1, (&nx[0]) as u64, 0))
        if rn != 0 { WALK_BAD = WALK_BAD + 1; nx[0] = 0 }
        let q: u64 = release(cur)
        cur = nx[0]
    }
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("uiacom: no font\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Settings", 520, 700)
    let hd: usize = app.label(a, "Preferences", 0)
    a11y.a11y_set_role(app.ax(a), hd, a11y.ROLE_HEADING)
    let cb: usize = appctl.checkbox(a, "Dark mode", false, changed)
    let sl: usize = appctl.slider(a, "Volume", 0, 100, 40, changed)
    let en: usize = app.entry(a, "Search")
    let tbl: usize = appctl.table(a, "People", 480, 100, 2, changed)
    appctl.table_col(a, tbl, 0, "Name", 200, false)
    appctl.table_col(a, tbl, 1, "Age", 120, false)
    let tr0: usize = appctl.table_add_row(a, tbl)
    appctl.table_set(a, tbl, tr0, 0, "Anna")
    appctl.table_set(a, tbl, tr0, 1, "7")
    let tr1: usize = appctl.table_add_row(a, tbl)
    appctl.table_set(a, tbl, tr1, 0, "Bruno")
    appctl.table_set(a, tbl, tr1, 1, "25")
    let qb: usize = app.button(a, "Quit", on_quit)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 520, 700)
    frame(a, s)
    frame(a, s)
    say("== UIA COM glue (through the vtables) ==\n")
    check(uiacom.test_attach(a, "Settings"), "tables + pool + provider set up")
    let root: u64 = uiacom.root_interface()
    check(root != 0, "root_interface() gives a pointer")
    // identity: IUnknown / Simple / Fragment / FragmentRoot on the root; no Invoke on the root
    let u0: u64 = qi(root, 0x0, 0x46000000000000c0)
    check(u0 == root, "QI IUnknown -> the Simple slot")
    let fr: u64 = qi(root, 0x439c8359f7063da8, 0x877d9a29c5bb9792)
    check(fr != 0 && fr != root, "QI Fragment")
    let rr: u64 = qi(root, 0x40a9ab8f620ce2a5, 0x589b59753cdecb86)
    check(rr != 0, "QI FragmentRoot on the root")
    check(qi(root, 0x47a2e18e54fcb24b, 0xa29975e7cbecd3b4) == 0, "QI Invoke on the root: E_NOINTERFACE")
    check(qi(root, 0x1, 0x2) == 0, "QI unknown IID: E_NOINTERFACE")
    var opt: [u64; 1] = [0; 1]
    check(hr(vc(root, 3, (&opt[0]) as u64, 0, 0)) == 0 && (opt[0] & 4294967295) == 34, "ProviderOptions = ServerSide | UseComThreading (0x22)")
    check(prop_i32(root, 30003) == 50032, "root ControlType = Window (50032)")
    // AddRef / Release count
    let r1: u64 = hr(vc(root, 1, 0, 0, 0))
    let r2: u64 = hr(vc(root, 2, 0, 0, 0))
    check(r1 == r2 + 1, "AddRef then Release: counts differ by one")
    // walk the whole tree through Navigate
    walk_com(fr, 0, 0)
    say("  walked ")
    say_num(WALK_N as i64)
    say(" fragments\n")
    check(WALK_BAD == 0, "Navigate: parent(child) == parent, root has no parent, all calls S_OK, QI Simple works everywhere")
    var pvm: uia.Provider = uia.provider_new(app.app_scene(a), app.ax(a), "Settings")
    uia.provider_set_app(&pvm, a)
    WALKED = 0
    walk(&pvm, uia.el_root(&pvm), 0)
    check(WALK_N == WALKED, "the COM walk visits as many elements as the model")
    check(FOUND_CB != 0 && FOUND_BTN != 0 && FOUND_SL != 0, "names via GetPropertyValue(Name): 'Dark mode', 'Quit', 'Volume' found")
    check(prop_i32(FOUND_CB, 30003) == 50002, "check box ControlType = CheckBox (50002)")
    check(prop_i32(FOUND_BTN, 30003) == 50000, "button ControlType = Button (50000)")
    check(prop_str_is(root, 30024, "fUi"), "FrameworkId = fUi")
    // patterns
    var pt: [u64; 1] = [0; 1]
    check(hr(vc(FOUND_CB, 4, 10015, (&pt[0]) as u64, 0)) == 0 && pt[0] != 0, "GetPatternProvider(Toggle) on the check box")
    let tg: u64 = pt[0]
    var st: [u64; 1] = [9; 1]
    check(hr(vc(tg, 4, (&st[0]) as u64, 0, 0)) == 0 && (st[0] & 4294967295) == 0, "ToggleState = Off")
    check(hr(vc(tg, 3, 0, 0, 0)) == 0, "Toggle() -> S_OK")
    frame(a, s)
    check(hr(vc(tg, 4, (&st[0]) as u64, 0, 0)) == 0 && (st[0] & 4294967295) == 1, "ToggleState = On after Toggle()")
    var pi: [u64; 1] = [0; 1]
    check(hr(vc(FOUND_CB, 4, 10000, (&pi[0]) as u64, 0)) == 0 && pi[0] == 0, "GetPatternProvider(Invoke) on a check box: none")
    check(hr(vc(FOUND_BTN, 4, 10000, (&pi[0]) as u64, 0)) == 0 && pi[0] != 0, "GetPatternProvider(Invoke) on the button")
    var rg: [u64; 1] = [0; 1]
    check(hr(vc(FOUND_SL, 4, 10003, (&rg[0]) as u64, 0)) == 0 && rg[0] != 0, "GetPatternProvider(RangeValue) on the slider")
    var dv: [f64; 1] = [0.0; 1]
    check(hr(vc(rg[0], 4, (&dv[0]) as u64, 0, 0)) == 0 && dv[0] == 40.0, "RangeValue.Value = 40.0 (slider 40 of 100)")
    var mx: [f64; 1] = [0.0; 1]
    check(hr(vc(rg[0], 6, (&mx[0]) as u64, 0, 0)) == 0 && mx[0] == 100.0, "RangeValue.Maximum = 100")
    var mn: [f64; 1] = [9.0; 1]
    check(hr(vc(rg[0], 7, (&mn[0]) as u64, 0, 0)) == 0 && mn[0] == 0.0, "RangeValue.Minimum = 0")
    // SetValue with a REAL double: the caller puts it in xmm1 and zeroes rdx (double_caller), the vtable word is the
    // xmm stub (C2)
    let sv: u64 = uiacom.double_caller(vword(rg[0], 3), 1)
    check(sv != 0, "double_caller: an executable page for the test caller")
    check(hr(wgl.call4(sv, rg[0], bits_of(70.0), 0, 0)) == 0, "RangeValue.SetValue(70.0) -> S_OK")
    check(hr(vc(rg[0], 4, (&dv[0]) as u64, 0, 0)) == 0 && dv[0] == 70.0, "RangeValue.Value = 70.0 after SetValue (through the pointer path)")
    check(hr(wgl.call4(sv, rg[0], bits_of(500.0), 0, 0)) == 0x80070057, "SetValue(500.0) out of range -> E_INVALIDARG")
    check(hr(wgl.call4(sv, rg[0], 0x7FF8000000000000, 0, 0)) == 0x80070057, "SetValue(NaN) -> E_INVALIDARG")
    check(hr(wgl.call4(sv, rg[0], bits_of(0.0), 0, 0)) == 0 && hr(vc(rg[0], 4, (&dv[0]) as u64, 0, 0)) == 0 && dv[0] == 0.0, "SetValue(0.0) -> Value 0 (left end)")
    check(hr(wgl.call4(sv, rg[0], bits_of(100.0), 0, 0)) == 0 && hr(vc(rg[0], 4, (&dv[0]) as u64, 0, 0)) == 0 && dv[0] == 100.0, "SetValue(100.0) -> Value 100 (right end)")
    check(hr(wgl.call4(sv, rg[0], bits_of(33.0), 0, 0)) == 0 && hr(vc(rg[0], 4, (&dv[0]) as u64, 0, 0)) == 0 && dv[0] == 33.0, "SetValue(33.0) -> Value 33")
    var ro: [u64; 1] = [9; 1]
    check(hr(vc(rg[0], 5, (&ro[0]) as u64, 0, 0)) == 0 && (ro[0] & 4294967295) == 0, "RangeValue.IsReadOnly = false for an enabled slider")
    // ---- W37: table patterns, Select on a row, the real text of a text field
    check(FOUND_TB != 0 && FOUND_EN != 0 && FOUND_CELL != 0, "found the table 'People', the text field 'Search' and the cell '25'")
    var gp: [u64; 1] = [0; 1]
    check(hr(vc(FOUND_TB, 4, 10006, (&gp[0]) as u64, 0)) == 0 && gp[0] != 0, "GetPatternProvider(Grid) on the table")
    var gn: [u64; 1] = [0; 1]
    check(hr(vc(gp[0], 4, (&gn[0]) as u64, 0, 0)) == 0 && (gn[0] & 4294967295) == 2, "Grid.RowCount = 2")
    check(hr(vc(gp[0], 5, (&gn[0]) as u64, 0, 0)) == 0 && (gn[0] & 4294967295) == 2, "Grid.ColumnCount = 2")
    var gi: [u64; 1] = [0; 1]
    check(hr(vc(gp[0], 3, 1, 1, (&gi[0]) as u64)) == 0 && gi[0] != 0, "Grid.GetItem(1, 1) gives the cell")
    check(prop_str_is(gi[0], 30005, "25"), "Grid.GetItem(1, 1) is the cell '25'")
    var gi2: [u64; 1] = [7; 1]
    check(hr(vc(gp[0], 3, 5, 0, (&gi2[0]) as u64)) == 0x80070057, "Grid.GetItem(5, 0) -> E_INVALIDARG")
    var tp: [u64; 1] = [0; 1]
    check(hr(vc(FOUND_TB, 4, 10012, (&tp[0]) as u64, 0)) == 0 && tp[0] != 0, "GetPatternProvider(Table) on the table")
    var tm: [u64; 1] = [9; 1]
    check(hr(vc(tp[0], 5, (&tm[0]) as u64, 0, 0)) == 0 && (tm[0] & 4294967295) == 0, "Table.RowOrColumnMajor = RowMajor")
    var th: [u64; 1] = [0; 1]
    check(hr(vc(tp[0], 4, (&th[0]) as u64, 0, 0)) == 0 && th[0] != 0, "Table.GetColumnHeaders gives an (empty) array")
    check(hr(vc(FOUND_EN, 4, 10012, (&tp[0]) as u64, 0)) == 0 && tp[0] == 0, "GetPatternProvider(Table) on a text field: none")
    var ip: [u64; 1] = [0; 1]
    check(hr(vc(FOUND_CELL, 4, 10007, (&ip[0]) as u64, 0)) == 0 && ip[0] != 0, "GetPatternProvider(GridItem) on a cell")
    var ir: [u64; 1] = [9; 1]
    check(hr(vc(ip[0], 3, (&ir[0]) as u64, 0, 0)) == 0 && (ir[0] & 4294967295) == 1, "GridItem.Row = 1")
    check(hr(vc(ip[0], 4, (&ir[0]) as u64, 0, 0)) == 0 && (ir[0] & 4294967295) == 1, "GridItem.Column = 1")
    check(hr(vc(ip[0], 5, (&ir[0]) as u64, 0, 0)) == 0 && (ir[0] & 4294967295) == 1, "GridItem.RowSpan = 1")
    var ig: [u64; 1] = [0; 1]
    check(hr(vc(ip[0], 7, (&ig[0]) as u64, 0, 0)) == 0 && ig[0] != 0 && prop_str_is(ig[0], 30005, "People"), "GridItem.ContainingGrid = the table")
    var ti: [u64; 1] = [0; 1]
    check(hr(vc(FOUND_CELL, 4, 10013, (&ti[0]) as u64, 0)) == 0 && ti[0] != 0, "GetPatternProvider(TableItem) on a cell")
    var tih: [u64; 1] = [0; 1]
    check(hr(vc(ti[0], 3, (&tih[0]) as u64, 0, 0)) == 0 && tih[0] != 0, "TableItem.GetRowHeaderItems gives an (empty) array")
    // Select on the row of the cell '25' (was NOTSUPPORTED 0x80040204)
    let fcell: u64 = qi(FOUND_CELL, 0x439c8359f7063da8, 0x877d9a29c5bb9792)
    var rowf: [u64; 1] = [0; 1]
    check(fcell != 0 && hr(vc(fcell, 3, 0, (&rowf[0]) as u64, 0)) == 0 && rowf[0] != 0, "Navigate(Parent) of the cell is the row")
    let rows: u64 = qi(rowf[0], 0x433286fdd6dd68d1, 0x4cd2a2debe9a6686)
    var sip: [u64; 1] = [0; 1]
    check(rows != 0 && hr(vc(rows, 4, 10010, (&sip[0]) as u64, 0)) == 0 && sip[0] != 0, "GetPatternProvider(SelectionItem) on the row")
    var sel0: [u64; 1] = [9; 1]
    check(hr(vc(sip[0], 6, (&sel0[0]) as u64, 0, 0)) == 0 && (sel0[0] & 4294967295) == 0, "row: IsSelected = false")
    check(hr(vc(sip[0], 3, 0, 0, 0)) == 0, "SelectionItem.Select() on the row -> S_OK")
    frame(a, s)
    check(hr(vc(sip[0], 6, (&sel0[0]) as u64, 0, 0)) == 0 && (sel0[0] & 4294967295) != 0, "row: IsSelected = true after Select()")
    var slp: [u64; 1] = [0; 1]
    check(hr(vc(FOUND_TB, 4, 10001, (&slp[0]) as u64, 0)) == 0 && slp[0] != 0, "GetPatternProvider(Selection) on the table")
    var ssa: [u64; 1] = [0; 1]
    check(hr(vc(slp[0], 3, (&ssa[0]) as u64, 0, 0)) == 0 && ssa[0] != 0, "Selection.GetSelection gives an array")
    check(uia.el_selected_count(&pvm, uia.el_from_node(&pvm, tbl)) == 1, "the model sees exactly one selected row")
    var cm: [u64; 1] = [9; 1]
    check(hr(vc(slp[0], 4, (&cm[0]) as u64, 0, 0)) == 0 && (cm[0] & 4294967295) == 0, "Selection.CanSelectMultiple = false")
    // text field: Value = the real text, IsReadOnly false, SetValue works
    app.set_text(a, en, "hello fUi")
    frame(a, s)
    var vp: [u64; 1] = [0; 1]
    check(hr(vc(FOUND_EN, 4, 10002, (&vp[0]) as u64, 0)) == 0 && vp[0] != 0, "GetPatternProvider(Value) on the text field")
    var vs: [u64; 1] = [0; 1]
    check(hr(vc(vp[0], 4, (&vs[0]) as u64, 0, 0)) == 0 && vs[0] != 0 && rt.ld32(vs[0] - 4, 0) == 18 as u32 && rt.ld16(vs[0], 0) == 104 as u16 && rt.ld16(vs[0], 8) == 105 as u16, "Value.Value = 'hello fUi' (not the label 'Search')")
    var vro: [u64; 1] = [9; 1]
    check(hr(vc(vp[0], 5, (&vro[0]) as u64, 0, 0)) == 0 && (vro[0] & 4294967295) == 0, "Value.IsReadOnly = false for an enabled text field")
    let sas: u64 = wgl.dll_sym("oleaut32.dll", "SysAllocString")
    var nw: [u16; 4] = [97 as u16, 98 as u16, 233 as u16, 0 as u16]
    var nbs: u64 = 0
    if sas != 0 { nbs = wgl.call1(sas, (&nw[0]) as u64) }
    check(nbs != 0 && hr(vc(vp[0], 3, nbs, 0, 0)) == 0, "Value.SetValue('ab\u00e9') -> S_OK")
    let nt: str = app.text(a, en)
    check(nt.n == 4 && nt.chars(0) == 97 && nt.chars(1) == 98 && nt.chars(2) == 195 && nt.chars(3) == 169, "the field now holds 'abé' (UTF-8)")
    // bounds (UiaRect of doubles)
    // runtime id
    var sa: [u64; 1] = [0; 1]
    let frag_btn: u64 = qi(FOUND_BTN, 0x439c8359f7063da8, 0x877d9a29c5bb9792)
    check(frag_btn != 0 && hr(vc(frag_btn, 4, (&sa[0]) as u64, 0, 0)) == 0 && sa[0] != 0, "GetRuntimeId gives a SAFEARRAY")
    var bx2: [f64; 4] = [0.0; 4]
    check(hr(vc(frag_btn, 5, (&bx2[0]) as u64, 0, 0)) == 0 && bx2[2] > 0.0 && bx2[3] > 0.0, "BoundingRectangle of the button has a size")
    // FragmentRoot of an inner element is the root, and GetFocus works
    var fro: [u64; 1] = [0; 1]
    check(hr(vc(frag_btn, 8, (&fro[0]) as u64, 0, 0)) == 0 && fro[0] == rr, "get_FragmentRoot of a leaf = the root's FragmentRoot slot")
    var fo: [u64; 1] = [0; 1]
    check(hr(vc(rr, 4, (&fo[0]) as u64, 0, 0)) == 0, "FragmentRoot.GetFocus -> S_OK")
    check(uiacom.entry_count() > 5, "pool holds entries")
    // ElementProviderFromPoint with real doubles (xmm1 / xmm2): the middle of the button must give the button
    let fpf: u64 = uiacom.double_caller(vword(rr, 3), 3)
    var fpo: [u64; 1] = [0; 1]
    let cx: f64 = bx2[0] + bx2[2] / 2.0
    let cy: f64 = bx2[1] + bx2[3] / 2.0
    check(fpf != 0 && hr(wgl.call4(fpf, rr, bits_of(cx), bits_of(cy), (&fpo[0]) as u64)) == 0 && fpo[0] == frag_btn, "ElementProviderFromPoint(doubles) at the button centre = the button")
    var fpo2: [u64; 1] = [7; 1]
    check(hr(wgl.call4(fpf, rr, bits_of(0.0 - 500.0), bits_of(0.0 - 500.0), (&fpo2[0]) as u64)) == 0 && fpo2[0] == 0, "ElementProviderFromPoint outside the window = none")
    // ---- events by polling (force_listening: Wine's UiaClientsAreListening says no)
    let frag_cb: u64 = qi(FOUND_CB, 0x439c8359f7063da8, 0x877d9a29c5bb9792)
    check(hr(vc(frag_cb, 7, 0, 0, 0)) == 0, "SetFocus on the check box (baseline focus)")
    uiacom.force_listening(false)
    check(uiacom.poll() == 0, "poll without a listening client: nothing raised")
    uiacom.force_listening(true)
    let ev0: u64 = uiacom.event_count()
    check(uiacom.poll() == 0, "poll: first tick with a listener = baseline, no events")
    check(uiacom.poll() == 0 && uiacom.event_count() == ev0, "poll: nothing changed, no events")
    check(hr(wgl.call4(sv, rg[0], bits_of(80.0), 0, 0)) == 0, "SetValue(80.0)")
    check(uiacom.poll() >= 1 && seen(ev0, 2, 30047), "poll: RangeValue.Value property event (30047)")
    let ev1: u64 = uiacom.event_count()
    check(hr(vc(tg, 3, 0, 0, 0)) == 0, "Toggle()")
    check(uiacom.poll() >= 1 && seen(ev1, 2, 30086), "poll: ToggleState property event (30086)")
    let ev2: u64 = uiacom.event_count()
    check(hr(vc(frag_btn, 7, 0, 0, 0)) == 0, "SetFocus on the button")
    check(uiacom.poll() >= 2 && seen(ev2, 1, 20005) && seen(ev2, 2, 30008), "poll: AutomationFocusChanged (20005) + HasKeyboardFocus (30008)")
    let ev3: u64 = uiacom.event_count()
    check(hr(vc(pi[0], 3, 0, 0, 0)) == 0, "Invoke() on the button")
    check(uiacom.poll() >= 1 && seen(ev3, 1, 20009), "poll: Invoke.Invoked event (20009) queued by Invoke")
    check(uiacom.poll() == 0, "poll: quiet again")
    let ev3b: u64 = uiacom.event_count()
    check(a11y.a11y_announce(app.ax(a), "Saved", a11y.LIVE_ASSERTIVE), "announce through the a11y ring")
    check(uiacom.poll() >= 1 && seen(ev3b, 3, 3), "poll: announcement raised as a notification event (assertive)")
    check(uiacom.poll() == 0, "poll: the announcement is raised once")
    uiacom.force_listening(false)
    check(hr(vc(tg, 3, 0, 0, 0)) == 0 && uiacom.poll() == 0, "poll without a listener after a change: nothing raised")
    // the window procedure: a real (STATIC) window, subclassed; WM_GETOBJECT(-25) must reach the glue
    let cw: u64 = wgl.dll_sym("user32.dll", "CreateWindowExW")
    let sm: u64 = wgl.dll_sym("user32.dll", "SendMessageW")
    var cls: [u16; 8] = [83 as u16, 84 as u16, 65 as u16, 84 as u16, 73 as u16, 67 as u16, 0 as u16, 0 as u16]
    var hw: u64 = 0
    if cw != 0 {
        hw = wgl.call12(cw, 0, (&cls[0]) as u64, 0, 0, 0, 0, 100, 100, 18446744073709551613, 0, 0, 0)
    }
    check(hw != 0, "test window created")
    check(uiacom.attach(a, hw, "Settings") && uiacom.is_attached(), "attach: CoInitializeEx(STA) + subclass")
    let before: u64 = uiacom.getobject_count()
    let lr: u64 = wgl.call4(sm, hw, 61, 0, 18446744073709551591)
    check(uiacom.getobject_count() == before + 1, "WM_GETOBJECT(UiaRootObjectId) reaches the glue (answer " + "counted)")
    say("  (UiaReturnRawElementProvider LRESULT = ")
    say_num(lr as i64)
    say(")\n")
    // the poll timer: WM_TIMER (0x113) with id 0xF0A1 reaches the subclass and runs `poll`
    uiacom.force_listening(true)
    let t0: u64 = wgl.call4(sm, hw, 275, 61601, 0)
    let ev4: u64 = uiacom.event_count()
    check(hr(vc(tg, 3, 0, 0, 0)) == 0, "Toggle() before the timer tick")
    let t1: u64 = wgl.call4(sm, hw, 275, 61601, 0)
    check(uiacom.event_count() > ev4 && seen(ev4, 2, 30086), "WM_TIMER(0xF0A1) -> poll -> ToggleState event")
    uiacom.force_listening(false)
    let lr2: u64 = wgl.call4(sm, hw, 61, 0, 12345)
    check(uiacom.getobject_count() == before + 1, "another object id is passed on, not answered")
    say("UIACOM bad=")
    say_num(BAD as i64)
    say("\n")
    if BAD > 0 { return 1 }
    return 0
}
