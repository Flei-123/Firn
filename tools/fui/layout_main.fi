// SPDX-License-Identifier: GPL-2.0-only
// tools/fui/layout_main.fi -- THE LAYOUT IS RECOMPUTED.
//
// A layout does not fall over loudly. It sits one pixel off, and you
// only see that on a screenshot at Justin's resolution -- or not at
// all. That is why this is computed and not looked at:
//
//   1. The parts of a stack add up to EXACTLY the space. No pixel is
//      missing at the right edge, none is too many.
//   2. No child overlaps its neighbour.
//   3. The stretchy one gets the rest, the fixed one keeps its size.
//   4. The columns of a grid sum exactly to the width -- even for a
//      count that does not divide evenly (7 columns over 100).
//   5. An inner margin larger than the rect yields an EMPTY rect and
//      not a negative one.
import std.rt
import fui.layout

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    rt.buf_push(&t, 40 as u8)
    rt.buf_push_dec_i64(&t, a)
    rt.buf_push(&t, 47 as u8)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 41 as u8)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn main(start: u64) -> i32 {
    // ============================================ 1. THE HORIZONTAL STACK
    //
    // The address bar of Certus: three fixed buttons, the address
    // field stretchy. Exactly the case `chrome.fi` computes by hand today.
    var s: layout.Box = layout.box_new(layout.HORIZONTAL)
    layout.box_set_margin(&s, 6, 4, 8, 4)
    layout.box_set_gap(&s, 4)
    var pref: [i64; 4] = [32, 32, 32, 100]
    var grow: [i64; 4] = [0, 0, 0, 1]
    var cross: [i64; 4] = [32, 32, 32, 28]
    var align: [layout.Rect; 4] = [layout.rect_new(0,0,0,0); 4]
    let space: layout.Rect = layout.rect_new(0, 0, 1024, 40)
    layout.box_layout(&s, space, (&pref[0]) as *mut i64,
        (&grow[0]) as *mut i64, (&cross[0]) as *mut i64,
        (&align[0]) as *mut layout.Rect, 4)

    // The three fixed buttons keep their size.
    var fixed_ok: bool = true
    var i: usize = 0
    while i < 3 {
        if layout.rect_w(&align[i]) != 32 {
            fixed_ok = false
        }
        i = i + 1
    }
    var n1: [u8; 23] = "1 fixed buttons keep 32"
    report((&n1[0]) as u64, 23, fixed_ok,
        layout.rect_w(&align[0]), 32)

    // THE STRETCHY FIELD TAKES THE REST -- and the box ends EXACTLY
    // at the right edge minus the margin.
    let end_: i64 = layout.rect_x(&align[3])
        + layout.rect_w(&align[3])
    var n2: [u8; 32] = "1 box ends exactly at the margin"
    report((&n2[0]) as u64, 32, end_ == 1024 - 8, end_, 1024 - 8)

    // NO OVERLAP: every child starts behind the previous one.
    var overlaps: bool = false
    var j: usize = 1
    while j < 4 {
        let before_end: i64 = layout.rect_x(&align[j - 1])
            + layout.rect_w(&align[j - 1])
        if layout.rect_x(&align[j]) < before_end {
            overlaps = true
        }
        j = j + 1
    }
    var n3: [u8; 12] = "1 no overlap"
    report((&n3[0]) as u64, 12, !overlaps, 0, 0)

    // The gap really is 4.
    let gap_px: i64 = layout.rect_x(&align[1])
        - (layout.rect_x(&align[0]) + layout.rect_w(&align[0]))
    var n4: [u8; 26] = "1 gap between buttons is 4"
    report((&n4[0]) as u64, 26, gap_px == 4, gap_px, 4)

    // ================================ 2. STRETCHY ONES, ODD REMAINDER
    //
    // 1000 pixels over three stretchy children: 333, 333, 334 -- and
    // NOT 333, 333, 333 with one pixel lost.
    var s2: layout.Box = layout.box_new(layout.HORIZONTAL)
    var w2: [i64; 3] = [0, 0, 0]
    var d2: [i64; 3] = [1, 1, 1]
    var q2: [i64; 3] = [10, 10, 10]
    var a2: [layout.Rect; 3] = [layout.rect_new(0,0,0,0); 3]
    layout.box_layout(&s2, layout.rect_new(0, 0, 1000, 10),
        (&w2[0]) as *mut i64, (&d2[0]) as *mut i64,
        (&q2[0]) as *mut i64, (&a2[0]) as *mut layout.Rect, 3)
    let sum2: i64 = layout.rect_w(&a2[0])
        + layout.rect_w(&a2[1]) + layout.rect_w(&a2[2])
    var n5: [u8; 31] = "2 three stretchy ones make 1000"
    report((&n5[0]) as u64, 31, sum2 == 1000, sum2, 1000)

    // ============================================== 3. THE VERTICAL STACK
    var s3: layout.Box = layout.box_new(layout.VERTICAL)
    layout.box_set_gap(&s3, 8)
    var w3: [i64; 3] = [32, 32, 32]
    var d3: [i64; 3] = [0, 0, 0]
    var q3: [i64; 3] = [200, 200, 200]
    var a3: [layout.Rect; 3] = [layout.rect_new(0,0,0,0); 3]
    layout.box_layout(&s3, layout.rect_new(0, 0, 200, 200),
        (&w3[0]) as *mut i64, (&d3[0]) as *mut i64,
        (&q3[0]) as *mut i64, (&a3[0]) as *mut layout.Rect, 3)
    let y2: i64 = layout.rect_y(&a3[1])
    var n6: [u8; 24] = "3 vertical: second at 40"
    report((&n6[0]) as u64, 24, y2 == 40, y2, 40)

    // ==================================================== 4. THE GRID
    //
    // SEVEN columns over 100 pixels -- does not divide evenly. The
    // sum must still be exactly 100.
    var r: layout.Grid = layout.grid_new(7, 3)
    let rraum: layout.Rect = layout.rect_new(0, 0, 100, 90)
    var sum_cols: i64 = 0
    var col_i: usize = 0
    while col_i < 7 {
        var z: layout.Rect = layout.grid_cell(&r, rraum, col_i, 0)
        sum_cols = sum_cols + layout.rect_w(&z)
        col_i = col_i + 1
    }
    var n7: [u8; 24] = "4 seven columns make 100"
    report((&n7[0]) as u64, 24, sum_cols == 100, sum_cols, 100)

    // The last column ends at the edge.
    var last_col: layout.Rect = layout.grid_cell(&r, rraum, 6, 0)
    let r_end: i64 = layout.rect_x(&last_col)
        + layout.rect_w(&last_col)
    var n8: [u8; 25] = "4 last column ends at 100"
    report((&n8[0]) as u64, 25, r_end == 100, r_end, 100)

    // With gaps: 3 columns, gap 10, over 100 -> 3x26 + 2x10 = 98
    // ... no: whole_x = 100 - 20 = 80, distributed 27/26/27 = 80. Sum
    // including the gaps = 100.
    var r2: layout.Grid = layout.grid_new(3, 1)
    layout.grid_set_gap(&r2, 10, 0)
    var z0: layout.Rect = layout.grid_cell(&r2, rraum, 0, 0)
    var z2b: layout.Rect = layout.grid_cell(&r2, rraum, 2, 0)
    let r2_end: i64 = layout.rect_x(&z2b)
        + layout.rect_w(&z2b)
    var n9: [u8; 27] = "4 grid with gap ends at 100"
    report((&n9[0]) as u64, 27, r2_end == 100, r2_end, 100)

    // ====================================== 5. MARGIN LARGER THAN BOX
    //
    // The overflow that killed Justin's start menu -- here an EMPTY
    // rect must come out and not a number close to 2^64.
    let small: layout.Rect = layout.rect_shrink(
        layout.rect_new(0, 0, 10, 10), 20, 20, 20, 20)
    var n10: [u8; 28] = "5 margin > rect yields empty"
    report((&n10[0]) as u64, 28,
        layout.rect_w(&small) == 0 && layout.rect_h(&small) == 0,
        layout.rect_w(&small), 0)

    // ============================================= 6. CROSS ALIGNMENT
    var s4: layout.Box = layout.box_new(layout.HORIZONTAL)
    layout.box_set_align(&s4, layout.ALIGN_MID)
    var w4: [i64; 1] = [50]
    var d4: [i64; 1] = [0]
    var q4: [i64; 1] = [20]
    var a4: [layout.Rect; 1] = [layout.rect_new(0,0,0,0); 1]
    layout.box_layout(&s4, layout.rect_new(0, 0, 100, 100),
        (&w4[0]) as *mut i64, (&d4[0]) as *mut i64,
        (&q4[0]) as *mut i64, (&a4[0]) as *mut layout.Rect, 1)
    let qy: i64 = layout.rect_y(&a4[0])
    var n11: [u8; 23] = "6 cross centred: y = 40"
    report((&n11[0]) as u64, 23, qy == 40, qy, 40)

    var t: rt.Buf = rt.buf_new()
    rt.buf_push(&t, 10 as u8)
    if G_ERRORS > 0 {
        var f: [u8; 24] = "LAYOUT IS NOT IN ORDER.\n"
        rt.buf_push_bytes(&t, (&f[0]) as u64, 24)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
        return 1
    }
    var o: [u8; 15] = "LAYOUT PASSED.\n"
    rt.buf_push_bytes(&t, (&o[0]) as u64, 15)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 0
}
