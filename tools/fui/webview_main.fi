import std.rt
import paint.canvas
import fui.theme
import fui.painter
import fui.scene
import fui.a11y
import fui.editor
import fui.services
import fui.webview
import fui.webview_types
import fui.webview_stub
import fui.webview_svc
import fui.webview_ax

static mut BAD: usize = 0
static mut CHECKS: usize = 0
static mut SPOT_X: f64 = 0.0
static mut SPOT_CALLS: u32 = 0
static mut NAV_VERDICT: u32 = 0
static mut SVC_CALLS: u32 = 0

const W: u32 = 96
const H: u32 = 64
const HTML: str = "<html><title>Hello page</title></html>"
const ID_CLIP: u32 = 7
const ID_CONFIRM: u32 = 8
const ID_OPEN: u32 = 9
const ID_SAVE: u32 = 10
const DOC_TITLE: str = "Doc title"
const FILE_NAME: str = "page.txt"
const FILE_DATA: str = "file body"

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn same(a: str, b: str) -> bool {
    return a.n == b.n && rt.mem_eq(a.p as u64, b.p as u64, a.n)
}

fn nav_hook(ud: u64, p: u64, n: usize) -> u32 {
    return NAV_VERDICT
}

fn spot_hook(ud: u64, x: f64, y: f64, h: f64) {
    SPOT_X = x
    SPOT_CALLS = SPOT_CALLS + 1
}

fn svc_hook(ud: u64, ev: *mut webview_types.Event) {
    SVC_CALLS = SVC_CALLS + 1
}

fn px_ok(wv: *mut webview.WebView, s: *mut webview_stub.Stub, x: u32, y: u32) -> bool {
    let p: u64 = webview.webview_pixels(wv)
    return rt.ld32(p + (y as usize * 4 * (W as usize)) as u64, x as usize) == webview_stub.stub_pixel(s, x, y)
}

fn open_stub(wv: *mut webview.WebView, caps: u32) -> *mut webview_stub.Stub {
    let s: *mut webview_stub.Stub = webview_stub.stub_new(caps)
    var be: webview_types.Backend = webview_stub.stub_backend(s)
    check(webview.webview_open(wv, &be, W, H), "open creates the backend and the surface")
    return s
}

fn test_paint_and_load() {
    var wv: webview.WebView = webview.webview_new()
    let s: *mut webview_stub.Stub = open_stub(&wv, 0 as u32)
    check(webview.webview_state(&wv) == webview_types.ST_READY, "state ready after open")
    check(webview.webview_tick(&wv, 1000), "first tick paints")
    check(webview.webview_frames(&wv) == 1 as u64, "one frame painted")
    check(px_ok(&wv, s, 0, 0) && px_ok(&wv, s, 50, 30) && px_ok(&wv, s, W - 1, H - 1), "surface holds the backend pattern")
    check(!webview.webview_tick(&wv, 2000), "idle tick changes nothing")
    check(webview_stub.stub_ticks(s) == 2 as u32, "backend ticked twice")
    check(webview.webview_load(&wv, HTML.p as u64, HTML.n, webview_types.LOAD_HTML), "load html")
    check(webview.webview_state(&wv) == webview_types.ST_LOADING, "state loading")
    check(webview.webview_tick(&wv, 3000), "tick after load repaints")
    check(webview.webview_state(&wv) == webview_types.ST_READY, "loaded event makes it ready")
    check(same(webview.webview_title(&wv), "<html><title>Hello page</title></html>"), "title event stored")
    check(webview.webview_doc_height(&wv) == H * 4 as u32, "document height stored")
    check(px_ok(&wv, s, 10, 10), "new page painted")
    var d: webview_types.DamageRect = webview_types.DamageRect { x: 1, y: 1, w: 1, h: 1 }
    webview.webview_damage(&wv, &d)
    check(d.x == 0 as u32 && d.w == W && d.h == H, "damage rectangle reported")
    check(!webview.webview_load(&wv, HTML.p as u64, HTML.n, webview_types.LOAD_URL) && webview.webview_state(&wv) == webview_types.ST_FAILED, "url load without capability fails the widget")
    webview.webview_close(&wv)
    check(webview_stub.stub_destroyed(s), "close destroys the backend")
    webview.webview_close(&wv)
    check(webview.webview_state(&wv) == webview_types.ST_NEW, "close is idempotent")
    webview_stub.stub_free(s)
}

fn test_resize() {
    var wv: webview.WebView = webview.webview_new()
    let s: *mut webview_stub.Stub = open_stub(&wv, 0 as u32)
    webview.webview_tick(&wv, 0)
    webview.webview_resize(&wv, 40 as u32, 30 as u32, 2000 as u32)
    var w: u32 = 0
    var h: u32 = 0
    webview_stub.stub_size(s, &w, &h)
    check(w == W && h == H, "resize waits for the tick")
    check(webview.webview_tick(&wv, 100), "tick applies the resize")
    webview_stub.stub_size(s, &w, &h)
    check(w == 40 as u32 && h == 30 as u32 && webview_stub.stub_scale(s) == 2000 as u32, "backend got size and scale")
    webview.webview_size(&wv, &w, &h)
    check(w == 40 as u32 && h == 30 as u32, "model size follows")
    let p: u64 = webview.webview_pixels(&wv)
    check(rt.ld32(p + (29 * 4 * 40) as u64, 39) == webview_stub.stub_pixel(s, 39 as u32, 29 as u32), "buffer reallocated and fully repainted")
    webview.webview_close(&wv)
    webview_stub.stub_free(s)
}

fn test_pointer_and_nav() {
    var wv: webview.WebView = webview.webview_new()
    let s: *mut webview_stub.Stub = open_stub(&wv, webview_types.CAP_URL)
    webview.webview_load(&wv, HTML.p as u64, HTML.n, webview_types.LOAD_HTML)
    webview.webview_tick(&wv, 0)
    webview.webview_pointer(&wv, webview_types.IN_MOVE, 5.0, 5.0, 0 as u32, 0 as u32)
    webview.webview_tick(&wv, 1)
    check(same(webview.webview_hover(&wv), webview_stub.LINK_HREF) && webview.webview_cursor(&wv) == 1 as u32, "hover and cursor events arrive")
    webview.webview_pointer(&wv, webview_types.IN_MOVE, 80.0, 50.0, 0 as u32, 0 as u32)
    webview.webview_tick(&wv, 2)
    check(webview.webview_hover(&wv).n == 0 && webview.webview_cursor(&wv) == 0 as u32, "leaving the link clears hover")
    webview.webview_pointer(&wv, webview_types.IN_DOWN, 5.0, 5.0, 0 as u32, 0 as u32)
    webview.webview_pointer(&wv, webview_types.IN_UP, 5.0, 5.0, 0 as u32, 0 as u32)
    webview.webview_tick(&wv, 3)
    check(same(webview.webview_last_nav(&wv), webview_stub.LINK_HREF), "click on a link raises a navigation request")
    check(same(webview.webview_title(&wv), "<html><title>Hello page</title></html>"), "no hook: navigation denied")
    webview.webview_on_nav(&wv, 0, nav_hook)
    NAV_VERDICT = webview_types.NAV_DENY
    webview.webview_pointer(&wv, webview_types.IN_UP, 5.0, 5.0, 0 as u32, 0 as u32)
    webview.webview_tick(&wv, 4)
    check(same(webview.webview_title(&wv), "<html><title>Hello page</title></html>"), "hook deny keeps the page")
    NAV_VERDICT = webview_types.NAV_ALLOW
    webview.webview_pointer(&wv, webview_types.IN_UP, 5.0, 5.0, 0 as u32, 0 as u32)
    webview.webview_tick(&wv, 5)
    webview.webview_tick(&wv, 6)
    check(same(webview.webview_title(&wv), webview_stub.LINK_HREF), "hook allow loads the url")
    webview.webview_wheel(&wv, 10.0, 10.0, 0.0, 3.0, 0 as u32)
    webview.webview_tick(&wv, 7)
    check(webview.webview_scroll(&wv) == 60 as u32 && px_ok(&wv, s, 20, 20), "wheel scrolls and repaints")
    webview.webview_close(&wv)
    webview_stub.stub_free(s)
}

fn test_keys_and_focus() {
    var wv: webview.WebView = webview.webview_new()
    let s: *mut webview_stub.Stub = open_stub(&wv, 0 as u32)
    check(!webview.webview_key(&wv, true, editor.KEY_UP, 0 as u32) && !webview.webview_char(&wv, 97 as u32), "no keys while unfocused")
    webview.webview_pointer(&wv, webview_types.IN_DOWN, 5.0, 5.0, 0 as u32, 0 as u32)
    check(webview.webview_focused(&wv) && webview_stub.stub_input_count(s, webview_types.IN_FOCUS) == 1 as u32, "press takes focus")
    check(webview.webview_key(&wv, true, editor.KEY_UP, 0 as u32) && webview.webview_char(&wv, 97 as u32), "keys and chars forwarded")
    check(!webview.webview_key(&wv, true, editor.KEY_TAB, 0 as u32), "Tab is never forwarded")
    check(webview_stub.stub_input_count(s, webview_types.IN_KEY_DOWN) == 1 as u32 && webview_stub.stub_typed(s) == 1 as u32, "backend saw one key and one char")
    webview.webview_focus(&wv, false)
    check(webview_stub.stub_input_count(s, webview_types.IN_BLUR) == 1 as u32 && !webview.webview_key(&wv, true, editor.KEY_UP, 0 as u32), "blur forwarded and keys stop")
    webview.webview_close(&wv)
    webview_stub.stub_free(s)
}

fn test_ime() {
    var wv: webview.WebView = webview.webview_new()
    let s: *mut webview_stub.Stub = open_stub(&wv, webview_types.CAP_IME)
    webview.webview_on_spot(&wv, 0, spot_hook)
    webview.webview_tick(&wv, 0)
    webview.webview_focus(&wv, true)
    check(webview.webview_tick(&wv, 1) && webview.webview_has_caret(&wv), "caret polled after focus")
    check(SPOT_CALLS == 1 as u32 && SPOT_X == 4.0, "spot hook got the caret position")
    let pre: str = "ka"
    check(webview.webview_preedit(&wv, pre.p as u64, pre.n, 1), "preedit forwarded")
    let com: str = "\u{304b}"
    check(webview.webview_commit(&wv, com.p as u64, com.n), "commit forwarded")
    webview.webview_tick(&wv, 2)
    check(webview_stub.stub_input_count(s, webview_types.IN_PREEDIT) == 1 as u32 && webview_stub.stub_input_count(s, webview_types.IN_COMMIT) == 1 as u32, "backend saw preedit and commit")
    check(SPOT_CALLS == 2 as u32 && SPOT_X == 4.0 + 8.0 * 3.0, "caret follows the typed text")
    webview.webview_preedit(&wv, pre.p as u64, pre.n, 1)
    webview.webview_focus(&wv, false)
    check(webview_stub.stub_input_count(s, webview_types.IN_PREEDIT) == 3 as u32, "blur cancels the preedit")
    webview.webview_close(&wv)
    webview_stub.stub_free(s)
    var wv2: webview.WebView = webview.webview_new()
    let s2: *mut webview_stub.Stub = open_stub(&wv2, 0 as u32)
    webview.webview_focus(&wv2, true)
    let mixed: str = "a\u{e9}\u{20ac}"
    check(webview.webview_commit(&wv2, mixed.p as u64, mixed.n) && webview_stub.stub_input_count(s2, webview_types.IN_CHAR) == 3 as u32, "without IME a commit becomes one char per code point")
    check(!webview.webview_preedit(&wv2, mixed.p as u64, mixed.n, 0), "without IME a preedit is refused")
    webview.webview_close(&wv2)
    webview_stub.stub_free(s2)
}

fn push_text(s: *mut webview_stub.Stub, kind: u32, id: u32, text: str) {
    webview_stub.stub_push_event(s, kind, id, 0 as u32, text.p as u64, text.n)
}

fn test_services() {
    services.use_memory(true)
    var wv: webview.WebView = webview.webview_new()
    let s: *mut webview_stub.Stub = open_stub(&wv, 0 as u32)
    var link: webview_svc.SvcLink = webview_svc.svc_link_new()
    webview_svc.svc_attach(&link, &wv)
    push_text(s, webview_types.EV_CLIP_WRITE, 0 as u32, "secret")
    push_text(s, webview_types.EV_CLIP_READ, ID_CLIP, "")
    webview.webview_tick(&wv, 0)
    check(webview_stub.stub_last_reply_id(s) == ID_CLIP && webview_stub.stub_last_reply_status(s) == 0 as u32, "denied by default: reply status 0")
    services.clip_request()
    var ev: services.SvcEvent = services.event_new()
    services.next(&ev)
    check(ev.status == 0 as u32, "denied clipboard write left the clipboard empty")
    webview.webview_set_perms(&wv, webview_types.PERM_CLIP | webview_types.PERM_DIALOG | webview_types.PERM_FILES)
    push_text(s, webview_types.EV_CLIP_WRITE, 0 as u32, "copied text")
    push_text(s, webview_types.EV_CLIP_READ, ID_CLIP, "")
    webview.webview_tick(&wv, 1)
    check(webview_svc.svc_poll(&link), "clipboard answer polled")
    check(webview_stub.stub_last_reply_id(s) == ID_CLIP && webview_stub.stub_last_reply_status(s) == 1 as u32 && same(webview_stub.stub_last_reply_text(s), "copied text"), "clipboard round trip")
    services.script_answer(services.ANS_YES)
    push_text(s, webview_types.EV_CONFIRM, ID_CONFIRM, "Title\nReally?")
    webview.webview_tick(&wv, 2)
    check(webview_stub.stub_last_reply_id(s) == ID_CONFIRM && webview_stub.stub_last_reply_status(s) == 1 as u32, "confirm answered yes")
    services.script_answer(services.ANS_NO)
    push_text(s, webview_types.EV_CONFIRM, ID_CONFIRM, "Title\nReally?")
    webview.webview_tick(&wv, 3)
    check(webview_stub.stub_last_reply_status(s) == 0 as u32, "confirm answered no")
    services.write_path(FILE_NAME, FILE_DATA.p as u64, FILE_DATA.n)
    services.script_pick(FILE_NAME)
    push_text(s, webview_types.EV_OPEN_FILE, ID_OPEN, "Text|*.txt")
    webview.webview_tick(&wv, 4)
    check(webview_svc.svc_poll(&link), "open answer polled")
    check(webview_stub.stub_last_reply_id(s) == ID_OPEN && same(webview_stub.stub_last_reply_text(s), FILE_DATA), "open file delivers the bytes")
    push_text(s, webview_types.EV_SAVE_FILE, ID_SAVE, "out.txt\npayload")
    services.script_pick("out.txt")
    webview.webview_tick(&wv, 5)
    check(webview_svc.svc_poll(&link), "save answer polled")
    check(webview_stub.stub_last_reply_id(s) == ID_SAVE && webview_stub.stub_last_reply_status(s) == 1 as u32, "save reported ok")
    var back: rt.Buf = rt.buf_new()
    check(services.read_path("out.txt", &back) && same(rt.buf_str(&back), "payload"), "save wrote the data after the first line")
    rt.buf_free(&back)
    webview.webview_set_perms(&wv, 0 as u32)
    push_text(s, webview_types.EV_OPEN_FILE, ID_OPEN, "")
    webview.webview_tick(&wv, 6)
    check(webview_stub.stub_last_reply_status(s) == 0 as u32 && !webview_svc.svc_poll(&link), "files denied without permission")
    services.event_free(&ev)
    webview_svc.svc_link_free(&link)
    webview.webview_close(&wv)
    webview_stub.stub_free(s)
    services.use_memory(false)
}

fn test_raw_service_hook() {
    var wv: webview.WebView = webview.webview_new()
    let s: *mut webview_stub.Stub = open_stub(&wv, 0 as u32)
    push_text(s, webview_types.EV_ALERT, 3 as u32, "Hi\nthere")
    webview.webview_tick(&wv, 0)
    check(SVC_CALLS == 0 as u32, "no hook: service events are dropped")
    webview.webview_on_service(&wv, 0, svc_hook)
    push_text(s, webview_types.EV_ALERT, 3 as u32, "Hi\nthere")
    webview.webview_tick(&wv, 1)
    check(SVC_CALLS == 1 as u32, "hook receives service events")
    var i: u32 = 0
    while i < 69 {
        webview_stub.stub_push_event(s, webview_types.EV_SCROLLED, 1 as u32, 0 as u32, 0, 0)
        i = i + 1
    }
    webview_stub.stub_push_event(s, webview_types.EV_SCROLLED, 2 as u32, 0 as u32, 0, 0)
    webview.webview_tick(&wv, 2)
    check(webview.webview_scroll(&wv) == 1 as u32, "one tick drains at most the event budget")
    webview.webview_tick(&wv, 3)
    check(webview.webview_scroll(&wv) == 2 as u32, "the next tick drains the rest")
    webview.webview_close(&wv)
    webview_stub.stub_free(s)
}

fn test_dead_backend() {
    var wv: webview.WebView = webview.webview_new()
    let s: *mut webview_stub.Stub = open_stub(&wv, 0 as u32)
    webview.webview_tick(&wv, 0)
    webview_stub.stub_kill(s)
    check(webview.webview_tick(&wv, 1), "dead backend reports a change")
    check(webview.webview_state(&wv) == webview_types.ST_FAILED, "state failed")
    check(!webview.webview_tick(&wv, 2) && !webview.webview_pointer(&wv, webview_types.IN_MOVE, 1.0, 1.0, 0 as u32, 0 as u32), "failed widget ignores ticks and input")
    webview.webview_close(&wv)
    webview_stub.stub_free(s)
    var empty: webview.WebView = webview.webview_new()
    var none: webview_types.Backend = webview_types.backend_null()
    check(!webview.webview_open(&empty, &none, W, H) && webview.webview_state(&empty) == webview_types.ST_FAILED, "a backend whose create fails fails the widget")
    webview.webview_close(&empty)
}

fn canvas_order(argb: u32) -> u32 {
    let r: u32 = (argb >> 16) & 255 as u32
    let b: u32 = argb & 255 as u32
    return (argb & 4278255360 as u32) | (b << 16) | r
}

fn test_draw() {
    var wv: webview.WebView = webview.webview_new()
    let s: *mut webview_stub.Stub = open_stub(&wv, 0 as u32)
    webview.webview_tick(&wv, 0)
    var cv: canvas.Canvas = canvas.canvas_new()
    var z: painter.Painter = painter.painter_new()
    canvas.canvas_init(&cv, 200, 120)
    canvas.canvas_clear(&cv, 4286611584 as u32)
    painter.painter_init(&z, &cv, 200, 120)
    webview.webview_draw(&wv, &z, 10.0, 12.0)
    check((canvas.canvas_get(&cv, 10 + 30, 12 + 20) & 16777215 as u32) == (canvas_order(webview_stub.stub_pixel(s, 30 as u32, 20 as u32)) & 16777215 as u32), "pixels land at the node origin")
    check((canvas.canvas_get(&cv, 9, 12) & 16777215 as u32) != (canvas_order(webview_stub.stub_pixel(s, 0 as u32, 0 as u32)) & 16777215 as u32), "nothing is painted outside the node")
    webview_stub.stub_kill(s)
    webview.webview_tick(&wv, 1)
    webview.webview_draw(&wv, &z, 10.0, 12.0)
    check((canvas.canvas_get(&cv, 40, 32) & 16777215 as u32) != (canvas_order(webview_stub.stub_pixel(s, 30 as u32, 20 as u32)) & 16777215 as u32), "failed widget paints the neutral surface")
    webview.webview_close(&wv)
    webview_stub.stub_free(s)
}

fn dump_has(sc: *mut scene.Scene, ax: *mut a11y.A11y, want: str) -> bool {
    var buf: rt.Buf = rt.buf_new()
    rt.buf_reserve(&buf, 4096)
    let n: usize = a11y.a11y_dump(sc, ax, rt.buf_ptr(&buf), 4096)
    rt.buf_set_len(&buf, n)
    let text: str = rt.buf_str(&buf)
    var i: usize = 0
    var found: bool = false
    while i + want.n <= text.n {
        if rt.mem_eq(text.p as u64 + i as u64, want.p as u64, want.n) {
            found = true
        }
        i = i + 1
    }
    rt.buf_free(&buf)
    return found
}

fn test_ax() {
    var wv: webview.WebView = webview.webview_new()
    let s: *mut webview_stub.Stub = open_stub(&wv, 0 as u32)
    webview.webview_load(&wv, DOC_TITLE.p as u64, DOC_TITLE.n, webview_types.LOAD_HTML)
    webview.webview_tick(&wv, 0)
    webview.webview_pointer(&wv, webview_types.IN_MOVE, 5.0, 5.0, 0 as u32, 0 as u32)
    webview.webview_tick(&wv, 1)
    var sc: scene.Scene = scene.scene_new()
    var ax: a11y.A11y = a11y.a11y_new()
    let root: usize = scene.scene_box(&sc, scene.SCENE_NONE, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    let node: usize = webview_ax.wax_document(&sc, &ax, root, &wv, "Page")
    check(node != scene.SCENE_NONE && a11y.a11y_role(&sc, &ax, node) == a11y.ROLE_DOCUMENT, "node has the document role")
    var rn: [u8; 32] = [0 as u8; 32]
    let len: usize = a11y.a11y_role_name(a11y.ROLE_DOCUMENT, (&rn[0]) as u64, 32)
    check(len == 8 && rn[0] == 100 as u8 && rn[7] == 116 as u8, "role name is document")
    check(dump_has(&sc, &ax, "Doc title") && dump_has(&sc, &ax, "document"), "dump names the document by the page title")
    check(dump_has(&sc, &ax, "https://example.org/next"), "hovered link is the description")
    webview.webview_close(&wv)
    webview_stub.stub_free(s)
}

fn main() -> i32 {
    test_paint_and_load()
    test_resize()
    test_pointer_and_nav()
    test_keys_and_focus()
    test_ime()
    test_services()
    test_raw_service_hook()
    test_dead_backend()
    test_draw()
    test_ax()
    if BAD > 0 {
        say("WEBVIEW FAILED\n")
        return 1
    }
    say("WEBVIEW PASSED\n")
    return 0
}
