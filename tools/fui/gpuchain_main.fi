// SPDX-License-Identifier: MPL-2.0
// tools/fui/gpuchain_main.fi -- unit test of the pure paint-path decisions (lib/plat/gpuchain.fi, W42-b): FUI_GPU -> policy -> order of
// GL / Vulkan / CPU, and a SIMULATION of the whole chain for every combination of "this stage opens / fails" (walk_chain below runs the
// same loop as fuiwin.gpu_start with the answers given instead of real GL / Vulkan). No window, no GPU, no libc. Exit 0 = ok.
import std.io
import plat.gpuchain

static mut FAILS: i32 = 0

fn check(ok: bool, what: str) {
    if !ok {
        FAILS = FAILS + 1
        io.fmt_print(f"FAIL: {what}\n")
    }
}

// same loop as fuiwin.gpu_start: stage by stage in the order next_stage gives; gl_ok / vk_ok say whether that stage would open.
// Returns the stage that ends up painting; `order` gets the stages tried, as digits (1 = GL, 2 = Vulkan), in order.
fn walk_chain(policy: i32, gl_ok: bool, vk_ok: bool, order: *mut i32) -> i32 {
    let provider: bool = gpuchain.plan_provider(policy)
    let force: bool = gpuchain.plan_force(policy)
    var tried: i32 = 0
    var guard: i32 = 0
    var seq: i32 = 0
    while guard < 3 {
        let st: i32 = gpuchain.next_stage(tried, provider, force)
        if st == gpuchain.STAGE_CPU {
            *order = seq
            return gpuchain.STAGE_CPU
        }
        tried = tried | gpuchain.stage_bit(st)
        seq = seq * 10 + st
        if st == gpuchain.STAGE_GL && gl_ok {
            *order = seq
            return st
        }
        if st == gpuchain.STAGE_VULKAN && vk_ok {
            *order = seq
            return st
        }
        guard = guard + 1
    }
    *order = seq
    return gpuchain.STAGE_CPU
}

fn expect(policy: i32, gl_ok: bool, vk_ok: bool, want_stage: i32, want_order: i32, what: str) {
    var order: i32 = 0
    let got: i32 = walk_chain(policy, gl_ok, vk_ok, &order)
    if got != want_stage || order != want_order {
        FAILS = FAILS + 1
        io.fmt_print(f"FAIL: {what}: stage {got} (want {want_stage}), tried {order} (want {want_order})\n")
    }
}

fn main() -> i32 {
    // ---- FUI_GPU + platform -> policy
    check(gpuchain.policy_of("0", "win32") == gpuchain.POLICY_CPU, "0 = CPU also on Windows")
    check(gpuchain.policy_of("0", "linux") == gpuchain.POLICY_CPU, "0 = CPU on Linux")
    check(gpuchain.policy_of("1", "linux") == gpuchain.POLICY_VULKAN, "1 = Vulkan")
    check(gpuchain.policy_of("gl", "linux") == gpuchain.POLICY_GL_FIRST, "gl = GL first")
    check(gpuchain.policy_of("vk", "win32") == gpuchain.POLICY_VULKAN_FIRST, "vk = Vulkan first (real GPU)")
    check(gpuchain.policy_of("", "win32") == gpuchain.POLICY_GL_FIRST, "unset on Windows = GL first")
    check(gpuchain.policy_of("", "linux") == gpuchain.POLICY_CPU, "unset on Linux = CPU")
    check(gpuchain.policy_of("", "android") == gpuchain.POLICY_CPU, "unset elsewhere = CPU")
    check(gpuchain.policy_of("yes", "win32") == gpuchain.POLICY_GL_FIRST, "junk on Windows = platform default")
    check(gpuchain.policy_of("yes", "linux") == gpuchain.POLICY_CPU, "junk on Linux = platform default")
    check(gpuchain.policy_of("2", "win32") == gpuchain.POLICY_GL_FIRST, "2 is not a value: platform default")
    // ---- plan: provider installed? Vulkan before GL? software device allowed?
    check(!gpuchain.plan_provider(gpuchain.POLICY_CPU), "CPU installs no provider")
    check(gpuchain.plan_provider(gpuchain.POLICY_VULKAN) && gpuchain.plan_provider(gpuchain.POLICY_GL_FIRST) && gpuchain.plan_provider(gpuchain.POLICY_VULKAN_FIRST), "the other three install the provider")
    check(gpuchain.plan_force(gpuchain.POLICY_VULKAN) && gpuchain.plan_force(gpuchain.POLICY_VULKAN_FIRST) && !gpuchain.plan_force(gpuchain.POLICY_GL_FIRST) && !gpuchain.plan_force(gpuchain.POLICY_CPU), "force = Vulkan before GL")
    check(gpuchain.plan_allow_cpu(gpuchain.POLICY_VULKAN) && !gpuchain.plan_allow_cpu(gpuchain.POLICY_GL_FIRST) && !gpuchain.plan_allow_cpu(gpuchain.POLICY_VULKAN_FIRST) && !gpuchain.plan_allow_cpu(gpuchain.POLICY_CPU), "a software Vulkan device only for FUI_GPU=1")
    // ---- the chain: order tried (12 = GL then Vulkan, 21 = Vulkan then GL) and the winner, 8 outcomes per policy
    let GL: i32 = gpuchain.STAGE_GL
    let VK: i32 = gpuchain.STAGE_VULKAN
    let CPU: i32 = gpuchain.STAGE_CPU
    // Windows default (GL first): GL ok -> done; GL fails -> Vulkan present; both fail -> CPU
    expect(gpuchain.POLICY_GL_FIRST, true, true, GL, 1, "default: GL ok")
    expect(gpuchain.POLICY_GL_FIRST, true, false, GL, 1, "default: GL ok, Vulkan not asked")
    expect(gpuchain.POLICY_GL_FIRST, false, true, VK, 12, "default: GL fails -> Vulkan")
    expect(gpuchain.POLICY_GL_FIRST, false, false, CPU, 12, "default: GL and Vulkan fail -> CPU")
    // FUI_GPU=1 / vk (Vulkan first): Vulkan ok -> done; Vulkan fails -> GL; both fail -> CPU
    expect(gpuchain.POLICY_VULKAN, true, true, VK, 2, "FUI_GPU=1: Vulkan ok")
    expect(gpuchain.POLICY_VULKAN, true, false, GL, 21, "FUI_GPU=1: Vulkan fails -> GL")
    expect(gpuchain.POLICY_VULKAN, false, true, VK, 2, "FUI_GPU=1: Vulkan ok, GL not asked")
    expect(gpuchain.POLICY_VULKAN, false, false, CPU, 21, "FUI_GPU=1: both fail -> CPU")
    expect(gpuchain.POLICY_VULKAN_FIRST, true, false, GL, 21, "vk: Vulkan fails -> GL")
    expect(gpuchain.POLICY_VULKAN_FIRST, false, false, CPU, 21, "vk: both fail -> CPU")
    expect(gpuchain.POLICY_VULKAN_FIRST, false, true, VK, 2, "vk: Vulkan ok")
    // FUI_GPU=0: nothing is tried, no matter what would open (the provider is not installed, GL is skipped by window_set_gpu(false))
    var order: i32 = 0
    check(walk_chain(gpuchain.POLICY_CPU, true, true, &order) == GL, "CPU policy by itself still walks GL (fuiwin skips the chain with gpu_will=false)")
    // a window without GL (X11, Osum) and no Vulkan provider: the chain has one stage, then the CPU
    check(gpuchain.next_stage(0, false, false) == GL, "no provider: GL first")
    check(gpuchain.next_stage(1, false, false) == CPU, "no provider: GL tried -> CPU (never Vulkan)")
    check(gpuchain.next_stage(3, true, false) == CPU && gpuchain.next_stage(3, true, true) == CPU, "everything tried -> CPU")
    check(gpuchain.next_stage(2, true, false) == GL && gpuchain.next_stage(1, true, true) == VK, "the untried stage comes next")
    // the chain always ends: at most two stages tried, whatever answers come back
    var bits: i32 = 0
    var ok_all: bool = true
    while bits < 32 {
        let pol: i32 = bits % 4
        let gl_ok: bool = (bits / 4) % 2 == 1
        let vk_ok: bool = (bits / 8) % 2 == 1
        var oo: i32 = 0
        let r: i32 = walk_chain(pol, gl_ok, vk_ok, &oo)
        if oo > 21 || (oo >= 10 && oo / 10 == oo % 10) {
            ok_all = false
        }
        // a stage is only the winner if its answer was yes
        if (r == GL && !gl_ok) || (r == VK && !vk_ok) {
            ok_all = false
        }
        // the CPU only wins when every reachable stage said no (GL always is reachable, Vulkan only with the provider)
        let vk_reach: bool = gpuchain.plan_provider(pol)
        if r == CPU && (gl_ok || (vk_ok && vk_reach)) {
            ok_all = false
        }
        bits = bits + 1
    }
    check(ok_all, "chain invariants over all policy x answers")
    if FAILS == 0 {
        io.print("gpuchain: ok\n")
        return 0
    }
    io.fmt_print(f"gpuchain: {FAILS} failures\n")
    return 1
}
