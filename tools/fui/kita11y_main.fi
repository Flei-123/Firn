// SPDX-License-Identifier: MPL-2.0
// tools/fui/kita11y_main.fi -- THE CHECK OF lib/fui/kita11y.fi: every part of the app kit
// describes itself into the accessibility tree.
//
// A window with every part of lib/fui/kit.fi in a known state is described (button,
// tab bar with a badge, sidebar with a header, tile grid with a selected tile, search field
// with text, progress bars, toasts of every kind, an open dialog, an avatar); then
//
//   * the audit of lib/fui/audit.fi must be green: every operable node has a name, no key
//     is doubled, nothing secret, and the count of controls is what was described;
//   * the text dump of the tree (lib/fui/a11y.fi a11y_dump) is compared with the dump written
//     out by hand below: role, name, state and value of every node as a screen reader gets them;
//   * the states follow the part's own state (selected tab, selected nav item, pressed tile,
//     disabled button, a toast that is closing is gone, a closed dialog is absent).
//
//     firnc -o /tmp/kita11y tools/fui/kita11y_main.fi && /tmp/kita11y
import std.rt
import std.io
import fui.scene
import fui.widget
import fui.a11y
import fui.audit
import fui.kit
import fui.kita11y
import fui.wave5

static mut BAD: usize = 0
static mut CHECKS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: io.Fmt) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    io.fmt_print_line(what)
}

fn count_of(dump: str, needle: str) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i + needle.n <= dump.n {
        if rt.mem_eq(dump.p as u64 + i as u64, needle.p as u64, needle.n) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn dump_of(sc: *mut scene.Scene, ax: *mut a11y.A11y, buf: *mut rt.Buf) -> str {
    rt.buf_clear(buf)
    rt.buf_reserve(buf, 16384)
    let n: usize = a11y.a11y_dump(sc, ax, rt.buf_ptr(buf), 16384)
    rt.buf_set_len(buf, n)
    return str { p: rt.ptr_of(rt.buf_ptr(buf)), n: n }
}

#[allow_escape]
fn main() -> i32 {
    var sc: scene.Scene = scene.scene_new()
    var ax: a11y.A11y = a11y.a11y_new()
    var kx: kita11y.KitAx = kita11y.kax_new(&sc, &ax)
    // the state of the window, as the program keeps it
    var tabs: [kit.Tab; 3] = [kit.Tab { icon: kit.ICON_NONE, label: "Installed", badge: 12 },
        kit.Tab { icon: kit.ICON_NONE, label: "Browse", badge: 0 }, kit.Tab { icon: kit.ICON_NONE, label: "Updates", badge: 3 }]
    var items: [kit.NavItem; 4] = [kit.NavItem { icon: kit.ICON_NONE, label: "Library", badge: 0, header: true },
        kit.NavItem { icon: kit.ICON_NONE, label: "Mods", badge: 5, header: false },
        kit.NavItem { icon: kit.ICON_NONE, label: "Worlds", badge: 0, header: false },
        kit.NavItem { icon: kit.ICON_NONE, label: "Settings", badge: 0, header: false }]
    var tiles: [kit.Tile; 2] = [kit.Tile { title: "Sodium", sub: "Rendering engine", badge: "Installed", icon: kit.ICON_NONE, seed: 1 as u32, px: 0, w: 0, h: 0, stride: 0 },
        kit.Tile { title: "Lithium", sub: "Game logic", badge: "", icon: kit.ICON_NONE, seed: 2 as u32, px: 0, w: 0, h: 0, stride: 0 }]
    var search: kit.Search = kit.search_new()
    kit.search_set_text(&search, "fabric")
    var toasts: kit.Toasts = kit.toasts_new()
    kit.toast_push(&toasts, kit.TK_ERROR, "Download failed", "Retry", 1000, 0)
    kit.toast_push(&toasts, kit.TK_SUCCESS, "Profile saved", "", 1000, 0)
    var modal: kit.Modal = kit.modal_new()
    kit.modal_open(&modal, "Delete profile?", 400, 200, 2, 1000)

    let root: usize = kita11y.kax_root(&kx, "Launcher")
    kita11y.kax_nav(&kx, root, &items[0], 4, 1, false)
    kita11y.kax_tabbar(&kx, root, &tabs[0], 3, 0)
    kita11y.kax_search(&kx, root, &search, "Search mods")
    kita11y.kax_grid(&kx, root, &tiles[0], 2, 1)
    kita11y.kax_button(&kx, root, "Play", kit.ST_FOCUS)
    kita11y.kax_button(&kx, root, "Delete profile", kit.ST_DISABLED)
    kita11y.kax_progress(&kx, root, 420, "Downloading 3 of 7")
    kita11y.kax_progress(&kx, root, -1, "")
    kita11y.kax_avatar(&kx, root, "Justin")
    kita11y.kax_toasts(&kx, root, &toasts)
    let dlg: usize = kita11y.kax_modal(&kx, root, &modal)
    kita11y.kax_button(&kx, dlg, "Cancel", 0 as u32)
    kita11y.kax_button(&kx, dlg, "Delete", 0 as u32)

    // 1. the audit is green
    var ra: audit.Audit = audit.audit_tree_ax(&sc, &ax)
    var line: rt.Buf = rt.buf_new()
    audit.audit_line(&ra, &line)
    let aline: str = str { p: rt.ptr_of(rt.buf_ptr(&line)), n: rt.buf_len(&line) }
    io.fmt_print_line(f"  audit: {aline}")
    rt.buf_free(&line)
    check(audit.audit_ok(&ra), f"the audit of the described kit is green")
    check(ra.unnamed == 0, f"no operable part without a name ({ra.controls} controls, {ra.nodes} nodes)")
    // controls: 3 nav items + 3 tabs + search + clear + 2 tiles + 2 buttons + 2 progress? (not operable)
    //           + toast buttons (Retry, Dismiss, Dismiss) + dialog (Close, Cancel, Delete)
    check(ra.controls >= 18, f"the controls of every part are counted ({ra.controls})")

    // 2. the dump, by hand
    var buf: rt.Buf = rt.buf_new()
    let d: str = dump_of(&sc, &ax, &buf)
    io.print_line("---- the dump")
    io.print_line(d)
    io.print_line("----")
    check(count_of(d, "Installed, 12") == 1, f"the tab 'Installed, 12' carries its badge")
    check(count_of(d, "Browse") >= 1 && count_of(d, "Updates, 3") == 1, f"the other tabs")
    check(count_of(d, "Mods, 5") == 1, f"the sidebar item with its badge")
    check(count_of(d, "Sodium, Rendering engine, Installed") == 1, f"the tile reads 'title, subtitle, badge'")
    check(count_of(d, "Lithium, Game logic") == 1, f"a tile without a badge has none")
    check(count_of(d, "Error: Download failed") == 1 && count_of(d, "Success: Profile saved") == 1, f"toasts say their kind")
    check(count_of(d, "Delete profile?") == 1, f"the dialog is named by its title")
    check(count_of(d, "Downloading 3 of 7") == 1 && count_of(d, "Progress, working") == 1, f"the progress bars")
    check(count_of(d, "Justin") == 1, f"the avatar")

    // 3. the states follow the parts
    var found_sel_tab: bool = false
    var found_sel_nav: bool = false
    var found_pressed: bool = false
    var found_disabled: bool = false
    var found_focused: bool = false
    var i: usize = 0
    while i < scene.scene_count(&sc) {
        let st: u32 = a11y.a11y_state(&sc, &ax, i)
        let r: u32 = a11y.a11y_role(&sc, &ax, i)
        if r == a11y.ROLE_TAB && (st & a11y.ST_SELECTED) != 0 as u32 {
            found_sel_tab = true
        }
        if r == a11y.ROLE_MENUITEM && (st & a11y.ST_SELECTED) != 0 as u32 {
            found_sel_nav = true
        }
        if (st & a11y.ST_PRESSED) != 0 as u32 {
            found_pressed = true
        }
        if (st & a11y.ST_DISABLED) != 0 as u32 && r == a11y.ROLE_BUTTON {
            found_disabled = true
        }
        if (st & a11y.ST_FOCUSED) != 0 as u32 {
            found_focused = true
        }
        i = i + 1
    }
    check(found_sel_tab, f"the selected tab is selected")
    check(found_sel_nav, f"the active sidebar item is selected")
    check(found_pressed, f"the selected tile is pressed")
    check(found_disabled, f"the disabled button is disabled")
    check(found_focused, f"the focused button / search field is focused")

    // 4. a closed dialog is absent, a closing toast is gone, the arena is reset
    kit.modal_close(&modal)
    kit.toast_dismiss(&toasts, 1 as u32, 2000)
    kita11y.kax_reset(&kx)
    let root2: usize = kita11y.kax_root(&kx, "Launcher")
    kita11y.kax_toasts(&kx, root2, &toasts)
    let dlg2: usize = kita11y.kax_modal(&kx, root2, &modal)
    check(dlg2 == scene.SCENE_NONE, f"a closed dialog is not described")
    let d2: str = dump_of(&sc, &ax, &buf)
    check(count_of(d2, "Download failed") == 0 && count_of(d2, "Profile saved") == 1, f"a toast that is closing is gone")
    check(scene.scene_count(&sc) < 12, f"after kax_reset the tree starts over ({scene.scene_count(&sc)} nodes)")

    // 5. wave 5: rating, chips, segmented, chart, skeleton, pager
    kita11y.kax_reset(&kx)
    let root3: usize = kita11y.kax_root(&kx, "Wave 5")
    var chips: [wave5.Chip; 2] = [wave5.Chip { label: "Rust", icon: kit.ICON_NONE, selected: true, close: false },
        wave5.Chip { label: "Firn", icon: kit.ICON_NONE, selected: false, close: true }]
    var segs: [wave5.Seg; 3] = [wave5.Seg { label: "Day", icon: kit.ICON_NONE }, wave5.Seg { label: "Week", icon: kit.ICON_NONE },
        wave5.Seg { label: "Month", icon: kit.ICON_NONE }]
    var series: [f64; 4] = [2.0, 9.0, 5.0, 7.0]
    var pg: wave5.Pager = wave5.pager_new(3)
    wave5.pager_goto(&pg, 1)
    kita11y.kax_rating(&kx, root3, "Quality", 5, 2, 7, kit.ST_FOCUS)
    kita11y.kax_range(&kx, root3, "Price", 0, 100, 20, 80, true, 0 as u32)
    kita11y.kax_chips(&kx, root3, "Tags", (&chips[0]) as *mut wave5.Chip, 2, 1)
    kita11y.kax_segmented(&kx, root3, "Range", (&segs[0]) as *mut wave5.Seg, 3, 1)
    kita11y.kax_chart(&kx, root3, "Downloads", (&series[0]) as *mut f64, 4)
    kita11y.kax_skeleton(&kx, root3, "")
    kita11y.kax_pager(&kx, root3, "Gallery", &pg)
    var rb: audit.Audit = audit.audit_tree_ax(&sc, &ax)
    check(audit.audit_ok(&rb) && rb.unnamed == 0, f"the audit of the wave 5 parts is green")
    let d5: str = dump_of(&sc, &ax, &buf)
    io.print_line("---- the dump of wave 5")
    io.print_line(d5)
    io.print_line("----")
    check(count_of(d5, "Quality, 3.5 of 5") == 1, f"a rating reads 'name, 3.5 of 5'")
    check(count_of(d5, "Price, 20 to 80") == 1, f"a range slider reads 'name, lo to hi'")
    check(count_of(d5, "Remove, Firn") == 1 && count_of(d5, "Remove, Rust") == 0, f"only the closable chip has a remove button")
    check(count_of(d5, "Day") == 1 && count_of(d5, "Week") == 1 && count_of(d5, "Month") == 1, f"the segments are radio buttons")
    check(count_of(d5, "Downloads, min 2, max 9, last 7") == 1, f"a chart reads its min, max and last value")
    check(count_of(d5, "Loading") == 1, f"a skeleton is a progress bar 'Loading'")
    check(count_of(d5, "Gallery, page 2 of 3") == 1 && count_of(d5, "Page 1") == 1 && count_of(d5, "Page 3") == 1, f"the pager says which page of how many")
    var rate_ok: bool = false
    var radio_on: bool = false
    var prev_ok: bool = false
    var tab_sel: bool = false
    var pressed_chip: bool = false
    var j: usize = 0
    while j < scene.scene_count(&sc) {
        let r5: u32 = a11y.a11y_role(&sc, &ax, j)
        let st5: u32 = a11y.a11y_state(&sc, &ax, j)
        if r5 == a11y.ROLE_SLIDER && a11y.a11y_value(&sc, j) == 700 && (st5 & a11y.ST_FOCUSED) != 0 as u32 {
            rate_ok = true
        }
        if r5 == a11y.ROLE_RADIO && a11y.a11y_value(&sc, j) == 1 {
            radio_on = true
        }
        if r5 == a11y.ROLE_BUTTON && (st5 & a11y.ST_DISABLED) == 0 as u32 {
            prev_ok = true
        }
        if r5 == a11y.ROLE_TAB && (st5 & a11y.ST_SELECTED) != 0 as u32 {
            tab_sel = true
        }
        if (st5 & a11y.ST_PRESSED) != 0 as u32 {
            pressed_chip = true
        }
        j = j + 1
    }
    check(rate_ok, f"the rating is a focused slider whose value is the filled share (700 of 1000)")
    check(radio_on, f"the chosen segment is on")
    check(prev_ok && tab_sel, f"the pager has working buttons and its current page selected")
    check(pressed_chip, f"the selected chip is pressed")

    rt.buf_free(&buf)
    kita11y.kax_free(&kx)
    kit.search_free(&search)
    say("checks: ")
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&nb, CHECKS as u64)
    rt.write_everything(1, rt.buf_ptr(&nb), rt.buf_len(&nb))
    rt.buf_free(&nb)
    say("\n")
    if BAD == 0 {
        say("KITA11Y PASSED\n")
        return 0
    }
    say("KITA11Y FAILED\n")
    return 1
}
