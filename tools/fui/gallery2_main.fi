// SPDX-License-Identifier: MPL-2.0
// tools/fui/gallery2_main.fi -- WAVE 2 SHOWS ITSELF.
//
// ====================================================== WHY IT EXISTS
//
// Justin: "Build a demo/test program that renders every element in all
// its states, and produce PNG proof (light AND dark). I check the
// pictures myself."
//
// So this is the picture. Every control of wave 2, each one in the
// five states -- normal, hover, pressed, focused, disabled -- plus the
// states that only some of them have (selected, on/off, part-way).
//
//     gallery2_main <out.png> [light|dark] [<font.ttf>]
//
// It paints without a window, straight onto a canvas and out as a PNG,
// so it runs on a server with no screen and the two pictures are
// comparable pixel by pixel.
//
// A control that does not show up here counts as unfinished -- that is
// the rule from the wave 1 gallery, and it still holds.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.wave2
import fui.layout

const FONTSET_BYTES: usize = 4096
const W: usize = 1240
const H: usize = 1180

// The five states, as bit patterns for `w_set_state_bits`. The order is
// the one the columns are read in.
const S_NORMAL: u32 = 0
const S_HOVER: u32 = 1
const S_ACTIVE: u32 = 2
const S_FOCUS: u32 = 4
const S_DISABLED: u32 = 8

fn heading(c: *mut render.Ctx, x: f64, y: f64, p: u64, n: usize) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, 600.0, 18.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(style.TOK_TEXT_MUTED))
    *s = style.style_set_font(*s, 0, 12)
    render.draw_label(c, &e)
}

// A small caption over a single column.
fn caption(c: *mut render.Ctx, x: f64, y: f64, p: u64, n: usize) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, 150.0, 14.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(style.TOK_TEXT_MUTED))
    *s = style.style_set_font(*s, 0, 11)
    render.draw_label(c, &e)
}

// ONE CONTROL IN ALL FIVE STATES, as a row.
//
// This is the function the whole page is built from -- so every control
// really is shown in the same five states, and none of them is quietly
// left out.
fn state_row(c: *mut render.Ctx, kind: u32, y: f64, w: f64, h: f64,
    tp: u64, tn: usize, value: i64, selected: bool) {
    var states: [u32; 5] = [S_NORMAL, S_HOVER, S_ACTIVE, S_FOCUS,
        S_DISABLED]
    var i: usize = 0
    var x: f64 = 150.0
    while i < 5 {
        var e: widget.Widget = widget.widget_new(kind)
        widget.w_place(&e, x, y, w, h)
        widget.w_set_text(&e, tp, tn)
        widget.w_set_value(&e, value)
        var bits: u32 = states[i]
        if selected {
            bits = bits | 16 as u32
        }
        widget.w_set_state_bits(&e, bits)
        // The scrollbar wants to know what share is visible.
        if kind == widget.KIND_SCROLLBAR {
            widget.w_set_pref(&e, 300.0, 300.0)
        }
        wave2.draw_any(c, &e)
        x = x + w + 22.0
        i = i + 1
    }
}

// ====================================================== THE PICTURE ENDS
//                                                        WITH THE CONTENT
//
// The canvas used to be a CONSTANT 1180 px tall while the last row
// stopped at about two thirds of that. The lower third stayed empty --
// in the dark scheme a black block under the picture, which reads like
// a cut-off render. So the height is taken from what was REALLY drawn:
// the lowest row that still carries ink, held against the y the layout
// itself reached, plus one margin. Nothing gets lost, nothing empty
// stays.
const MARGIN: usize = 20

// The lowest row that differs from the page ground, as a HEIGHT (so
// one past the last inked row). A page with nothing on it gives 0.
fn ink_bottom(cv: *mut canvas.Canvas, bg: u32) -> usize {
    let w: usize = canvas.canvas_width(cv)
    var yy: usize = canvas.canvas_height(cv)
    while yy > 0 {
        yy = yy - 1
        var xx: usize = 0
        while xx < w {
            if canvas.canvas_get(cv, xx, yy) != bg {
                return yy + 1
            }
            xx = xx + 1
        }
    }
    return 0
}

// Ink and the tracked y, whichever reaches further down, plus the
// margin -- and never more than the canvas actually has.
fn crop_height(cv: *mut canvas.Canvas, bg: u32, yend: f64) -> usize {
    var h: usize = ink_bottom(cv, bg)
    if yend > 0.0 {
        let t: usize = yend as usize
        if t > h {
            h = t
        }
    }
    h = h + MARGIN
    if h > canvas.canvas_height(cv) {
        h = canvas.canvas_height(cv)
    }
    return h
}

// Copy the top `h` rows over into `dst`, one pixel at a time -- the
// canvas keeps its own stride, so this goes through its own door
// instead of guessing at the buffer.
fn crop_copy(src: *mut canvas.Canvas, dst: *mut canvas.Canvas,
    h: usize) {
    let w: usize = canvas.canvas_width(src)
    var yy: usize = 0
    while yy < h {
        var xx: usize = 0
        while xx < w {
            canvas.canvas_set_raw(dst, xx, yy,
                canvas.canvas_get(src, xx, yy))
            xx = xx + 1
        }
        yy = yy + 1
    }
}

// The label in front of a row.
fn row_label(c: *mut render.Ctx, y: f64, p: u64, n: usize) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, 24.0, y, 120.0, 32.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_font(*s, 0, 13)
    render.draw_label(c, &e)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 48] = "gallery2_main <out.png> [light|dark] [font.ttf]\n"
        rt.write_everything(2, (&u[0]) as u64, 47)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    var dark: bool = true
    if rt.arg_count(start) >= 3 {
        if rt.ld8(rt.arg_ptr(start, 2), 0) == 108 as u8 {
            dark = false
        }
    }

    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
        rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    // OHNE SCHRIFT KEIN BELEG. Ein Bild ohne einen einzigen
    // Buchstaben sieht von weitem aus wie ein Bild, und genau so ist
    // in OrientOS eine textlose Oberflaeche durch die Abnahme
    // gekommen. Ein Beleg ohne Beschriftung belegt nichts -- also
    // Fehler auf fd 2 und ein Rueckgabewert, an dem der Lauf
    // haengenbleibt, statt ein stummes PNG zu schreiben.
    if fm == 0 {
        var ks: [u8; 60] = "gallery2: keine Schrift gefunden -- ohne Schrift kein Beleg\n"
        rt.write_everything(2, (&ks[0]) as u64, 60)
        return 9
    }

    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 300) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(dark)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque((*f).base))

    var y: f64 = 20.0

    // ---- the column captions
    var h_states: [u8; 44] = "WAVE 2 -- every control in all five states  "
    heading(&c, 24.0, y, (&h_states[0]) as u64, 42)
    y = y + 22.0
    var cn: [u8; 6] = "normal"
    var chv: [u8; 5] = "hover"
    var cpr: [u8; 7] = "pressed"
    var cfo: [u8; 7] = "focused"
    var cdi: [u8; 8] = "disabled"
    caption(&c, 150.0, y, (&cn[0]) as u64, 6)
    caption(&c, 322.0, y, (&chv[0]) as u64, 5)
    caption(&c, 494.0, y, (&cpr[0]) as u64, 7)
    caption(&c, 666.0, y, (&cfo[0]) as u64, 7)
    caption(&c, 838.0, y, (&cdi[0]) as u64, 8)
    y = y + 18.0

    let rw: f64 = 150.0
    let rh: f64 = 32.0
    let step: f64 = 44.0

    // ---- CHECKBOX, off and on
    var l_cb: [u8; 12] = "Checkbox off"
    var t_cb: [u8; 6] = "Option"
    row_label(&c, y, (&l_cb[0]) as u64, 12)
    state_row(&c, widget.KIND_CHECKBOX, y, rw, rh, (&t_cb[0]) as u64,
        6, 0, false)
    y = y + step

    var l_cb2: [u8; 11] = "Checkbox on"
    row_label(&c, y, (&l_cb2[0]) as u64, 11)
    state_row(&c, widget.KIND_CHECKBOX, y, rw, rh, (&t_cb[0]) as u64,
        6, 1, true)
    y = y + step

    var l_cb3: [u8; 16] = "Checkbox partial"
    row_label(&c, y, (&l_cb3[0]) as u64, 16)
    state_row(&c, widget.KIND_CHECKBOX, y, rw, rh, (&t_cb[0]) as u64,
        6, wave2.CHECK_PARTIAL, true)
    y = y + step

    // ---- RADIO
    var l_rb: [u8; 9] = "Radio off"
    var t_rb: [u8; 6] = "Choice"
    row_label(&c, y, (&l_rb[0]) as u64, 9)
    state_row(&c, widget.KIND_RADIO, y, rw, rh, (&t_rb[0]) as u64, 6,
        0, false)
    y = y + step

    var l_rb2: [u8; 8] = "Radio on"
    row_label(&c, y, (&l_rb2[0]) as u64, 8)
    state_row(&c, widget.KIND_RADIO, y, rw, rh, (&t_rb[0]) as u64, 6,
        1, true)
    y = y + step

    // ---- TOGGLE
    var l_tg: [u8; 10] = "Toggle off"
    var t_tg: [u8; 6] = "Wi-Fi "
    row_label(&c, y, (&l_tg[0]) as u64, 10)
    state_row(&c, widget.KIND_TOGGLE, y, rw, rh, (&t_tg[0]) as u64, 5,
        0, false)
    y = y + step

    var l_tg2: [u8; 9] = "Toggle on"
    row_label(&c, y, (&l_tg2[0]) as u64, 9)
    state_row(&c, widget.KIND_TOGGLE, y, rw, rh, (&t_tg[0]) as u64, 5,
        1, true)
    y = y + step

    // ---- SLIDER
    var l_sl: [u8; 10] = "Slider 30%"
    var t_none: [u8; 1] = " "
    row_label(&c, y, (&l_sl[0]) as u64, 10)
    state_row(&c, widget.KIND_SLIDER, y, rw, 28.0, (&t_none[0]) as u64,
        0, 300, false)
    y = y + step

    var l_sl2: [u8; 10] = "Slider 80%"
    row_label(&c, y, (&l_sl2[0]) as u64, 10)
    state_row(&c, widget.KIND_SLIDER, y, rw, 28.0, (&t_none[0]) as u64,
        0, 800, false)
    y = y + step

    // ---- SCROLLBAR
    var l_sc: [u8; 9] = "Scrollbar"
    row_label(&c, y, (&l_sc[0]) as u64, 9)
    state_row(&c, widget.KIND_SCROLLBAR, y, rw, 16.0,
        (&t_none[0]) as u64, 0, 400, false)
    y = y + step

    // ---- PROGRESS
    var l_pr: [u8; 12] = "Progress 60%"
    row_label(&c, y, (&l_pr[0]) as u64, 12)
    state_row(&c, widget.KIND_PROGRESS, y, rw, 14.0,
        (&t_none[0]) as u64, 0, 600, false)
    y = y + step

    // ---- DROPDOWN
    var l_dd: [u8; 8] = "Dropdown"
    var t_dd: [u8; 9] = "Choose..."
    row_label(&c, y, (&l_dd[0]) as u64, 8)
    state_row(&c, widget.KIND_DROPDOWN, y, rw, rh, (&t_dd[0]) as u64,
        9, 0, false)
    y = y + step

    // ---- TAB, unselected and selected
    var l_tb: [u8; 12] = "Tab inactive"
    var t_tb: [u8; 8] = "Overview"
    row_label(&c, y, (&l_tb[0]) as u64, 12)
    state_row(&c, widget.KIND_TAB, y, rw, rh, (&t_tb[0]) as u64, 8, 0,
        false)
    y = y + step

    var l_tb2: [u8; 12] = "Tab selected"
    row_label(&c, y, (&l_tb2[0]) as u64, 12)
    state_row(&c, widget.KIND_TAB, y, rw, rh, (&t_tb[0]) as u64, 8, 0,
        true)
    y = y + step + 8.0

    // ==================================================================
    // THE COMPOSED ONES -- they only make sense in context
    // ==================================================================
    var h_comp: [u8; 42] = "COMPOSED -- bar, menu, tooltip, group box "
    heading(&c, 24.0, y, (&h_comp[0]) as u64, 41)
    y = y + 26.0

    // ---- A REAL TOOLBAR with real controls on it.
    //
    // This is the point of `draw_toolbar`: the strip is drawn by the
    // library, and what sits on it are ORDINARY widgets through the
    // ordinary dispatcher. A toolbar that painted its own buttons
    // would be the second drawing of a button -- exactly what the
    // OrientOS control centre did wrong.
    var tb: widget.Widget = widget.widget_new(widget.KIND_TOOLBAR)
    widget.w_place(&tb, 24.0, y, 560.0, 44.0)
    wave2.draw_any(&c, &tb)
    var tb_b1: [u8; 4] = "Open"
    var tb_b2: [u8; 4] = "Save"
    var tb_b3: [u8; 5] = "Print"
    var bx: f64 = 32.0
    var bi: usize = 0
    while bi < 3 {
        var b: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
        widget.w_place(&b, bx, y + 6.0, 90.0, 32.0)
        if bi == 0 {
            widget.w_set_text(&b, (&tb_b1[0]) as u64, 4)
        } else if bi == 1 {
            widget.w_set_text(&b, (&tb_b2[0]) as u64, 4)
            widget.w_set_hover(&b, true)
        } else {
            widget.w_set_text(&b, (&tb_b3[0]) as u64, 5)
            widget.w_set_disabled(&b, true)
        }
        wave2.draw_any(&c, &b)
        bx = bx + 98.0
        bi = bi + 1
    }
    // a separator and a slider on the same bar
    var sep: widget.Widget = widget.widget_new(widget.KIND_SEPARATOR)
    widget.w_place(&sep, bx + 4.0, y + 10.0, 1.0, 24.0)
    wave2.draw_any(&c, &sep)
    var vol: widget.Widget = widget.widget_new(widget.KIND_SLIDER)
    widget.w_place(&vol, bx + 18.0, y + 8.0, 140.0, 28.0)
    widget.w_set_value(&vol, 650)
    wave2.draw_any(&c, &vol)

    // ---- A TAB BAR, really as a row
    var tabs: [widget.Widget; 4] =
        [widget.widget_new(widget.KIND_TAB); 4]
    var tt1: [u8; 5] = "Files"
    var tt2: [u8; 4] = "Edit"
    var tt3: [u8; 4] = "View"
    var tt4: [u8; 4] = "Help"
    var tbar: widget.Widget = widget.widget_new(widget.KIND_TOOLBAR)
    widget.w_place(&tbar, 620.0, y, 560.0, 44.0)
    var ti: usize = 0
    while ti < 4 {
        widget.w_place(&tabs[ti], 620.0 + (ti as f64) * 120.0, y,
            120.0, 44.0)
        if ti == 0 {
            widget.w_set_text(&tabs[ti], (&tt1[0]) as u64, 5)
            widget.w_set_selected(&tabs[ti], true)
        } else if ti == 1 {
            widget.w_set_text(&tabs[ti], (&tt2[0]) as u64, 4)
        } else if ti == 2 {
            widget.w_set_text(&tabs[ti], (&tt3[0]) as u64, 4)
            widget.w_set_hover(&tabs[ti], true)
        } else {
            widget.w_set_text(&tabs[ti], (&tt4[0]) as u64, 4)
            widget.w_set_disabled(&tabs[ti], true)
        }
        ti = ti + 1
    }
    wave2.draw_tabbar(&c, &tbar, (&tabs[0]) as *mut widget.Widget, 4)
    y = y + 60.0

    // ---- A MENU with real lines
    var mn: widget.Widget = widget.widget_new(widget.KIND_MENU)
    let mh: f64 = wave2.menu_item_height(&c)
    widget.w_place(&mn, 24.0, y, 220.0, mh * 5.0 + 8.0)
    wave2.draw_any(&c, &mn)
    var mi1: [u8; 4] = "Undo"
    var mi2: [u8; 4] = "Redo"
    var mi3: [u8; 9] = "Word wrap"
    var mi4: [u8; 12] = "Export as..."
    var mi5: [u8; 6] = "Delete"
    var mi: usize = 0
    while mi < 5 {
        var it: widget.Widget = widget.widget_new(widget.KIND_MENU)
        widget.w_place(&it, 28.0, y + 4.0 + (mi as f64) * mh, 212.0, mh)
        var checked: bool = false
        var sub: bool = false
        if mi == 0 {
            widget.w_set_text(&it, (&mi1[0]) as u64, 4)
        } else if mi == 1 {
            widget.w_set_text(&it, (&mi2[0]) as u64, 4)
            widget.w_set_hover(&it, true)
        } else if mi == 2 {
            widget.w_set_text(&it, (&mi3[0]) as u64, 9)
            checked = true
        } else if mi == 3 {
            widget.w_set_text(&it, (&mi4[0]) as u64, 12)
            sub = true
        } else {
            widget.w_set_text(&it, (&mi5[0]) as u64, 6)
            widget.w_set_disabled(&it, true)
        }
        wave2.draw_menu_item(&c, &it, checked, sub)
        mi = mi + 1
    }

    // ---- A TOOLTIP, measured by the library itself
    //
    // IT IS MEASURED AND NOT GUESSED. `tooltip_size` gives the size for
    // the text, so nothing is cut off -- and the check in
    // wave2_main.fi test 8 reads the ring around it to show that
    // nothing is painted OUTSIDE it either. That is the grey box
    // Justin saw, and this is where you can see that it is gone.
    var tp: widget.Widget = widget.widget_new(widget.KIND_TOOLTIP)
    var ttx: [u8; 27] = "Saves the file to your disk"
    var tw: f64 = 0.0
    var th: f64 = 0.0
    wave2.tooltip_size(&c, (&ttx[0]) as u64, 27, &tw, &th)
    widget.w_place(&tp, 300.0, y + 20.0, tw, th)
    widget.w_set_text(&tp, (&ttx[0]) as u64, 27)
    wave2.draw_any(&c, &tp)

    var cap_tt: [u8; 29] = "tooltip -- no box behind it  "
    caption(&c, 300.0, y + 20.0 + th + 8.0, (&cap_tt[0]) as u64, 28)

    // ---- A GROUP BOX with controls inside it
    var gb: widget.Widget = widget.widget_new(widget.KIND_GROUPBOX)
    var gbt: [u8; 8] = "Settings"
    widget.w_place(&gb, 620.0, y + 14.0, 300.0, 120.0)
    widget.w_set_text(&gb, (&gbt[0]) as u64, 8)
    wave2.draw_any(&c, &gb)
    var g1: widget.Widget = widget.widget_new(widget.KIND_CHECKBOX)
    var g1t: [u8; 15] = "Start with boot"
    widget.w_place(&g1, 640.0, y + 34.0, 260.0, 28.0)
    widget.w_set_text(&g1, (&g1t[0]) as u64, 15)
    widget.w_set_value(&g1, 1)
    widget.w_set_selected(&g1, true)
    wave2.draw_any(&c, &g1)
    var g2: widget.Widget = widget.widget_new(widget.KIND_RADIO)
    var g2t: [u8; 10] = "Light mode"
    widget.w_place(&g2, 640.0, y + 64.0, 260.0, 28.0)
    widget.w_set_text(&g2, (&g2t[0]) as u64, 10)
    wave2.draw_any(&c, &g2)
    var g3: widget.Widget = widget.widget_new(widget.KIND_RADIO)
    var g3t: [u8; 9] = "Dark mode"
    widget.w_place(&g3, 640.0, y + 94.0, 260.0, 28.0)
    widget.w_set_text(&g3, (&g3t[0]) as u64, 9)
    widget.w_set_value(&g3, 1)
    widget.w_set_selected(&g3, true)
    wave2.draw_any(&c, &g3)

    // ---- an upright scrollbar next to it
    var vsb: widget.Widget = widget.widget_new(widget.KIND_SCROLLBAR)
    widget.w_place(&vsb, 960.0, y + 14.0, 16.0, 120.0)
    widget.w_set_value(&vsb, 300)
    widget.w_set_pref(&vsb, 0.0, 400.0)
    wave2.draw_any(&c, &vsb)

    // ---- an upright slider, so both directions are shown
    var vsl: widget.Widget = widget.widget_new(widget.KIND_SLIDER)
    widget.w_place(&vsl, 1000.0, y + 14.0, 28.0, 120.0)
    widget.w_set_value(&vsl, 700)
    wave2.draw_any(&c, &vsl)

    // ---- WRITING IT OUT, CUT TO THE CONTENT
    //
    // The last band is the upright scrollbar and slider: they start at
    // `y + 14` and are 120 tall, so that is how far the layout got.
    let used: usize = crop_height(&cv, theme.opaque((*f).base),
        y + 14.0 + 120.0)
    var oc: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&oc, W, used) {
        return 4
    }
    crop_copy(&cv, &oc, used)

    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&oc, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < rt.c_length(path) {
        rt.buf_push(&pf, rt.ld8(path, k))
        k = k + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 10] = "GALLERY 2\n"
    rt.write_everything(1, (&okm[0]) as u64, 10)
    painter.painter_free(&z)
    canvas.canvas_free(&oc)
    canvas.canvas_free(&cv)
    return 0
}
