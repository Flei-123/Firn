// SPDX-License-Identifier: MPL-2.0
// tools/fui/tablex_main.fi -- the TABLE, W34: caret by mouse click in the open cell editor (click, double click, drag) and the rows /
// cells of the table in the a11y tree (a11y model, dump, JSON, UIA elements, AT-SPI object count).
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.wave8m
import fui.wave11
import fui.vlist
import fui.inspect
import fui.safeout
import fui.sheet
import fui.anim
import fui.style
import fui.a11y
import fui.render
import fui.uia
import fui.atspi
import fui.textbuf

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

static mut CLOCK: i64 = 1000

fn tick(a: *mut app.App, ms: i64) {
    CLOCK = ms
    fuiwirt.host_tick(app.app_host(a), ms)
}

#[allow_escape]
fn dlen(a: *mut app.App, node: usize, p: *mut [u8; 192]) -> usize {
    return a11y.a11y_description(app.app_scene(a), app.ax(a), node, (&(*p)[0]) as u64, 192)
}

#[allow_escape]
fn desc_has(a: *mut app.App, node: usize, what: str) -> bool {
    var db: [u8; 192] = [0 as u8; 192]
    let n: usize = dlen(a, node, &db)
    return has((&db[0]) as u64, n, what)
}

fn has(buf: u64, n: usize, what: str) -> bool {
    if what.n > n {
        return false
    }
    var i: usize = 0
    while i + what.n <= n {
        var j: usize = 0
        while j < what.n && *((buf + (i + j) as u64) as *mut u8) == *((what.p as u64 + j as u64) as *mut u8) {
            j = j + 1
        }
        if j == what.n {
            return true
        }
        i = i + 1
    }
    return false
}

fn same(a: str, b: str) -> bool {
    if a.n != b.n {
        return false
    }
    var i: usize = 0
    while i < a.n {
        if *((a.p as u64 + i as u64) as *mut u8) != *((b.p as u64 + i as u64) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return true
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

fn act(a: *mut app.App) {
    let i: usize = fuiwirt.host_take_activated(app.app_host(a))
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
}

fn click_at(a: *mut app.App, s: *mut Surface, x: f64, y: f64) {
    let w: *mut fuiwirt.Host = app.app_host(a)
    CLOCK = CLOCK + 30
    tick(a, CLOCK)
    let c1: u32 = fuiwirt.host_pointer_move(w, x, y)
    tick(a, CLOCK)
    let c2: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let c3: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
    act(a)
    frame(a, s)
}

fn key(a: *mut app.App, s: *mut Surface, k: u32, mods: u32) {
    let used: bool = app.app_key(a as u64, k, mods)
    frame(a, s)
}

fn type_text(a: *mut app.App, s: *mut Surface, t: str) {
    var i: usize = 0
    while i < t.n {
        let b: bool = app.app_char(a as u64, rt.ld8(t.p as u64, i) as u32, 0 as u32)
        i = i + 1
    }
    frame(a, s)
}

// window x / y of a cell (inside it) and of the header
fn cell_x(a: *mut app.App, t: usize, col: usize) -> f64 {
    let v: *mut vlist.Vlist = app.vlist_model(a, t)
    return (*v).x + vlist.vl_col_x(v, col) + 12.0
}

fn cell_y(a: *mut app.App, t: usize, row: usize) -> f64 {
    let v: *mut vlist.Vlist = app.vlist_model(a, t)
    return vlist.vl_body_y(v) + vlist.vl_row_top(v, row) - vlist.vl_scroll_y(v) + vlist.vl_height_of(v, row) / 2.0
}

fn head_y(a: *mut app.App, t: usize) -> f64 {
    let v: *mut vlist.Vlist = app.vlist_model(a, t)
    return (*v).y + vlist.vl_header_h(v) / 2.0
}

fn cell_is(a: *mut app.App, t: usize, row: usize, col: usize, what: str) -> bool {
    return same(appctl.table_cell(a, t, row, col), what)
}

fn put(a: *mut app.App, t: usize, name: str, age: str, id: str) {
    let r: usize = appctl.table_add_row(a, t)
    appctl.table_set(a, t, r, 0, name)
    appctl.table_set(a, t, r, 1, age)
    appctl.table_set(a, t, r, 2, id)
}

fn drag_at(a: *mut app.App, s: *mut Surface, x1: f64, x2: f64, y: f64) {
    let w: *mut fuiwirt.Host = app.app_host(a)
    CLOCK = CLOCK + 900
    tick(a, CLOCK)
    let c1: u32 = fuiwirt.host_pointer_move(w, x1, y)
    tick(a, CLOCK)
    let c2: u32 = fuiwirt.host_pointer_down(w, x1, y, fuiwirt.BTN_LEFT)
    tick(a, CLOCK + 10)
    let c3: u32 = fuiwirt.host_pointer_move(w, x2, y)
    tick(a, CLOCK + 20)
    let c4: u32 = fuiwirt.host_pointer_up(w, x2, y, fuiwirt.BTN_LEFT)
    frame(a, s)
}

fn slow_click(a: *mut app.App, s: *mut Surface, x: f64, y: f64) {
    CLOCK = CLOCK + 900
    click_at(a, s, x, y)
}

fn edit_is(a: *mut app.App, t: usize, what: str) -> bool {
    return same(appctl.table_edit_text(a, t), what)
}

fn cell_left(a: *mut app.App, t: usize, col: usize) -> f64 {
    let v: *mut vlist.Vlist = app.vlist_model(a, t)
    return (*v).x + vlist.vl_col_x(v, col)
}

#[allow_escape]
fn name_of(a: *mut app.App, row: usize, col: usize, what: str, t: usize) -> bool {
    var b: [u8; 128] = [0 as u8; 128]
    let n: usize = a11y.a11y_vcell_name(app.ax(a), t, row, col, (&b[0]) as u64, 128)
    return n == what.n && has((&b[0]) as u64, n, what)
}

#[allow_escape]
fn name_len(a: *mut app.App, t: usize, row: usize, col: usize) -> usize {
    var b: [u8; 128] = [0 as u8; 128]
    return a11y.a11y_vcell_name(app.ax(a), t, row, col, (&b[0]) as u64, 128)
}

fn dump_has(a: *mut app.App, what: str) -> bool {
    let buf: u64 = rt.heap_alloc(65536)
    let n: usize = a11y.a11y_dump(app.app_scene(a), app.ax(a), buf, 65536)
    var m: usize = n
    if m > 65536 {
        m = 65536
    }
    return has(buf, m, what)
}

fn json_has(a: *mut app.App, what: str) -> bool {
    let buf: u64 = rt.heap_alloc(131072)
    let n: usize = a11y.a11y_dump_json(app.app_scene(a), app.ax(a), buf, 131072)
    var m: usize = n
    if m > 131072 {
        m = 131072
    }
    return has(buf, m, what)
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("tablex: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Table", 640, 360)
    let t: usize = appctl.table(a, "People", 560, 240, 3, changed)
    appctl.table_col(a, t, 0, "Name", 200, false)
    appctl.table_col(a, t, 1, "Age", 120, false)
    appctl.table_col(a, t, 2, "ID", 160, true)
    put(a, t, "Carla", "41", "c-03")
    put(a, t, "anna", "7", "a-01")
    put(a, t, "Bruno", "25", "b-02")
    let s: *mut Surface = surface_for(a, 640, 360)
    fuiwirt.host_bind(app.app_host(a))
    let sc: *mut scene.Scene = app.app_scene(a)
    let ax: *mut a11y.A11y = app.ax(a)
    settle(a, s)
    settle(a, s)
    let y0: f64 = cell_y(a, t, 0)
    let x0: f64 = cell_left(a, t, 0)

    // ---- caret by click
    slow_click(a, s, cell_x(a, t, 0), y0)
    check(!appctl.table_editing(a, t), "a click on a cell does not begin editing")
    key(a, s, appctl.KEY_F2, 0 as u32)
    check(appctl.table_editing(a, t) && edit_is(a, t, "Carla") && appctl.table_edit_caret(a, t) == 5, "F2: editor open, caret at the end")
    slow_click(a, s, x0 + 1.0, y0)
    check(appctl.table_editing(a, t), "a click inside the open editor keeps editing")
    check(appctl.table_edit_caret(a, t) == 0 && appctl.table_edit_anchor(a, t) == 0, "click at the left edge: caret 0, no selection")
    slow_click(a, s, x0 + 25.0, y0)
    let mid: usize = appctl.table_edit_caret(a, t)
    check(mid > 0 && mid < 5 && appctl.table_edit_anchor(a, t) == mid, "click in the middle of the text: caret inside it")
    type_text(a, s, "X")
    check(edit_is(a, t, "Carla") == false && appctl.table_edit_text(a, t).n == 6, "typing inserts at the clicked caret")
    slow_click(a, s, x0 + 190.0, y0)
    check(appctl.table_edit_caret(a, t) == 6, "click right of the text: caret at the end")
    // double click = word
    slow_click(a, s, x0 + 20.0, y0)
    click_at(a, s, x0 + 20.0, y0)
    check(appctl.table_editing(a, t) && appctl.table_edit_anchor(a, t) != appctl.table_edit_caret(a, t), "double click selects a word")
    // drag selects
    drag_at(a, s, x0 + 2.0, x0 + 190.0, y0)
    check(appctl.table_edit_anchor(a, t) == 0 && appctl.table_edit_caret(a, t) == 6, "drag from the left to the right selects all")
    drag_at(a, s, x0 + 190.0, x0 + 2.0, y0)
    check(appctl.table_edit_anchor(a, t) == 6 && appctl.table_edit_caret(a, t) == 0, "drag back selects the other way")
    check(appctl.table_editing(a, t), "dragging does not end the edit")
    // a click elsewhere still commits
    slow_click(a, s, cell_x(a, t, 1), cell_y(a, t, 2))
    check(!appctl.table_editing(a, t) && appctl.table_cursor_row(a, t) == 2 && appctl.table_cursor_col(a, t) == 1, "a click on another cell commits and moves the cursor")
    check(!cell_is(a, t, 0, 0, "Carla") && appctl.table_cell(a, t, 0, 0).n == 6, "the typed text was committed")
    // a click on a cell of ANOTHER column while editing (cell 2,1): caret works there too
    key(a, s, appctl.KEY_F2, 0 as u32)
    check(edit_is(a, t, "25"), "second cell: editor holds 25")
    slow_click(a, s, cell_left(a, t, 1) + 1.0, cell_y(a, t, 2))
    check(appctl.table_editing(a, t) && appctl.table_edit_caret(a, t) == 0, "caret by click in a cell of the second column")
    key(a, s, editor.KEY_ESC, 0 as u32)

    // ---- a11y: rows and cells
    appctl.table_set_cursor(a, t, 1, 1)
    settle(a, s)
    check(a11y.a11y_vtable(ax, t) && a11y.a11y_vrow_role(ax, t) == a11y.ROLE_ROW, "a11y: the rows of the table are role row")
    check(a11y.a11y_vcol_count(ax, t) == 3, "a11y: 3 cells per row")
    check(a11y.a11y_vrow_end(ax, t) - a11y.a11y_vrow_first(ax, t) == 3, "a11y: 3 rows show")
    check(name_of(a, 0, 1, "41", t) && name_of(a, 1, 0, "anna", t) && name_of(a, 2, 2, "b-02", t), "a11y: the cell names are the cell texts")
    var q: [i64; 4] = [0; 4]
    var r: [i64; 4] = [0; 4]
    a11y.a11y_vcell_rect(sc, ax, t, 1, 1, &q)
    a11y.a11y_vrow_rect(sc, ax, t, 1, &r)
    check(q[2] == 120 && q[1] == r[1] && q[3] == r[3] && q[0] >= r[0] && q[0] + q[2] <= r[0] + r[2], "a11y: the cell rectangle lies in its row (column width 120)")
    check(dump_has(a, "row \"anna 7 a-01\"") || dump_has(a, "row \"anna"), "dump: a row line")
    check(dump_has(a, "cell \"anna\"") && dump_has(a, "cell \"41\"") && dump_has(a, "pos=2/3 virtual"), "dump: cell lines with pos=column/columns")
    check(!dump_has(a, "listitem \"anna"), "dump: no listitem for a table row")
    check(json_has(a, "\"role\":\"row\"") && json_has(a, "\"role\":\"cell\""), "json: row and cell objects")
    // focus + selection
    slow_click(a, s, cell_x(a, t, 1), cell_y(a, t, 1))
    settle(a, s)
    check(appctl.table_cursor_row(a, t) == 1 && appctl.table_cursor_col(a, t) == 1, "cursor on (1, 1)")
    let sc1: u32 = a11y.a11y_vcell_state(sc, ax, t, 1, 1)
    let sc0: u32 = a11y.a11y_vcell_state(sc, ax, t, 1, 0)
    let sc2: u32 = a11y.a11y_vcell_state(sc, ax, t, 0, 1)
    check((sc1 & a11y.ST_SELECTED) != 0 as u32 && (sc0 & a11y.ST_SELECTED) != 0 as u32 && (sc2 & a11y.ST_SELECTED) == 0 as u32, "a11y: the cells of the selected row are selected")
    check((sc1 & a11y.ST_FOCUSED) != 0 as u32, "a11y: the cursor cell is focused")
    check((sc0 & a11y.ST_FOCUSED) == 0 as u32 && (sc2 & a11y.ST_FOCUSED) == 0 as u32, "a11y: no other cell is focused")
    key(a, s, editor.KEY_LEFT, 0 as u32)
    settle(a, s)
    check(appctl.table_cursor_col(a, t) == 0, "Left moves the cursor column")
    check((a11y.a11y_vcell_state(sc, ax, t, 1, 0) & a11y.ST_FOCUSED) != 0 as u32 && (a11y.a11y_vcell_state(sc, ax, t, 1, 1) & a11y.ST_FOCUSED) == 0 as u32, "a11y: the focus follows the cursor column")
    // sort: names follow the data
    click_at(a, s, cell_x(a, t, 1), head_y(a, t))
    settle(a, s)
    check(name_of(a, 0, 0, "anna", t) && name_len(a, t, 2, 0) == 6, "a11y: after a sort the cells show the new order")

    // ---- UIA elements
    var pv: uia.Provider = uia.provider_new(sc, ax, "Table")
    let en: uia.El = uia.el_from_node(&pv, t)
    check(uia.el_control_type(&pv, en) == uia.CT_TABLE, "UIA: the table node is a Table")
    check(uia.el_child_count(&pv, en) == 3 + uia.el_head_count(&pv, en), "UIA: the table has 3 row children + its header cells (no scene children)")
    // W38: header cells are the last children, type HeaderItem, named like the column
    if uia.el_head_count(&pv, en) > 0 {
        let h0: uia.El = uia.el_head_at(&pv, en, 0)
        check(uia.el_control_type(&pv, h0) == uia.CT_HEADERITEM, "UIA: a header cell is a HeaderItem")
        check(uia.el_equal(uia.el_last_child(&pv, en), uia.el_head_at(&pv, en, uia.el_head_count(&pv, en) - 1)), "UIA: the header cells come after the rows")
    }
    let er: uia.El = uia.el_first_child(&pv, en)
    check(uia.el_control_type(&pv, er) == uia.CT_DATAITEM, "UIA: a row is a DataItem")
    check(uia.el_has_pattern(&pv, er, uia.PAT_SELITEM), "UIA: a row has the SelectionItem pattern")
    check(uia.el_child_count(&pv, er) == 3, "UIA: a row has 3 cell children")
    let ec: uia.El = uia.el_first_child(&pv, er)
    var nb: [u8; 64] = [0 as u8; 64]
    let nn: usize = uia.el_name(&pv, ec, (&nb[0]) as u64, 64)
    check(nn == 4 && has((&nb[0]) as u64, nn, "anna"), "UIA: the first cell is named 'anna'")
    let ec2: uia.El = uia.el_next(&pv, ec)
    check(uia.el_equal(uia.el_parent(&pv, ec2), er) && uia.el_equal(uia.el_prev(&pv, ec2), ec), "UIA: next / prev / parent of cells")
    check(!uia.el_is_none(uia.el_next(&pv, ec2)) && uia.el_is_none(uia.el_next(&pv, uia.el_next(&pv, ec2))), "UIA: three cells, then none")
    var rb: [i64; 4] = [0; 4]
    uia.el_rect(&pv, ec2, &rb)
    check(rb[2] == 120, "UIA: the cell rectangle has the column width")
    var idb: rt.Buf = rt.buf_new()
    let idn: usize = uia.el_automation_id(ec2, &idb)
    check(idn > 0, "UIA: a cell has an automation id")
    rt.buf_free(&idb)
    let hit: uia.El = uia.el_from_point(&pv, (rb[0] + 5) as i64, rb[1] + rb[3] / 2)
    check(uia.el_equal(hit, ec2), "UIA: the point in a cell finds that cell")
    var rid1: [i32; 3] = [0; 3]
    var rid2: [i32; 3] = [0; 3]
    uia.el_runtime_id(ec, &rid1)
    uia.el_runtime_id(ec2, &rid2)
    check(rid1[2] != rid2[2] && rid1[2] != 0, "UIA: runtime ids of cells differ")
    check(uia.el_has_focus(&pv, uia.el_next(&pv, ec)) == false, "UIA: only the cursor cell has focus")

    // ---- AT-SPI: the objects reachable
    var br: atspi.Bridge = atspi.bridge_new(sc, ax, "Table")
    let total: usize = atspi.bridge_node_total(&br)
    a11y.a11y_set_vtable(ax, t, false)
    let flat: usize = atspi.bridge_node_total(&br)
    a11y.a11y_set_vtable(ax, t, true)
    check(total == flat + 9 + a11y.a11y_vhead_count(ax, t) && a11y.a11y_vhead_count(ax, t) == 3, "AT-SPI: the bridge reaches 3 rows x 3 cells and the 3 header cells more as a table")
    atspi.bridge_free(&br)

    if BAD == 0 {
        say("TABLEX PASSED\n")
        return 0
    }
    say("TABLEX FAILED\n")
    return 1
}
