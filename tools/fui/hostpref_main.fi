// SPDX-License-Identifier: MPL-2.0
// tools/fui/hostpref_main.fi -- W40-a: THE SYSTEM PREFERENCES THE HOST READS (transparency, high contrast) IN A REAL WINDOW.
// Opens a window (needs $DISPLAY: run it under Xvfb, tools/fui/hostpref.sh does), does what lib/@linux/fui/apphost.fi does after
// opening (`fuiwin.window_system_look`) and prints ONE line:
//     HOSTPREF reduced=<0|1> hc=<0|1> base=<hex>
//   reduced  glasspane.reduced(): the glass is drawn flat
//   hc       the window layer's answer to "high contrast?" (1 = asked and on)
//   base     the theme's ground colour (0 = the black ground of the High Contrast theme)
// Switches: FUI_TRANSPARENCY=0|1 and FUI_CONTRAST=0|1 (x11.fi). Exit 0 when a window opened.
import std.rt
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.scene
import fui.flex
import fui.glasspane
import window.window
import plat.fuiwirt
import plat.fuiwin
import plat.sysfont

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn put_hex(v: u32) {
    var b: rt.Buf = rt.buf_new()
    var sh: u32 = 28 as u32
    var started: bool = false
    var i: usize = 0
    while i < 8 {
        let d: u32 = (v >> sh) & 15 as u32
        if d != 0 as u32 || started || i == 7 {
            started = true
            if d < 10 as u32 {
                rt.buf_push(&b, (48 as u32 + d) as u8)
            } else {
                rt.buf_push(&b, (87 as u32 + d) as u8)
            }
        }
        if sh >= 4 as u32 {
            sh = sh - 4 as u32
        }
        i = i + 1
    }
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

fn main() -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("hostpref: no font\n")
        return 9
    }
    var fx: fuiwin.Window = fuiwin.window_new()
    fuiwin.window_set_font(&fx, fs as u64)
    fuiwin.window_set_gpu(&fx, false)
    var m: theme.Theme = theme.theme_new(false)
    var sc: scene.Scene = scene.scene_new()
    var c: render.Ctx = render.ctx_new(&m, fuiwin.window_painter(&fx))
    var w: fuiwirt.Host = fuiwirt.host_new(&sc, &c)
    let root: usize = scene.scene_box(&sc, scene.SCENE_NONE, 0 as u32, flex.FLEX_COLUMN, flex.JUSTIFY_CENTER, flex.AL_CENTER)
    fuiwirt.host_bind(&w)
    let t: str = "hostpref"
    if !fuiwin.window_open(&fx, &w, &m, 0, 200, 120, t.p as u64, t.n) {
        say("hostpref: no window\n")
        return 1
    }
    fuiwin.window_system_look(&fx, &m)
    let f: *mut window.Window = fuiwin.window_window(&fx)
    say("HOSTPREF reduced=")
    if glasspane.reduced() { say("1") } else { say("0") }
    say(" hc=")
    if window.contrast_known(f) && window.contrast_on(f) { say("1") } else { say("0") }
    say(" base=")
    put_hex((*theme.theme_colors(&m)).base)
    say("\n")
    fuiwin.window_close(&fx)
    return 0
}
