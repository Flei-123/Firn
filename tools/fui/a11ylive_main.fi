import std.io
import fui.a11y
import fui.audit
import fui.announce
import fui.flex
import fui.kit
import fui.painter
import fui.render
import fui.scene
import fui.screenax
import fui.screenaxtree
import fui.theme
import fui.widget
import fui.ds_fbtok
import fui.ds_toast
import plat.fuiwirt

static mut BAD: usize = 0

fn expect(ok: bool, what: str) {
    if !ok {
        BAD = BAD + 1
        io.print_line(what)
    }
}

fn same(a: *mut u8, n: usize, want: str) -> bool {
    if n != want.n { return false }
    var i: usize = 0
    while i < n {
        if *((a as u64 + i as u64) as *mut u8) != *((want.p as u64 + i as u64) as *mut u8) { return false }
        i = i + 1
    }
    return true
}

fn check_ring() {
    let r: u64 = announce.ring_alloc()
    expect(announce.ring_seq(r) == 0, "empty ring has no sequence")
    expect(!announce.ring_push(r, "", announce.MODE_POLITE), "empty text is ignored")
    expect(!announce.ring_push(r, "x", announce.MODE_NONE), "mode none is ignored")
    var i: usize = 0
    while i < 10 {
        var t: [u8; 2] = [48 as u8 + i as u8, 0 as u8]
        var m: u32 = announce.MODE_POLITE
        if i == 9 { m = announce.MODE_ASSERTIVE }
        announce.ring_push(r, str { p: (&t[0]) as *mut u8, n: 1 }, m)
        i = i + 1
    }
    expect(announce.ring_seq(r) == 10, "ten pushes, sequence 10")
    expect(announce.ring_oldest(r) == 3, "ring keeps the last eight")
    var out: [u8; 32] = [0 as u8; 32]
    var mode: u32 = 0 as u32
    expect(announce.ring_get(r, 2, (&out[0]) as u64, 32, &mode) == 0, "dropped entry is gone")
    expect(announce.ring_get(r, 11, (&out[0]) as u64, 32, &mode) == 0, "future entry is absent")
    let n3: usize = announce.ring_get(r, 3, (&out[0]) as u64, 32, &mode)
    expect(same((&out[0]) as *mut u8, n3, "2") && mode == announce.MODE_POLITE, "oldest entry readable")
    let n10: usize = announce.ring_get(r, 10, (&out[0]) as u64, 32, &mode)
    expect(same((&out[0]) as *mut u8, n10, "9") && mode == announce.MODE_ASSERTIVE, "newest entry is assertive")
    announce.ring_free(r)
}

fn check_core() {
    var sc: scene.Scene = scene.scene_new()
    var ax: a11y.A11y = a11y.a11y_new()
    let root: usize = scene.scene_box(&sc, scene.SCENE_NONE, 0 as u32, flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_START)
    let st: usize = scene.scene_widget(&sc, root, widget.KIND_BADGE, "Idle".p as u64, 4)
    let bt: usize = scene.scene_widget(&sc, root, widget.KIND_BUTTON, "Go".p as u64, 2)
    a11y.a11y_set_name(&ax, st, "Idle".p as u64, 4)
    a11y.a11y_set_name(&ax, bt, "Go".p as u64, 2)
    expect(a11y.a11y_live(&sc, &ax, st) == a11y.LIVE_POLITE, "status role is a polite live region by default")
    expect(a11y.a11y_live(&sc, &ax, bt) == a11y.LIVE_OFF, "button is not live")
    a11y.a11y_set_live(&ax, bt, a11y.LIVE_ASSERTIVE)
    expect(a11y.a11y_live(&sc, &ax, bt) == a11y.LIVE_ASSERTIVE, "explicit assertive wins")
    a11y.a11y_set_live(&ax, st, a11y.LIVE_OFF)
    expect(a11y.a11y_live(&sc, &ax, st) == a11y.LIVE_OFF, "explicit off wins over the role")
    a11y.a11y_set_live(&ax, st, a11y.LIVE_UNSET)
    expect(a11y.a11y_live(&sc, &ax, st) == a11y.LIVE_POLITE, "unset returns to the role default")
    var db: [u8; 4096] = [0 as u8; 4096]
    let dn: usize = a11y.a11y_dump(&sc, &ax, (&db[0]) as u64, 4096)
    var has: bool = false
    var i: usize = 0
    while i + 15 <= dn {
        if db[i] == 108 as u8 && db[i + 1] == 105 as u8 && db[i + 2] == 118 as u8 && db[i + 3] == 101 as u8 && db[i + 4] == 61 as u8 && db[i + 5] == 97 as u8 { has = true }
        i = i + 1
    }
    expect(has, "dump shows an explicit live=assertive")
    var jb: [u8; 4096] = [0 as u8; 4096]
    let jn: usize = a11y.a11y_dump_json(&sc, &ax, (&jb[0]) as u64, 4096)
    var jhas: bool = false
    i = 0
    while i + 8 <= jn {
        if jb[i] == 34 as u8 && jb[i + 1] == 108 as u8 && jb[i + 2] == 105 as u8 && jb[i + 3] == 118 as u8 && jb[i + 4] == 101 as u8 && jb[i + 5] == 34 as u8 { jhas = true }
        i = i + 1
    }
    expect(jhas, "json shows the live mode")

    let blank: usize = scene.scene_widget(&sc, root, widget.KIND_BADGE, "".p as u64, 0)
    a11y.a11y_set_live(&ax, blank, a11y.LIVE_POLITE)
    let au: audit.Audit = audit.audit_tree_ax(&sc, &ax)
    expect(au.live_empty == 1 && !audit.audit_ok(&au), "audit flags an explicit live region without a name")
    a11y.a11y_set_name(&ax, blank, "Ready".p as u64, 5)
    let au2: audit.Audit = audit.audit_tree_ax(&sc, &ax)
    expect(au2.live_empty == 0 && audit.audit_ok(&au2), "audit passes once it has a name")
    a11y.a11y_set_live(&ax, blank, a11y.LIVE_UNSET)
    expect(a11y.a11y_live_sync(&sc, &ax) == 0, "first sync only records")
    expect(a11y.a11y_announce_seq(&ax) == 0, "nothing announced yet")
    expect(a11y.a11y_live_sync(&sc, &ax) == 0, "unchanged names stay quiet")
    a11y.a11y_set_name(&ax, st, "Saved".p as u64, 5)
    expect(a11y.a11y_live_sync(&sc, &ax) == 1, "a changed live name is announced")
    var out: [u8; 160] = [0 as u8; 160]
    var mode: u32 = 0 as u32
    let n: usize = a11y.a11y_announce_get(&ax, 1, (&out[0]) as u64, 160, &mode)
    expect(same((&out[0]) as *mut u8, n, "Saved") && mode == a11y.LIVE_POLITE, "announcement carries the new name, polite")
    a11y.a11y_set_name(&ax, bt, "Stop".p as u64, 4)
    a11y.a11y_live_sync(&sc, &ax)
    a11y.a11y_set_name(&ax, bt, "Halt".p as u64, 4)
    expect(a11y.a11y_live_sync(&sc, &ax) == 1, "assertive node announces too")
    let n2: usize = a11y.a11y_announce_get(&ax, a11y.a11y_announce_seq(&ax), (&out[0]) as u64, 160, &mode)
    expect(same((&out[0]) as *mut u8, n2, "Halt") && mode == a11y.LIVE_ASSERTIVE, "assertive mode carried")
    a11y.a11y_set_hidden(&ax, st, true)
    a11y.a11y_set_name(&ax, st, "Hidden".p as u64, 6)
    expect(a11y.a11y_live_sync(&sc, &ax) == 0, "hidden live region stays silent")
    expect(a11y.a11y_announce(&ax, "Direct", a11y.LIVE_POLITE) && !a11y.a11y_announce(&ax, "Off", a11y.LIVE_OFF), "direct announce works, off is refused")
    a11y.a11y_free(&ax)
    expect(a11y.a11y_announce_seq(&ax) == 0, "free drops the ring")
}

fn check_screen_path() {
    screenax.install()
    let t: *mut screenaxtree.Tree = screenaxtree.tree_new("Live")
    screenax.begin()
    screenax.note(widget.KIND_BUTTON, 0 as u32, "Play", 10.0, 10.0, 80.0, 30.0, 0)
    screenax.announce_polite("Download done")
    screenax.announce_assertive("Disk full")
    screenaxtree.publish(t)
    let ax: *mut a11y.A11y = screenaxtree.tree_ax(t)
    expect(a11y.a11y_announce_seq(ax) == 2, "publish forwards both announcements")
    var out: [u8; 160] = [0 as u8; 160]
    var mode: u32 = 0 as u32
    let n1: usize = a11y.a11y_announce_get(ax, 1, (&out[0]) as u64, 160, &mode)
    expect(same((&out[0]) as *mut u8, n1, "Download done") && mode == a11y.LIVE_POLITE, "first is polite")
    let n2: usize = a11y.a11y_announce_get(ax, 2, (&out[0]) as u64, 160, &mode)
    expect(same((&out[0]) as *mut u8, n2, "Disk full") && mode == a11y.LIVE_ASSERTIVE, "second is assertive")
    screenaxtree.publish(t)
    expect(a11y.a11y_announce_seq(ax) == 2, "a second publish does not repeat them")
    screenax.announce_polite("Later")
    screenaxtree.publish(t)
    expect(a11y.a11y_announce_seq(ax) == 3, "new announcements survive the tree rebuild")

    let f: *mut ds_toast.Feed = ds_toast.feed_new()
    ds_toast.push(f, ds_fbtok.INFO, "Saved", "Profile stored", "", 1000, 4000)
    ds_toast.push(f, ds_fbtok.ERROR, "Failed", "Disk full", "", 1000, 4000)
    screenaxtree.publish(t)
    expect(a11y.a11y_announce_seq(ax) == 5, "each toast announces once")
    let n4: usize = a11y.a11y_announce_get(ax, 4, (&out[0]) as u64, 160, &mode)
    expect(same((&out[0]) as *mut u8, n4, "Information: Saved: Profile stored") && mode == a11y.LIVE_POLITE, "info toast text, polite")
    let n5: usize = a11y.a11y_announce_get(ax, 5, (&out[0]) as u64, 160, &mode)
    expect(same((&out[0]) as *mut u8, n5, "Error: Failed: Disk full") && mode == a11y.LIVE_ASSERTIVE, "error toast text, assertive")
}

fn check_toast_title() {
    var m: theme.Theme = theme.theme_new(true)
    var cx: render.Ctx = render.ctx_new(&m, 0 as u64 as *mut painter.Painter)
    let c: *mut render.Ctx = &cx
    var q: kit.Toasts = kit.toasts_new()
    kit.toast_push(&q, kit.TK_INFO, "plain", "", 100 as i64, 0 as i64)
    kit.toast_push_titled(&q, kit.TK_SUCCESS, "Saved", "Profile stored", "Undo", 200 as i64, 0 as i64)
    var x0: f64 = 0.0
    var y0: f64 = 0.0
    var w0: f64 = 0.0
    var h0: f64 = 0.0
    var x1: f64 = 0.0
    var y1: f64 = 0.0
    var w1: f64 = 0.0
    var h1: f64 = 0.0
    expect(kit.toasts_geometry(c, &q, 800.0, 600.0, 0, &x0, &y0, &w0, &h0), "plain toast has a rectangle")
    expect(kit.toasts_geometry(c, &q, 800.0, 600.0, 1, &x1, &y1, &w1, &h1), "titled toast has a rectangle")
    expect(h1 > h0, "titled toast is taller")
    expect(h0 == kit.ln(c, 48) && h1 == kit.ln(c, 64), "heights are 48 and 64")
    expect(y1 + h1 + kit.ln(c, 16) == 600.0, "newest sits on the bottom margin")
    expect(y0 + h0 + kit.ln(c, 8) == y1, "older toast stacks above with the gap")
    expect(q.t[1].tn == 5 && q.t[0].tn == 0, "title stored only when given")
}

fn main() -> i32 {
    check_ring()
    check_core()
    check_screen_path()
    check_toast_title()
    if BAD == 0 {
        io.print_line("A11YLIVE PASSED")
        return 0
    }
    io.print_line("A11YLIVE FAILED")
    return 1
}
