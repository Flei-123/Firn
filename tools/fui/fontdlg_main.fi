// SPDX-License-Identifier: MPL-2.0
// tools/fui/fontdlg_main.fi -- THE CHECK OF THE FONT DIALOG WITHOUT A WINDOW
// (lib/fui/fontdlg.fi, lib/fui/fontscan.fi; fUi roadmap r177, Firn r348).
//
// A font folder made by tools/dialog/fontdlg_fonts.py (500 tiny generated families, a family with five faces,
// squares against bars so a picture can tell two files apart, Macintosh-only names, a CFF font, a collection,
// broken files, duplicates, a link loop, links to the system DejaVu) is walked; the dialog is built into an app
// window, painted into a canvas, driven with the events a window sends (pointer, wheel, keys, characters) and
// the pixels are read back.
//
//   1. THE WALK: names, styles, grouping, order, duplicates, broken files, loop, CFF/collection flags,
//      Bold/Italic picking, the empty folder, the walk in slices.
//   2. THE DIALOG: first state, clicking, wheel, scroll bar, type-ahead, filter, size field (clamped), Bold /
//      Italic / Underline / Strikeout, Enter / Esc, the answer.
//   3. THE SAMPLE: the pixels. Real face against emulated, 12 against 48, squares against bars.
//   4. LOOK: light and dark, contrast, hover, focus ring, accessibility audit.
//   5. SPEED: FRAME_MS lines, a font walk of 600 files.
//
//     firnc -o /tmp/fontdlg tools/fui/fontdlg_main.fi && /tmp/fontdlg <fontdir> [dir-for-pngs]
//
// The last line is FONTDLG PASSED or FONTDLG FAILED. FRAME_MS lines are only meaningful in a release build.
import std.rt
import std.time
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import fui.style
import fui.render
import fui.a11y
import plat.fuiwirt
import plat.sysfont
import fui.app
import fui.fontscan
import fui.fontdlg

static mut BAD: usize = 0
static mut FONT: u64 = 0
static mut CLOCK: i64 = 1000
static mut PNGDIR: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_int(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn eq(what: str, got: i64, want: i64) {
    if got == want {
        say("  ok    ")
        say(what)
        say("\n")
    } else {
        say("  WRONG ")
        say(what)
        say(" -- got ")
        say_int(got)
        say(", wanted ")
        say_int(want)
        say("\n")
        BAD = BAD + 1
    }
}

fn same(a: str, b: str) -> bool {
    if a.n != b.n {
        return false
    }
    var i: usize = 0
    while i < a.n {
        if rt.ld8(a.p as u64, i) != rt.ld8(b.p as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn now_ms() -> f64 {
    var ts: [u64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as u64)
    return (ts[0] as f64) * 1000.0 + (ts[1] as f64) / 1000000.0
}

// One timing line: FRAME_MS <state> <ms with one decimal>
fn frame_ms(state: str, ms: f64) {
    say("FRAME_MS ")
    say(state)
    say(" ")
    let t: i64 = (ms * 10.0 + 0.5) as i64
    say_int(t / 10)
    say(".")
    say_int(t % 10)
    say("\n")
    if ms > 16.0 {
        BAD = BAD + 1
        say("  WRONG that frame took more than 16 ms\n")
    }
}

// ------------------------------------------------------------ a surface

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h) || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn paint1(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

// One frame, and (like the host) more frames while it asks for them.
fn frame(a: *mut app.App, s: *mut Surface) {
    paint1(a, s)
    var n: usize = 0
    while fuiwirt.host_dirty(app.app_host(a)) && n < 6 {
        CLOCK = CLOCK + 1000
        fuiwirt.host_tick(app.app_host(a), CLOCK)
        paint1(a, s)
        n = n + 1
    }
}

fn save(s: *mut Surface, name: str) {
    if PNGDIR == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, PNGDIR, rt.c_length(PNGDIR))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(&(*s).cv, &out) {
        let ok: bool = rt.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

// ------------------------------------------------------------ a dialog under test

struct Sc {
    a: *mut app.App,
    d: *mut fontdlg.FontDlg,
    s: *mut Surface,
}

fn make(family: str, size: i32, w: usize, h: usize) -> Sc {
    let a: *mut app.App = app.window("Choose a font", fontdlg.WIN_W, fontdlg.WIN_H)
    let d: *mut fontdlg.FontDlg = fontdlg.dlg_new()
    fontdlg.build(a, d, family, size)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, w, h)
    frame(a, s)
    return Sc { a: a, d: d, s: s }
}

fn make_dark(family: str, size: i32, w: usize, h: usize) -> Sc {
    let a: *mut app.App = app.window("Choose a font", fontdlg.WIN_W, fontdlg.WIN_H)
    app.set_dark(a, true)
    let d: *mut fontdlg.FontDlg = fontdlg.dlg_new()
    fontdlg.build(a, d, family, size)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, w, h)
    frame(a, s)
    return Sc { a: a, d: d, s: s }
}

fn node_of(t: *mut Sc, role: usize) -> usize {
    return fontdlg.dlg_node((*t).d, role)
}

fn settle(a: *mut app.App) {
    let i: usize = fuiwirt.host_take_activated(app.app_host(a))
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
}

fn click_xy(t: *mut Sc, x: f64, y: f64) {
    let w: *mut fuiwirt.Host = app.app_host((*t).a)
    let c1: u32 = fuiwirt.host_pointer_move(w, x, y)
    let c2: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let c3: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
    settle((*t).a)
    frame((*t).a, (*t).s)
}

fn click_node(t: *mut Sc, role: usize) {
    let sc: *mut scene.Scene = app.app_scene((*t).a)
    let n: usize = node_of(t, role)
    click_xy(t, scene.node_x(sc, n) + scene.node_w(sc, n) / 2.0, scene.node_y(sc, n) + scene.node_h(sc, n) / 2.0)
}

fn move_xy(t: *mut Sc, x: f64, y: f64) {
    let c1: u32 = fuiwirt.host_pointer_move(app.app_host((*t).a), x, y)
    frame((*t).a, (*t).s)
}

fn wheel(t: *mut Sc, x: f64, y: f64, down: bool, times: usize) {
    let w: *mut fuiwirt.Host = app.app_host((*t).a)
    let c1: u32 = fuiwirt.host_pointer_move(w, x, y)
    var i: usize = 0
    while i < times {
        var b: u32 = fuiwirt.BTN_WHEEL_UP
        if down {
            b = fuiwirt.BTN_WHEEL_DOWN
        }
        let c2: u32 = fuiwirt.host_pointer_down(w, x, y, b)
        i = i + 1
    }
    frame((*t).a, (*t).s)
}

fn key(t: *mut Sc, k: u32) {
    let b: bool = fontdlg.dlg_key((*t).a as u64, k, 0 as u32)
    frame((*t).a, (*t).s)
}

fn type_text(t: *mut Sc, s: str) {
    var i: usize = 0
    while i < s.n {
        let b: bool = fontdlg.dlg_char((*t).a as u64, rt.ld8(s.p as u64, i) as u32, 0 as u32)
        i = i + 1
    }
    frame((*t).a, (*t).s)
}

fn geom(t: *mut Sc, which: usize, out: *mut [f64; 7]) -> bool {
    return fontdlg.dlg_list_geometry((*t).d, which, out)
}

// The window position of the middle of row `r` of list `which`, if it is in view.
fn row_xy(t: *mut Sc, which: usize, r: usize, x: *mut f64, y: *mut f64) -> bool {
    var g: [f64; 7] = [0.0; 7]
    if !geom(t, which, &g) {
        return false
    }
    let ry: f64 = g[1] + 4.0 + (r as f64) * g[4] - g[5]
    if ry < g[1] || ry + g[4] > g[1] + g[3] {
        return false
    }
    *x = g[0] + 30.0
    *y = ry + g[4] / 2.0
    return true
}

fn click_row(t: *mut Sc, which: usize, r: usize) -> bool {
    var x: f64 = 0.0
    var y: f64 = 0.0
    if !row_xy(t, which, r, &x, &y) {
        return false
    }
    click_xy(t, x, y)
    return true
}

fn family_name_of(t: *mut Sc) -> str {
    return fontscan.family_name(fontdlg.dlg_family((*t).d))
}

fn face_style_of(t: *mut Sc) -> str {
    let f: usize = fontscan.family_face(fontdlg.dlg_family((*t).d), fontdlg.dlg_face((*t).d))
    return fontscan.face_style(f)
}

fn clear_field(t: *mut Sc, role: usize) {
    click_node(t, role)
    var i: usize = 0
    while i < 40 {
        let b: bool = fontdlg.dlg_key((*t).a as u64, editor.KEY_END, 0 as u32)
        let c: bool = fontdlg.dlg_key((*t).a as u64, editor.KEY_BACKSPACE, 0 as u32)
        i = i + 1
    }
    frame((*t).a, (*t).s)
}

// ------------------------------------------------------------ pixels

fn pix(t: *mut Sc, x: usize, y: usize) -> u32 {
    return canvas.canvas_get(&(*(*t).s).cv, x, y) & 16777215 as u32
}

// Ink in the sample box: every pixel that is not the ground of the box.
struct Ink {
    count: usize,
    top: usize,
    bottom: usize,
    left: usize,
    right: usize,
    top_left: usize, // leftmost ink column in the topmost ink row
    bot_left: usize, // ... in the lowest
    hash: u64,
}

fn ink_of(t: *mut Sc) -> Ink {
    var r: [f64; 4] = [0.0; 4]
    let ok: bool = fontdlg.dlg_preview_rect((*t).d, &r)
    let x0: usize = (r[0] + 4.0) as usize
    let y0: usize = (r[1] + 4.0) as usize
    let x1: usize = (r[0] + r[2] - 4.0) as usize
    let y1: usize = (r[1] + r[3] - 4.0) as usize
    let bg: u32 = pix(t, x0 + 1, y0 + 1)
    var k: Ink = Ink { count: 0, top: 100000, bottom: 0, left: 100000, right: 0, top_left: 0, bot_left: 0, hash: 7 as u64 }
    var y: usize = y0
    while y < y1 {
        var x: usize = x0
        while x < x1 {
            let p: u32 = pix(t, x, y)
            if p != bg {
                k.count = k.count + 1
                if y < k.top {
                    k.top = y
                }
                if y > k.bottom {
                    k.bottom = y
                }
                if x < k.left {
                    k.left = x
                }
                if x > k.right {
                    k.right = x
                }
                k.hash = (k.hash * 31 as u64 + (p as u64)) % 1000000007 as u64
            }
            x = x + 1
        }
        y = y + 1
    }
    // the leftmost ink column in the top and the bottom ink row
    if k.count > 0 {
        var x2: usize = x0
        while x2 < x1 {
            if pix(t, x2, k.top) != bg && k.top_left == 0 {
                k.top_left = x2
            }
            if pix(t, x2, k.bottom) != bg && k.bot_left == 0 {
                k.bot_left = x2
            }
            x2 = x2 + 1
        }
    }
    return k
}

// ------------------------------------------------------------ 1. the walk

fn read_expected(dir: str) -> i64 {
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir.p as u64, dir.n)
    rt.buf_push_bytes(&path, "/EXPECTED".p as u64, 9)
    rt.buf_push(&path, 0 as u8)
    var data: rt.Buf = rt.buf_new()
    var fams: i64 = 0 - 1
    if rt.read_file(rt.buf_ptr(&path), &data) {
        let n: usize = rt.buf_len(&data)
        var i: usize = 0
        while i + 9 < n {
            if rt.buf_at(&data, i) == 102 as u8 && rt.buf_at(&data, i + 1) == 97 as u8 && rt.buf_at(&data, i + 8) == 61 as u8 {
                fams = 0
                var j: usize = i + 9
                while j < n && rt.buf_at(&data, j) >= 48 as u8 && rt.buf_at(&data, j) <= 57 as u8 {
                    fams = fams * 10 + ((rt.buf_at(&data, j) - 48 as u8) as i64)
                    j = j + 1
                }
                i = n
            }
            i = i + 1
        }
    }
    rt.buf_free(&path)
    rt.buf_free(&data)
    return fams
}

fn walk_checks(dir: str, want_fams: i64) {
    say("== 1. the walk\n")
    fontscan.set_dirs(dir)
    let t0: f64 = now_ms()
    fontscan.run_all()
    let t1: f64 = now_ms()
    say("SCAN_MS ")
    say_int((t1 - t0) as i64)
    say(" files ")
    say_int(fontscan.files_seen() as i64)
    say(" dirs ")
    say_int(fontscan.dirs_seen() as i64)
    say(" families ")
    say_int(fontscan.family_count() as i64)
    say("\n")
    eq("families found (500 generated + the rest)", fontscan.family_count() as i64, want_fams)
    check(fontscan.done() && !fontscan.fallback_active(), "the walk is done and found fonts")
    check(fontscan.dirs_seen() < 16, "the link loop did not eat the directory budget")

    // alphabetical, case blind
    var sorted: bool = true
    var i: usize = 1
    while i < fontscan.family_count() {
        if fontscan.fold_cmp(fontscan.family_name(i - 1), fontscan.family_name(i)) > 0 {
            sorted = false
        }
        i = i + 1
    }
    check(sorted, "the families are in alphabetical order")

    // a family with five faces
    let tb: usize = fontscan.find_family("test box")
    check(tb != fontscan.NONE, "find_family is case blind (Test Box)")
    eq("Test Box has five faces (the copy and the link are not a sixth and seventh)", fontscan.family_face_count(tb) as i64, 5)
    check(same(fontscan.face_style(fontscan.family_face(tb, 0)), "Regular")
        && same(fontscan.face_style(fontscan.family_face(tb, 1)), "Italic")
        && same(fontscan.face_style(fontscan.family_face(tb, 2)), "Bold")
        && same(fontscan.face_style(fontscan.family_face(tb, 3)), "Bold Italic")
        && same(fontscan.face_style(fontscan.family_face(tb, 4)), "Light"),
        "styles in the order Regular, Italic, Bold, Bold Italic, then Light")
    check(fontscan.face_bold(fontscan.family_face(tb, 2)) && !fontscan.face_italic(fontscan.family_face(tb, 2))
        && fontscan.face_bold(fontscan.family_face(tb, 3)) && fontscan.face_italic(fontscan.family_face(tb, 3))
        && !fontscan.face_bold(fontscan.family_face(tb, 4)) && fontscan.face_weight(fontscan.family_face(tb, 4)) == 300 as u32,
        "bold / italic flags and the weight of Light come from OS/2 and head")
    check(!fontscan.face_plain(fontscan.family_face(tb, 4)) && fontscan.face_plain(fontscan.family_face(tb, 3)),
        "Light is not a plain style, Bold Italic is")
    check(fontscan.face_drawable(fontscan.family_face(tb, 0)), "a TrueType face can be drawn")

    // pick_face for the check boxes
    eq("pick Bold Italic", fontscan.pick_face(tb, true, true) as i64, 3)
    eq("pick Italic", fontscan.pick_face(tb, false, true) as i64, 1)
    eq("pick Regular beats Light", fontscan.pick_face(tb, false, false) as i64, 0)
    let tbar: usize = fontscan.find_family("Test Bar")
    eq("pick Bold in a family without one finds none", fontscan.pick_face(tbar, true, false) as i64, fontscan.NONE as i64)
    eq("find_face_style", fontscan.find_face_style(tb, "bold italic") as i64, 3)

    // the odd ones
    let mac: usize = fontscan.find_family("Mac Äpfel")
    check(mac != fontscan.NONE, "a font with Macintosh names only: \"Mac Äpfel\" (Mac Roman -> UTF-8)")
    let nl: usize = fontscan.find_family("Nameless-Face")
    check(nl != fontscan.NONE, "a font without a name table is named by its file")
    check(fontscan.find_family("empty") == fontscan.NONE && fontscan.find_family("text") == fontscan.NONE
        && fontscan.find_family("truncated") == fontscan.NONE, "an empty file, a text file and a truncated font are not listed")
    let cf: usize = fontscan.find_family("Test CFF")
    check(cf != fontscan.NONE && !fontscan.face_drawable(fontscan.family_face(cf, 0)), "a CFF font is listed but cannot be drawn")
    let ca: usize = fontscan.find_family("Test Collection B")
    check(ca != fontscan.NONE && !fontscan.face_drawable(fontscan.family_face(ca, 0)),
        "both fonts of a .ttc are listed (cannot be drawn)")
    let g0: usize = fontscan.find_family("Gen Family 000")
    eq("every tenth generated family has Bold and Italic", fontscan.family_face_count(g0) as i64, 3)
    let g1: usize = fontscan.find_family("Gen Family 001")
    eq("the others have one face", fontscan.family_face_count(g1) as i64, 1)
    let dj: usize = fontscan.find_family("DejaVu Sans")
    check(dj != fontscan.NONE && fontscan.family_face_count(dj) == 2, "DejaVu Sans (a link to the system file): Regular + Bold")

    // the walk in slices gives the same
    fontscan.set_dirs(dir)
    fontscan.begin()
    var rounds: usize = 0
    while !fontscan.step(1 as u64) && rounds < 100000 {
        rounds = rounds + 1
    }
    eq("the walk in slices of 1 ms gives the same families", fontscan.family_count() as i64, want_fams)
    say("  (")
    say_int(rounds as i64)
    say(" slices)\n")

    // nothing found
    fontscan.set_dirs("/nonexistent-font-folder")
    fontscan.begin()
    let fin: bool = fontscan.step(0 as u64)
    check(fin && fontscan.fallback_active() && fontscan.family_count() == 1
        && same(fontscan.family_name(0), "DejaVu Sans"), "an empty folder: one entry, DejaVu Sans, no crash")
    fontscan.set_dirs(dir)
    fontscan.begin()
    let fin2: bool = fontscan.step(0 as u64)
}

// ------------------------------------------------------------ 2. the dialog

fn dialog_checks(w: usize, h: usize, want_fams: i64) {
    say("== 2. the dialog\n")
    var t: Sc = make("Test Box", 14, w, h)
    let d: *mut fontdlg.FontDlg = t.d
    check(same(family_name_of(&t), "Test Box"), "it starts with the family it was given")
    eq("... and the size", fontdlg.dlg_size(d) as i64, 14)
    check(same(face_style_of(&t), "Regular"), "... in its Regular face")
    eq("all families are shown", fontdlg.dlg_visible_count(d) as i64, want_fams)
    var g: [f64; 7] = [0.0; 7]
    check(geom(&t, fontdlg.DLG_FAMILY, &g) && g[3] > 100.0 && g[4] > 10.0, "the family list has a size and rows")
    check(g[5] > 0.0, "the chosen family was scrolled to the middle of the list (the list is long)")
    check(same(fontdlg.dlg_status(d), "510 font families"), "the status line counts the families")
    save(t.s, "fontdlg-start.png")

    // family list: wheel, click
    let top0: f64 = fontdlg.dlg_list_top(d, fontdlg.DLG_FAMILY)
    wheel(&t, g[0] + 40.0, g[1] + 40.0, false, 4)
    check(top0 - fontdlg.dlg_list_top(d, fontdlg.DLG_FAMILY) > g[4] * 11.0, "the wheel scrolls the list under the pointer (3 rows a notch)")
    wheel(&t, g[0] + 40.0, g[1] + 40.0, false, 300)
    eq("scrolled to the top", fontdlg.dlg_list_top(d, fontdlg.DLG_FAMILY) as i64, 0)
    wheel(&t, g[0] + 40.0, g[1] + 40.0, true, 2)
    check(fontdlg.dlg_list_top(d, fontdlg.DLG_FAMILY) > g[4] * 5.0, "... and down again")
    wheel(&t, g[0] + 40.0, g[1] + 40.0, false, 10)
    eq("... and up", fontdlg.dlg_list_top(d, fontdlg.DLG_FAMILY) as i64, 0)
    check(click_row(&t, fontdlg.DLG_FAMILY, 5), "row 5 is in view")
    check(same(family_name_of(&t), "Gen Family 002"), "a click on a row chooses that family")
    check(same(face_style_of(&t), "Regular"), "... and its Regular face")
    eq("the style list has one row for it", fontscan.family_face_count(fontdlg.dlg_family(d)) as i64, 1)

    // keys in the family list
    key(&t, editor.KEY_DOWN)
    check(same(family_name_of(&t), "Gen Family 003"), "Down moves to the next family")
    key(&t, editor.KEY_PGDN)
    check(same(family_name_of(&t), "Gen Family 009"), "PageDown moves a page (the rows in view less one)")
    key(&t, editor.KEY_END)
    check(fontdlg.dlg_family(d) == fontscan.family_count() - 1, "End moves to the last family")
    key(&t, editor.KEY_HOME)
    check(fontdlg.dlg_family(d) == 0, "Home moves to the first")
    key(&t, editor.KEY_UP)
    check(fontdlg.dlg_family(d) == 0, "Up on the first row stays")

    // type-ahead
    type_text(&t, "Test B")
    check(same(family_name_of(&t), "Test Bar"), "typing 'Test B' in the list jumps to Test Bar")
    type_text(&t, "o")
    check(same(family_name_of(&t), "Test Box"), "one more letter within a second: 'Test Bo' is Test Box")

    // the scroll bar thumb
    check(geom(&t, fontdlg.DLG_FAMILY, &g), "geometry")
    let bx: f64 = g[0] + g[2] - 4.0 - 6.0
    let by: f64 = g[1] + 12.0
    let c1: u32 = fuiwirt.host_pointer_move(app.app_host(t.a), bx, by)
    let c2: u32 = fuiwirt.host_pointer_down(app.app_host(t.a), bx, by, fuiwirt.BTN_LEFT)
    let c3: u32 = fuiwirt.host_pointer_move(app.app_host(t.a), bx, by + 60.0)
    frame(t.a, t.s)
    check(fontdlg.dlg_list_top(d, fontdlg.DLG_FAMILY) > 100.0, "dragging the thumb scrolls the list")
    let c4: u32 = fuiwirt.host_pointer_up(app.app_host(t.a), bx, by + 60.0, fuiwirt.BTN_LEFT)
    let c5: u32 = fuiwirt.host_pointer_move(app.app_host(t.a), bx, by + 200.0)
    frame(t.a, t.s)
    let held: f64 = fontdlg.dlg_list_top(d, fontdlg.DLG_FAMILY)
    let c6: u32 = fuiwirt.host_pointer_move(app.app_host(t.a), bx, by + 20.0)
    frame(t.a, t.s)
    check(fontdlg.dlg_list_top(d, fontdlg.DLG_FAMILY) == held, "after the button is up the thumb is let go")

    // filter
    clear_field(&t, fontdlg.NODE_FILTER)
    type_text(&t, "BOX")
    eq("the filter 'BOX' (any case, anywhere in the name) leaves one family", fontdlg.dlg_visible_count(d) as i64, 1)
    check(same(family_name_of(&t), "Test Box"), "... and chooses it")
    clear_field(&t, fontdlg.NODE_FILTER)
    type_text(&t, "gen family 05")
    eq("'gen family 05' leaves ten", fontdlg.dlg_visible_count(d) as i64, 10)
    check(same(family_name_of(&t), "Gen Family 050"), "the first of them is chosen")
    key(&t, editor.KEY_DOWN)
    check(same(family_name_of(&t), "Gen Family 051"), "Down in the filter field moves the family list")
    clear_field(&t, fontdlg.NODE_FILTER)
    type_text(&t, "zzzz")
    eq("a filter that matches nothing", fontdlg.dlg_visible_count(d) as i64, 0)
    check(same(fontdlg.dlg_status(d), "No font matches the filter"), "... says so in the status line")
    key(&t, editor.KEY_ENTER)
    check(!fontdlg.dlg_done(d), "Enter does nothing while nothing is chosen")
    clear_field(&t, fontdlg.NODE_FILTER)
    eq("an empty filter shows all again", fontdlg.dlg_visible_count(d) as i64, want_fams)

    // size field
    var gs: [f64; 7] = [0.0; 7]
    check(geom(&t, fontdlg.DLG_SIZE, &gs), "size list geometry")
    wheel(&t, gs[0] + 20.0, gs[1] + 20.0, true, 20)
    check(click_row(&t, fontdlg.DLG_SIZE, 14), "the size list (scrolled down) shows row 14")
    eq("a click on row 14 of the size list chooses 48", fontdlg.dlg_size(d) as i64, 48)
    check(same(app.text(t.a, node_of(&t, fontdlg.NODE_SIZE)), "48"), "... and writes it into the field")
    clear_field(&t, fontdlg.NODE_SIZE)
    type_text(&t, "5000")
    eq("5000 is clamped to 999", fontdlg.dlg_size(d) as i64, 999)
    check(same(app.text(t.a, node_of(&t, fontdlg.NODE_SIZE)), "999"), "... and the field shows 999")
    clear_field(&t, fontdlg.NODE_SIZE)
    type_text(&t, "0")
    eq("0 is clamped to 1", fontdlg.dlg_size(d) as i64, 1)
    clear_field(&t, fontdlg.NODE_SIZE)
    type_text(&t, "1a7")
    eq("letters are dropped: '1a7' is 17", fontdlg.dlg_size(d) as i64, 17)
    key(&t, editor.KEY_UP)
    eq("Up in the size field counts", fontdlg.dlg_size(d) as i64, 18)
    save(t.s, "fontdlg-size.png")

    // bold / italic
    let tb: Sc = make("Test Box", 14, w, h)
    var u: Sc = tb
    click_node(&u, fontdlg.NODE_BOLD)
    check(same(face_style_of(&u), "Bold") && fontdlg.dlg_bold(u.d) && !fontdlg.dlg_synth(u.d, 0),
        "ticking Bold chooses the Bold face of the family, no emulation")
    click_node(&u, fontdlg.NODE_ITALIC)
    check(same(face_style_of(&u), "Bold Italic"), "ticking Italic as well: Bold Italic")
    click_node(&u, fontdlg.NODE_BOLD)
    check(same(face_style_of(&u), "Italic") && !fontdlg.dlg_bold(u.d) && fontdlg.dlg_italic(u.d), "unticking Bold: Italic")
    check(click_row(&u, fontdlg.DLG_STYLE, 2), "the style list shows row 2")
    check(same(face_style_of(&u), "Bold") && fontdlg.dlg_bold(u.d) && !fontdlg.dlg_italic(u.d),
        "a click on the Bold row sets the ticks from the face")
    check(widget.w_value(scene.node_widget(app.app_scene(u.a), node_of(&u, fontdlg.NODE_BOLD))) == 1
        && widget.w_value(scene.node_widget(app.app_scene(u.a), node_of(&u, fontdlg.NODE_ITALIC))) == 0,
        "... and the check boxes show them")
    check(fontdlg.dlg_set_family(u.d, "Gen Family 001"), "choose a family that has only one face")
    frame(u.a, u.s)
    check(fontdlg.dlg_bold(u.d) && same(face_style_of(&u), "Regular") && fontdlg.dlg_synth(u.d, 0),
        "the Bold wish stays, the face is Regular, Bold is emulated")
    check(fontdlg.dlg_status(u.d).n > 20 && same(fontdlg.dlg_status(u.d), "Bold - Not installed in this family - emulated in the sample"),
        "the status line says so")
    click_node(&u, fontdlg.NODE_UNDERLINE)
    click_node(&u, fontdlg.NODE_STRIKE)
    check(fontdlg.dlg_underline(u.d) && fontdlg.dlg_strike(u.d), "Underline and Strikeout")

    // the answer
    key(&u, editor.KEY_ENTER)
    check(fontdlg.dlg_done(u.d) && app.app_done(u.a as u64), "Enter ends the dialog")
    var fam: rt.Buf = rt.buf_new()
    var pick: fontdlg.FontPick = fontdlg.pick_new()
    eq("... with a chosen answer (0)", fontdlg.dlg_result(u.d, &fam, &pick) as i64, 0)
    check(same(str { p: rt.buf_data(&fam), n: rt.buf_len(&fam) }, "Gen Family 001"), "the family name comes back in UTF-8")
    check(pick.size == 14 && pick.bold && !pick.italic && pick.underline && pick.strike, "size, bold, italic, underline, strike")
    let esc: Sc = make("Test Box", 33, w, h)
    var e2: Sc = esc
    key(&e2, editor.KEY_ESC)
    check(fontdlg.dlg_done(e2.d) && app.app_done(e2.a as u64), "Esc ends the dialog")
    eq("... as a cancel (1)", fontdlg.dlg_result(e2.d, &fam, &pick) as i64, 1)
    // OK button by the mouse, Cancel by the mouse
    let okb: Sc = make("Test Bar", 20, w, h)
    var o3: Sc = okb
    click_node(&o3, fontdlg.NODE_OK)
    check(fontdlg.dlg_done(o3.d) && fontdlg.dlg_result(o3.d, &fam, &pick) == 0 && pick.size == 20
        && same(str { p: rt.buf_data(&fam), n: rt.buf_len(&fam) }, "Test Bar"), "the OK button gives Test Bar at 20")
    let cb: Sc = make("Test Bar", 20, w, h)
    var c7: Sc = cb
    click_node(&c7, fontdlg.NODE_CANCEL)
    check(fontdlg.dlg_done(c7.d) && fontdlg.dlg_result(c7.d, &fam, &pick) == 1, "the Cancel button cancels")
    // Enter on the Cancel button is that button's (the host presses it), not OK
    let tc: Sc = make("Test Bar", 20, w, h)
    var t5: Sc = tc
    var guard: usize = 0
    while app.focus(t5.a) != node_of(&t5, fontdlg.NODE_CANCEL) && guard < 40 {
        let tt: u32 = fuiwirt.host_key(app.app_host(t5.a), fuiwirt.KEY_TAB, 0 as u32)
        guard = guard + 1
    }
    check(app.focus(t5.a) == node_of(&t5, fontdlg.NODE_CANCEL), "Tab walks to the Cancel button")
    let ent: bool = fontdlg.dlg_key(t5.a as u64, editor.KEY_ENTER, 0 as u32)
    check(!ent && !fontdlg.dlg_done(t5.d), "Enter on Cancel is not taken by the dialog (the host presses the button)")
    let rr: u32 = fuiwirt.host_key(app.app_host(t5.a), fuiwirt.KEY_RETURN, 0 as u32)
    settle(t5.a)
    check(fontdlg.dlg_done(t5.d) && fontdlg.dlg_result(t5.d, &fam, &pick) == 1, "... and Cancel cancels")
    // the free
    fontdlg.dlg_free(t5.d)
    // a family that is not installed: the first row, no error text
    let nf: Sc = make("No Such Family", 9, w, h)
    var n4: Sc = nf
    check(fontdlg.dlg_family(n4.d) == 0 && fontdlg.dlg_size(n4.d) == 9, "an unknown family starts on the first row, size kept")
    check(same(fontdlg.dlg_status(n4.d), "510 font families"), "... and the status line does not call it an error")
}

// ------------------------------------------------------------ the walk in the frames

fn slice_checks(dir: str, w: usize, h: usize, want_fams: i64) {
    say("== 2b. the walk while the window is open\n")
    fontscan.set_dirs(dir)
    fontscan.begin()
    fontdlg.set_first_slice(1 as u64)
    let a: *mut app.App = app.window("Choose a font", fontdlg.WIN_W, fontdlg.WIN_H)
    let d: *mut fontdlg.FontDlg = fontdlg.dlg_new()
    fontdlg.build(a, d, "Test Box", 14)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, w, h)
    var t: Sc = Sc { a: a, d: d, s: s }
    let still: bool = !fontscan.done()
    check(still && fontdlg.dlg_status(d).n > 8 && same(str { p: fontdlg.dlg_status(d).p, n: 8 }, "Scanning"),
        "with a 1 ms first slice the walk is not over after build, and the status line says Scanning")
    var n: usize = 0
    while !fontscan.done() && n < 2000 {
        paint1(a, s)
        n = n + 1
    }
    paint1(a, s)
    check(fontscan.done() && fontdlg.dlg_status(d).n > 3 && same(fontdlg.dlg_status(d), "510 font families"),
        "the frames finish the walk, the line counts the families")
    check(same(family_name_of(&t), "Test Box"), "the family the dialog was given is chosen as soon as it is found")
    eq("all families are in the list", fontdlg.dlg_visible_count(d) as i64, want_fams)
    fontdlg.set_first_slice(120 as u64)
}

fn fallback_check(w: usize, h: usize) {
    say("== 2c. no fonts at all\n")
    fontscan.set_dirs("/nonexistent-font-folder")
    fontscan.begin()
    var t: Sc = make("Whatever", 12, w, h)
    check(fontscan.fallback_active() && fontdlg.dlg_visible_count(t.d) == 1, "the list has the one system entry")
    check(same(family_name_of(&t), "DejaVu Sans"), "... DejaVu Sans, chosen")
    check(same(fontdlg.dlg_status(t.d), "No fonts found - using the system font"), "the status line says so")
    key(&t, editor.KEY_ENTER)
    var fam: rt.Buf = rt.buf_new()
    var pick: fontdlg.FontPick = fontdlg.pick_new()
    check(fontdlg.dlg_result(t.d, &fam, &pick) == 0 && same(str { p: rt.buf_data(&fam), n: rt.buf_len(&fam) }, "DejaVu Sans"),
        "OK still works")
    save(t.s, "fontdlg-nofonts.png")
}

// ------------------------------------------------------------ 3. the sample

fn sample_checks(w: usize, h: usize) {
    say("== 3. the sample (pixels)\n")
    var t: Sc = make("Test Box", 12, w, h)
    let k12: Ink = ink_of(&t)
    check(k12.count > 100, "the sample draws ink")
    fontdlg.dlg_set_size(t.d, 48)
    frame(t.a, t.s)
    let k48: Ink = ink_of(&t)
    check(k48.count > k12.count * 4, "48 pt has far more ink than 12 pt")
    check((k48.bottom - k48.top) > (k12.bottom - k12.top) * 2, "... and is more than twice as high")
    save(t.s, "fontdlg-sample48.png")
    fontdlg.dlg_set_size(t.d, 999)
    frame(t.a, t.s)
    let kbig: Ink = ink_of(&t)
    var r: [f64; 4] = [0.0; 4]
    let ok: bool = fontdlg.dlg_preview_rect(t.d, &r)
    check(kbig.top >= (r[1] as usize) && kbig.bottom <= (r[1] + r[3]) as usize, "999 pt is capped to the box: the ink stays inside it")

    // the face: squares against bars
    fontdlg.dlg_set_size(t.d, 24)
    check(fontdlg.dlg_set_family(t.d, "Test Box"), "Test Box")
    frame(t.a, t.s)
    let box: Ink = ink_of(&t)
    check(fontdlg.dlg_set_family(t.d, "Test Bar"), "Test Bar")
    frame(t.a, t.s)
    let bar: Ink = ink_of(&t)
    check(box.count > bar.count * 3, "the sample is drawn WITH THE CHOSEN FACE: squares carry far more ink than bars")
    check(box.hash != bar.hash, "... and the pictures differ")
    eq("the sample loaded the two files (and DejaVu none yet)", fontdlg.dlg_font_loads(t.d) as i64, 2)
    check(fontdlg.dlg_set_family(t.d, "Test Box"), "back to Test Box")
    frame(t.a, t.s)
    eq("a face still in memory is not read again", fontdlg.dlg_font_loads(t.d) as i64, 2)
    check(ink_of(&t).hash == box.hash, "... and gives the same picture")

    // emulated bold and italic (Test Bar has neither face)
    check(fontdlg.dlg_set_family(t.d, "Test Bar"), "Test Bar again")
    frame(t.a, t.s)
    let plain: Ink = ink_of(&t)
    click_node(&t, fontdlg.NODE_BOLD)
    let bold: Ink = ink_of(&t)
    check(fontdlg.dlg_synth(t.d, 0) && bold.count > plain.count + plain.count / 8, "emulated Bold draws more ink than the plain face")
    click_node(&t, fontdlg.NODE_BOLD)
    click_node(&t, fontdlg.NODE_ITALIC)
    let it: Ink = ink_of(&t)
    check(fontdlg.dlg_synth(t.d, 1) && it.hash != plain.hash && it.top_left > it.bot_left,
        "emulated Italic shears the glyphs (the top of a bar lies right of its foot)")
    save(t.s, "fontdlg-synth-italic.png")
    click_node(&t, fontdlg.NODE_ITALIC)

    // the real face of a family that HAS Bold
    check(fontdlg.dlg_set_family(t.d, "Test Box"), "Test Box")
    let reg: Ink = ink_of(&t)
    click_node(&t, fontdlg.NODE_BOLD)
    check(!fontdlg.dlg_synth(t.d, 0) && same(face_style_of(&t), "Bold"), "Bold is the real face, not emulated")
    click_node(&t, fontdlg.NODE_BOLD)

    // underline and strikeout
    let before: Ink = ink_of(&t)
    click_node(&t, fontdlg.NODE_UNDERLINE)
    let ul: Ink = ink_of(&t)
    check(ul.count > before.count + 100 && ul.bottom > before.bottom, "Underline draws a line below the text")
    click_node(&t, fontdlg.NODE_UNDERLINE)
    click_node(&t, fontdlg.NODE_STRIKE)
    let st: Ink = ink_of(&t)
    check(st.count > before.count + 100 && st.bottom == before.bottom && st.top == before.top, "Strikeout draws a line through the text")
    save(t.s, "fontdlg-strike.png")
    click_node(&t, fontdlg.NODE_STRIKE)

    // a face that cannot be drawn: the system face stands in, the line says so
    check(fontdlg.dlg_set_family(t.d, "Test CFF"), "Test CFF")
    frame(t.a, t.s)
    check(ink_of(&t).count > 100, "a CFF face still shows a sample (system face)")
    check(same(fontdlg.dlg_status(t.d), "This font format cannot be previewed - showing the system font"), "... and the status line says why")

    // the sample text field
    fontdlg.dlg_set_family(t.d, "Test Box")
    clear_field(&t, fontdlg.NODE_SAMPLE)
    let empty: Ink = ink_of(&t)
    type_text(&t, "Ab")
    frame(t.a, t.s)
    let hi: Ink = ink_of(&t)
    check(hi.count > 0 && hi.count < reg.count, "the sample text is editable (\"Ab\" has less ink than the stock sample)")
}

// ------------------------------------------------------------ 4. look

fn pad_ok(c: u32) -> bool {
    return c != 0 as u32
}

fn contrast_checks(t: *mut Sc, tag: str) {
    let m: *mut theme.Theme = app.app_theme((*t).a)
    let f: *mut theme.Colors = theme.theme_colors(m)
    say("  ")
    say(tag)
    say(": contrast text/field ")
    say_int((theme.contrast(theme.opaque((*f).text), theme.opaque((*f).field)) * 100.0) as i64)
    say(", selection ")
    say_int((theme.contrast(theme.opaque((*f).selection_text), theme.opaque((*f).selection)) * 100.0) as i64)
    say(", status ")
    say_int((theme.contrast(theme.opaque((*f).text), theme.opaque((*f).base)) * 100.0) as i64)
    say("\n")
    check(theme.contrast(theme.opaque((*f).text), theme.opaque((*f).field)) >= 4.5, tag)
    check(theme.contrast(theme.opaque((*f).selection_text), theme.opaque((*f).selection)) >= 4.5, "selected row text on its ground")
    check(theme.contrast(theme.opaque((*f).text), theme.opaque((*f).base)) >= 4.5, "status text on the window ground")
}

fn look_checks(w: usize, h: usize) {
    say("== 4. look\n")
    var t: Sc = make("Test Box", 14, w, h)
    let m: *mut theme.Theme = app.app_theme(t.a)
    contrast_checks(&t, "light: list text on the field ground")
    let f: *mut theme.Colors = theme.theme_colors(m)

    // hover: a row that is not chosen changes colour under the pointer
    check(fontdlg.dlg_set_family(t.d, "DejaVu Sans"), "DejaVu Sans")
    frame(t.a, t.s)
    var g: [f64; 7] = [0.0; 7]
    check(geom(&t, fontdlg.DLG_FAMILY, &g), "geometry")
    // the row just below the chosen one
    var x: f64 = 0.0
    var y: f64 = 0.0
    check(row_xy(&t, fontdlg.DLG_FAMILY, fontscan.find_family("DejaVu Sans") + 1, &x, &y), "the row below the chosen one is in view")
    let rest: u32 = pix(&t, (g[0] + g[2] - 30.0) as usize, y as usize)
    move_xy(&t, x, y)
    let hover: u32 = pix(&t, (g[0] + g[2] - 30.0) as usize, y as usize)
    check(rest != hover, "hover paints the row under the pointer (rest and hover differ)")
    check(hover == (theme.opaque((*f).button_hover) & 16777215 as u32), "... in the hover colour of the theme")
    move_xy(&t, 5.0, h as f64 - 5.0)
    check(pix(&t, (g[0] + g[2] - 30.0) as usize, y as usize) == rest, "... and gives it back when the pointer leaves")
    // the chosen row
    var sx: f64 = 0.0
    var sy: f64 = 0.0
    check(row_xy(&t, fontdlg.DLG_FAMILY, fontscan.find_family("DejaVu Sans"), &sx, &sy), "the chosen row is in view")
    check(pix(&t, (g[0] + g[2] - 30.0) as usize, sy as usize) == (theme.opaque((*f).selection) & 16777215 as u32),
        "the chosen row is painted in the selection colour")
    // the focus ring: click the list
    let before: u32 = pix(&t, (g[0] + 60.0) as usize, (g[1] + 1.0) as usize)
    click_xy(&t, g[0] + g[2] - 40.0, g[1] + g[3] - 6.0)
    let ring: u32 = pix(&t, (g[0] + 60.0) as usize, (g[1] + 1.0) as usize)
    check(before != ring, "the focus ring appears around the list that has the focus")
    save(t.s, "fontdlg-light.png")

    // dark: a dialog that is dark from its first frame (as a window on a dark desktop is)
    let dk: Sc = make_dark("Test Box", 14, w, h)
    t = dk
    let fm: *mut theme.Theme = app.app_theme(t.a)
    check(fontdlg.dlg_set_family(t.d, "DejaVu Sans"), "DejaVu Sans (dark dialog)")
    frame(t.a, t.s)
    contrast_checks(&t, "dark: list text on the field ground")
    let fd: *mut theme.Colors = theme.theme_colors(fm)
    check((*fd).dark, "the theme is dark")
    check(row_xy(&t, fontdlg.DLG_FAMILY, fontscan.find_family("DejaVu Sans"), &sx, &sy), "the chosen row is in view")
    check(pix(&t, (g[0] + g[2] - 30.0) as usize, sy as usize) == (theme.opaque((*fd).selection) & 16777215 as u32),
        "dark: the chosen row is painted in the dark selection colour")
    var r: [f64; 4] = [0.0; 4]
    let ok: bool = fontdlg.dlg_preview_rect(t.d, &r)
    check(pix(&t, (r[0] + 6.0) as usize, (r[1] + 6.0) as usize) == (theme.opaque((*fd).field) & 16777215 as u32),
        "dark: the sample ground is the dark field colour")
    check(ink_of(&t).count > 100, "dark: the sample draws ink")
    move_xy(&t, 5.0, h as f64 - 5.0)
    save(t.s, "fontdlg-dark.png")

    // accessibility
    check(app.audit(t.a) == 0, "accessibility audit: every operable part is named (0 unnamed)")
    var buf: [u8; 4096] = [0 as u8; 4096]
    let n: usize = a11y.a11y_dump(app.app_scene(t.a), &(*t.a).ax, (&buf[0]) as u64, 4096)
    var has_list: bool = false
    var i: usize = 0
    while i + 4 < n {
        if buf[i] == 108 as u8 && buf[i + 1] == 105 as u8 && buf[i + 2] == 115 as u8 && buf[i + 3] == 116 as u8 {
            has_list = true
        }
        i = i + 1
    }
    check(has_list, "the lists carry the role list in the accessibility dump")
}

// ------------------------------------------------------------ 5. speed

fn time_frames(t: *mut Sc, state: str, n: usize) {
    var worst: f64 = 0.0
    var i: usize = 0
    while i < n {
        let a: f64 = now_ms()
        paint1((*t).a, (*t).s)
        let b: f64 = now_ms()
        if b - a > worst {
            worst = b - a
        }
        i = i + 1
    }
    frame_ms(state, worst)
}

fn speed_checks(w: usize, h: usize) {
    say("== 5. speed\n")
    var wh: usize = 0
    while wh < 2 {
        var sw: usize = w
        var sh: usize = h
        var tag: str = "dialog"
        if wh == 1 {
            sw = 1240
            sh = 720
            tag = "1240x720"
        }
        let a: *mut app.App = app.window("Choose a font", fontdlg.WIN_W, fontdlg.WIN_H)
        let d: *mut fontdlg.FontDlg = fontdlg.dlg_new()
        fontdlg.build(a, d, "Gen Family 250", 14)
        fuiwirt.host_bind(app.app_host(a))
        let s: *mut Surface = surface_for(a, sw, sh)
        var t: Sc = Sc { a: a, d: d, s: s }
        let f0: f64 = now_ms()
        paint1(a, s)
        let f1: f64 = now_ms()
        say("FRAME_MS first-")
        say(tag)
        say(" ")
        say_int(((f1 - f0) * 10.0 + 0.5) as i64 / 10)
        say(".")
        say_int(((f1 - f0) * 10.0 + 0.5) as i64 % 10)
        say("\n")
        if f1 - f0 > 16.0 {
            BAD = BAD + 1
            say("  WRONG the first frame took more than 16 ms\n")
        }
        frame(a, s)
        time_frames(&t, "steady-" + tag, 20)
        var g: [f64; 7] = [0.0; 7]
        let ok: bool = geom(&t, fontdlg.DLG_FAMILY, &g)
        var hv: f64 = 0.0
        var worst_h: f64 = 0.0
        var k: usize = 0
        while k < 12 {
            let c1: u32 = fuiwirt.host_pointer_move(app.app_host(a), g[0] + 40.0, g[1] + 10.0 + (k as f64) * 12.0)
            let a0: f64 = now_ms()
            paint1(a, s)
            let a1: f64 = now_ms()
            if a1 - a0 > worst_h {
                worst_h = a1 - a0
            }
            k = k + 1
        }
        frame_ms("hover-" + tag, worst_h)
        // the worst case: 510 families, wheel through the whole list
        var worst_s: f64 = 0.0
        k = 0
        while k < 60 {
            wheel(&t, g[0] + 40.0, g[1] + 40.0, true, 1)
            k = k + 1
        }
        k = 0
        while k < 60 {
            let c2: u32 = fuiwirt.host_pointer_move(app.app_host(a), g[0] + 40.0, g[1] + 40.0)
            let b0: f64 = now_ms()
            let c3: u32 = fuiwirt.host_pointer_down(app.app_host(a), g[0] + 40.0, g[1] + 40.0, fuiwirt.BTN_WHEEL_UP)
            paint1(a, s)
            let b1: f64 = now_ms()
            if b1 - b0 > worst_s {
                worst_s = b1 - b0
            }
            k = k + 1
        }
        frame_ms("scroll-" + tag, worst_s)
        // typing into the filter (refilter of 510 families)
        click_node(&t, fontdlg.NODE_FILTER)
        var worst_f: f64 = 0.0
        let word: str = "gen family 4"
        k = 0
        while k < word.n {
            let b2: bool = fontdlg.dlg_char(a as u64, rt.ld8(word.p as u64, k) as u32, 0 as u32)
            let d0: f64 = now_ms()
            paint1(a, s)
            let d1: f64 = now_ms()
            if d1 - d0 > worst_f {
                worst_f = d1 - d0
            }
            k = k + 1
        }
        frame_ms("filter-" + tag, worst_f)
        // a new family: the frame that reads its file into the sample
        var worst_l: f64 = 0.0
        var fam: usize = 0
        while fam < 6 {
            let ok2: bool = fontdlg.dlg_set_family(d, "Gen Family 0" + "1" + "0")
            fontdlg.dlg_set_size(d, 14 + (fam as i32))
            let e0: f64 = now_ms()
            paint1(a, s)
            let e1: f64 = now_ms()
            if e1 - e0 > worst_l {
                worst_l = e1 - e0
            }
            fam = fam + 1
        }
        frame_ms("size-change-" + tag, worst_l)
        wh = wh + 1
    }
    // the real file: DejaVu Sans (750 KB) read into the sample
    var t2: Sc = make("Gen Family 010", 14, w, h)
    let g0: f64 = now_ms()
    let okd: bool = fontdlg.dlg_set_family(t2.d, "DejaVu Sans")
    paint1(t2.a, t2.s)
    let g1: f64 = now_ms()
    frame_ms("font-switch-DejaVu-Sans-750KB", g1 - g0)
    let okt: bool = fontdlg.dlg_set_family(t2.d, "Test Box")
    paint1(t2.a, t2.s)
    let okf: bool = fontdlg.dlg_set_family(t2.d, "Gen Family 011")
    paint1(t2.a, t2.s)
    let h0: f64 = now_ms()
    let okg: bool = fontdlg.dlg_set_family(t2.d, "DejaVu Serif")
    paint1(t2.a, t2.s)
    let h1: f64 = now_ms()
    frame_ms("font-switch-DejaVu-Serif-380KB", h1 - h0)
}

// ------------------------------------------------------------ main

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        say("usage: fontdlg_main <fontdir> [dir-for-pngs]\n")
        return 2
    }
    let dirp: u64 = rt.arg_ptr(start, 1)
    let dir: str = str { p: dirp as *mut u8, n: rt.c_length(dirp) }
    if rt.arg_count(start) > 2 {
        PNGDIR = rt.arg_ptr(start, 2)
    }
    var fs: *mut metrics.FontSet = rt.heap_alloc(65536) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("no system font\n")
        return 9
    }
    FONT = fs as u64
    let want_fams: i64 = read_expected(dir)
    if want_fams < 0 {
        say("no EXPECTED file in the font folder (run tools/dialog/fontdlg_fonts.py)\n")
        return 2
    }
    let w: usize = fontdlg.WIN_W
    let h: usize = fontdlg.WIN_H
    walk_checks(dir, want_fams)
    dialog_checks(w, h, want_fams)
    slice_checks(dir, w, h, want_fams)
    fallback_check(w, h)
    // the rest wants the folder back
    fontscan.set_dirs(dir)
    fontscan.begin()
    let fin: bool = fontscan.step(0 as u64)
    sample_checks(w, h)
    look_checks(w, h)
    speed_checks(w, h)
    if BAD == 0 {
        say("FONTDLG PASSED\n")
        return 0
    }
    say("FONTDLG FAILED (")
    say_int(BAD as i64)
    say(")\n")
    return 1
}
