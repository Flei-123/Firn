// tools/fui/appw12_main.fi -- wave 12 controls (appctl.datepicker, navview, tree) in the ten-line API: keys, clicks, a11y.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.wave12
import fui.lucide
import fui.anim
import fui.style
import fui.a11y
import fui.render
import fui.safeout

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn num(tag: str, v: f64) {
    say(tag)
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v as i64)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

#[allow_escape]
fn dlen(a: *mut app.App, node: usize) -> usize {
    var db: [u8; 192] = [0 as u8; 192]
    let n: usize = a11y.a11y_description(app.app_scene(a), app.ax(a), node, (&db[0]) as u64, 192)
    return n
}

fn click(w: *mut fuiwirt.Host, x: f64, y: f64) {
    let m: u32 = fuiwirt.host_pointer_move(w, x, y)
    let d: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let u: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appw12: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Wave12", 700, 760)
    let dp: usize = appctl.datepicker(a, "Trip", 2026, 10, 18, true, changed)
    let nv: usize = appctl.navview(a, "Sections", 240, changed)
    let tr: usize = appctl.tree(a, "Files", 240, 160, changed)
    let s: *mut Surface = surface_for(a, 700, 760)
    let h1: bool = appctl.navview_header(a, nv, "Main")
    let n1: bool = appctl.navview_add(a, nv, lucide.HOUSE, "Home", 0) && appctl.navview_add(a, nv, lucide.FOLDER, "Files", 3)
    && appctl.navview_add(a, nv, lucide.STAR, "Starred", 0)
    let t1: bool = appctl.tree_add(a, tr, 0, "Documents", true) && appctl.tree_add(a, tr, 1, "Work", false)
    && appctl.tree_add(a, tr, 2, "Report", false) && appctl.tree_add(a, tr, 0, "Music", false)
    settle(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    let w: *mut fuiwirt.Host = app.app_host(a)
    let ax: *mut a11y.A11y = app.ax(a)
    check(dp != appctl.NONE && nv != appctl.NONE && tr != appctl.NONE && h1 && n1 && t1, "all three controls exist and are filled")
    check(scene.node_w(sc, dp) > 200.0 && scene.node_h(sc, tr) > 100.0 && scene.node_w(sc, nv) > 150.0, "they have a size")
    check(a11y.a11y_role(sc, ax, tr) == a11y.ROLE_TREE && a11y.a11y_role(sc, ax, nv) == a11y.ROLE_LIST && a11y.a11y_role(sc, ax, dp) == a11y.ROLE_GROUP, "a11y roles")
    check(dlen(a, dp) > 0 && dlen(a, tr) > 0 && dlen(a, nv) > 0, "a11y descriptions are set")
    // ---- calendar: range by clicks
    var r: [f64; 4] = [0.0; 4]
    check(appctl.datepicker_day_rect(a, dp, 8, &r), "day rect")
    let c0: usize = CHANGES
    click(w, r[0] + r[2] / 2.0, r[1] + r[3] / 2.0)
    check(appctl.datepicker_start(a, dp) == 20261008 && !appctl.datepicker_complete(a, dp) && CHANGES == c0 + 1, "click 1: the start, the range waits for its end")
    check(appctl.datepicker_day_rect(a, dp, 14, &r), "day rect 14")
    click(w, r[0] + r[2] / 2.0, r[1] + r[3] / 2.0)
    check(appctl.datepicker_end(a, dp) == 20261014 && appctl.datepicker_complete(a, dp) && CHANGES == c0 + 2, "click 2: the range is complete")
    check(appctl.datepicker_arrow_rect(a, dp, wave12.CAL_NEXT, &r), "arrow rect")
    click(w, r[0] + r[2] / 2.0, r[1] + r[3] / 2.0)
    check(appctl.datepicker_month(a, dp) == 202611 && appctl.datepicker_start(a, dp) == 20261008, "the next arrow shows November, the range stays")
    app.set_focus(a, dp)
    let k1: bool = app.app_key(a as u64, editor.KEY_PGUP, 0 as u32)
    let k2: bool = app.app_key(a as u64, editor.KEY_DOWN, 0 as u32)
    check(k1 && k2 && appctl.datepicker_month(a, dp) == 202610 && appctl.datepicker_cursor(a, dp) == 21, "PgUp back to October, Down = +7")
    app.app_act(a as u64, dp)
    check(appctl.datepicker_start(a, dp) == 20261021 && appctl.datepicker_end(a, dp) == 0, "Enter chooses the cursor day (a new range)")
    appctl.datepicker_set(a, dp, 20261101, 20261105)
    check(appctl.datepicker_month(a, dp) == 202611 && appctl.datepicker_end(a, dp) == 20261105 && appctl.datepicker_complete(a, dp), "datepicker_set (program side)")
    // ---- nav view
    settle(a, s)
    check(appctl.navview_selected(a, nv) == 1 && appctl.navview_open(a, nv), "first item selected, pane open")
    check(appctl.navview_item_rect(a, nv, 2, &r), "item rect")
    let c1: usize = CHANGES
    click(w, r[0] + r[2] / 2.0, r[1] + r[3] / 2.0)
    check(appctl.navview_selected(a, nv) == 2 && appctl.navview_event(a, nv) == 1 && CHANGES == c1 + 1, "a click selects the item and calls back")
    check(appctl.navview_hamburger_rect(a, nv, &r), "hamburger rect")
    click(w, r[0] + r[2] / 2.0, r[1] + r[3] / 2.0)
    settle(a, s)
    num("  nv width after collapse ", scene.node_w(sc, nv))
    check(!appctl.navview_open(a, nv) && appctl.navview_event(a, nv) == 2 && scene.node_w(sc, nv) < 90.0, "the hamburger collapses the pane to the compact 64 and the node shrinks")
    appctl.navview_set_mode(a, nv, wave12.NV_MINIMAL)
    settle(a, s)
    check(scene.node_w(sc, nv) < 60.0 && !appctl.navview_item_rect(a, nv, 1, &r), "minimal: 48 wide, no item rectangles")
    appctl.navview_toggle(a, nv)
    settle(a, s)
    check(appctl.navview_open(a, nv) && scene.node_w(sc, nv) > 200.0, "toggle opens the overlay pane (240)")
    app.set_focus(a, nv)
    let e1: bool = app.app_key(a as u64, editor.KEY_ESC, 0 as u32)
    settle(a, s)
    check(e1 && !appctl.navview_open(a, nv), "Esc closes the overlay of the minimal mode")
    appctl.navview_set_mode(a, nv, wave12.NV_EXPANDED)
    settle(a, s)
    let u1: bool = app.app_key(a as u64, editor.KEY_UP, 0 as u32)
    let u2: bool = app.app_key(a as u64, editor.KEY_UP, 0 as u32)
    check(u1 && appctl.navview_selected(a, nv) == 1, "Up moves to the first item")
    // ---- tree
    check(appctl.tree_selected(a, tr) == 0 && appctl.tree_count(a, tr) == 4 && appctl.tree_visible(a, tr) == 3, "tree: Documents selected, 3 rows visible")
    check(appctl.tree_item_rect(a, tr, 1, &r), "tree item rect")
    let c2: usize = CHANGES
    click(w, r[0] + r[2] / 2.0, r[1] + r[3] / 2.0)
    check(appctl.tree_selected(a, tr) == 1 && CHANGES == c2 + 1, "a click selects Work")
    app.set_focus(a, tr)
    let r1: bool = app.app_key(a as u64, editor.KEY_RIGHT, 0 as u32)
    check(r1 && appctl.tree_is_open(a, tr, 1) && appctl.tree_visible(a, tr) == 4 && appctl.tree_event(a, tr) == 2, "Right opens Work")
    let r2: bool = app.app_key(a as u64, editor.KEY_DOWN, 0 as u32)
    check(r2 && appctl.tree_selected(a, tr) == 2, "Down: Report")
    let l1: bool = app.app_key(a as u64, editor.KEY_LEFT, 0 as u32)
    check(l1 && appctl.tree_selected(a, tr) == 1, "Left: back to the parent")
    // ---- pictures: calendar range in November, expanded pane, open tree -- light then dark
    app.set_focus(a, dp)
    settle(a, s)
    save(&(*s).cv, dir, "wave12-light.png")
    app.set_dark(a, true)
    settle(a, s)
    save(&(*s).cv, dir, "wave12-dark.png")
    app.set_dark(a, false)
    settle(a, s)
    check(appctl.tree_set_open(a, tr, 0, false) && appctl.tree_selected(a, tr) == 0 && appctl.tree_visible(a, tr) == 2, "program closes Documents: the selection follows")
    check(dlen(a, tr) > 0, "description follows")
    check(appctl.tree_selected(a, dp) == appctl.NONE && appctl.datepicker_start(a, tr) == 0 && appctl.navview_selected(a, 9999) == appctl.NONE, "wrong ids are harmless")
    if BAD == 0 {
        say("APPW12 PASSED\n")
        return 0
    }
    say("APPW12 FAILED\n")
    return 1
}
