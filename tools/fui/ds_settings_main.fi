import ds_testpage
import fui.ds_settings
import fui.editor
import fui.lucide
import fui.render
import fui.screenax
import fui.style
import fui.widget
import plat.fuiwirt

const LANGS: str = "English|Deutsch|Francais"
const NONE: usize = 18446744073709551615

fn frame(p: *mut ds_settings.Panel, pg: *mut ds_testpage.Page, hx: f64, hy: f64) {
    let c: *mut render.Ctx = &(*pg).c
    ds_testpage.clear(pg)
    screenax.begin()
    ds_settings.begin(p, c, 20.0, 20.0, 700.0, hx, hy)
    ds_settings.row_plain(p, c, 0, lucide.SETTINGS, "Network", "Wi-Fi, Ethernet")
    ds_settings.row_toggle(p, c, 1, lucide.SUN, "Wi-Fi", "")
    ds_settings.row_combo(p, c, 2, lucide.MENU, "Language", "", LANGS)
    ds_settings.row_slider(p, c, 3, 0 - 1, "Volume", "", 0, 100, "%")
    ds_settings.row_button(p, c, 4, 0 - 1, "Reset", "Back to defaults", "Reset")
    ds_settings.row_chevron(p, c, 5, 0 - 1, "About", "")
    ds_settings.row_value(p, c, 6, 0 - 1, "Version", "", "1.2.3", false)
    ds_settings.row_value(p, c, 7, 0 - 1, "Storage", "", "42 GB", true)
    ds_settings.group_begin(p, c, 8, lucide.POWER, "Advanced", "", ds_settings.body_height(c, 2, 0))
    ds_settings.row_toggle(p, c, 9, 0 - 1, "Developer mode", "")
    ds_settings.row_toggle(p, c, 10, 0 - 1, "Telemetry", "")
    ds_settings.group_end(p, c)
    ds_settings.row_toggle(p, c, 11, 0 - 1, "Quiet option", "")
    ds_settings.end(p, c)
}

fn mid_y(p: *mut ds_settings.Panel, id: usize) -> f64 {
    var q: [f64; 4] = [0.0; 4]
    ds_settings.row_rect(p, id, &q)
    return q[1] + q[3] / 2.0
}

fn left_x(p: *mut ds_settings.Panel, id: usize) -> f64 {
    var q: [f64; 4] = [0.0; 4]
    ds_settings.row_rect(p, id, &q)
    return q[0] + 30.0
}

fn ctl_x(p: *mut ds_settings.Panel, id: usize, frac: f64) -> f64 {
    var q: [f64; 4] = [0.0; 4]
    ds_settings.control_rect(p, id, &q)
    return q[0] + q[2] * frac
}

fn click_row(p: *mut ds_settings.Panel, id: usize) -> usize {
    return ds_settings.click(p, left_x(p, id), mid_y(p, id))
}

fn node(name: str) -> usize {
    var i: usize = 0
    while i < screenax.count() {
        if screenax.name_of(i) == name { return i }
        i = i + 1
    }
    return NONE
}

fn press_key(p: *mut ds_settings.Panel, k: u32) -> bool {
    return ds_settings.key(p, k, 0 as u32)
}

fn main() -> i32 {
    let font: u64 = ds_testpage.font_load()
    if font == 0 {
        ds_testpage.say("no system font\n")
        return 2
    }
    screenax.install()
    let pg: *mut ds_testpage.Page = ds_testpage.page_new(760, 900, true, font)
    let c: *mut render.Ctx = &(*pg).c
    let p: *mut ds_settings.Panel = ds_settings.panel_new()
    ds_settings.set_enabled(p, 10, false)
    ds_settings.set_enabled(p, 11, false)
    let base: u32 = ds_testpage.tok(pg, style.TOK_BASE)
    var q: [f64; 4] = [0.0; 4]
    var q2: [f64; 4] = [0.0; 4]

    ds_testpage.say("== layout\n")
    frame(p, pg, 0.0 - 1.0, 0.0 - 1.0)
    ds_settings.row_rect(p, 0, &q)
    ds_settings.row_rect(p, 1, &q2)
    ds_testpage.check(q[3] == 68.0 && q2[3] == 52.0, "row with subtitle is 68, without 52")
    ds_testpage.check(q2[1] == q[1] + 68.0 + 3.0, "rows stack with a 3 px gap")
    ds_testpage.check(q[0] == 20.0 && q[2] == 700.0, "row takes the panel width")
    ds_settings.row_rect(p, 8, &q)
    ds_testpage.check(q[3] == 52.0, "collapsed group is one header row")
    ds_settings.row_rect(p, 11, &q2)
    ds_testpage.check(q2[1] == q[1] + 52.0 + 3.0, "row after a collapsed group follows the header")
    ds_testpage.check((*p).n == 10, "children of a collapsed group are not registered")
    ds_testpage.check(ds_settings.y_end(p) > q2[1] + 52.0, "panel cursor below the last row")

    ds_testpage.say("== toggle\n")
    ds_settings.press(p, left_x(p, 1), mid_y(p, 1))
    ds_testpage.check(ds_settings.val(p, 1) == 0, "press alone does not flip")
    ds_testpage.check(ds_settings.release(p, left_x(p, 1), mid_y(p, 1)) == 1 && ds_settings.val(p, 1) == 1, "release on the row flips it")
    ds_settings.press(p, left_x(p, 1), mid_y(p, 1))
    ds_testpage.check(ds_settings.release(p, left_x(p, 0), mid_y(p, 0)) == NONE && ds_settings.val(p, 1) == 1, "release on another row cancels")
    ds_testpage.check(click_row(p, 1) == 1 && ds_settings.val(p, 1) == 0, "whole row is the click target")
    ds_testpage.check(ds_settings.click(p, 5.0, 5.0) == NONE, "click outside hits nothing")
    ds_testpage.check(ds_settings.click(p, 730.0, mid_y(p, 1)) == NONE, "click right of the card hits nothing")

    ds_testpage.say("== plain, chevron, value, button\n")
    ds_testpage.check(click_row(p, 0) == 0 && ds_settings.fired(p) == 0, "plain row fires")
    ds_testpage.check(ds_settings.fired(p) == NONE, "fired is consumed")
    ds_testpage.check(click_row(p, 5) == 5 && ds_settings.fired(p) == 5, "chevron row fires")
    ds_testpage.check(click_row(p, 6) == NONE && ds_settings.fired(p) == NONE, "plain value row is not clickable")
    ds_testpage.check(click_row(p, 7) == 7 && ds_settings.fired(p) == 7, "value row with a chevron fires")
    ds_testpage.check(click_row(p, 4) == NONE && ds_settings.fired(p) == NONE, "button row ignores a click beside the button")
    ds_testpage.check(ds_settings.click(p, ctl_x(p, 4, 0.5), mid_y(p, 4)) == 4 && ds_settings.fired(p) == 4, "click on the button fires")

    ds_testpage.say("== combo\n")
    ds_testpage.check(click_row(p, 2) == 2 && ds_settings.combo_open(p) == 2, "click opens the list")
    frame(p, pg, 0.0 - 1.0, 0.0 - 1.0)
    ds_settings.control_rect(p, 2, &q)
    ds_testpage.check(ds_testpage.region_differs(pg, q[0], q[1] + q[3] + 6.0, q[2], 60.0, base) > 500, "list drawn under the box")
    ds_settings.item_rect(p, c, 2, 2, &q2)
    ds_testpage.check(q2[1] > q[1] + q[3], "list item below the box")
    ds_testpage.check(ds_settings.click(p, q2[0] + 5.0, q2[1] + 5.0) == 2 && ds_settings.val(p, 2) == 2 && ds_settings.combo_open(p) == NONE, "item picked and list closed")
    click_row(p, 2)
    ds_testpage.check(ds_settings.click(p, 600.0, 800.0) == NONE && ds_settings.combo_open(p) == NONE && ds_settings.val(p, 2) == 2, "click away closes without a change")
    click_row(p, 2)
    ds_testpage.check(press_key(p, editor.KEY_ESC) && ds_settings.combo_open(p) == NONE, "Esc closes")

    ds_testpage.say("== slider\n")
    frame(p, pg, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(click_row(p, 3) == NONE && !ds_settings.dragging(p), "row text is not the slider")
    ds_settings.control_rect(p, 3, &q)
    ds_settings.press(p, q[0] + 1.0, q[1] + 12.0)
    ds_testpage.check(ds_settings.val(p, 3) == 0 && ds_settings.dragging(p), "press at the left end = lo, drag starts")
    ds_testpage.check(ds_settings.pointer(p, fuiwirt.HOOK_MOVE, q[0] + q[2], q[1]) && ds_settings.val(p, 3) == 100, "drag to the right end = hi")
    ds_testpage.check(ds_settings.pointer(p, fuiwirt.HOOK_MOVE, q[0] + q[2] / 2.0, q[1]) && ds_settings.val(p, 3) >= 49 && ds_settings.val(p, 3) <= 51, "drag to the middle = about 50")
    ds_testpage.check(ds_settings.pointer(p, fuiwirt.HOOK_UP, q[0] + q[2] / 4.0, q[1]) && !ds_settings.dragging(p) && ds_settings.val(p, 3) >= 21 && ds_settings.val(p, 3) <= 23, "release sets the value and ends the drag")
    ds_testpage.check(!ds_settings.pointer(p, fuiwirt.HOOK_MOVE, q[0], q[1]), "no drag, no pointer handling")

    ds_testpage.say("== group\n")
    ds_testpage.check(click_row(p, 8) == 8 && ds_settings.expanded(p, 8), "click on the header expands")
    frame(p, pg, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check((*p).n == 12, "children are registered when expanded")
    ds_settings.row_rect(p, 8, &q)
    ds_settings.row_rect(p, 9, &q2)
    ds_testpage.check(q2[1] == q[1] + q[3] && q2[3] == 52.0, "child row sits right under the header")
    ds_settings.row_rect(p, 11, &q2)
    ds_testpage.check(q2[1] == q[1] + 52.0 + 104.0 + 3.0, "next row follows header + body + gap")
    ds_testpage.check(click_row(p, 9) == 9 && ds_settings.val(p, 9) == 1, "child toggle works")
    ds_testpage.check(click_row(p, 10) == NONE && ds_settings.val(p, 10) == 0, "disabled child ignores a click")
    ds_testpage.check(click_row(p, 8) == 8 && !ds_settings.expanded(p, 8), "second click collapses")
    frame(p, pg, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check((*p).n == 10, "children gone after collapse")

    ds_testpage.say("== disabled\n")
    ds_testpage.check(click_row(p, 11) == NONE && ds_settings.val(p, 11) == 0, "disabled row ignores a click")
    ds_settings.set_enabled(p, 11, true)
    frame(p, pg, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(click_row(p, 11) == 11 && ds_settings.val(p, 11) == 1, "enabled again, the click works")
    ds_settings.set_enabled(p, 11, false)
    ds_settings.set_val(p, 11, 0)

    ds_testpage.say("== keyboard\n")
    ds_settings.reset(p)
    frame(p, pg, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(press_key(p, editor.KEY_TAB) && ds_settings.focus_id(p) == 0, "Tab goes to the first row")
    ds_testpage.check(press_key(p, editor.KEY_TAB) && ds_settings.focus_id(p) == 1, "Tab goes to the next row")
    ds_testpage.check(press_key(p, editor.KEY_ENTER) && ds_settings.val(p, 1) == 1, "Enter flips the toggle")
    ds_testpage.check(ds_settings.text(p, 32 as u32, 0 as u32) && ds_settings.val(p, 1) == 0, "Space flips the toggle")
    ds_testpage.check(press_key(p, editor.KEY_RIGHT) && ds_settings.val(p, 1) == 1 && press_key(p, editor.KEY_LEFT) && ds_settings.val(p, 1) == 0, "Right and Left set the toggle")
    ds_settings.set_val(p, 2, 0)
    ds_testpage.check(press_key(p, editor.KEY_DOWN) && ds_settings.focus_id(p) == 2, "Down moves to the combo")
    ds_testpage.check(press_key(p, editor.KEY_RIGHT) && ds_settings.val(p, 2) == 1, "Right picks the next option")
    ds_testpage.check(press_key(p, editor.KEY_ENTER) && ds_settings.combo_open(p) == 2, "Enter opens the list")
    ds_testpage.check(press_key(p, editor.KEY_DOWN) && press_key(p, editor.KEY_ENTER) && ds_settings.val(p, 2) == 2 && ds_settings.combo_open(p) == NONE, "Down + Enter picks in the list")
    ds_testpage.check(press_key(p, editor.KEY_DOWN) && ds_settings.focus_id(p) == 3, "Down moves to the slider")
    ds_settings.set_val(p, 3, 40)
    ds_testpage.check(press_key(p, editor.KEY_RIGHT) && ds_settings.val(p, 3) == 45, "Right = one step (5 percent of the range)")
    ds_testpage.check(press_key(p, editor.KEY_HOME) && ds_settings.val(p, 3) == 0 && press_key(p, editor.KEY_END) && ds_settings.val(p, 3) == 100, "Home and End")
    ds_testpage.check(press_key(p, editor.KEY_PGDN) && ds_settings.val(p, 3) == 75, "PageDown = five steps")
    ds_testpage.check(press_key(p, editor.KEY_DOWN) && ds_settings.focus_id(p) == 4 && press_key(p, editor.KEY_ENTER) && ds_settings.fired(p) == 4, "Enter on the button row fires")
    ds_testpage.check(ds_settings.key(p, editor.KEY_TAB, editor.MOD_SHIFT) && ds_settings.focus_id(p) == 3, "Shift+Tab goes back")
    ds_settings.set_focus(p, 7)
    ds_testpage.check(press_key(p, editor.KEY_TAB) && ds_settings.focus_id(p) == 8, "Tab walks onto the group")
    ds_testpage.check(press_key(p, editor.KEY_RIGHT) && ds_settings.expanded(p, 8), "Right expands the group")
    frame(p, pg, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(press_key(p, editor.KEY_TAB) && ds_settings.focus_id(p) == 9, "Tab enters the group")
    ds_testpage.check(press_key(p, editor.KEY_TAB) && ds_settings.focus_id(p) == 0, "Tab skips disabled rows and wraps")
    ds_settings.set_focus(p, 8)
    ds_testpage.check(press_key(p, editor.KEY_LEFT) && !ds_settings.expanded(p, 8), "Left collapses the group")
    ds_settings.set_focus(p, 6)
    frame(p, pg, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(press_key(p, editor.KEY_DOWN) && ds_settings.focus_id(p) == 7, "arrow skips a plain value row going down")
    ds_testpage.check(press_key(p, editor.KEY_UP) && ds_settings.focus_id(p) == 5, "arrow skips a plain value row going up")

    ds_testpage.say("== accessibility\n")
    ds_settings.reset(p)
    ds_settings.set_val(p, 1, 1)
    ds_settings.set_val(p, 3, 40)
    ds_settings.set_expanded(p, 8, true)
    ds_settings.set_focus(p, 2)
    frame(p, pg, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(screenax.count() == 12, "one node per row")
    var i: usize = node("Network: Wi-Fi, Ethernet")
    ds_testpage.check(i != NONE && screenax.kind_of(i) == widget.KIND_BUTTON, "plain row: title and subtitle in the name")
    i = node("Wi-Fi")
    ds_testpage.check(i != NONE && screenax.kind_of(i) == widget.KIND_TOGGLE && (screenax.state_of(i) & screenax.F_CHECKED) != 0 as u32, "toggle row is checked")
    i = node("Language")
    ds_testpage.check(i != NONE && screenax.kind_of(i) == widget.KIND_DROPDOWN && (screenax.state_of(i) & screenax.F_FOCUS) != 0 as u32 && screenax.value_of(i) == 2, "combo row: focus and index")
    i = node("Volume")
    ds_testpage.check(i != NONE && screenax.kind_of(i) == widget.KIND_SLIDER && screenax.value_of(i) == 400, "slider value in per mille")
    ds_testpage.check(screenax.apply_num(i, 250) && ds_settings.val(p, 3) == 25, "a screen reader can set the slider")
    i = node("Reset: Back to defaults")
    ds_testpage.check(i != NONE && screenax.kind_of(i) == widget.KIND_BUTTON, "button row")
    i = node("Telemetry")
    ds_testpage.check(i != NONE && (screenax.state_of(i) & screenax.F_DISABLED) != 0 as u32, "disabled child is flagged")
    i = node("Advanced")
    ds_testpage.check(i != NONE && (screenax.state_of(i) & screenax.F_CHECKED) != 0 as u32 && screenax.value_of(i) == 1, "expanded group is flagged")

    ds_testpage.say("== pixels\n")
    ds_settings.reset(p)
    ds_settings.set_expanded(p, 8, false)
    ds_settings.set_val(p, 1, 0)
    frame(p, pg, 0.0 - 1.0, 0.0 - 1.0)
    ds_settings.row_rect(p, 0, &q)
    ds_testpage.check(ds_testpage.region_differs(pg, q[0], q[1], q[2], q[3], base) > 5000, "card and text drawn")
    let rest: u32 = ds_testpage.px(pg, 400.0, q[1] + 20.0)
    frame(p, pg, 400.0, q[1] + 20.0)
    ds_testpage.check(ds_testpage.px(pg, 400.0, q[1] + 20.0) != rest, "hover tints the row")
    ds_settings.press(p, 400.0, q[1] + 20.0)
    frame(p, pg, 400.0, q[1] + 20.0)
    ds_testpage.check(ds_testpage.px(pg, 400.0, q[1] + 20.0) != rest, "pressed row differs from rest")
    ds_settings.release(p, 5.0, 5.0)
    ds_settings.row_rect(p, 6, &q)
    frame(p, pg, 400.0, q[1] + 20.0)
    ds_testpage.check(ds_testpage.px(pg, 400.0, q[1] + 20.0) == ds_testpage.px(pg, 400.0, q[1] + 22.0), "plain value row has no hover tint")
    ds_settings.set_val(p, 1, 1)
    frame(p, pg, 0.0 - 1.0, 0.0 - 1.0)
    ds_settings.control_rect(p, 1, &q)
    ds_testpage.check(ds_testpage.px(pg, q[0] + 6.0, q[1] + 12.0) == ds_testpage.tok(pg, style.TOK_ACCENT), "toggle track is the accent when on")
    ds_settings.set_val(p, 1, 0)
    ds_settings.set_focus(p, 1)
    frame(p, pg, 0.0 - 1.0, 0.0 - 1.0)
    ds_settings.row_rect(p, 1, &q)
    ds_testpage.check(ds_testpage.region_differs(pg, q[0] - 3.0, q[1] - 3.0, q[2] + 6.0, 3.0, base) > 100, "focus ring above the row")
    ds_settings.reset(p)
    ds_settings.set_enabled(p, 1, false)
    frame(p, pg, 0.0 - 1.0, 0.0 - 1.0)
    ds_settings.row_rect(p, 1, &q)
    let lit: *mut ds_testpage.Page = ds_testpage.page_new(760, 900, true, font)
    ds_settings.set_enabled(p, 1, true)
    frame(p, lit, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(ds_testpage.regions_differ(pg, q[0], q[1], q[2], q[3], lit) > 100, "disabled row is drawn differently")
    let lg: *mut ds_testpage.Page = ds_testpage.page_new(760, 900, false, font)
    frame(p, lg, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(ds_testpage.regions_differ(lg, 20.0, 20.0, 700.0, 400.0, lit) > 20000, "light theme renders differently")
    ds_testpage.check(ds_testpage.region_differs(lg, 20.0, 20.0, 700.0, 400.0, ds_testpage.tok(lg, style.TOK_BASE)) > 5000, "light theme draws the rows")
    return ds_testpage.finish("DS_SETTINGS")
}
