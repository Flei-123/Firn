// SPDX-License-Identifier: MPL-2.0
// tools/fui/svg_main.fi -- THE SVG READER AT THE PIXEL.
//
// Each check is here because getting it wrong produces a WRONG PICTURE
// that still looks like a picture -- which is the only kind of bug that
// ships.
//
//   1. viewBox is read, and a document without one is refused rather
//      than guessed at.
//   2. A filled square really lands where the viewBox says, at the right
//      SIZE -- this is the scaling check.
//   3. The fill COLOUR arrives un-swapped. Same numeric channel check as
//      the picture test; #c86432 has three different channels on purpose.
//   4. fill-rule="evenodd" leaves a HOLE and nonzero does not. This is
//      the one that catches the shared rasteriser being non-zero only.
//   5. The arc `A` agrees with the cubic `C` for a quarter circle. The
//      arc maths (centre from endpoints, F.6.5) is the easiest thing in
//      the file to get subtly wrong.
//   6. transform="translate(...) scale(...)" composes in the right ORDER.
//   7. Scaling is SMOOTH: the same icon at 16 and at 64 has antialiased
//      edges, i.e. pixels that are neither empty nor full.
//   8. A group's fill is inherited, and a child's own fill wins.
//   9. Relative commands (lowercase) land in the same place as absolute.
//  10. `Z` closes, so a triangle is solid and not a sliver.
import std.rt
import paint.canvas
import fui.painter
import fui.svg

const W: usize = 128
const H: usize = 128

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, got: i64, want: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 50 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var h1: [u8; 5] = " got "
    rt.buf_push_bytes(&t, (&h1[0]) as u64, 5)
    rt.buf_push_dec_i64(&t, got)
    var h2: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&h2[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, want)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn say(s: u64, n: usize) {
    rt.write_everything(1, s, n)
}

// Straight (un-premultiplied) channel of a canvas pixel.
fn chan(cv: *mut canvas.Canvas, x: usize, y: usize, which: usize) -> i64 {
    let v: u32 = canvas.canvas_get(cv, x, y)
    let a: u32 = (v >> 24) & 255 as u32
    if which == 3 { return a as i64 }
    var c: u32 = 0
    if which == 0 { c = (v >> 16) & 255 as u32 }
    if which == 1 { c = (v >> 8) & 255 as u32 }
    if which == 2 { c = v & 255 as u32 }
    if a == 0 as u32 { return 0 }
    return ((c as f64) * 255.0 / (a as f64) + 0.5) as i64
}

fn alpha_at(cv: *mut canvas.Canvas, x: usize, y: usize) -> i64 {
    return chan(cv, x, y, 3)
}

fn near(a: i64, b: i64, tol: i64) -> bool {
    var d: i64 = a - b
    if d < 0 { d = 0 - d }
    return d <= tol
}

// Count pixels with any coverage.
fn ink(cv: *mut canvas.Canvas) -> i64 {
    var c: i64 = 0
    var y: usize = 0
    while y < H {
        var x: usize = 0
        while x < W {
            if alpha_at(cv, x, y) > 0 { c = c + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return c
}

// How many pixels are PARTLY covered -- the antialiasing measure.
fn soft(cv: *mut canvas.Canvas) -> i64 {
    var c: i64 = 0
    var y: usize = 0
    while y < H {
        var x: usize = 0
        while x < W {
            let a: i64 = alpha_at(cv, x, y)
            if a > 12 && a < 243 { c = c + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return c
}

fn draw(cv: *mut canvas.Canvas, z: *mut painter.Painter, src: u64,
    n: usize, x: f64, y: f64, w: f64, h: f64, tint: u32) -> bool {
    canvas.canvas_clear(cv, 0 as u32)
    var s: svg.Svg = svg.svg_new()
    if !svg.svg_parse(&s, src, n) { return false }
    svg.svg_draw(&s, z, x, y, w, h, tint)
    return true
}

fn main() -> i32 {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) { return 2 }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, H) { return 2 }

    // ================================================================
    var t1: [u8; 21] = "== 1. THE viewBox ==\n"
    say((&t1[0]) as u64, 21)

    var d1: [u8; 81] = "<svg viewBox='0 0 24 24'><path d='M0 0 L24 0 L24 24 L0 24 Z' fill='black'/></svg>"
    var s1: svg.Svg = svg.svg_new()
    let ok1: bool = svg.svg_parse(&s1, (&d1[0]) as u64, 81)
    var n1: [u8; 34] = "1 viewBox 0 0 24 24 gives width 24"
    report((&n1[0]) as u64, 34, ok1 && near(svg.svg_vb_w(&s1) as i64, 24, 0),
        svg.svg_vb_w(&s1) as i64, 24)

    // no viewBox and no width/height -> refused
    var d1b: [u8; 32] = "<svg><path d='M0 0 L1 1'/></svg>"
    var s1b: svg.Svg = svg.svg_new()
    let ok1b: bool = svg.svg_parse(&s1b, (&d1b[0]) as u64, 32)
    var n1b: [u8; 46] = "1 without a viewBox it is REFUSED, not guessed"
    report((&n1b[0]) as u64, 46, !ok1b, ok1b as i64, 0)

    // ================================================================
    var t2: [u8; 38] = "\n== 2. THE SQUARE LANDS AND SCALES ==\n"
    say((&t2[0]) as u64, 38)

    // The whole viewBox filled, drawn into 40x40 at (10,10).
    draw(&cv, &z, (&d1[0]) as u64, 81, 10.0, 10.0, 40.0, 40.0, 0 as u32)
    var n2: [u8; 35] = "2 the middle of the square is solid"
    report((&n2[0]) as u64, 35, alpha_at(&cv, 30, 30) == 255,
        alpha_at(&cv, 30, 30), 255)
    var n2b: [u8; 21] = "2 outside it is empty"
    report((&n2b[0]) as u64, 21, alpha_at(&cv, 5, 5) == 0,
        alpha_at(&cv, 5, 5), 0)
    // 40x40 of coverage = 1600 pixels, give or take the edge
    let i2: i64 = ink(&cv)
    var n2c: [u8; 41] = "2 and it covers about 40x40 = 1600 pixels"
    report((&n2c[0]) as u64, 41, i2 > 1500 && i2 < 1750, i2, 1600)

    // ================================================================
    var t3: [u8; 41] = "\n== 3. THE FILL COLOUR IS NOT SWAPPED ==\n"
    say((&t3[0]) as u64, 41)

    var d3: [u8; 88] = "<svg viewBox='0 0 10 10'><rect x='0' y='0' width='10' height='10' fill='#c86432'/></svg>"
    draw(&cv, &z, (&d3[0]) as u64, 88, 0.0, 0.0, 40.0, 40.0, 0 as u32)
    var n3r: [u8; 20] = "3 #c86432 -> red 200"
    report((&n3r[0]) as u64, 20, near(chan(&cv, 20, 20, 0), 200, 2),
        chan(&cv, 20, 20, 0), 200)
    var n3g: [u8; 22] = "3 #c86432 -> green 100"
    report((&n3g[0]) as u64, 22, near(chan(&cv, 20, 20, 1), 100, 2),
        chan(&cv, 20, 20, 1), 100)
    var n3b: [u8; 20] = "3 #c86432 -> blue 50"
    report((&n3b[0]) as u64, 20, near(chan(&cv, 20, 20, 2), 50, 2),
        chan(&cv, 20, 20, 2), 50)

    // ================================================================
    var t4: [u8; 44] = "\n== 4. fill-rule evenodd LEAVES THE HOLE ==\n"
    say((&t4[0]) as u64, 44)

    // A big square with a small one inside it, SAME direction. Under
    // even-odd the inner one is a hole; under non-zero it is filled.
    var d4a: [u8; 111] = "<svg viewBox='0 0 20 20'><path fill-rule='evenodd' fill='black' d='M2 2 H18 V18 H2 Z M7 7 H13 V13 H7 Z'/></svg>"
    draw(&cv, &z, (&d4a[0]) as u64, 111, 0.0, 0.0, 40.0, 40.0, 0 as u32)
    // centre (20,20) is inside the inner square -> must be EMPTY
    var n4a: [u8; 31] = "4 evenodd: the middle is a HOLE"
    report((&n4a[0]) as u64, 31, alpha_at(&cv, 20, 20) < 20,
        alpha_at(&cv, 20, 20), 0)
    // between the two squares -> solid
    var n4b: [u8; 35] = "4 evenodd: the ring itself is solid"
    report((&n4b[0]) as u64, 35, alpha_at(&cv, 9, 20) == 255,
        alpha_at(&cv, 9, 20), 255)

    var d4b: [u8; 111] = "<svg viewBox='0 0 20 20'><path fill-rule='nonzero' fill='black' d='M2 2 H18 V18 H2 Z M7 7 H13 V13 H7 Z'/></svg>"
    draw(&cv, &z, (&d4b[0]) as u64, 111, 0.0, 0.0, 40.0, 40.0, 0 as u32)
    var n4c: [u8; 33] = "4 nonzero: the same path is SOLID"
    report((&n4c[0]) as u64, 33, alpha_at(&cv, 20, 20) == 255,
        alpha_at(&cv, 20, 20), 255)

    // ================================================================
    var t5: [u8; 40] = "\n== 5. THE ARC AGREES WITH THE CUBIC ==\n"
    say((&t5[0]) as u64, 40)

    // A quarter disc, once with A and once with the Bezier that matches
    // it. The ink must be within a couple of per mille.
    var d5a: [u8; 87] = "<svg viewBox='0 0 20 20'><path fill='black' d='M2 18 L2 2 A16 16 0 0 1 18 18 Z'/></svg>"
    draw(&cv, &z, (&d5a[0]) as u64, 87, 0.0, 0.0, 80.0, 80.0, 0 as u32)
    let ia: i64 = ink(&cv)
    var d5b: [u8; 95] = "<svg viewBox='0 0 20 20'><path fill='black' d='M2 18 L2 2 C10.8365 2 18 9.1635 18 18 Z'/></svg>"
    draw(&cv, &z, (&d5b[0]) as u64, 95, 0.0, 0.0, 80.0, 80.0, 0 as u32)
    let ib: i64 = ink(&cv)
    var diff: i64 = ia - ib
    if diff < 0 { diff = 0 - diff }
    var n5: [u8; 35] = "5 arc and cubic cover the same area"
    report((&n5[0]) as u64, 35, diff * 200 < ib, diff, 0)
    var n5b: [u8; 30] = "5 and it really drew something"
    report((&n5b[0]) as u64, 30, ia > 1000, ia, 1000)

    // ================================================================
    var t6: [u8; 43] = "\n== 6. transform COMPOSES LEFT TO RIGHT ==\n"
    say((&t6[0]) as u64, 43)

    // translate(10,0) then scale(2): a 0..5 square becomes 10..20 in
    // USER space. Drawn 1:1 into a 20x20 viewBox at 40x40 it is
    // 20..40 in pixels.
    var d6: [u8; 128] = "<svg viewBox='0 0 20 20'><g transform='translate(10,0) scale(2)'><rect x='0' y='0' width='5' height='5' fill='black'/></g></svg>"
    draw(&cv, &z, (&d6[0]) as u64, 128, 0.0, 0.0, 40.0, 40.0, 0 as u32)
    // pixel (30,10) is inside 20..40 x 0..20 -> solid
    var n6: [u8; 42] = "6 translate then scale puts it at x=20..40"
    report((&n6[0]) as u64, 42, alpha_at(&cv, 30, 10) == 255,
        alpha_at(&cv, 30, 10), 255)
    // (5,10) is left of it -> empty
    var n6b: [u8; 36] = "6 and NOT at the untransformed place"
    report((&n6b[0]) as u64, 36, alpha_at(&cv, 5, 10) == 0,
        alpha_at(&cv, 5, 10), 0)

    // ================================================================
    var t7: [u8; 31] = "\n== 7. SCALING STAYS SMOOTH ==\n"
    say((&t7[0]) as u64, 31)

    // A circle has a curved edge at every size; if the edge were
    // quantised there would be no partly covered pixels at all.
    var d7: [u8; 76] = "<svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='11' fill='black'/></svg>"
    draw(&cv, &z, (&d7[0]) as u64, 76, 0.0, 0.0, 16.0, 16.0, 0 as u32)
    let s16: i64 = soft(&cv)
    var n7a: [u8; 41] = "7 at 16 px the circle edge is antialiased"
    report((&n7a[0]) as u64, 41, s16 > 12, s16, 12)
    draw(&cv, &z, (&d7[0]) as u64, 76, 0.0, 0.0, 64.0, 64.0, 0 as u32)
    let s64: i64 = soft(&cv)
    var n7b: [u8; 42] = "7 at 64 px too, and there are more of them"
    report((&n7b[0]) as u64, 42, s64 > s16, s64, s16)

    // ================================================================
    var t8: [u8; 40] = "\n== 8. THE GROUP'S FILL IS INHERITED ==\n"
    say((&t8[0]) as u64, 40)

    var d8: [u8; 153] = "<svg viewBox='0 0 20 10'><g fill='#c86432'><rect x='0' y='0' width='10' height='10'/><rect x='10' y='0' width='10' height='10' fill='#3264c8'/></g></svg>"
    draw(&cv, &z, (&d8[0]) as u64, 153, 0.0, 0.0, 40.0, 20.0, 0 as u32)
    var n8a: [u8; 42] = "8 the child with no fill takes the group's"
    report((&n8a[0]) as u64, 42, near(chan(&cv, 5, 5, 0), 200, 3),
        chan(&cv, 5, 5, 0), 200)
    var n8b: [u8; 40] = "8 and its own fill wins where it has one"
    report((&n8b[0]) as u64, 40, near(chan(&cv, 30, 5, 2), 200, 3),
        chan(&cv, 30, 5, 2), 200)

    // ================================================================
    var t9: [u8; 31] = "\n== 9. RELATIVE == ABSOLUTE ==\n"
    say((&t9[0]) as u64, 31)

    var d9a: [u8; 81] = "<svg viewBox='0 0 20 20'><path fill='black' d='M4 4 L16 4 L16 16 L4 16 Z'/></svg>"
    draw(&cv, &z, (&d9a[0]) as u64, 81, 0.0, 0.0, 40.0, 40.0, 0 as u32)
    let inkabs: i64 = ink(&cv)
    var d9b: [u8; 81] = "<svg viewBox='0 0 20 20'><path fill='black' d='m4 4 l12 0 l0 12 l-12 0 z'/></svg>"
    draw(&cv, &z, (&d9b[0]) as u64, 81, 0.0, 0.0, 40.0, 40.0, 0 as u32)
    let inkrel: i64 = ink(&cv)
    var n9: [u8; 44] = "9 lowercase and uppercase give the same area"
    report((&n9[0]) as u64, 44, inkabs == inkrel, inkrel, inkabs)

    // ================================================================
    var t10: [u8; 29] = "\n== 10. Z CLOSES THE PATH ==\n"
    say((&t10[0]) as u64, 29)

    // A triangle with no Z -- SVG fills it as if closed, so it must be
    // solid, not a hairline.
    var d10: [u8; 74] = "<svg viewBox='0 0 20 20'><path fill='black' d='M10 3 L17 17 L3 17'/></svg>"
    draw(&cv, &z, (&d10[0]) as u64, 74, 0.0, 0.0, 40.0, 40.0, 0 as u32)
    var n10: [u8; 39] = "10 an unclosed triangle is filled solid"
    report((&n10[0]) as u64, 39, alpha_at(&cv, 20, 28) == 255,
        alpha_at(&cv, 20, 28), 255)

    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    if G_ERRORS != 0 {
        var bad: [u8; 13] = "\nSVG FAILED.\n"
        say((&bad[0]) as u64, 13)
        return 1
    }
    var good: [u8; 13] = "\nSVG PASSED.\n"
    say((&good[0]) as u64, 13)
    return 0
}
