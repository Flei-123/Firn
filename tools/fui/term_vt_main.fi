import std.rt
import term.term
import term.termstate
import term.termgrid
import term.termtext

static mut BAD: usize = 0
static mut TOTAL: usize = 0

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }

fn say_num(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(ok: bool, what: str) {
    TOTAL = TOTAL + 1
    if ok { return }
    say("  WRONG ")
    say(what)
    say("\n")
    BAD = BAD + 1
}

fn new_term(cols: usize, rows: usize) -> *mut termstate.Term {
    return term.term_new(cols, rows, 10)
}

fn row_text(t: *mut termstate.Term, y: usize, out: *mut rt.Buf) {
    let g: *mut termgrid.Grid = term.term_grid(t)
    termtext.line_text(g, (*g).sb_len + y, 0, (*g).cols, out)
}

fn row_is(t: *mut termstate.Term, y: usize, want: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    row_text(t, y, &b)
    var same: bool = rt.buf_len(&b) == want.n
    if same { same = rt.mem_eq(rt.buf_ptr(&b), want.p as u64, want.n) }
    rt.buf_free(&b)
    return same
}

fn reply_is(t: *mut termstate.Term, want: str) -> bool {
    var same: bool = term.term_reply_len(t) == want.n
    if same { same = rt.mem_eq(term.term_reply_ptr(t), want.p as u64, want.n) }
    term.term_reply_clear(t)
    return same
}

static mut ONE: [u8; 1] = [0 as u8]

fn feed_octet(t: *mut termstate.Term, v: u32) {
    ONE[0] = v as u8
    term.term_feed(t, (&ONE[0]) as u64, 1)
}

fn cx(t: *mut termstate.Term) -> usize { return (*term.term_grid(t)).cx }

fn cy(t: *mut termstate.Term) -> usize { return (*term.term_grid(t)).cy }

fn test_print() {
    let t: *mut termstate.Term = new_term(20, 4)
    term.term_feed_str(t, "hello\r\nworld")
    check(row_is(t, 0, "hello"), "print row 0")
    check(row_is(t, 1, "world"), "print row 1")
    check(cx(t) == 5 && cy(t) == 1, "cursor after print")
    term.term_feed_str(t, "\x08\x08X")
    check(row_is(t, 1, "worXd"), "backspace overwrite")
    term.term_free(t)
}

fn test_wrap() {
    let t: *mut termstate.Term = new_term(10, 3)
    term.term_feed_str(t, "0123456789AB")
    check(row_is(t, 0, "0123456789"), "wrap row 0")
    check(row_is(t, 1, "AB"), "wrap row 1")
    let g: *mut termgrid.Grid = term.term_grid(t)
    check(termgrid.row_wrapped(g, (*g).sb_len), "wrapped flag")
    var b: rt.Buf = rt.buf_new()
    termtext.screen_text(g, &b)
    check(rt.buf_len(&b) >= 12 && rt.ld8(rt.buf_ptr(&b), 10) == 65 as u8, "wrapped rows join without newline")
    rt.buf_free(&b)
    term.term_feed_str(t, "\x1b[?7l\x1b[1;10HXY")
    check(row_is(t, 0, "012345678Y"), "autowrap off overwrites last cell")
    term.term_free(t)
}

fn test_cursor() {
    let t: *mut termstate.Term = new_term(20, 6)
    term.term_feed_str(t, "\x1b[3;5HX")
    check(row_is(t, 2, "    X"), "CUP")
    term.term_feed_str(t, "\x1b[2A\x1b[3DY")
    check(row_is(t, 0, "  Y"), "CUU + CUB")
    term.term_feed_str(t, "\x1b[10GZ")
    check(row_is(t, 0, "  Y      Z"), "CHA")
    term.term_feed_str(t, "\x1b[4d\x1b[1;1H")
    check(cy(t) == 0 && cx(t) == 0, "VPA then CUP home")
    term.term_feed_str(t, "\x1b7\x1b[5;5H\x1b8")
    check(cy(t) == 0 && cx(t) == 0, "save and restore cursor")
    term.term_feed_str(t, "\x1b[99;99H")
    check(cy(t) == 5 && cx(t) == 19, "cursor clamps")
    term.term_free(t)
}

fn test_erase() {
    let t: *mut termstate.Term = new_term(10, 3)
    term.term_feed_str(t, "aaaaaaaaaa\r\nbbbbbbbbbb\r\ncccccccccc")
    term.term_feed_str(t, "\x1b[2;5H\x1b[K")
    check(row_is(t, 1, "bbbb"), "EL 0")
    term.term_feed_str(t, "\x1b[1K")
    check(row_is(t, 1, "          ") || row_is(t, 1, ""), "EL 1")
    term.term_feed_str(t, "\x1b[3;3H\x1b[1J")
    check(row_is(t, 0, "") && row_is(t, 1, ""), "ED 1 clears above")
    check(row_is(t, 2, "   ccccccc"), "ED 1 clears start of row")
    term.term_feed_str(t, "\x1b[2J")
    check(row_is(t, 2, ""), "ED 2")
    term.term_feed_str(t, "\x1b[1;1Habcdef\x1b[1;3H\x1b[2P")
    check(row_is(t, 0, "abef"), "DCH")
    term.term_feed_str(t, "\x1b[2@")
    check(row_is(t, 0, "ab  ef"), "ICH")
    term.term_feed_str(t, "\x1b[3X")
    check(row_is(t, 0, "ab   f"), "ECH")
    term.term_free(t)
}

fn test_scroll() {
    let t: *mut termstate.Term = new_term(10, 3)
    term.term_feed_str(t, "1\r\n2\r\n3\r\n4\r\n5")
    check(row_is(t, 0, "3") && row_is(t, 1, "4") && row_is(t, 2, "5"), "scroll up screen")
    let g: *mut termgrid.Grid = term.term_grid(t)
    check((*g).sb_len == 2, "scrollback length")
    var b: rt.Buf = rt.buf_new()
    termtext.line_text(g, 0, 0, 10, &b)
    check(rt.buf_len(&b) == 1 && rt.ld8(rt.buf_ptr(&b), 0) == 49 as u8, "scrollback keeps oldest line")
    rt.buf_free(&b)
    term.term_feed_str(t, "\x1b[2;3r\x1b[2;1H")
    check(cy(t) == 1 && cx(t) == 0, "DECSTBM homes the cursor")
    term.term_feed_str(t, "A\r\nB\r\nC")
    check(row_is(t, 0, "3") && row_is(t, 1, "B") && row_is(t, 2, "C"), "scroll inside region only")
    check((*g).sb_len == 2, "region scroll adds no history")
    term.term_feed_str(t, "\x1b[r\x1b[1;1H\x1bM")
    check(row_is(t, 0, ""), "reverse index at top scrolls down")
    term.term_feed_str(t, "\x1b[2;1H\x1b[L")
    check(row_is(t, 1, "") && row_is(t, 2, "3"), "IL")
    term.term_feed_str(t, "\x1b[M")
    check(row_is(t, 1, "3"), "DL")
    term.term_free(t)
}

fn test_alt_screen() {
    let t: *mut termstate.Term = new_term(10, 3)
    term.term_feed_str(t, "main\x1b[?1049hALT")
    check(term.term_is_alt(t), "alt screen on")
    check(row_is(t, 0, "ALT"), "alt content")
    term.term_feed_str(t, "\x1b[?1049l")
    check(!term.term_is_alt(t), "alt screen off")
    check(row_is(t, 0, "main") && cx(t) == 4, "main restored with cursor")
    term.term_free(t)
}

fn test_sgr() {
    let t: *mut termstate.Term = new_term(20, 2)
    term.term_feed_str(t, "\x1b[1;31;44mA\x1b[0mB")
    let g: *mut termgrid.Grid = term.term_grid(t)
    check(termgrid.screen_fg(g, 0, 0) == termgrid.color_indexed(1 as u32), "SGR fg red")
    check(termgrid.screen_bg(g, 0, 0) == termgrid.color_indexed(4 as u32), "SGR bg blue")
    check((termgrid.screen_flags(g, 0, 0) & termgrid.F_BOLD) != 0 as u32, "SGR bold")
    check(termgrid.screen_fg(g, 0, 1) == 0 as u32 && termgrid.screen_flags(g, 0, 1) == 0 as u32, "SGR reset")
    term.term_feed_str(t, "\x1b[38;5;200mC\x1b[48;2;10;20;30mD\x1b[0m")
    check(termgrid.screen_fg(g, 0, 2) == termgrid.color_indexed(200 as u32), "SGR 256 colour")
    check(termgrid.screen_bg(g, 0, 3) == termgrid.color_rgb(0x0A141E as u32), "SGR truecolor bg")
    term.term_feed_str(t, "\x1b[38:2::1:2:3mE\x1b[38:2:4:5:6mF\x1b[0m")
    check(termgrid.screen_fg(g, 0, 4) == termgrid.color_rgb(0x010203 as u32), "SGR colon truecolor with colour space")
    check(termgrid.screen_fg(g, 0, 5) == termgrid.color_rgb(0x040506 as u32), "SGR colon truecolor")
    term.term_feed_str(t, "\x1b[91;102;3;4;7mG\x1b[23;24;27;39;49mH")
    check(termgrid.screen_fg(g, 0, 6) == termgrid.color_indexed(9 as u32), "SGR bright fg")
    check(termgrid.screen_bg(g, 0, 6) == termgrid.color_indexed(10 as u32), "SGR bright bg")
    check((termgrid.screen_flags(g, 0, 6) & (termgrid.F_ITALIC | termgrid.F_UNDERLINE | termgrid.F_INVERSE)) == (termgrid.F_ITALIC | termgrid.F_UNDERLINE | termgrid.F_INVERSE), "SGR italic underline inverse")
    check(termgrid.screen_flags(g, 0, 7) == 0 as u32 && termgrid.screen_fg(g, 0, 7) == 0 as u32, "SGR individual resets")
    term.term_free(t)
}

fn test_utf8() {
    let t: *mut termstate.Term = new_term(10, 2)
    term.term_feed_str(t, "\u{e4}\u{20ac}")
    check(termgrid.screen_cp(term.term_grid(t), 0, 0) == 0xE4 as u32, "UTF-8 two octets")
    check(termgrid.screen_cp(term.term_grid(t), 0, 1) == 0x20AC as u32, "UTF-8 three octets")
    feed_octet(t, 0xE2 as u32)
    feed_octet(t, 0x82 as u32)
    feed_octet(t, 0xAC as u32)
    check(termgrid.screen_cp(term.term_grid(t), 0, 2) == 0x20AC as u32, "UTF-8 split across feeds")
    feed_octet(t, 0xFF as u32)
    feed_octet(t, 0xC3 as u32)
    term.term_feed_str(t, "(")
    check(termgrid.screen_cp(term.term_grid(t), 0, 3) == 0xFFFD as u32, "invalid octet gives U+FFFD")
    check(termgrid.screen_cp(term.term_grid(t), 0, 4) == 0xFFFD as u32, "truncated sequence gives U+FFFD")
    check(termgrid.screen_cp(term.term_grid(t), 0, 5) == 40 as u32, "octet after broken sequence kept")
    term.term_feed_str(t, "\r\n\u{4e2d}x")
    let g: *mut termgrid.Grid = term.term_grid(t)
    check((termgrid.screen_flags(g, 1, 0) & termgrid.F_WIDE) != 0 as u32, "wide head flag")
    check((termgrid.screen_flags(g, 1, 1) & termgrid.F_TAIL) != 0 as u32, "wide tail flag")
    check(termgrid.screen_cp(g, 1, 2) == 120 as u32, "cell after wide char")
    term.term_free(t)
}

fn test_osc_and_replies() {
    let t: *mut termstate.Term = new_term(20, 4)
    term.term_feed_str(t, "\x1b]0;my title\x07")
    check(term.term_title(t).n == 8, "OSC 0 title with BEL")
    term.term_feed_str(t, "\x1b]2;other\x1b\\")
    check(term.term_title(t).n == 5, "OSC 2 title with ST")
    term.term_feed_str(t, "\x1b]52;c;ZGF0YQ==\x07")
    check(term.term_title(t).n == 5, "other OSC ignored")
    term.term_feed_str(t, "\x1b[2;3H\x1b[6n")
    check(reply_is(t, "\x1b[2;3R"), "DSR cursor position")
    term.term_feed_str(t, "\x1b[5n")
    check(reply_is(t, "\x1b[0n"), "DSR status")
    term.term_feed_str(t, "\x1b[c")
    check(reply_is(t, "\x1b[?1;2c"), "primary DA")
    term.term_feed_str(t, "\x1b[18t")
    check(reply_is(t, "\x1b[8;4;20t"), "window size report")
    term.term_free(t)
}

fn test_modes() {
    let t: *mut termstate.Term = new_term(20, 4)
    term.term_feed_str(t, "\x1b[?1h\x1b[?2004h\x1b[?1002h\x1b[?1006h\x1b[?25l")
    check(term.term_app_cursor(t) && term.term_bracketed(t), "app cursor + bracketed paste")
    check(term.term_mouse_mode(t) == term.MOUSE_DRAG && term.term_mouse_sgr(t), "mouse drag + SGR")
    check(!term.term_cursor_visible(t), "cursor hidden")
    term.term_feed_str(t, "\x1b[?1l\x1b[?2004l\x1b[?1002l\x1b[?25h")
    check(!term.term_app_cursor(t) && !term.term_bracketed(t) && term.term_mouse_mode(t) == term.MOUSE_OFF, "modes reset")
    check(term.term_cursor_visible(t), "cursor shown")
    term.term_feed_str(t, "\x1b[?9999h\x1b[>1;2;3x\x1b[?1;2;3$p")
    check(cx(t) == 0, "unknown sequences ignored")
    term.term_free(t)
}

fn test_tabs_and_charset() {
    let t: *mut termstate.Term = new_term(30, 2)
    term.term_feed_str(t, "a\tb\t\tc")
    check(termgrid.screen_cp(term.term_grid(t), 0, 8) == 98 as u32, "tab to column 8")
    check(termgrid.screen_cp(term.term_grid(t), 0, 24) == 99 as u32, "two tabs")
    term.term_feed_str(t, "\r\n\x1b(0lqk\x1b(Bq")
    let g: *mut termgrid.Grid = term.term_grid(t)
    check(termgrid.screen_cp(g, 1, 0) == 0x250C as u32 && termgrid.screen_cp(g, 1, 1) == 0x2500 as u32, "line drawing charset")
    check(termgrid.screen_cp(g, 1, 3) == 113 as u32, "charset back to ASCII")
    term.term_free(t)
}

fn test_resize() {
    let t: *mut termstate.Term = new_term(10, 4)
    term.term_feed_str(t, "1\r\n2\r\n3\r\n4")
    term.term_resize(t, 10, 2)
    check(row_is(t, 0, "3") && row_is(t, 1, "4"), "shrink keeps cursor row")
    check((*term.term_grid(t)).sb_len == 2, "shrink pushes lines into history")
    term.term_resize(t, 10, 4)
    check(row_is(t, 0, "1") && row_is(t, 3, "4"), "grow pulls history back")
    check(cy(t) == 3, "cursor follows content")
    term.term_resize(t, 4, 4)
    term.term_feed_str(t, "\r\nabcdefgh")
    check(row_is(t, 3, "efgh"), "narrow terminal wraps")
    term.term_free(t)
}

fn test_insert_mode_and_repeat() {
    let t: *mut termstate.Term = new_term(10, 2)
    term.term_feed_str(t, "abc\x1b[1;2H\x1b[4hX\x1b[4l")
    check(row_is(t, 0, "aXbc"), "insert mode")
    term.term_feed_str(t, "\x1b[2;1Hz\x1b[3b")
    check(row_is(t, 1, "zzzz"), "REP")
    term.term_free(t)
}

fn main() -> i32 {
    test_print()
    test_wrap()
    test_cursor()
    test_erase()
    test_scroll()
    test_alt_screen()
    test_sgr()
    test_utf8()
    test_osc_and_replies()
    test_modes()
    test_tabs_and_charset()
    test_resize()
    test_insert_mode_and_repeat()
    say("term_vt: ")
    say_num((TOTAL - BAD) as i64)
    say("/")
    say_num(TOTAL as i64)
    say(" checks passed\n")
    if BAD > 0 { return 1 }
    return 0
}
