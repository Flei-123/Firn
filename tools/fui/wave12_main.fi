// SPDX-License-Identifier: MPL-2.0
// tools/fui/wave12_main.fi -- wave 12: calendar (day / range), navigation view, tree view (lib/fui/wave12.fi).
// Logic, geometry (hit = draw), pixels in both themes, mirrored (RTL).
//
//     wave12_main            prints one line per check, exit 0 when all hold
//     wave12_main <dir>      additionally writes wave12-light.png / wave12-dark.png into <dir>
import std.rt
import fui.safeout
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.style
import fui.editor
import fui.kit
import fui.kitcolor
import fui.wave12
import fui.lucide
import plat.sysfont

static mut BAD: usize = 0
static mut CHECKS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
    w: usize,
    h: usize,
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    kitcolor.kit_theme(&(*p).m, dark)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    (*p).w = w
    (*p).h = h
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn tok(p: *mut Page, t: u32) -> u32 {
    return theme.opaque(render.color_of(&(*p).c, style.color_token(t))) & 16777215 as u32
}

fn clear(p: *mut Page) {
    canvas.canvas_clear(&(*p).cv, tok(p, style.TOK_BASE) | (255 as u32) << 24)
}

fn px(p: *mut Page, x: f64, y: f64) -> u32 {
    return canvas.canvas_get(&(*p).cv, x as usize, y as usize) & 16777215 as u32
}

fn near(a: f64, b: f64, eps: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    return d <= eps
}

fn rect_ok(r: *mut [f64; 4], w: f64, h: f64) -> bool {
    return (*r)[0] >= 0.0 && (*r)[1] >= 0.0 && (*r)[0] + (*r)[2] <= w + 0.5 && (*r)[1] + (*r)[3] <= h + 0.5
}

fn center_hit(c: *mut render.Ctx, k: *mut wave12.Cal, r: *mut [f64; 4], x: f64, y: f64, w: f64) -> usize {
    return wave12.cal_hit(c, k, x, y, w, (*r)[0] + (*r)[2] / 2.0, (*r)[1] + (*r)[3] / 2.0)
}

// ---------------------------------------------------------------- calendar
fn run_cal_model() {
    say("-- calendar model\n")
    check(wave12.cal_dim(2024, 2) == 29 && wave12.cal_dim(2026, 2) == 28 && wave12.cal_dim(2100, 2) == 28 && wave12.cal_dim(2000, 2) == 29
        && wave12.cal_dim(2026, 4) == 30 && wave12.cal_dim(2026, 12) == 31, "days per month, leap years")
    check(wave12.cal_weekday(2026, 10, 18) == 6 && wave12.cal_weekday(2026, 10, 19) == 0 && wave12.cal_weekday(2024, 2, 29) == 3, "weekday: 18.10.2026 is a Sunday, 29.2.2024 a Thursday")
    var k: wave12.Cal = wave12.cal_new(2026, 10, 18, false)
    check(k.a == 20261018 && k.b == 0 && k.cur == 18, "single: starts with the day chosen")
    wave12.cal_move_days(&k, 14)
    check(k.m == 11 && k.cur == 1 && k.y == 2026, "+14 days crosses to 1 Nov")
    wave12.cal_move_days(&k, 0 - 1)
    check(k.m == 10 && k.cur == 31, "-1 day back to 31 Oct")
    wave12.cal_shift_month(&k, 4)
    check(k.y == 2027 && k.m == 2 && k.cur == 28, "+4 months: Feb 2027, the day is clamped to 28")
    wave12.cal_shift_month(&k, 0 - 2)
    check(k.y == 2026 && k.m == 12, "-2 months crosses the year")
    check(wave12.cal_key(&k, editor.KEY_PGDN) == 1 as u32 && k.y == 2027 && k.m == 1, "PgDn: next month")
    check(wave12.cal_key(&k, editor.KEY_END) == 1 as u32 && k.cur == 31 && wave12.cal_key(&k, editor.KEY_HOME) == 1 as u32 && k.cur == 1, "End / Home")
    check(wave12.cal_key(&k, editor.KEY_DOWN) == 1 as u32 && k.cur == 8 && wave12.cal_key(&k, editor.KEY_RIGHT) == 1 as u32 && k.cur == 9, "Down = +7, Right = +1")
    check(wave12.cal_key(&k, editor.KEY_ENTER) == 0 as u32 && wave12.cal_key(&k, editor.KEY_TAB) == 0 as u32, "other keys are not used")
    check(wave12.cal_choose(&k) && k.a == 20270109, "single: choose sets the day")
    var g: wave12.Cal = wave12.cal_new(2026, 10, 5, true)
    check(g.a == 0 && !wave12.cal_in_range(&g, 20261010), "range: starts empty")
    check(!wave12.cal_choose(&g) && g.a == 20261005 && g.pend, "range: the first choice is only the start")
    g.cur = 12
    check(wave12.cal_choose(&g) && g.a == 20261005 && g.b == 20261012 && !g.pend, "range: the second choice completes")
    check(wave12.cal_in_range(&g, 20261005) && wave12.cal_in_range(&g, 20261008) && wave12.cal_in_range(&g, 20261012)
        && !wave12.cal_in_range(&g, 20261004) && !wave12.cal_in_range(&g, 20261013), "range: both ends are inside, the days beside are not")
    g.cur = 20
    check(!wave12.cal_choose(&g) && g.a == 20261020 && g.b == 0, "range: a third choice starts a new one")
    g.cur = 3
    check(wave12.cal_choose(&g) && g.a == 20261003 && g.b == 20261020, "range: an earlier end swaps the ends")
    var tb: [u8; 48] = [0 as u8; 48]
    check(wave12.cal_title(&g, &tb) == 12, "title 'October 2026' is 12 bytes")
}

fn run_cal_pixels(p: *mut Page, ts: str, rtl: bool) {
    let c: *mut render.Ctx = &(*p).c
    say("-- calendar pixels ")
    say(ts)
    if rtl { say(" rtl") }
    say("\n")
    kit.kit_set_rtl(rtl)
    var k: wave12.Cal = wave12.cal_new(2026, 10, 18, true)
    k.a = 20261008
    k.b = 20261014
    let w: f64 = wave12.cal_width(c)
    let h: f64 = wave12.cal_height(c)
    clear(p)
    let base: u32 = px(p, 20.0, 20.0)
    wave12.cal_draw(c, &k, 10.0, 10.0, w, h, wave12.CAL_NONE, true, true)
    var r: [f64; 4] = [0.0; 4]
    var allin: bool = true
    var hitsok: bool = true
    var d: i64 = 1
    while d <= 31 {
        if !wave12.cal_day_rect(c, &k, 10.0, 10.0, d, &r) { allin = false } else {
            if r[0] < 10.0 || r[0] + r[2] > 10.0 + w || r[1] + r[3] > 10.0 + h { allin = false }
            if center_hit(c, &k, &r, 10.0, 10.0, w) != (d as usize) { hitsok = false }
        }
        d = d + 1
    }
    check(allin && hitsok, "every day of Oct 2026 is inside the box and a click in its middle finds it")
    check(!wave12.cal_day_rect(c, &k, 10.0, 10.0, 32, &r), "day 32 has no rectangle")
    var a1: bool = wave12.cal_arrow_rect(c, 10.0, 10.0, w, wave12.CAL_PREV, &r)
    check(a1 && center_hit(c, &k, &r, 10.0, 10.0, w) == wave12.CAL_PREV, "the previous arrow is hit")
    var prevx: f64 = r[0]
    a1 = wave12.cal_arrow_rect(c, 10.0, 10.0, w, wave12.CAL_NEXT, &r)
    check(a1 && center_hit(c, &k, &r, 10.0, 10.0, w) == wave12.CAL_NEXT, "the next arrow is hit")
    if rtl {
        check(prevx > r[0], "RTL: previous is at the right, next at the left")
    } else {
        check(prevx < r[0], "previous is at the left, next at the right")
    }
    check(wave12.cal_hit(c, &k, 10.0, 10.0, w, 11.0, 11.0) == wave12.CAL_NONE, "the corner is nothing")
    // range band: the middle day has the selection colour, a day outside has the surface
    wave12.cal_day_rect(c, &k, 10.0, 10.0, 11, &r)
    let inner: u32 = px(p, r[0] + 3.0, r[1] + r[3] / 2.0)
    wave12.cal_day_rect(c, &k, 10.0, 10.0, 20, &r)
    let outer: u32 = px(p, r[0] + 3.0, r[1] + r[3] / 2.0)
    check(inner == tok(p, style.TOK_SELECTION) && outer == tok(p, style.TOK_SURFACE), "the band between the ends is the selection colour, the rest the surface")
    wave12.cal_day_rect(c, &k, 10.0, 10.0, 8, &r)
    check(px(p, r[0] + r[2] / 2.0, r[1] + 4.0) != tok(p, style.TOK_SURFACE) && px(p, r[0] + r[2] / 2.0, r[1] + 4.0) != base, "the start day is filled")
    kit.kit_set_rtl(false)
}

// ---------------------------------------------------------------- nav view
fn run_nav() {
    say("-- nav view model\n")
    var v: wave12.NavView = wave12.nv_new()
    check(wave12.nv_header(&v, "Main") && wave12.nv_add(&v, lucide.HOUSE, "Home", 0) && wave12.nv_add(&v, lucide.FOLDER, "Files", 3) && wave12.nv_add(&v, lucide.STAR, "Starred", 0), "4 entries added")
    check(v.active == 1 && v.open && wave12.nv_width_pt(&v) == 240, "first item active, expanded 240")
    wave12.nv_set_mode(&v, wave12.NV_COMPACT)
    check(!v.open && wave12.nv_width_pt(&v) == 64 && wave12.nv_list_shown(&v), "compact: 64 wide, the icons are shown")
    wave12.nv_set_mode(&v, wave12.NV_MINIMAL)
    check(!v.open && wave12.nv_width_pt(&v) == 48 && !wave12.nv_list_shown(&v), "minimal: 48 wide, only the hamburger")
    v.open = true
    check(wave12.nv_width_pt(&v) == 240 && wave12.nv_list_shown(&v), "minimal opened: the full pane")
    wave12.nv_set_mode(&v, wave12.NV_EXPANDED)
    check(v.open && v.mode == wave12.NV_EXPANDED, "expanded opens the pane")
    check(wave12.nv_key(&v, editor.KEY_DOWN) == 1 as u32 && v.active == 2 && wave12.nv_key(&v, editor.KEY_END) == 1 as u32 && v.active == 3, "Down, End")
    check(wave12.nv_key(&v, editor.KEY_DOWN) == 0 as u32 && v.active == 3, "Down at the end stays")
    check(wave12.nv_key(&v, editor.KEY_HOME) == 1 as u32 && v.active == 1, "Home skips the header")
    check(wave12.nv_key(&v, editor.KEY_UP) == 2 as u32 && v.foc == wave12.NV_HAMBURGER, "Up from the first item goes to the hamburger")
    check(wave12.nv_key(&v, editor.KEY_DOWN) == 2 as u32 && v.foc == wave12.NV_NONE, "Down goes back into the list")
}

fn run_nav_pixels(p: *mut Page, ts: str, rtl: bool, mode: u32) {
    let c: *mut render.Ctx = &(*p).c
    say("-- nav view pixels ")
    say(ts)
    if rtl { say(" rtl") }
    say("\n")
    kit.kit_set_rtl(rtl)
    var v: wave12.NavView = wave12.nv_new()
    let a: bool = wave12.nv_header(&v, "Main")
    let b: bool = wave12.nv_add(&v, lucide.HOUSE, "Home", 0)
    let b2: bool = wave12.nv_add(&v, lucide.FOLDER, "Files", 3)
    wave12.nv_set_mode(&v, mode)
    v.open = mode == wave12.NV_EXPANDED
    let w: f64 = kit.ln(c, wave12.nv_width_pt(&v))
    clear(p)
    wave12.nv_draw(c, &v, 10.0, 10.0, w, 300.0, wave12.NV_NONE, true)
    var r: [f64; 4] = [0.0; 4]
    wave12.nv_hb_rect(c, 10.0, 10.0, w, &r)
    check(wave12.nv_hit(c, &v, 10.0, 10.0, w, r[0] + r[2] / 2.0, r[1] + r[3] / 2.0) == wave12.NV_HAMBURGER, "the hamburger is hit")
    check(r[0] >= 10.0 && r[0] + r[2] <= 10.0 + w, "the hamburger is inside the pane")
    if rtl {
        check(r[0] > 10.0 + w / 2.0, "RTL: the hamburger is at the right")
    } else {
        check(r[0] < 10.0 + w / 2.0, "the hamburger is at the left")
    }
    check(px(p, 10.0 + w / 2.0, 290.0) == tok(p, style.TOK_SURFACE), "the pane has the surface colour")
    if wave12.nv_list_shown(&v) {
        check(wave12.nv_item_rect(c, &v, 10.0, 10.0, w, 2, &r) && wave12.nv_hit(c, &v, 10.0, 10.0, w, r[0] + r[2] / 2.0, r[1] + r[3] / 2.0) == 2, "item 2 is hit in its rectangle")
        check(wave12.nv_item_rect(c, &v, 10.0, 10.0, w, 1, &r) && px(p, r[0] + r[2] / 2.0, r[1] + 3.0) == tok(p, style.TOK_SELECTION), "the active item has the selection colour")
    } else {
        check(!wave12.nv_item_rect(c, &v, 10.0, 10.0, w, 1, &r), "hidden strip: no item rectangles")
    }
    kit.kit_set_rtl(false)
}

// ---------------------------------------------------------------- tree
fn build_tree(t: *mut wave12.Tree) -> bool {
    return wave12.tr_add(t, 0, "Documents", true) && wave12.tr_add(t, 1, "Work", false) && wave12.tr_add(t, 2, "Report", false)
    && wave12.tr_add(t, 1, "Home", false) && wave12.tr_add(t, 0, "Music", false) && wave12.tr_add(t, 0, "Pictures", false)
}

fn run_tree_model() {
    say("-- tree model\n")
    var t: wave12.Tree = wave12.tr_new()
    check(!wave12.tr_add(&t, 1, "bad", false), "the first item must be at depth 0")
    check(build_tree(&t), "6 items added")
    check(!wave12.tr_add(&t, 5, "bad", false), "a depth jump is refused")
    check(t.sel == 0 && wave12.tr_has_kids(&t, 0) && wave12.tr_has_kids(&t, 1) && !wave12.tr_has_kids(&t, 2) && !wave12.tr_has_kids(&t, 4), "kids: Documents, Work")
    check(wave12.tr_visible(&t, 0) && wave12.tr_visible(&t, 1) && !wave12.tr_visible(&t, 2) && wave12.tr_visible(&t, 3) && wave12.tr_visible(&t, 4), "Report hides inside the closed Work")
    check(wave12.tr_vis_count(&t) == 5 && wave12.tr_vis_at(&t, 2) == 3 && wave12.tr_row_of(&t, 3) == 2 && wave12.tr_row_of(&t, 2) == wave12.TR_NONE, "visible rows")
    check(wave12.tr_key(&t, editor.KEY_DOWN, 8) == 1 as u32 && t.sel == 1, "Down: Work")
    check(wave12.tr_key(&t, editor.KEY_RIGHT, 8) == 2 as u32 && t.item[1].open && wave12.tr_vis_count(&t) == 6, "Right opens Work")
    check(wave12.tr_key(&t, editor.KEY_RIGHT, 8) == 1 as u32 && t.sel == 2, "Right on an open branch goes to the first child")
    check(wave12.tr_key(&t, editor.KEY_RIGHT, 8) == 0 as u32, "Right on a leaf: nothing")
    check(wave12.tr_key(&t, editor.KEY_LEFT, 8) == 1 as u32 && t.sel == 1, "Left on a leaf goes to its parent")
    check(wave12.tr_key(&t, editor.KEY_LEFT, 8) == 2 as u32 && !t.item[1].open, "Left on an open branch closes it")
    check(wave12.tr_key(&t, editor.KEY_LEFT, 8) == 1 as u32 && t.sel == 0, "Left on a closed branch goes to the parent")
    check(wave12.tr_key(&t, editor.KEY_END, 8) == 1 as u32 && t.sel == 5 && wave12.tr_key(&t, editor.KEY_HOME, 8) == 1 as u32 && t.sel == 0, "End / Home")
    check(wave12.tr_set_open(&t, 1, true) && wave12.tr_select(&t, 2, 8) && t.sel == 2, "a program opens Work and selects Report")
    check(wave12.tr_set_open(&t, 0, false) && t.sel == 0, "closing Documents moves the hidden selection to it")
    check(!wave12.tr_set_open(&t, 4, true), "a leaf cannot open")
    // scrolling: a window of 2 rows follows the selection
    wave12.tr_set_open(&t, 0, true)
    t.top = 0
    wave12.tr_select(&t, 5, 2)
    check(t.top == wave12.tr_row_of(&t, 5) + 1 - 2, "the window scrolls down to the selection")
    wave12.tr_select(&t, 0, 2)
    check(t.top == 0, "and back up")
}

fn run_tree_pixels(p: *mut Page, ts: str, rtl: bool) {
    let c: *mut render.Ctx = &(*p).c
    say("-- tree pixels ")
    say(ts)
    if rtl { say(" rtl") }
    say("\n")
    kit.kit_set_rtl(rtl)
    var t: wave12.Tree = wave12.tr_new()
    let ok: bool = build_tree(&t)
    wave12.tr_set_open(&t, 1, true)
    wave12.tr_select(&t, 1, 8)
    let w: f64 = 220.0
    let h: f64 = 220.0
    clear(p)
    wave12.tr_draw(c, &t, 10.0, 10.0, w, h, wave12.TR_NONE, true)
    var r: [f64; 4] = [0.0; 4]
    var chev: bool = false
    check(wave12.tr_rect(c, &t, 10.0, 10.0, w, 1, &r) && px(p, r[0] + r[2] / 2.0, r[1] + 2.0) == tok(p, style.TOK_SELECTION), "the selected row has the selection colour")
    check(wave12.tr_hit(c, &t, 10.0, 10.0, w, h, r[0] + r[2] / 2.0, r[1] + r[3] / 2.0, &chev) == 1 && !chev, "a click in the middle of Work hits it, not the arrow")
    var cx: f64 = r[0] + 8.0 + 16.0 + 12.0
    if rtl { cx = r[0] + r[2] - 8.0 - 16.0 - 12.0 }
    check(wave12.tr_hit(c, &t, 10.0, 10.0, w, h, cx, r[1] + r[3] / 2.0, &chev) == 1 && chev, "a click on the arrow of Work is flagged")
    check(wave12.tr_rect(c, &t, 10.0, 10.0, w, 2, &r) && wave12.tr_hit(c, &t, 10.0, 10.0, w, h, r[0] + r[2] / 2.0, r[1] + r[3] / 2.0, &chev) == 2, "the child Report is hit one row below")
    check(wave12.tr_hit(c, &t, 10.0, 10.0, w, h, 12.0, 300.0, &chev) == wave12.TR_NONE, "outside: nothing")
    // the child is indented against its parent
    var rp: [f64; 4] = [0.0; 4]
    wave12.tr_rect(c, &t, 10.0, 10.0, w, 1, &rp)
    kit.kit_set_rtl(false)
}

fn run_page(p: *mut Page, ts: str) {
    run_cal_pixels(p, ts, false)
    run_cal_pixels(p, ts, true)
    run_nav_pixels(p, ts, false, wave12.NV_EXPANDED)
    run_nav_pixels(p, ts, true, wave12.NV_EXPANDED)
    run_nav_pixels(p, ts, false, wave12.NV_COMPACT)
    run_nav_pixels(p, ts, false, wave12.NV_MINIMAL)
    run_tree_pixels(p, ts, false)
    run_tree_pixels(p, ts, true)
}

fn gallery(p: *mut Page) {
    let c: *mut render.Ctx = &(*p).c
    clear(p)
    var k: wave12.Cal = wave12.cal_new(2026, 10, 18, true)
    k.a = 20261008
    k.b = 20261014
    wave12.cal_draw(c, &k, 10.0, 10.0, wave12.cal_width(c), wave12.cal_height(c), 18, true, true)
    var v: wave12.NavView = wave12.nv_new()
    let a: bool = wave12.nv_header(&v, "Main")
    let b: bool = wave12.nv_add(&v, lucide.HOUSE, "Home", 0)
    let b2: bool = wave12.nv_add(&v, lucide.FOLDER, "Files", 3)
    wave12.nv_draw(c, &v, 280.0, 10.0, kit.ln(c, 240), 200.0, 2, true)
    var t: wave12.Tree = wave12.tr_new()
    let ok: bool = build_tree(&t)
    wave12.tr_set_open(&t, 1, true)
    wave12.tr_select(&t, 2, 8)
    wave12.tr_draw(c, &t, 10.0, 310.0, 250.0, 190.0, 4, true)
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("wave12: no font (DejaVu Sans)\n")
        return 9
    }
    run_cal_model()
    run_nav()
    run_tree_model()
    var d: usize = 0
    while d < 2 {
        let dark: bool = d == 1
        var ts: str = "light"
        if dark {
            ts = "dark"
        }
        let p: *mut Page = page_new(560, 520, dark, fs as u64)
        if p as u64 == 0 {
            say("no page\n")
            return 2
        }
        run_page(p, ts)
        gallery(p)
        if dir != 0 {
            if dark {
                save(&(*p).cv, dir, "wave12-dark.png")
            } else {
                save(&(*p).cv, dir, "wave12-light.png")
            }
        }
        d = d + 1
    }
    say("checks: ")
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, CHECKS as i64)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
    if BAD == 0 {
        say("WAVE12 PASSED\n")
        return 0
    }
    say("WAVE12 FAILED\n")
    return 1
}
