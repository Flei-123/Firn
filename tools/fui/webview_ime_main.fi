import std.rt
import fui.app
import fui.apphost
import fui.webview
import fui.webview_types
import fui.webview_stub
import fui.webview_node

static mut BAD: usize = 0

const VIEW_W: usize = 96
const VIEW_H: usize = 64
const STATE_BYTES: usize = 4096
const PREEDIT_TEXT: str = "ka"
const COMMIT_TEXT: str = "\u{304b}"
const MIXED_TEXT: str = "a\u{e9}"
const CARET_X: f64 = 4.0

struct Rig {
    a: *mut app.App,
    wv: *mut webview.WebView,
    node: *mut webview_node.WvNode,
    stub: *mut webview_stub.Stub,
    hk: *mut apphost.Hooks,
}

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn rig_new(caps: u32) -> Rig {
    let a: *mut app.App = app.window("IME sink", 200, 160)
    let wv: *mut webview.WebView = rt.heap_alloc(STATE_BYTES) as *mut webview.WebView
    let node: *mut webview_node.WvNode = rt.heap_alloc(STATE_BYTES) as *mut webview_node.WvNode
    *wv = webview.webview_new()
    *node = webview_node.wvnode_new(wv)
    let stub: *mut webview_stub.Stub = webview_stub.stub_new(caps)
    var be: webview_types.Backend = webview_stub.stub_backend(stub)
    webview.webview_open(wv, &be, VIEW_W as u32, VIEW_H as u32)
    webview_node.wvnode_attach(a, node, VIEW_W, VIEW_H)
    return Rig { a: a, wv: wv, node: node, stub: stub, hk: app.app_hooks(a) as *mut apphost.Hooks }
}

fn rig_pre(r: *mut Rig, text: str, caret: usize) -> bool {
    let f: fn(u64, u64, usize, usize) -> bool = (*(*r).hk).ime_pre
    return f((*(*r).hk).ud, text.p as u64, text.n, caret)
}

fn rig_commit(r: *mut Rig, text: str) -> bool {
    let f: fn(u64, u64, usize) -> bool = (*(*r).hk).ime_commit
    return f((*(*r).hk).ud, text.p as u64, text.n)
}

fn rig_spot(r: *mut Rig, out: *mut [f64; 3]) -> bool {
    let f: fn(u64, *mut [f64; 3]) -> bool = (*(*r).hk).ime_spot
    return f((*(*r).hk).ud, out)
}

fn rig_buf(r: *mut Rig) -> u64 {
    let f: fn(u64) -> u64 = (*(*r).hk).buf
    return f((*(*r).hk).ud)
}

fn rig_confirm(r: *mut Rig) {
    let f: fn(u64) = (*(*r).hk).ime_confirm
    f((*(*r).hk).ud)
}

fn rig_count(r: *mut Rig, kind: u32) -> u32 {
    return webview_stub.stub_input_count((*r).stub, kind)
}

fn test_sink_routing() {
    var r: Rig = rig_new(webview_types.CAP_IME)
    var spot: [f64; 3] = [0.0; 3]
    check(rig_buf(&r) == 0 as u64 && !rig_spot(&r, &spot) && !rig_pre(&r, PREEDIT_TEXT, 1), "unfocused node takes no IME")
    webview.webview_tick(r.wv, 0)
    webview.webview_focus(r.wv, true)
    webview.webview_tick(r.wv, 1)
    check(rig_buf(&r) != 0 as u64, "focused node owns the IME buffer id")
    check(rig_spot(&r, &spot) && spot[0] == CARET_X, "host asks the node for the caret spot")
    check(rig_pre(&r, PREEDIT_TEXT, 1) && rig_count(&r, webview_types.IN_PREEDIT) == 1 as u32, "preedit reaches the page")
    check(rig_commit(&r, COMMIT_TEXT) && rig_count(&r, webview_types.IN_COMMIT) == 1 as u32, "commit reaches the page")
    webview.webview_tick(r.wv, 2)
    check(rig_spot(&r, &spot) && spot[0] > CARET_X, "spot follows the typed text")
    rig_pre(&r, PREEDIT_TEXT, 1)
    rig_confirm(&r)
    check(rig_count(&r, webview_types.IN_PREEDIT) == 3 as u32, "a click ends the pending preedit")
    webview.webview_focus(r.wv, false)
    check(rig_buf(&r) == 0 as u64 && !rig_commit(&r, COMMIT_TEXT), "blurred node gives the IME back")
    webview.webview_close(r.wv)
    webview_stub.stub_free(r.stub)
}

fn test_char_fallback() {
    var r: Rig = rig_new(0 as u32)
    webview.webview_tick(r.wv, 0)
    webview.webview_focus(r.wv, true)
    check(rig_commit(&r, MIXED_TEXT) && rig_count(&r, webview_types.IN_CHAR) == 2 as u32, "without CAP_IME a commit becomes chars")
    check(!rig_pre(&r, PREEDIT_TEXT, 1), "without CAP_IME a preedit is refused")
    webview.webview_close(r.wv)
    webview_stub.stub_free(r.stub)
}

fn main() -> i32 {
    test_sink_routing()
    test_char_fallback()
    if BAD > 0 {
        say("WEBVIEW IME FAILED\n")
        return 1
    }
    say("WEBVIEW IME PASSED\n")
    return 0
}
