import std.rt
import fui.safeout
import html.mem
import paint.png
import paint.canvas
import font.metrics
import fui.ds_appcard
import fui.ds_listdetail
import fui.ds_navview
import fui.ds_vgrid
import fui.kit
import fui.kitcolor
import fui.lucide
import fui.painter
import fui.render
import fui.style
import fui.theme
import plat.sysfont

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    kitcolor.kit_theme(&(*p).m, dark)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) { return 0 as u64 as *mut Page }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    canvas.canvas_clear(&(*p).cv, theme.opaque(render.color_of(&(*p).c, style.color_token(style.TOK_BASE))))
    return p
}

fn save(p: *mut Page, dir: u64, name: str, dark: bool) {
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    if dark {
        rt.buf_push_bytes(&path, ("-dark.png").p as u64, ("-dark.png").n)
    } else {
        rt.buf_push_bytes(&path, ("-light.png").p as u64, ("-light.png").n)
    }
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(&(*p).cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

fn shot_appcard(dir: u64, font: u64, dark: bool) {
    let probe: *mut Page = page_new(8, 8, dark, font)
    let ph: f64 = ds_appcard.preferred_h(&(*probe).c)
    let p: *mut Page = page_new(320, ((ph + 12.0) * 4.0 + 12.0) as usize, dark, font)
    let c: *mut render.Ctx = &(*p).c
    var k: ds_appcard.Card = ds_appcard.card_new()
    var i: usize = 0
    while i < 4 {
        let y: f64 = 12.0 + (ph + 12.0) * (i as f64)
        if i == 0 { ds_appcard.set_state(&k, ds_appcard.S_INSTALL) }
        if i == 1 { ds_appcard.set_state(&k, ds_appcard.S_OPEN) }
        if i == 2 { ds_appcard.set_state(&k, ds_appcard.S_UPDATE) }
        if i == 3 {
            ds_appcard.set_state(&k, ds_appcard.S_INSTALLING)
            ds_appcard.set_progress(&k, 420 as i64)
        }
        ds_appcard.draw(&k, c, 12.0, y, 296.0, ph, lucide.PACKAGE, "Notes", "Productivity", "4.8 stars", -1.0, -1.0)
        i = i + 1
    }
    save(p, dir, "dsc_appcard", dark)
}

fn nav_fill(v: *mut ds_navview.NavView) {
    ds_navview.add(v, lucide.HOUSE, "Home")
    ds_navview.add(v, lucide.PACKAGE, "Apps")
    ds_navview.add(v, lucide.DOWNLOAD, "Downloads")
    ds_navview.add_footer(v, lucide.SETTINGS, "Settings")
    ds_navview.select(v, 1)
}

fn shot_nav(dir: u64, font: u64, dark: bool, w: usize, name: str, overlay: bool) {
    let p: *mut Page = page_new(w, 360, dark, font)
    let c: *mut render.Ctx = &(*p).c
    var v: ds_navview.NavView = ds_navview.nv_new()
    nav_fill(&v)
    ds_navview.layout(&v, c, 0.0, 0.0, w as f64, 360.0)
    ds_navview.draw(&v, c, -1.0, -1.0)
    if overlay {
        ds_navview.press(&v, 20.0, 20.0)
        ds_navview.draw_overlay(&v, c, -1.0, -1.0)
    }
    save(p, dir, name, dark)
}

fn shot_listdetail(dir: u64, font: u64, dark: bool, w: usize, name: str, open: bool) {
    let p: *mut Page = page_new(w, 400, dark, font)
    let c: *mut render.Ctx = &(*p).c
    var l: ds_listdetail.ListDetail = ds_listdetail.ld_new()
    ds_listdetail.set_count(&l, 50)
    ds_listdetail.layout(&l, c, 0.0, 0.0, w as f64, 400.0)
    if open { ds_listdetail.open_detail(&l, 2) }
    ds_listdetail.begin_list(&l, c, "Items")
    let g: *mut ds_vgrid.Grid = ds_listdetail.list_of(&l)
    var i: usize = ds_vgrid.first(g)
    while i < ds_vgrid.end_index(g) {
        ds_listdetail.row_draw(&l, c, i, lucide.PACKAGE, "Item", "Details", -1.0, -1.0)
        i = i + 1
    }
    ds_listdetail.finish_list(&l, c)
    ds_listdetail.draw_chrome(&l, c, "Item", -1.0, -1.0)
    save(p, dir, name, dark)
}

fn shot_vgrid(dir: u64, font: u64, dark: bool, w: usize, name: str) {
    let p: *mut Page = page_new(w, 480, dark, font)
    let c: *mut render.Ctx = &(*p).c
    var g: ds_vgrid.Grid = ds_vgrid.grid_new()
    ds_vgrid.set_count(&g, 5000)
    ds_vgrid.set_cell(&g, 240, ds_appcard.preferred_h(c) as usize, 12)
    ds_vgrid.layout(&g, c, 0.0, 0.0, w as f64, 480.0)
    ds_vgrid.select(&g, 1)
    ds_vgrid.begin(&g, c, "Apps")
    var cards: [ds_appcard.Card; 64] = [ds_appcard.card_new(); 64]
    var i: usize = ds_vgrid.first(&g)
    let e: usize = ds_vgrid.end_index(&g)
    var r: [f64; 4] = [0.0; 4]
    while i < e {
        ds_vgrid.cell_rect(&g, i, &r)
        ds_appcard.set_state(&cards[i % 64], (i % 3) as u32)
        ds_appcard.draw(&cards[i % 64], c, r[0], r[1], r[2], r[3], lucide.PACKAGE, "Application", "Publisher", "4.8 stars", -1.0, -1.0)
        i = i + 1
    }
    ds_vgrid.finish(&g, c)
    save(p, dir, name, dark)
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) { return 9 }
    if rt.arg_count(start) < 2 { return 2 }
    let dir: u64 = rt.arg_ptr(start, 1)
    let font: u64 = fs as u64
    var d: usize = 0
    while d < 2 {
        let dark: bool = d == 1
        shot_appcard(dir, font, dark)
        shot_nav(dir, font, dark, 1100, "dsc_nav_expanded", false)
        shot_nav(dir, font, dark, 800, "dsc_nav_compact", false)
        shot_nav(dir, font, dark, 400, "dsc_nav_minimal", false)
        shot_nav(dir, font, dark, 400, "dsc_nav_overlay", true)
        shot_listdetail(dir, font, dark, 900, "dsc_ld_split", false)
        shot_listdetail(dir, font, dark, 400, "dsc_ld_stacked", false)
        shot_listdetail(dir, font, dark, 400, "dsc_ld_detail", true)
        shot_vgrid(dir, font, dark, 360, "dsc_vgrid_360")
        shot_vgrid(dir, font, dark, 800, "dsc_vgrid_800")
        shot_vgrid(dir, font, dark, 1240, "dsc_vgrid_1240")
        d = d + 1
    }
    return 0
}
