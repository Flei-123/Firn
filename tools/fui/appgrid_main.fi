// tools/fui/appgrid_main.fi -- the grid container of the ten-line API (appctl.grid, grid_cell, grid_gap, grid_pad, grid_rtl, grid_name): tracks, spans, RTL, inspector line, pictures.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.grid
import fui.inspect
import fui.safeout
import fui.sheet
import fui.anim
import fui.style
import fui.a11y
import fui.render

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn num(tag: str, v: f64) {
    say(tag)
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v as i64)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

#[allow_escape]
fn dlen(a: *mut app.App, node: usize) -> usize {
    var db: [u8; 192] = [0 as u8; 192]
    let n: usize = a11y.a11y_description(app.app_scene(a), app.ax(a), node, (&db[0]) as u64, 192)
    return n
}

fn click(w: *mut fuiwirt.Host, x: f64, y: f64) {
    let m: u32 = fuiwirt.host_pointer_move(w, x, y)
    let d: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let u: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

fn pressed(a: *mut app.App) {
    CHANGES = CHANGES + 1
}

fn has(buf: u64, n: usize, what: str) -> bool {
    if what.n > n {
        return false
    }
    var i: usize = 0
    while i + what.n <= n {
        var j: usize = 0
        while j < what.n && *((buf + (i + j) as u64) as *mut u8) == *((what.p as u64 + j as u64) as *mut u8) {
            j = j + 1
        }
        if j == what.n {
            return true
        }
        i = i + 1
    }
    return false
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appgrid: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Grid", 560, 330)
    let head: usize = app.label(a, "Settings", 14)
    let g: usize = appctl.grid(a, "120 1fr 2fr", "auto auto auto")
    appctl.grid_name(a, g, "Form")
    let l0: usize = app.button(a, "Name", pressed)
    let b1: usize = app.button(a, "OK", pressed)
    let b2: usize = app.button(a, "Cancel", pressed)
    let wide: usize = app.button(a, "Wide", pressed)
    appctl.grid_cell(a, wide, 0, 1, 2, 1)
    let tall: usize = app.button(a, "Tall", pressed)
    appctl.grid_cell(a, tall, 2, 1, 1, 2)
    let low: usize = app.button(a, "Bottom", pressed)
    appctl.grid_cell(a, low, 0, 2, 1, 1)
    app.end(a)
    let after: usize = app.label(a, "After the grid", 0)
    let g2: usize = appctl.grid(a, "1fr foo 2.5fr 100-1fr", "40 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr")
    app.end(a)
    let s: *mut Surface = surface_for(a, 560, 330)
    settle(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    let ax: *mut a11y.A11y = app.ax(a)
    check(g != appctl.NONE && g2 != appctl.NONE && l0 != appctl.NONE && low != appctl.NONE, "grids and cells exist")
    check(scene.node_is_grid(sc, g) && !scene.node_is_grid(sc, head), "the container is a grid node, a label is not")
    check(scene.node_grid_count(sc, g, 0) == 3 && scene.node_grid_count(sc, g, 1) == 3, "3 columns, 3 rows")
    check(scene.node_grid_gap_get(sc, g, 0) == 10 && scene.node_grid_gap_get(sc, g, 1) == 10, "default gap 10")
    // ---- geometry
    let x0: f64 = scene.node_x(sc, l0)
    num("col0 -> col1 dx = ", scene.node_x(sc, b1) - x0)
    num("w(OK) = ", scene.node_w(sc, b1))
    num("w(Cancel) = ", scene.node_w(sc, b2))
    num("w(Wide) = ", scene.node_w(sc, wide))
    num("h(Wide) = ", scene.node_h(sc, wide))
    num("h(Tall) = ", scene.node_h(sc, tall))
    num("h(Bottom) = ", scene.node_h(sc, low))
    check(near(scene.node_w(sc, l0), 120.0, 1.5), "column 0 is 120 wide")
    check(near(scene.node_x(sc, b1) - x0, 130.0, 1.5), "column 1 starts after 120 + gap 10")
    check(near(scene.node_w(sc, b2), 2.0 * scene.node_w(sc, b1), 2.5), "2fr is twice 1fr")
    check(near(scene.node_x(sc, b2) - scene.node_x(sc, b1), scene.node_w(sc, b1) + 10.0, 1.5), "column 2 follows column 1 + gap")
    check(near(scene.node_w(sc, wide), 120.0 + 10.0 + scene.node_w(sc, b1), 2.5), "column span 2 covers two tracks and the gap")
    check(near(scene.node_y(sc, wide), scene.node_y(sc, l0) + scene.node_h(sc, l0) + 10.0, 2.0), "row 1 starts after row 0 + gap")
    check(near(scene.node_h(sc, tall), scene.node_h(sc, wide) + 10.0 + scene.node_h(sc, low), 3.0), "row span 2 covers two rows and the gap")
    check(near(scene.node_x(sc, tall), scene.node_x(sc, b2), 1.0), "Tall sits in column 2")
    check(scene.node_y(sc, after) > scene.node_y(sc, low) + scene.node_h(sc, low) - 1.0, "end() closes the grid: the next label is below it")
    check(scene.scene_parent(sc, after) != g && scene.scene_parent(sc, low) == g, "parents: after is outside, Bottom is inside")
    // ---- cells read back
    check(scene.node_cell_get(sc, b1, 0) == 0 - 1 && scene.node_cell_get(sc, b1, 1) == 0 - 1 && scene.node_cell_get(sc, b1, 2) == 1, "an auto child has col/row -1, span 1")
    check(scene.node_cell_get(sc, tall, 0) == 2 && scene.node_cell_get(sc, tall, 1) == 1 && scene.node_cell_get(sc, tall, 2) == 1 && scene.node_cell_get(sc, tall, 3) == 2, "Tall: col 2, row 1, 1 x 2")
    check(scene.node_cell_get(sc, 99999, 0) == 0 - 1, "bad node: -1")
    // ---- track words
    let sp: *mut grid.GridSpec = scene.node_grid_spec(sc, g2)
    check(scene.node_grid_count(sc, g2, 0) == 4, "4 words = 4 columns (garbage 'foo' becomes auto)")
    check((*sp).cols[0].max_k == grid.TK_FR && (*sp).cols[0].max_v == 1000, "1fr = 1000 per mille")
    check((*sp).cols[1].min_k == grid.TK_AUTO && (*sp).cols[1].max_k == grid.TK_AUTO, "foo = auto")
    check((*sp).cols[2].max_v == 2500, "2.5fr = 2500 per mille")
    check((*sp).cols[3].min_k == grid.TK_PX && (*sp).cols[3].min_v == 100 && (*sp).cols[3].max_k == grid.TK_FR, "100-1fr = minmax(100, 1fr)")
    check(scene.node_grid_count(sc, g2, 1) == 16, "17 words: the 17th row is refused, 16 stay")
    // ---- a11y
    var nb: [u8; 32] = [0 as u8; 32]
    let nn: usize = a11y.a11y_name(sc, ax, g, (&nb[0]) as u64, 32)
    check(a11y.a11y_role(sc, ax, g) == a11y.ROLE_GROUP && nn == 4, "grid: group role named Form")
    // ---- inspector
    let ib: u64 = rt.heap_alloc(2048)
    let itn: usize = inspect.inspect_text(sc, ax, 0 as u64 as *mut sheet.Sheet, g, ib, 2048)
    check(has(ib, itn, "grid cols=3 rows=3 gap=10,10"), "inspector: grid line on the container")
    let itc: usize = inspect.inspect_text(sc, ax, 0 as u64 as *mut sheet.Sheet, tall, ib, 2048)
    check(has(ib, itc, "cell col=2 row=1 span=1x2"), "inspector: cell line on the child")
    let itb: usize = inspect.inspect_text(sc, ax, 0 as u64 as *mut sheet.Sheet, head, ib, 2048)
    check(!has(ib, itb, "grid cols") && !has(ib, itb, "cell col"), "inspector: no grid lines on a plain label")
    // ---- changes after the fact
    appctl.grid_gap(a, g, 20, 4)
    settle(a, s)
    check(near(scene.node_x(sc, b1) - scene.node_x(sc, l0), 140.0, 1.5) && near(scene.node_y(sc, wide) - scene.node_y(sc, l0), 36.0, 1.5), "grid_gap: column gap 20 / row gap 4")
    appctl.grid_pad(a, g, 8, 0, 0, 0)
    settle(a, s)
    check(near(scene.node_x(sc, l0) - scene.node_x(sc, g), 8.0, 1.5) && scene.node_w(sc, g) > 0.0, "grid_pad: left padding 8 insets column 0")
    appctl.grid_pad(a, g, 0, 0, 0, 0)
    appctl.grid_gap(a, g, 10, 10)
    appctl.grid_cell(a, low, 1, 2, 1, 1)
    settle(a, s)
    check(near(scene.node_x(sc, low), scene.node_x(sc, b1), 1.0), "grid_cell: Bottom moved to column 1")
    appctl.grid_cell(a, low, 0, 2, 1, 1)
    // ---- the picture, light then dark; RTL mirrors the columns
    settle(a, s)
    save(&(*s).cv, dir, "grid-light.png")
    app.set_dark(a, true)
    settle(a, s)
    save(&(*s).cv, dir, "grid-dark.png")
    app.set_dark(a, false)
    appctl.grid_rtl(a, g, true)
    settle(a, s)
    check(scene.node_x(sc, l0) > scene.node_x(sc, b1) && scene.node_x(sc, b1) > scene.node_x(sc, b2), "RTL: column 0 on the right")
    check(near(scene.node_x(sc, l0) + scene.node_w(sc, l0), scene.node_x(sc, g) + scene.node_w(sc, g), 1.5), "RTL: column 0 is flush with the right edge")
    appctl.grid_rtl(a, g, false)
    settle(a, s)
    check(near(scene.node_x(sc, l0) - scene.node_x(sc, g), 0.0, 1.0), "RTL off: back at the left edge")
    // ---- harmless misuse
    appctl.grid_cell(a, 99999, 0, 0, 1, 1)
    appctl.grid_gap(a, head, 5, 5)
    appctl.grid_rtl(a, head, true)
    appctl.grid_name(a, g, "")
    settle(a, s)
    check(!scene.node_is_grid(sc, head) && scene.node_grid_count(sc, head, 0) == 0, "grid calls on a non-grid change nothing")
    if BAD == 0 {
        say("APPGRID PASSED\n")
        return 0
    }
    say("APPGRID FAILED\n")
    return 1
}
