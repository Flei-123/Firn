// SPDX-License-Identifier: MPL-2.0
// tools/fui/ripple_main.fi -- test for lib/fui/ripple.fi
//
//     ripple_main        prints RIPPLE PASSED / FAILED
//
// Geometry (farthest corner), timing (expand curve, fade), slots, off switch, and real pixels:
// the wave tints the control rect only, grows with time and is gone after the fade.
import std.rt
import paint.canvas
import fui.painter
import fui.ripple

static mut FAILS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if !ok {
        FAILS = FAILS + 1
        say("FAIL: ")
        say(what)
        say("\n")
    }
}

fn near(a: f64, b: f64, eps: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    return d <= eps
}

// number of pixels in the canvas that differ from the clear colour (checks the red octet)
fn changed_px(cv: *mut canvas.Canvas, w: usize, h: usize, x0: usize, y0: usize, x1: usize, y1: usize) -> usize {
    let px: *mut u8 = canvas.canvas_pixels(cv)
    var n: usize = 0
    var y: usize = y0
    while y < y1 {
        var x: usize = x0
        while x < x1 {
            let o: usize = (y * w + x) * 4
            if rt.ld8(px as u64, o) != 255 as u8 || rt.ld8(px as u64, o + 1) != 255 as u8 {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn main(start: u64) -> i32 {
    // ---- geometry
    check(near(ripple.max_radius(50.0, 20.0, 0.0, 0.0, 100.0, 40.0), 53.851648, 0.001), "centre: half diagonal")
    check(near(ripple.max_radius(0.0, 0.0, 0.0, 0.0, 30.0, 40.0), 50.0, 0.001), "corner press: full diagonal")

    // ---- timing
    var rp: ripple.Ripples = ripple.ripples_new()
    check(!ripple.busy(&rp, 0), "idle at start")
    let s: usize = ripple.press(&rp, 1000, 50.0, 20.0, 0.0, 0.0, 100.0, 40.0)
    check(s == 0, "first slot is 0")
    check(near(ripple.radius_at(&rp, s, 1000), 0.0, 0.0001), "radius 0 at press")
    check(near(ripple.radius_at(&rp, s, 1000 + ripple.EXPAND_MS), 53.851648, 0.001), "full radius after EXPAND_MS")
    var prev: f64 = 0.0
    var mono: bool = true
    var t: i64 = 1000
    while t <= 1000 + ripple.EXPAND_MS {
        let r: f64 = ripple.radius_at(&rp, s, t)
        if r < prev {
            mono = false
        }
        prev = r
        t = t + 10
    }
    check(mono, "radius never shrinks while growing")
    // decelerating: first half of the time covers more than half of the distance
    check(ripple.radius_at(&rp, s, 1000 + ripple.EXPAND_MS / 2) > 0.5 * 53.851648, "decelerate curve")
    check(near(ripple.alpha_at(&rp, s, 5000), 1.0, 0.0001), "held = full alpha")
    check(ripple.busy(&rp, 5000), "held press keeps the frame loop busy")
    ripple.release(&rp, 1200)
    check(near(ripple.alpha_at(&rp, s, 1200), 1.0, 0.0001), "alpha 1 at release")
    check(near(ripple.alpha_at(&rp, s, 1200 + ripple.FADE_MS / 2), 0.5, 0.001), "alpha 0.5 mid fade")
    check(near(ripple.alpha_at(&rp, s, 1200 + ripple.FADE_MS), 0.0, 0.0001), "alpha 0 after fade")
    check(ripple.busy(&rp, 1300), "busy while fading")
    check(!ripple.busy(&rp, 1000 + ripple.EXPAND_MS + ripple.FADE_MS + 1), "idle after expand + fade")
    // released before the expand ended: the wave still finishes growing
    check(ripple.busy(&rp, 1000 + ripple.EXPAND_MS - 5), "still growing")

    // ---- slots: 6 presses never use more than RIPPLES
    var r2: ripple.Ripples = ripple.ripples_new()
    var i: i64 = 0
    while i < 6 {
        let k: usize = ripple.press(&r2, 100 + i, 5.0, 5.0, 0.0, 0.0, 10.0, 10.0)
        check(k < ripple.RIPPLES, "slot in range")
        i = i + 1
    }
    check(ripple.count(&r2, 110) == ripple.RIPPLES, "at most RIPPLES live")

    // ---- off switch
    var r3: ripple.Ripples = ripple.ripples_new()
    ripple.set_enabled(&r3, false)
    check(ripple.press(&r3, 0, 1.0, 1.0, 0.0, 0.0, 10.0, 10.0) == ripple.RIPPLES, "disabled: no slot")
    check(!ripple.busy(&r3, 0), "disabled: never busy")

    // ---- pixels
    var cv: canvas.Canvas = canvas.canvas_new()
    var z: painter.Painter = painter.painter_new()
    let w: usize = 200
    let h: usize = 100
    check(canvas.canvas_init(&cv, w, h) && painter.painter_init(&z, &cv, w, h), "surface")
    var r4: ripple.Ripples = ripple.ripples_new()
    // control rect 40..140 x 30..70, press at its centre
    let s4: usize = ripple.press(&r4, 0, 90.0, 50.0, 40.0, 30.0, 100.0, 40.0)
    painter.painter_clear(&z, 4294967295 as u32)
    ripple.paint(&z, &r4, 5, 40.0, 30.0, 100.0, 40.0, 0.0, 0 as u32)
    let early: usize = changed_px(&cv, w, h, 0, 0, w, h)
    painter.painter_clear(&z, 4294967295 as u32)
    ripple.paint(&z, &r4, 200, 40.0, 30.0, 100.0, 40.0, 0.0, 0xFF0000 as u32)
    let mid: usize = changed_px(&cv, w, h, 0, 0, w, h)
    let outside: usize = changed_px(&cv, w, h, 0, 0, 40, h) + changed_px(&cv, w, h, 140, 0, w, h)
        + changed_px(&cv, w, h, 0, 0, w, 30) + changed_px(&cv, w, h, 0, 70, w, h)
    check(mid > early, "wave grows with time")
    check(mid > 100, "wave is visible")
    check(outside == 0, "nothing outside the control rect")
    // frame-rate independence: the same time paints the same pixels no matter how often we painted before
    painter.painter_clear(&z, 4294967295 as u32)
    ripple.paint(&z, &r4, 90, 40.0, 30.0, 100.0, 40.0, 0.0, 0xFF0000 as u32)
    ripple.paint(&z, &r4, 200, 40.0, 30.0, 100.0, 40.0, 0.0, 0xFF0000 as u32)
    // gone after release + fade
    ripple.release(&r4, 300)
    painter.painter_clear(&z, 4294967295 as u32)
    ripple.paint(&z, &r4, 300 + ripple.FADE_MS + 1, 40.0, 30.0, 100.0, 40.0, 0.0, 0xFF0000 as u32)
    check(changed_px(&cv, w, h, 0, 0, w, h) == 0, "gone after the fade")

    if FAILS > 0 {
        say("RIPPLE FAILED\n")
        return 1
    }
    say("RIPPLE PASSED\n")
    return 0
}
