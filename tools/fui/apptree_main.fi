// SPDX-License-Identifier: MPL-2.0
// tools/fui/apptree_main.fi -- THE APP TREE, MEASURED (docs/APP-TREE.md).
//
// The question behind this program (Justin, 29.09.2026): should a whole
// fUi / OrientOS application live in ONE browser-like element tree --
// layout, events, accessibility, queries and automation all reading the
// same scene.Scene -- instead of being painted like a classic program?
// The answer depends on what the tree costs. This program measures it on
// the tree fUi has today (lib/fui/scene.fi), with nothing added to the
// library:
//
//   A. the real page of gallery9 (the page tools/fui/run.sh paints and the
//      web demo shows): building it, the four passes (style, measure, lay
//      out, draw), a hit test, a lookup by id, a QUERY BY SELECTOR (see
//      below), the accessibility dump and the unnamed-control check;
//   B. synthetic application trees of growing size (a grid of cards, each
//      row a label, a button and a checkbox) -- the same measurements, so
//      the cost per node can be read off;
//   C. the bytes a node costs (scene node + accessibility entry).
//
// THE QUERY BY SELECTOR is a prototype of `querySelectorAll` that builds
// no second selector engine: it walks the tree like scene_style does,
// builds the same ancestor chain of sheet.NodeDesc and asks
// sheet.sheet_match -- the matcher the stylesheet already uses. Whatever
// a stylesheet can select, a script or an agent can then find.
//
//   apptree_main [max_nodes] [rounds]
//
// max_nodes caps part B (default 128 = scene.SCENE_MAX). Built against a
// library copy with a larger SCENE_MAX (tools/fui/apptree.sh does that in
// a temporary directory), part B goes up to 1024 nodes. Numbers go to
// standard output, one key=value line per tree; times are medians of the
// rounds. Exit 0 = every tree was complete (no node refused).
import std.rt
import paint.canvas
import font.metrics
import fui.theme
import fui.style
import fui.painter
import fui.render
import fui.viewport
import fui.sheet
import fui.scene
import fui.widget
import fui.flex
import fui.a11y
import gallery9_main

// ============================================================ HELPERS

fn now_ms() -> f64 {
    var ts: [u64; 2] = [0; 2]
    // SYS_clock_gettime = 228, CLOCK_MONOTONIC = 1
    syscall(228, 1, (&ts[0]) as u64)
    return (ts[0] as f64) * 1000.0 + (ts[1] as f64) / 1000000.0
}

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_int(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var n: usize = 0
    var w: u64 = v
    if w == 0 {
        buf[0] = 48 as u8
        n = 1
    }
    while w > 0 {
        buf[n] = (48 + (w % 10)) as u8
        w = w / 10
        n = n + 1
    }
    var out: [u8; 24] = [0; 24]
    var i: usize = 0
    while i < n {
        out[i] = buf[n - 1 - i]
        i = i + 1
    }
    rt.write_everything(1, (&out[0]) as u64, n)
}

// One decimal.
fn say_num(v: f64) {
    var x: f64 = v
    if x < 0.0 {
        say("-")
        x = 0.0 - x
    }
    var whole: u64 = x as u64
    var tenth: u64 = ((x - (whole as f64)) * 10.0 + 0.5) as u64
    if tenth >= 10 {
        whole = whole + 1
        tenth = 0
    }
    say_int(whole)
    say(".")
    say_int(tenth)
}

fn median(t: *mut f64, n: usize) -> f64 {
    var a: [f64; 64] = [0.0; 64]
    var i: usize = 0
    while i < n && i < 64 {
        a[i] = *((t as u64 + (i * 8) as u64) as *mut f64)
        i = i + 1
    }
    i = 1
    while i < n {
        var j: usize = i
        while j > 0 && a[j - 1] > a[j] {
            let x: f64 = a[j]
            a[j] = a[j - 1]
            a[j - 1] = x
            j = j - 1
        }
        i = i + 1
    }
    return a[n / 2]
}

// xorshift64 -- the same points on every run
fn next(s: *mut u64) -> u64 {
    var x: u64 = *s
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    *s = x
    return x
}

fn rnd(s: *mut u64, lo: f64, hi: f64) -> f64 {
    let u: f64 = ((next(s) >> 11) as f64) / 9007199254740992.0
    return lo + (hi - lo) * u
}

fn arg_num(p: u64) -> usize {
    var v: usize = 0
    var i: usize = 0
    while rt.ld8(p, i) >= 48 as u8 && rt.ld8(p, i) <= 57 as u8 {
        v = v * 10 + ((rt.ld8(p, i) - 48 as u8) as usize)
        i = i + 1
    }
    return v
}

// FNV-1a over the picture -- two builds that must paint the same octets
// (the culling experiment of docs/APP-TREE.md) print the same number.
fn pixel_sum(cv: *mut canvas.Canvas, n: usize) -> u64 {
    let p: u64 = canvas.canvas_pixels(cv) as u64
    // 32-bit FNV-1a, multiplied wide and cut back (Firn traps on an
    // overflowing multiplication; FNV needs exactly that overflow)
    var h: u32 = 2166136261 as u32
    var i: usize = 0
    while i < n {
        h = h ^ (rt.ld8(p, i) as u32)
        let wide: u64 = (h as u64) * (16777619 as u64)
        h = (wide & (4294967295 as u64)) as u32
        i = i + 1
    }
    return h as u64
}

// ================================================== QUERY BY SELECTOR
//
// Every node the selector in rule 0 of `q` matches, in tree order, into
// `out` (at most `cap`); the answer is the full count. The walk and the
// chain are the ones of scene.style_walk; the matcher is sheet_match.
fn query_walk(sc: *mut scene.Scene, q: *mut sheet.Sheet, i: usize,
    chain: *mut sheet.NodeDesc, depth: usize, out: u64, cap: usize,
    n: *mut usize) {
    if i == scene.SCENE_NONE || i >= scene.scene_count(sc) {
        return
    }
    if depth >= sheet.CHAIN_MAX {
        return
    }
    *((chain as u64 + (depth * sheet.sheet_desc_stride()) as u64)
        as *mut sheet.NodeDesc) = scene.scene_desc(sc, i)
    if sheet.sheet_match(q, 0, chain, depth + 1) {
        if *n < cap {
            *((out + (*n * 8) as u64) as *mut usize) = i
        }
        *n = *n + 1
    }
    var c: usize = scene.scene_first_child(sc, i)
    while c != scene.SCENE_NONE {
        query_walk(sc, q, c, chain, depth + 1, out, cap, n)
        c = scene.scene_next_sibling(sc, c)
    }
}

fn query_all(sc: *mut scene.Scene, q: *mut sheet.Sheet, out: u64,
    cap: usize) -> usize {
    var chain: [sheet.NodeDesc; 16] =
    [sheet.desc_new(0 as u32, 0 as u32); 16]
    var n: usize = 0
    query_walk(sc, q, scene.scene_root(sc), &chain[0], 0, out, cap, &n)
    return n
}

// ========================================================= THE PASSES

fn t_style(sc: *mut scene.Scene, sh: *mut sheet.Sheet, rounds: usize) -> f64 {
    var t: [f64; 64] = [0.0; 64]
    var i: usize = 0
    while i < rounds {
        let a: f64 = now_ms()
        scene.scene_style(sc, sh)
        t[i] = now_ms() - a
        i = i + 1
    }
    return median(&t[0], rounds)
}

fn t_measure(sc: *mut scene.Scene, c: *mut render.Ctx, rounds: usize) -> f64 {
    var t: [f64; 64] = [0.0; 64]
    var i: usize = 0
    while i < rounds {
        let a: f64 = now_ms()
        scene.scene_measure(sc, c)
        t[i] = now_ms() - a
        i = i + 1
    }
    return median(&t[0], rounds)
}

fn t_layout(sc: *mut scene.Scene, c: *mut render.Ctx, w: f64, h: f64,
    rounds: usize) -> f64 {
    var t: [f64; 64] = [0.0; 64]
    var i: usize = 0
    while i < rounds {
        let a: f64 = now_ms()
        scene.scene_layout(sc, c, 0.0, 0.0, w, h)
        t[i] = now_ms() - a
        i = i + 1
    }
    return median(&t[0], rounds)
}

fn t_clear(cv: *mut canvas.Canvas, base: u32, rounds: usize) -> f64 {
    var t: [f64; 64] = [0.0; 64]
    var i: usize = 0
    while i < rounds {
        let a: f64 = now_ms()
        canvas.canvas_clear(cv, base)
        t[i] = now_ms() - a
        i = i + 1
    }
    return median(&t[0], rounds)
}

// The draw pass on a cleared canvas; the clear is measured on its own and
// taken off, so this is what the TREE costs to paint.
fn t_draw(sc: *mut scene.Scene, c: *mut render.Ctx, cv: *mut canvas.Canvas,
    base: u32, rounds: usize) -> f64 {
    var t: [f64; 64] = [0.0; 64]
    var i: usize = 0
    while i < rounds {
        canvas.canvas_clear(cv, base)
        let a: f64 = now_ms()
        scene.scene_draw(sc, c)
        t[i] = now_ms() - a
        i = i + 1
    }
    return median(&t[0], rounds)
}

// ns per hit test, over 1000 fixed points in the window.
fn t_hit(sc: *mut scene.Scene, px: *mut f64, py: *mut f64, rounds: usize,
    found: *mut usize) -> f64 {
    var t: [f64; 64] = [0.0; 64]
    var i: usize = 0
    var got: usize = 0
    while i < rounds {
        got = 0
        let a: f64 = now_ms()
        var k: usize = 0
        while k < 1000 {
            let x: f64 = *((px as u64 + (k * 8) as u64) as *mut f64)
            let y: f64 = *((py as u64 + (k * 8) as u64) as *mut f64)
            if scene.scene_hit(sc, x, y) != scene.SCENE_NONE {
                got = got + 1
            }
            k = k + 1
        }
        t[i] = now_ms() - a
        i = i + 1
    }
    *found = got
    return median(&t[0], rounds) * 1000000.0 / 1000.0
}

// ns per lookup by id (linear scan, scene_find_id), ids 1 .. 2*maxid so
// that half of the lookups miss and walk the whole tree.
fn t_find(sc: *mut scene.Scene, maxid: u32, rounds: usize) -> f64 {
    var t: [f64; 64] = [0.0; 64]
    var i: usize = 0
    var sink: usize = 0
    while i < rounds {
        var seed: u64 = 2463534242 as u64
        let a: f64 = now_ms()
        var k: usize = 0
        while k < 1000 {
            let id: u32 = (1 + (next(&seed) % ((2 * maxid) as u64))) as u32
            if scene.scene_find_id(sc, id) != scene.SCENE_NONE {
                sink = sink + 1
            }
            k = k + 1
        }
        t[i] = now_ms() - a
        i = i + 1
    }
    if sink == 0 {
        say("")
    }
    return median(&t[0], rounds) * 1000000.0 / 1000.0
}

// us per full query (whole tree walked), 100 queries per round.
fn t_query(sc: *mut scene.Scene, q: *mut sheet.Sheet, out: u64,
    rounds: usize, hits: *mut usize) -> f64 {
    var t: [f64; 64] = [0.0; 64]
    var i: usize = 0
    var n: usize = 0
    while i < rounds {
        let a: f64 = now_ms()
        var k: usize = 0
        while k < 100 {
            n = query_all(sc, q, out, 4096)
            k = k + 1
        }
        t[i] = now_ms() - a
        i = i + 1
    }
    *hits = n
    return median(&t[0], rounds) * 1000.0 / 100.0
}

// us per accessibility dump of the whole tree.
fn t_dump(sc: *mut scene.Scene, ax: *mut a11y.A11y, buf: u64, cap: usize,
    rounds: usize, bytes: *mut usize) -> f64 {
    var t: [f64; 64] = [0.0; 64]
    var i: usize = 0
    var n: usize = 0
    while i < rounds {
        let a: f64 = now_ms()
        var k: usize = 0
        while k < 10 {
            n = a11y.a11y_dump(sc, ax, buf, cap)
            k = k + 1
        }
        t[i] = now_ms() - a
        i = i + 1
    }
    *bytes = n
    return median(&t[0], rounds) * 1000.0 / 10.0
}

// us per unnamed-control check (the check a build could run).
fn t_unnamed(sc: *mut scene.Scene, ax: *mut a11y.A11y, rounds: usize,
    missing: *mut usize) -> f64 {
    var t: [f64; 64] = [0.0; 64]
    var i: usize = 0
    var n: usize = 0
    while i < rounds {
        let a: f64 = now_ms()
        var k: usize = 0
        while k < 10 {
            n = a11y.a11y_unnamed(sc, ax)
            k = k + 1
        }
        t[i] = now_ms() - a
        i = i + 1
    }
    *missing = n
    return median(&t[0], rounds) * 1000.0 / 10.0
}

// ================================================ THE SYNTHETIC TREE
//
// A wrapping row of cards (300 points wide, the gallery's card class),
// each card a column of up to 16 rows, each row a label, a button and a
// checkbox. Every control gets an id, the way an app that wants stable
// ids would do it. Nodes = 1 + cards + 4 * rows.
const CARD_ROWS: usize = 16

fn synth_nodes(rows: usize) -> usize {
    return 1 + (rows + CARD_ROWS - 1) / CARD_ROWS + 4 * rows
}

fn build_synth(sc: *mut scene.Scene, rows: usize, k_card: u32,
    k_line: u32, k_even: u32, k_accent: u32, t: u64) -> u32 {
    scene.scene_reset(sc)
    let root: usize = scene.scene_add(sc, scene.SCENE_NONE, scene.N_BOX)
    scene.node_set_flex(sc, root, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_START)
    scene.node_set_wrap(sc, root, flex.WRAP_WRAP)
    scene.node_set_padding(sc, root, 8, 8, 8, 8)
    scene.node_set_gap(sc, root, 8, 8)
    var card: usize = scene.SCENE_NONE
    var id: u32 = 1 as u32
    var r: usize = 0
    while r < rows {
        if r % CARD_ROWS == 0 {
            card = scene.scene_add(sc, root, scene.N_BOX)
            scene.node_add_class(sc, card, k_card)
            scene.node_set_flex(sc, card, flex.FLEX_COLUMN,
                flex.JUSTIFY_START, flex.AL_STRETCH)
            scene.node_set_size(sc, card, 300.0, 0.0)
            scene.node_set_gap(sc, card, 4, 0)
        }
        let row: usize = scene.scene_add(sc, card, scene.N_BOX)
        scene.node_add_class(sc, row, k_line)
        if r % 2 == 0 {
            scene.node_add_class(sc, row, k_even)
        }
        scene.node_set_flex(sc, row, flex.FLEX_ROW, flex.JUSTIFY_START,
            flex.AL_CENTER)
        scene.node_set_gap(sc, row, 6, 0)
        scene.node_set_size(sc, row, 0.0, 30.0)
        let lab: usize = scene.scene_add(sc, row, scene.N_TEXT)
        scene.node_set_text(sc, lab, t, 10)
        scene.node_set_grow(sc, lab, 1000, 1000)
        let b: usize = scene.scene_widget(sc, row, widget.KIND_BUTTON,
            t + 16 as u64, 4)
        scene.node_set_id(sc, b, id)
        if r % 4 == 3 {
            scene.node_add_class(sc, b, k_accent)
        }
        id = id + 1 as u32
        let cb: usize = scene.scene_widget(sc, row, widget.KIND_CHECKBOX,
            t + 32 as u64, 5)
        scene.node_set_id(sc, cb, id)
        id = id + 1 as u32
        r = r + 1
    }
    return id - 1 as u32
}

// ============================================= THE MEMO CHANGES NOTHING

// Every node's preferred size and rectangle (6 numbers) and its resolved
// style (ssz bytes).
fn snap_tree(sc: *mut scene.Scene, g: *mut f64, sb: u64, ssz: usize) {
    var i: usize = 0
    while i < scene.scene_count(sc) {
        let o: u64 = g as u64 + (i * 48) as u64
        *((o) as *mut f64) = scene.node_pref_w(sc, i)
        *((o + 8) as *mut f64) = scene.node_pref_h(sc, i)
        *((o + 16) as *mut f64) = scene.node_x(sc, i)
        *((o + 24) as *mut f64) = scene.node_y(sc, i)
        *((o + 32) as *mut f64) = scene.node_w(sc, i)
        *((o + 40) as *mut f64) = scene.node_h(sc, i)
        rt.mem_copy(sb + (i * ssz) as u64, scene.node_style(sc, i) as u64, ssz)
        i = i + 1
    }
}

// Two styles field by field (a byte compare would also see the padding
// between fields, which a struct copy does not carry).
fn style_same(a: *mut style.Style, b: *mut style.Style) -> bool {
    var ok: bool = true
    ok = ok && (*a).bg == (*b).bg
    ok = ok && (*a).border == (*b).border
    ok = ok && (*a).fg == (*b).fg
    ok = ok && (*a).border_w == (*b).border_w
    ok = ok && (*a).radius == (*b).radius
    ok = ok && (*a).pad_x == (*b).pad_x
    ok = ok && (*a).pad_y == (*b).pad_y
    ok = ok && (*a).font_px == (*b).font_px
    ok = ok && (*a).weight == (*b).weight
    ok = ok && (*a).slant == (*b).slant
    ok = ok && (*a).font_id == (*b).font_id
    ok = ok && (*a).align == (*b).align
    ok = ok && (*a).alpha == (*b).alpha
    ok = ok && (*a).tracking == (*b).tracking
    ok = ok && (*a).word_spacing == (*b).word_spacing
    ok = ok && (*a).line_height == (*b).line_height
    ok = ok && (*a).line_h_abs == (*b).line_h_abs
    ok = ok && (*a).kerning == (*b).kerning
    ok = ok && (*a).out_w == (*b).out_w
    ok = ok && (*a).sh_dx == (*b).sh_dx
    ok = ok && (*a).sh_dy == (*b).sh_dy
    ok = ok && (*a).out_col == (*b).out_col
    ok = ok && (*a).sh_col == (*b).sh_col
    ok = ok && (*a).grad_col == (*b).grad_col
    ok = ok && (*a).width == (*b).width
    ok = ok && (*a).height == (*b).height
    ok = ok && (*a).dir == (*b).dir
    ok = ok && (*a).bg2 == (*b).bg2
    ok = ok && (*a).g_a0 == (*b).g_a0
    ok = ok && (*a).g_a1 == (*b).g_a1
    ok = ok && (*a).g_dx == (*b).g_dx
    ok = ok && (*a).g_dy == (*b).g_dy
    ok = ok && (*a).bs_lift == (*b).bs_lift
    ok = ok && (*a).bs_blur == (*b).bs_blur
    ok = ok && (*a).bs_a == (*b).bs_a
    ok = ok && (*a).bs_col == (*b).bs_col
    ok = ok && (*a).gl_col == (*b).gl_col
    ok = ok && (*a).gl_x == (*b).gl_x
    ok = ok && (*a).gl_y == (*b).gl_y
    ok = ok && (*a).gl_rx == (*b).gl_rx
    ok = ok && (*a).gl_ry == (*b).gl_ry
    ok = ok && (*a).gl_k == (*b).gl_k
    ok = ok && (*a).fl_min == (*b).fl_min
    ok = ok && (*a).fl_max == (*b).fl_max
    ok = ok && (*a).fl_base == (*b).fl_base
    ok = ok && (*a).fl_vw == (*b).fl_vw
    ok = ok && (*a).set_mask == (*b).set_mask
    return ok
}

// How many nodes differ from the snapshot.
fn diff_tree(sc: *mut scene.Scene, g: *mut f64, sb: u64, ssz: usize) -> usize {
    var bad: usize = 0
    var i: usize = 0
    while i < scene.scene_count(sc) {
        let o: u64 = g as u64 + (i * 48) as u64
        var ok: bool = *((o) as *mut f64) == scene.node_pref_w(sc, i)
        ok = ok && *((o + 8) as *mut f64) == scene.node_pref_h(sc, i)
        ok = ok && *((o + 16) as *mut f64) == scene.node_x(sc, i)
        ok = ok && *((o + 24) as *mut f64) == scene.node_y(sc, i)
        ok = ok && *((o + 32) as *mut f64) == scene.node_w(sc, i)
        ok = ok && *((o + 40) as *mut f64) == scene.node_h(sc, i)
        ok = ok && style_same((sb + (i * ssz) as u64) as *mut style.Style,
            scene.node_style(sc, i))
        if !ok {
            if bad == 0 {
                say("apptree: first differing node ")
                say_int(i as u64)
                say(" geometry ")
                say_num(*((o) as *mut f64))
                say("/")
                say_num(scene.node_pref_w(sc, i))
                say(" ")
                say_num(*((o + 8) as *mut f64))
                say("/")
                say_num(scene.node_pref_h(sc, i))
                say(" x ")
                say_num(*((o + 16) as *mut f64))
                say("/")
                say_num(scene.node_x(sc, i))
                say(" y ")
                say_num(*((o + 24) as *mut f64))
                say("/")
                say_num(scene.node_y(sc, i))
                say(" w ")
                say_num(*((o + 32) as *mut f64))
                say("/")
                say_num(scene.node_w(sc, i))
                say(" h ")
                say_num(*((o + 40) as *mut f64))
                say("/")
                say_num(scene.node_h(sc, i))
                if !style_same((sb + (i * ssz) as u64) as *mut style.Style,
                    scene.node_style(sc, i)) {
                    say(" style differs")
                }
                say("\n")
            }
            bad = bad + 1
        }
        i = i + 1
    }
    return bad
}

// ================================================================ MAIN

fn main(start: u64) -> i32 {
    var max_nodes: usize = 128
    var rounds: usize = 15
    if rt.arg_count(start) >= 2 {
        max_nodes = arg_num(rt.arg_ptr(start, 1))
    }
    if rt.arg_count(start) >= 3 {
        rounds = arg_num(rt.arg_ptr(start, 2))
    }
    if rounds > 64 {
        rounds = 64
    }
    if rounds < 3 {
        rounds = 3
    }
    let width: usize = 1240
    let height: usize = 720
    let fw: f64 = width as f64
    let fh: f64 = height as f64

    // ---- the font, the canvas, the painter (as in tempo_main)
    var fbuf: rt.Buf = rt.buf_new()
    var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
    if !rt.read_file((&f1[0]) as u64, &fbuf) {
        say("apptree: no font\n")
        return 9
    }
    let fsp: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    *fsp = metrics.fontset_new()
    if !metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
        return 9
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, width, height) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, width, height) {
        return 5
    }
    painter.painter_set_font(&z, fsp as u64)
    var m: theme.Theme = theme.theme_new(true)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    let base: u32 = theme.opaque((*f).base)

    // ---- the tree, the accessibility record and the query sheets live
    // on the heap: with a larger SCENE_MAX (part B) they no longer fit a
    // comfortable stack frame.
    let sc: *mut scene.Scene = rt.heap_alloc(2097152) as *mut scene.Scene
    *sc = scene.scene_new()
    let ax: *mut a11y.A11y = rt.heap_alloc(524288) as *mut a11y.A11y
    *ax = a11y.a11y_new()
    let sh: *mut sheet.Sheet = rt.heap_alloc(1048576) as *mut sheet.Sheet
    *sh = sheet.sheet_new()
    let q1: *mut sheet.Sheet = rt.heap_alloc(1048576) as *mut sheet.Sheet
    *q1 = sheet.sheet_new()
    let q2: *mut sheet.Sheet = rt.heap_alloc(1048576) as *mut sheet.Sheet
    *q2 = sheet.sheet_new()
    let qout: u64 = rt.heap_alloc(4096 * 8)
    let dcap: usize = 262144
    let dbuf: u64 = rt.heap_alloc(dcap)
    let memo: *mut scene.Memo = rt.heap_alloc(1048576) as *mut scene.Memo
    *memo = scene.memo_new()
    var sprobe: [style.Style; 2] = [style.style_new(); 2]
    let ssz: usize = ((&sprobe[1]) as u64 - (&sprobe[0]) as u64) as usize

    // ---- part C first: what a node costs in bytes
    let stride: u64 = (scene.scene_node(sc, 1) as u64)
    -(scene.scene_node(sc, 0) as u64)
    var two: [a11y.A11y; 2] = [a11y.a11y_new(); 2]
    let axbytes: u64 = ((&two[1]) as u64) - ((&two[0]) as u64)
    // where the bytes of a node go: it carries a whole widget (with its
    // style set), a stylesheet declaration and a flex box
    var ww: [widget.Widget; 2] = [widget.widget_new(widget.KIND_NONE); 2]
    var dd: [sheet.Decl; 2] = [sheet.decl_new(); 2]
    var ff: [flex.FlexBox; 2] = [flex.flexbox_new(flex.FLEX_ROW); 2]
    var ss: [style.Style; 2] = [style.style_new(); 2]
    say("apptree bytes node_stride=")
    say_int(stride)
    say(" a11y_record=")
    say_int(axbytes)
    say(" widget=")
    say_int(((&ww[1]) as u64) - ((&ww[0]) as u64))
    say(" decl=")
    say_int(((&dd[1]) as u64) - ((&dd[0]) as u64))
    say(" flexbox=")
    say_int(((&ff[1]) as u64) - ((&ff[0]) as u64))
    say(" style=")
    say_int(((&ss[1]) as u64) - ((&ss[0]) as u64))
    say(" scene_max=")
    say_int(scene.SCENE_MAX as u64)
    say("\n")

    // ---- the gallery's names and stylesheet
    let texts: u64 = rt.heap_alloc(640)
    let field: u64 = rt.heap_alloc(gallery9_main.LINES * gallery9_main.STEP)
    gallery9_main.write_texts(texts)
    gallery9_main.write_lines(field)
    var nleiste: [u8; 6] = "leiste"
    var ntitel: [u8; 5] = "titel"
    var nkarte: [u8; 5] = "karte"
    var nueber: [u8; 5] = "ueber"
    var nnotiz: [u8; 5] = "notiz"
    var nliste: [u8; 5] = "liste"
    var nzeile: [u8; 5] = "zeile"
    var ngerade: [u8; 6] = "gerade"
    var nakzent: [u8; 6] = "akzent"
    let k_bar: u32 = sheet.sheet_name((&nleiste[0]) as u64, 6)
    let k_titel: u32 = sheet.sheet_name((&ntitel[0]) as u64, 5)
    let k_karte: u32 = sheet.sheet_name((&nkarte[0]) as u64, 5)
    let k_over: u32 = sheet.sheet_name((&nueber[0]) as u64, 5)
    let k_notiz: u32 = sheet.sheet_name((&nnotiz[0]) as u64, 5)
    let k_list: u32 = sheet.sheet_name((&nliste[0]) as u64, 5)
    let k_line: u32 = sheet.sheet_name((&nzeile[0]) as u64, 5)
    let k_even: u32 = sheet.sheet_name((&ngerade[0]) as u64, 6)
    let k_accent: u32 = sheet.sheet_name((&nakzent[0]) as u64, 6)
    let spurfarbe: u32 = theme.color_from_token(&m, style.TOK_SURFACE)
    let basic_list: u32 = theme.mix(spurfarbe,
        theme.color_from_token(&m, style.TOK_TEXT), 500)
    gallery9_main.build_leaf(sh, k_bar, k_titel, k_karte, k_over,
        k_notiz, k_list, k_line, k_even, k_accent,
        style.color_literal(basic_list))
    // a hovered node gets another fill and more room (it moves its
    // neighbours): the memo has to see the state, else frames go wrong
    var hd: sheet.Decl = sheet.decl_new()
    sheet.decl_set_style(&hd, style.style_set_pad(style.style_set_bg(
                style.style_new(), style.color_literal(0xFF3366CC as u32)), 9, 5))
    sheet.sheet_add(sh, sheet.sel_with_state(sheet.sel_any(),
            style.STATE_HOVER), hd)

    // the fixed points of the hit test
    let px: *mut f64 = rt.heap_alloc(8000) as *mut f64
    let py: *mut f64 = rt.heap_alloc(8000) as *mut f64
    var seed: u64 = 88172645463325252 as u64
    var k: usize = 0
    while k < 1000 {
        *((px as u64 + (k * 8) as u64) as *mut f64) = rnd(&seed, 0.0, fw)
        *((py as u64 + (k * 8) as u64) as *mut f64) = rnd(&seed, 0.0, fh)
        k = k + 1
    }

    var incomplete: usize = 0

    // ================================================ A. THE GALLERY PAGE
    // on the heap: the tree keeps a pointer to it (scene.node_set_viewport)
    let v: *mut viewport.Viewport =
    rt.heap_alloc(65536) as *mut viewport.Viewport
    *v = viewport.viewport_new(0.0, 0.0,
        gallery9_main.LIST_W, 400.0, gallery9_main.CONTENT_W,
        gallery9_main.CONTENT_H)
    viewport.viewport_set_bar(v, gallery9_main.BAR)
    viewport.viewport_set_inset(v, gallery9_main.PADDING)
    viewport.viewport_set_offset(v, 0.0, gallery9_main.ROLL_Y)
    // building it, rounds times
    var tb: [f64; 64] = [0.0; 64]
    var frame_box: usize = 0
    var i: usize = 0
    while i < rounds {
        let a: f64 = now_ms()
        scene.scene_reset(sc)
        frame_box = gallery9_main.build_tree(sc, v, field, k_bar, k_titel,
            k_karte, k_over, k_notiz, k_list, k_line, k_even, k_accent,
            texts)
        tb[i] = now_ms() - a
        i = i + 1
    }
    let g_build: f64 = median(&tb[0], rounds)
    a11y.a11y_reset(ax)
    gallery9_main.beschreibe_barrierefrei(ax, sc, frame_box, texts)
    // one full frame first, so that caches are warm as in a running app
    canvas.canvas_clear(&cv, base)
    scene.scene_run(sc, &c, sh, 0.0, 0.0, fw, fh)
    let g_style: f64 = t_style(sc, sh, rounds)
    let g_measure: f64 = t_measure(sc, &c, rounds)
    let g_layout: f64 = t_layout(sc, &c, fw, fh, rounds)
    let g_clear: f64 = t_clear(&cv, base, rounds)
    let g_draw: f64 = t_draw(sc, &c, &cv, base, rounds)
    var g_hits: usize = 0
    let g_hit: f64 = t_hit(sc, px, py, rounds, &g_hits)
    let g_find: f64 = t_find(sc, gallery9_main.ID_ACTIVE, rounds)
    sheet.sheet_add(q1, sheet.sel_within_class(sheet.sel_kind(
                widget.KIND_BUTTON), k_bar), sheet.decl_new())
    var g_qn: usize = 0
    let g_query: f64 = t_query(sc, q1, qout, rounds, &g_qn)
    var g_bytes: usize = 0
    let g_dump: f64 = t_dump(sc, ax, dbuf, dcap, rounds, &g_bytes)
    var g_missing: usize = 0
    let g_unnamed: f64 = t_unnamed(sc, ax, rounds, &g_missing)
    if scene.scene_overflow_reason(sc) != scene.OF_NONE {
        incomplete = incomplete + 1
    }
    say("apptree tree=gallery9 nodes=")
    say_int(scene.scene_count(sc) as u64)
    say(" controls=")
    say_int(a11y.a11y_widgets(sc, ax) as u64)
    say(" build_us=")
    say_num(g_build * 1000.0)
    say(" style_us=")
    say_num(g_style * 1000.0)
    say(" measure_us=")
    say_num(g_measure * 1000.0)
    say(" layout_us=")
    say_num(g_layout * 1000.0)
    say(" draw_us=")
    say_num(g_draw * 1000.0)
    say(" clear_us=")
    say_num(g_clear * 1000.0)
    say(" hit_ns=")
    say_int(g_hit as u64)
    say(" hits=")
    say_int(g_hits as u64)
    say(" find_ns=")
    say_int(g_find as u64)
    say(" query_us=")
    say_num(g_query)
    say(" query_hits=")
    say_int(g_qn as u64)
    say(" dump_us=")
    say_num(g_dump)
    say(" dump_bytes=")
    say_int(g_bytes as u64)
    say(" unnamed_us=")
    say_num(g_unnamed)
    say(" unnamed=")
    say_int(g_missing as u64)
    say(" reason=")
    say_int(scene.scene_overflow_reason(sc) as u64)
    say(" pix=")
    say_int(pixel_sum(&cv, width * height * 4))
    say("\n")

    // ============================================ B. SYNTHETIC APP TREES
    let st: u64 = rt.heap_alloc(64)
    var s_lab: [u8; 10] = "Row label "
    var s_btn: [u8; 4] = "Open"
    var s_chk: [u8; 5] = "Check"
    rt.mem_copy(st, (&s_lab[0]) as u64, 10)
    rt.mem_copy(st + 16 as u64, (&s_btn[0]) as u64, 4)
    rt.mem_copy(st + 32 as u64, (&s_chk[0]) as u64, 5)
    sheet.sheet_add(q2, sheet.sel_within_class(sheet.sel_kind(
                widget.KIND_CHECKBOX), k_karte), sheet.decl_new())
    // rows so that the node count lands near 16, 32, 64, 128, 256, 512
    // and 1024 -- as far as max_nodes allows.
    var sizes: [usize; 7] = [3, 7, 15, 30, 62, 124, 248]
    var si: usize = 0
    while si < 7 {
        let rows: usize = sizes[si]
        si = si + 1
        if synth_nodes(rows) > max_nodes {
            continue
        }
        var tbs: [f64; 64] = [0.0; 64]
        var maxid: u32 = 0 as u32
        i = 0
        while i < rounds {
            let a: f64 = now_ms()
            maxid = build_synth(sc, rows, k_karte, k_line, k_even, k_accent,
                st)
            tbs[i] = now_ms() - a
            i = i + 1
        }
        let s_build: f64 = median(&tbs[0], rounds)
        a11y.a11y_reset(ax)
        canvas.canvas_clear(&cv, base)
        scene.scene_run(sc, &c, sh, 0.0, 0.0, fw, fh)
        let s_style: f64 = t_style(sc, sh, rounds)
        let s_measure: f64 = t_measure(sc, &c, rounds)
        let s_layout: f64 = t_layout(sc, &c, fw, fh, rounds)
        let s_draw: f64 = t_draw(sc, &c, &cv, base, rounds)
        let s_pix: u64 = pixel_sum(&cv, width * height * 4)
        // the same paint without culling (scene_set_cull), same octets
        scene.scene_set_cull(sc, false)
        let s_draw_all: f64 = t_draw(sc, &c, &cv, base, rounds)
        if pixel_sum(&cv, width * height * 4) != s_pix {
            say("apptree: WRONG -- culling changed the picture\n")
            incomplete = incomplete + 1
        }
        scene.scene_set_cull(sc, true)
        // the reference: every node's size, place and style without memo
        let nn: usize = scene.scene_count(sc)
        let ref_g: *mut f64 = rt.heap_alloc(nn * 6 * 8) as *mut f64
        let ref_s: u64 = rt.heap_alloc(nn * ssz)
        snap_tree(sc, ref_g, ref_s, ssz)
        // the memo (scene_attach_memo): style, measure and layout of a tree
        // done before
        scene.memo_clear(memo)
        scene.scene_attach_memo(sc, memo)
        maxid = build_synth(sc, rows, k_karte, k_line, k_even, k_accent, st)
        scene.scene_style(sc, sh)
        scene.scene_measure(sc, &c)
        scene.scene_layout(sc, &c, 0.0, 0.0, fw, fh)
        let s_memo: f64 = t_measure(sc, &c, rounds)
        let s_smemo: f64 = t_style(sc, sh, rounds)
        let s_lmemo: f64 = t_layout(sc, &c, fw, fh, rounds)
        // rebuilt from scratch with the memo: the same tree as without
        let bad: usize = diff_tree(sc, ref_g, ref_s, ssz)
        if bad != 0 {
            say("apptree: WRONG -- the memo changed ")
            say_int(bad as u64)
            say(" nodes (size, place or style)\n")
            incomplete = incomplete + 1
        }
        canvas.canvas_clear(&cv, base)
        scene.scene_draw(sc, &c)
        if pixel_sum(&cv, width * height * 4) != s_pix {
            say("apptree: WRONG -- the memo changed the picture\n")
            incomplete = incomplete + 1
        }
        // A FRAME OF AN APP: rebuild the tree, one row hovered (a new one
        // each frame), then style, measure and layout -- with the memo.
        var tfr: [f64; 64] = [0.0; 64]
        var tfr0: [f64; 64] = [0.0; 64]
        i = 0
        while i < rounds {
            let a: f64 = now_ms()
            maxid = build_synth(sc, rows, k_karte, k_line, k_even, k_accent,
                st)
            scene.node_set_state(sc, (7 * i + 3) % scene.scene_count(sc),
                style.STATE_HOVER)
            scene.scene_style(sc, sh)
            scene.scene_measure(sc, &c)
            scene.scene_layout(sc, &c, 0.0, 0.0, fw, fh)
            tfr[i] = now_ms() - a
            i = i + 1
        }
        let s_frame: f64 = median(&tfr[0], rounds)
        let s_lh: usize = scene.memo_layout_hits(memo)
        // the last memo frame (one row hovered) is kept to compare with the
        // same frame done without memo
        snap_tree(sc, ref_g, ref_s, ssz)
        scene.scene_attach_memo(sc, 0 as *mut scene.Memo)
        // the same frame without memo
        i = 0
        while i < rounds {
            let a: f64 = now_ms()
            maxid = build_synth(sc, rows, k_karte, k_line, k_even, k_accent,
                st)
            scene.node_set_state(sc, (7 * i + 3) % scene.scene_count(sc),
                style.STATE_HOVER)
            scene.scene_style(sc, sh)
            scene.scene_measure(sc, &c)
            scene.scene_layout(sc, &c, 0.0, 0.0, fw, fh)
            tfr0[i] = now_ms() - a
            i = i + 1
        }
        let s_frame0: f64 = median(&tfr0[0], rounds)
        let bad2: usize = diff_tree(sc, ref_g, ref_s, ssz)
        if bad2 != 0 {
            say("apptree: WRONG -- a hovered frame with memo differs in ")
            say_int(bad2 as u64)
            say(" nodes from the same frame without\n")
            incomplete = incomplete + 1
        }
        maxid = build_synth(sc, rows, k_karte, k_line, k_even, k_accent, st)
        scene.scene_style(sc, sh)
        scene.scene_measure(sc, &c)
        scene.scene_layout(sc, &c, 0.0, 0.0, fw, fh)
        var s_hits: usize = 0
        let s_hit: f64 = t_hit(sc, px, py, rounds, &s_hits)
        let s_find: f64 = t_find(sc, maxid, rounds)
        var s_qn: usize = 0
        let s_query: f64 = t_query(sc, q2, qout, rounds, &s_qn)
        var s_bytes: usize = 0
        let s_dump: f64 = t_dump(sc, ax, dbuf, dcap, rounds, &s_bytes)
        var s_missing: usize = 0
        let s_unnamed: f64 = t_unnamed(sc, ax, rounds, &s_missing)
        if scene.scene_overflow_reason(sc) != scene.OF_NONE {
            incomplete = incomplete + 1
        }
        say("apptree tree=synth nodes=")
        say_int(scene.scene_count(sc) as u64)
        say(" controls=")
        say_int(a11y.a11y_widgets(sc, ax) as u64)
        say(" build_us=")
        say_num(s_build * 1000.0)
        say(" style_us=")
        say_num(s_style * 1000.0)
        say(" measure_us=")
        say_num(s_measure * 1000.0)
        say(" layout_us=")
        say_num(s_layout * 1000.0)
        say(" draw_us=")
        say_num(s_draw * 1000.0)
        say(" draw_nocull_us=")
        say_num(s_draw_all * 1000.0)
        say(" measure_memo_us=")
        say_num(s_memo * 1000.0)
        say(" style_memo_us=")
        say_num(s_smemo * 1000.0)
        say(" layout_memo_us=")
        say_num(s_lmemo * 1000.0)
        say(" frame_us=")
        say_num(s_frame0 * 1000.0)
        say(" frame_memo_us=")
        say_num(s_frame * 1000.0)
        say(" layout_hits=")
        say_int(s_lh as u64)
        say(" hit_ns=")
        say_int(s_hit as u64)
        say(" hits=")
        say_int(s_hits as u64)
        say(" find_ns=")
        say_int(s_find as u64)
        say(" query_us=")
        say_num(s_query)
        say(" query_hits=")
        say_int(s_qn as u64)
        say(" dump_us=")
        say_num(s_dump)
        say(" dump_bytes=")
        say_int(s_bytes as u64)
        say(" unnamed_us=")
        say_num(s_unnamed)
        say(" unnamed=")
        say_int(s_missing as u64)
        say(" reason=")
        say_int(scene.scene_overflow_reason(sc) as u64)
        say(" pix=")
        say_int(pixel_sum(&cv, width * height * 4))
        say("\n")
    }
    if incomplete > 0 {
        say("apptree: WRONG -- a tree was incomplete (see reason=)\n")
        return 1
    }
    return 0
}
