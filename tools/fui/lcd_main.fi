// SPDX-License-Identifier: MPL-2.0
// tools/fui/lcd_main.fi -- LCD subpixel text in the painter (fUi W18, r256).
//
//     lcd <font.ttf>
//
// Off by default: grey pixels only. On: coloured fringes at the edges, the same total
// ink as the grey picture (within 12 %), the clip is respected.
import std.rt
import paint.canvas
import font.metrics
import font.ttf
import fui.painter

const FONTSET_BYTES: usize = 4096
const CW: usize = 400
const CH: usize = 80
const BG: u32 = 0xff202020
static mut FAILS: usize = 0

fn expect(id: i64, got: i64, want: i64) {
    if got != want {
        FAILS = FAILS + 1
        var t: rt.Buf = rt.buf_new()
        var a: [u8; 11] = "FAIL check "
        rt.buf_push_bytes(&t, (&a[0]) as u64, 11)
        rt.buf_push_dec_i64(&t, id)
        var b: [u8; 6] = " got  "
        rt.buf_push_bytes(&t, (&b[0]) as u64, 6)
        rt.buf_push_dec_i64(&t, got)
        var c: [u8; 6] = " want "
        rt.buf_push_bytes(&t, (&c[0]) as u64, 6)
        rt.buf_push_dec_i64(&t, want)
        rt.buf_push(&t, 10 as u8)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
    }
}

fn load_set(path: u64) -> u64 {
    var fbuf: rt.Buf = rt.buf_new()
    if !rt.read_file(path, &fbuf) {
        return 0
    }
    let fsp: *mut metrics.FontSet = rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    *fsp = metrics.fontset_new()
    if !metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
        return 0
    }
    return fsp as u64
}

// Total ink (sum of the green channel above the background) and the number of
// pixels whose channels disagree (a colour fringe).
fn measure(cv: *mut canvas.Canvas, x0: usize, x1: usize, fringe: *mut i64) -> i64 {
    var sum: i64 = 0
    *fringe = 0
    var x: usize = x0
    while x < x1 && x < CW {
        var y: usize = 0
        while y < CH {
            let c: u32 = canvas.canvas_get(cv, x, y)
            let r8: i64 = ((c >> 16 as u32) & 255 as u32) as i64
            let g8: i64 = ((c >> 8 as u32) & 255 as u32) as i64
            let b8: i64 = (c & 255 as u32) as i64
            sum = sum + g8 - 32
            var d: i64 = r8 - b8
            if d < 0 { d = 0 - d }
            if d > 24 {
                *fringe = *fringe + 1
            }
            y = y + 1
        }
        x = x + 1
    }
    return sum
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 2
    }
    let m: u64 = load_set(rt.arg_ptr(start, 1))
    if m == 0 {
        return 3
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, CW, CH) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, CW, CH) {
        return 5
    }
    painter.painter_set_font(&z, m)
    var r: painter.TextRun = painter.run_new(16.0)
    var s: [u8; 14] = "Hamburgefonts."
    let sp: u64 = (&s[0]) as u64
    var fr: i64 = 0
    expect(1, // default is off
        painter.painter_lcd() as i64, 0)
    canvas.canvas_clear(&cv, BG)
    painter.run_draw(&z, &r, 10.0, 40.0, 380.0, 0xffffffff as u32, sp, 14, 0 as u32)
    let grey: i64 = measure(&cv, 0, CW, &fr)
    expect(2, // grey: no fringe
        fr, 0)
    painter.painter_set_lcd(true)
    canvas.canvas_clear(&cv, BG)
    painter.run_draw(&z, &r, 10.0, 40.0, 380.0, 0xffffffff as u32, sp, 14, 0 as u32)
    let lcd: i64 = measure(&cv, 0, CW, &fr)
    expect(3, // fringes
        (fr > 40) as i64, 1)
    expect(4, // ink within 12 % of grey
        (lcd * 100 > grey * 88 && lcd * 100 < grey * 112) as i64, 1)
    // the clip
    canvas.canvas_clear(&cv, BG)
    canvas.clip_push_rect(&cv, 0.0, 0.0, 40.0, 80.0)
    painter.run_draw(&z, &r, 10.0, 40.0, 380.0, 0xffffffff as u32, sp, 14, 0 as u32)
    canvas.clip_pop(&cv)
    var fr2: i64 = 0
    let right: i64 = measure(&cv, 42, CW, &fr2)
    expect(5, // nothing right of the clip
        right, 0)
    painter.painter_set_lcd(false)
    var ok: [u8; 17] = "lcd checks done\n\n"
    rt.write_everything(1, (&ok[0]) as u64, 16)
    if FAILS > 0 {
        return 1
    }
    return 0
}
