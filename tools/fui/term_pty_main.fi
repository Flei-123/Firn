import std.rt
import term.pty
import term.term
import term.termstate
import term.termgrid
import term.termtext

const READ_CAP: usize = 4096
const POLL_ROUNDS: usize = 600

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }

fn pump(p: *mut pty.Pty, t: *mut termstate.Term) {
    let buf: u64 = rt.heap_alloc(READ_CAP)
    var rounds: usize = 0
    var idle: usize = 0
    while rounds < POLL_ROUNDS && idle < 40 {
        let n: i64 = pty.pty_read(p, buf, READ_CAP)
        if n > 0 {
            term.term_feed(t, buf, n as usize)
            idle = 0
        } else if n < 0 {
            rounds = POLL_ROUNDS
        } else {
            idle = idle + 1
            var ts: [i64; 2] = [0, 5000000]
            syscall(35, (&ts[0]) as i64, 0, 0, 0, 0, 0)
        }
        rounds = rounds + 1
    }
    rt.heap_free(buf, READ_CAP)
}

fn screen_has(t: *mut termstate.Term, want: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    termtext.screen_text(term.term_grid(t), &b)
    var found: bool = false
    var i: usize = 0
    while !found && i + want.n <= rt.buf_len(&b) {
        found = rt.mem_eq(rt.buf_ptr(&b) + i as u64, want.p as u64, want.n)
        i = i + 1
    }
    rt.buf_free(&b)
    return found
}

fn main() -> i32 {
    if !pty.pty_supported() {
        say("term_pty: no pty on this target, skipped\n")
        return 0
    }
    var p: pty.Pty = pty.Pty { fd: 0 - 1, pid: 0 - 1, exited: true }
    let t: *mut termstate.Term = term.term_new(40, 5, 10)
    if !pty.pty_open(&p, "/bin/sh\0-c\0echo hello-pty; stty size; exit 3\0", 40, 5) {
        say("term_pty: WRONG open\n")
        return 1
    }
    pump(&p, t)
    var bad: i32 = 0
    if !screen_has(t, "hello-pty") { say("  WRONG echo output\n")
        bad = 1 }
    if !screen_has(t, "5 40") { say("  WRONG window size seen by child\n")
        bad = 1 }
    var tries: usize = 0
    while pty.pty_alive(&p) && tries < 100 { tries = tries + 1 }
    if pty.pty_alive(&p) { say("  WRONG child still alive\n")
        bad = 1 }
    pty.pty_close(&p)
    term.term_free(t)
    if bad == 0 { say("term_pty: all checks passed\n") }
    return bad
}
