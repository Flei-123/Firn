// SPDX-License-Identifier: MPL-2.0
// tools/fui/wrapgrow_main.fi -- a wrapping row that GROWS after set_text must push the rows below it (a65, Jarvis "Mehr" chips),
// and an entry keeps its hint even when the buffer the caller passed is overwritten (a65, Jarvis "Chats suchen ..." ghost).
//     firnc -o /tmp/wrapgrow tools/fui/wrapgrow_main.fi && /tmp/wrapgrow [dir-for-pngs]
import std.rt
import fui.safeout
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.painter
import fui.scene
import fui.app
import fui.applay
import plat.fuiwirt
import plat.sysfont
import fui.apphost

static mut BAD: usize = 0
static mut FONT: u64 = 0

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }
fn check(ok: bool, what: str) {
    if ok { say("  ok    ") } else { say("  WRONG "); BAD = BAD + 1 }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h) || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn save(s: *mut Surface, dir: u64, name: str) {
    if dir == 0 { return }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(&(*s).cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 { dir = rt.arg_ptr(start, 1) }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("wrapgrow: no font\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("wrap", 300, 400)
    let r0: usize = applay.hrow(a)
    let b0: usize = app.button(a, "Autonom: ...", 0 as u64 as fn(*mut app.App))
    let b1: usize = app.button(a, "Tiefen: ...", 0 as u64 as fn(*mut app.App))
    app.end(a)
    let r1: usize = applay.hrow(a)
    let b2: usize = app.button(a, "Experiment: ...", 0 as u64 as fn(*mut app.App))
    let b3: usize = app.button(a, "Lern: ...", 0 as u64 as fn(*mut app.App))
    app.end(a)
    let r2: usize = applay.hrow(a)
    let b4: usize = app.button(a, "Plan: ...", 0 as u64 as fn(*mut app.App))
    app.end(a)
    // an entry whose hint is a TRANSIENT buffer (like texts.tr)
    let tmp: u64 = rt.heap_alloc(64)
    rt.mem_copy(tmp, "Neue Aufgabe (Text)".p as u64, 19)
    let e: usize = app.entry(a, str { p: tmp as *mut u8, n: 19 })
    rt.mem_set(tmp, 88 as u8, 64) // the caller reuses the buffer
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 300, 400)
    frame(a, s)
    save(s, dir, "wrapgrow-0.png")
    let sc: *mut scene.Scene = app.app_scene(a)
    let y2a: f64 = scene.node_y(sc, r2)
    let h1a: f64 = scene.node_h(sc, r1)
    app.set_text(a, b0, "Autonom: an")
    app.set_text(a, b1, "Tiefen-Modus: an")
    app.set_text(a, b2, "Experimentier-Modus: an")
    app.set_text(a, b3, "Lern-Modus: aus")
    app.set_text(a, b4, "Plan-Modus: aus")
    frame(a, s)
    frame(a, s)
    save(s, dir, "wrapgrow-1.png")
    let y1: f64 = scene.node_y(sc, r1)
    let h1: f64 = scene.node_h(sc, r1)
    let y2: f64 = scene.node_y(sc, r2)
    check(h1 > h1a + 1.0, "the wrapped row got taller after set_text")
    check(y2 >= y1 + h1 - 0.5, "the row below starts under the grown row (no overlap)")
    check(y2 > y2a + 1.0, "the row below moved down")
    check(scene.node_y(sc, r1) >= scene.node_y(sc, r0) + scene.node_h(sc, r0) - 0.5, "row 1 stays below row 0")
    if BAD == 0 {
        say("WRAPGROW PASSED\n")
        return 0
    }
    say("WRAPGROW FAILED\n")
    return 1
}
