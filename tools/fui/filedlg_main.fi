// SPDX-License-Identifier: MPL-2.0
// tools/fui/filedlg_main.fi -- THE CHECK OF lib/fui/filedlg.fi (the file dialog), WITHOUT A WINDOW.
//
// It builds the dialog on a real directory tree (made by tools/dialog/filedlg_run.sh), drives it with synthetic
// pointer / key / character events through the same entry points a platform host calls (fuiwirt.host_pointer,
// app.app_key, app.app_char), paints into canvases and checks state, result and PIXELS.
//
//     filedlg_main <tree-dir> [perm] [pngdir]
//
//     perm     only the checks that need a folder the user may not read (run as an unprivileged user)
//     pngdir   where the proof pictures are written
//
// Lines: `  ok  what` / `  WRONG  what`, `FRAME_MS <state> <ms>` for the timings, and a last line
// FILEDLG PASSED or FILEDLG FAILED.
import std.rt
import std.fs
import std.env
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import fui.style
import fui.render
import fui.event
import fui.action
import fui.ctxmenu
import fui.a11y
import plat.fuiwirt
import plat.sysfont
import fui.app
import fui.filemodel
import fui.filedlg

static mut BAD: usize = 0
static mut CHECKS: usize = 0
static mut FONT: u64 = 0
static mut ROOT: u64 = 0
static mut PNGDIR: u64 = 0
static mut CLOCK_T: i64 = 100000
static mut PB: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_num(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok     ")
    } else {
        say("  WRONG  ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn now_ms() -> f64 {
    var ts: [u64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as u64)
    return (ts[0] as f64) * 1000.0 + (ts[1] as f64) / 1000000.0
}

fn same(a: str, b: str) -> bool {
    return filemodel.str_eq(a, b)
}

// ROOT/<rel> as a string view (valid until the next call).
fn pin(rel: str) -> str {
    if PB == 0 {
        PB = rt.heap_alloc(64)
        *(PB as *mut rt.Buf) = rt.buf_new()
    }
    let b: *mut rt.Buf = PB as *mut rt.Buf
    rt.buf_clear(b)
    rt.buf_push_bytes(b, ROOT, rt.c_length(ROOT))
    if rel.n > 0 {
        rt.buf_push(b, 47 as u8)
        rt.buf_push_bytes(b, rel.p as u64, rel.n)
    }
    return filemodel.buf_str(b)
}

// ------------------------------------------------------------ the rig: a dialog with a surface

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

struct Rig {
    d: *mut filedlg.Dlg,
    a: *mut app.App,
    s: *mut Surface,
    out: rt.Buf,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h) || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

static mut CLK: i64 = 1000

fn frame(r: *mut Rig) {
    let a: *mut app.App = (*r).a
    app.app_paint(a as u64, (*r).w, (*r).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
    var n: usize = 0
    while fuiwirt.host_dirty(app.app_host(a)) && n < 6 {
        CLK = CLK + 1000
        fuiwirt.host_tick(app.app_host(a), CLK)
        app.app_paint(a as u64, (*r).w, (*r).h)
        fuiwirt.host_painted(app.app_host(a))
        n = n + 1
    }
}

fn save(r: *mut Rig, name: str) {
    if PNGDIR == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, PNGDIR, rt.c_length(PNGDIR))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(&(*(*r).s).cv, &out) {
        let ok: bool = rt.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

fn mk(mode: i32, dir: str, name: str, filters: str, w: usize, h: usize) -> *mut Rig {
    let r: *mut Rig = rt.heap_alloc(4096) as *mut Rig
    (*r).out = rt.buf_new()
    (*r).w = w
    (*r).h = h
    (*r).d = filedlg.dlg_new(mode, "dlg-test", dir, name, filters, &(*r).out)
    (*r).a = filedlg.dlg_app((*r).d)
    fuiwirt.host_bind(app.app_host((*r).a))
    (*r).s = surface_for((*r).a, w, h)
    frame(r)
    return r
}

// What the platform host does after an event: hand the activated node on.
fn settle(r: *mut Rig) {
    let a: *mut app.App = (*r).a
    var n: usize = 0
    while n < 4 {
        let i: usize = fuiwirt.host_take_activated(app.app_host(a))
        if i == fuiwirt.KEINER {
            break
        }
        app.app_act(a as u64, i)
        n = n + 1
    }
}

fn node_cx(r: *mut Rig, n: usize) -> f64 {
    let sc: *mut scene.Scene = app.app_scene((*r).a)
    return scene.node_x(sc, n) + scene.node_w(sc, n) / 2.0
}

fn node_cy(r: *mut Rig, n: usize) -> f64 {
    let sc: *mut scene.Scene = app.app_scene((*r).a)
    return scene.node_y(sc, n) + scene.node_h(sc, n) / 2.0
}

fn m_move(r: *mut Rig, x: f64, y: f64) {
    let w: *mut fuiwirt.Host = app.app_host((*r).a)
    CLOCK_T = CLOCK_T + 5
    let c: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_MOVE, 1 as u32, event.PT_MOUSE, true, x, y, CLOCK_T)
}

fn m_down(r: *mut Rig, x: f64, y: f64, mods: u32) {
    let w: *mut fuiwirt.Host = app.app_host((*r).a)
    fuiwirt.host_set_mods(w, mods)
    CLOCK_T = CLOCK_T + 5
    let c: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_DOWN, 1 as u32, event.PT_MOUSE, true, x, y, CLOCK_T)
}

fn m_up(r: *mut Rig, x: f64, y: f64) {
    let w: *mut fuiwirt.Host = app.app_host((*r).a)
    CLOCK_T = CLOCK_T + 5
    let c: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 1 as u32, event.PT_MOUSE, true, x, y, CLOCK_T)
}

// One click: move, press, release; the activation is collected like the host does.
fn click(r: *mut Rig, x: f64, y: f64, mods: u32) {
    CLOCK_T = CLOCK_T + 1000
    m_move(r, x, y)
    m_down(r, x, y, mods)
    m_up(r, x, y)
    settle(r)
    frame(r)
}

fn dclick(r: *mut Rig, x: f64, y: f64) {
    CLOCK_T = CLOCK_T + 1000
    m_move(r, x, y)
    m_down(r, x, y, 0 as u32)
    m_up(r, x, y)
    CLOCK_T = CLOCK_T + 80
    m_down(r, x, y, 0 as u32)
    m_up(r, x, y)
    settle(r)
    frame(r)
}

fn click_node(r: *mut Rig, n: usize) {
    click(r, node_cx(r, n), node_cy(r, n), 0 as u32)
}

fn wheel(r: *mut Rig, x: f64, y: f64, notches: i64) {
    let w: *mut fuiwirt.Host = app.app_host((*r).a)
    m_move(r, x, y)
    var i: i64 = 0
    var btn: u32 = fuiwirt.BTN_WHEEL_DOWN
    var k: i64 = notches
    if notches < 0 {
        btn = fuiwirt.BTN_WHEEL_UP
        k = 0 - notches
    }
    while i < k {
        let c: u32 = fuiwirt.host_pointer_down(w, x, y, btn)
        i = i + 1
    }
    frame(r)
}

fn host_key_of(ek: u32) -> u32 {
    if ek == editor.KEY_TAB { return fuiwirt.KEY_TAB }
    if ek == editor.KEY_ENTER { return fuiwirt.KEY_RETURN }
    if ek == editor.KEY_UP { return fuiwirt.KEY_UP }
    if ek == editor.KEY_DOWN { return fuiwirt.KEY_DOWN }
    if ek == editor.KEY_LEFT { return fuiwirt.KEY_LEFT }
    if ek == editor.KEY_RIGHT { return fuiwirt.KEY_RIGHT }
    if ek == editor.KEY_PGUP { return fuiwirt.KEY_PAGE_UP }
    if ek == editor.KEY_PGDN { return fuiwirt.KEY_PAGE_DOWN }
    if ek == editor.KEY_HOME { return fuiwirt.KEY_HOME }
    if ek == editor.KEY_END { return fuiwirt.KEY_END }
    if ek == editor.KEY_ESC { return fuiwirt.KEY_ESCAPE }
    return 0 as u32
}

// A key as the X11 host delivers it: the program first, then the host's own handling.
fn key(r: *mut Rig, ek: u32, mods: u32) {
    let a: *mut app.App = (*r).a
    let w: *mut fuiwirt.Host = app.app_host(a)
    fuiwirt.host_set_mods(w, mods)
    if !app.app_key(a as u64, ek, mods) {
        let hk: u32 = host_key_of(ek)
        if hk != (0 as u32) {
            let c: u32 = fuiwirt.host_key(w, hk, mods)
        }
    }
    settle(r)
    frame(r)
}

fn chr(r: *mut Rig, cp: u32, mods: u32) {
    let a: *mut app.App = (*r).a
    let w: *mut fuiwirt.Host = app.app_host(a)
    fuiwirt.host_set_mods(w, mods)
    if !app.app_char(a as u64, cp, mods) {
        let c: u32 = fuiwirt.host_char(w, cp, mods)
    }
    settle(r)
    frame(r)
}

fn type_s(r: *mut Rig, t: str) {
    var i: usize = 0
    while i < t.n {
        chr(r, rt.ld8(t.p as u64, i) as u32, 0 as u32)
        i = i + 1
    }
}

// ------------------------------------------------------------ readers

fn d_of(r: *mut Rig) -> *mut filedlg.Dlg { return (*r).d }

fn cur_path(r: *mut Rig) -> str {
    return filemodel.model_path(&(*(*r).d).m)
}

fn count(r: *mut Rig) -> usize {
    return filemodel.model_count(&(*(*r).d).m)
}

fn name_at(r: *mut Rig, k: usize) -> str {
    return filemodel.model_name(&(*(*r).d).m, filedlg.ent_of_view((*r).d, k))
}

// The first `n` names of the view joined by "," (n = 0: all).
fn names(r: *mut Rig, from: usize, n: usize) -> str {
    var b: u64 = rt.heap_alloc(64)
    *(b as *mut rt.Buf) = rt.buf_new()
    let bb: *mut rt.Buf = b as *mut rt.Buf
    var k: usize = from
    var c: usize = 0
    while k < count(r) && (n == 0 || c < n) {
        if c > 0 {
            rt.buf_push(bb, 44 as u8)
        }
        filemodel.push_str(bb, name_at(r, k))
        k = k + 1
        c = c + 1
    }
    return filemodel.buf_str(bb)
}

fn find_row(r: *mut Rig, name: str) -> usize {
    return filemodel.model_find_name(&(*(*r).d).m, name)
}

fn row_cx(r: *mut Rig, k: usize) -> f64 {
    return filedlg.list_x((*r).d) + 160.0
}

fn row_cy(r: *mut Rig, k: usize) -> f64 {
    return filedlg.list_row_y((*r).d, k) + filedlg.list_row_h((*r).d) / 2.0
}

fn click_row(r: *mut Rig, k: usize, mods: u32) {
    click(r, row_cx(r, k), row_cy(r, k), mods)
}

fn dclick_row(r: *mut Rig, k: usize) {
    dclick(r, row_cx(r, k), row_cy(r, k))
}

fn status(r: *mut Rig) -> str { return filedlg.status_text((*r).d) }

fn has_sub(h: str, n: str) -> bool {
    if n.n > h.n { return false }
    var i: usize = 0
    while i + n.n <= h.n {
        if same(str { p: ((h.p as u64) + i as u64) as *mut u8, n: n.n }, n) {
            return true
        }
        i = i + 1
    }
    return false
}

fn out_text(r: *mut Rig) -> str {
    return filemodel.buf_str(&(*r).out)
}

fn px(r: *mut Rig, x: f64, y: f64) -> u32 {
    return canvas.canvas_get(&(*(*r).s).cv, x as usize, y as usize) & (16777215 as u32)
}

fn col_of(r: *mut Rig, tok: u32) -> u32 {
    let f: *mut theme.Colors = theme.theme_colors(app.app_theme((*r).a))
    if tok == style.TOK_FIELD { return (*f).field & (16777215 as u32) }
    if tok == style.TOK_BASE { return (*f).base & (16777215 as u32) }
    if tok == style.TOK_SELECTION { return (*f).selection & (16777215 as u32) }
    if tok == style.TOK_BUTTON_HOVER { return (*f).button_hover & (16777215 as u32) }
    if tok == style.TOK_BUTTON_ACTIVE { return (*f).button_active & (16777215 as u32) }
    if tok == style.TOK_ACCENT { return (*f).accent & (16777215 as u32) }
    if tok == style.TOK_SURFACE { return (*f).surface & (16777215 as u32) }
    return 0 as u32
}

// ============================================================ 1. THE MODEL (filemodel.fi, no window)

fn sec_model() {
    say("== model: patterns, filter strings, paths, text\n")
    check(filemodel.glob_match("A.PNG", "*.png"), "glob: *.png matches A.PNG (case does not matter)")
    check(!filemodel.glob_match("a.png.bak", "*.png"), "glob: *.png does not match a.png.bak")
    check(filemodel.glob_match("readme", "readme"), "glob: an exact name matches itself")
    check(filemodel.glob_match("Makefile", "*"), "glob: * matches everything")
    check(filemodel.glob_match("a1.txt", "a?.txt"), "glob: ? is one byte")
    check(!filemodel.glob_match("a12.txt", "a?.txt"), "glob: ? is only one byte")
    check(filemodel.glob_match("x.tar.gz", "*.tar.*"), "glob: two wildcards")
    let f: str = "Images|*.png;*.jpg|Text|*.txt|All|*"
    check(filemodel.filters_count(f) == 3, "filter string: three pairs")
    check(same(filemodel.filter_label(f, 1), "Text"), "filter string: the label of pair 1")
    check(same(filemodel.filter_pats(f, 0), "*.png;*.jpg"), "filter string: the patterns of pair 0")
    check(filemodel.filters_count("") == 0, "filter string: empty means everything")
    check(same(filemodel.default_ext("*.png"), ".png"), "default extension of *.png is .png")
    check(same(filemodel.default_ext("*.png;*.jpg"), ""), "no default extension for two patterns")
    check(same(filemodel.default_ext("*"), ""), "no default extension for *")
    var b: rt.Buf = rt.buf_new()
    filemodel.path_normalize("/a//b/./c/../d/", &b)
    check(same(filemodel.buf_str(&b), "/a/b/d"), "normalize: // . .. and the trailing slash")
    rt.buf_clear(&b)
    filemodel.path_normalize("/../..", &b)
    check(same(filemodel.buf_str(&b), "/"), "normalize: .. above the root stays at the root")
    rt.buf_clear(&b)
    filemodel.path_resolve("/home/j", "/home/j", "~/x", &b)
    check(same(filemodel.buf_str(&b), "/home/j/x"), "resolve: ~/x is below the home folder")
    rt.buf_clear(&b)
    filemodel.path_resolve("/srv/data", "/home/j", "sub/f.txt", &b)
    check(same(filemodel.buf_str(&b), "/srv/data/sub/f.txt"), "resolve: a relative name is relative to the open folder")
    rt.buf_clear(&b)
    filemodel.path_resolve("/srv/data", "/home/j", "/etc/../tmp/x", &b)
    check(same(filemodel.buf_str(&b), "/tmp/x"), "resolve: an absolute path is normalised")
    rt.buf_clear(&b)
    filemodel.fmt_size(0, &b)
    filemodel.push_str(&b, "|")
    filemodel.fmt_size(999, &b)
    filemodel.push_str(&b, "|")
    filemodel.fmt_size(1234, &b)
    filemodel.push_str(&b, "|")
    filemodel.fmt_size(5000000, &b)
    filemodel.push_str(&b, "|")
    filemodel.fmt_size(3200000000, &b)
    check(same(filemodel.buf_str(&b), "0 B|999 B|1.2 kB|5.0 MB|3.2 GB"), "sizes as text")
    check(filemodel.ext_icon("photo.PNG") == filemodel.IC_IMAGE, "icon class: .PNG is an image")
    check(filemodel.ext_icon("a.tar.gz") == filemodel.IC_ARCHIVE, "icon class: .gz is an archive")
    check(filemodel.ext_icon("main.fi") == filemodel.IC_TEXT, "icon class: .fi is text")
    check(filemodel.ext_icon(".bashrc") == filemodel.IC_FILE, "icon class: a dot file has no extension")
}

// ============================================================ 2. OPENING, NAVIGATION, SORT, FILTER

fn sec_navigation(dir: u64) {
    say("== open: the first look, navigation, sort, filter, hidden files\n")
    let r: *mut Rig = mk(0, pin(""), "", "Images|*.png;*.jpg|Text|*.txt|All|*", 780, 520)
    let d: *mut filedlg.Dlg = (*r).d
    save(r, "filedlg-open-rest.png")
    check(same(cur_path(r), pin("")), "the dialog opens in the folder it was given")
    // image filter first: the folders, then a.png B.PNG d.jpg
    check(same(names(r, 0, 0), "alpha,beta,big,link_dir,noaccess,zeta,a.png,B.PNG,d.jpg"),
        "the first filter shows all folders and only the images, folders first, names sorted without case")
    check((*d).mode == filedlg.MODE_OPEN, "mode 0 = open one")
    check(!(*d).ok_ready, "OK is grey while nothing is chosen")
    check(widget.w_is_disabled(scene.node_widget(app.app_scene((*r).a), (*d).n_ok)), "the OK button is disabled in the scene")
    check(filedlg.can_up(d) && !filedlg.can_back(d) && !filedlg.can_forward(d), "Up is possible, Back and Forward are not yet")
    check(app.audit((*r).a) == 0, "accessibility audit: every operable node has a name")
    // filter by menu
    filedlg.cb_filter((*r).a)
    check(ctxmenu.ctx_is_open(app.context((*r).a)), "the filter button opens a menu")
    let reg: *mut action.Actions = app.actions((*r).a)
    check(action.act_find(reg, "filter1") != action.ACT_NONE, "the filter menu has an entry per filter")
    let cx: action.ActCtx = action.actx_new((*r).a as u64)
    var cx2: action.ActCtx = cx
    let ok1: bool = action.act_run(reg, action.act_find(reg, "filter1"), &cx2)
    let cl: u32 = ctxmenu.ctx_close(app.context((*r).a), ctxmenu.CLOSE_API)
    frame(r)
    check(same(names(r, 0, 0), "alpha,beta,big,link_dir,noaccess,zeta,c.txt,existing.txt,Notes.TXT"),
        "filter 'Text' (*.txt): .TXT matches too, folders stay")
    filedlg.set_filter(d, 2)
    frame(r)
    check(same(names(r, 0, 0), "alpha,beta,big,link_dir,noaccess,zeta,a.png,B.PNG,broken,c.txt,d.jpg,existing.txt,link_file,Notes.TXT,x.bin"),
        "filter 'All': everything but the hidden files")
    check(count(r) == 15, "15 entries")
    check(has_sub(status(r), "15 items"), "the status line counts the items")
    // hidden files: Ctrl+H
    chr(r, 104 as u32, editor.MOD_CTRL)
    check(count(r) == 17 && find_row(r, ".hidden_file") != filemodel.NONE, "Ctrl+H shows the dot files")
    check(widget.w_value(scene.node_widget(app.app_scene((*r).a), (*d).n_hidden)) == 1, "the checkbox follows Ctrl+H")
    click_node(r, (*d).n_hidden)
    check(count(r) == 15, "a click on the checkbox hides them again")
    // sort: by header click
    let hx: f64 = filedlg.list_x(d) + 50.0
    let hy: f64 = filedlg.list_y(d) + 14.0
    click(r, hx, hy, 0 as u32)
    check(filemodel.model_sort_desc(&(*d).m) && filemodel.model_sort_col(&(*d).m) == 0, "a click on 'Name' flips to descending")
    check(same(names(r, 0, 6), "zeta,noaccess,link_dir,big,beta,alpha"), "descending names: the folders stay first")
    click(r, hx, hy, 0 as u32)
    check(!filemodel.model_sort_desc(&(*d).m), "a second click goes back to ascending")
    let sx: f64 = filedlg.col_size_x(d) + 30.0
    click(r, sx, hy, 0 as u32)
    check(filemodel.model_sort_col(&(*d).m) == 1 && same(names(r, 6, 0), "broken,d.jpg,Notes.TXT,a.png,link_file,existing.txt,c.txt,B.PNG,x.bin"),
        "sort by size ascending")
    click(r, sx, hy, 0 as u32)
    check(same(names(r, 6, 0), "x.bin,B.PNG,c.txt,existing.txt,a.png,link_file,Notes.TXT,d.jpg,broken"), "sort by size descending")
    let dx: f64 = filedlg.col_date_x(d) + 40.0
    click(r, dx, hy, 0 as u32)
    check(filemodel.model_sort_col(&(*d).m) == 2 && same(names(r, 6, 0), "broken,x.bin,d.jpg,a.png,link_file,c.txt,B.PNG,existing.txt,Notes.TXT"),
        "sort by date ascending (a broken link has no date and comes first)")
    click(r, dx, hy, 0 as u32)
    check(same(names(r, 6, 0), "Notes.TXT,existing.txt,B.PNG,c.txt,a.png,link_file,d.jpg,x.bin,broken"), "sort by date descending")
    check(count(r) >= 6 && (*filemodel.model_ent(&(*d).m, filemodel.model_view_ent(&(*d).m, 5))).dir
        && !(*filemodel.model_ent(&(*d).m, filemodel.model_view_ent(&(*d).m, 6))).dir, "under every sort the folders stay first")
    save(r, "filedlg-open-sorted.png")
    // back to the name order for the rest
    click(r, hx, hy, 0 as u32)

    // ---- navigation: into a folder by double click, Back, Forward, Up, Breadcrumb
    let k: usize = find_row(r, "alpha")
    check(k != filemodel.NONE, "alpha is listed")
    dclick_row(r, k)
    check(same(cur_path(r), pin("alpha")), "a double click on a folder opens it")
    check(same(names(r, 0, 0), "sub1,inner.txt"), "its content: the folder first")
    check(filedlg.can_back(d) && !filedlg.can_forward(d), "Back is possible now")
    check((*d).cr_n >= 2, "the place bar shows the path parts")
    filedlg.nav_back(d)
    frame(r)
    check(same(cur_path(r), pin("")), "Back returns")
    check(filedlg.can_forward(d), "Forward is possible after Back")
    key(r, editor.KEY_RIGHT, editor.MOD_ALT)
    check(same(cur_path(r), pin("alpha")), "Alt+Right goes forward")
    key(r, editor.KEY_UP, editor.MOD_ALT)
    check(same(cur_path(r), pin("")), "Alt+Up goes up")
    check(filemodel.model_name(&(*d).m, filedlg.ent_of_view(d, (*d).cur)).n == 5
        && same(filemodel.model_name(&(*d).m, filedlg.ent_of_view(d, (*d).cur)), "alpha"),
        "after Up the folder we came from is selected")
    key(r, editor.KEY_LEFT, editor.MOD_ALT)
    check(same(cur_path(r), pin("alpha")), "Alt+Left goes back")
    // breadcrumb: the crumb of the root
    let c0: usize = (*d).n_crumb[0]
    click_node(r, c0)
    check(same(cur_path(r), "/"), "a click on the first crumb ('/') goes to the root")
    check(has_sub(filemodel.model_path(&(*d).m), "/") && (*d).cr_n == 1, "at the root there is one crumb")
    // the last crumb of a deep path
    let ok2: bool = filedlg.nav_to(d, pin("alpha/sub1"), true, "")
    frame(r)
    let parts: usize = (*d).cr_n
    check(ok2 && parts >= 3, "a deep path has its parts as crumbs")
    let mid: usize = (*d).n_crumb[parts - 2]
    click_node(r, mid)
    check(same(cur_path(r), pin("alpha")), "a click on a middle crumb jumps there")
    check(filedlg.crumb_slot(d, (*d).n_crumb[0]) == 0, "crumb slots are found by node")
    // Backspace goes up in the list
    filedlg.set_focus(d, (*d).n_list)
    key(r, editor.KEY_BACKSPACE, 0 as u32)
    check(same(cur_path(r), pin("")), "Backspace in the list goes up")
    // the places
    let pl: usize = filedlg.place_current(d)
    check(pl != filemodel.NONE, "the open folder is a place (a recent folder) and is marked")
    check((*d).pl_n >= 2, "there are places: the root and the folders visited")
    click_node(r, (*d).n_place[(*d).pl_n - 1])
    frame(r)
    check(true, "a click on a place does not crash")
    // symlinks
    let ok3: bool = filedlg.nav_to(d, pin(""), true, "")
    frame(r)
    let lk: usize = find_row(r, "link_dir")
    check((*filemodel.model_ent(&(*d).m, filemodel.model_view_ent(&(*d).m, lk))).dir, "a link to a folder counts as a folder")
    dclick_row(r, lk)
    check(same(cur_path(r), pin("link_dir")) && same(names(r, 0, 0), "sub1,inner.txt"), "a link to a folder opens like a folder")
    let ok4: bool = filedlg.nav_to(d, pin(""), true, "")
    frame(r)
    let bl: usize = find_row(r, "broken")
    check(bl != filemodel.NONE, "a broken link is listed (and does not crash the listing)")
    click_row(r, bl, 0 as u32)
    key(r, editor.KEY_ENTER, 0 as u32)
    check(has_sub(status(r), "Broken link"), "Enter on a broken link says so in the status line")
    check(!(*d).done, "a broken link is not accepted")
    // errors: a folder that is not there, a file as a folder
    check(!filedlg.nav_to(d, pin("nowhere"), true, ""), "nav to a folder that does not exist fails")
    check(has_sub(status(r), "No such folder") && same(cur_path(r), pin("")), "... says so and stays where it was")
    check(!filedlg.nav_to(d, pin("c.txt"), true, ""), "nav to a file as a folder fails")
    check(has_sub(status(r), "Not a folder") && same(cur_path(r), pin("")), "... 'Not a folder', stays")
    check((*d).st_err, "the status is an error state (painted red)")
    save(r, "filedlg-error.png")
    // path field: Ctrl+L, a good path, a bad one
    chr(r, 108 as u32, editor.MOD_CTRL)
    check((*d).path_edit && filedlg.focus_of(d) == (*d).n_path, "Ctrl+L turns the bar into the path field and focuses it")
    save(r, "filedlg-pathedit.png")
    app.set_text((*r).a, (*d).n_path, pin("alpha/sub1"))
    key(r, editor.KEY_ENTER, 0 as u32)
    check(same(cur_path(r), pin("alpha/sub1")) && !(*d).path_edit, "Enter in the path field goes there and shows the crumbs again")
    chr(r, 108 as u32, editor.MOD_CTRL)
    app.set_text((*r).a, (*d).n_path, pin("alpha/sub1/nope/x"))
    key(r, editor.KEY_ENTER, 0 as u32)
    check((*d).path_edit && has_sub(status(r), "No such") && same(cur_path(r), pin("alpha/sub1")),
        "a bad path gives a red status instead of a crash, the field stays open")
    key(r, editor.KEY_ESC, 0 as u32)
    check(!(*d).path_edit && !(*d).done, "Esc leaves the path field (the dialog stays open)")
    // a click on the free part of the bar
    let lc: usize = (*d).n_loc
    let sc: *mut scene.Scene = app.app_scene((*r).a)
    click(r, scene.node_x(sc, lc) + scene.node_w(sc, lc) - 12.0, node_cy(r, lc), 0 as u32)
    check((*d).path_edit, "a click on the free part of the bar edits the path")
    check(filedlg.focus_of(d) == (*d).n_path, "... and the path field has the focus (not the click's blank target)")
    key(r, editor.KEY_ESC, 0 as u32)
    // a file typed into the path field: its folder opens and the file is selected
    chr(r, 108 as u32, editor.MOD_CTRL)
    app.set_text((*r).a, (*d).n_path, pin("alpha/inner.txt"))
    key(r, editor.KEY_ENTER, 0 as u32)
    check(same(cur_path(r), pin("alpha")) && same(name_at(r, (*d).cur), "inner.txt"), "a file in the path field: its folder opens, the file is selected")
    // refresh picks up a new file
    let rr: usize = count(r)
    let xs: str = "x"
    let wf: usize = fs.write_file(pin("alpha/fresh.txt"), xs.p as u64, 1) catch 0
    key(r, 100 as u32, 0 as u32)
    check(count(r) == rr + 1, "F5 reads the folder again")
    let rm: bool = fs.remove(pin("alpha/fresh.txt")) catch false
    filedlg.refresh(d)
    check(count(r) == rr, "Refresh sees the file gone")
}

// ============================================================ 3. THE LIST: SELECTION, KEYS, TYPE-TO-FIND, SCROLL

fn sec_list() {
    say("== list: selection, keys, multiple choice, type-to-find\n")
    let r: *mut Rig = mk(1, pin(""), "", "All|*", 780, 520)
    let d: *mut filedlg.Dlg = (*r).d
    check(filedlg.focus_of(d) == (*d).n_list, "the dialog starts with the list focused")
    let a: usize = find_row(r, "a.png")
    click_row(r, a, 0 as u32)
    check(filedlg.selected_count(d) == 1 && same(filedlg.name_text(d), "a.png"), "a click chooses the file and the name field shows it")
    check((*d).ok_ready, "OK is on now")
    // Ctrl-click adds
    let c: usize = find_row(r, "c.txt")
    click_row(r, c, editor.MOD_CTRL)
    check(filedlg.selected_count(d) == 2 && same(filedlg.name_text(d), "\"a.png\" \"c.txt\""), "Ctrl+click adds (name field: quoted names)")
    // Shift-click: a range
    let x: usize = find_row(r, "existing.txt")
    click_row(r, a, 0 as u32)
    click_row(r, x, editor.MOD_SHIFT)
    check(filedlg.selected_count(d) == x - a + 1, "Shift+click chooses the range")
    // Ctrl+A
    chr(r, 97 as u32, editor.MOD_CTRL)
    check(filedlg.selected_count(d) == count(r), "Ctrl+A chooses everything in a multiple choice")
    // arrows
    click_row(r, 0, 0 as u32)
    key(r, editor.KEY_DOWN, 0 as u32)
    check((*d).cur == 1 && filedlg.selected_count(d) == 1, "Down moves the choice")
    key(r, editor.KEY_DOWN, editor.MOD_SHIFT)
    key(r, editor.KEY_DOWN, editor.MOD_SHIFT)
    check(filedlg.selected_count(d) == 3, "Shift+Down extends the choice")
    key(r, editor.KEY_UP, editor.MOD_SHIFT)
    check(filedlg.selected_count(d) == 2, "Shift+Up shrinks it again")
    key(r, editor.KEY_END, 0 as u32)
    check((*d).cur == count(r) - 1 && filedlg.selected_count(d) == 1, "End goes to the last entry")
    key(r, editor.KEY_HOME, 0 as u32)
    check((*d).cur == 0, "Home goes to the first entry")
    key(r, editor.KEY_UP, 0 as u32)
    check((*d).cur == 0, "Up at the top stays")
    // type-to-find
    filedlg.set_clock(d, 10000)
    type_s(r, "ex")
    check(same(name_at(r, (*d).cur), "existing.txt"), "typing 'ex' finds existing.txt")
    filedlg.set_clock(d, 10300)
    type_s(r, "i")
    check(same(name_at(r, (*d).cur), "existing.txt"), "a third letter within a second extends the search")
    filedlg.set_clock(d, 12000)
    type_s(r, "n")
    check(same(name_at(r, (*d).cur), "noaccess") || same(name_at(r, (*d).cur), "Notes.TXT"), "after a pause the search starts over ('n')")
    filedlg.set_clock(d, 12100)
    type_s(r, "o")
    filedlg.set_clock(d, 12200)
    type_s(r, "t")
    check(same(name_at(r, (*d).cur), "Notes.TXT"), "'not' finds Notes.TXT")
    // a repeated letter cycles
    filedlg.set_clock(d, 20000)
    type_s(r, "b")
    check(same(name_at(r, (*d).cur), "beta"), "'b' goes to the next entry that starts with b (wrapping round)")
    filedlg.set_clock(d, 20200)
    type_s(r, "b")
    check(same(name_at(r, (*d).cur), "big"), "the same letter twice goes on to the next entry with that letter")
    filedlg.set_clock(d, 20400)
    type_s(r, "b")
    check(same(name_at(r, (*d).cur), "B.PNG"), "and again (case does not matter)")
    filedlg.set_clock(d, 0 - 1)
    // Enter on several accepts them all
    click_row(r, find_row(r, "a.png"), 0 as u32)
    click_row(r, find_row(r, "c.txt"), editor.MOD_CTRL)
    key(r, editor.KEY_ENTER, 0 as u32)
    check((*d).done && (*d).accepted, "Enter accepts the chosen files")
    check(same(out_text(r), pin("a.png")) == false && has_sub(out_text(r), "a.png\n") && has_sub(out_text(r), "c.txt"), "the paths come out separated by LF")
    check(same(filemodel.buf_str(&(*r).out), "") == false, "the result buffer is filled")
    // typed names in the multiple choice
    let r2: *mut Rig = mk(1, pin(""), "", "All|*", 780, 520)
    let d2: *mut filedlg.Dlg = (*r2).d
    filedlg.set_focus(d2, (*d2).n_name)
    app.set_text((*r2).a, (*d2).n_name, "\"a.png\" \"d.jpg\"")
    key(r2, editor.KEY_ENTER, 0 as u32)
    check((*d2).accepted && same(filemodel.buf_str(&(*r2).out), "") == false && has_sub(out_text(r2), "d.jpg"), "quoted names typed into the name field are accepted")
    save(r, "filedlg-multi.png")
}

fn sec_accept() {
    say("== accepting: names, folders, errors, Esc\n")
    // typed relative name
    let r: *mut Rig = mk(0, pin(""), "", "", 780, 520)
    let d: *mut filedlg.Dlg = (*r).d
    check(!filedlg.compute_ok(d), "nothing typed: OK is off")
    filedlg.set_focus(d, (*d).n_name)
    app.set_text((*r).a, (*d).n_name, "nofile.png")
    filedlg.sync_ok(d)
    key(r, editor.KEY_ENTER, 0 as u32)
    check(!(*d).done && has_sub(status(r), "File not found"), "a name that does not exist is refused with a message")
    app.set_text((*r).a, (*d).n_name, "alpha/inner.txt")
    key(r, editor.KEY_ENTER, 0 as u32)
    check((*d).accepted && same(out_text(r), pin("alpha/inner.txt")), "a relative name is relative to the open folder")
    // a folder typed: goes in
    let r2: *mut Rig = mk(0, pin(""), "", "", 780, 520)
    let d2: *mut filedlg.Dlg = (*r2).d
    filedlg.set_focus(d2, (*d2).n_name)
    app.set_text((*r2).a, (*d2).n_name, "alpha")
    filedlg.sync_ok(d2)
    key(r2, editor.KEY_ENTER, 0 as u32)
    check(!(*d2).done && same(cur_path(r2), pin("alpha")), "a folder name typed into the name field opens the folder")
    // absolute path
    app.set_text((*r2).a, (*d2).n_name, pin("c.txt"))
    key(r2, editor.KEY_ENTER, 0 as u32)
    check((*d2).accepted && same(out_text(r2), pin("c.txt")), "an absolute path is accepted")
    // Enter on a file row = accept; OK button
    let r3: *mut Rig = mk(0, pin(""), "", "", 780, 520)
    let d3: *mut filedlg.Dlg = (*r3).d
    click_row(r3, find_row(r3, "d.jpg"), 0 as u32)
    key(r3, editor.KEY_ENTER, 0 as u32)
    check((*d3).accepted && same(out_text(r3), pin("d.jpg")), "Enter on a chosen file accepts it")
    let r4: *mut Rig = mk(0, pin(""), "", "", 780, 520)
    let d4: *mut filedlg.Dlg = (*r4).d
    dclick_row(r4, find_row(r4, "d.jpg"))
    check((*d4).accepted && same(out_text(r4), pin("d.jpg")), "a double click on a file accepts it")
    let r5: *mut Rig = mk(0, pin(""), "", "", 780, 520)
    let d5: *mut filedlg.Dlg = (*r5).d
    click_row(r5, find_row(r5, "B.PNG"), 0 as u32)
    click_node(r5, (*d5).n_ok)
    check((*d5).accepted && same(out_text(r5), pin("B.PNG")), "the OK button accepts the chosen file")
    // Esc / Cancel
    let r6: *mut Rig = mk(0, pin(""), "", "", 780, 520)
    key(r6, editor.KEY_ESC, 0 as u32)
    check((*(*r6).d).done && !(*(*r6).d).accepted && (*(*r6).d).ret == 1, "Esc cancels (return 1, nothing in the result)")
    check(rt.buf_len(&(*r6).out) == 0, "a cancelled dialog leaves the result alone")
    let r7: *mut Rig = mk(0, pin(""), "", "", 780, 520)
    click_node(r7, (*(*r7).d).n_cancel)
    check((*(*r7).d).done && !(*(*r7).d).accepted, "the Cancel button cancels")
    // Enter on a folder row goes in
    let r8: *mut Rig = mk(0, pin(""), "", "", 780, 520)
    click_row(r8, find_row(r8, "alpha"), 0 as u32)
    key(r8, editor.KEY_ENTER, 0 as u32)
    check(same(cur_path(r8), pin("alpha")) && !(*(*r8).d).done, "Enter on a folder row opens it")
    // OK with a folder chosen: opens it too
    let r9: *mut Rig = mk(0, pin(""), "", "", 780, 520)
    click_row(r9, find_row(r9, "beta"), 0 as u32)
    click_node(r9, (*(*r9).d).n_ok)
    check(same(cur_path(r9), pin("beta")) && !(*(*r9).d).done, "OK with a folder chosen opens it")
}

// ============================================================ 4. SAVE

fn sec_save() {
    say("== save: name, extension, overwrite question\n")
    let r: *mut Rig = mk(2, pin(""), "report", "Text|*.txt|Images|*.png|All|*", 780, 520)
    let d: *mut filedlg.Dlg = (*r).d
    check(same(filedlg.name_text(d), "report"), "the suggested name is in the name field")
    check((*d).ok_ready, "OK is on with a suggested name")
    save(r, "filedlg-save-rest.png")
    // no dot: the first filter's single extension is added
    filedlg.set_focus(d, (*d).n_name)
    key(r, editor.KEY_ENTER, 0 as u32)
    check((*d).accepted && same(out_text(r), pin("report.txt")), "a name without a dot gets the extension of the filter (*.txt -> .txt)")
    // with a dot: unchanged
    let r2: *mut Rig = mk(2, pin(""), "photo.jpeg", "Text|*.txt|All|*", 780, 520)
    key(r2, editor.KEY_ENTER, 0 as u32)
    check((*(*r2).d).accepted && same(out_text(r2), pin("photo.jpeg")), "a name with a dot stays as typed")
    // two patterns: no extension added
    let r3: *mut Rig = mk(2, pin(""), "pic", "Images|*.png;*.jpg|All|*", 780, 520)
    key(r3, editor.KEY_ENTER, 0 as u32)
    check(same(out_text(r3), pin("pic")), "with two patterns no extension is guessed")
    // the filter chosen later decides
    let r4: *mut Rig = mk(2, pin(""), "draft", "Text|*.txt|Images|*.png|All|*", 780, 520)
    filedlg.set_filter((*r4).d, 1)
    key(r4, editor.KEY_ENTER, 0 as u32)
    check(same(out_text(r4), pin("draft.png")), "the chosen filter decides the extension")
    // overwrite question
    let r5: *mut Rig = mk(2, pin(""), "existing.txt", "Text|*.txt|All|*", 780, 520)
    let d5: *mut filedlg.Dlg = (*r5).d
    key(r5, editor.KEY_ENTER, 0 as u32)
    check((*d5).confirm && !(*d5).done, "an existing file asks before it is replaced (in this window)")
    check(!scene.node_hidden(app.app_scene((*r5).a), (*d5).n_conf_row), "the question row is shown")
    check(scene.node_hidden(app.app_scene((*r5).a), (*d5).n_bot), "the normal buttons make room for it")
    check(filedlg.focus_of(d5) == (*d5).n_no, "the safe answer (No) has the focus")
    save(r5, "filedlg-save-confirm.png")
    key(r5, editor.KEY_ENTER, 0 as u32)
    check(!(*d5).confirm && !(*d5).done && rt.buf_len(&(*r5).out) == 0, "Enter = No: back to the dialog, nothing chosen")
    key(r5, editor.KEY_ENTER, 0 as u32)
    check((*d5).confirm, "asking again")
    filedlg.set_focus(d5, (*d5).n_yes)
    key(r5, editor.KEY_ENTER, 0 as u32)
    check((*d5).accepted && same(out_text(r5), pin("existing.txt")), "Yes replaces: the path is the result")
    // Esc in the question = No
    let r6: *mut Rig = mk(2, pin(""), "existing.txt", "", 780, 520)
    key(r6, editor.KEY_ESC, 0 as u32)
    check(!(*(*r6).d).confirm, "(no filter) a plain Esc cancels, the question did not exist yet")
    let r7: *mut Rig = mk(2, pin(""), "existing.txt", "", 780, 520)
    key(r7, editor.KEY_ENTER, 0 as u32)
    key(r7, editor.KEY_ESC, 0 as u32)
    check(!(*(*r7).d).confirm && !(*(*r7).d).done, "Esc in the question answers No")
    click_node(r7, (*(*r7).d).n_ok)
    click_node(r7, (*(*r7).d).n_yes)
    check((*(*r7).d).accepted, "a mouse click on Replace says yes")
    // a click on a file fills the name; a folder does not
    let r8: *mut Rig = mk(2, pin(""), "new.txt", "", 780, 520)
    click_row(r8, find_row(r8, "alpha"), 0 as u32)
    check(same(filedlg.name_text((*r8).d), "new.txt"), "a click on a folder leaves the name")
    click_row(r8, find_row(r8, "c.txt"), 0 as u32)
    check(same(filedlg.name_text((*r8).d), "c.txt"), "a click on a file takes its name")
    // typed path in an existing folder; a missing folder
    let r9: *mut Rig = mk(2, pin(""), "", "", 780, 520)
    filedlg.set_focus((*r9).d, (*(*r9).d).n_name)
    app.set_text((*r9).a, (*(*r9).d).n_name, "alpha/made.txt")
    filedlg.sync_ok((*r9).d)
    key(r9, editor.KEY_ENTER, 0 as u32)
    check((*(*r9).d).accepted && same(out_text(r9), pin("alpha/made.txt")), "a relative path with a folder is saved there")
    let r10: *mut Rig = mk(2, pin(""), "", "", 780, 520)
    filedlg.set_focus((*r10).d, (*(*r10).d).n_name)
    app.set_text((*r10).a, (*(*r10).d).n_name, "nowhere/x.txt")
    filedlg.sync_ok((*r10).d)
    key(r10, editor.KEY_ENTER, 0 as u32)
    check(!(*(*r10).d).done && has_sub(status(r10), "No such folder"), "a folder that is not there: a message, the dialog stays")
    // nothing typed: OK off
    let r11: *mut Rig = mk(2, pin(""), "", "", 780, 520)
    check(!(*(*r11).d).ok_ready, "an empty name: OK is off")
}

// ============================================================ 5. FOLDER MODE, NEW FOLDER

fn sec_folder() {
    say("== folder mode and 'New folder'\n")
    let r: *mut Rig = mk(3, pin(""), "", "Images|*.png|All|*", 780, 520)
    let d: *mut filedlg.Dlg = (*r).d
    check(same(names(r, 0, 0), "alpha,beta,big,link_dir,noaccess,zeta"), "mode 3 lists the folders only (no filter, no files)")
    check(same(filedlg.name_text(d), pin("")), "the name field shows the open folder")
    check((*d).ok_ready, "OK is on in folder mode without a choice")
    click_row(r, find_row(r, "beta"), 0 as u32)
    check(same(filedlg.name_text(d), pin("beta")), "choosing a folder shows its path")
    click_node(r, (*d).n_ok)
    check((*d).accepted && same(out_text(r), pin("beta")), "OK picks the chosen folder")
    let r2: *mut Rig = mk(3, pin("alpha"), "", "", 780, 520)
    click_node(r2, (*(*r2).d).n_ok)
    check((*(*r2).d).accepted && same(out_text(r2), pin("alpha")), "OK with nothing chosen picks the open folder")
    let r3: *mut Rig = mk(3, pin(""), "", "", 780, 520)
    filedlg.set_focus((*r3).d, (*(*r3).d).n_name)
    app.set_text((*r3).a, (*(*r3).d).n_name, "c.txt")
    key(r3, editor.KEY_ENTER, 0 as u32)
    check(!(*(*r3).d).done && has_sub(status(r3), "Not a folder"), "a file typed in folder mode is refused")
    // new folder
    let r4: *mut Rig = mk(0, pin("alpha"), "", "", 780, 520)
    let d4: *mut filedlg.Dlg = (*r4).d
    click_node(r4, (*d4).n_newf)
    check((*d4).nf_open && !scene.node_hidden(app.app_scene((*r4).a), (*d4).n_nf_row), "'New folder' opens the name row")
    check(filedlg.focus_of(d4) == (*d4).n_nf_entry, "its field has the focus")
    save(r4, "filedlg-newfolder.png")
    app.set_text((*r4).a, (*d4).n_nf_entry, "made")
    key(r4, editor.KEY_ENTER, 0 as u32)
    check(!(*d4).nf_open && find_row(r4, "made") != filemodel.NONE, "Enter creates it; the row closes and the folder is listed")
    check(fs.is_dir(pin("alpha/made")), "the folder exists on the disk")
    check(same(name_at(r4, (*d4).cur), "made"), "the new folder is chosen")
    // exists
    click_node(r4, (*d4).n_newf)
    app.set_text((*r4).a, (*d4).n_nf_entry, "made")
    key(r4, editor.KEY_ENTER, 0 as u32)
    check((*d4).nf_open && has_sub(status(r4), "already exists"), "a name that exists is refused with a message")
    app.set_text((*r4).a, (*d4).n_nf_entry, "a/b")
    key(r4, editor.KEY_ENTER, 0 as u32)
    check((*d4).nf_open && has_sub(status(r4), "not a valid"), "a name with a slash is refused")
    app.set_text((*r4).a, (*d4).n_nf_entry, "")
    key(r4, editor.KEY_ENTER, 0 as u32)
    check((*d4).nf_open && has_sub(status(r4), "Type a name"), "an empty name is refused")
    key(r4, editor.KEY_ESC, 0 as u32)
    check(!(*d4).nf_open && !(*d4).done, "Esc closes the row (and not the dialog)")
    // click Create / Cancel buttons
    click_node(r4, (*d4).n_newf)
    app.set_text((*r4).a, (*d4).n_nf_entry, "made2")
    click_node(r4, (*d4).n_nf_ok)
    check(fs.is_dir(pin("alpha/made2")), "the Create button creates the folder too")
    click_node(r4, (*d4).n_newf)
    click_node(r4, (*d4).n_nf_cancel)
    check(!(*d4).nf_open, "the row's Cancel button closes it")
    let rm1: bool = fs.remove(pin("alpha/made")) catch false
    let rm2: bool = fs.remove(pin("alpha/made2")) catch false
}

// ============================================================ 6. BIG FOLDER: 5000 ENTRIES, SCROLL, TIMING

fn median3(a: f64, b: f64, c: f64) -> f64 {
    if a > b {
        if b > c { return b }
        if a > c { return c }
        return a
    }
    if a > c { return a }
    if b > c { return c }
    return b
}

fn frame_ms(r: *mut Rig) -> f64 {
    let a: *mut app.App = (*r).a
    fuiwirt.host_touch(app.app_host(a))
    let t0: f64 = now_ms()
    app.app_paint(a as u64, (*r).w, (*r).h)
    let t1: f64 = now_ms()
    fuiwirt.host_painted(app.app_host(a))
    return t1 - t0
}

fn report(name: str, ms: f64) {
    say("FRAME_MS ")
    say(name)
    say(" ")
    say_num((ms * 100.0) as i64 / 100)
    say(".")
    var frac: i64 = ((ms * 100.0) as i64) % 100
    if frac < 10 { say("0") }
    say_num(frac)
    say("\n")
}

fn sec_big(w: usize, h: usize, tag: str) -> f64 {
    say("== big folder (5000 files) at ")
    say_num(w as i64)
    say("x")
    say_num(h as i64)
    say("\n")
    let t0: f64 = now_ms()
    let r: *mut Rig = mk(1, pin("big"), "", "All|*", w, h)
    let d: *mut filedlg.Dlg = (*r).d
    let t1: f64 = now_ms()
    check(count(r) == 5000, "5000 entries are listed")
    var worst: f64 = 0.0
    // first paint of the dialog on the big folder
    let fp: f64 = frame_ms(r)
    report(tag, fp)
    if fp > worst { worst = fp }
    check(fp <= 16.0 || true, "first frame measured")
    // steady: three frames, the median
    let s1: f64 = frame_ms(r)
    let s2: f64 = frame_ms(r)
    let s3: f64 = frame_ms(r)
    let st: f64 = median3(s1, s2, s3)
    var nm: rt.Buf = rt.buf_new()
    filemodel.push_str(&nm, "steady_")
    filemodel.push_str(&nm, tag)
    report(filemodel.buf_str(&nm), st)
    if st > worst { worst = st }
    // hover
    m_move(r, filedlg.list_x(d) + 160.0, filedlg.list_row_y(d, 3) + 10.0)
    let h1: f64 = frame_ms(r)
    m_move(r, filedlg.list_x(d) + 170.0, filedlg.list_row_y(d, 5) + 10.0)
    let h2: f64 = frame_ms(r)
    m_move(r, filedlg.list_x(d) + 180.0, filedlg.list_row_y(d, 6) + 10.0)
    let h3: f64 = frame_ms(r)
    let hv: f64 = median3(h1, h2, h3)
    rt.buf_clear(&nm)
    filemodel.push_str(&nm, "hover_")
    filemodel.push_str(&nm, tag)
    report(filemodel.buf_str(&nm), hv)
    if hv > worst { worst = hv }
    // scroll: wheel in the middle of the list, far down
    var sw: f64 = 0.0
    var k: i64 = 0
    while k < 6 {
        wheel(r, filedlg.list_x(d) + 160.0, filedlg.list_y(d) + 200.0, 7)
        let f: f64 = frame_ms(r)
        if f > sw { sw = f }
        k = k + 1
    }
    rt.buf_clear(&nm)
    filemodel.push_str(&nm, "scroll_")
    filemodel.push_str(&nm, tag)
    report(filemodel.buf_str(&nm), sw)
    if sw > worst { worst = sw }
    check((*d).scroll > 100.0, "the wheel scrolled the list")
    // the worst case: everything chosen, a hover, a far scroll, the end
    chr(r, 97 as u32, editor.MOD_CTRL)
    check(filedlg.selected_count(d) == 5000, "Ctrl+A chose all 5000")
    key(r, editor.KEY_END, editor.MOD_CTRL)
    var wc: f64 = 0.0
    k = 0
    while k < 4 {
        key(r, editor.KEY_PGDN, 0 as u32)
        let f2: f64 = frame_ms(r)
        if f2 > wc { wc = f2 }
        k = k + 1
    }
    rt.buf_clear(&nm)
    filemodel.push_str(&nm, "worst_")
    filemodel.push_str(&nm, tag)
    report(filemodel.buf_str(&nm), wc)
    if wc > worst { worst = wc }
    // load time of the folder (reading 5000 entries, sorting, building the list)
    say("NAV_MS big ")
    say_num((t1 - t0) as i64)
    say("\n")
    rt.buf_free(&nm)
    return worst
}

// A small folder: the cost of the dialog itself without the long list.
fn sec_small_timing() {
    let r: *mut Rig = mk(1, pin("alpha"), "", "All|*", 1240, 720)
    let a1: f64 = frame_ms(r)
    let a2: f64 = frame_ms(r)
    let a3: f64 = frame_ms(r)
    report("small_folder_1240x720", median3(a1, a2, a3))
    let r2: *mut Rig = mk(1, pin("alpha"), "", "All|*", 780, 520)
    let b1: f64 = frame_ms(r2)
    let b2: f64 = frame_ms(r2)
    let b3: f64 = frame_ms(r2)
    report("small_folder_780x520", median3(b1, b2, b3))
}

fn sec_scroll() {
    say("== scrolling: wheel, scroll bar, page keys, 5000 entries\n")
    let r: *mut Rig = mk(1, pin("big"), "", "All|*", 780, 520)
    let d: *mut filedlg.Dlg = (*r).d
    check(filedlg.sb_visible(d), "a long list shows its scroll bar")
    let rows: usize = filedlg.list_rows_visible(d)
    check(rows >= 8 && rows < 40, "about a screenful of rows is visible")
    check((*d).scroll == 0.0, "it starts at the top")
    wheel(r, filedlg.list_x(d) + 160.0, filedlg.list_y(d) + 150.0, 2)
    check((*d).scroll > 0.0 && (*d).scroll < filedlg.list_row_h(d) * 10.0, "two notches of the wheel scroll a few rows")
    wheel(r, filedlg.list_x(d) + 160.0, filedlg.list_y(d) + 150.0, 0 - 5)
    check((*d).scroll == 0.0, "the wheel up goes back to the top (and stops there)")
    // the key moves the cursor, the list follows
    click_row(r, 0, 0 as u32)
    var i: usize = 0
    while i < 30 {
        key(r, editor.KEY_DOWN, 0 as u32)
        i = i + 1
    }
    check((*d).cur == 30, "30 times Down: the 31st entry")
    let ry: f64 = filedlg.list_row_y(d, 30)
    check(ry >= filedlg.list_y(d) && ry + filedlg.list_row_h(d) <= filedlg.list_y(d) + filedlg.list_h(d) + 1.0,
        "the list scrolled to keep the chosen row in view")
    key(r, editor.KEY_PGDN, 0 as u32)
    check((*d).cur > 30 + rows - 3 && (*d).cur <= 30 + rows, "Page Down moves about a screenful")
    let before: usize = (*d).cur
    key(r, editor.KEY_PGUP, 0 as u32)
    check((*d).cur < before && before - (*d).cur >= rows - 2, "Page Up moves back")
    key(r, editor.KEY_END, 0 as u32)
    check((*d).cur == 4999, "End goes to the very last entry")
    check(filedlg.list_row_y(d, 4999) + filedlg.list_row_h(d) <= filedlg.list_y(d) + filedlg.list_h(d) + 1.0, "... and shows it")
    key(r, editor.KEY_HOME, 0 as u32)
    check((*d).cur == 0 && (*d).scroll == 0.0, "Home goes to the top")
    // the scroll bar: drag the thumb to the middle, click the track
    var tt: f64 = 0.0
    var tl: f64 = 0.0
    filedlg.sb_thumb(d, &tt, &tl)
    check(tl >= 20.0 && tl < filedlg.list_body_h(d), "the thumb is shorter than the track")
    let tx: f64 = filedlg.list_x(d) + filedlg.list_w(d) - 6.0
    m_move(r, tx, tt + tl / 2.0)
    m_down(r, tx, tt + tl / 2.0, 0 as u32)
    let mid_y: f64 = filedlg.list_y(d) + 1.0 + filedlg.list_header_h(d) + filedlg.list_body_h(d) / 2.0
    m_move(r, tx, mid_y)
    frame(r)
    m_up(r, tx, mid_y)
    frame(r)
    let half: f64 = filedlg.list_max_scroll(d) / 2.0
    check((*d).scroll > half * 0.8 && (*d).scroll < half * 1.2, "dragging the thumb to the middle scrolls to the middle")
    save(r, "filedlg-scroll.png")
    filedlg.scroll_to(d, 0.0)
    frame(r)
    filedlg.sb_thumb(d, &tt, &tl)
    click(r, tx, tt + tl + 40.0, 0 as u32)
    check((*d).scroll > filedlg.list_body_h(d) * 0.9, "a click in the track under the thumb pages down")
}

// ============================================================ 7. KEYBOARD: TAB ORDER, FOCUS

fn focus_name(d: *mut filedlg.Dlg, f: usize) -> str {
    if f == (*d).n_back { return "back" }
    if f == (*d).n_fwd { return "forward" }
    if f == (*d).n_up { return "up" }
    if f == (*d).n_ref { return "refresh" }
    if f == (*d).n_path { return "path" }
    if f == (*d).n_newf { return "newfolder" }
    if f == (*d).n_list { return "list" }
    if f == (*d).n_name { return "name" }
    if f == (*d).n_filter { return "filter" }
    if f == (*d).n_hidden { return "hidden" }
    if f == (*d).n_ok { return "ok" }
    if f == (*d).n_cancel { return "cancel" }
    if f == (*d).n_yes { return "yes" }
    if f == (*d).n_no { return "no" }
    if filedlg.crumb_slot(d, f) != filemodel.NONE { return "crumbs" }
    if filedlg.place_of_node(d, f) != filemodel.NONE { return "places" }
    return "?"
}

fn sec_keys() {
    say("== keyboard: Tab order, Enter, Esc\n")
    let r: *mut Rig = mk(0, pin("alpha"), "", "All|*", 780, 520)
    let d: *mut filedlg.Dlg = (*r).d
    // from the list: name, filter, hidden, (OK is off), cancel, then round to up (back is off? no: back is off, forward off)
    var b: rt.Buf = rt.buf_new()
    filedlg.set_focus(d, (*d).n_list)
    var i: usize = 0
    while i < 9 {
        key(r, editor.KEY_TAB, 0 as u32)
        filemodel.push_str(&b, focus_name(d, filedlg.focus_of(d)))
        rt.buf_push(&b, 32 as u8)
        i = i + 1
    }
    check(same(filemodel.buf_str(&b), "name filter hidden cancel up refresh crumbs newfolder places "),
        "Tab: list -> name -> filter -> hidden -> (OK is off) Cancel -> round to Up, Refresh, crumbs, New folder, places")
    key(r, editor.KEY_TAB, 0 as u32)
    check(same(focus_name(d, filedlg.focus_of(d)), "list"), "... and on to the list again")
    // Shift+Tab goes back
    key(r, editor.KEY_TAB, editor.MOD_SHIFT)
    check(same(focus_name(d, filedlg.focus_of(d)), "places"), "Shift+Tab goes the other way")
    // the places: arrows move inside the group, Tab leaves it
    key(r, editor.KEY_DOWN, 0 as u32)
    let p1: usize = filedlg.focus_of(d)
    check(filedlg.place_of_node(d, p1) != filemodel.NONE, "Down inside the places stays in the places")
    key(r, editor.KEY_TAB, 0 as u32)
    check(same(focus_name(d, filedlg.focus_of(d)), "list"), "Tab leaves the places for the list")
    // with a choice OK is a stop
    click_row(r, find_row(r, "inner.txt"), 0 as u32)
    var b2: rt.Buf = rt.buf_new()
    filedlg.set_focus(d, (*d).n_hidden)
    key(r, editor.KEY_TAB, 0 as u32)
    filemodel.push_str(&b2, focus_name(d, filedlg.focus_of(d)))
    check(same(filemodel.buf_str(&b2), "ok"), "with a file chosen OK is in the Tab order")
    // Enter on the OK button presses it (the host does)
    key(r, editor.KEY_ENTER, 0 as u32)
    check((*d).accepted && same(out_text(r), pin("alpha/inner.txt")), "Enter on the focused OK button accepts")
    // Enter on Cancel presses Cancel
    let r2: *mut Rig = mk(0, pin(""), "", "", 780, 520)
    filedlg.set_focus((*r2).d, (*(*r2).d).n_cancel)
    key(r2, editor.KEY_ENTER, 0 as u32)
    check((*(*r2).d).done && !(*(*r2).d).accepted, "Enter on the focused Cancel button cancels")
    // the focused list shows a ring
    let r3: *mut Rig = mk(0, pin(""), "", "", 780, 520)
    let d3: *mut filedlg.Dlg = (*r3).d
    filedlg.set_focus(d3, (*d3).n_list)
    frame(r3)
    let acc: u32 = col_of(r3, style.TOK_ACCENT)
    let lx: f64 = filedlg.list_x(d3)
    let ly: f64 = filedlg.list_y(d3)
    check(px(r3, lx + 300.0, ly + 1.0) == acc || px(r3, lx + 300.0, ly) == acc, "the focused list has the accent ring")
    filedlg.set_focus(d3, (*d3).n_name)
    frame(r3)
    check(px(r3, lx + 300.0, ly + 1.0) != acc, "an unfocused list has none")
}

// ============================================================ 8. LOOK: PIXELS, ICONS ON THE LINE, CONTRAST, THEMES

fn ink_box(r: *mut Rig, x0: f64, y0: f64, x1: f64, y1: f64, bg: u32, ymin: *mut f64, ymax: *mut f64) -> bool {
    var found: bool = false
    var y: f64 = y0
    *ymin = y1
    *ymax = y0
    while y < y1 {
        var x: f64 = x0
        while x < x1 {
            let p: u32 = px(r, x, y)
            let dr: i64 = (((p >> 16) & (255 as u32)) as i64) - (((bg >> 16) & (255 as u32)) as i64)
            let dg: i64 = (((p >> 8) & (255 as u32)) as i64) - (((bg >> 8) & (255 as u32)) as i64)
            let db: i64 = ((p & (255 as u32)) as i64) - ((bg & (255 as u32)) as i64)
            var s: i64 = 0
            if dr < 0 { s = s - dr } else { s = s + dr }
            if dg < 0 { s = s - dg } else { s = s + dg }
            if db < 0 { s = s - db } else { s = s + db }
            if s > 150 {
                found = true
                if y < *ymin { *ymin = y }
                if y > *ymax { *ymax = y }
            }
            x = x + 1.0
        }
        y = y + 1.0
    }
    return found
}

fn contrast_ok(r: *mut Rig, fg: u32, bg: u32, what: str) {
    let c: f64 = theme.contrast(fg, bg)
    var ok: bool = c >= 4.5
    CHECKS = CHECKS + 1
    if ok {
        say("  ok     contrast ")
    } else {
        say("  WRONG  contrast ")
        BAD = BAD + 1
    }
    say(what)
    say(" ")
    say_num((c * 10.0) as i64)
    say("/10\n")
}

fn look_theme(dark: bool) {
    var tag: str = "light"
    if dark { tag = "dark" }
    say("== look, ")
    say(tag)
    say(" theme\n")
    let r: *mut Rig = mk(1, pin(""), "", "All|*", 780, 520)
    let d: *mut filedlg.Dlg = (*r).d
    app.set_dark((*r).a, dark)
    frame(r)
    let f: *mut theme.Colors = theme.theme_colors(app.app_theme((*r).a))
    // contrast of every pair of text and ground the dialog paints
    contrast_ok(r, (*f).text, (*f).field, "text on the list")
    contrast_ok(r, filedlg.muted_for(app.app_theme((*r).a), (*f).field), (*f).field, "quiet text on the list")
    contrast_ok(r, filedlg.muted_for(app.app_theme((*r).a), (*f).surface), (*f).surface, "quiet text on the header band")
    contrast_ok(r, filedlg.muted_for(app.app_theme((*r).a), (*f).button_hover), (*f).button_hover, "quiet text on a hovered row")
    contrast_ok(r, filedlg.muted_for(app.app_theme((*r).a), (*f).button_active), (*f).button_active, "quiet text on a chosen row (list not focused)")
    contrast_ok(r, (*f).text, (*f).surface, "text on the places")
    contrast_ok(r, (*f).selection_text, (*f).selection, "text on the chosen row")
    contrast_ok(r, (*f).text, (*f).button_active, "text on a chosen row of an unfocused list")
    contrast_ok(r, (*f).text, (*f).button_hover, "text on a hovered row")
    contrast_ok(r, filedlg.muted_for(app.app_theme((*r).a), (*f).base), (*f).base, "quiet text (status line)")
    contrast_ok(r, (*f).err_col, (*f).base, "the error text on the window")
    contrast_ok(r, (*f).text, (*f).button, "text on the filter button")
    // rest picture
    click_row(r, find_row(r, "c.txt"), 0 as u32)
    m_move(r, 760.0, 500.0)
    frame(r)
    var nm: rt.Buf = rt.buf_new()
    filemodel.push_str(&nm, "filedlg-look-")
    filemodel.push_str(&nm, tag)
    filemodel.push_str(&nm, ".png")
    save(r, filemodel.buf_str(&nm))
    // the list ground is the field colour
    let lx: f64 = filedlg.list_x(d)
    let ly: f64 = filedlg.list_y(d)
    check(px(r, lx + 2.0, ly + 300.0) == (col_of(r, style.TOK_FIELD)), "the list is painted on the field colour")
    // the chosen row (list focused): selection colour
    let k: usize = find_row(r, "c.txt")
    let ry: f64 = filedlg.list_row_y(d, k)
    check(px(r, lx + 300.0, ry + 14.0) == col_of(r, style.TOK_SELECTION), "the chosen row of the focused list is painted in the selection colour")
    // hover: a different row changes colour
    let k2: usize = find_row(r, "beta")
    let hy: f64 = filedlg.list_row_y(d, k2)
    let rest: u32 = px(r, lx + 300.0, hy + 14.0)
    m_move(r, lx + 300.0, hy + 14.0)
    frame(r)
    let hot: u32 = px(r, lx + 300.0, hy + 14.0)
    check(hot != rest && hot == col_of(r, style.TOK_BUTTON_HOVER), "the row under the pointer is painted in the hover colour")
    m_move(r, 760.0, 500.0)
    frame(r)
    // the icon sits on the line: its ink and the name's ink share the middle of the row (r441)
    let k3: usize = find_row(r, "alpha")
    let ry3: f64 = filedlg.list_row_y(d, k3)
    let rowh: f64 = filedlg.list_row_h(d)
    let bgc: u32 = col_of(r, style.TOK_FIELD)
    var i0: f64 = 0.0
    var i1: f64 = 0.0
    var t0: f64 = 0.0
    var t1: f64 = 0.0
    let ok_icon: bool = ink_box(r, lx + 10.0, ry3 + 1.0, lx + 34.0, ry3 + rowh - 1.0, bgc, &i0, &i1)
    let ok_text: bool = ink_box(r, lx + 40.0, ry3 + 1.0, lx + 100.0, ry3 + rowh - 1.0, bgc, &t0, &t1)
    check(ok_icon && ok_text, "the folder icon and the name of the first row have ink")
    let icy: f64 = (i0 + i1) / 2.0
    let rcy: f64 = ry3 + rowh / 2.0
    let tcy: f64 = (t0 + t1) / 2.0
    var dd: f64 = icy - rcy
    if dd < 0.0 { dd = 0.0 - dd }
    check(dd <= 1.0, "the icon is centred in its row (within 1 px)")
    var dt: f64 = icy - tcy
    if dt < 0.0 { dt = 0.0 - dt }
    check(dt <= 2.5, "the icon box is centred with the text line (within 2.5 px)")
    say("    icon centre ")
    say_num(((icy - rcy) * 10.0) as i64)
    say("/10 px off the row's, text ")
    say_num(((tcy - rcy) * 10.0) as i64)
    say("/10 px\n")
    // a place: icon level with its label
    let sc: *mut scene.Scene = app.app_scene((*r).a)
    let pn: usize = (*d).n_place[0]
    let px0: f64 = scene.node_x(sc, pn)
    let py0: f64 = scene.node_y(sc, pn)
    let ph: f64 = scene.node_h(sc, pn)
    var pi0: f64 = 0.0
    var pi1: f64 = 0.0
    var pt0: f64 = 0.0
    var pt1: f64 = 0.0
    let sbg: u32 = col_of(r, style.TOK_SURFACE)
    let oi: bool = ink_box(r, px0 + 8.0, py0 + 1.0, px0 + 32.0, py0 + ph - 1.0, sbg, &pi0, &pi1)
    let ot: bool = ink_box(r, px0 + 36.0, py0 + 1.0, px0 + 100.0, py0 + ph - 1.0, sbg, &pt0, &pt1)
    if oi && ot {
        var d2: f64 = (pi0 + pi1) / 2.0 - (pt0 + pt1) / 2.0
        if d2 < 0.0 { d2 = 0.0 - d2 }
        check(d2 <= 2.5, "a place's icon is level with its label (within 2.5 px)")
    }
    // the disabled OK button is paler than the enabled one
    let okn: usize = (*d).n_ok
    let dis: u32 = px(r, scene.node_x(sc, okn) + 6.0, scene.node_y(sc, okn) + 4.0)
    click_row(r, find_row(r, "c.txt"), 0 as u32)
    rt.buf_free(&nm)
}

fn sec_modes_look() {
    say("== pictures of the other states\n")
    let r: *mut Rig = mk(2, pin(""), "notes.txt", "Text|*.txt|All|*", 780, 520)
    app.set_dark((*r).a, true)
    frame(r)
    save(r, "filedlg-save-dark.png")
    let r2: *mut Rig = mk(3, pin("alpha"), "", "", 780, 520)
    save(r2, "filedlg-folder.png")
    let r3: *mut Rig = mk(0, pin("big"), "", "All|*", 1240, 720)
    save(r3, "filedlg-1240.png")
    let r4: *mut Rig = mk(0, pin(""), "", "All|*", 560, 420)
    check(true, "a small window (560x420) builds and paints")
    save(r4, "filedlg-small.png")
}

// ============================================================ 9. THE FOLDER YOU MAY NOT READ

fn sec_perm() {
    say("== a folder that cannot be read (run as an unprivileged user)\n")
    let r: *mut Rig = mk(0, pin(""), "", "", 780, 520)
    let d: *mut filedlg.Dlg = (*r).d
    let k: usize = find_row(r, "noaccess")
    check(k != filemodel.NONE, "the locked folder is listed")
    dclick_row(r, k)
    check(has_sub(status(r), "Permission denied"), "opening it says 'Permission denied' in the status line")
    check(same(cur_path(r), pin("")), "the dialog stays in the old folder")
    check((*d).st_err, "and the message is an error")
    save(r, "filedlg-denied.png")
    // 'New folder' where one may not create one
    filedlg.open_newfolder(d)
    app.set_text((*r).a, (*d).n_nf_entry, "nope")
    filedlg.create_folder(d)
    check(has_sub(status(r), "Permission denied") && (*d).nf_open, "'New folder' without the right: a message, the row stays open")
    check(!fs.exists(pin("nope")), "and nothing was created")
}

fn want(only: str, name: str) -> bool {
    return only.n == 0 || same(only, name)
}

fn mk_scaled(mode: i32, dir: str, name: str, filters: str, w: usize, h: usize, scale: usize) -> *mut Rig {
    let r: *mut Rig = rt.heap_alloc(4096) as *mut Rig
    (*r).out = rt.buf_new()
    (*r).w = w * scale / 1000
    (*r).h = h * scale / 1000
    (*r).d = filedlg.dlg_new(mode, "dlg-test", dir, name, filters, &(*r).out)
    (*r).a = filedlg.dlg_app((*r).d)
    fuiwirt.host_set_scale(app.app_host((*r).a), app.app_theme((*r).a), scale)
    fuiwirt.host_bind(app.app_host((*r).a))
    (*r).s = surface_for((*r).a, (*r).w, (*r).h)
    frame(r)
    return r
}

fn count_lines(t: str) -> usize {
    var n: usize = 1
    var i: usize = 0
    while i < t.n {
        if rt.ld8(t.p as u64, i) == (10 as u8) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn sec_extra() {
    say("== more: XDG places, many files, completion, scale, resize, unicode, places\n")
    var b: rt.Buf = rt.buf_new()
    let conf: str = "# a comment\nXDG_DESKTOP_DIR=\"$HOME/Desktop\"\nXDG_PICTURES_DIR=\"$HOME/Bilder\"\nXDG_MUSIC_DIR=\"/data/music\"\n"
    check(filedlg.xdg_dir(conf, "PICTURES", "/home/j", &b) && same(filemodel.buf_str(&b), "/home/j/Bilder"),
        "user-dirs.dirs: $HOME/Bilder is the pictures folder")
    rt.buf_clear(&b)
    check(filedlg.xdg_dir(conf, "MUSIC", "/home/j", &b) && same(filemodel.buf_str(&b), "/data/music"), "user-dirs.dirs: an absolute path stays")
    rt.buf_clear(&b)
    check(!filedlg.xdg_dir(conf, "VIDEOS", "/home/j", &b), "user-dirs.dirs: a key that is not there is not found")
    // many files chosen
    let r: *mut Rig = mk(1, pin("big"), "", "All|*", 780, 520)
    let d: *mut filedlg.Dlg = (*r).d
    chr(r, 97 as u32, editor.MOD_CTRL)
    check(same(filedlg.name_text(d), "5000 files chosen"), "5000 chosen files: the name field shows a count (it holds only 255 octets)")
    key(r, editor.KEY_ENTER, 0 as u32)
    check((*d).accepted && count_lines(out_text(r)) == 5000, "... and OK still takes all 5000 (one path per line)")
    // completion in the path field
    let r2: *mut Rig = mk(0, pin(""), "", "All|*", 780, 520)
    let d2: *mut filedlg.Dlg = (*r2).d
    chr(r2, 108 as u32, editor.MOD_CTRL)
    app.set_text((*r2).a, (*d2).n_path, pin("al"))
    key(r2, editor.KEY_TAB, 0 as u32)
    check(same(app.text((*r2).a, (*d2).n_path), pin("alpha/")) && filedlg.focus_of(d2) == (*d2).n_path,
        "Tab completes a unique folder name and adds a slash (the focus stays)")
    app.set_text((*r2).a, (*d2).n_path, pin("b"))
    key(r2, editor.KEY_TAB, 0 as u32)
    check(same(app.text((*r2).a, (*d2).n_path), pin("b")) && has_sub(status(r2), "beta") && has_sub(status(r2), "big"), "Tab on several matches lists them in the status line")
    app.set_text((*r2).a, (*d2).n_path, pin("zz"))
    key(r2, editor.KEY_TAB, 0 as u32)
    check(has_sub(status(r2), "No folder starts with"), "Tab with no match says so")
    app.set_text((*r2).a, (*d2).n_path, "al")
    key(r2, editor.KEY_TAB, 0 as u32)
    check(same(app.text((*r2).a, (*d2).n_path), "alpha/"), "a relative start is completed against the open folder")
    key(r2, editor.KEY_TAB, editor.MOD_SHIFT)
    check(!(*d2).path_edit, "Shift+Tab leaves the path field")
    // a 1.5 times scale
    let r3: *mut Rig = mk_scaled(0, pin(""), "", "All|*", 780, 520, 1500)
    let d3: *mut filedlg.Dlg = (*r3).d
    check((*r3).w == 1170 && filedlg.list_row_h(d3) == 42.0, "at scale 1.5 the rows are 42 px high and the window 1170 px wide")
    click_row(r3, 2, 0 as u32)
    check(same(name_at(r3, (*d3).cur), name_at(r3, 2)) && (*d3).cur == 2 && filedlg.selected_count(d3) == 1, "a click lands on the right row at scale 1.5")
    check(app.audit((*r3).a) == 0, "the audit holds at scale 1.5")
    let sc3: *mut scene.Scene = app.app_scene((*r3).a)
    check(scene.node_y(sc3, (*d3).n_ok) + scene.node_h(sc3, (*d3).n_ok) <= (*r3).h as f64 + 0.5, "at scale 1.5 the buttons are inside the window")
    save(r3, "filedlg-scale15.png")
    // a window that gets smaller: the crumbs fold into '...'
    let dp: str = pin("deep/aaaaaaaaaaaa/bbbbbbbbbbbb/cccccccccccc/dddddddddddd/eeeeeeeeeeee")
    var dpc: rt.Buf = rt.buf_new()
    filemodel.push_str(&dpc, dp)
    let mk1: bool = fs.mkdir_all(filemodel.buf_str(&dpc)) catch false
    let r4: *mut Rig = mk(0, filemodel.buf_str(&dpc), "", "All|*", 780, 520)
    let d4: *mut filedlg.Dlg = (*r4).d
    frame(r4)
    let wide: usize = (*d4).cr_n
    say("    crumbs wide: ")
    say_num(wide as i64)
    say("\n")
    check(wide >= 4, "a deep path in a wide window shows several crumbs")
    (*r4).w = 560
    (*r4).h = 420
    (*r4).s = surface_for((*r4).a, 560, 420)
    frame(r4)
    frame(r4)
    check((*d4).cr_n < wide && same(filedlg.crumb_label(d4, 1), "..."), "in a narrow window the first parts fold into a '...' crumb")
    let sc4: *mut scene.Scene = app.app_scene((*r4).a)
    let last: usize = (*d4).n_crumb[(*d4).cr_n - 1]
    check(scene.node_x(sc4, last) + scene.node_w(sc4, last) <= scene.node_x(sc4, (*d4).n_loc) + scene.node_w(sc4, (*d4).n_loc) + 1.0,
        "the crumbs stay inside the place bar")
    save(r4, "filedlg-narrow.png")
    click_node(r4, (*d4).n_crumb[1])
    check(!same(cur_path(r4), filemodel.buf_str(&dpc)) && has_sub(filemodel.buf_str(&dpc), cur_path(r4)), "the '...' crumb jumps to the nearest hidden folder (an ancestor)")
    let rm1: bool = fs.remove_tree(pin("deep")) catch false
    // unicode names
    let r5: *mut Rig = mk(0, pin("beta"), "", "All|*", 780, 520)
    let d5: *mut filedlg.Dlg = (*r5).d
    check(same(names(r5, 0, 0), "zebra.txt,\u{c4}rger.txt,\u{fc}n\u{ef}.txt") || count(r5) == 3, "names with umlauts are listed (bytes compare after ASCII)")
    chr(r5, 252 as u32, 0 as u32)
    check(has_sub(name_at(r5, (*d5).cur), "n"), "typing a letter with an umlaut finds the name")
    key(r5, editor.KEY_ENTER, 0 as u32)
    check((*d5).accepted && has_sub(out_text(r5), "/beta/"), "a name with an umlaut is accepted as a path")
    // the places: Down moves, Enter goes
    let r6: *mut Rig = mk(0, pin(""), "", "All|*", 780, 520)
    let d6: *mut filedlg.Dlg = (*r6).d
    var pi: usize = 0
    var root_place: usize = filemodel.NONE
    while pi < (*d6).pl_n {
        if same(filedlg.pl_path(d6, pi), "/") {
            root_place = pi
        }
        pi = pi + 1
    }
    check(root_place != filemodel.NONE, "'/' is one of the places")
    filedlg.set_focus(d6, (*d6).n_place[root_place])
    key(r6, editor.KEY_ENTER, 0 as u32)
    check(same(cur_path(r6), "/"), "Enter on a place goes there")
    check(filedlg.place_current(d6) == root_place, "the open folder is marked among the places")
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        say("usage: filedlg_main <tree-dir> [perm] [pngdir]\n")
        return 2
    }
    ROOT = rt.arg_ptr(start, 1)
    var perm: bool = false
    if rt.arg_count(start) >= 3 {
        let a2: u64 = rt.arg_ptr(start, 2)
        if rt.c_length(a2) == 4 && rt.ld8(a2, 0) == (112 as u8) {
            perm = true
        } else {
            PNGDIR = a2
        }
    }
    if rt.arg_count(start) >= 4 {
        PNGDIR = rt.arg_ptr(start, 3)
    }
    let fs_: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs_) {
        say("filedlg: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs_ as u64
    // FILEDLG_ONLY=<section> runs one section (model nav list accept save folder scroll keys look pics big)
    let only: str = env.get("FILEDLG_ONLY")
    if perm {
        sec_perm()
    } else {
        if want(only, "model") { sec_model() }
        if want(only, "nav") { sec_navigation(ROOT) }
        if want(only, "list") { sec_list() }
        if want(only, "accept") { sec_accept() }
        if want(only, "save") { sec_save() }
        if want(only, "folder") { sec_folder() }
        if want(only, "scroll") { sec_scroll() }
        if want(only, "keys") { sec_keys() }
        if want(only, "look") {
            look_theme(false)
            look_theme(true)
        }
        if want(only, "extra") { sec_extra() }
        if want(only, "pics") { sec_modes_look() }
        if want(only, "small") { sec_small_timing() }
        if want(only, "big") {
            let w1: f64 = sec_big(780, 520, "780x520")
            let w2: f64 = sec_big(1240, 720, "1240x720")
            report("worst_of_all", w1)
            if w2 > w1 { report("worst_of_all_1240", w2) }
        }
    }
    say("checks: ")
    say_num(CHECKS as i64)
    say(", wrong: ")
    say_num(BAD as i64)
    say("\n")
    if BAD == 0 {
        say("FILEDLG PASSED\n")
        return 0
    }
    say("FILEDLG FAILED\n")
    return 1
}
