// SPDX-License-Identifier: GPL-2.0-only
// tools/fui/anordnung_main.fi -- DIE ANORDNUNG WIRD NACHGERECHNET.
//
// Eine Anordnung faellt nicht laut um. Sie liegt um einen Bildpunkt
// daneben, und das sieht man erst auf einem Bildschirmfoto in Justins
// Aufloesung -- oder gar nicht. Darum wird hier gerechnet und nicht
// geschaut:
//
//   1. Die Teile eines Stapels ergeben GENAU den Raum. Kein Bildpunkt
//      fehlt an der rechten Kante, keiner ist zuviel.
//   2. Kein Kind ueberlappt seinen Nachbarn.
//   3. Der dehnbare bekommt den Rest, der feste behaelt seine Groesse.
//   4. Die Spalten eines Rasters summieren sich exakt auf die Breite --
//      auch bei einer Zahl, die nicht aufgeht (7 Spalten auf 100).
//   5. Ein Innenrand, der groesser ist als der Kasten, ergibt einen
//      LEEREN Kasten und keinen negativen.
import std.rt
import fui.anordnung

static mut G_FEHLER: usize = 0

fn sag(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "FALSCH  "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_FEHLER = G_FEHLER + 1
    }
    rt.buf_push(&t, 40 as u8)
    rt.buf_push_dec_i64(&t, a)
    rt.buf_push(&t, 47 as u8)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 41 as u8)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn main(start: u64) -> i32 {
    // ============================================ 1. DER WAAGRECHTE STAPEL
    //
    // Die Adressleiste von Certus: drei Knoepfe fest, das Adressfeld
    // dehnbar. Genau der Fall, den `chrome.fi` heute von Hand rechnet.
    var s: anordnung.Stapel = anordnung.stapel_neu(anordnung.WAAGRECHT)
    anordnung.stapel_setz_rand(&s, 6, 4, 8, 4)
    anordnung.stapel_setz_abstand(&s, 4)
    var wunsch: [i64; 4] = [32, 32, 32, 100]
    var dehnt: [i64; 4] = [0, 0, 0, 1]
    var quer: [i64; 4] = [32, 32, 32, 28]
    var aus: [anordnung.Kasten; 4] = [anordnung.kasten_neu(0,0,0,0); 4]
    let raum: anordnung.Kasten = anordnung.kasten_neu(0, 0, 1024, 40)
    anordnung.stapel_legen(&s, raum, (&wunsch[0]) as *mut i64,
        (&dehnt[0]) as *mut i64, (&quer[0]) as *mut i64,
        (&aus[0]) as *mut anordnung.Kasten, 4)

    // Die drei festen Knoepfe behalten ihre Groesse.
    var feste_ok: bool = true
    var i: usize = 0
    while i < 3 {
        if anordnung.kasten_w(&aus[i]) != 32 {
            feste_ok = false
        }
        i = i + 1
    }
    var n1: [u8; 34] = "1 feste Knoepfe behalten 32       "
    sag((&n1[0]) as u64, 34, feste_ok,
        anordnung.kasten_w(&aus[0]), 32)

    // DAS DEHNBARE FELD NIMMT DEN REST -- und der Stapel endet GENAU
    // an der rechten Kante minus Rand.
    let ende: i64 = anordnung.kasten_x(&aus[3])
        + anordnung.kasten_w(&aus[3])
    var n2: [u8; 34] = "1 Stapel endet genau am Rand      "
    sag((&n2[0]) as u64, 34, ende == 1024 - 8, ende, 1024 - 8)

    // KEINE UEBERLAPPUNG: jedes Kind faengt hinter dem vorigen an.
    var ueberlappt: bool = false
    var j: usize = 1
    while j < 4 {
        let vor_ende: i64 = anordnung.kasten_x(&aus[j - 1])
            + anordnung.kasten_w(&aus[j - 1])
        if anordnung.kasten_x(&aus[j]) < vor_ende {
            ueberlappt = true
        }
        j = j + 1
    }
    var n3: [u8; 34] = "1 keine Ueberlappung              "
    sag((&n3[0]) as u64, 34, !ueberlappt, 0, 0)

    // Der Abstand ist wirklich 4.
    let luecke: i64 = anordnung.kasten_x(&aus[1])
        - (anordnung.kasten_x(&aus[0]) + anordnung.kasten_w(&aus[0]))
    var n4: [u8; 34] = "1 Abstand zwischen Knoepfen ist 4 "
    sag((&n4[0]) as u64, 34, luecke == 4, luecke, 4)

    // ================================== 2. ZWEI DEHNBARE, UNGERADER REST
    //
    // 1000 Bildpunkte auf drei dehnbare Kinder: 333, 333, 334 -- und
    // NICHT 333, 333, 333 mit einem verlorenen Bildpunkt.
    var s2: anordnung.Stapel = anordnung.stapel_neu(anordnung.WAAGRECHT)
    var w2: [i64; 3] = [0, 0, 0]
    var d2: [i64; 3] = [1, 1, 1]
    var q2: [i64; 3] = [10, 10, 10]
    var a2: [anordnung.Kasten; 3] = [anordnung.kasten_neu(0,0,0,0); 3]
    anordnung.stapel_legen(&s2, anordnung.kasten_neu(0, 0, 1000, 10),
        (&w2[0]) as *mut i64, (&d2[0]) as *mut i64,
        (&q2[0]) as *mut i64, (&a2[0]) as *mut anordnung.Kasten, 3)
    let summe2: i64 = anordnung.kasten_w(&a2[0])
        + anordnung.kasten_w(&a2[1]) + anordnung.kasten_w(&a2[2])
    var n5: [u8; 34] = "2 drei Dehnbare ergeben 1000      "
    sag((&n5[0]) as u64, 34, summe2 == 1000, summe2, 1000)

    // ============================================ 3. DER SENKRECHTE STAPEL
    var s3: anordnung.Stapel = anordnung.stapel_neu(anordnung.SENKRECHT)
    anordnung.stapel_setz_abstand(&s3, 8)
    var w3: [i64; 3] = [32, 32, 32]
    var d3: [i64; 3] = [0, 0, 0]
    var q3: [i64; 3] = [200, 200, 200]
    var a3: [anordnung.Kasten; 3] = [anordnung.kasten_neu(0,0,0,0); 3]
    anordnung.stapel_legen(&s3, anordnung.kasten_neu(0, 0, 200, 200),
        (&w3[0]) as *mut i64, (&d3[0]) as *mut i64,
        (&q3[0]) as *mut i64, (&a3[0]) as *mut anordnung.Kasten, 3)
    let y2: i64 = anordnung.kasten_y(&a3[1])
    var n6: [u8; 34] = "3 senkrecht: zweites bei 40       "
    sag((&n6[0]) as u64, 34, y2 == 40, y2, 40)

    // ================================================== 4. DAS RASTER
    //
    // SIEBEN Spalten auf 100 Bildpunkte -- geht nicht auf. Die Summe
    // muss trotzdem exakt 100 sein.
    var r: anordnung.Raster = anordnung.raster_neu(7, 3)
    let rraum: anordnung.Kasten = anordnung.kasten_neu(0, 0, 100, 90)
    var summe_sp: i64 = 0
    var sp: usize = 0
    while sp < 7 {
        var z: anordnung.Kasten = anordnung.raster_zelle(&r, rraum, sp, 0)
        summe_sp = summe_sp + anordnung.kasten_w(&z)
        sp = sp + 1
    }
    var n7: [u8; 34] = "4 sieben Spalten ergeben 100      "
    sag((&n7[0]) as u64, 34, summe_sp == 100, summe_sp, 100)

    // Die letzte Spalte endet an der Kante.
    var letzte: anordnung.Kasten = anordnung.raster_zelle(&r, rraum, 6, 0)
    let r_ende: i64 = anordnung.kasten_x(&letzte)
        + anordnung.kasten_w(&letzte)
    var n8: [u8; 34] = "4 letzte Spalte endet bei 100     "
    sag((&n8[0]) as u64, 34, r_ende == 100, r_ende, 100)

    // Mit Abstand: 3 Spalten, Abstand 10, auf 100 -> 3x26 + 2x10 = 98
    // ... nein: ganz_x = 100 - 20 = 80, verteilt 27/26/27 = 80. Summe
    // mit Abstaenden = 100.
    var r2: anordnung.Raster = anordnung.raster_neu(3, 1)
    anordnung.raster_setz_abstand(&r2, 10, 0)
    var z0: anordnung.Kasten = anordnung.raster_zelle(&r2, rraum, 0, 0)
    var z2b: anordnung.Kasten = anordnung.raster_zelle(&r2, rraum, 2, 0)
    let r2_ende: i64 = anordnung.kasten_x(&z2b)
        + anordnung.kasten_w(&z2b)
    var n9: [u8; 34] = "4 Raster mit Abstand endet bei 100"
    sag((&n9[0]) as u64, 34, r2_ende == 100, r2_ende, 100)

    // ====================================== 5. RAND GROESSER ALS KASTEN
    //
    // Der Ueberlauf, an dem Justins Startmenue gestorben ist -- hier
    // muss ein LEERER Kasten herauskommen und keine Zahl nahe 2^64.
    let klein: anordnung.Kasten = anordnung.kasten_schrumpf(
        anordnung.kasten_neu(0, 0, 10, 10), 20, 20, 20, 20)
    var n10: [u8; 34] = "5 Rand > Kasten ergibt leer       "
    sag((&n10[0]) as u64, 34,
        anordnung.kasten_w(&klein) == 0 && anordnung.kasten_h(&klein) == 0,
        anordnung.kasten_w(&klein), 0)

    // ============================================ 6. QUER-AUSRICHTUNG
    var s4: anordnung.Stapel = anordnung.stapel_neu(anordnung.WAAGRECHT)
    anordnung.stapel_setz_ausricht(&s4, anordnung.A_MITTE)
    var w4: [i64; 1] = [50]
    var d4: [i64; 1] = [0]
    var q4: [i64; 1] = [20]
    var a4: [anordnung.Kasten; 1] = [anordnung.kasten_neu(0,0,0,0); 1]
    anordnung.stapel_legen(&s4, anordnung.kasten_neu(0, 0, 100, 100),
        (&w4[0]) as *mut i64, (&d4[0]) as *mut i64,
        (&q4[0]) as *mut i64, (&a4[0]) as *mut anordnung.Kasten, 1)
    let qy: i64 = anordnung.kasten_y(&a4[0])
    var n11: [u8; 34] = "6 quer mittig: y = 40             "
    sag((&n11[0]) as u64, 34, qy == 40, qy, 40)

    var t: rt.Buf = rt.buf_new()
    rt.buf_push(&t, 10 as u8)
    if G_FEHLER > 0 {
        var f: [u8; 30] = "ANORDNUNG NICHT IN ORDNUNG.\n\0\0"
        rt.buf_push_bytes(&t, (&f[0]) as u64, 28)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
        return 1
    }
    var o: [u8; 24] = "ANORDNUNG BESTANDEN.\n\0\0\0"
    rt.buf_push_bytes(&t, (&o[0]) as u64, 21)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 0
}
