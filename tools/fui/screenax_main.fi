import std.io
import fui.editor
import fui.kit
import fui.kitset
import fui.painter
import fui.render
import fui.theme
import fui.widget
import fui.screenax
import fui.screenaxtree
import fui.scene
import plat.fuiwirt

static mut BAD: usize = 0

fn expect(ok: bool, what: str) {
    if !ok {
        BAD = BAD + 1
        io.print_line(what)
    }
}

fn frame(a: u32) {
    screenax.begin()
    screenax.note(widget.KIND_BUTTON, 0 as u32, "Play", 10.0, 10.0, 80.0, 30.0, 0)
    screenax.note(widget.KIND_TOGGLE, screenax.F_CHECKED, "Sound", 10.0, 50.0, 40.0, 24.0, 0)
    screenax.note(widget.KIND_LABEL, screenax.F_HEADING, "Title", 10.0, 0.0, 100.0, 8.0, 0)
    screenax.note(widget.KIND_SLIDER, 0 as u32, "Volume", 10.0, 90.0, 200.0, 24.0, 300 + a as i64)
}

#[allow_escape]
fn main() -> i32 {
    screenax.install()
    frame(0 as u32)
    expect(screenax.count() == 4, "four nodes")
    expect(screenax.changed(), "first frame is new")
    let t: *mut screenaxtree.Tree = screenaxtree.tree_new("Test")
    screenaxtree.publish(t)
    expect(!screenax.changed(), "published")
    frame(0 as u32)
    expect(!screenax.changed(), "same frame, same hash")
    frame(1 as u32)
    expect(screenax.changed(), "value change shows")
    expect(scene.scene_count(screenaxtree.tree_scene(t)) == 5, "tree exists")
    expect(screenax.focus_step(false) && screenax.focus_index() == 0, "tab to first")
    expect(screenax.focus_step(false) && screenax.focus_index() == 1, "tab to toggle")
    expect(screenax.focus_step(false) && screenax.focus_index() == 3, "tab skips heading")
    expect(screenax.focus_step(false) && screenax.focus_index() == 0, "tab wraps")
    expect(screenax.focus_step(true) && screenax.focus_index() == 3, "shift tab wraps back")
    var tg: [f64; 2] = [0.0; 2]
    expect(screenax.target(&tg) && tg[0] == 110.0 && tg[1] == 102.0, "target is the centre")

    var m: theme.Theme = theme.theme_new(true)
    var cx: render.Ctx = render.ctx_new(&m, 0 as u64 as *mut painter.Painter)
    let s: *mut kitset.Set = kitset.set_new()
    (*s).ctx = (&cx) as u64
    kitset.reg_add(s, 6, kitset.SLIDER, 100.0, 300.0, 220.0, 24.0)
    (*s).lo[6] = 0
    (*s).hi[6] = 100
    kitset.press(s, 100.0, 310.0)
    expect(kitset.dragging(s) && kitset.val(s, 6) == 0, "press starts a drag at the left end")
    expect(kitset.pointer(s, fuiwirt.HOOK_MOVE, 210.0, 400.0) && kitset.val(s, 6) == 50, "drag follows x only")
    expect(kitset.pointer(s, fuiwirt.HOOK_MOVE, 5000.0, 0.0) && kitset.val(s, 6) == 100, "drag clamps right")
    expect(kitset.pointer(s, fuiwirt.HOOK_MOVE, -50.0, 0.0) && kitset.val(s, 6) == 0, "drag clamps left")
    let r0: u64 = kitset.revision(s)
    kitset.pointer(s, fuiwirt.HOOK_UP, 210.0, 0.0)
    expect(!kitset.dragging(s) && kitset.val(s, 6) == 50 && kitset.revision(s) > r0, "release ends the drag")
    expect(!kitset.pointer(s, fuiwirt.HOOK_MOVE, 300.0, 0.0) && kitset.val(s, 6) == 50, "no drag after release")
    kitset.press(s, 210.0, 310.0)
    kitset.pointer(s, fuiwirt.HOOK_UP, 210.0, 310.0)
    kitset.key(s, editor.KEY_HOME, 0 as u32)
    expect(kitset.val(s, 6) == 0, "Home")
    kitset.key(s, editor.KEY_END, 0 as u32)
    expect(kitset.val(s, 6) == 100, "End")
    kitset.key(s, editor.KEY_LEFT, 0 as u32)
    expect(kitset.val(s, 6) == 95, "Left")
    kitset.key(s, editor.KEY_PGDN, 0 as u32)
    expect(kitset.val(s, 6) == 70, "Page down")
    if BAD == 0 { io.print_line("screenax: all ok") }
    return BAD as i32
}
