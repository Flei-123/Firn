import std.io
import fui.editor
import fui.kit
import fui.kitset
import fui.mdedit
import fui.painter
import fui.render
import fui.theme
import fui.widget
import fui.screenax
import fui.screenaxtree
import fui.scene
import plat.fuiwirt

static mut BAD: usize = 0

fn expect(ok: bool, what: str) {
    if !ok {
        BAD = BAD + 1
        io.print_line(what)
    }
}

fn frame(a: u32) {
    screenax.begin()
    screenax.note(widget.KIND_BUTTON, 0 as u32, "Play", 10.0, 10.0, 80.0, 30.0, 0)
    screenax.note(widget.KIND_TOGGLE, screenax.F_CHECKED, "Sound", 10.0, 50.0, 40.0, 24.0, 0)
    screenax.note(widget.KIND_LABEL, screenax.F_HEADING, "Title", 10.0, 0.0, 100.0, 8.0, 0)
    screenax.note(widget.KIND_SLIDER, 0 as u32, "Volume", 10.0, 90.0, 200.0, 24.0, 300 + a as i64)
}

fn check_groups() {
    screenax.begin()
    screenax.group(2 as u32)
    screenax.note(widget.KIND_BUTTON, 0 as u32, "late", 0.0, 0.0, 10.0, 10.0, 0)
    screenax.group(1 as u32)
    screenax.note(widget.KIND_TEXTBOX, 0 as u32, "side field", 0.0, 20.0, 10.0, 10.0, 0)
    screenax.note(widget.KIND_BUTTON, 0 as u32, "side button", 0.0, 40.0, 10.0, 10.0, 0)
    screenax.group(0 as u32)
    screenax.note(widget.KIND_BUTTON, 0 as u32, "first", 0.0, 60.0, 10.0, 10.0, 0)
    screenax.focus_clear()
    expect(screenax.focus_step(false) && screenax.name_of(screenax.focus_index()) == "first", "group 0 is first")
    expect(screenax.focus_step(false) && screenax.name_of(screenax.focus_index()) == "side field", "then group 1 field")
    expect(screenax.focus_step(false) && screenax.name_of(screenax.focus_index()) == "side button", "then group 1 button")
    expect(screenax.focus_step(false) && screenax.name_of(screenax.focus_index()) == "late", "then group 2")
    expect(screenax.focus_step(false) && screenax.name_of(screenax.focus_index()) == "first", "wraps to group 0")
    expect(screenax.focus_step(true) && screenax.name_of(screenax.focus_index()) == "late", "shift tab goes to the last group")
    expect(screenax.focus_step(true) && screenax.name_of(screenax.focus_index()) == "side button", "shift tab walks back")
}

fn check_setters() {
    let s: *mut kitset.Set = kitset.set_new()
    kitset.reg_add(s, 3, kitset.SLIDER, 10.0, 10.0, 220.0, 24.0)
    (*s).lo[3] = 0
    (*s).hi[3] = 200
    kitset.set_val(s, 3, 40)
    kitset.reg_add(s, 4, kitset.FIELD, 10.0, 50.0, 220.0, 38.0)
    kitset.reg_add(s, 5, kitset.TOGGLE, 10.0, 100.0, 42.0, 24.0)
    screenax.begin()
    kitset.ax_row(s, 3, kitset.SLIDER, "Size", 10.0, 10.0, 220.0, 24.0)
    let si: usize = screenax.note_last()
    kitset.set_text(s, 4, "abc")
    kitset.ax_row(s, 4, kitset.FIELD, "Name", 10.0, 50.0, 220.0, 38.0)
    let fi: usize = screenax.note_last()
    kitset.ax_row(s, 5, kitset.TOGGLE, "Sound", 10.0, 100.0, 42.0, 24.0)
    let ti: usize = screenax.note_last()
    screenax.note(widget.KIND_TEXTBOX, 0 as u32, "Plain", 10.0, 140.0, 50.0, 20.0, 0)
    let pi: usize = screenax.note_last()
    expect(screenax.value_of(si) == 200, "slider value is per mille")
    expect(screenax.settable_num(si) && !screenax.settable_num(ti) && !screenax.settable_num(fi), "only the slider takes numbers")
    expect(screenax.settable_text(fi) && !screenax.settable_text(pi) && !screenax.settable_text(si), "only bound fields take text")
    expect(screenax.text_of(fi) == "abc", "field text is exposed")
    expect(screenax.apply_num(si, 500) && kitset.val(s, 3) == 100, "per mille 500 is half of 0..200")
    expect(screenax.apply_num(si, 9000) && kitset.val(s, 3) == 200, "clamped high")
    expect(screenax.apply_num(si, 0) && kitset.val(s, 3) == 0, "zero")
    expect(!screenax.apply_num(ti, 500) && !screenax.apply_num(fi, 500), "numbers refused elsewhere")
    expect(screenax.apply_text(fi, "hello") && kitset.text_of(s, 4) == "hello", "text lands in the field")
    expect(!screenax.apply_text(pi, "x") && !screenax.apply_text(si, "x"), "text refused elsewhere")
    screenax.begin()
    kitset.ax_row(s, 3, kitset.SLIDER, "Size", 10.0, 10.0, 220.0, 24.0)
    kitset.ax_row(s, 4, kitset.FIELD, "Name", 10.0, 50.0, 220.0, 38.0)
    expect(screenax.text_of(1) == "hello" && screenax.value_of(0) == 0, "next frame shows the new values")
    expect(screenax.changed(), "new values change the hash")
    let t: *mut screenaxtree.Tree = screenaxtree.tree_new("Set")
    screenaxtree.publish(t)
    let n: usize = screenaxtree.tree_node(t, 1)
    let wd: *mut widget.Widget = scene.node_widget(screenaxtree.tree_scene(t), n)
    expect(widget.w_text_len(wd) == 5, "tree widget carries the field text")
}

fn check_editor() {
    let s: *mut kitset.Set = kitset.set_new()
    kitset.reg_add(s, 4, kitset.FIELD, 10.0, 50.0, 220.0, 38.0)
    kitset.set_text(s, 4, "abc")
    let m: *mut mdedit.MdEd = mdedit.new()
    mdedit.set_text(m, "# Hi")
    screenax.begin()
    kitset.ax_row(s, 4, kitset.FIELD, "Name", 10.0, 50.0, 220.0, 38.0)
    mdedit.ax_editor_note(m, 10.0, 100.0, 300.0, 200.0)
    mdedit.ax_preview_note(m, 320.0, 100.0, 300.0, 200.0)
    expect(screenax.count() == 3, "field, editor and preview are nodes")
    expect(screenax.name_of(1) == "Note text" && screenax.kind_of(1) == widget.KIND_TEXTBOX, "editor name and role")
    expect(screenax.name_of(2) == "Preview" && screenax.kind_of(2) == widget.KIND_TEXTBOX, "preview name and role")
    expect(screenax.text_of(1) == "# Hi" && screenax.text_of(2) == "# Hi", "editor and preview expose the text")
    expect(screenax.settable_text(1) && !screenax.settable_text(2), "only the editor takes text")
    expect(screenax.focusable(1) && (screenax.state_of(1) & screenax.F_FOCUS) == 0 as u32, "editor is focusable, not focused")
    expect(screenax.apply_text(1, "from reader") && mdedit.text(m) == "from reader", "editor text lands in the document")
    expect(screenax.apply_text(0, "field") && kitset.text_of(s, 4) == "field", "field handler is not the editor handler")
    expect(!screenax.apply_text(2, "x") && mdedit.text(m) == "from reader", "preview refuses text")
    var car: usize = 99
    var anc: usize = 99
    expect(screenax.caret_of(1, &car, &anc) && car == 0 && anc == 0, "editor reports its caret")
    expect(!screenax.caret_of(0, &car, &anc) && !screenax.caret_of(2, &car, &anc), "field and preview have no caret")
    expect(screenax.apply_caret(1, 1, 3), "editor takes a caret and anchor")
    expect(!screenax.apply_caret(0, 1, 3) && !screenax.apply_caret(2, 1, 3), "no caret set on field and preview")
    screenax.begin()
    kitset.ax_row(s, 4, kitset.FIELD, "Name", 10.0, 50.0, 220.0, 38.0)
    mdedit.ax_editor_note(m, 10.0, 100.0, 300.0, 200.0)
    expect(screenax.caret_of(1, &car, &anc) && car == 3 && anc == 1, "next frame shows caret 3 and anchor 1")
    expect(screenax.apply_caret(1, 0, 99), "oversized caret is accepted")
    screenax.begin()
    mdedit.ax_editor_note(m, 10.0, 100.0, 300.0, 200.0)
    expect(screenax.caret_of(0, &car, &anc) && car == screenax.text_of(0).n && anc == 0, "oversized caret is clamped to the text end")
    screenax.begin()
    kitset.ax_row(s, 4, kitset.FIELD, "Name", 10.0, 50.0, 220.0, 38.0)
    mdedit.ax_editor_note(m, 10.0, 100.0, 300.0, 200.0)
    mdedit.ax_preview_note(m, 320.0, 100.0, 300.0, 200.0)
    screenax.set_focus_index(1)
    expect(screenax.owner_of(screenax.focus_index()) == m as u64, "focus lands on the editor owner")
    mdedit.ax_sync(m)
    screenax.begin()
    mdedit.ax_editor_note(m, 10.0, 100.0, 300.0, 200.0)
    expect((screenax.state_of(0) & screenax.F_FOCUS) != 0 as u32, "focused editor reports the focus")
    expect(screenax.text_of(0) == "from reader", "next frame shows the new text")
    editor_focus_flow(s, m)
}

fn editor_frame(s: *mut kitset.Set, m: *mut mdedit.MdEd) {
    screenax.begin()
    kitset.ax_row(s, 4, kitset.FIELD, "Name", 10.0, 50.0, 220.0, 38.0)
    mdedit.ax_editor_note(m, 10.0, 100.0, 300.0, 200.0)
    mdedit.ax_preview_note(m, 320.0, 100.0, 300.0, 200.0)
}

fn tree_focused(t: *mut screenaxtree.Tree, reg: usize) -> bool {
    let n: usize = screenaxtree.tree_node(t, reg)
    return widget.w_is_focus(scene.node_widget(screenaxtree.tree_scene(t), n))
}

fn editor_focus_flow(s: *mut kitset.Set, m: *mut mdedit.MdEd) {
    let t: *mut screenaxtree.Tree = screenaxtree.tree_new("Focus")
    editor_frame(s, m)
    screenax.set_focus_index(0)
    editor_frame(s, m)
    expect(!(*m).focus, "focus on the field takes it from the editor")
    expect((screenax.state_of(1) & screenax.F_FOCUS) == 0 as u32, "unfocused editor reports no focus")
    screenaxtree.publish(t)
    expect(tree_focused(t, 0) && !tree_focused(t, 1), "tab focus on the field shows in the tree")
    expect(!screenax.changed(), "published focus is not a change")
    expect(screenax.focus_step(false) && screenax.focus_index() == 1, "tab reaches the editor")
    expect(screenax.changed(), "moving the focus changes the tree")
    editor_frame(s, m)
    expect((*m).focus && (screenax.state_of(1) & screenax.F_FOCUS) != 0 as u32, "tab focus lands in the editor on the next frame")
    screenaxtree.publish(t)
    expect(tree_focused(t, 1) && !tree_focused(t, 0), "the tree moves the focus to the editor")
    expect(screenax.focus_step(false) && screenax.focus_index() == 2, "tab leaves the editor for the preview")
    editor_frame(s, m)
    expect(!(*m).focus && (screenax.state_of(1) & screenax.F_FOCUS) == 0 as u32, "editor drops the focus when it moves on")
    screenax.focus_clear()
    (*m).focus = true
    editor_frame(s, m)
    expect(screenax.focus_index() == 1 && (*m).focus, "mouse focus is registered as the tab focus")
    expect(screenax.focus_step(false) && screenax.focus_index() == 2, "tab continues after the mouse-focused editor")
}

#[allow_escape]
fn main() -> i32 {
    screenax.install()
    frame(0 as u32)
    expect(screenax.count() == 4, "four nodes")
    expect(screenax.changed(), "first frame is new")
    let t: *mut screenaxtree.Tree = screenaxtree.tree_new("Test")
    screenaxtree.publish(t)
    expect(!screenax.changed(), "published")
    frame(0 as u32)
    expect(!screenax.changed(), "same frame, same hash")
    frame(1 as u32)
    expect(screenax.changed(), "value change shows")
    expect(scene.scene_count(screenaxtree.tree_scene(t)) == 5, "tree exists")
    expect(screenax.focus_step(false) && screenax.focus_index() == 0, "tab to first")
    expect(screenax.focus_step(false) && screenax.focus_index() == 1, "tab to toggle")
    expect(screenax.focus_step(false) && screenax.focus_index() == 3, "tab skips heading")
    expect(screenax.focus_step(false) && screenax.focus_index() == 0, "tab wraps")
    expect(screenax.focus_step(true) && screenax.focus_index() == 3, "shift tab wraps back")
    var tg: [f64; 2] = [0.0; 2]
    expect(screenax.target(&tg) && tg[0] == 110.0 && tg[1] == 102.0, "target is the centre")

    var m: theme.Theme = theme.theme_new(true)
    var cx: render.Ctx = render.ctx_new(&m, 0 as u64 as *mut painter.Painter)
    let s: *mut kitset.Set = kitset.set_new()
    (*s).ctx = (&cx) as u64
    kitset.reg_add(s, 6, kitset.SLIDER, 100.0, 300.0, 220.0, 24.0)
    (*s).lo[6] = 0
    (*s).hi[6] = 100
    kitset.press(s, 100.0, 310.0)
    expect(kitset.dragging(s) && kitset.val(s, 6) == 0, "press starts a drag at the left end")
    expect(kitset.pointer(s, fuiwirt.HOOK_MOVE, 210.0, 400.0) && kitset.val(s, 6) == 50, "drag follows x only")
    expect(kitset.pointer(s, fuiwirt.HOOK_MOVE, 5000.0, 0.0) && kitset.val(s, 6) == 100, "drag clamps right")
    expect(kitset.pointer(s, fuiwirt.HOOK_MOVE, -50.0, 0.0) && kitset.val(s, 6) == 0, "drag clamps left")
    let r0: u64 = kitset.revision(s)
    kitset.pointer(s, fuiwirt.HOOK_UP, 210.0, 0.0)
    expect(!kitset.dragging(s) && kitset.val(s, 6) == 50 && kitset.revision(s) > r0, "release ends the drag")
    expect(!kitset.pointer(s, fuiwirt.HOOK_MOVE, 300.0, 0.0) && kitset.val(s, 6) == 50, "no drag after release")
    kitset.press(s, 210.0, 310.0)
    kitset.pointer(s, fuiwirt.HOOK_UP, 210.0, 310.0)
    kitset.key(s, editor.KEY_HOME, 0 as u32)
    expect(kitset.val(s, 6) == 0, "Home")
    kitset.key(s, editor.KEY_END, 0 as u32)
    expect(kitset.val(s, 6) == 100, "End")
    kitset.key(s, editor.KEY_LEFT, 0 as u32)
    expect(kitset.val(s, 6) == 95, "Left")
    kitset.key(s, editor.KEY_PGDN, 0 as u32)
    expect(kitset.val(s, 6) == 70, "Page down")
    screenax.begin()
    let j: usize = screenax.note_join(widget.KIND_BUTTON, 0 as u32, "Anna", "see you", 0.0, 0.0, 50.0, 20.0, 2)
    expect(j == 0 && screenax.count() == 1, "joined note added")
    expect(screenax.name_of(0) == "Anna: see you", "joined name")
    expect(screenax.name_of(0).n == 13, "joined length")
    check_groups()
    check_setters()
    check_editor()
    if BAD == 0 { io.print_line("screenax: all ok") }
    return BAD as i32
}
