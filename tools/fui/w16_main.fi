// SPDX-License-Identifier: MPL-2.0
// tools/fui/w16_main.fi -- keyboard model, headless: mnemonics (Alt+letter, '&'),
// Tab order end to end, shortcut management (parse / conflicts / rebind / save / load).
//
//   w16_main        "ok"/"WRONG" lines, then "W16 PASSED" and exit 0 when everything holds
import std.rt
import paint.canvas
import font.metrics
import fui.painter
import fui.scene
import fui.widget
import fui.control
import fui.action
import plat.fuiwirt
import plat.sysfont
import fui.app

static mut BAD: usize = 0
static mut TOTAL: usize = 0
static mut CLICKED: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    TOTAL = TOTAL + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn eq(a: str, b: str) -> bool {
    if a.n != b.n { return false }
    var i: usize = 0
    while i < a.n {
        if rt.ld8(a.p as u64, i) != rt.ld8(b.p as u64, i) { return false }
        i = i + 1
    }
    return true
}

fn letter(s: str) -> u32 { return control.mn_letter(s.p as u64, s.n) }
fn index(s: str) -> usize { return control.mn_index(s.p as u64, s.n) }

// ------------------------------------------------------------ A. mnemonic text

fn text_part() {
    say("== mnemonic text\n")
    check(letter("&Save") == 83 as u32, "&Save -> S")
    check(letter("Sa&ve") == 86 as u32, "Sa&ve -> V (upper-case)")
    check(letter("A && B") == 0 as u32, "&& is a literal ampersand, no mnemonic")
    check(letter("A && &B") == 66 as u32, "&& then &B -> B")
    check(letter("end&") == 0 as u32, "a trailing & marks nothing")
    check(letter("plain") == 0 as u32, "no marker, no mnemonic")
    check(index("Sa&ve") == 2, "underline index of Sa&ve is 2 (clean text)")
    check(index("A && &B") == 4, "underline index skips the doubled &")
    check(index("plain") == control.MN_NONE, "no index without marker")
    var buf: [u8; 32] = [0 as u8; 32]
    let tx: str = "A && &B"
    let n: usize = control.mn_clean(tx.p as u64, tx.n, (&buf[0]) as *mut u8, 32)
    check(n == 5, "clean text of A && &B has 5 bytes")
}

// ------------------------------------------------------------ B. the panel

fn panel_part() {
    say("== panel: Alt+letter\n")
    var ws: [widget.Widget; 6] = [widget.widget_new(widget.KIND_BUTTON); 6]
    ws[0] = widget.widget_new(widget.KIND_LABEL)
    widget.w_set_text(&ws[0], "&Name:".p as u64, 6)
    ws[1] = widget.widget_new(widget.KIND_TEXTBOX)
    ws[2] = widget.widget_new(widget.KIND_BUTTON)
    widget.w_set_text(&ws[2], "&Save".p as u64, 5)
    ws[3] = widget.widget_new(widget.KIND_CHECKBOX)
    widget.w_set_text(&ws[3], "Sa&fe mode".p as u64, 10)
    ws[4] = widget.widget_new(widget.KIND_BUTTON)
    widget.w_set_text(&ws[4], "&Delete".p as u64, 7)
    widget.w_set_disabled(&ws[4], true)
    ws[5] = widget.widget_new(widget.KIND_BUTTON)
    widget.w_set_text(&ws[5], "S&top".p as u64, 5)
    var pn: control.Panel = control.panel_new()
    control.panel_attach(&pn, (&ws[0]) as u64, 6)
    check(control.panel_alt_char(&pn, 83 as u32) == control.CH_NONE,
        "mnemonics are opt-in: Alt+S does nothing before panel_set_mnemonics")
    control.panel_set_mnemonics(&pn, true)
    check(control.panel_mnemonic_count(&pn, 83 as u32) == 1, "S is unique (Save; Stop has T)")
    let ch: u32 = control.panel_alt_char(&pn, 115 as u32)
    check((ch & control.CH_ACTIVATE) != 0 as u32 && control.panel_focus(&pn) == 2,
        "Alt+s (lower case) focuses and presses Save")
    let n: u32 = control.panel_alt_char(&pn, 78 as u32)
    check(control.panel_focus(&pn) == 1 && (n & control.CH_ACTIVATE) == 0 as u32,
        "Alt+N on the label '&Name:' moves the focus to the next control (the field)")
    check(control.panel_alt_char(&pn, 68 as u32) == control.CH_NONE,
        "Alt+D: a disabled button owns no mnemonic")
    check(control.panel_alt_char(&pn, 81 as u32) == control.CH_NONE, "Alt+Q: nobody owns Q")
    let t: u32 = control.panel_alt_char(&pn, 84 as u32)
    check(control.panel_focus(&pn) == 5 && (t & control.CH_ACTIVATE) != 0 as u32,
        "Alt+T presses Stop")
    // two owners of one letter: Alt moves the focus round robin, it does not press
    var w2: [widget.Widget; 3] = [widget.widget_new(widget.KIND_BUTTON); 3]
    widget.w_set_text(&w2[0], "&Open".p as u64, 5)
    widget.w_set_text(&w2[1], "O&k".p as u64, 3)
    w2[2] = widget.widget_new(widget.KIND_CHECKBOX)
    widget.w_set_text(&w2[2], "&Option".p as u64, 7)
    var p2: control.Panel = control.panel_new()
    control.panel_attach(&p2, (&w2[0]) as u64, 3)
    control.panel_set_mnemonics(&p2, true)
    check(control.panel_mnemonic_count(&p2, 79 as u32) == 2, "O has two owners (Open, Option)")
    let c1: u32 = control.panel_alt_char(&p2, 79 as u32)
    check(control.panel_focus(&p2) == 0 && (c1 & control.CH_ACTIVATE) == 0 as u32,
        "first Alt+O focuses Open without pressing")
    let c2: u32 = control.panel_alt_char(&p2, 79 as u32)
    check(control.panel_focus(&p2) == 2, "second Alt+O moves on to Option")
    let c3: u32 = control.panel_alt_char(&p2, 79 as u32)
    check(control.panel_focus(&p2) == 0, "third Alt+O wraps back to Open")
    // bound mnemonics (text without '&')
    var w3: [widget.Widget; 2] = [widget.widget_new(widget.KIND_BUTTON); 2]
    widget.w_set_text(&w3[0], "Print".p as u64, 5)
    widget.w_set_text(&w3[1], "Quit".p as u64, 4)
    var p3: control.Panel = control.panel_new()
    control.panel_attach(&p3, (&w3[0]) as u64, 2)
    check(control.panel_mn_bind(&p3, 1, 81 as u32, 0), "bind Q to Quit")
    check(control.panel_mn_index(&p3, 1) == 0 && control.panel_mn_index(&p3, 0) == control.MN_NONE,
        "bound index reported, unbound has none")
    let c4: u32 = control.panel_alt_char(&p3, 113 as u32)
    check(control.panel_focus(&p3) == 1 && (c4 & control.CH_ACTIVATE) != 0 as u32,
        "Alt+q presses the bound Quit although the panel is not in '&' mode")
    // lent tab order: the mnemonic round robin follows the tab order
    var ord: [usize; 3] = [2, 1, 0]
    control.panel_set_order(&p2, (&ord[0]) as u64, 3)
    control.panel_clear(&p2)
    let c5: u32 = control.panel_alt_char(&p2, 79 as u32)
    check(control.panel_focus(&p2) == 2, "with tab order [2,1,0] the first O owner is Option")
}

// ------------------------------------------------------------ C. end to end

fn on_click(a: *mut app.App) {
    CLICKED = CLICKED + 1
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h) || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn tab(a: *mut app.App, back: bool) {
    var m: u32 = 0 as u32
    if back { m = fuiwirt.MOD_SHIFT }
    let r: u32 = fuiwirt.host_key(app.app_host(a), fuiwirt.KEY_TAB, m)
}

fn e2e_part() {
    say("== end to end: Tab order and Alt+letter through the host\n")
    let a: *mut app.App = app.window("Form", 400, 300)
    app.set_text_mn(a, true)
    let lb: usize = app.label(a, "&Name:", 0)
    let e1: usize = app.entry(a, "name")
    let b1: usize = app.button(a, "&Save", on_click)
    let e2: usize = app.entry(a, "mail")
    let b2: usize = app.button(a, "&Cancel", on_click)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 400, 300)
    frame(a, s)
    check(eq(app.text(a, b1), "Save"), "the shown text has no '&' (Save)")
    check(eq(app.text(a, lb), "Name:"), "the label shows 'Name:'")
    check(app.focus(a) == app.NONE, "nobody has the focus at the start")
    tab(a, false)
    check(app.focus(a) == e1, "Tab 1 -> first entry (a label is skipped)")
    tab(a, false)
    check(app.focus(a) == b1, "Tab 2 -> Save")
    tab(a, false)
    check(app.focus(a) == e2, "Tab 3 -> second entry")
    tab(a, false)
    check(app.focus(a) == b2, "Tab 4 -> Cancel")
    tab(a, false)
    check(app.focus(a) == e1, "Tab 5 wraps to the first entry")
    tab(a, true)
    check(app.focus(a) == b2, "Shift+Tab goes back (wraps to Cancel)")
    tab(a, true)
    check(app.focus(a) == e2, "Shift+Tab -> second entry")
    // Alt+letter through the host
    let before: usize = CLICKED
    let ac: bool = app.app_char(a as u64, 115 as u32, 8 as u32)
    let ti: usize = fuiwirt.host_take_activated(app.app_host(a))
    if ti != fuiwirt.KEINER { app.app_act(a as u64, ti) }
    check(ac && ti == b1 && CLICKED == before + 1, "Alt+s presses Save (callback ran once)")
    check(app.focus(a) == b1, "...and the focus moved to Save")
    let an: bool = app.app_char(a as u64, 110 as u32, 8 as u32)
    check(an && app.focus(a) == e1, "Alt+n on the label 'Name:' focuses the first entry")
    check(fuiwirt.host_alt_char(app.app_host(a), 120 as u32) == control.CH_NONE,
        "Alt+x: nobody owns it (CH_NONE, the caller may try the shortcuts)")
    let cl: usize = CLICKED
    let ap: bool = app.app_char(a as u64, 115 as u32, 4 as u32)
    check(CLICKED == cl, "Ctrl+s is not the mnemonic of Save (callback not run)")
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("w16: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    text_part()
    panel_part()
    e2e_part()
    if BAD == 0 {
        say("W16 PASSED\n")
        return 0
    }
    say("W16 FAILED\n")
    return 1
}
