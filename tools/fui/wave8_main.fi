// SPDX-License-Identifier: MPL-2.0
// tools/fui/wave8_main.fi -- wave 8: spinner, time picker, breadcrumb, info bar, stepper (lib/fui/wave8.fi), the models
// of lib/fui/wave8m.fi (accordion, toolbar overflow, cell edit, insets, density, text scale) and the shortcut capture
// of lib/fui/keycapture.fi. Logic, geometry, pixels in both themes, mirrored (RTL).
//
//     wave8_main            prints one line per check, exit 0 when all hold
//     wave8_main <dir>      additionally writes wave8-light.png / wave8-dark.png into <dir>
import std.rt
import fui.safeout
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.style
import fui.editor
import fui.kit
import fui.kitcolor
import fui.action
import fui.wave8
import fui.wave8m
import fui.keycapture
import plat.sysfont

static mut BAD: usize = 0
static mut CHECKS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
    w: usize,
    h: usize,
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    kitcolor.kit_theme(&(*p).m, dark)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    (*p).w = w
    (*p).h = h
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn tok(p: *mut Page, t: u32) -> u32 {
    return theme.opaque(render.color_of(&(*p).c, style.color_token(t))) & 16777215 as u32
}

fn clear(p: *mut Page) {
    canvas.canvas_clear(&(*p).cv, tok(p, style.TOK_BASE) | (255 as u32) << 24)
}

fn px(p: *mut Page, x: f64, y: f64) -> u32 {
    return canvas.canvas_get(&(*p).cv, x as usize, y as usize) & 16777215 as u32
}

fn near(a: f64, b: f64, eps: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    return d <= eps
}

// ---------------------------------------------------------------- spinner
fn run_spinner(p: *mut Page, ts: str) {
    let c: *mut render.Ctx = &(*p).c
    say("-- spinner ")
    say(ts)
    say("\n")
    check(wave8.spinner_head(0 as i64) == 0 && wave8.spinner_head(250 as i64) == 3 && wave8.spinner_head(999 as i64) == 11 && wave8.spinner_head(1000 as i64) == 0 && wave8.spinner_head(-5 as i64) == 0,
        "head: one turn per second, 12 steps, negative clock = 0")
    var mono: bool = wave8.spinner_alpha(5, 5) == 255 as u32 && wave8.spinner_alpha(6, 5) == 40 as u32
    var i: usize = 1
    while i < 12 {
        // walking against the turning direction from the head, the dots fade
        if wave8.spinner_alpha((5 + 12 - i) % 12, 5) <= wave8.spinner_alpha((5 + 12 - i + 1) % 12, 5) {
            // ok
        } else {
            mono = false
        }
        i = i + 1
    }
    check(mono, "alpha: head 255, tail fades step by step down to 40")
    let col: u32 = tok(p, style.TOK_TEXT)
    let d: f64 = wave8.spinner_size(c)
    let x: f64 = 20.0
    let y: f64 = 20.0
    let dd: f64 = d / 6.0
    let rad: f64 = (d - dd) / 2.0
    let cx: f64 = x + d / 2.0
    let cy: f64 = y + d / 2.0
    clear(p)
    wave8.spinner_draw(c, x, y, d, 0 as i64, col)
    let top: u32 = px(p, cx, cy - rad)
    check(top == col, "head dot (12 o'clock at t = 0) has the full colour")
    check(px(p, cx - rad / 2.0 * 1.732 / 1.0 * 0.0 - rad * 0.5, cy - rad * 0.866) != top, "the next dot back (11 o'clock) is fainter")
    check(px(p, cx, cy) == tok(p, style.TOK_BASE), "the middle stays empty")
    clear(p)
    wave8.spinner_draw(c, x, y, d, -1 as i64, col)
    check(px(p, cx, cy - rad) == px(p, cx + rad, cy) && px(p, cx, cy - rad) != tok(p, style.TOK_BASE), "reduced motion: a still ring, every dot alike")
}

// ---------------------------------------------------------------- time picker
fn run_time(p: *mut Page, ts: str) {
    let c: *mut render.Ctx = &(*p).c
    say("-- time picker ")
    say(ts)
    say("\n")
    var t: wave8.Time = wave8.tp_new(14, 30, 5, true)
    var buf: [u8; 24] = [0 as u8; 24]
    check(t.h == 14 && t.m == 30 && wave8.tp_fields(&t) == 2 && wave8.tp_hour_shown(&t) == 14, "24 h: 14:30, two fields")
    var n: usize = wave8.tp_text(&t, wave8.TP_HOUR, &buf)
    check(n == 2 && buf[0] == 49 as u8 && buf[1] == 52 as u8, "text of the hour: 14")
    var t12: wave8.Time = wave8.tp_new(14, 30, 5, false)
    n = wave8.tp_text(&t12, wave8.TP_HOUR, &buf)
    check(wave8.tp_fields(&t12) == 3 && wave8.tp_hour_shown(&t12) == 2 && buf[0] == 48 as u8 && buf[1] == 50 as u8, "12 h: 14:30 shows 02, three fields")
    n = wave8.tp_text(&t12, wave8.TP_AMPM, &buf)
    check(buf[0] == 80 as u8 && buf[1] == 77 as u8, "12 h: PM")
    var w: wave8.Time = wave8.tp_new(23, 59, 1, true)
    check(wave8.tp_step(&w, wave8.TP_HOUR, 1) && w.h == 0 && w.m == 59, "hour wraps 23 -> 0 and leaves the minute")
    check(wave8.tp_step(&w, wave8.TP_MIN, 1) && w.m == 0 && w.h == 0, "minute wraps 59 -> 0 without carrying into the hour")
    var s: wave8.Time = wave8.tp_new(9, 7, 15, true)
    wave8.tp_step(&s, wave8.TP_MIN, 1)
    check(s.m == 15, "minute step 15: 7 -> 15 (on the grid)")
    wave8.tp_set(&s, 9, 52)
    wave8.tp_step(&s, wave8.TP_MIN, 1)
    check(s.m == 0, "minute step 15: 52 -> 0 (wraps)")
    wave8.tp_step(&s, wave8.TP_MIN, -1)
    check(s.m == 45, "minute step 15: 0 -> 45 backwards")
    var h12: wave8.Time = wave8.tp_new(11, 0, 1, false)
    wave8.tp_step(&h12, wave8.TP_HOUR, 1)
    check(h12.h == 0 && wave8.tp_hour_shown(&h12) == 12, "12 h: the hour wraps inside the half day (11 AM -> 12 AM)")
    var ap: wave8.Time = wave8.tp_new(9, 0, 1, false)
    wave8.tp_step(&ap, wave8.TP_AMPM, 1)
    check(ap.h == 21, "AM/PM toggles +12 h")
    wave8.tp_step(&ap, wave8.TP_AMPM, -1)
    check(ap.h == 9, "AM/PM toggles back")
    // keys
    var k: wave8.Time = wave8.tp_new(10, 20, 5, false)
    check(k.field == wave8.TP_HOUR, "starts on the hour")
    wave8.tp_key(&k, editor.KEY_RIGHT)
    wave8.tp_key(&k, editor.KEY_RIGHT)
    wave8.tp_key(&k, editor.KEY_RIGHT)
    check(k.field == wave8.TP_AMPM, "right moves to AM/PM and stops there (3 fields)")
    wave8.tp_key(&k, editor.KEY_LEFT)
    check(wave8.tp_key(&k, editor.KEY_UP) && k.m == 25, "up on the minute: +5")
    check(wave8.tp_key(&k, editor.KEY_END) && k.m == 55, "End on the minute: last step of the grid")
    check(wave8.tp_key(&k, editor.KEY_HOME) && k.m == 0, "Home on the minute: 0")
    wave8.tp_key(&k, editor.KEY_LEFT)
    check(wave8.tp_key(&k, editor.KEY_END) && k.h == 11, "End on the 12 h hour: 11 (stays AM)")
    wave8.tp_key(&k, editor.KEY_RIGHT)
    wave8.tp_key(&k, editor.KEY_RIGHT)
    check(wave8.tp_key(&k, editor.KEY_END) && k.h == 23, "End on AM/PM: PM")
    check(wave8.tp_wheel(&k, wave8.TP_MIN, -1), "wheel steps the field under the pointer")
    // digits
    var dg: wave8.Time = wave8.tp_new(0, 0, 1, true)
    wave8.tp_digit(&dg, 1)
    check(dg.h == 1 && dg.field == wave8.TP_HOUR, "digit 1: waits for a second digit")
    wave8.tp_digit(&dg, 4)
    check(dg.h == 14 && dg.field == wave8.TP_MIN, "digits 1 4: 14, on to the minute")
    wave8.tp_digit(&dg, 3)
    wave8.tp_digit(&dg, 0)
    check(dg.m == 30, "minute digits 3 0: 30")
    var d2: wave8.Time = wave8.tp_new(0, 0, 1, true)
    wave8.tp_digit(&d2, 7)
    check(d2.h == 7 && d2.field == wave8.TP_MIN, "24 h: a first digit 7 finishes the hour")
    var d3: wave8.Time = wave8.tp_new(0, 0, 1, true)
    wave8.tp_digit(&d3, 2)
    wave8.tp_digit(&d3, 5)
    check(d3.h == 5 && d3.field == wave8.TP_MIN, "24 h: 2 5 is no hour -> 5")
    var d4: wave8.Time = wave8.tp_new(15, 0, 1, false)
    wave8.tp_digit(&d4, 1)
    wave8.tp_digit(&d4, 2)
    check(d4.h == 12 && wave8.tp_hour_shown(&d4) == 12, "12 h: 1 2 in the afternoon: 12 PM")
    var d5: wave8.Time = wave8.tp_new(15, 0, 1, false)
    wave8.tp_digit(&d5, 0)
    wave8.tp_digit(&d5, 9)
    check(d5.h == 21 && d5.field == wave8.TP_MIN, "12 h: 0 9 -> 9 PM")
    check(!wave8.tp_digit(&dg, 99), "a digit above 9 is refused")
    // geometry + hit
    var ok: bool = true
    var f: usize = 0
    var lastx: f64 = 0.0
    while f < wave8.tp_fields(&t12) {
        var bx: f64 = 0.0
        var by: f64 = 0.0
        var bw: f64 = 0.0
        var bh: f64 = 0.0
        wave8.tp_rect(c, &t12, f, 100.0, 20.0, &bx, &by, &bw, &bh)
        if wave8.tp_hit(c, &t12, 100.0, 20.0, bx + bw / 2.0, by + bh / 2.0) != f || bx < lastx {
            ok = false
        }
        lastx = bx + bw
        f = f + 1
    }
    check(ok, "every field is hit at its centre, left to right")
    check(wave8.tp_hit(c, &t12, 100.0, 20.0, 5.0, 5.0) == wave8.TP_NONE && wave8.tp_hit(c, &t12, 100.0, 20.0, 100.0 + wave8.tp_width(c, &t12) + 4.0, 30.0) == wave8.TP_NONE, "outside is no field")
    check(lastx - 100.0 <= wave8.tp_width(c, &t12) + 0.01, "the width covers all fields")
    // pixels
    clear(p)
    t12.field = wave8.TP_MIN
    wave8.tp_draw(c, &t12, 100.0, 20.0, wave8.TP_NONE, true, true)
    var fx: f64 = 0.0
    var fy: f64 = 0.0
    var fw: f64 = 0.0
    var fh: f64 = 0.0
    wave8.tp_rect(c, &t12, wave8.TP_MIN, 100.0, 20.0, &fx, &fy, &fw, &fh)
    let accent: u32 = theme.opaque(kit.accent_gfx(c, style.TOK_BASE)) & 16777215 as u32
    check(px(p, fx + 4.0, fy + fh / 2.0) == accent, "the focused field is filled with the accent")
    wave8.tp_rect(c, &t12, wave8.TP_HOUR, 100.0, 20.0, &fx, &fy, &fw, &fh)
    check(px(p, fx + 4.0, fy + fh / 2.0) == tok(p, style.TOK_BUTTON), "the other fields are plain buttons")
    clear(p)
    wave8.tp_draw(c, &t12, 100.0, 20.0, wave8.TP_HOUR, false, true)
    check(px(p, fx + 4.0, fy + fh / 2.0) == tok(p, style.TOK_BUTTON_HOVER), "hover colours the field under the pointer")
}

// ---------------------------------------------------------------- breadcrumb
fn run_crumbs(p: *mut Page, ts: str) {
    let c: *mut render.Ctx = &(*p).c
    say("-- breadcrumb ")
    say(ts)
    say("\n")
    kit.kit_set_rtl(false)
    var cr: wave8.Crumbs = wave8.crumbs_new()
    wave8.crumbs_add(&cr, "Home")
    wave8.crumbs_add(&cr, "Projects")
    wave8.crumbs_add(&cr, "fUi")
    wave8.crumbs_add(&cr, "library")
    wave8.crumbs_add(&cr, "widgets")
    check(cr.n == 5, "five crumbs")
    check(wave8.bc_first(c, &cr, 600.0) == 0, "wide: nothing folds")
    let f1: usize = wave8.bc_first(c, &cr, 230.0)
    check(f1 > 0 && f1 < 4, "narrow: the first crumbs fold, the last stay")
    check(wave8.bc_first(c, &cr, 10.0) == 4, "tiny: only the last crumb is left")
    var ox: f64 = 0.0
    var oy: f64 = 0.0
    var ow: f64 = 0.0
    var oh: f64 = 0.0
    check(!wave8.bc_rect(c, &cr, 20.0, 80.0, 600.0, wave8.BC_OVERFLOW, &ox, &oy, &ow, &oh), "no overflow button when nothing is folded")
    check(wave8.bc_rect(c, &cr, 20.0, 80.0, 230.0, wave8.BC_OVERFLOW, &ox, &oy, &ow, &oh) && near(ox, 20.0, 0.01), "overflow button sits at the start edge")
    check(!wave8.bc_rect(c, &cr, 20.0, 80.0, 230.0, 0, &ox, &oy, &ow, &oh), "a folded crumb has no box")
    // hit all shown crumbs
    var okh: bool = true
    var i: usize = wave8.bc_first(c, &cr, 600.0)
    while i < 5 {
        if wave8.bc_rect(c, &cr, 20.0, 80.0, 600.0, i, &ox, &oy, &ow, &oh) {
            if wave8.bc_hit(c, &cr, 20.0, 80.0, 600.0, ox + ow / 2.0, oy + oh / 2.0) != i {
                okh = false
            }
        } else {
            okh = false
        }
        i = i + 1
    }
    check(okh, "every crumb is hit at its centre")
    check(wave8.bc_rect(c, &cr, 20.0, 80.0, 230.0, wave8.BC_OVERFLOW, &ox, &oy, &ow, &oh) && wave8.bc_hit(c, &cr, 20.0, 80.0, 230.0, ox + ow / 2.0, oy + oh / 2.0) == wave8.BC_OVERFLOW, "the overflow button is hit")
    check(wave8.bc_hit(c, &cr, 20.0, 80.0, 600.0, 15.0, 90.0) == wave8.BC_NONE && wave8.bc_hit(c, &cr, 20.0, 80.0, 600.0, 300.0, 200.0) == wave8.BC_NONE, "outside is no part")
    // focus walk
    check(wave8.bc_focus_step(c, &cr, 600.0, wave8.BC_NONE, 1) == 0 && wave8.bc_focus_step(c, &cr, 600.0, 0, 1) == 1 && wave8.bc_focus_step(c, &cr, 600.0, 4, 1) == 0, "focus walk wraps over 5 crumbs")
    check(wave8.bc_focus_step(c, &cr, 600.0, wave8.BC_NONE, -1) == 4 && wave8.bc_focus_step(c, &cr, 600.0, 0, -1) == 4, "focus walk backwards")
    let fz: usize = wave8.bc_first(c, &cr, 230.0)
    check(wave8.bc_focus_step(c, &cr, 230.0, wave8.BC_NONE, 1) == wave8.BC_OVERFLOW && wave8.bc_focus_step(c, &cr, 230.0, wave8.BC_OVERFLOW, 1) == fz, "folded: the walk starts at the overflow button, then the first shown crumb")
    // RTL
    kit.kit_set_rtl(true)
    var ax: f64 = 0.0
    var bx: f64 = 0.0
    wave8.bc_rect(c, &cr, 20.0, 80.0, 600.0, 0, &ax, &oy, &ow, &oh)
    wave8.bc_rect(c, &cr, 20.0, 80.0, 600.0, 1, &bx, &oy, &ow, &oh)
    check(ax > bx, "RTL: the first crumb is on the right")
    check(wave8.bc_hit(c, &cr, 20.0, 80.0, 600.0, ax + 3.0, 96.0) == 0, "RTL: hit follows the mirror")
    kit.kit_set_rtl(false)
    // pixels
    clear(p)
    wave8.bc_draw(c, &cr, 20.0, 80.0, 600.0, 1, wave8.BC_NONE)
    wave8.bc_rect(c, &cr, 20.0, 80.0, 600.0, 1, &ox, &oy, &ow, &oh)
    check(px(p, ox + ow / 2.0, oy + 2.0) == tok(p, style.TOK_BUTTON_HOVER), "hover colours the crumb under the pointer")
    wave8.bc_rect(c, &cr, 20.0, 80.0, 600.0, 2, &ox, &oy, &ow, &oh)
    check(px(p, ox + ow / 2.0, oy + 2.0) == tok(p, style.TOK_BASE), "the others stay plain")
    wave8.bc_rect(c, &cr, 20.0, 80.0, 600.0, 4, &ox, &oy, &ow, &oh)
    wave8.bc_draw(c, &cr, 20.0, 80.0, 600.0, 4, wave8.BC_NONE)
    check(px(p, ox + ow / 2.0, oy + 2.0) == tok(p, style.TOK_BASE), "the last crumb is the place you are: no hover fill")
}

// ---------------------------------------------------------------- info bar
fn run_infobar(p: *mut Page, ts: str) {
    let c: *mut render.Ctx = &(*p).c
    say("-- info bar ")
    say(ts)
    say("\n")
    kit.kit_set_rtl(false)
    var ib: wave8.InfoBar = wave8.infobar_new(wave8.IB_WARNING, "Update", "Restart to finish installing.")
    ib.action = "Restart"
    var ax: f64 = 0.0
    var ay: f64 = 0.0
    var aw: f64 = 0.0
    var ah: f64 = 0.0
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    var cw: f64 = 0.0
    var ch: f64 = 0.0
    check(wave8.ib_rect(c, &ib, 20.0, 130.0, 440.0, wave8.IB_PART_ACTION, &ax, &ay, &aw, &ah) && wave8.ib_rect(c, &ib, 20.0, 130.0, 440.0, wave8.IB_PART_CLOSE, &cx, &cy, &cw, &ch), "action and close have boxes")
    check(cx > ax + aw && cx + cw <= 460.0, "close is the last on the end edge, the action before it")
    check(wave8.ib_hit(c, &ib, 20.0, 130.0, 440.0, ax + aw / 2.0, ay + ah / 2.0) == wave8.IB_PART_ACTION && wave8.ib_hit(c, &ib, 20.0, 130.0, 440.0, cx + cw / 2.0, cy + ch / 2.0) == wave8.IB_PART_CLOSE && wave8.ib_hit(c, &ib, 20.0, 130.0, 440.0, 40.0, 154.0) == wave8.IB_PART_NONE, "hit: action, close, none")
    check(near(cy + cw / 2.0, 130.0 + wave8.ib_height(c) / 2.0, 0.01), "close is centred in the bar")
    var plain: wave8.InfoBar = wave8.infobar_new(wave8.IB_INFO, "Tip", "")
    plain.closable = false
    check(!wave8.ib_rect(c, &plain, 20.0, 130.0, 440.0, wave8.IB_PART_ACTION, &ax, &ay, &aw, &ah) && !wave8.ib_rect(c, &plain, 20.0, 130.0, 440.0, wave8.IB_PART_CLOSE, &cx, &cy, &cw, &ch), "no action, not closable: no boxes")
    check(wave8.ib_hit(c, &plain, 20.0, 130.0, 440.0, 440.0, 154.0) == wave8.IB_PART_NONE, "...and nothing to hit")
    check(wave8.ib_color(c, wave8.IB_INFO) != wave8.ib_color(c, wave8.IB_SUCCESS) && wave8.ib_color(c, wave8.IB_WARNING) != wave8.ib_color(c, wave8.IB_ERROR) && wave8.ib_color(c, wave8.IB_SUCCESS) != wave8.ib_color(c, wave8.IB_ERROR), "the severities have different colours")
    check(wave8.ib_icon(wave8.IB_INFO) != wave8.ib_icon(wave8.IB_ERROR) && wave8.ib_icon(wave8.IB_SUCCESS) != wave8.ib_icon(wave8.IB_WARNING), "...and different symbols")
    // contrast of the message colour against the bar: at least 3:1
    let th: *mut theme.Theme = render.ctx_theme(c)
    var allok: bool = true
    var sv: u32 = 0 as u32
    while sv < 4 as u32 {
        let col: u32 = wave8.ib_color(c, sv)
        let bg: u32 = (*theme.theme_colors(th)).surface_raised
        if theme.contrast(col & 16777215 as u32, bg & 16777215 as u32) < 2.95 {
            allok = false
        }
        sv = sv + 1 as u32
    }
    check(allok, "every message colour reads at 3:1 on the bar")
    // RTL
    kit.kit_set_rtl(true)
    wave8.ib_rect(c, &ib, 20.0, 130.0, 440.0, wave8.IB_PART_ACTION, &ax, &ay, &aw, &ah)
    wave8.ib_rect(c, &ib, 20.0, 130.0, 440.0, wave8.IB_PART_CLOSE, &cx, &cy, &cw, &ch)
    check(cx < ax && cx < 60.0, "RTL: close is at the left, before the action")
    kit.kit_set_rtl(false)
    // pixels
    clear(p)
    wave8.ib_draw(c, &ib, 20.0, 130.0, 440.0, wave8.IB_PART_NONE, wave8.IB_PART_NONE)
    let col: *mut theme.Colors = theme.theme_colors(th)
    let want: u32 = theme.mix((*col).surface_raised, wave8.ib_color(c, wave8.IB_WARNING), 120) & 16777215 as u32
    check(px(p, 240.0, 133.0) == want, "the bar is the raised surface tinted with the message colour")
    var ib2: wave8.InfoBar = wave8.infobar_new(wave8.IB_ERROR, "Failed", "")
    clear(p)
    wave8.ib_draw(c, &ib2, 20.0, 130.0, 440.0, wave8.IB_PART_NONE, wave8.IB_PART_NONE)
    check(px(p, 240.0, 133.0) != want, "an error bar is tinted differently")
    wave8.ib_rect(c, &ib, 20.0, 130.0, 440.0, wave8.IB_PART_CLOSE, &cx, &cy, &cw, &ch)
    clear(p)
    wave8.ib_draw(c, &ib, 20.0, 130.0, 440.0, wave8.IB_PART_CLOSE, wave8.IB_PART_NONE)
    check(px(p, cx + cw / 2.0, cy + 2.0) == tok(p, style.TOK_BUTTON_HOVER), "hover colours the close button")
}

// ---------------------------------------------------------------- stepper
fn run_stepper(p: *mut Page, ts: str) {
    let c: *mut render.Ctx = &(*p).c
    say("-- stepper ")
    say(ts)
    say("\n")
    kit.kit_set_rtl(false)
    var st: wave8.Steps = wave8.steps_new()
    wave8.steps_add(&st, "Account")
    wave8.steps_add(&st, "Profile")
    wave8.steps_add(&st, "Plan")
    wave8.steps_add(&st, "Done")
    check(st.n == 4, "four steps")
    var ox: f64 = 0.0
    var oy: f64 = 0.0
    var ow: f64 = 0.0
    var oh: f64 = 0.0
    var okh: bool = true
    var i: usize = 0
    while i < 4 {
        wave8.stepper_rect(c, &st, 20.0, 200.0, 440.0, i, &ox, &oy, &ow, &oh)
        if wave8.stepper_hit(c, &st, 20.0, 200.0, 440.0, ox + ow / 2.0, oy + 10.0) != i || !near(ow, 110.0, 0.01) {
            okh = false
        }
        i = i + 1
    }
    check(okh, "four equal columns, each hit at its centre")
    check(wave8.stepper_hit(c, &st, 20.0, 200.0, 440.0, 10.0, 210.0) == wave8.STEP_NONE && wave8.stepper_hit(c, &st, 20.0, 200.0, 440.0, 100.0, 400.0) == wave8.STEP_NONE, "outside is no step")
    check(wave8.stepper_key(4, 1, 2, editor.KEY_RIGHT) == 2 && wave8.stepper_key(4, 2, 2, editor.KEY_RIGHT) == 2, "right goes on until the furthest allowed step")
    check(wave8.stepper_key(4, 2, 2, editor.KEY_LEFT) == 1 && wave8.stepper_key(4, 0, 2, editor.KEY_LEFT) == 0, "left goes back, stops at 0")
    check(wave8.stepper_key(4, 2, 3, editor.KEY_HOME) == 0 && wave8.stepper_key(4, 0, 3, editor.KEY_END) == 3 && wave8.stepper_key(4, 0, 1, editor.KEY_END) == 1, "Home / End (End limited by the reach)")
    kit.kit_set_rtl(true)
    check(wave8.stepper_key(4, 1, 3, editor.KEY_LEFT) == 2, "RTL: left arrow = forward")
    var rx0: f64 = 0.0
    var rx1: f64 = 0.0
    wave8.stepper_rect(c, &st, 20.0, 200.0, 440.0, 0, &rx0, &oy, &ow, &oh)
    wave8.stepper_rect(c, &st, 20.0, 200.0, 440.0, 1, &rx1, &oy, &ow, &oh)
    check(rx0 > rx1, "RTL: the first step is on the right")
    kit.kit_set_rtl(false)
    // pixels: current = 1
    clear(p)
    wave8.stepper_draw(c, &st, 1, 20.0, 200.0, 440.0, wave8.STEP_NONE, wave8.STEP_NONE)
    let accent: u32 = theme.opaque(kit.accent_gfx(c, style.TOK_BASE)) & 16777215 as u32
    let d: f64 = kit.ln(c, 24)
    let cy: f64 = 200.0 + d / 2.0
    // centres: 20 + 55, +110, ...
    check(px(p, 75.0 - 8.0, cy) == accent, "done step: filled with the accent")
    check(px(p, 185.0 - 8.0, cy) == accent, "current step: filled with the accent")
    check(px(p, 295.0 - 8.0, cy) == tok(p, style.TOK_BASE), "todo step: empty inside")
    check(px(p, 130.0, cy) == accent, "connector after a done step: accent")
    check(px(p, 240.0, cy) != accent && px(p, 240.0, cy) != tok(p, style.TOK_BASE), "connector after the current step: the border colour")
}

// ---------------------------------------------------------------- models
fn run_models() {
    say("-- models\n")
    // accordion
    var a: wave8m.Accordion = wave8m.acc_new(4, true)
    check(wave8m.acc_open_count(&a) == 0, "accordion starts closed")
    check(wave8m.acc_toggle(&a, 1) && wave8m.acc_is_open(&a, 1), "toggle opens")
    check(wave8m.acc_set(&a, 3, true) && wave8m.acc_is_open(&a, 3) && !wave8m.acc_is_open(&a, 1) && wave8m.acc_open_count(&a) == 1, "exclusive: opening 3 closes 1")
    check(!wave8m.acc_set(&a, 3, true), "opening the open one changes nothing")
    check(wave8m.acc_toggle(&a, 3) && wave8m.acc_open_count(&a) == 0, "an exclusive group may close all")
    check(!wave8m.acc_set(&a, 9, true), "out of range is refused")
    var fr: wave8m.Accordion = wave8m.acc_new(3, false)
    wave8m.acc_set(&fr, 0, true)
    wave8m.acc_set(&fr, 2, true)
    check(wave8m.acc_open_count(&fr) == 2 && wave8m.acc_is_open(&fr, 0) && wave8m.acc_is_open(&fr, 2), "free group: several open")
    wave8m.acc_key(&fr, editor.KEY_DOWN)
    wave8m.acc_key(&fr, editor.KEY_DOWN)
    check(fr.focus == 2, "keys: down moves the header focus")
    check(wave8m.acc_key(&fr, editor.KEY_ENTER) && !wave8m.acc_is_open(&fr, 2), "Enter toggles the focused section")
    wave8m.acc_key(&fr, editor.KEY_HOME)
    check(fr.focus == 0, "Home")
    wave8m.acc_key(&fr, editor.KEY_UP)
    check(fr.focus == 0, "up at the top stays")
    var big: wave8m.Accordion = wave8m.acc_new(200, false)
    check(big.n == 64 && wave8m.acc_set(&big, 63, true) && wave8m.acc_is_open(&big, 63), "64 sections at most, the last works")
    // toolbar
    var tb: wave8m.Toolbar = wave8m.toolbar_new()
    wave8m.toolbar_add(&tb, 40.0, 0 as u32)
    wave8m.toolbar_add(&tb, 40.0, 2 as u32)
    wave8m.toolbar_add(&tb, 40.0, 1 as u32)
    wave8m.toolbar_add(&tb, 40.0, 2 as u32)
    var mk: u64 = wave8m.toolbar_fit(&tb, 400.0, 4.0, 32.0)
    check(mk == 15 as u64 && wave8m.toolbar_hidden(&tb, mk) == 0, "wide: all four fit, no chevron")
    mk = wave8m.toolbar_fit(&tb, 170.0, 4.0, 32.0)
    check(mk == 7 as u64 && wave8m.toolbar_hidden(&tb, mk) == 1, "170: the LAST item of the highest prio folds (needs 164 + chevron)")
    mk = wave8m.toolbar_fit(&tb, 130.0, 4.0, 32.0)
    check(mk == 5 as u64, "130: then the other prio-2 item, prio 1 and 0 stay")
    mk = wave8m.toolbar_fit(&tb, 90.0, 4.0, 32.0)
    check(mk == 1 as u64, "90: only the never-fold item (prio 0) is left")
    mk = wave8m.toolbar_fit(&tb, 10.0, 4.0, 32.0)
    check(mk == 1 as u64, "10: prio 0 never folds, the rest is the caller's clipping")
    var tb2: wave8m.Toolbar = wave8m.toolbar_new()
    var tn: usize = 0
    while tn < 40 {
        wave8m.toolbar_add(&tb2, 10.0, 1 as u32)
        tn = tn + 1
    }
    check(tb2.n == 32, "32 items at most")
    // cell edit
    var e: wave8m.CellEdit = wave8m.cell_new(3, 4)
    wave8m.cell_set_readonly(&e, 1, true)
    check(!wave8m.cell_editable(&e, 1) && wave8m.cell_editable(&e, 0), "column 1 is read-only")
    check(wave8m.cell_key(&e, editor.KEY_DOWN, false) == wave8m.CE_MOVED && e.row == 1, "down moves the cursor")
    check(wave8m.cell_key(&e, editor.KEY_UP, false) == wave8m.CE_MOVED && wave8m.cell_key(&e, editor.KEY_UP, false) == wave8m.CE_NONE, "up, then stops at the top")
    check(wave8m.cell_key(&e, editor.KEY_END, false) == wave8m.CE_MOVED && e.col == 3, "End: last column")
    check(wave8m.cell_key(&e, editor.KEY_RIGHT, false) == wave8m.CE_NONE, "right at the last column: nothing")
    wave8m.cell_key(&e, editor.KEY_HOME, false)
    check(wave8m.cell_key(&e, editor.KEY_ENTER, false) == wave8m.CE_BEGIN && wave8m.cell_editing(&e) && e.mode == wave8m.CE_KEEP, "Enter begins an edit that keeps the text")
    check(wave8m.cell_key(&e, editor.KEY_LEFT, false) == wave8m.CE_NONE && e.col == 0, "while editing the arrow keys belong to the text field")
    check(wave8m.cell_key(&e, editor.KEY_ENTER, false) == wave8m.CE_COMMIT && !wave8m.cell_editing(&e) && e.last_row == 0 && e.row == 1, "Enter commits (cell 0,0) and goes down")
    wave8m.cell_key(&e, editor.KEY_RIGHT, false)
    check(e.col == 1 && wave8m.cell_type(&e) == wave8m.CE_NONE && !wave8m.cell_editing(&e), "a read-only cell does not begin an edit")
    wave8m.cell_key(&e, editor.KEY_LEFT, false)
    check(wave8m.cell_type(&e) == wave8m.CE_BEGIN && e.mode == wave8m.CE_REPLACE, "typing begins an edit that replaces the text")
    check(wave8m.cell_key(&e, editor.KEY_TAB, false) == wave8m.CE_COMMIT && e.col == 2 && e.row == 1 && e.last_col == 0, "Tab commits and skips the read-only column 1")
    wave8m.cell_begin(&e, wave8m.CE_KEEP)
    check(wave8m.cell_key(&e, editor.KEY_ESC, false) == wave8m.CE_CANCEL && !wave8m.cell_editing(&e) && e.col == 2, "Esc cancels, the cursor stays")
    wave8m.cell_key(&e, editor.KEY_END, false)
    wave8m.cell_begin(&e, wave8m.CE_KEEP)
    wave8m.cell_key(&e, editor.KEY_TAB, false)
    check(e.row == 2 && e.col == 0 && !wave8m.cell_editing(&e), "Tab at the row end wraps to the next row")
    wave8m.cell_begin(&e, wave8m.CE_KEEP)
    wave8m.cell_key(&e, editor.KEY_TAB, true)
    check(e.row == 1 && e.col == 3, "Shift+Tab goes back across the row break")
    wave8m.cell_begin(&e, wave8m.CE_KEEP)
    check(wave8m.cell_click(&e, 1, 3, false) == wave8m.CE_NONE && wave8m.cell_editing(&e), "a click inside the edited cell is the text field's")
    check(wave8m.cell_click(&e, 2, 2, false) == wave8m.CE_COMMIT && !wave8m.cell_editing(&e) && e.row == 2 && e.col == 2 && e.last_row == 1, "a click on another cell commits and moves there")
    check(wave8m.cell_click(&e, 0, 0, false) == wave8m.CE_MOVED && wave8m.cell_click(&e, 0, 0, true) == wave8m.CE_BEGIN, "click selects, double click begins")
    check(wave8m.cell_click(&e, 9, 9, false) == wave8m.CE_NONE, "a click outside the table is refused")
    wave8m.cell_key(&e, editor.KEY_ESC, false)
    // the last cell of the table
    var z: wave8m.CellEdit = wave8m.cell_new(1, 2)
    wave8m.cell_key(&z, editor.KEY_END, false)
    wave8m.cell_begin(&z, wave8m.CE_KEEP)
    check(wave8m.cell_key(&z, editor.KEY_TAB, false) == wave8m.CE_COMMIT && z.row == 0 && z.col == 1, "Tab in the very last cell commits and stays")
    var emp: wave8m.CellEdit = wave8m.cell_new(0, 3)
    check(wave8m.cell_key(&emp, editor.KEY_DOWN, false) == wave8m.CE_NONE && wave8m.cell_begin(&emp, wave8m.CE_KEEP) == wave8m.CE_NONE, "an empty table does nothing")
    // insets
    var sa: wave8m.Insets = wave8m.insets_zero()
    sa.top = 24.0
    sa.bottom = 16.0
    var kb: wave8m.Insets = wave8m.insets_zero()
    kb.bottom = 300.0
    let m: wave8m.Insets = wave8m.insets_max(sa, kb)
    check(near(m.bottom, 300.0, 0.01) && near(m.top, 24.0, 0.01), "max: per edge the larger source")
    let ad: wave8m.Insets = wave8m.insets_add(sa, kb)
    check(near(ad.bottom, 316.0, 0.01), "add: stacked sources")
    var side: wave8m.Insets = wave8m.insets_zero()
    side.left = 40.0
    side.right = 10.0
    check(near(wave8m.insets_start(side, false), 40.0, 0.01) && near(wave8m.insets_start(side, true), 10.0, 0.01) && near(wave8m.insets_end(side, true), 40.0, 0.01), "start / end swap in RTL")
    check(near(wave8m.insets_lift(100.0, 40.0, 800.0, 300.0, 8.0), 0.0, 0.01), "field above the keyboard: no lift")
    check(near(wave8m.insets_lift(600.0, 40.0, 800.0, 300.0, 8.0), 148.0, 0.01), "field under the keyboard: lifted to sit 8 above it")
    check(near(wave8m.insets_lift(10.0, 100.0, 400.0, 350.0, 8.0), 10.0, 0.01), "no room at all: aligned at its own top, never lifted past it")
    // density
    check(wave8m.density_pick(wave8m.DENS_COMPACT, false) == wave8m.DENS_COMPACT && wave8m.density_pick(wave8m.DENS_COMPACT, true) == wave8m.DENS_COMFORTABLE, "a coarse pointer never gets compact")
    check(wave8m.density_len(wave8m.DENS_COMFORTABLE, 40) == 40 && wave8m.density_len(wave8m.DENS_COMPACT, 40) == 32 && wave8m.density_len(wave8m.DENS_COMPACT, 10) == 8, "compact = 80 %")
    check(wave8m.density_row_h(wave8m.DENS_COMPACT, 32) == 26 && wave8m.density_row_h(wave8m.DENS_COMPACT, 28) == 24 && wave8m.density_row_h(wave8m.DENS_COMPACT, 20) == 16, "row height: not under 24 for rows that start at 24+")
    // text scale
    check(wave8m.textscale_clamp(500 as i64) == 850 as i64 && wave8m.textscale_clamp(5000 as i64) == 2000 as i64 && wave8m.textscale_clamp(1300 as i64) == 1300 as i64, "text scale clamps to 85..200 %")
    check(wave8m.textscale_snap(1137 as i64) == 1125 as i64 && wave8m.textscale_snap(1140 as i64) == 1150 as i64 && wave8m.textscale_from_percent(130 as i64) == 1300 as i64, "snap to 2.5 % steps")
    check(near(wave8m.textscale_size(16.0, 1500 as i64), 24.0, 0.001) && near(wave8m.textscale_size(16.0, 100 as i64), 13.6, 0.001) && wave8m.textscale_size(0.5, 1000 as i64) == 1.0, "size = size * factor, never under 1")
}

// ---------------------------------------------------------------- key capture
fn nop(ud: u64, cx: *mut action.ActCtx) {
}

fn run_capture() {
    say("-- key capture\n")
    var reg: action.Actions = action.actions_new()
    let r: *mut action.Actions = &reg
    let copy: usize = action.act_add(r, "copy", "Copy", nop, 0 as u64)
    let cut: usize = action.act_add(r, "cut", "Cut", nop, 0 as u64)
    action.act_set_shortcut(r, copy, 67 as u32, action.MOD_CTRL)
    action.act_set_shortcut(r, cut, 88 as u32, action.MOD_CTRL)
    var cap: keycapture.Capture = keycapture.cap_new()
    check(keycapture.cap_key(&cap, r, 65 as u32, action.MOD_CTRL) == keycapture.CAP_IDLE, "not capturing: keys are ignored")
    keycapture.cap_begin(&cap, cut)
    check(cap.active && keycapture.cap_key(&cap, r, 0 as u32, action.MOD_CTRL) == keycapture.CAP_WAIT && cap.active, "a modifier alone keeps waiting")
    check(keycapture.cap_key(&cap, r, 65 as u32, 0 as u32) == keycapture.CAP_INVALID && cap.active, "a bare letter is invalid (it would eat typing), still capturing")
    check(keycapture.cap_key(&cap, r, 67 as u32, action.MOD_CTRL) == keycapture.CAP_CONFLICT && cap.owner == copy && action.act_key(r, cut) == 88 as u32, "Ctrl+C is taken by Copy: conflict, nothing changed")
    check(keycapture.cap_confirm(&cap, r) == keycapture.CAP_DONE && action.act_key(r, cut) == 67 as u32 && action.act_key(r, copy) == 0 as u32 && !cap.active, "confirming takes it from the holder")
    keycapture.cap_begin(&cap, cut)
    check(keycapture.cap_key(&cap, r, 88 as u32, action.MOD_CTRL | action.MOD_SHIFT) == keycapture.CAP_DONE && action.act_mods(r, cut) == (action.MOD_CTRL | action.MOD_SHIFT) && !cap.active, "a free combination is bound at once")
    keycapture.cap_begin(&cap, cut)
    check(keycapture.cap_key(&cap, r, action.SK_ESCAPE, 0 as u32) == keycapture.CAP_CANCEL && !cap.active && action.act_key(r, cut) == 88 as u32, "Esc gives up, binding unchanged")
    keycapture.cap_begin(&cap, cut)
    check(keycapture.cap_key(&cap, r, action.SK_BACKSPACE, 0 as u32) == keycapture.CAP_CLEARED && action.act_key(r, cut) == 0 as u32, "Backspace removes the shortcut")
    keycapture.cap_begin(&cap, cut)
    keycapture.cap_key(&cap, r, 67 as u32, action.MOD_CTRL)
    keycapture.cap_cancel(&cap)
    check(!cap.active && keycapture.cap_confirm(&cap, r) == keycapture.CAP_IDLE, "answering no ends it; a late yes does nothing")
}

fn run_pictures(dir: u64, font: u64) {
    var d: usize = 0
    while d < 2 {
        let dark: bool = d == 1
        let p: *mut Page = page_new(480, 320, dark, font)
        if p as u64 == 0 {
            return
        }
        let c: *mut render.Ctx = &(*p).c
        kit.kit_set_rtl(false)
        clear(p)
        wave8.spinner_draw(c, 20.0, 20.0, wave8.spinner_size(c), 250 as i64, tok(p, style.TOK_TEXT))
        var t: wave8.Time = wave8.tp_new(14, 30, 5, false)
        wave8.tp_draw(c, &t, 100.0, 20.0, wave8.TP_MIN, true, true)
        var cr: wave8.Crumbs = wave8.crumbs_new()
        wave8.crumbs_add(&cr, "Home")
        wave8.crumbs_add(&cr, "Projects")
        wave8.crumbs_add(&cr, "fUi")
        wave8.crumbs_add(&cr, "widgets")
        wave8.bc_draw(c, &cr, 20.0, 80.0, 440.0, 1, wave8.BC_NONE)
        var ib: wave8.InfoBar = wave8.infobar_new(wave8.IB_WARNING, "Update ready", "Restart to finish.")
        ib.action = "Restart"
        wave8.ib_draw(c, &ib, 20.0, 124.0, 440.0, wave8.IB_PART_NONE, wave8.IB_PART_NONE)
        var ie: wave8.InfoBar = wave8.infobar_new(wave8.IB_ERROR, "Upload failed", "Check your connection.")
        wave8.ib_draw(c, &ie, 20.0, 180.0, 440.0, wave8.IB_PART_NONE, wave8.IB_PART_NONE)
        var st: wave8.Steps = wave8.steps_new()
        wave8.steps_add(&st, "Account")
        wave8.steps_add(&st, "Profile")
        wave8.steps_add(&st, "Plan")
        wave8.steps_add(&st, "Done")
        wave8.stepper_draw(c, &st, 1, 20.0, 240.0, 440.0, wave8.STEP_NONE, wave8.STEP_NONE)
        if dark {
            save(&(*p).cv, dir, "wave8-dark.png")
        } else {
            save(&(*p).cv, dir, "wave8-light.png")
        }
        d = d + 1
    }
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("wave8: no font (DejaVu Sans)\n")
        return 9
    }
    var d: usize = 0
    while d < 2 {
        let dark: bool = d == 1
        var ts: str = "light"
        if dark {
            ts = "dark"
        }
        let p: *mut Page = page_new(480, 320, dark, fs as u64)
        if p as u64 == 0 {
            say("no page\n")
            return 2
        }
        run_spinner(p, ts)
        run_time(p, ts)
        run_crumbs(p, ts)
        run_infobar(p, ts)
        run_stepper(p, ts)
        d = d + 1
    }
    run_models()
    run_capture()
    run_pictures(dir, fs as u64)
    say("checks: ")
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&nb, CHECKS as u64)
    rt.write_everything(1, rt.buf_ptr(&nb), rt.buf_len(&nb))
    rt.buf_free(&nb)
    say("\n")
    if BAD == 0 {
        say("WAVE8 PASSED\n")
        return 0
    }
    say("WAVE8 FAILED\n")
    return 1
}
