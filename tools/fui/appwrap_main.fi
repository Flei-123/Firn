import std.rt
import paint.canvas
import font.metrics
import fui.painter
import fui.scene
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.app
import fui.appctl
import fui.editor

static mut BAD: usize = 0
static mut FONT: u64 = 0
static mut CLOSED: usize = 0

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h) || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    fuiwirt.host_bind(app.app_host(a))
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn lines_of_label(a: *mut app.App, id: usize) -> usize {
    return widget.w_text_lines(scene.node_widget(app.app_scene(a), id))
}

fn left(a: *mut app.App, id: usize) -> f64 {
    return scene.node_x(app.app_scene(a), id)
}

fn right(a: *mut app.App, id: usize) -> f64 {
    return scene.node_x(app.app_scene(a), id) + scene.node_w(app.app_scene(a), id)
}

fn bottom(a: *mut app.App, id: usize) -> f64 {
    return scene.node_y(app.app_scene(a), id) + scene.node_h(app.app_scene(a), id)
}

fn click(a: *mut app.App, s: *mut Surface, x: f64, y: f64) {
    let w: *mut fuiwirt.Host = app.app_host(a)
    let c1: u32 = fuiwirt.host_pointer_move(w, x, y)
    let c2: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let c3: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
    let i: usize = fuiwirt.host_take_activated(w)
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
    frame(a, s)
}

fn click_node(a: *mut app.App, s: *mut Surface, id: usize) {
    let sc: *mut scene.Scene = app.app_scene(a)
    click(a, s, scene.node_x(sc, id) + scene.node_w(sc, id) / 2.0, scene.node_y(sc, id) + scene.node_h(sc, id) / 2.0)
}

static mut CHANGES: usize = 0
static mut PICKED: usize = 0

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn pick_one(a: *mut app.App) {
    PICKED = 1
}

fn pick_two(a: *mut app.App) {
    PICKED = 2
}

fn nothing(a: *mut app.App) {}

const LONG: str = "A long sentence that is much wider than any of these small windows and has to wrap into several lines"
const VERY_LONG: str = "one two three four five six seven eight nine ten eleven twelve thirteen fourteen fifteen sixteen seventeen eighteen nineteen twenty twentyone twentytwo twentythree twentyfour twentyfive twentysix twentyseven twentyeight twentynine thirty thirtyone thirtytwo thirtythree thirtyfour thirtyfive thirtysix thirtyseven thirtyeight thirtynine forty fortyone fortytwo fortythree fortyfour fortyfive fortysix fortyseven fortyeight fortynine fifty"

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appwrap: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Wrap", 240, 900)
    let card: usize = app.card(a)
    let in_card: usize = app.label(a, LONG, 0)
    app.end(a)
    let row: usize = app.row(a)
    let ok_button: usize = app.button(a, "OK", nothing)
    let beside: usize = app.label(a, LONG, 0)
    app.end(a)
    let tall: usize = app.label(a, VERY_LONG, 0)
    let dark: usize = appctl.checkbox(a, "Dark mode", false, changed)
    let vol: usize = appctl.slider(a, "Volume", 0, 100, 10, changed)
    let l: usize = app.list(a)
    let first: usize = app.list_item(a, "", "First", "", "", pick_one)
    let second: usize = app.list_item(a, "", "Second", "", "", pick_two)
    app.end(a)
    let s: *mut Surface = surface_for(a, 240, 900)
    frame(a, s)
    frame(a, s)
    check(lines_of_label(a, in_card) >= 2, "a label in a card wraps")
    check(left(a, in_card) >= left(a, card) && right(a, in_card) <= right(a, card) + 0.5, "the wrapped label stays inside its card")
    check(lines_of_label(a, beside) >= 2, "a label beside a button wraps")
    check(right(a, ok_button) <= left(a, beside) + 0.5 && right(a, beside) <= 240.0, "it leaves room for the button and stays in the window")
    check(lines_of_label(a, tall) > 8, "more than eight lines are possible")
    check(right(a, tall) <= 240.0 && bottom(a, tall) <= 900.0, "a tall label stays inside the window")
    click_node(a, s, dark)
    check(appctl.checked(a, dark) && CHANGES == 1, "app controls: a check box flips and calls back")
    click(a, s, right(a, vol) - 6.0, scene.node_y(app.app_scene(a), vol) + scene.node_h(app.app_scene(a), vol) / 2.0)
    check(appctl.value(a, vol) > 80, "app controls: a click on the slider moves its value")
    click_node(a, s, second)
    check(PICKED == 2 && app.chosen(a, l) == second, "app controls: a list row is chosen and calls back")
    check(app.audit(a) == 0, "accessibility audit: no unnamed element")
    if BAD == 0 {
        say("APPWRAP PASSED\n")
        return 0
    }
    say("APPWRAP FAILED\n")
    return 1
}
