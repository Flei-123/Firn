// SPDX-License-Identifier: MPL-2.0
// tools/fui/ctxmenu_main.fi -- THE CHECK OF THE CONTEXT MENU SYSTEM
// (lib/fui/action.fi, lib/fui/ctxmenu.fi; roadmap r161, docs/CONTEXT-MENUS.md).
//
// Without a window: requests are made by hand, the model is read back.
//
//   1. ACTIONS: the registry, shortcuts, mnemonics, the bus manifest, the
//      run-by-bus-name path, labels through a catalog.
//   2. THE REQUEST CHAIN: providers per node key / widget kind / global, the
//      merge (groups, priorities, separators, duplicates, nearest wins,
//      submenus merged and pruned), multi selection, plugin entries and
//      the rights check, the selection rule.
//   3. THE STATE: keyboard (arrows, Home/End, Enter, Esc, Left/Right,
//      mnemonics, typeahead), hover delay, outside press, focus loss,
//      window change, the screen lock, activation closes first.
//   4. PLACEMENT: flip at the right / bottom edge, clamp, submenu flip.
//   5. ANNOUNCEMENTS for a screen reader.
//
//     firnc -o /tmp/ctxmenu tools/fui/ctxmenu_main.fi && /tmp/ctxmenu
//
// The last line is CTXMENU PASSED or CTXMENU FAILED.
import std.rt
import fui.action
import fui.ctxmenu
import fui.scene
import fui.widget
import fui.ctxstd

static mut BAD: usize = 0
static mut RAN: [i64; 16] = [0; 16]
static mut LASTCLOSE: i64 = 0
static mut CLOSES: i64 = 0
static mut SELECTED: [u32; 8] = [0 as u32; 8]
static mut NSEL: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_int(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn eq(what: str, got: i64, want: i64) {
    if got == want {
        say("  ok    ")
        say(what)
        say("\n")
    } else {
        say("  WRONG ")
        say(what)
        say("  got ")
        say_int(got)
        say(" want ")
        say_int(want)
        say("\n")
        BAD = BAD + 1
    }
}

// handlers: ud is the slot of RAN that counts the call
fn h_count(ud: u64, cx: *mut action.ActCtx) {
    RAN[ud as usize] = RAN[ud as usize] + 1
}

fn on_close(ud: u64, reason: u32) {
    CLOSES = CLOSES + 1
    LASTCLOSE = reason as i64
}

fn en_false(ud: u64, cx: *mut action.ActCtx) -> bool { return false }
fn vis_false(ud: u64, cx: *mut action.ActCtx) -> bool { return false }
fn vis_one(ud: u64, cx: *mut action.ActCtx) -> bool { return (*cx).selected == 1 }
fn chk_on(ud: u64, cx: *mut action.ActCtx) -> u32 { return action.CHK_ON }
fn chk_off(ud: u64, cx: *mut action.ActCtx) -> u32 { return action.CHK_OFF }

fn gr_deny(ud: u64, owner: str, level: u32) -> bool {
    return !action.str_eq(owner, "evil")
}

// ----- the tree: root(1) > list(2) > row(3), root > bar(4)
static mut G_SCP: u64 = 0

fn gsc() -> *mut scene.Scene {
    if G_SCP == 0 {
        G_SCP = rt.heap_alloc(1 << 20)
        *(G_SCP as *mut scene.Scene) = scene.scene_new()
    }
    return G_SCP as *mut scene.Scene
}

// ----- providers
// near: row key 3. Copy, Delete (danger), Rename
static mut A: [usize; 24] = [0; 24]
static mut TA: [usize; 4] = [0; 4]

fn ta_id(i: usize) -> str {
    if i == 0 { return "Alpha" }
    if i == 1 { return "Beta" }
    if i == 2 { return "Bravo" }
    return "Charlie"
}

fn prov_ta(ud: u64, pc: *mut ctxmenu.ProviderCtx) {
    var i: usize = 0
    while i < 4 {
        let e: usize = ctxmenu.pc_add(pc, TA[i])
        i = i + 1
    }
}

fn prov_row(ud: u64, pc: *mut ctxmenu.ProviderCtx) {
    let a: usize = ctxmenu.pc_add(pc, A[0]) // copy
    let b: usize = ctxmenu.pc_add(pc, A[2]) // delete
    let c: usize = ctxmenu.pc_add(pc, A[1]) // rename
    let d: usize = ctxmenu.pc_add(pc, A[3]) // hidden action
}

// far: list key 2 offers copy again (nearer one wins), select-all, sort submenu
fn prov_list(ud: u64, pc: *mut ctxmenu.ProviderCtx) {
    let a: usize = ctxmenu.pc_add(pc, A[0])
    let b: usize = ctxmenu.pc_add(pc, A[4]) // select all
    let s: usize = ctxmenu.pc_submenu(pc, "&Sort by", action.ICON_NONE, action.G_VIEW)
    let x: usize = ctxmenu.pc_add_to(pc, s, A[5])
    let y: usize = ctxmenu.pc_add_to(pc, s, A[6])
    let e: usize = ctxmenu.pc_submenu(pc, "Empty", action.ICON_NONE, action.G_VIEW)
}

// global: refresh, and the same Sort-by submenu with a third entry
fn prov_global(ud: u64, pc: *mut ctxmenu.ProviderCtx) {
    let a: usize = ctxmenu.pc_add(pc, A[7]) // refresh
    let s: usize = ctxmenu.pc_submenu(pc, "&Sort by", action.ICON_NONE, action.G_VIEW)
    let z: usize = ctxmenu.pc_add_to(pc, s, A[8])
    ctxmenu.pc_tag(pc, ".txt")
}

fn sel_item(ud: u64, sc: *mut scene.Scene, n: usize) -> u32 {
    var k: usize = n
    while k != scene.SCENE_NONE {
        if scene.node_id(sc, k) == 3 as u32 { return 3 as u32 }
        k = scene.scene_parent(sc, k)
    }
    return 0 as u32
}

fn sel_is(ud: u64, k: u32) -> bool {
    var i: usize = 0
    while i < NSEL {
        if SELECTED[i] == k { return true }
        i = i + 1
    }
    return false
}

fn sel_only(ud: u64, k: u32) {
    SELECTED[0] = k
    NSEL = 1
}

fn sel_clear(ud: u64) {
    NSEL = 0
}

fn sel_count(ud: u64) -> usize { return NSEL }

fn tr_hook(ud: u64, key: str) -> str {
    if action.str_eq(key, "t.copy") { return "&Kopieren" }
    return key
}

fn build_tree() {
    scene.scene_reset(gsc())
    let root: usize = scene.scene_add(gsc(), scene.SCENE_NONE, scene.N_BOX)
    scene.node_set_id(gsc(), root, 1 as u32)
    let list: usize = scene.scene_add(gsc(), root, scene.N_BOX)
    scene.node_set_id(gsc(), list, 2 as u32)
    let row: usize = scene.scene_add(gsc(), list, scene.N_BOX)
    scene.node_set_id(gsc(), row, 3 as u32)
    let bar: usize = scene.scene_add(gsc(), root, scene.N_BOX)
    scene.node_set_id(gsc(), bar, 4 as u32)
}

fn lbl(m: *mut ctxmenu.Ctxm, s: usize) -> str {
    return ctxmenu.menu_label(m, s)
}

fn is_label(m: *mut ctxmenu.Ctxm, s: usize, want: str) -> bool {
    return action.str_eq(lbl(m, s), want)
}

fn test_actions() {
    say("== 1. ACTIONS ==\n")
    var r: action.Actions = action.actions_new()
    action.act_set_app(&r, "notes")
    let c: usize = action.act_add(&r, "copy", "&Copy", h_count, 0 as u64)
    action.act_set_shortcut(&r, c, 67 as u32, action.MOD_CTRL)
    let d: usize = action.act_add(&r, "delete", "&Delete", h_count, 1 as u64)
    action.act_danger(&r, d)
    action.act_set_shortcut(&r, d, action.SK_DELETE, 0 as u32)
    let off: usize = action.act_add(&r, "off", "Off", h_count, 2 as u64)
    action.act_set_enabled(&r, off, en_false)
    action.act_set_shortcut(&r, off, 79 as u32, action.MOD_CTRL)
    let hid: usize = action.act_add(&r, "hid", "Hid", h_count, 3 as u64)
    action.act_set_visible(&r, hid, vis_false)
    var cx: action.ActCtx = action.actx_new(0 as u64)
    eq("three actions plus one hidden", action.act_count(&r) as i64, 4)
    eq("declaring the same id again keeps the index",
        action.act_add(&r, "copy", "&Copy", h_count, 0 as u64) as i64, c as i64)
    eq("... and does not grow the registry", action.act_count(&r) as i64, 4)
    action.act_set_shortcut(&r, c, 67 as u32, action.MOD_CTRL)
    check(action.act_dispatch_key(&r, 67 as u32, action.MOD_CTRL, &cx), "Ctrl+C runs copy")
    eq("copy ran once", RAN[0], 1)
    check(!action.act_dispatch_key(&r, 67 as u32, 0 as u32, &cx), "C without Ctrl runs nothing")
    check(!action.act_dispatch_key(&r, 79 as u32, action.MOD_CTRL, &cx), "a disabled action's shortcut runs nothing")
    eq("off never ran", RAN[2], 0)
    check(action.act_dispatch_key(&r, action.SK_DELETE, 0 as u32, &cx), "Del runs delete")
    check(!action.act_run(&r, hid, &cx), "a hidden action does not run")
    eq("run by name: copy", action.act_run_id(&r, "copy", &cx) as i64, action.RUN_OK as i64)
    eq("run by name: unknown", action.act_run_id(&r, "nope", &cx) as i64, action.RUN_UNKNOWN as i64)
    eq("run by name: disabled", action.act_run_id(&r, "off", &cx) as i64, action.RUN_DISABLED as i64)
    eq("run by name: hidden", action.act_run_id(&r, "hid", &cx) as i64, action.RUN_HIDDEN as i64)
    eq("run by BUS name notes.copy", action.act_run_bus(&r, "notes.copy", &cx) as i64, action.RUN_OK as i64)
    eq("... a bus call carries the source", (cx.source) as i64, action.SRC_BUS as i64)
    eq("bus name of another app is unknown", action.act_run_bus(&r, "mail.copy", &cx) as i64, action.RUN_UNKNOWN as i64)
    eq("bus name without verb is unknown", action.act_run_bus(&r, "notes.", &cx) as i64, action.RUN_UNKNOWN as i64)
    eq("the mnemonic of &Copy is C", action.act_mnemonic(&r, c) as i64, 67)
    eq("delete is critical on the bus", action.act_level(&r, d) as i64, action.LV_CRITICAL as i64)
    check(action.act_is_danger(&r, d), "delete is danger")
    eq("delete sorts into the danger group", action.act_group(&r, d) as i64, action.G_DANGER as i64)

    var st: [u8; 32] = [0 as u8; 32]
    var n: usize = action.shortcut_text(67 as u32, action.MOD_CTRL | action.MOD_SHIFT, (&st[0]) as *mut u8, 32)
    check(action.str_eq(str { p: (&st[0]) as *mut u8, n: n }, "Ctrl+Shift+C"), "shortcut text Ctrl+Shift+C")
    n = action.shortcut_text(action.SK_DELETE, 0 as u32, (&st[0]) as *mut u8, 32)
    check(action.str_eq(str { p: (&st[0]) as *mut u8, n: n }, "Del"), "shortcut text Del")
    n = action.shortcut_text(action.SK_F1 + (1 as u32), action.MOD_ALT, (&st[0]) as *mut u8, 32)
    check(action.str_eq(str { p: (&st[0]) as *mut u8, n: n }, "Alt+F2"), "shortcut text Alt+F2")
    eq("Ctrl+C arrives as control code 3 and is the logical key C", action.key_logical(3 as u32) as i64, 67)
    eq("a typed lower-case c is the logical key C", action.key_logical(99 as u32) as i64, 67)

    var buf: [u8; 600] = [0 as u8; 600]
    let mn: usize = action.act_manifest(&r, "Notes", (&buf[0]) as *mut u8, 600)
    let man: str = str { p: (&buf[0]) as *mut u8, n: mn }
    check(action.str_starts(man, "manifest 1\napp notes\ntitle \"Notes\"\n"), "the manifest starts like ACTION-BUS.md section 3")
    var has_copy: bool = false
    var has_del: bool = false
    var k: usize = 0
    while k + 30 < mn {
        if action.str_starts(str { p: ((&buf[0]) as u64 + k as u64) as *mut u8, n: mn - k }, "action notes.copy write \"Copy\"") { has_copy = true }
        if action.str_starts(str { p: ((&buf[0]) as u64 + k as u64) as *mut u8, n: mn - k }, "action notes.delete critical \"Delete\"") { has_del = true }
        k = k + 1
    }
    check(has_copy, "manifest line: action notes.copy write \"Copy\" (no '&' in the description)")
    check(has_del, "manifest line: action notes.delete critical \"Delete\"")
    action.act_set_bus(&r, off, false)
    eq("an action kept off the bus is not counted", action.act_bus_count(&r) as i64, 3)

    // labels: translator hook, then catalog, then the key
    var ra: action.Actions = action.actions_new()
    let t1: usize = action.act_add(&ra, "tc", "t.copy", h_count, 0 as u64)
    let t2: usize = action.act_add(&ra, "tp", "t.paste", h_count, 0 as u64)
    check(action.str_eq(action.act_label(&ra, t1), "t.copy"), "no translator: the key itself")
    var cat: action.Catalog = action.catalog_new()
    let ok1: bool = action.catalog_add(&cat, "t.paste", "Paste")
    action.act_set_catalog(&ra, &cat)
    check(action.str_eq(action.act_label(&ra, t2), "Paste"), "catalog answers a key")
    check(action.str_eq(action.act_label(&ra, t1), "t.copy"), "a key the catalog lacks shows itself")
    action.act_set_translator(&ra, 0 as u64, tr_hook)
    check(action.str_eq(action.act_label(&ra, t1), "&Kopieren"), "the translator hook wins")
    check(action.str_eq(action.act_label(&ra, t2), "Paste"), "... and the catalog still serves the rest")
    var cl: [u8; 32] = [0 as u8; 32]
    var at: usize = 0
    let cn: usize = action.label_clean("Sa&ve && quit", (&cl[0]) as *mut u8, 32, &at)
    check(action.str_eq(str { p: (&cl[0]) as *mut u8, n: cn }, "Save & quit"), "label_clean: && is a literal ampersand")
    eq("label_clean: the mnemonic is the v at index 2", at as i64, 2)
}

// fill the shared registry used by the chain tests
fn fill(r: *mut action.Actions) {
    action.act_set_app(r, "files")
    A[0] = action.act_add(r, "copy", "&Copy", h_count, 4 as u64)
    action.act_set_group(r, A[0], action.G_EDIT)
    action.act_set_shortcut(r, A[0], 67 as u32, action.MOD_CTRL)
    A[1] = action.act_add(r, "rename", "Re&name", h_count, 5 as u64)
    action.act_set_group(r, A[1], action.G_EDIT)
    action.act_set_shortcut(r, A[1], action.SK_F1 + (1 as u32), 0 as u32)
    A[2] = action.act_add(r, "delete", "&Delete", h_count, 6 as u64)
    action.act_danger(r, A[2])
    A[3] = action.act_add(r, "secret", "Secret", h_count, 7 as u64)
    action.act_set_visible(r, A[3], vis_false)
    A[4] = action.act_add(r, "selectall", "Select &all", h_count, 8 as u64)
    action.act_set_group(r, A[4], action.G_SELECTION)
    A[5] = action.act_add(r, "sortname", "By name", h_count, 9 as u64)
    action.act_set_radio(r, A[5], chk_on)
    A[6] = action.act_add(r, "sortsize", "By size", h_count, 10 as u64)
    action.act_set_radio(r, A[6], chk_off)
    A[7] = action.act_add(r, "refresh", "&Refresh", h_count, 11 as u64)
    action.act_set_group(r, A[7], action.G_VIEW)
    A[8] = action.act_add(r, "sortdate", "By date", h_count, 12 as u64)
    A[9] = action.act_add(r, "open", "&Open", h_count, 13 as u64)
    action.act_set_group(r, A[9], action.G_PRIMARY)
    A[10] = action.act_add(r, "one", "Only for one", h_count, 14 as u64)
    action.act_set_visible(r, A[10], vis_one)
    A[11] = action.act_add(r, "plug", "Plugin thing", h_count, 15 as u64)
    A[12] = action.act_add(r, "evilplug", "Evil thing", h_count, 3 as u64)
    A[13] = action.act_add(r, "killplug", "Plugin kill", h_count, 3 as u64)
    action.act_set_level(r, A[13], action.LV_CRITICAL)
}

fn test_chain() {
    say("== 2. THE REQUEST CHAIN AND THE MERGE ==\n")
    var r: action.Actions = action.actions_new()
    fill(&r)
    var m: ctxmenu.Ctxm = ctxmenu.ctxm_new()
    ctxmenu.ctxm_set_actions(&m, &r)
    ctxmenu.ctx_set_on_close(&m, 0 as u64, on_close)
    build_tree()
    let okp: bool = ctxmenu.ctx_provider_key(&m, 3 as u32, prov_row, 0 as u64)
    let okq: bool = ctxmenu.ctx_provider_key(&m, 2 as u32, prov_list, 0 as u64)
    let okg: bool = ctxmenu.ctx_provider_global(&m, prov_global, 0 as u64)
    eq("three providers", ctxmenu.ctx_provider_count(&m) as i64, 3)
    // the row is node 2 of the tree (root 0, list 1, row 2)
    let row: usize = scene.scene_find_id(gsc(), 3 as u32)
    let bar: usize = scene.scene_find_id(gsc(), 4 as u32)
    check(row != scene.SCENE_NONE, "the tree has the row")

    check(ctxmenu.ctx_request(&m, gsc(), row, 100.0, 100.0, 100.0, action.SRC_MOUSE, 0 as u32, 0), "a right click on the row opens a menu")
    check(ctxmenu.ctx_is_open(&m), "open")
    // top level: Edit group: copy, rename (insertion order within the group: copy
    // from the row first), selection group: select all, view group: sort by >, refresh,
    // danger: delete.
    let n0: usize = ctxmenu.menu_level_count(&m, ctxmenu.NONE)
    var names: [usize; 24] = [0; 24]
    var q: usize = 0
    while q < n0 {
        names[q] = ctxmenu.menu_level_at(&m, ctxmenu.NONE, q)
        q = q + 1
    }
    // expected top-level order of kinds: A SEP? see below. Dump what is there.
    say("    top level: ")
    q = 0
    while q < n0 {
        let s: usize = names[q]
        if ctxmenu.menu_kind(&m, s) == ctxmenu.IK_SEP {
            say("| ")
        } else {
            say(lbl(&m, s))
            if ctxmenu.menu_kind(&m, s) == ctxmenu.IK_SUB { say(">") }
            say(" ")
        }
        q = q + 1
    }
    say("\n")
    check(is_label(&m, names[0], "Copy"), "1st: Copy")
    check(is_label(&m, names[1], "Rename"), "2nd: Rename")
    check(ctxmenu.menu_kind(&m, names[2]) == ctxmenu.IK_SEP, "separator between Edit and Selection")
    check(is_label(&m, names[3], "Select all"), "Select all (selection group)")
    check(ctxmenu.menu_kind(&m, names[4]) == ctxmenu.IK_SEP, "separator before the view group")
    check(is_label(&m, names[5], "Sort by") && ctxmenu.menu_kind(&m, names[5]) == ctxmenu.IK_SUB, "Sort by is a submenu (the two providers' submenus are ONE)")
    check(is_label(&m, names[6], "Refresh"), "Refresh after the submenu: same group, later")
    check(ctxmenu.menu_kind(&m, names[7]) == ctxmenu.IK_SEP, "separator before the danger group")
    check(is_label(&m, names[8], "Delete") && ctxmenu.menu_danger(&m, names[8]), "Delete is last and dangerous")
    eq("no trailing separator: nine slots at the top", n0 as i64, 9)
    eq("Sort by holds three entries from two providers", ctxmenu.menu_level_count(&m, names[5]) as i64, 3)
    let sub0: usize = ctxmenu.menu_level_at(&m, names[5], 0)
    check(is_label(&m, sub0, "By name") && ctxmenu.menu_checked(&m, sub0) == action.CHK_ON, "By name is a radio entry that is on")
    check(ctxmenu.menu_checked(&m, ctxmenu.menu_level_at(&m, names[5], 1)) == action.CHK_OFF, "By size is a radio entry that is off")
    check(ctxmenu.menu_index_of_act(&m, A[0]) == names[0], "Copy appears exactly once")
    check(ctxmenu.menu_index_of_act(&m, A[3]) == ctxmenu.NONE, "the hidden action is not in the menu")
    check(ctxmenu.ctx_stat(&m, ctxmenu.ST_DUPLICATES) >= 1 as u64, "the duplicate Copy was counted")
    check(ctxmenu.ctx_stat(&m, ctxmenu.ST_HIDDEN) >= 1 as u64, "the hidden action was counted")
    check(ctxmenu.ctx_stat(&m, ctxmenu.ST_PRUNED) >= 1 as u64, "the empty 'Empty' submenu was pruned")
    eq("mnemonic of Copy", ctxmenu.menu_mnemonic(&m, names[0]) as i64, 67)
    eq("the shortcut is carried: Ctrl+C", ctxmenu.menu_key(&m, names[0]) as i64, 67)
    eq("... with its modifier", ctxmenu.menu_mods(&m, names[0]) as i64, action.MOD_CTRL as i64)
    check(ctxmenu.menu_has_check(&m, names[5]) && !ctxmenu.menu_has_check(&m, ctxmenu.NONE), "the submenu has a check gutter, the top level does not")
    eq("a mouse request focuses nothing", ctxmenu.ctx_focus(&m, 0) as i64, ctxmenu.NONE as i64)
    eq("the request knows its source", ctxmenu.ctx_source(&m) as i64, action.SRC_MOUSE as i64)
    check(!ctxmenu.ctx_touch(&m), "a mouse request is not touch")
    let c1: u32 = ctxmenu.ctx_close(&m, ctxmenu.CLOSE_API)

    // the request on the bar (key 4): only the global provider applies
    check(ctxmenu.ctx_request(&m, gsc(), bar, 10.0, 10.0, 10.0, action.SRC_MOUSE, 0 as u32, 0), "a request on the bar opens a menu")
    eq("the bar's menu: Refresh and Sort by (one group, no separator)", ctxmenu.menu_level_count(&m, ctxmenu.NONE) as i64, 2)
    check(ctxmenu.menu_index_of_act(&m, A[0]) == ctxmenu.NONE, "no Copy on the bar: the row's provider did not run")
    let c2: u32 = ctxmenu.ctx_close(&m, ctxmenu.CLOSE_API)

    // keyboard request: first entry focused, tag from the global provider
    check(ctxmenu.ctx_request(&m, gsc(), row, 50.0, 60.0, 40.0, action.SRC_SHIFT_F10, 0 as u32, 0), "Shift+F10 opens the menu on the row")
    eq("a key request focuses the first entry", ctxmenu.ctx_focus(&m, 0) as i64, names[0] as i64)
    let c3: u32 = ctxmenu.ctx_close(&m, ctxmenu.CLOSE_API)

    // selection rule + multi selection
    NSEL = 0
    ctxmenu.ctx_set_sel_hooks(&m, ctxmenu.SelHooks { ud: 0 as u64, item_of: sel_item,
        is_selected: sel_is, select_only: sel_only, clear: sel_clear, count: sel_count, on: true })
    check(ctxmenu.ctx_request(&m, gsc(), row, 5.0, 5.0, 5.0, action.SRC_MOUSE, 0 as u32, 0), "right click on an unselected row")
    eq("... selects it", NSEL as i64, 1)
    eq("... the program's selection is that row", SELECTED[0] as i64, 3)
    eq("... the provider sees one selected item", ctxmenu.ctx_selected(&m) as i64, 1)
    let c4: u32 = ctxmenu.ctx_close(&m, ctxmenu.CLOSE_API)
    NSEL = 3
    SELECTED[0] = 1 as u32
    SELECTED[1] = 3 as u32
    SELECTED[2] = 9 as u32
    check(ctxmenu.ctx_request(&m, gsc(), row, 5.0, 5.0, 5.0, action.SRC_MOUSE, 0 as u32, 0), "right click on a selected row of three")
    eq("... keeps the three", NSEL as i64, 3)
    eq("... the provider sees three", ctxmenu.ctx_selected(&m) as i64, 3)
    let c5: u32 = ctxmenu.ctx_close(&m, ctxmenu.CLOSE_API)
    check(ctxmenu.ctx_request(&m, gsc(), bar, 5.0, 5.0, 5.0, action.SRC_MOUSE, 0 as u32, 0), "right click on empty ground")
    eq("... clears the selection", NSEL as i64, 0)
    let c6: u32 = ctxmenu.ctx_close(&m, ctxmenu.CLOSE_API)
    eq("policy: on unselected item = replace", ctxmenu.selection_policy(true, false) as i64, ctxmenu.SEL_REPLACE as i64)
    eq("policy: on selected item = keep", ctxmenu.selection_policy(true, true) as i64, ctxmenu.SEL_KEEP as i64)
    eq("policy: on empty ground = clear", ctxmenu.selection_policy(false, false) as i64, ctxmenu.SEL_CLEAR as i64)

    // plugin entries by tag and the rights check
    let e1: bool = ctxmenu.ctx_extension_add(&m, A[11], "goodplug", ".txt", 0)
    let e2: bool = ctxmenu.ctx_extension_add(&m, A[12], "evil", ".txt", 0)
    let e3: bool = ctxmenu.ctx_extension_add(&m, A[13], "goodplug", ".png", 0)
    let e4: bool = ctxmenu.ctx_extension_add(&m, A[10], "goodplug", "*", 0)
    ctxmenu.ctx_set_grant(&m, 0 as u64, gr_deny)
    NSEL = 0
    check(ctxmenu.ctx_request(&m, gsc(), row, 5.0, 5.0, 5.0, action.SRC_MOUSE, 0 as u32, 0), "request with plugin entries")
    check(ctxmenu.menu_index_of_act(&m, A[11]) != ctxmenu.NONE, "the .txt plugin entry shows (its tag was declared)")
    check(ctxmenu.menu_index_of_act(&m, A[12]) == ctxmenu.NONE, "the entry of an owner without grant does not")
    eq("... and is counted as denied", ctxmenu.ctx_stat(&m, ctxmenu.ST_DENIED) as i64, 1)
    check(ctxmenu.menu_index_of_act(&m, A[13]) == ctxmenu.NONE, "the .png plugin entry does not (no such tag)")
    check(ctxmenu.menu_index_of_act(&m, A[10]) != ctxmenu.NONE, "a '*' entry shows with exactly one item selected (its visible() says so)")
    let c7: u32 = ctxmenu.ctx_close(&m, ctxmenu.CLOSE_API)
    let pe: usize = ctxmenu.menu_level_count(&m, ctxmenu.NONE)
    check(is_label(&m, ctxmenu.menu_index_of_act(&m, A[11]), "Plugin thing"), "plugin label")
    check(pe > 0, "menu not empty")
    // a critical plugin entry sits in the danger group
    var r2: action.Actions = action.actions_new()
    fill(&r2)
    var m2: ctxmenu.Ctxm = ctxmenu.ctxm_new()
    ctxmenu.ctxm_set_actions(&m2, &r2)
    let g2: bool = ctxmenu.ctx_provider_global(&m2, prov_global, 0 as u64)
    let x1: bool = ctxmenu.ctx_extension_add(&m2, A[13], "goodplug", ".txt", 0)
    check(ctxmenu.ctx_request(&m2, gsc(), bar, 5.0, 5.0, 5.0, action.SRC_MOUSE, 0 as u32, 0), "request with a critical plugin entry")
    let last: usize = ctxmenu.menu_level_at(&m2, ctxmenu.NONE, ctxmenu.menu_level_count(&m2, ctxmenu.NONE) - 1)
    check(is_label(&m2, last, "Plugin kill") && ctxmenu.menu_danger(&m2, last), "a critical plugin entry is last and dangerous")
    let c8: u32 = ctxmenu.ctx_close(&m2, ctxmenu.CLOSE_API)

    // nothing to show -> refused
    var m3: ctxmenu.Ctxm = ctxmenu.ctxm_new()
    ctxmenu.ctxm_set_actions(&m3, &r)
    check(!ctxmenu.ctx_request(&m3, gsc(), row, 1.0, 1.0, 1.0, action.SRC_MOUSE, 0 as u32, 0), "no provider: no menu")
    eq("... counted as refused", ctxmenu.ctx_stat(&m3, ctxmenu.ST_REFUSED) as i64, 1)
}

fn test_state() {
    say("== 3. THE STATE: KEYS, HOVER, CLOSE RULES ==\n")
    var r: action.Actions = action.actions_new()
    fill(&r)
    var m: ctxmenu.Ctxm = ctxmenu.ctxm_new()
    ctxmenu.ctxm_set_actions(&m, &r)
    ctxmenu.ctx_set_on_close(&m, 0 as u64, on_close)
    build_tree()
    let a1: bool = ctxmenu.ctx_provider_key(&m, 3 as u32, prov_row, 0 as u64)
    let a2: bool = ctxmenu.ctx_provider_key(&m, 2 as u32, prov_list, 0 as u64)
    let a3: bool = ctxmenu.ctx_provider_global(&m, prov_global, 0 as u64)
    let row: usize = scene.scene_find_id(gsc(), 3 as u32)
    // slots: 0 Copy, 1 Rename, 2 sep, 3 Select all, 4 sep, 5 Sort by>, 6 Refresh, 7 sep, 8 Delete; 9.. the submenu
    check(ctxmenu.ctx_request(&m, gsc(), row, 20.0, 20.0, 20.0, action.SRC_MENU_KEY, 0 as u32, 0), "menu key opens the menu")
    eq("the first entry is focused", ctxmenu.ctx_focus(&m, 0) as i64, 0)
    var cr: u32 = ctxmenu.ctx_key(&m, action.SK_DOWN, 0 as u32)
    check((cr & ctxmenu.CR_CONSUMED) != 0 as u32, "Down is consumed")
    eq("Down moves to Rename", ctxmenu.ctx_focus(&m, 0) as i64, 1)
    cr = ctxmenu.ctx_key(&m, action.SK_DOWN, 0 as u32)
    eq("Down skips the separator: Select all", ctxmenu.ctx_focus(&m, 0) as i64, 3)
    cr = ctxmenu.ctx_key(&m, action.SK_END, 0 as u32)
    eq("End: the last entry (Delete)", ctxmenu.ctx_focus(&m, 0) as i64, 8)
    cr = ctxmenu.ctx_key(&m, action.SK_DOWN, 0 as u32)
    eq("Down wraps to the first", ctxmenu.ctx_focus(&m, 0) as i64, 0)
    cr = ctxmenu.ctx_key(&m, action.SK_UP, 0 as u32)
    eq("Up wraps to the last", ctxmenu.ctx_focus(&m, 0) as i64, 8)
    cr = ctxmenu.ctx_key(&m, action.SK_HOME, 0 as u32)
    eq("Home: the first", ctxmenu.ctx_focus(&m, 0) as i64, 0)
    cr = ctxmenu.ctx_key(&m, 65 as u32, action.MOD_CTRL)
    check((cr & ctxmenu.CR_CONSUMED) != 0 as u32 && ctxmenu.ctx_is_open(&m), "a stray shortcut is swallowed: the menu is modal")
    // submenu by keyboard
    cr = ctxmenu.ctx_key(&m, action.SK_DOWN, 0 as u32)
    cr = ctxmenu.ctx_key(&m, action.SK_DOWN, 0 as u32)
    cr = ctxmenu.ctx_key(&m, action.SK_DOWN, 0 as u32)
    eq("on 'Sort by'", ctxmenu.ctx_focus(&m, 0) as i64, 5)
    cr = ctxmenu.ctx_key(&m, action.SK_RIGHT, 0 as u32)
    eq("Right opens the submenu", ctxmenu.ctx_depth(&m) as i64, 2)
    eq("... and focuses its first entry", ctxmenu.ctx_focus(&m, 1) as i64, 9)
    eq("the path knows the header", ctxmenu.ctx_open_path(&m, 1) as i64, 5)
    cr = ctxmenu.ctx_key(&m, action.SK_DOWN, 0 as u32)
    eq("Down inside the submenu", ctxmenu.ctx_focus(&m, 1) as i64, 10)
    cr = ctxmenu.ctx_key(&m, action.SK_LEFT, 0 as u32)
    eq("Left closes the submenu", ctxmenu.ctx_depth(&m) as i64, 1)
    eq("the header keeps the focus", ctxmenu.ctx_focus(&m, 0) as i64, 5)
    cr = ctxmenu.ctx_key(&m, action.SK_ENTER, 0 as u32)
    eq("Enter on a submenu opens it", ctxmenu.ctx_depth(&m) as i64, 2)
    cr = ctxmenu.ctx_key(&m, action.SK_ESCAPE, 0 as u32)
    eq("Esc closes the submenu first", ctxmenu.ctx_depth(&m) as i64, 1)
    check(ctxmenu.ctx_is_open(&m), "... the menu stays")
    // activation closes first, then runs
    CLOSES = 0
    RAN[4] = 0
    cr = ctxmenu.ctx_key(&m, action.SK_HOME, 0 as u32)
    cr = ctxmenu.ctx_key(&m, action.SK_ENTER, 0 as u32)
    check((cr & ctxmenu.CR_RAN) != 0 as u32, "Enter on Copy: ran")
    eq("the handler ran once", RAN[4], 1)
    check(!ctxmenu.ctx_is_open(&m), "the menu closed")
    eq("close reason: RAN", LASTCLOSE, ctxmenu.CLOSE_RAN as i64)
    eq("last ran = Copy", ctxmenu.ctx_last_ran(&m) as i64, A[0] as i64)
    // Esc closes the whole menu
    check(ctxmenu.ctx_request(&m, gsc(), row, 20.0, 20.0, 20.0, action.SRC_MOUSE, 0 as u32, 0), "reopen")
    cr = ctxmenu.ctx_key(&m, action.SK_ESCAPE, 0 as u32)
    check(!ctxmenu.ctx_is_open(&m) && LASTCLOSE == ctxmenu.CLOSE_ESC as i64, "Esc at the top closes the menu (reason ESC)")
    // mnemonic
    check(ctxmenu.ctx_request(&m, gsc(), row, 20.0, 20.0, 20.0, action.SRC_MOUSE, 0 as u32, 0), "reopen for mnemonics")
    RAN[6] = 0
    cr = ctxmenu.ctx_char(&m, 100 as u32, 0)
    eq("'d' = &Delete activates it", RAN[6], 1)
    check((cr & ctxmenu.CR_RAN) != 0 as u32, "... CR_RAN")
    // typeahead (labels without a mnemonic): Alpha Beta Bravo Charlie
    var r5: action.Actions = action.actions_new()
    action.act_set_app(&r5, "ta")
    var q5: usize = 0
    while q5 < 4 {
        TA[q5] = action.act_add(&r5, ta_id(q5), ta_id(q5), h_count, 0 as u64)
        q5 = q5 + 1
    }
    var m5: ctxmenu.Ctxm = ctxmenu.ctxm_new()
    ctxmenu.ctxm_set_actions(&m5, &r5)
    let t5: bool = ctxmenu.ctx_provider_global(&m5, prov_ta, 0 as u64)
    check(ctxmenu.ctx_request(&m5, gsc(), ctxmenu.NONE, 0.0, 0.0, 0.0, action.SRC_MOUSE, 0 as u32, 0), "a menu of four plain labels")
    cr = ctxmenu.ctx_char(&m5, 98 as u32, 1000)
    eq("typing b: Beta (the first b after nothing)", ctxmenu.ctx_focus(&m5, 0) as i64, 1)
    cr = ctxmenu.ctx_char(&m5, 114 as u32, 1300)
    eq("typing r within the delay: 'br' = Bravo", ctxmenu.ctx_focus(&m5, 0) as i64, 2)
    cr = ctxmenu.ctx_char(&m5, 98 as u32, 5000)
    eq("typing b after the delay starts anew and moves on from Bravo: Beta", ctxmenu.ctx_focus(&m5, 0) as i64, 1)
    cr = ctxmenu.ctx_char(&m5, 99 as u32, 9000)
    eq("typing c: Charlie", ctxmenu.ctx_focus(&m5, 0) as i64, 3)
    cr = ctxmenu.ctx_char(&m5, 122 as u32, 12000)
    eq("a letter nobody starts with changes nothing", ctxmenu.ctx_focus(&m5, 0) as i64, 3)
    check(ctxmenu.ctx_is_open(&m5), "and the menu stays open")
    let cz: u32 = ctxmenu.ctx_close(&m5, ctxmenu.CLOSE_API)
    // fresh menu for the hover tests
    check(ctxmenu.ctx_request(&m, gsc(), row, 20.0, 20.0, 20.0, action.SRC_MOUSE, 0 as u32, 0), "reopen for the hover tests")
    cr = ctxmenu.ctx_hover(&m, 3 as usize, 9000)
    eq("hover on Select all: the focus follows", ctxmenu.ctx_focus(&m, 0) as i64, 3)
    eq("... nothing is pending", ctxmenu.ctx_pending_ms(&m, 9000), 0 - 1)
    // hover delay for a submenu
    cr = ctxmenu.ctx_hover(&m, 5 as usize, 10000)
    eq("hover on Sort by: not open yet", ctxmenu.ctx_depth(&m) as i64, 1)
    eq("... the focus follows the pointer", ctxmenu.ctx_focus(&m, 0) as i64, 5)
    eq("... a deadline is pending", ctxmenu.ctx_pending_ms(&m, 10000), 250)
    cr = ctxmenu.ctx_tick(&m, 10100)
    eq("100 ms later: still closed", ctxmenu.ctx_depth(&m) as i64, 1)
    cr = ctxmenu.ctx_tick(&m, 10250)
    eq("250 ms later: open", ctxmenu.ctx_depth(&m) as i64, 2)
    check((cr & ctxmenu.CR_REPAINT) != 0 as u32, "... a repaint is asked for")
    eq("hovering inside the submenu keeps it", ctxmenu.ctx_depth(&m) as i64, 2)
    cr = ctxmenu.ctx_hover(&m, 10 as usize, 10300)
    eq("the focus of level 1 follows", ctxmenu.ctx_focus(&m, 1) as i64, 10)
    // leaving the header for another item of level 0 closes the submenu after the delay
    cr = ctxmenu.ctx_hover(&m, 6 as usize, 10400)
    eq("to Refresh: the submenu still stands", ctxmenu.ctx_depth(&m) as i64, 2)
    cr = ctxmenu.ctx_tick(&m, 10700)
    eq("300 ms later it is closed", ctxmenu.ctx_depth(&m) as i64, 1)
    // coming back into the header and then into the submenu cancels a pending close
    cr = ctxmenu.ctx_hover(&m, 5 as usize, 11000)
    cr = ctxmenu.ctx_tick(&m, 11300)
    eq("reopened", ctxmenu.ctx_depth(&m) as i64, 2)
    cr = ctxmenu.ctx_hover(&m, 6 as usize, 11400)
    cr = ctxmenu.ctx_hover(&m, 9 as usize, 11450)
    cr = ctxmenu.ctx_tick(&m, 12000)
    eq("moving into the submenu in time keeps it", ctxmenu.ctx_depth(&m) as i64, 2)
    // a press on a submenu item runs it
    RAN[9] = 0
    cr = ctxmenu.ctx_press(&m, 9 as usize, 12100)
    eq("a click in the submenu ran By name", RAN[9], 1)
    check(!ctxmenu.ctx_is_open(&m), "and closed all")
    // outside press
    check(ctxmenu.ctx_request(&m, gsc(), row, 20.0, 20.0, 20.0, action.SRC_MOUSE, 0 as u32, 0), "reopen for the outside press")
    cr = ctxmenu.ctx_press(&m, ctxmenu.NONE, 0)
    check((cr & ctxmenu.CR_CLOSED) != 0 as u32 && (cr & ctxmenu.CR_PASS) != 0 as u32, "an outside press closes AND lets the press through")
    eq("close reason OUTSIDE", LASTCLOSE, ctxmenu.CLOSE_OUTSIDE as i64)
    // a press on a separator does nothing
    check(ctxmenu.ctx_request(&m, gsc(), row, 20.0, 20.0, 20.0, action.SRC_MOUSE, 0 as u32, 0), "reopen: separator press")
    cr = ctxmenu.ctx_press(&m, 2 as usize, 0)
    check(ctxmenu.ctx_is_open(&m) && (cr & ctxmenu.CR_CONSUMED) != 0 as u32, "a press on a separator is consumed, the menu stays")
    // focus loss / window change
    cr = ctxmenu.ctx_focus_lost(&m)
    check(!ctxmenu.ctx_is_open(&m) && LASTCLOSE == ctxmenu.CLOSE_FOCUS as i64, "focus loss closes")
    check(ctxmenu.ctx_request(&m, gsc(), row, 20.0, 20.0, 20.0, action.SRC_MOUSE, 0 as u32, 0), "reopen: window change")
    cr = ctxmenu.ctx_window_changed(&m)
    check(!ctxmenu.ctx_is_open(&m) && LASTCLOSE == ctxmenu.CLOSE_WINDOW as i64, "a window change closes")
    // lock
    check(ctxmenu.ctx_request(&m, gsc(), row, 20.0, 20.0, 20.0, action.SRC_MOUSE, 0 as u32, 0), "reopen: lock")
    cr = ctxmenu.ctx_set_locked(&m, true)
    check(!ctxmenu.ctx_is_open(&m) && LASTCLOSE == ctxmenu.CLOSE_LOCK as i64, "the screen lock closes an open menu")
    check(!ctxmenu.ctx_request(&m, gsc(), row, 20.0, 20.0, 20.0, action.SRC_MOUSE, 0 as u32, 0), "no menu opens over the lock")
    cr = ctxmenu.ctx_set_locked(&m, false)
    check(ctxmenu.ctx_request(&m, gsc(), row, 20.0, 20.0, 20.0, action.SRC_MOUSE, 0 as u32, 0), "after the unlock a menu opens again")
    // a new request replaces the open menu
    CLOSES = 0
    check(ctxmenu.ctx_request(&m, gsc(), row, 30.0, 30.0, 30.0, action.SRC_TOUCH, 0 as u32, 0), "a second request replaces the first")
    eq("the first one was closed (reason NEW)", LASTCLOSE, ctxmenu.CLOSE_NEW as i64)
    check(ctxmenu.ctx_touch(&m), "a long press request is touch")
    // disabled item cannot run, menu stays
    var r4: action.Actions = action.actions_new()
    fill(&r4)
    action.act_set_enabled(&r4, A[0], en_false)
    var m4: ctxmenu.Ctxm = ctxmenu.ctxm_new()
    ctxmenu.ctxm_set_actions(&m4, &r4)
    let b1: bool = ctxmenu.ctx_provider_key(&m4, 3 as u32, prov_row, 0 as u64)
    check(ctxmenu.ctx_request(&m4, gsc(), row, 20.0, 20.0, 20.0, action.SRC_MENU_KEY, 0 as u32, 0), "menu with a disabled Copy")
    check(!ctxmenu.menu_enabled(&m4, 0 as usize), "Copy is disabled in the model")
    RAN[4] = 0
    cr = ctxmenu.ctx_key(&m4, action.SK_ENTER, 0 as u32)
    check(ctxmenu.ctx_is_open(&m4) && RAN[4] == 0, "Enter on a disabled entry does nothing and the menu stays")
    cr = ctxmenu.ctx_char(&m4, 99 as u32, 0)
    check(ctxmenu.ctx_is_open(&m4) && RAN[4] == 0, "its mnemonic does nothing either")
}

fn test_place() {
    say("== 4. PLACEMENT ==\n")
    // window 800 x 600, menu 200 x 300
    var p: ctxmenu.Place = ctxmenu.place_popup(100.0, 100.0, 100.0, 200.0, 300.0, 0.0, 0.0, 800.0, 600.0)
    check(p.x == 100.0 && p.y == 100.0 && p.flip == 0 as u32, "fits: at the pointer")
    p = ctxmenu.place_popup(700.0, 100.0, 100.0, 200.0, 300.0, 0.0, 0.0, 800.0, 600.0)
    check(p.x == 500.0 && (p.flip & 1 as u32) != 0 as u32, "no room right: opens to the left of the pointer")
    p = ctxmenu.place_popup(100.0, 450.0, 450.0, 200.0, 300.0, 0.0, 0.0, 800.0, 600.0)
    check(p.y == 150.0 && (p.flip & 2 as u32) != 0 as u32, "no room below: opens above the pointer")
    p = ctxmenu.place_popup(100.0, 450.0, 420.0, 200.0, 300.0, 0.0, 0.0, 800.0, 600.0)
    check(p.y == 120.0, "a key request flips to the top edge of the target (ay_alt)")
    p = ctxmenu.place_popup(790.0, 590.0, 590.0, 200.0, 300.0, 0.0, 0.0, 800.0, 600.0)
    check(p.x == 590.0 && p.y == 290.0, "bottom right corner: both flips")
    p = ctxmenu.place_popup(10.0, 10.0, 10.0, 200.0, 700.0, 0.0, 0.0, 800.0, 600.0)
    check(p.y == 0.0, "taller than the window: clamped to the top")
    p = ctxmenu.place_popup(100.0, 300.0, 300.0, 200.0, 400.0, 0.0, 0.0, 800.0, 600.0)
    check(p.y == 200.0, "neither side fits fully: the menu is moved up to fit")
    p = ctxmenu.place_popup(5.0, 5.0, 5.0, 900.0, 100.0, 0.0, 0.0, 800.0, 600.0)
    check(p.x == 0.0, "wider than the window: pinned to the left edge")
    // submenu: parent at x=100 w=200, header at y=140, h=32
    var s: ctxmenu.Place = ctxmenu.place_submenu(100.0, 200.0, 140.0, 4.0, 4.0, 180.0, 120.0, 0.0, 0.0, 800.0, 600.0)
    check(s.x == 296.0 && s.y == 136.0 && s.flip == 0 as u32, "submenu: right of the parent, overlapping 4, level with the header")
    s = ctxmenu.place_submenu(600.0, 200.0, 140.0, 4.0, 4.0, 180.0, 120.0, 0.0, 0.0, 800.0, 600.0)
    check(s.x == 424.0 && s.flip == 1 as u32, "submenu: no room right, to the left of the parent")
    s = ctxmenu.place_submenu(100.0, 200.0, 550.0, 4.0, 4.0, 180.0, 120.0, 0.0, 0.0, 800.0, 600.0)
    check(s.y == 480.0, "submenu: no room below, shifted up")
}

fn test_say() {
    say("== 5. ANNOUNCEMENTS ==\n")
    var r: action.Actions = action.actions_new()
    fill(&r)
    var m: ctxmenu.Ctxm = ctxmenu.ctxm_new()
    ctxmenu.ctxm_set_actions(&m, &r)
    build_tree()
    let a1: bool = ctxmenu.ctx_provider_key(&m, 3 as u32, prov_row, 0 as u64)
    let a2: bool = ctxmenu.ctx_provider_key(&m, 2 as u32, prov_list, 0 as u64)
    let row: usize = scene.scene_find_id(gsc(), 3 as u32)
    let s0: u64 = ctxmenu.ctx_announce_seq(&m)
    check(ctxmenu.ctx_request(&m, gsc(), row, 20.0, 20.0, 20.0, action.SRC_MENU_KEY, 0 as u32, 0), "open by key")
    check(ctxmenu.ctx_announce_seq(&m) > s0, "an announcement was made")
    say("    last: ")
    say(ctxmenu.ctx_announce_text(&m))
    say("\n")
    check(action.str_starts(ctxmenu.ctx_announce_text(&m), "Copy"), "the focused first entry is read: Copy ...")
    check(action.str_eq(ctxmenu.ctx_announce_text(&m), "Copy, 1 of 5"), "... 'Copy, 1 of 5' (five entries at the top: copy rename select-all sort-by delete)")
    var cr: u32 = ctxmenu.ctx_key(&m, action.SK_END, 0 as u32)
    check(action.str_eq(ctxmenu.ctx_announce_text(&m), "Delete, 5 of 5"), "End reads Delete, 5 of 5")
    cr = ctxmenu.ctx_key(&m, action.SK_UP, 0 as u32)
    check(action.str_eq(ctxmenu.ctx_announce_text(&m), "Sort by, submenu, 4 of 5"), "a submenu header says so")
    cr = ctxmenu.ctx_key(&m, action.SK_RIGHT, 0 as u32)
    check(action.str_eq(ctxmenu.ctx_announce_text(&m), "By name, checked, 1 of 2"), "a checked radio entry says 'checked'")
}


// ----------------------------------------------------------------- the standard entries
static mut OPLOG: [u32; 16] = [0 as u32; 16]
static mut NOPLOG: usize = 0
static mut MAXIMIZED: bool = false
static mut PINNED: bool = false
static mut HAS_SEL: bool = true

fn std_act(ud: u64, op: u32, cx: *mut action.ActCtx) {
    if NOPLOG < 16 {
        OPLOG[NOPLOG] = op
        NOPLOG = NOPLOG + 1
    }
}

fn std_can(ud: u64, op: u32, cx: *mut action.ActCtx) -> u32 {
    var r: u32 = 0 as u32
    if ud == 1 {
        // a text field
        if (op == ctxstd.OP_CUT || op == ctxstd.OP_COPY || op == ctxstd.OP_DELETE) && !HAS_SEL {
            r = ctxstd.CAN_OFF
        }
        if op == ctxstd.OP_REDO { r = ctxstd.CAN_OFF }
    } else if ud == 4 {
        // a title bar
        if op == ctxstd.OP_RESTORE && !MAXIMIZED { r = ctxstd.CAN_OFF }
        if op == ctxstd.OP_MAXIMIZE && MAXIMIZED { r = ctxstd.CAN_OFF }
        if (op == ctxstd.OP_MOVE || op == ctxstd.OP_SIZE) && MAXIMIZED { r = ctxstd.CAN_OFF }
    } else if ud == 5 {
        // a taskbar entry
        if op == ctxstd.OP_PIN && PINNED { r = ctxstd.CAN_HIDE }
        if op == ctxstd.OP_UNPIN && !PINNED { r = ctxstd.CAN_HIDE }
    }
    return r
}

fn std_tag(ud: u64, cx: *mut action.ActCtx) -> str {
    if ud == 3 { return "dir" }
    return ""
}

fn std_ops(ud: u64) -> ctxstd.StdOps {
    return ctxstd.StdOps { ud: ud, act: std_act, can: std_can, tag: std_tag }
}

fn test_std() {
    say("== 6. THE STANDARD ENTRIES ==\n")
    var r: action.Actions = action.actions_new()
    action.act_set_app(&r, "shell")
    var set: ctxstd.StdSet = ctxstd.std_set_new()
    check(ctxstd.std_register(&r, &set, ctxstd.FAM_EDIT, std_ops(1 as u64)), "edit family registered")
    check(ctxstd.std_register(&r, &set, ctxstd.FAM_LIST, std_ops(2 as u64)), "list family registered")
    check(ctxstd.std_register(&r, &set, ctxstd.FAM_FILE, std_ops(3 as u64)), "file family registered")
    check(ctxstd.std_register(&r, &set, ctxstd.FAM_WINDOW, std_ops(4 as u64)), "window family registered")
    check(ctxstd.std_register(&r, &set, ctxstd.FAM_TASK, std_ops(5 as u64)), "task family registered")
    check(ctxstd.std_register(&r, &set, ctxstd.FAM_PROC, std_ops(6 as u64)), "proc family registered")
    eq("all standard entries are in the registry", action.act_count(&r) as i64, ctxstd.std_def_count() as i64)
    var cat: action.Catalog = action.catalog_new()
    ctxstd.std_catalog_de(&cat)
    action.act_set_catalog(&r, &cat)
    // a scene: root > field (textbox, key 10), list node (key 11), file row (key 12),
    // title (key 13), task entry (key 14), process row (key 15)
    build_tree()
    let sc: *mut scene.Scene = gsc()
    let root: usize = 0
    let fld: usize = scene.scene_widget(sc, root, widget.KIND_TEXTBOX, "x".p as u64, 1)
    scene.node_set_id(sc, fld, 10 as u32)
    let lst: usize = scene.scene_add(sc, root, scene.N_BOX)
    scene.node_set_id(sc, lst, 11 as u32)
    let frow: usize = scene.scene_add(sc, lst, scene.N_BOX)
    scene.node_set_id(sc, frow, 12 as u32)
    let ttl: usize = scene.scene_add(sc, root, scene.N_BOX)
    scene.node_set_id(sc, ttl, 13 as u32)
    let tsk: usize = scene.scene_add(sc, root, scene.N_BOX)
    scene.node_set_id(sc, tsk, 14 as u32)
    let prc: usize = scene.scene_add(sc, root, scene.N_BOX)
    scene.node_set_id(sc, prc, 15 as u32)
    var m: ctxmenu.Ctxm = ctxmenu.ctxm_new()
    ctxmenu.ctxm_set_actions(&m, &r)
    let p1: bool = ctxmenu.ctx_provider_kind(&m, widget.KIND_TEXTBOX, ctxstd.std_prov_edit, 0 as u64)
    let p2: bool = ctxmenu.ctx_provider_key(&m, 11 as u32, ctxstd.std_prov_list, 0 as u64)
    let p3: bool = ctxmenu.ctx_provider_key(&m, 12 as u32, ctxstd.std_prov_file, 0 as u64)
    let p4: bool = ctxmenu.ctx_provider_key(&m, 13 as u32, ctxstd.std_prov_window, 0 as u64)
    let p5: bool = ctxmenu.ctx_provider_key(&m, 14 as u32, ctxstd.std_prov_task, 0 as u64)
    let p6: bool = ctxmenu.ctx_provider_key(&m, 15 as u32, ctxstd.std_prov_proc, 0 as u64)

    // --- the text field (found by its widget kind, not by a key it was given)
    HAS_SEL = false
    check(ctxmenu.ctx_request(&m, sc, fld, 10.0, 10.0, 10.0, action.SRC_MOUSE, 0 as u32, 0), "a request on a text field")
    var q: usize = 0
    var line: [usize; 16] = [0; 16]
    let n: usize = ctxmenu.menu_level_count(&m, ctxmenu.NONE)
    say("    text field menu: ")
    while q < n {
        let sl: usize = ctxmenu.menu_level_at(&m, ctxmenu.NONE, q)
        line[q] = sl
        if ctxmenu.menu_kind(&m, sl) == ctxmenu.IK_SEP { say("| ") } else {
            say(lbl(&m, sl))
            if !ctxmenu.menu_enabled(&m, sl) { say("(off)") }
            say(" ")
        }
        q = q + 1
    }
    say("\n")
    // english: ok -- the German catalog is what is tested here
    check(is_label(&m, line[0], "Rückgängig") && is_label(&m, line[1], "Wiederholen"), "German catalog: Rückgängig, Wiederholen first") // english: ok
    check(ctxmenu.menu_kind(&m, line[2]) == ctxmenu.IK_SEP, "a separator after Undo/Redo")
    check(is_label(&m, line[3], "Ausschneiden") && !ctxmenu.menu_enabled(&m, line[3]), "Ausschneiden is greyed out without a selection")
    check(is_label(&m, line[4], "Kopieren") && !ctxmenu.menu_enabled(&m, line[4]), "Kopieren is greyed out without a selection")
    // english: ok -- the German catalog is what is tested here
    check(is_label(&m, line[5], "Einfügen") && ctxmenu.menu_enabled(&m, line[5]), "Einfügen is enabled") // english: ok
    check(!ctxmenu.menu_enabled(&m, line[1]), "Wiederholen is greyed out (nothing to redo)")
    // english: ok -- the German catalog is what is tested here
    check(is_label(&m, line[n - 1], "Alles auswählen"), "Alles auswählen is last (selection group)") // english: ok
    eq("mnemonic of Einfügen is E", ctxmenu.menu_mnemonic(&m, line[5]) as i64, 69) // english: ok
    NOPLOG = 0
    let cr: u32 = ctxmenu.ctx_activate(&m, line[5])
    check(NOPLOG == 1 && OPLOG[0] == ctxstd.OP_PASTE, "activating Einfügen calls the program's act with OP_PASTE") // english: ok
    let cx0: u32 = ctxmenu.ctx_close(&m, ctxmenu.CLOSE_API)
    HAS_SEL = true
    check(ctxmenu.ctx_request(&m, sc, fld, 10.0, 10.0, 10.0, action.SRC_MOUSE, 0 as u32, 0), "again, with a selection")
    check(ctxmenu.menu_enabled(&m, ctxmenu.menu_level_at(&m, ctxmenu.NONE, 3)), "Ausschneiden is enabled with a selection")
    let cx1: u32 = ctxmenu.ctx_close(&m, ctxmenu.CLOSE_API)

    // --- a file row inside a list: two providers (file at the row, list above), plugin by tag
    let x1: bool = ctxmenu.ctx_extension_add(&m, action.act_find(&r, "file-open"), "shellext", "dir", 5)
    check(ctxmenu.ctx_request(&m, sc, frow, 10.0, 10.0, 10.0, action.SRC_MOUSE, 0 as u32, 0), "a request on a file row")
    check(ctxmenu.menu_index_of_act(&m, action.act_find(&r, "file-open")) != ctxmenu.NONE, "Open is there")
    check(ctxmenu.menu_index_of_act(&m, action.act_find(&r, "list-selectall")) != ctxmenu.NONE, "the list's Select all is merged in")
    check(ctxmenu.menu_index_of_act(&m, action.act_find(&r, "list-invert")) != ctxmenu.NONE, "... and Invert selection")
    let del: usize = ctxmenu.menu_index_of_act(&m, action.act_find(&r, "file-delete"))
    check(del != ctxmenu.NONE && ctxmenu.menu_danger(&m, del), "Delete is there and dangerous")
    let top: usize = ctxmenu.menu_level_count(&m, ctxmenu.NONE)
    eq("Delete is the last entry", ctxmenu.menu_level_at(&m, ctxmenu.NONE, top - 1) as i64, del as i64)
    eq("the first entry is Open (primary group)", ctxmenu.menu_level_at(&m, ctxmenu.NONE, 0) as i64, ctxmenu.menu_index_of_act(&m, action.act_find(&r, "file-open")) as i64)
    let cx2: u32 = ctxmenu.ctx_close(&m, ctxmenu.CLOSE_API)

    // --- the title bar
    MAXIMIZED = false
    check(ctxmenu.ctx_request(&m, sc, ttl, 10.0, 10.0, 10.0, action.SRC_MOUSE, 0 as u32, 0), "a request on the title bar")
    eq("six entries and a separator", ctxmenu.menu_level_count(&m, ctxmenu.NONE) as i64, 7)
    check(!ctxmenu.menu_enabled(&m, ctxmenu.menu_index_of_act(&m, action.act_find(&r, "window-restore"))), "Wiederherstellen is off when not maximized")
    check(ctxmenu.menu_enabled(&m, ctxmenu.menu_index_of_act(&m, action.act_find(&r, "window-maximize"))), "Maximieren is on")
    let cl: usize = ctxmenu.menu_index_of_act(&m, action.act_find(&r, "window-close"))
    // english: ok -- the German catalog is what is tested here
    check(is_label(&m, cl, "Schließen") && !ctxmenu.menu_danger(&m, cl), "Schließen is last and NOT red") // english: ok
    let cx3: u32 = ctxmenu.ctx_close(&m, ctxmenu.CLOSE_API)
    MAXIMIZED = true
    check(ctxmenu.ctx_request(&m, sc, ttl, 10.0, 10.0, 10.0, action.SRC_MOUSE, 0 as u32, 0), "maximized")
    check(ctxmenu.menu_enabled(&m, ctxmenu.menu_index_of_act(&m, action.act_find(&r, "window-restore"))), "Wiederherstellen is on when maximized")
    check(!ctxmenu.menu_enabled(&m, ctxmenu.menu_index_of_act(&m, action.act_find(&r, "window-maximize"))), "Maximieren is off")
    check(!ctxmenu.menu_enabled(&m, ctxmenu.menu_index_of_act(&m, action.act_find(&r, "window-move"))), "Verschieben is off")
    let cx4: u32 = ctxmenu.ctx_close(&m, ctxmenu.CLOSE_API)

    // --- the taskbar entry: Pin XOR Unpin
    PINNED = false
    check(ctxmenu.ctx_request(&m, sc, tsk, 10.0, 10.0, 10.0, action.SRC_MOUSE, 0 as u32, 0), "a request on a taskbar entry")
    check(ctxmenu.menu_index_of_act(&m, action.act_find(&r, "task-pin")) != ctxmenu.NONE && ctxmenu.menu_index_of_act(&m, action.act_find(&r, "task-unpin")) == ctxmenu.NONE, "not pinned: only 'anheften'")
    let cx5: u32 = ctxmenu.ctx_close(&m, ctxmenu.CLOSE_API)
    PINNED = true
    check(ctxmenu.ctx_request(&m, sc, tsk, 10.0, 10.0, 10.0, action.SRC_MOUSE, 0 as u32, 0), "pinned")
    check(ctxmenu.menu_index_of_act(&m, action.act_find(&r, "task-unpin")) != ctxmenu.NONE && ctxmenu.menu_index_of_act(&m, action.act_find(&r, "task-pin")) == ctxmenu.NONE, "pinned: only 'lösen'") // english: ok
    let cx6: u32 = ctxmenu.ctx_close(&m, ctxmenu.CLOSE_API)

    // --- the process row: End task is critical and last
    check(ctxmenu.ctx_request(&m, sc, prc, 10.0, 10.0, 10.0, action.SRC_MOUSE, 0 as u32, 0), "a request on a process row")
    let et: usize = ctxmenu.menu_index_of_act(&m, action.act_find(&r, "proc-end"))
    check(et != ctxmenu.NONE && ctxmenu.menu_danger(&m, et), "Task beenden is dangerous")
    eq("End task is critical on the bus", action.act_level(&r, action.act_find(&r, "proc-end")) as i64, action.LV_CRITICAL as i64)
    let cx7: u32 = ctxmenu.ctx_close(&m, ctxmenu.CLOSE_API)

    // --- every entry is also on the bus, and its shortcut works
    var cx: action.ActCtx = action.actx_new(0 as u64)
    NOPLOG = 0
    eq("shell.edit-copy runs from the bus", action.act_run_bus(&r, "shell.edit-copy", &cx) as i64, action.RUN_OK as i64)
    check(NOPLOG == 1 && OPLOG[0] == ctxstd.OP_COPY, "... and reaches the program as OP_COPY")
    var mb: [u8; 4096] = [0 as u8; 4096]
    let mn: usize = action.act_manifest(&r, "Shell", (&mb[0]) as *mut u8, 4096)
    check(contains(str { p: (&mb[0]) as *mut u8, n: mn }, "action shell.proc-end critical"), "the manifest lists shell.proc-end as critical")
    check(contains(str { p: (&mb[0]) as *mut u8, n: mn }, "action shell.window-close write"), "... and shell.window-close as write")
    // English catalog
    var cen: action.Catalog = action.catalog_new()
    ctxstd.std_catalog_en(&cen)
    action.act_set_catalog(&r, &cen)
    check(action.str_eq(action.act_label(&r, action.act_find(&r, "edit-copy")), "&Copy"), "English catalog: &Copy")
}

fn contains(hay: str, needle: str) -> bool {
    if needle.n > hay.n { return false }
    var i: usize = 0
    while i + needle.n <= hay.n {
        if action.str_starts(str { p: (hay.p as u64 + i as u64) as *mut u8, n: hay.n - i }, needle) {
            return true
        }
        i = i + 1
    }
    return false
}

// ----------------------------------------------------------------- manifest entries, node actions
static mut PROXY_LOG: [u32; 8] = [0 as u32; 8]
static mut NPROXY: usize = 0

fn proxy_call(ud: u64, owner: str, verb: str, cx: *mut action.ActCtx) {
    if NPROXY < 8 {
        PROXY_LOG[NPROXY] = verb.n as u32 + (owner.n as u32) * 100
        NPROXY = NPROXY + 1
    }
}

fn gr_only_good(ud: u64, owner: str, level: u32) -> bool {
    return action.str_eq(owner, "goodplug") && level != action.LV_CRITICAL
}

// the manager keeps its own address in its proxy actions; here it lives in this frame
#[allow_escape]
fn test_manifest() {
    say("== 7. ENTRIES FROM A MANIFEST, A NODE'S DEFAULT ACTION ==\n")
    var r: action.Actions = action.actions_new()
    action.act_set_app(&r, "files")
    var m: ctxmenu.Ctxm = ctxmenu.ctxm_new()
    ctxmenu.ctxm_set_actions(&m, &r)
    ctxmenu.ctx_set_proxy_call(&m, 0 as u64, proxy_call)
    ctxmenu.ctx_set_grant(&m, 0 as u64, gr_only_good)
    let text: str = "# the plugin's entries\nmenu open-with-x on .txt prio 10 level write \"Open with &X\"\nmenu share on .png level read \"&Share ...\"\nmenu wipe on .txt level critical \"Wipe\"\nmenu broken on\nbogus line\n"
    eq("three good lines are loaded (two broken ones are skipped)", ctxmenu.ctx_manifest_load(&m, "goodplug", text) as i64, 3)
    eq("three plugin entries", ctxmenu.ctx_extension_count(&m) as i64, 3)
    check(action.act_find(&r, "goodplug.open-with-x") != action.ACT_NONE, "the proxy action is goodplug.open-with-x")
    eq("its level is write by default", action.act_level(&r, action.act_find(&r, "goodplug.open-with-x")) as i64, action.LV_WRITE as i64)
    eq("level read is read", action.act_level(&r, action.act_find(&r, "goodplug.share")) as i64, action.LV_READ as i64)
    eq("level critical is critical", action.act_level(&r, action.act_find(&r, "goodplug.wipe")) as i64, action.LV_CRITICAL as i64)
    check(action.str_eq(action.act_label(&r, action.act_find(&r, "goodplug.open-with-x")), "Open with &X"), "the label is the quoted text")
    eq("a proxy is kept off this program's bus", action.act_bus_count(&r) as i64, 0)
    build_tree()
    let sc: *mut scene.Scene = gsc()
    let tgt: usize = scene.scene_find_id(sc, 4 as u32)
    // a provider that declares .txt
    let g: bool = ctxmenu.ctx_provider_global(&m, prov_txt, 0 as u64)
    check(ctxmenu.ctx_request(&m, sc, tgt, 5.0, 5.0, 5.0, action.SRC_MOUSE, 0 as u32, 0), "a request for a .txt thing")
    let open_x: usize = ctxmenu.menu_index_of_act(&m, action.act_find(&r, "goodplug.open-with-x"))
    check(open_x != ctxmenu.NONE, "'Open with X' is in the menu")
    check(ctxmenu.menu_index_of_act(&m, action.act_find(&r, "goodplug.share")) == ctxmenu.NONE, "the .png entry is not")
    check(ctxmenu.menu_index_of_act(&m, action.act_find(&r, "goodplug.wipe")) == ctxmenu.NONE, "the critical one is refused by the rights check")
    eq("... and counted as denied", ctxmenu.ctx_stat(&m, ctxmenu.ST_DENIED) as i64, 1)
    NPROXY = 0
    let rr: u32 = ctxmenu.ctx_activate(&m, open_x)
    check(NPROXY == 1 && PROXY_LOG[0] == 11 as u32 + 800 as u32, "activating it calls the proxy hook with the owner and the verb (the bus call)")
    // a node's default action
    var r2: action.Actions = action.actions_new()
    let a1: usize = action.act_add(&r2, "save", "&Save", h_count, 12 as u64)
    check(action.act_bind_node(&r2, 77 as u32, a1), "an element (key 77) is bound to Save")
    eq("the element's action is Save", action.act_node_action(&r2, 77 as u32) as i64, a1 as i64)
    var cx: action.ActCtx = action.actx_new(0 as u64)
    RAN[12] = 0
    eq("the screen reader's 'activate' runs it", action.act_run_node(&r2, 77 as u32, &cx) as i64, action.RUN_OK as i64)
    eq("... once", RAN[12], 1)
    eq("an element with no action: unknown", action.act_run_node(&r2, 78 as u32, &cx) as i64, action.RUN_UNKNOWN as i64)
    action.act_set_enabled(&r2, a1, en_false)
    eq("a disabled action does not run through the element either", action.act_run_node(&r2, 77 as u32, &cx) as i64, action.RUN_DISABLED as i64)
}

fn prov_txt(ud: u64, pc: *mut ctxmenu.ProviderCtx) {
    ctxmenu.pc_tag(pc, ".txt")
    let e: usize = ctxmenu.pc_add(pc, A[0])
}

fn main() -> i32 {
    test_actions()
    test_chain()
    test_state()
    test_place()
    test_say()
    test_std()
    test_manifest()
    if BAD == 0 {
        say("CTXMENU PASSED\n")
        return 0
    }
    say("CTXMENU FAILED\n")
    return 1
}
