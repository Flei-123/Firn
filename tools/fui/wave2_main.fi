// SPDX-License-Identifier: MPL-2.0
// tools/fui/wave2_main.fi -- THE ACCEPTANCE OF WAVE 2, AT THE PIXEL.
//
// ====================================================== WHY IT EXISTS
//
// Justin, 11.09.2026: "ACCEPTANCE -- hard, no claims." And the two
// findings from the real system that must not come back:
//
//   * "Tooltip: WITHOUT a shadow-rectangle artefact behind it. You
//      could see a grey box behind the text -- prove with a pixel
//      measurement that it is gone."
//   * "Dark mode must take effect on EVERY element -- window contents
//      stayed white, and exactly that must be impossible here."
//
// Neither can be checked by reading the source. Both are checked here
// by PAINTING and READING THE PIXELS BACK.
//
// The same programme as wave1_main.fi, and it found real bugs on its
// first run too -- they are written down at the checks that catch
// them.
import std.rt
import paint.canvas
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.wave2
import fui.control
import fui.layout

const FONTSET_BYTES: usize = 4096
const W: usize = 640
const H: usize = 260

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, got: u32, want: u32) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var h1: [u8; 5] = " got "
    rt.buf_push_bytes(&t, (&h1[0]) as u64, 5)
    rt.buf_push_hex_u64(&t, got as u64, 6)
    var h2: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&h2[0]) as u64, 6)
    rt.buf_push_hex_u64(&t, want as u64, 6)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn report_n(nm: u64, nn: usize, ok: bool, got: i64, want: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var h1: [u8; 5] = " got "
    rt.buf_push_bytes(&t, (&h1[0]) as u64, 5)
    rt.buf_push_dec_i64(&t, got)
    var h2: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&h2[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, want)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// The colour of one pixel, without the alpha.
fn px(cv: *mut canvas.Canvas, x: usize, y: usize) -> u32 {
    let p: u64 = canvas.canvas_pixels(cv) as u64
    let o: u64 = ((y * canvas.canvas_width(cv) + x) * 4) as u64
    let r8: u8 = *((p + o) as *mut u8)
    let g8: u8 = *((p + o + 1 as u64) as *mut u8)
    let b8: u8 = *((p + o + 2 as u64) as *mut u8)
    let r: u32 = r8 as u32
    let g: u32 = g8 as u32
    let b: u32 = b8 as u32
    return (r << 16) | (g << 8) | b
}

// How bright a pixel is, 0..255. The measure Justin asked for
// ("brightness values per area"). The weights are the usual ones for
// perceived brightness (ITU-R BT.601) -- a flat average would call
// pure blue as bright as pure green, and no eye agrees.
fn brightness(c: u32) -> i64 {
    let r: i64 = ((c >> 16) & 255 as u32) as i64
    let g: i64 = ((c >> 8) & 255 as u32) as i64
    let b: i64 = (c & 255 as u32) as i64
    return (r * 299 + g * 587 + b * 114) / 1000
}

fn setup(cv: *mut canvas.Canvas, z: *mut painter.Painter,
    m: *mut theme.Theme) {
    let f: *mut theme.Colors = theme.theme_colors(m)
    canvas.canvas_clear(cv, theme.opaque((*f).base))
}

fn main(start: u64) -> i32 {
    // ---- the font
    var fbuf: rt.Buf = rt.buf_new()
    var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
    let have: bool = rt.read_file((&f1[0]) as u64, &fbuf)
    let fsp: *mut metrics.FontSet =
        rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }

    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 200) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(true)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)

    // ==================================================================
    // 1. THE CHECKBOX REALLY SHOWS ITS STATE
    // ==================================================================
    //
    // Off: the box carries the field colour. On: the accent. If the two
    // were the same, you could not tell a ticked checkbox from an
    // unticked one -- and that is exactly the class of bug that made
    // all five buttons the same grey in wave 1.
    setup(&cv, &z, &m)
    var cb: widget.Widget = widget.widget_new(widget.KIND_CHECKBOX)
    widget.w_place(&cb, 20.0, 20.0, 200.0, 32.0)
    var tcb: [u8; 8] = "Checked "
    widget.w_set_text(&cb, (&tcb[0]) as u64, 7)
    wave2.draw_any(&c, &cb)
    // the box sits at the left edge, vertically centred
    let boxmid_x: usize = 20 + 7
    let boxmid_y: usize = 20 + 16
    let off_col: u32 = px(&cv, boxmid_x, boxmid_y)
    var n1: [u8; 36] = "1 checkbox off = the field colour   "
    report((&n1[0]) as u64, 35, off_col == (*f).field, off_col,
        (*f).field)

    setup(&cv, &z, &m)
    widget.w_set_value(&cb, 1)
    wave2.draw_any(&c, &cb)
    // Measured at a corner of the box, NOT in the middle: the tick
    // sits in the middle and would be measured instead of the fill.
    let on_col: u32 = px(&cv, 20 + 2, 20 + 16 - 5)
    var n2: [u8; 34] = "1 checkbox on = the accent        "
    report((&n2[0]) as u64, 33, on_col == (*f).accent, on_col,
        (*f).accent)

    // AND THE TICK IS REALLY THERE. Without this check a checkbox that
    // paints the fill but forgets the mark would pass -- and it would
    // look "on" in one place and unreadable in another.
    var tickpx: usize = 0
    var yy: usize = 20 + 8
    while yy < 20 + 24 {
        var xx: usize = 20
        while xx < 20 + 16 {
            if px(&cv, xx, yy) != (*f).accent {
                tickpx = tickpx + 1
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
    var n3: [u8; 34] = "1 and the tick is really drawn    "
    report_n((&n3[0]) as u64, 33, tickpx > 10, tickpx as i64, 10)

    // ==================================================================
    // 2. HOVER CHANGES THE PICTURE -- NOT JUST THE STRUCT
    // ==================================================================
    //
    // THIS IS JUSTIN'S POINT, MEASURED. control_main.fi shows that the
    // BIT gets set; here it is shown that the PIXELS change because of
    // it. Both halves are needed: a bit nobody paints is worth as
    // little as a paint nobody triggers.
    setup(&cv, &z, &m)
    var bt: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&bt, 20.0, 20.0, 120.0, 32.0)
    wave2.draw_any(&c, &bt)
    let rest: u32 = px(&cv, 80, 24)

    // Now through the REAL event path -- not by setting the bit.
    var arr: [widget.Widget; 1] =
        [widget.widget_new(widget.KIND_BUTTON); 1]
    widget.w_place(&arr[0], 20.0, 20.0, 120.0, 32.0)
    var pn: control.Panel = control.panel_new()
    control.panel_attach(&pn, (&arr[0]) as u64, 1)
    let ch: u32 = control.mouse_move(&pn, 80.0, 36.0)
    setup(&cv, &z, &m)
    wave2.draw_any(&c, &arr[0])
    let hov: u32 = px(&cv, 80, 24)

    var n4: [u8; 43] = "2 mouse move really changes the pixels     "
    report((&n4[0]) as u64, 42, hov != rest, hov, rest)
    var n5: [u8; 41] = "2 and the event asked for a repaint      "
    report_n((&n5[0]) as u64, 40,
        (ch & control.CH_REPAINT) != 0 as u32, 1, 1)

    // ==================================================================
    // 3. THE SLIDER: THE HANDLE FOLLOWS THE VALUE
    // ==================================================================
    //
    // Painted at 0, 500 and 1000 and the handle LOOKED FOR each time.
    //
    // MEASURED NEAR THE TOP EDGE (y = 22) AND NOT IN THE MIDDLE. The
    // first version probed the middle row and got 120 all three times:
    // there the TRACK runs right across, so the longest non-background
    // run is the whole track and the handle disappears inside it. Two
    // pixels below the top edge only the handle reaches -- it is as
    // tall as the widget, the track is four points thin. That is not a
    // trick, it is the only row where the answer is unambiguous.
    // That is the proof that the drawing really reads the value --
    // a handle painted at a fixed place is the "fake switch" the brief
    // forbids, and it would pass any check that only looks at one
    // value.
    var sl: widget.Widget = widget.widget_new(widget.KIND_SLIDER)
    widget.w_place(&sl, 20.0, 20.0, 200.0, 24.0)

    widget.w_set_value(&sl, 0)
    setup(&cv, &z, &m)
    wave2.draw_any(&c, &sl)
    let h0: i64 = find_handle(&cv, 20, 220, 22, (*f).base)

    widget.w_set_value(&sl, 500)
    setup(&cv, &z, &m)
    wave2.draw_any(&c, &sl)
    let h5: i64 = find_handle(&cv, 20, 220, 22, (*f).base)

    widget.w_set_value(&sl, 1000)
    setup(&cv, &z, &m)
    wave2.draw_any(&c, &sl)
    let h10: i64 = find_handle(&cv, 20, 220, 22, (*f).base)

    var n6: [u8; 39] = "3 slider 0: handle at the left         "
    report_n((&n6[0]) as u64, 38, h0 >= 20 && h0 < 50, h0, 32)
    var n7: [u8; 39] = "3 slider 500: handle in the middle     "
    report_n((&n7[0]) as u64, 38, h5 > 100 && h5 < 140, h5, 120)
    var n8: [u8; 39] = "3 slider 1000: handle at the right     "
    report_n((&n8[0]) as u64, 38, h10 > 190 && h10 <= 220, h10, 208)
    var n9: [u8; 43] = "3 the three positions really differ        "
    report_n((&n9[0]) as u64, 42, h0 < h5 && h5 < h10, h5, h5)

    // AND THE FILLED PART GROWS WITH IT. A slider whose track never
    // fills says nothing about where it stands until you find the
    // handle.
    widget.w_set_value(&sl, 800)
    setup(&cv, &z, &m)
    wave2.draw_any(&c, &sl)
    var accpx: usize = 0
    var sx: usize = 20
    while sx < 220 {
        if px(&cv, sx, 32) == (*f).accent {
            accpx = accpx + 1
        }
        sx = sx + 1
    }
    var n10: [u8; 41] = "3 the filled part is really painted      "
    report_n((&n10[0]) as u64, 40, accpx > 60, accpx as i64, 60)

    // ==================================================================
    // 4. THE PROGRESS BAR READS ITS VALUE
    // ==================================================================
    var pr: widget.Widget = widget.widget_new(widget.KIND_PROGRESS)
    widget.w_place(&pr, 20.0, 20.0, 200.0, 16.0)
    widget.w_set_value(&pr, 250)
    setup(&cv, &z, &m)
    wave2.draw_any(&c, &pr)
    // At a quarter it must be accent, at three quarters not.
    let q1: u32 = px(&cv, 20 + 30, 28)
    let q3: u32 = px(&cv, 20 + 170, 28)
    var n11: [u8; 39] = "4 progress 25%: filled at the front    "
    report((&n11[0]) as u64, 38, q1 == (*f).accent, q1, (*f).accent)
    var n12: [u8; 39] = "4 progress 25%: empty at the back      "
    report((&n12[0]) as u64, 38, q3 != (*f).accent, q3, (*f).field)

    // ==================================================================
    // 5. THE TOGGLE SWITCH REALLY MOVES ITS THUMB
    // ==================================================================
    // GEMESSEN WIRD DER GRIFF, UND NICHT MEHR DER BALKEN DAHINTER.
    // Bis zum 22.09.2026 wurde der Griff gegen die GRUNDFARBE der
    // Leinwand gesucht -- das ging nur gut, solange der Schalter seine
    // ganze Zeile grau ausmalte: gefunden wurde in Wahrheit die Kante
    // dieses grauen Balkens, nicht der Griff. (Nachgerechnet: im
    // dunklen Schema ist `text_on_accent` 0x1C1B22, also genau die
    // Grundfarbe -- der eingeschaltete Griff war fuer diese Suche
    // ueberhaupt nicht zu sehen.) Seit lib/fui/render.fi den Schalter
    // nur noch seinen KASTEN faerben laesst (Abschnitt 10), gibt es
    // diesen Balken nicht mehr, und die Suche laeuft dort, wo sie
    // hingehoert: INNERHALB der Pille.
    //
    // Der Griff ist dort der HELLIGKEITSAUSREISSER: ausgeschaltet
    // liegt er ueber der Pille (heller Punkt auf dunklem Feld),
    // eingeschaltet darunter (dunkler Punkt auf dem Akzent). Genau das
    // sucht `find_extreme` -- ohne eine einzige Farbe oder Abmessung
    // aus wave2.fi nachzubauen. Die Breite der Pille wird aus dem
    // ausgeschalteten Bild abgelesen (rechts davon steht der
    // Untergrund) und fuer beide Messungen benutzt, denn sie haengt
    // nicht vom Wert ab.
    var tg: widget.Widget = widget.widget_new(widget.KIND_TOGGLE)
    widget.w_place(&tg, 20.0, 20.0, 120.0, 32.0)
    widget.w_set_value(&tg, 0)
    setup(&cv, &z, &m)
    wave2.draw_any(&c, &tg)
    let pill_r: usize = letzte_fremde(&cv, 20, 70, 36, (*f).base)
    let t_off: i64 = find_extreme(&cv, 21, pill_r - 1, 36, true)
    widget.w_set_value(&tg, 1)
    setup(&cv, &z, &m)
    wave2.draw_any(&c, &tg)
    let t_on: i64 = find_extreme(&cv, 21, pill_r - 1, 36, false)
    var n13: [u8; 41] = "5 the toggle thumb really moves          "
    report_n((&n13[0]) as u64, 40, t_on > t_off + 5, t_on - t_off, 10)

    // ==================================================================
    // 6. DISABLED IS VISIBLY WEAKER -- ON EVERY CONTROL
    // ==================================================================
    //
    // Not "a field in the struct" but measured: the label of a disabled
    // control has to be CLEARLY paler than that of an enabled one.
    // Checked on the checkbox, because it was the one that painted its
    // label through a path of its own.
    setup(&cv, &z, &m)
    var cd: widget.Widget = widget.widget_new(widget.KIND_CHECKBOX)
    widget.w_place(&cd, 20.0, 20.0, 200.0, 32.0)
    var tl: [u8; 6] = "Label "
    widget.w_set_text(&cd, (&tl[0]) as u64, 5)
    wave2.draw_any(&c, &cd)
    let bright_on: i64 = darkest(&cv, 40, 200, 20, 52)

    setup(&cv, &z, &m)
    widget.w_set_disabled(&cd, true)
    wave2.draw_any(&c, &cd)
    let bright_off: i64 = darkest(&cv, 40, 200, 20, 52)

    // In the dark scheme the text is BRIGHT, so "paler" means darker
    // -- the disabled text has to stay below the normal one.
    var n14: [u8; 43] = "6 disabled label is visibly weaker         "
    report_n((&n14[0]) as u64, 42, bright_off < bright_on - 20,
        bright_on - bright_off, 20)

    // ==================================================================
    // 7. DARK MODE TAKES EFFECT ON EVERY CONTROL
    // ==================================================================
    //
    // JUSTIN'S SECOND FINDING FROM THE REAL SYSTEM: "window contents
    // stayed white". The check is blunt and therefore useful: paint
    // EVERY control of wave 2 once light and once dark, and require
    // that the picture really differs -- and that the dark one is
    // DARKER.
    //
    // A control that wrote a colour into itself would show up here at
    // once, because its patch would be the same in both.
    var kinds: [u32; 12] = [widget.KIND_CHECKBOX, widget.KIND_RADIO,
        widget.KIND_TOGGLE, widget.KIND_SLIDER, widget.KIND_SCROLLBAR,
        widget.KIND_PROGRESS, widget.KIND_DROPDOWN, widget.KIND_TAB,
        widget.KIND_TOOLBAR, widget.KIND_MENU, widget.KIND_TOOLTIP,
        widget.KIND_GROUPBOX]
    var ki: usize = 0
    var dark_fails: usize = 0
    var same_fails: usize = 0
    while ki < 12 {
        var tt: [u8; 5] = "Text "
        // --- light
        theme.theme_set_dark(&m, false)
        let lf: *mut theme.Colors = theme.theme_colors(&m)
        canvas.canvas_clear(&cv, theme.opaque((*lf).base))
        var wl: widget.Widget = widget.widget_new(kinds[ki])
        widget.w_place(&wl, 20.0, 20.0, 180.0, 32.0)
        widget.w_set_text(&wl, (&tt[0]) as u64, 4)
        widget.w_set_value(&wl, 600)
        wave2.draw_any(&c, &wl)
        let bl: i64 = mean_brightness(&cv, 20, 200, 20, 52)

        // --- dark
        theme.theme_set_dark(&m, true)
        let df: *mut theme.Colors = theme.theme_colors(&m)
        canvas.canvas_clear(&cv, theme.opaque((*df).base))
        var wd: widget.Widget = widget.widget_new(kinds[ki])
        widget.w_place(&wd, 20.0, 20.0, 180.0, 32.0)
        widget.w_set_text(&wd, (&tt[0]) as u64, 4)
        widget.w_set_value(&wd, 600)
        wave2.draw_any(&c, &wd)
        let bd: i64 = mean_brightness(&cv, 20, 200, 20, 52)

        if bl == bd {
            same_fails = same_fails + 1
        }
        if bd >= bl {
            dark_fails = dark_fails + 1
        }
        ki = ki + 1
    }
    var n15: [u8; 43] = "7 dark mode changes every control          "
    report_n((&n15[0]) as u64, 42, same_fails == 0,
        same_fails as i64, 0)
    var n16: [u8; 43] = "7 and dark is really darker everywhere     "
    report_n((&n16[0]) as u64, 42, dark_fails == 0,
        dark_fails as i64, 0)

    // ==================================================================
    // 8. THE TOOLTIP HAS NO GREY BOX BEHIND IT
    // ==================================================================
    //
    // ================= THE CHECK THIS WHOLE FILE WAS WRITTEN FOR
    //
    // Justin, 11.09.2026: in the real system a grey rectangle stood
    // behind the tooltip text. The cause is named in wave2.fi: a
    // shadow painted as a RECTANGLE under a ROUNDED panel sticks out
    // at all four corners, because the rect has corners where the
    // panel has none.
    //
    // So that is where it is measured: the four pixels DIAGONALLY
    // OUTSIDE the corners. They have to hold the background, unchanged.
    // A shadow rect would be sitting exactly there.
    theme.theme_set_dark(&m, true)
    let df2: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque((*df2).base))
    let bg_before: u32 = px(&cv, 10, 10)

    var tp: widget.Widget = widget.widget_new(widget.KIND_TOOLTIP)
    var ttext: [u8; 13] = "Save the file"
    var tw: f64 = 0.0
    var th: f64 = 0.0
    wave2.tooltip_size(&c, (&ttext[0]) as u64, 13, &tw, &th)
    let tx: f64 = 60.0
    let ty: f64 = 60.0
    widget.w_place(&tp, tx, ty, tw, th)
    widget.w_set_text(&tp, (&ttext[0]) as u64, 13)
    wave2.draw_any(&c, &tp)

    // the four corners, two pixels out on the diagonal
    let x0: usize = (tx as usize) - 2
    let y0: usize = (ty as usize) - 2
    let x1: usize = (tx + tw) as usize + 1
    let y1: usize = (ty + th) as usize + 1
    let c1: u32 = px(&cv, x0, y0)
    let c2: u32 = px(&cv, x1, y0)
    let c3: u32 = px(&cv, x0, y1)
    let c4: u32 = px(&cv, x1, y1)
    var n17: [u8; 45] = "8 tooltip: nothing outside the top left      "
    report((&n17[0]) as u64, 44, c1 == bg_before, c1, bg_before)
    var n18: [u8; 45] = "8 tooltip: nothing outside the top right     "
    report((&n18[0]) as u64, 44, c2 == bg_before, c2, bg_before)
    var n19: [u8; 45] = "8 tooltip: nothing outside the low left      "
    report((&n19[0]) as u64, 44, c3 == bg_before, c3, bg_before)
    var n20: [u8; 45] = "8 tooltip: nothing outside the low right     "
    report((&n20[0]) as u64, 44, c4 == bg_before, c4, bg_before)

    // AND THE WHOLE FRAME AROUND IT IS CLEAN -- not just four points.
    // A shadow offset to one side would slip past four corner probes.
    var dirty: usize = 0
    var ex: usize = x0
    while ex <= x1 {
        if px(&cv, ex, y0) != bg_before {
            dirty = dirty + 1
        }
        if px(&cv, ex, y1) != bg_before {
            dirty = dirty + 1
        }
        ex = ex + 1
    }
    var ey: usize = y0
    while ey <= y1 {
        if px(&cv, x0, ey) != bg_before {
            dirty = dirty + 1
        }
        if px(&cv, x1, ey) != bg_before {
            dirty = dirty + 1
        }
        ey = ey + 1
    }
    var n21: [u8; 45] = "8 and the whole ring around it is clean      "
    report_n((&n21[0]) as u64, 44, dirty == 0, dirty as i64, 0)

    // The tooltip itself is of course NOT empty -- otherwise the check
    // above would be trivially true.
    let inside: u32 = px(&cv, (tx as usize) + 4, (ty as usize) + 4)
    var n22: [u8; 43] = "8 but the tooltip itself is painted        "
    report((&n22[0]) as u64, 42, inside != bg_before, inside,
        (*df2).surface_raised)

    // THE TEXT FITS INSIDE IT. `tooltip_size` has to be honest --
    // whoever measures too small cuts the text off, and that is the
    // "clipped label" the brief asks about.
    var textpx: usize = 0
    var ty2: usize = ty as usize
    while ty2 < (ty + th) as usize {
        var tx2: usize = tx as usize
        while tx2 < (tx + tw) as usize {
            let q: u32 = px(&cv, tx2, ty2)
            if q != (*df2).surface_raised && q != (*df2).border_col {
                textpx = textpx + 1
            }
            tx2 = tx2 + 1
        }
        ty2 = ty2 + 1
    }
    var n23: [u8; 43] = "8 and the text really sits inside it       "
    report_n((&n23[0]) as u64, 42, textpx > 30, textpx as i64, 30)

    // AND THE MEASUREMENT COVERS THE WHOLE STRING. Whoever hands
    // `tooltip_size` a length one byte short of the text gets a box
    // one letter short of the text -- that is how the clipped label
    // came about in the gallery. So the measured width is held
    // against the width of ALL 13 bytes plus the two paddings the
    // shape prescribes; a truncated caption turns the run red here.
    let zz: *mut painter.Painter = render.ctx_painter(&c)
    let sh2: *mut theme.Shape = theme.theme_shape(&m)
    let fpx: f64 = render.len_of(&c, (*sh2).font)
    let pad2: f64 = render.len_of(&c, (*sh2).sp_s)
    let want_w: f64 = painter.text_width(zz, (&ttext[0]) as u64, 13,
        fpx) + 2.0 * pad2
    var nt1: [u8; 45] = "8 tooltip_size covers all 13 bytes (x100)    "
    report_n((&nt1[0]) as u64, 44,
        (tw * 100.0) as i64 == (want_w * 100.0) as i64,
        (tw * 100.0) as i64, (want_w * 100.0) as i64)

    // And that last byte really does carry width -- otherwise the
    // check above would also pass on a text cut short.
    let short_w: f64 = painter.text_width(zz, (&ttext[0]) as u64, 12,
        fpx)
    var nt2: [u8; 45] = "8 the last letter is worth at least 4 px     "
    report_n((&nt2[0]) as u64, 44,
        (want_w - 2.0 * pad2 - short_w) >= 4.0,
        ((want_w - 2.0 * pad2 - short_w) * 100.0) as i64, 400)

    // ==================================================================
    // 9. NO CONTROL CARRIES A COLOUR OF ITS OWN
    // ==================================================================
    //
    // The rule "colour only out of theme/style" is checked in the BUILD
    // (tools/fui/run.sh greps the source for literal colour values).
    // Here the effect is measured instead: with a theme whose accent is
    // set to something unmistakable, every control that uses the accent
    // has to show THAT colour. One that had written 0x0A84FF into
    // itself would keep the old blue.
    theme.theme_set_dark(&m, true)
    let f9: *mut theme.Colors = theme.theme_colors(&m)
    (*f9).accent = 16711935 as u32     // magenta -- occurs nowhere else
    canvas.canvas_clear(&cv, theme.opaque((*f9).base))
    var pr9: widget.Widget = widget.widget_new(widget.KIND_PROGRESS)
    widget.w_place(&pr9, 20.0, 20.0, 200.0, 16.0)
    widget.w_set_value(&pr9, 900)
    wave2.draw_any(&c, &pr9)
    let acc9: u32 = px(&cv, 60, 28)
    var n24: [u8; 45] = "9 the accent really comes from the theme     "
    report((&n24[0]) as u64, 44, acc9 == 16711935 as u32, acc9,
        16711935 as u32)

    // ==================================================================
    // 10. DER SCHALTER FAERBT SEINEN KASTEN, NICHT SEINE ZEILE
    // ==================================================================
    //
    // DER FEHLER, DEN DIESER ABSCHNITT FESTNAGELT. In lib/fui/render.fi
    // stand `KIND_TOGGLE` in ZWEI Zweigen: in `def_bg_state` unter den
    // knopfartigen (also mit einer grauen Flaeche ueber die ganze
    // Zeile) und in `def_bg` unter den durchsichtigen. Gewonnen hat die
    // Reihenfolge der Abfragen, nicht die dokumentierte Regel -- der
    // Schalter malte einen Knopfbalken hinter seine Beschriftung, und
    // in den Belegen 03/04 (fui-wave2-light/dark.png) war er zu sehen.
    //
    // Gemessen wird der Streifen OBERHALB der Pille: die Pille ist so
    // hoch wie die Schrift und sitzt senkrecht in der Mitte, also ist
    // in den ersten Zeilen der Widget-Flaeche weder Pille noch Schrift.
    // Dort darf kein einziger Bildpunkt vom Untergrund abweichen.
    //
    // UND DIE GEGENPROBE: derselbe Streifen unter einem KNOPF derselben
    // Groesse MUSS Flaeche tragen. Ohne sie waere die Null oben auch
    // dann gruen, wenn gar nichts mehr gemalt wuerde.
    theme.theme_set_dark(&m, true)
    let f10: *mut theme.Colors = theme.theme_colors(&m)
    (*f10).accent = 16711935 as u32
    let grund10: u32 = theme.opaque((*f10).base) & 16777215 as u32
    var t10: [u8; 6] = "Wi-Fi "
    var tg10: widget.Widget = widget.widget_new(widget.KIND_TOGGLE)
    widget.w_place(&tg10, 20.0, 20.0, 200.0, 32.0)
    widget.w_set_text(&tg10, (&t10[0]) as u64, 5)
    canvas.canvas_clear(&cv, theme.opaque((*f10).base))
    wave2.draw_any(&c, &tg10)
    var fremd10: i64 = 0
    var y10: usize = 21
    while y10 < 25 {
        var x10: usize = 21
        while x10 < 219 {
            if px(&cv, x10, y10) != grund10 {
                fremd10 = fremd10 + 1
            }
            x10 = x10 + 1
        }
        y10 = y10 + 1
    }
    var n25: [u8; 46] = "10 the toggle row carries no surface          "
    report_n((&n25[0]) as u64, 45, fremd10 == 0, fremd10, 0)

    var kn10: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&kn10, 20.0, 20.0, 200.0, 32.0)
    widget.w_set_text(&kn10, (&t10[0]) as u64, 5)
    canvas.canvas_clear(&cv, theme.opaque((*f10).base))
    wave2.draw_any(&c, &kn10)
    var fremd11: i64 = 0
    y10 = 21
    while y10 < 25 {
        var x11: usize = 21
        while x11 < 219 {
            if px(&cv, x11, y10) != grund10 {
                fremd11 = fremd11 + 1
            }
            x11 = x11 + 1
        }
        y10 = y10 + 1
    }
    var n26: [u8; 46] = "10 counter-proof: a BUTTON does carry one     "
    report_n((&n26[0]) as u64, 45, fremd11 > 700, fremd11, 700)

    // ---- the verdict
    if G_ERRORS != 0 {
        var bad: [u8; 16] = "\nWAVE 2 FAILED.\n"
        rt.write_everything(2, (&bad[0]) as u64, 16)
        return 1
    }
    var okm: [u8; 16] = "\nWAVE 2 PASSED.\n"
    rt.write_everything(1, (&okm[0]) as u64, 16)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    return 0
}

// WHERE THE HANDLE SITS. Looked for as the widest run of pixels that
// are neither the background nor the track -- that is the handle,
// whatever colour the theme gives it.
//
// Gives back its MIDDLE, or -1.
fn find_handle(cv: *mut canvas.Canvas, x0: usize, x1: usize,
    y: usize, bg: u32) -> i64 {
    // The row through the middle of the widget. The handle is the
    // tallest thing there, so it is found by looking one row ABOVE the
    // track: the track is thin, the handle is not.
    var best_start: i64 = 0 - 1
    var best_len: i64 = 0
    var cur_start: i64 = 0 - 1
    var cur_len: i64 = 0
    var x: usize = x0
    while x <= x1 {
        let c: u32 = px(cv, x, y)
        if c != bg {
            if cur_start < 0 {
                cur_start = x as i64
                cur_len = 0
            }
            cur_len = cur_len + 1
            if cur_len > best_len {
                best_len = cur_len
                best_start = cur_start
            }
        } else {
            cur_start = 0 - 1
            cur_len = 0
        }
        x = x + 1
    }
    if best_start < 0 {
        return 0 - 1
    }
    return best_start + best_len / 2
}

// DIE RECHTE KANTE EINER FLAECHE. Gesucht wird der letzte Bildpunkt
// der Zeile, der NICHT die Grundfarbe traegt -- damit steht die Breite
// der Pille eines Schalters im Bild und muss nicht aus wave2.fi
// nachgerechnet werden (dort haengt sie an `box_side` mal 1.8, und
// eine zweite Fassung dieser Zahl waere genau der zweite Ort, den
// dieser Baum nicht erlaubt).
fn letzte_fremde(cv: *mut canvas.Canvas, x0: usize, x1: usize, y: usize,
    bg: u32) -> usize {
    var letzte: usize = x0
    var x: usize = x0
    while x <= x1 {
        if px(cv, x, y) != bg {
            letzte = x
        }
        x = x + 1
    }
    return letzte
}

// DER HELLIGKEITSAUSREISSER EINER ZEILE. Die Schwelle ist die Mitte
// zwischen dem dunkelsten und dem hellsten Punkt des Abschnitts, und
// gesucht wird die laengste zusammenhaengende Kette auf der verlangten
// Seite davon; zurueck kommt ihre Mitte. So laesst sich ein Griff auf
// einer Flaeche finden, ohne seine Farbe zu kennen -- und er wird in
// beiden Schemata gefunden, auch wenn er dort einmal heller und einmal
// dunkler ist als das, worauf er liegt.
fn find_extreme(cv: *mut canvas.Canvas, x0: usize, x1: usize, y: usize,
    heller: bool) -> i64 {
    var lo: i64 = 255
    var hi: i64 = 0
    var x: usize = x0
    while x <= x1 {
        let b: i64 = brightness(px(cv, x, y))
        if b < lo { lo = b }
        if b > hi { hi = b }
        x = x + 1
    }
    let schwelle: i64 = (lo + hi) / 2
    var best_start: i64 = 0 - 1
    var best_len: i64 = 0
    var cur_start: i64 = 0 - 1
    var cur_len: i64 = 0
    x = x0
    while x <= x1 {
        let b: i64 = brightness(px(cv, x, y))
        var drin: bool = b < schwelle
        if heller {
            drin = b > schwelle
        }
        if drin {
            if cur_start < 0 {
                cur_start = x as i64
                cur_len = 0
            }
            cur_len = cur_len + 1
            if cur_len > best_len {
                best_len = cur_len
                best_start = cur_start
            }
        } else {
            cur_start = 0 - 1
            cur_len = 0
        }
        x = x + 1
    }
    if best_start < 0 {
        return 0 - 1
    }
    return best_start + best_len / 2
}

// The mean brightness of an area. The measure for "dark mode really
// took effect".
fn mean_brightness(cv: *mut canvas.Canvas, x0: usize, x1: usize,
    y0: usize, y1: usize) -> i64 {
    var sum: i64 = 0
    var n: i64 = 0
    var y: usize = y0
    while y < y1 {
        var x: usize = x0
        while x < x1 {
            sum = sum + brightness(px(cv, x, y))
            n = n + 1
            x = x + 1
        }
        y = y + 1
    }
    if n == 0 {
        return 0
    }
    return sum / n
}

// The brightest pixel of an area -- that is the text in a dark scheme.
fn darkest(cv: *mut canvas.Canvas, x0: usize, x1: usize, y0: usize,
    y1: usize) -> i64 {
    var best: i64 = 0
    var y: usize = y0
    while y < y1 {
        var x: usize = x0
        while x < x1 {
            let b: i64 = brightness(px(cv, x, y))
            if b > best {
                best = b
            }
            x = x + 1
        }
        y = y + 1
    }
    return best
}
