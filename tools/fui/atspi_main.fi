// SPDX-License-Identifier: MPL-2.0
// tools/fui/atspi_main.fi -- THE CHECK OF lib/fui/atspi.fi (AT-SPI bridge), WITHOUT A WINDOW.
//
// Builds a window (settings controls, a heading, a virtual list, a table, a Quit button), paints it,
// writes the a11y JSON of the tree to $FUI_ATSPI_JSON, connects to the bus at $FUI_ATSPI_ADDR
// and serves AT-SPI calls until the Quit button's action is run over the bus (or 25 s).
// tools/fui/atspi_test.py is the client: it walks the tree over D-Bus and compares it with the JSON.
//
//     tools/fui/atspi.sh   (private dbus-daemon, firnc build, python client)
import std.rt
import fui.safeout
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.a11y
import fui.atspi
import fui.control
import fui.vlist
import std.env

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut LAST_ID: usize = 0

static mut MAIL_ID: usize = 0
static mut OUT_ID: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_num(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

static mut FONT: u64 = 0

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn settle(a: *mut app.App) {
    let i: usize = fuiwirt.host_take_activated(app.app_host(a))
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
}

fn click_at(a: *mut app.App, s: *mut Surface, x: f64, y: f64) {
    let w: *mut fuiwirt.Host = app.app_host(a)
    let c1: u32 = fuiwirt.host_pointer_move(w, x, y)
    let c2: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let c3: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
    settle(a)
    frame(a, s)
}

fn click(a: *mut app.App, s: *mut Surface, id: usize) {
    let sc: *mut scene.Scene = app.app_scene(a)
    click_at(a, s, scene.node_x(sc, id) + scene.node_w(sc, id) / 2.0,
        scene.node_y(sc, id) + scene.node_h(sc, id) / 2.0)
}

fn key(a: *mut app.App, s: *mut Surface, k: u32) {
    let used: bool = app.app_key(a as u64, k, 0 as u32)
    if !used {
        let h: u32 = fuiwirt.host_key(app.app_host(a), 0 as u32, 0 as u32)
    }
    frame(a, s)
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
    LAST_ID = id
}

fn focus_on(a: *mut app.App, id: usize) {
    let r: u32 = fuiwirt.host_pointer_move(app.app_host(a), 1.0, 1.0)
    let f: bool = false
}

static mut QUIT: bool = false
static mut APP: u64 = 0
static mut SURF: u64 = 0
static mut QUIT_ID: usize = 0
static mut SERVED_ACTIONS: usize = 0

#[allow_escape]
fn row_of(ud: u64, i: usize, out: *mut vlist.VRow) {
    var d: [u8; 8] = [82, 111, 119, 32, 48, 48, 0, 0]
    d[4] = (48 + (i / 10) % 10) as u8
    d[5] = (48 + i % 10) as u8
    vlist.vrow_text(out, str { p: &d[0], n: 6 })
}

fn on_quit(a: *mut app.App) {
    QUIT = true
}

// DoAction over the bus -> the same path as a click (the hit test of the pointer path)
fn on_action(ud: u64, node: usize, row: usize) -> bool {
    SERVED_ACTIONS = SERVED_ACTIONS + 1
    if node == QUIT_ID {
        QUIT = true
        return true
    }
    if row != app.NONE {
        // W42: a row = a click in its middle (selects it); a header (row >= ACT_HEAD = 1 << 40) = a click on the title
        let a: *mut app.App = APP as *mut app.App
        var q: [i64; 4] = [0; 4]
        if row >= 1099511627776 {
            a11y.a11y_vhead_rect(app.app_scene(a), app.ax(a), node, row - 1099511627776, &q)
        } else {
            a11y.a11y_vrow_rect(app.app_scene(a), app.ax(a), node, row, &q)
        }
        if q[2] > 0 && q[3] > 0 {
            click_at(a, SURF as *mut Surface, (q[0] as f64) + (q[2] as f64) / 2.0, (q[1] as f64) + (q[3] as f64) / 2.0)
        }
        return true
    }
    click(APP as *mut app.App, SURF as *mut Surface, node)
    return true
}

fn on_focus(ud: u64, node: usize) -> bool {
    let w: *mut fuiwirt.Host = app.app_host(APP as *mut app.App)
    let r: u32 = control.panel_set_focus(fuiwirt.host_panel(w), node)
    fuiwirt.host_touch(w)
    return true
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("atspi: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Settings", 520, 700)
    let hd: usize = app.label(a, "Preferences", 0)
    a11y.a11y_set_role(app.ax(a), hd, a11y.ROLE_HEADING)
    a11y.a11y_set_level(app.ax(a), hd, 1 as u32)
    let cb: usize = appctl.checkbox(a, "Dark mode", false, changed)
    let tg: usize = appctl.toggle(a, "Notifications", false, changed)
    let r1: usize = appctl.radio(a, 1, "Small", true, changed)
    let r2: usize = appctl.radio(a, 1, "Large", false, changed)
    let sl: usize = appctl.slider(a, "Volume", 0, 100, 40, changed)
    let pg: usize = appctl.progress(a, "Download", 0, 100, 25)
    let dd: usize = appctl.dropdown(a, "Language", changed)
    let o1: bool = appctl.dropdown_add(a, dd, "English")
    let tb: usize = appctl.tabs(a)
    let t1: usize = appctl.tab(a, tb, "General", changed)
    let t2: usize = appctl.tab(a, tb, "Advanced", changed)
    appctl.tabs_end(a)
    let p1: usize = appctl.tab_page(a, tb)
    let l1: usize = app.label(a, "page one", 0)
    app.end(a)
    let p2: usize = appctl.tab_page(a, tb)
    let l2: usize = app.label(a, "page two", 0)
    app.end(a)
    let en: usize = app.entry(a, "Search")
    let vl: usize = app.vlist_new(a, "Big list", 480, 150, 50, row_of, 0)
    let tbl: usize = appctl.table(a, "People", 480, 90, 3, changed)
    appctl.table_col(a, tbl, 0, "Name", 200, false)
    appctl.table_col(a, tbl, 1, "Age", 120, false)
    appctl.table_col(a, tbl, 2, "ID", 160, true)
    let tr0: usize = appctl.table_add_row(a, tbl)
    appctl.table_set(a, tbl, tr0, 0, "Anna")
    appctl.table_set(a, tbl, tr0, 1, "7")
    appctl.table_set(a, tbl, tr0, 2, "a-01")
    let tr1: usize = appctl.table_add_row(a, tbl)
    appctl.table_set(a, tbl, tr1, 0, "Bruno")
    appctl.table_set(a, tbl, tr1, 1, "25")
    appctl.table_set(a, tbl, tr1, 2, "b-02")
    let qb: usize = app.button(a, "Quit", on_quit)
    QUIT_ID = qb
    let ds: str = "Switches the dark theme"
    a11y.a11y_set_description(app.ax(a), cb, (ds.p) as u64, ds.n)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 520, 700)
    APP = a as u64
    SURF = s as u64
    frame(a, s)
    frame(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    // the JSON oracle
    let jp: str = env.get("FUI_ATSPI_JSON")
    if jp.n > 0 {
        let jb: u64 = rt.heap_alloc(262144)
        let jn: usize = a11y.a11y_dump_json(sc, app.ax(a), jb, 262144)
        var pb: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&pb, (jp.p) as u64, jp.n)
        rt.buf_push(&pb, 0 as u8)
        let wok: bool = safeout.write_file(rt.buf_ptr(&pb), jb, jn)
        rt.buf_free(&pb)
    }
    let addr: str = env.get("FUI_ATSPI_ADDR")
    var br: atspi.Bridge = atspi.bridge_new(sc, app.ax(a), "Settings")
    atspi.bridge_set_actions(&br, 0, on_action, on_focus)
    atspi.bridge_set_app(&br, a)
    if addr.n == 0 || !atspi.bridge_open_address(&br, addr) {
        say("atspi: no bus (set FUI_ATSPI_ADDR)\n")
        return 8
    }
    say("ATSPI READY ")
    say_num(atspi.bridge_node_total(&br) as i64)
    say(" objects\n")
    var waited: i64 = 0
    while !QUIT && waited < 25000 {
        let n: i32 = atspi.bridge_serve(&br, 100)
        let ev: usize = atspi.bridge_poll(&br)
        if n < 0 {
            say("atspi: bus closed\n")
            return 7
        }
        if n == 0 {
            waited = waited + 100
        }
        frame(a, s)
    }
    say("ATSPI DONE calls=")
    say_num(atspi.bridge_calls(&br) as i64)
    say(" actions=")
    say_num(SERVED_ACTIONS as i64)
    say(" events=")
    say_num(atspi.bridge_events(&br) as i64)
    say("\n")
    atspi.bridge_free(&br)
    return 0
}
