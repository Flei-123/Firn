import std.io
import std.rt
import fui.textbuf
import fui.editor
import fui.textarea
import fui.undolog

static mut BAD: usize = 0
static mut MEASURED: usize = 0
static mut SEED: u64 = 12345

fn expect(ok: bool, what: str) {
    if !ok {
        BAD = BAD + 1
        io.print_line(what)
    }
}

fn mono(ctx: u64, p: u64, n: usize) -> f64 {
    MEASURED = MEASURED + n
    return (n as f64) * 10.0
}

fn hx(ctx: u64, p: u64, n: usize, i: usize) -> f64 {
    let w: f64 = ((n / 2) as f64) * 20.0
    return w - ((i / 2) as f64) * 20.0
}

fn hhit(ctx: u64, p: u64, n: usize, x: f64) -> usize {
    let w: f64 = ((n / 2) as f64) * 20.0
    var k: i64 = ((w - x + 10.0) / 20.0) as i64
    if k < 0 as i64 { k = 0 as i64 }
    if k > (n / 2) as i64 { k = (n / 2) as i64 }
    return (k as usize) * 2
}

fn hrtl(ctx: u64, p: u64, n: usize) -> bool {
    return n > 0 && *(p as *mut u8) == 0xD7 as u8
}

fn rnd(m: usize) -> usize {
    SEED = (SEED * 1103515245 + 12345) % 2147483648
    return ((SEED >> 8) as usize) % m
}

fn put(ed: *mut editor.Editor, s: str, caret: usize) {
    let t: *mut textbuf.TextBuf = editor.editor_buf(ed)
    textbuf.tb_set_text(t, s.p as u64, s.n)
    textbuf.tb_set_range(t, caret, caret)
}

fn caret(ed: *mut editor.Editor) -> usize {
    return textbuf.tb_caret(editor.editor_buf(ed))
}

fn make(ed: *mut editor.Editor, l: *mut textarea.Lines, raw: u64, cap: usize) {
    editor.editor_init_cap(ed, raw, cap, 65536)
    editor.editor_set_multiline(ed, true)
    textarea.ta_init(l, 0)
    textarea.ta_set_measure(l, mono, 0)
    textarea.ta_set_view(l, 200.0, 160.0, 16.0)
}

fn same_layout(a: *mut textarea.Lines, b: *mut textarea.Lines) -> bool {
    if textarea.ta_line_count(a) != textarea.ta_line_count(b) { return false }
    var i: usize = 0
    while i < textarea.ta_line_count(a) {
        if textarea.ta_line_start(a, i) != textarea.ta_line_start(b, i) { return false }
        if textarea.ta_line_end(a, i) != textarea.ta_line_end(b, i) { return false }
        i = i + 1
    }
    return true
}

fn fill_doc(ed: *mut editor.Editor, rows: usize) {
    let t: *mut textbuf.TextBuf = editor.editor_buf(ed)
    textbuf.tb_clear(t)
    var r: usize = 0
    while r < rows {
        var k: usize = 0
        while k < 40 + (r % 30) {
            textbuf.tb_insert_cp(t, (97 + (k * 7 + r) % 26) as u32)
            if k % 6 == 5 { textbuf.tb_insert_cp(t, 32 as u32) }
            k = k + 1
        }
        textbuf.tb_insert_cp(t, 10 as u32)
        r = r + 1
    }
}

fn check_undo() {
    var raw: [u8; 600000] = [0; 600000]
    var ed: editor.Editor = editor.editor_new()
    var l: textarea.Lines = textarea.ta_new()
    make(&ed, &l, (&raw[0]) as u64, 600000)
    fill_doc(&ed, 3000)
    let t: *mut textbuf.TextBuf = editor.editor_buf(&ed)
    let n0: usize = textbuf.tb_len(t)
    expect(n0 > 100000, "doc is over 100 KB")
    let ul: *mut undolog.UndoLog = (textbuf.tb_journal(t)) as *mut undolog.UndoLog
    textbuf.tb_set_range(t, n0 / 2, n0 / 2)
    let used0: usize = undolog.ul_bytes_used(ul)
    var i: usize = 0
    while i < 500 {
        textarea.ta_char(&l, &ed, 120 as u32, 0 as u32)
        i = i + 1
    }
    expect(textbuf.tb_len(t) == n0 + 500, "500 chars typed")
    expect(undolog.ul_bytes_used(ul) - used0 < 1000, "undo log holds changes, not texts")
    textarea.ta_char(&l, &ed, 26 as u32, editor.MOD_CTRL)
    expect(textbuf.tb_len(t) == n0, "one Ctrl+Z undoes the typed word group")
    expect(caret(&ed) == n0 / 2, "caret returns to where the group began")
    textarea.ta_char(&l, &ed, 25 as u32, editor.MOD_CTRL)
    expect(textbuf.tb_len(t) == n0 + 500, "Ctrl+Y redoes it")
    textarea.ta_key(&l, &ed, editor.KEY_ENTER, 0 as u32)
    textarea.ta_key(&l, &ed, editor.KEY_BACKSPACE, 0 as u32)
    textarea.ta_char(&l, &ed, 26 as u32, editor.MOD_CTRL)
    expect(textbuf.tb_len(t) == n0 + 501, "undo of Backspace brings the LF back")
    textarea.ta_char(&l, &ed, 26 as u32, editor.MOD_CTRL)
    expect(textbuf.tb_len(t) == n0 + 500, "undo of Enter")
    textbuf.tb_select_all(t)
    textarea.ta_key(&l, &ed, editor.KEY_DELETE, 0 as u32)
    expect(textbuf.tb_len(t) == 0, "select all + Delete")
    textarea.ta_char(&l, &ed, 26 as u32, editor.MOD_CTRL)
    expect(textbuf.tb_len(t) == n0 + 500, "undo of a delete over 100 KB")
    textarea.ta_free(&l)
    editor.editor_free(&ed)
}

fn edit_random(ed: *mut editor.Editor, l: *mut textarea.Lines) {
    let t: *mut textbuf.TextBuf = editor.editor_buf(ed)
    let len: usize = textbuf.tb_len(t)
    let at: usize = rnd(len + 1)
    let kind: usize = rnd(5)
    textbuf.tb_set_range(t, at, at)
    if kind == 0 { textarea.ta_char(l, ed, 10 as u32, 0 as u32) }
    if kind == 1 { textarea.ta_char(l, ed, 113 as u32, 0 as u32) }
    if kind == 2 { textarea.ta_key(l, ed, editor.KEY_BACKSPACE, 0 as u32) }
    if kind == 3 {
        var cut: usize = at + rnd(300)
        if cut > len { cut = len }
        textbuf.tb_set_range(t, cut, at)
        textarea.ta_key(l, ed, editor.KEY_DELETE, 0 as u32)
    }
    if kind == 4 {
        textarea.ta_char(l, ed, 32 as u32, 0 as u32)
        textarea.ta_char(l, ed, 10 as u32, 0 as u32)
    }
}

fn check_layout() {
    var raw: [u8; 600000] = [0; 600000]
    var ed: editor.Editor = editor.editor_new()
    var l: textarea.Lines = textarea.ta_new()
    make(&ed, &l, (&raw[0]) as u64, 600000)
    var fresh: textarea.Lines = textarea.ta_new()
    textarea.ta_init(&fresh, 0)
    textarea.ta_set_measure(&fresh, mono, 0)
    textarea.ta_set_view(&fresh, 200.0, 160.0, 16.0)
    fill_doc(&ed, 3000)
    textarea.ta_relayout(&l, &ed)
    expect(textarea.ta_line_count(&l) > 4000, "over 2048 lines are kept (no cut)")
    let t: *mut textbuf.TextBuf = editor.editor_buf(&ed)
    textbuf.tb_set_range(t, textbuf.tb_len(t) / 2, textbuf.tb_len(t) / 2)
    MEASURED = 0
    textarea.ta_char(&l, &ed, 120 as u32, 0 as u32)
    textarea.ta_relayout(&l, &ed)
    textarea.ta_relayout(&l, &ed)
    expect(MEASURED < 4000, "one keystroke in a 130 KB doc measures a few lines only")
    MEASURED = 0
    textarea.ta_relayout(&l, &ed)
    expect(MEASURED == 0, "unchanged text: layout is cached")
    var i: usize = 0
    var ok: bool = true
    while i < 300 {
        edit_random(&ed, &l)
        if i % 7 == 0 {
            textarea.ta_relayout(&l, &ed)
            textarea.ta_relayout(&fresh, &ed)
            textarea.ta_free(&fresh)
            textarea.ta_init(&fresh, 0)
            textarea.ta_set_measure(&fresh, mono, 0)
            textarea.ta_set_view(&fresh, 200.0, 160.0, 16.0)
            textarea.ta_relayout(&fresh, &ed)
            if !same_layout(&l, &fresh) { ok = false }
        }
        i = i + 1
    }
    expect(ok, "300 random edits: incremental layout equals a full layout")
    textarea.ta_set_view(&l, 120.0, 160.0, 16.0)
    textarea.ta_relayout(&l, &ed)
    textarea.ta_set_view(&fresh, 120.0, 160.0, 16.0)
    textarea.ta_relayout(&fresh, &ed)
    expect(same_layout(&l, &fresh), "width change relayouts completely")
    textarea.ta_free(&l)
    textarea.ta_free(&fresh)
    editor.editor_free(&ed)
}

fn check_bidi_and_shift() {
    var raw: [u8; 256] = [0; 256]
    var ed: editor.Editor = editor.editor_new()
    var l: textarea.Lines = textarea.ta_new()
    make(&ed, &l, (&raw[0]) as u64, 256)
    textarea.ta_set_visual(&l, 0, hx, hhit, hrtl)
    put(&ed, "abc\n\u{5D0}\u{5D1}\u{5D2}", 0)
    textarea.ta_relayout(&l, &ed)
    textarea.ta_mouse_down(&l, &ed, 59.0, 20.0, 1000000 as u64, false)
    expect(caret(&ed) == 4, "RTL line: a click at the right edge puts the caret at the line start")
    textarea.ta_mouse_down(&l, &ed, 1.0, 20.0, 9000000 as u64, false)
    expect(caret(&ed) == 10, "RTL line: a click at the left edge puts the caret at the line end")
    put(&ed, "\u{5D0}\u{5D1}\u{5D2}", 0)
    textarea.ta_relayout(&l, &ed)
    textarea.ta_key(&l, &ed, editor.KEY_LEFT, 0 as u32)
    expect(caret(&ed) == 2, "RTL line: Left moves forward in the text")
    textarea.ta_key(&l, &ed, editor.KEY_RIGHT, 0 as u32)
    expect(caret(&ed) == 0, "RTL line: Right moves back")
    put(&ed, "abcdef", 1)
    textarea.ta_relayout(&l, &ed)
    textarea.ta_key(&l, &ed, editor.KEY_RIGHT, 0 as u32)
    expect(caret(&ed) == 2, "LTR line: Right moves forward")
    textarea.ta_mouse_down(&l, &ed, 40.0, 3.0, 20000000 as u64, false)
    expect(caret(&ed) == 4 && !textbuf.tb_has_sel(editor.editor_buf(&ed)), "plain click")
    textarea.ta_mouse_down(&l, &ed, 10.0, 3.0, 30000000 as u64, true)
    expect(textbuf.tb_sel_a(editor.editor_buf(&ed)) == 1 && textbuf.tb_sel_b(editor.editor_buf(&ed)) == 4, "Shift+click extends from the caret")
    textarea.ta_mouse_down(&l, &ed, 50.0, 3.0, 30100000 as u64, true)
    expect(textbuf.tb_sel_a(editor.editor_buf(&ed)) == 4 && textbuf.tb_sel_b(editor.editor_buf(&ed)) == 5, "Shift+click keeps the anchor, no word selection on a quick second click")
    textarea.ta_free(&l)
    editor.editor_free(&ed)
}

fn main(start: u64) -> i32 {
    check_undo()
    check_layout()
    check_bidi_and_shift()
    if BAD == 0 {
        io.print_line("TEXTAREA EDIT PASSED")
        return 0
    }
    io.print_line("TEXTAREA EDIT FAILED")
    return 1
}
