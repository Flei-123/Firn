// SPDX-License-Identifier: MPL-2.0
// tools/fui/mdvscroll_main.fi -- a66: frame times of the chat markdown view with a LONG history (the phone's fling jank: p99 240 ms).
//
// A chat-like document (user bubbles, answers with headings / lists / code / tables, tool step links, meta lines) of N message pairs is
// parsed, laid out and painted into a canvas at phone size. Measured (ms): parse, cold layout+paint, a scroll-only frame (median / p95 /
// max over a sweep of the whole document), mdv_tick, and the frame in which older text is put in front (set_markdown_keep + layout).
//
//   mdvscroll_main [pairs] [scale_permille] [mode]      prints the numbers; MDVSCROLL PASSED when the budgets below hold
//
// Budgets: see the end of main (layout alone, relayout, scroll p95, tick, page frame, append frame).
import std.rt
import std.vec
import paint.canvas
import font.metrics
import fui.theme
import fui.style
import fui.painter
import fui.render
import fui.viewport
import fui.markdownview
import markdown.doc
import plat.sysfont

fn now_ms() -> f64 {
    var ts: [u64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as u64)
    return (ts[0] as f64) * 1000.0 + (ts[1] as f64) / 1000000.0
}

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }

fn say_num(v: f64) {
    var x: f64 = v
    if x < 0.0 {
        say("-")
        x = 0.0 - x
    }
    let whole: u64 = x as u64
    let tenth: u64 = ((x - (whole as f64)) * 10.0 + 0.5) as u64
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, (whole + tenth / 10) as i64)
    rt.buf_push(&b, 46 as u8)
    rt.buf_push_dec_i64(&b, (tenth % 10) as i64)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

fn line(name: str, v: f64) {
    say("  ")
    say(name)
    say(": ")
    say_num(v)
    say(" ms\n")
}

fn put(b: *mut rt.Buf, s: str) { rt.buf_push_bytes(b, s.p as u64, s.n) }

// one message pair; `k` varies the text a little so no two are alike
static mut MODE: usize = 0

fn add_pair(b: *mut rt.Buf, k: usize) {
    if MODE == 1 {
        put(b, "The symbol is declared in the render file but the new split file does not export it, so the linker finds nothing. This is the same thing that happened with the font set two weeks ago. A longer sentence follows so that the paragraph wraps over several lines on a narrow phone screen and the word placement has real work to do.\n\n")
        return
    }
    if MODE == 2 {
        put(b, "```rust\nfn main() {\n    let x: i64 = 42;\n    println!(\"value {}\", x);\n    for i in 0..10 { if i % 2 == 0 { continue; } }\n}\n```\n\n")
        return
    }
    if MODE == 7 {
        put(b, "```\nfn main() {\n    let x: i64 = 42;\n    println!(\"value {}\", x);\n    for i in 0..10 { if i % 2 == 0 { continue; } }\n}\n```\n\n")
        return
    }
    if MODE == 3 {
        put(b, "- first point with some more words in it to wrap around the edge of the view\n- second point with `inline code` and a [link](https://example.com)\n- third point\n\n")
        return
    }
    if MODE == 4 {
        put(b, "| name | value | note |\n|---|---|---|\n| alpha | 1 | first |\n| beta | 2 | second |\n\n")
        return
    }
    if MODE == 5 {
        put(b, "> > Can you look at the build log and tell me why the linker complains about the missing symbol in the render module? It happened again.\n\n")
        return
    }
    if MODE == 6 {
        put(b, "[Shell: grep -n undefined build.log](step:1)\n\n[Read: lib/fui/render.fi](step:2)\n\n###### 4.2 s \u{b7} 12:30\n\n")
        return
    }
    put(b, "> > Can you look at the build log of run ")
    rt.buf_push_dec_i64(b, k as i64)
    put(b, " and tell me why the linker complains about the missing symbol in the render module? It happened again after the last merge.\n\n")
    put(b, "[Shell: grep -n undefined build.log](step:")
    rt.buf_push_dec_i64(b, k as i64)
    put(b, ")\n\n[Read: lib/fui/render.fi](step:")
    rt.buf_push_dec_i64(b, k as i64 + 1)
    put(b, ")\n\n")
    put(b, "## Cause\n\nThe symbol `ctx_painter` is declared in **render.fi** but the *new* split file does not export it, so the linker finds nothing. ")
    put(b, "This is the same thing that happened with the font set two weeks ago, see [the report](https://example.com/r/")
    rt.buf_push_dec_i64(b, k as i64)
    put(b, "). A longer sentence follows so that the paragraph wraps over several lines on a narrow phone screen and the word placement has real work to do.\n\n")
    put(b, "- first point with some more words in it to wrap around the edge of the view\n- second point with `inline code` and a [link](https://example.com)\n- third point\n\n")
    put(b, "```rust\nfn main() {\n    let x: i64 = ")
    rt.buf_push_dec_i64(b, k as i64 * 7 + 1)
    put(b, ";\n    println!(\"value {}\", x);\n    for i in 0..10 { if i % 2 == 0 { continue; } }\n}\n```\n\n")
    put(b, "| name | value | note |\n|---|---|---|\n| alpha | 1 | first |\n| beta | 2 | second |\n\n")
    put(b, "Done. Rebuild with the flag and it links again.\n\n###### 4.2 s \u{b7} 12:")
    rt.buf_push_dec_i64(b, (10 + k % 50) as i64)
    put(b, "\n\n")
}

fn build(b: *mut rt.Buf, from: usize, to: usize) {
    rt.buf_clear(b)
    var k: usize = from
    while k < to {
        add_pair(b, k)
        k = k + 1
    }
}

static mut FR: [f64; 4096] = [0.0; 4096]

fn sort_f(n: usize) {
    var i: usize = 1
    while i < n {
        let x: f64 = FR[i]
        var j: usize = i
        while j > 0 && FR[j - 1] > x {
            FR[j] = FR[j - 1]
            j = j - 1
        }
        FR[j] = x
        i = i + 1
    }
}

fn parse_num(p: u64) -> usize {
    var n: usize = 0
    var i: usize = 0
    while rt.ld8(p, i) >= 48 as u8 && rt.ld8(p, i) <= 57 as u8 {
        n = n * 10 + (rt.ld8(p, i) - 48 as u8) as usize
        i = i + 1
    }
    return n
}

fn main(start: u64) -> i32 {
    var pairs: usize = 60
    var scale: usize = 1375
    if rt.arg_count(start) >= 2 { pairs = parse_num(rt.arg_ptr(start, 1)) }
    if rt.arg_count(start) >= 3 { scale = parse_num(rt.arg_ptr(start, 2)) }
    if rt.arg_count(start) >= 4 { MODE = parse_num(rt.arg_ptr(start, 3)) }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("mdvscroll: no font\n")
        return 9
    }
    let W: usize = 540
    let H: usize = 960
    var cv: canvas.Canvas = canvas.canvas_new()
    var z: painter.Painter = painter.painter_new()
    if !canvas.canvas_init(&cv, W, H) || !painter.painter_init(&z, &cv, W, H) {
        say("mdvscroll: canvas\n")
        return 9
    }
    painter.painter_set_font(&z, fs as u64)
    var m: theme.Theme = theme.theme_new(true)
    theme.theme_set_scale(&m, scale)
    markdownview.mdv_set_bubble(0x2a3b8f, 18)
    markdownview.mdv_set_bubble_end(0x4a2f9f)
    markdownview.mdv_set_meta_h6(true)
    markdownview.mdv_set_web_style(true)
    markdownview.mdv_set_code_bg(0x0b0d1c)
    var c: render.Ctx = render.ctx_new(&m, &z)
    var v: markdownview.MdView = markdownview.mdv_new()
    markdownview.mdv_set_base_size(&v, 14)
    markdownview.mdv_set_bar_pt(&v, 0)
    markdownview.mdv_set_web_padx(3.2)
    markdownview.mdv_set_background(&v, 4294967295)
    markdownview.mdv_set_overscroll(&v, true)
    markdownview.mdv_set_rect(&v, 0.0, 0.0, W as f64, H as f64)

    var src: rt.Buf = rt.buf_new()
    build(&src, 20, 20 + pairs)
    say("mdvscroll: pairs ")
    rt.write_everything(1, "".p as u64, 0)
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&nb, pairs as i64)
    put(&nb, ", source bytes ")
    rt.buf_push_dec_i64(&nb, rt.buf_len(&src) as i64)
    put(&nb, ", scale ")
    rt.buf_push_dec_i64(&nb, scale as i64)
    put(&nb, "\n")
    rt.write_everything(1, rt.buf_ptr(&nb), rt.buf_len(&nb))

    var t0: f64 = now_ms()
    markdownview.mdv_set_markdown(&v, str { p: rt.buf_ptr(&src) as *mut u8, n: rt.buf_len(&src) }, doc.opts_default())
    line("parse", now_ms() - t0)
    t0 = now_ms()
    markdownview.mdv_paint(&v, &c)
    line("cold layout+paint", now_ms() - t0)
    let items: usize = markdownview.mdv_item_count(&v)
    var nn: rt.Buf = rt.buf_new()
    put(&nn, "  items ")
    rt.buf_push_dec_i64(&nn, items as i64)
    put(&nn, ", content height ")
    rt.buf_push_dec_i64(&nn, markdownview.mdv_content_height(&v) as i64)
    put(&nn, "\n")
    rt.write_everything(1, rt.buf_ptr(&nn), rt.buf_len(&nn))

    // the host paints again while code blocks wait for their colours (3 per layout): finish them
    var settle: usize = 0
    t0 = now_ms()
    while settle < 60 {
        markdownview.mdv_paint(&v, &c)
        settle = settle + 1
    }
    line("settle (60 paints, colours finished)", now_ms() - t0)

    // relayout only (dirty, same text): what an invalidate costs
    markdownview.mdv_invalidate(&v)
    t0 = now_ms()
    markdownview.mdv_paint(&v, &c)
    let relayout: f64 = now_ms() - t0
    line("relayout+paint (invalidate)", relayout)

    // the layout alone (no paint)
    t0 = now_ms()
    markdownview.mdv_layout(&v, &c, W as f64)
    let lay: f64 = now_ms() - t0
    line("layout only", lay)
    line("hl hits", markdownview.mdv_hl_stat(0) as f64)
    line("hl misses", markdownview.mdv_hl_stat(1) as f64)
    line("wc hits", markdownview.mdv_cache_stat(0) as f64)
    line("wc misses", markdownview.mdv_cache_stat(1) as f64)
    markdownview.mdv_invalidate(&v)
    markdownview.mdv_paint(&v, &c)

    // scroll sweep: a frame per 90 px over the whole document
    let total: f64 = markdownview.mdv_content_height(&v)
    let cap: usize = 4096
    var nf: usize = 0
    var off: f64 = 0.0
    while off < total && nf < cap {
        markdownview.mdv_set_offset(&v, off)
        t0 = now_ms()
        markdownview.mdv_paint(&v, &c)
        FR[nf] = now_ms() - t0
        nf = nf + 1
        off = off + 90.0
    }
    sort_f(nf)
    say("  scroll-only frames: ")
    var q: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&q, nf as i64)
    rt.write_everything(1, rt.buf_ptr(&q), rt.buf_len(&q))
    say("\n")
    line("scroll p50", FR[nf / 2])
    line("scroll p95", FR[nf * 95 / 100])
    line("scroll max", FR[nf - 1])
    let scroll_p95: f64 = FR[nf * 95 / 100]

    // the clock tick the host runs every frame while moving
    t0 = now_ms()
    var tk: usize = 0
    while tk < 100 {
        let ch: bool = markdownview.mdv_tick(&v, 1000 + tk as i64 * 8)
        tk = tk + 1
    }
    let tick: f64 = (now_ms() - t0) / 100.0
    line("mdv_tick (avg of 100)", tick)

    // older text put in front: the page frame
    var src2: rt.Buf = rt.buf_new()
    build(&src2, 0, 20 + pairs)
    markdownview.mdv_set_offset(&v, 2000.0)
    markdownview.mdv_anchor_begin(&v)
    t0 = now_ms()
    markdownview.mdv_set_markdown_keep(&v, str { p: rt.buf_ptr(&src2) as *mut u8, n: rt.buf_len(&src2) }, doc.opts_default())
    let t1: f64 = now_ms()
    markdownview.mdv_paint(&v, &c)
    let page: f64 = now_ms() - t0
    line("page: parse", t1 - t0)
    line("page frame total (parse+layout+paint)", page)

    // a new chat event at the end (streamed token): one frame
    markdownview.mdv_set_offset(&v, markdownview.mdv_content_height(&v))
    markdownview.mdv_paint(&v, &c)
    var src3: rt.Buf = rt.buf_new()
    build(&src3, 0, 21 + pairs)
    t0 = now_ms()
    markdownview.mdv_set_markdown_keep(&v, str { p: rt.buf_ptr(&src3) as *mut u8, n: rt.buf_len(&src3) }, doc.opts_default())
    markdownview.mdv_paint(&v, &c)
    let append: f64 = now_ms() - t0
    line("append frame total", append)

    // budgets (desktop, release-fast, 60 pairs; before the caches: layout 67 ms, relayout 73, page 118, append 103)
    var bad: usize = 0
    if lay > 15.0 { say("  WRONG layout only > 15 ms\n"); bad = bad + 1 }
    if relayout > 30.0 { say("  WRONG relayout+paint > 30 ms\n"); bad = bad + 1 }
    if scroll_p95 > 25.0 { say("  WRONG scroll p95 > 25 ms\n"); bad = bad + 1 }
    if tick > 1.0 { say("  WRONG tick > 1 ms\n"); bad = bad + 1 }
    if page > 80.0 { say("  WRONG page frame > 80 ms\n"); bad = bad + 1 }
    if append > 40.0 { say("  WRONG append frame > 40 ms\n"); bad = bad + 1 }
    if bad == 0 { say("MDVSCROLL PASSED\n"); return 0 }
    say("MDVSCROLL FAILED\n")
    return 1
}
