// SPDX-License-Identifier: GPL-2.0-only
// tools/fui/kreuz_main.fi -- DAS SCHLIESSKREUZ WIRD NACHGEZAEHLT.
//
// ================================================== WARUM ES DAS GIBT
//
// Dieselbe Zeichnung ist in OrientOS SCHON ZWEIMAL kaputtgegangen:
//
//   1. Ein Vektorrasterer ersetzte das Kreuz. Zwei Strichumrisse in
//      EINEM Pfad, gefuellt nach der Nichtnull-Regel -- an der Kreuzung
//      addieren sich die Umlaufzahlen, es entstand ein fetter
//      Zusatzbalken. Gemessen wurden 4 doppelt gedeckte Bildpunkte bei
//      Skala 1, 12 bei 2, 24 bei 3: es wird mit der Skalierung
//      SCHLIMMER.
//
//   2. Nach dem Rueckbau stand im laufenden System nur noch EINE
//      Diagonale -- ein Schraegstrich statt eines Kreuzes. Ursache war
//      eine feste 10 statt `10 * skala` im Aufrufer.
//
// Beide Male ist es im Quelltext niemandem aufgefallen. Darum zaehlt
// dieses Programm nach, und der Bau faellt, wenn etwas nicht stimmt:
//
//   A JEDE ZEILE hat Bildpunkte auf BEIDEN Seiten der Mitte. Das ist
//     die Pruefung, die einen Schraegstrich von einem Kreuz
//     unterscheidet -- und die genau den Fehler findet, der heute im
//     System steht.
//   B KEIN Bildpunkt liegt ausserhalb des Feldes.
//   C Das Kreuz ist in BEIDEN Achsen spiegelgleich.
//   D Es SKALIERT: bei doppelter Groesse ist es doppelt so gross.
//
// Gerechnet wird auf einem eigenen Puffer, ohne Fenster und ohne
// Schrift -- diese Pruefung braucht kein Bild und keinen Bildschirm.
import std.rt
import fui.kern

const W: usize = 128
const H: usize = 128

static mut G_FEHLER: usize = 0

fn zahl(t: *mut rt.Buf, v: i64) {
    rt.buf_push_dec_i64(t, v)
}

fn sag(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 42 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "FALSCH  "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_FEHLER = G_FEHLER + 1
    }
    rt.buf_push(&t, 40 as u8)
    zahl(&t, a)
    rt.buf_push(&t, 47 as u8)
    zahl(&t, b)
    rt.buf_push(&t, 41 as u8)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// Ein Kreuz der Groesse `d` mit Strichbreite `sb` in ein frisches Feld
// malen und die vier Eigenschaften pruefen.
fn pruefe_kreuz(p: u64, d: usize, sb: usize) {
    var z: kern.Ziel = kern.ziel_neu(p, W, H, W * 4)
    kern.fuellen(&z, 0 as u32)
    // Das Feld liegt bei (10, 10), damit "ausserhalb" in jede Richtung
    // messbar ist.
    let ox: usize = 10
    let oy: usize = 10
    kern.kn_schliessen(&z, ox, oy, d, sb, 16777215 as u32)

    // ---- B: nichts ausserhalb des Feldes
    var draussen: usize = 0
    var y: usize = 0
    while y < H {
        var x: usize = 0
        while x < W {
            if kern.hole(&z, x, y) != 0 as u32 {
                if x < ox || y < oy || x >= ox + d || y >= oy + d {
                    draussen = draussen + 1
                }
            }
            x = x + 1
        }
        y = y + 1
    }
    var nb: [u8; 30] = "  nichts ausserhalb des Feldes"
    sag((&nb[0]) as u64, 30, draussen == 0, draussen as i64, 0)

    // ---- A: JEDE belegte Zeile hat Punkte LINKS UND RECHTS der Mitte.
    //
    // Das ist die Pruefung, die den heutigen Fehler findet. Ein
    // Schraegstrich hat in jeder Zeile GENAU EINEN Bereich; ein Kreuz
    // hat in fast jeder Zeile zwei -- einen links und einen rechts der
    // Mittelachse. Nur in den ein bis zwei Zeilen der Kreuzung selbst
    // fallen sie zusammen.
    let mitte: usize = ox + d / 2
    var zeilen: usize = 0
    var beidseitig: usize = 0
    var kreuzung: usize = 0
    var yy: usize = oy
    while yy < oy + d {
        var links: usize = 0
        var rechts: usize = 0
        var xx: usize = ox
        while xx < ox + d {
            if kern.hole(&z, xx, yy) != 0 as u32 {
                if xx < mitte {
                    links = links + 1
                } else {
                    rechts = rechts + 1
                }
            }
            xx = xx + 1
        }
        if links + rechts > 0 {
            zeilen = zeilen + 1
            if links > 0 && rechts > 0 {
                beidseitig = beidseitig + 1
            } else {
                // In der Naehe der Mitte duerfen beide Aeste in
                // derselben Haelfte liegen.
                var dm: usize = 0
                if yy > oy + d / 2 {
                    dm = yy - (oy + d / 2)
                } else {
                    dm = (oy + d / 2) - yy
                }
                if dm <= sb {
                    kreuzung = kreuzung + 1
                }
            }
        }
        yy = yy + 1
    }
    var na: [u8; 33] = "  jede Zeile beidseits der Mitte "
    sag((&na[0]) as u64, 33, beidseitig + kreuzung == zeilen,
        beidseitig as i64, zeilen as i64)

    // ---- C: SPIEGELGLEICH IM BELEGTEN BEREICH.
    //
    // NICHT im ganzen Feld -- und das ist keine Nachsicht, sondern
    // Geometrie, die die Vorlage selbst nennt: die belegte Hoehe ist
    // `kn = d - (sb - 1)`, der Rest im Feld also `sb - 1`. Bei GERADER
    // Strichbreite ist dieser Rest ungerade und laesst sich nicht auf
    // zwei Seiten gleich verteilen. Die Vorlage misst dasselbe:
    // "d = 20: sb=1 -> 20x20, sb=2 -> 20x19, sb=3 -> 20x18. Dass ein 2
    // breites Kreuz nur 19 von 20 Zeilen belegt, ist Geometrie."
    //
    // Verlangt wird darum das, was WIRKLICH gelten muss: innerhalb
    // seiner eigenen Ausdehnung ist das Kreuz in beiden Achsen
    // spiegelgleich, und der Rand oben/unten bzw. links/rechts
    // unterscheidet sich um hoechstens einen Bildpunkt.
    var by0: usize = d
    var by1: usize = 0
    var bx0: usize = d
    var bx1: usize = 0
    var y2: usize = 0
    while y2 < d {
        var x2: usize = 0
        while x2 < d {
            if kern.hole(&z, ox + x2, oy + y2) != 0 as u32 {
                if y2 < by0 { by0 = y2 }
                if y2 > by1 { by1 = y2 }
                if x2 < bx0 { bx0 = x2 }
                if x2 > bx1 { bx1 = x2 }
            }
            x2 = x2 + 1
        }
        y2 = y2 + 1
    }
    var ungleich_x: usize = 0
    var ungleich_y: usize = 0
    var y3: usize = by0
    while y3 <= by1 {
        var x3: usize = bx0
        while x3 <= bx1 {
            let a: u32 = kern.hole(&z, ox + x3, oy + y3)
            let sx: u32 = kern.hole(&z, ox + bx0 + bx1 - x3, oy + y3)
            let sy: u32 = kern.hole(&z, ox + x3, oy + by0 + by1 - y3)
            if a != sx {
                ungleich_x = ungleich_x + 1
            }
            if a != sy {
                ungleich_y = ungleich_y + 1
            }
            x3 = x3 + 1
        }
        y3 = y3 + 1
    }
    var nc: [u8; 28] = "  spiegelgleich (waagrecht) "
    sag((&nc[0]) as u64, 28, ungleich_x == 0, ungleich_x as i64, 0)
    var nd: [u8; 28] = "  spiegelgleich (senkrecht) "
    sag((&nd[0]) as u64, 28, ungleich_y == 0, ungleich_y as i64, 0)
    // Der Rand: hoechstens ein Bildpunkt Unterschied.
    let r_oben: usize = by0
    let r_unten: usize = d - 1 - by1
    var diff: usize = 0
    if r_oben > r_unten {
        diff = r_oben - r_unten
    } else {
        diff = r_unten - r_oben
    }
    var ne: [u8; 30] = "  mittig im Feld (Rand +-1)   "
    sag((&ne[0]) as u64, 30, diff <= 1, r_oben as i64, r_unten as i64)
}

// Wieviele Bildpunkte belegt das Kreuz? Fuer die Skalierungspruefung.
fn zaehle(p: u64, d: usize, sb: usize) -> usize {
    var z: kern.Ziel = kern.ziel_neu(p, W, H, W * 4)
    kern.fuellen(&z, 0 as u32)
    kern.kn_schliessen(&z, 10, 10, d, sb, 16777215 as u32)
    var n: usize = 0
    var y: usize = 0
    while y < H {
        var x: usize = 0
        while x < W {
            if kern.hole(&z, x, y) != 0 as u32 {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn main(start: u64) -> i32 {
    let p: u64 = rt.heap_alloc(W * H * 4)
    if p == 0 as u64 {
        return 2
    }

    var k1: [u8; 26] = "KREUZ d=10 sb=1 (Skala 1)\n"
    rt.write_everything(1, (&k1[0]) as u64, 26)
    pruefe_kreuz(p, 10, 1)

    var k2: [u8; 26] = "KREUZ d=20 sb=2 (Skala 2)\n"
    rt.write_everything(1, (&k2[0]) as u64, 26)
    pruefe_kreuz(p, 20, 2)

    var k3: [u8; 26] = "KREUZ d=30 sb=3 (Skala 3)\n"
    rt.write_everything(1, (&k3[0]) as u64, 26)
    pruefe_kreuz(p, 30, 3)

    // ---- D: ES SKALIERT WIRKLICH.
    //
    // Genau der Fehler auf Justins Foto: der Knopf wurde groesser, das
    // Zeichen nicht. Ein Kreuz bei d=20 muss deutlich mehr Bildpunkte
    // belegen als eines bei d=10 -- steht dort dieselbe Zahl, ist die
    // Skalierung verloren gegangen.
    let n1: usize = zaehle(p, 10, 1)
    let n2: usize = zaehle(p, 20, 2)
    let n3: usize = zaehle(p, 30, 3)
    var ns: [u8; 34] = "  waechst mit der Skalierung      "
    sag((&ns[0]) as u64, 34, n2 > n1 && n3 > n2, n1 as i64, n2 as i64)

    var t: rt.Buf = rt.buf_new()
    var z1: [u8; 22] = "\nBildpunkte 10/20/30: "
    rt.buf_push_bytes(&t, (&z1[0]) as u64, 22)
    rt.buf_push_dec_i64(&t, n1 as i64)
    rt.buf_push(&t, 47 as u8)
    rt.buf_push_dec_i64(&t, n2 as i64)
    rt.buf_push(&t, 47 as u8)
    rt.buf_push_dec_i64(&t, n3 as i64)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)

    if G_FEHLER > 0 {
        var f: [u8; 26] = "KREUZ NICHT IN ORDNUNG.\n\0\0"
        rt.write_everything(1, (&f[0]) as u64, 24)
        return 1
    }
    var o: [u8; 20] = "KREUZ BESTANDEN.\n\0\0\0"
    rt.write_everything(1, (&o[0]) as u64, 17)
    return 0
}
