import std.rt
import fui.kitview
import fui.kpdocs

fn main(start: u64) -> i32 {
    var v: kitview.View = kitview.view_new()
    kitview.view_set_doc_installer(&v, kpdocs.install_pdf_docx)
    let n: usize = 4096
    let d: u64 = rt.heap_alloc(n)
    let mode: u32 = kitview.view_open(&v, d, n, "a.pdf")
    kitview.view_press(&v, 1.0, 1.0)
    kitview.view_tick(&v)
    kitview.view_free(&v)
    return mode as i32
}
