static mut BAD: usize = 0
static mut TOTAL: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    TOTAL = TOTAL + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn num(tag: str, v: i64) {
    say(tag)
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
}

fn near_rgb(a: u32, b: u32, tol: i64) -> bool {
    var s: u32 = 0
    while s <= 16 {
        let x: i64 = ((a >> s) & 255 as u32) as i64
        let y: i64 = ((b >> s) & 255 as u32) as i64
        var d: i64 = x - y
        if d < 0 { d = 0 - d }
        if d > tol { return false }
        s = s + 8
    }
    return true
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    fuiwirt.host_bind(app.app_host(a))
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

fn settle2(a: *mut app.App, s: *mut Surface) {
    lay.scroll_sync(a)
    frame(a, s)
    lay.scroll_sync(a)
    frame(a, s)
    lay.scroll_sync(a)
    frame(a, s)
}

fn nh(a: *mut app.App, n: usize) -> i64 { return scene.node_h(app.app_scene(a), n) as i64 }
fn ny(a: *mut app.App, n: usize) -> i64 { return scene.node_y(app.app_scene(a), n) as i64 }

fn ta_mono(ctx: u64, p: u64, n: usize) -> f64 {
    return (n as f64) * 8.0
}

fn ta_run(l: *mut textarea.Lines, t0: i64, ms: i64) -> bool {
    var t: i64 = t0
    var n: i64 = 0
    while n < ms {
        n = n + 16
        t = t + 16
        textarea.ta_kin_tick(l, t)
    }
    return textarea.ta_moving(l)
}

fn ta_drag(l: *mut textarea.Lines, dy: f64, steps: usize, t0: i64) -> i64 {
    var t: i64 = t0
    var i: usize = 0
    while i < steps {
        t = t + 16
        textarea.ta_touch_move(l, dy, t, t * 1000)
        i = i + 1
    }
    return t
}

fn text_area_checks() {
    say("-- text area kinetics\n")
    var raw: [u8; 8192] = [0; 8192]
    var ed: editor.Editor = editor.editor_new()
    if !editor.editor_init_cap(&ed, (&raw[0]) as u64, 8192, 4096) {
        check(false, "text area editor init")
        return
    }
    editor.editor_set_multiline(&ed, true)
    var l: textarea.Lines = textarea.ta_new()
    if !textarea.ta_init(&l, 0) {
        check(false, "text area init")
        return
    }
    textarea.ta_set_measure(&l, ta_mono, 0)
    textarea.ta_set_view(&l, 200.0, 48.0, 16.0)
    let t: *mut textbuf.TextBuf = editor.editor_buf(&ed)
    var k: usize = 0
    var line: [u8; 4] = [76, 10, 76, 10]
    textbuf.tb_set_text(t, (&line[0]) as u64, 0)
    var all: [u8; 400] = [0; 400]
    k = 0
    while k < 200 {
        all[k] = if k % 2 == 0 { 76 as u8 } else { 10 as u8 }
        k = k + 1
    }
    textbuf.tb_set_text(t, (&all[0]) as u64, 200)
    textarea.ta_relayout(&l, &ed)
    let mx: f64 = textarea.ta_content_h(&l) - 48.0
    check(textarea.ta_line_count(&l) >= 100 && mx > 1000.0, "the text area has a long text")
    var now: i64 = 100000
    textarea.ta_touch_down(&l, now * 1000)
    now = ta_drag(&l, 0.0 - 12.0, 8, now)
    let held: f64 = textarea.ta_scroll_y(&l)
    check(held > 90.0 && held < 100.0, "the text follows the finger 1:1")
    check(textarea.ta_over(&l) == 0.0, "no band inside the text")
    textarea.ta_touch_up(&l, now, now * 1000 + 8000)
    check(textarea.ta_moving(&l), "a quick lift starts a fling")
    let moving: bool = ta_run(&l, now, 2000)
    check(!moving, "the fling ends")
    let after: f64 = textarea.ta_scroll_y(&l)
    check(after > held + 40.0 && after <= mx, "the fling carried the text on")
    now = now + 3000
    textarea.ta_wheel(&l, 0.0 - 100000.0)
    check(textarea.ta_scroll_y(&l) == 0.0, "wheel clamps to the top")
    textarea.ta_touch_down(&l, now * 1000)
    now = ta_drag(&l, 0.0 - 12.0, 8, now)
    textarea.ta_touch_up(&l, now, now * 1000 + 8000)
    check(textarea.ta_moving(&l), "second fling runs")
    textarea.ta_wheel(&l, 1.0)
    check(!textarea.ta_moving(&l), "the wheel stops a running fling")
    say("-- rested finger, no fling\n")
    textarea.ta_wheel(&l, 0.0 - 100000.0)
    textarea.ta_touch_down(&l, now * 1000)
    now = ta_drag(&l, 0.0 - 12.0, 8, now)
    textarea.ta_touch_up(&l, now + 400, now * 1000 + 400000)
    check(!textarea.ta_moving(&l), "a finger that rested before the lift does not fling")
    say("-- band at the top\n")
    textarea.ta_wheel(&l, 0.0 - 100000.0)
    now = now + 5000
    textarea.ta_touch_down(&l, now * 1000)
    now = ta_drag(&l, 12.0, 8, now)
    check(textarea.ta_scroll_y(&l) == 0.0, "pulling past the top keeps the scroll at 0")
    check(textarea.ta_over(&l) < 0.0 - 10.0, "pulling past the top stretches the band")
    now = now + 300
    textarea.ta_touch_up(&l, now, now * 1000)
    check(textarea.ta_moving(&l), "the band springs back")
    let still: bool = ta_run(&l, now, 3000)
    check(!still && textarea.ta_over(&l) == 0.0 && textarea.ta_scroll_y(&l) == 0.0, "the band is back at rest")
    say("-- band at the bottom\n")
    textarea.ta_wheel(&l, 100000.0)
    check(textarea.ta_scroll_y(&l) == mx, "wheel clamps to the bottom")
    now = now + 5000
    textarea.ta_touch_down(&l, now * 1000)
    now = ta_drag(&l, 0.0 - 12.0, 8, now)
    check(textarea.ta_scroll_y(&l) == mx && textarea.ta_over(&l) > 10.0, "pulling past the bottom stretches the band")
    now = now + 300
    textarea.ta_touch_up(&l, now, now * 1000)
    let still2: bool = ta_run(&l, now, 3000)
    check(!still2 && textarea.ta_over(&l) == 0.0 && textarea.ta_scroll_y(&l) == mx, "the bottom band is back at rest")
    say("-- fling into the end\n")
    textarea.ta_wheel(&l, 0.0 - 300.0)
    now = now + 5000
    textarea.ta_touch_down(&l, now * 1000)
    now = ta_drag(&l, 0.0 - 10.0, 8, now)
    textarea.ta_touch_up(&l, now, now * 1000 + 8000)
    let before: f64 = textarea.ta_scroll_y(&l)
    let still3: bool = ta_run(&l, now, 3000)
    check(!still3 && textarea.ta_scroll_y(&l) <= mx && textarea.ta_scroll_y(&l) > before, "a fling stops at the end of the text")
    textarea.ta_free(&l)
    editor.editor_free(&ed)
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("touchscroll: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let W: usize = 360
    let H: usize = 600
    let a: *mut app.App = app.window("Scroll", W, H)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, W, H)
    if s as u64 == 0 {
        return 9
    }
    lay.page(a)
    let bar: usize = lay.vbox(a)
    lay.min_h(a, bar, 56)
    lay.grow(a, bar, 0)
    app.end(a)
    let inner: usize = lay.scroll_v(a)
    var k: usize = 0
    while k < 30 {
        let row: usize = app.spacer(a, 0, 40)
        k = k + 1
    }
    app.end(a)
    let hin: usize = lay.scroll_h(a, 60)
    var hk: usize = 0
    while hk < 20 {
        let cell: usize = app.spacer(a, 40, 40)
        hk = hk + 1
    }
    app.end(a)
    settle2(a, s)
    let w: *mut fuiwirt.Host = app.app_host(a)
    let touch: u32 = event.PT_TOUCH
    say("-- tap\n")
    fuiwirt.host_tick(w, 1000)
    let d0: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_DOWN, 1 as u32, touch, true, 180.0, 300.0, 1000)
    fuiwirt.host_tick(w, 1010)
    let m0: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_MOVE, 1 as u32, touch, true, 180.0, 292.0, 1010)
    fuiwirt.host_tick(w, 1020)
    let u0: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 1 as u32, touch, true, 180.0, 292.0, 1020)
    check(lay.scroll_offset(0) == 0.0, "a tap that stays inside the slop does not scroll")
    say("-- drag\n")
    fuiwirt.host_tick(w, 2000)
    let d1: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_DOWN, 2 as u32, touch, true, 180.0, 500.0, 2000)
    var t: i64 = 2000
    var y: f64 = 500.0
    var steps: usize = 0
    while steps < 10 {
        t = t + 16
        y = y - 12.0
        fuiwirt.host_tick(w, t)
        let mv: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_MOVE, 2 as u32, touch, true, 180.0, y, t)
        steps = steps + 1
    }
    let held: f64 = lay.scroll_offset(0)
    check(held > 60.0 && held < 130.0, "the content follows the finger (offset between 60 and 130 after 120 px of drag)")
    t = t + 8
    fuiwirt.host_tick(w, t)
    let u1: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 2 as u32, touch, true, 180.0, y, t)
    let at_up: f64 = lay.scroll_offset(0)
    var ms: i64 = 0
    while ms < 600 {
        ms = ms + 16
        fuiwirt.host_tick(w, t + ms)
    }
    let after: f64 = lay.scroll_offset(0)
    check(after > at_up + 20.0, "a flick runs out after the finger lifts")
    num("offset at lift: ", at_up as i64)
    num("offset after run-out: ", after as i64)
    say("-- stop\n")
    ms = ms + 16
    fuiwirt.host_tick(w, t + ms)
    let still: f64 = lay.scroll_offset(0)
    ms = ms + 16
    fuiwirt.host_tick(w, t + ms)
    check(lay.scroll_offset(0) == still, "the run-out has ended")
    say("-- slow drag, no fling\n")
    lay.scroll_to(0, 0.0)
    let base_t: i64 = t + ms + 1000
    fuiwirt.host_tick(w, base_t)
    let d2: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_DOWN, 3 as u32, touch, true, 180.0, 500.0, base_t)
    var t2: i64 = base_t
    var y2: f64 = 500.0
    steps = 0
    while steps < 5 {
        t2 = t2 + 16
        y2 = y2 - 12.0
        fuiwirt.host_tick(w, t2)
        let mv2: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_MOVE, 3 as u32, touch, true, 180.0, y2, t2)
        steps = steps + 1
    }
    t2 = t2 + 400
    fuiwirt.host_tick(w, t2)
    let u2: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 3 as u32, touch, true, 180.0, y2, t2)
    let rest: f64 = lay.scroll_offset(0)
    fuiwirt.host_tick(w, t2 + 300)
    check(lay.scroll_offset(0) == rest, "a finger that rested before the lift does not fling")
    say("-- mouse\n")
    lay.scroll_to(0, 0.0)
    fuiwirt.host_tick(w, t2 + 2000)
    let d3: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_DOWN, 9 as u32, event.PT_MOUSE, true, 180.0, 500.0, t2 + 2000)
    let m3: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_MOVE, 9 as u32, event.PT_MOUSE, true, 180.0, 300.0, t2 + 2016)
    let u3: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 9 as u32, event.PT_MOUSE, true, 180.0, 300.0, t2 + 2032)
    check(lay.scroll_offset(0) == 0.0, "a mouse drag does not scroll the area")
    say("-- overscroll at the top\n")
    lay.scroll_to(0, 0.0)
    let ot: i64 = t2 + 5000
    fuiwirt.host_tick(w, ot)
    let d4: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_DOWN, 4 as u32, touch, true, 180.0, 200.0, ot)
    var oy4: f64 = 200.0
    var ot4: i64 = ot
    steps = 0
    while steps < 8 {
        ot4 = ot4 + 16
        oy4 = oy4 + 12.0
        fuiwirt.host_tick(w, ot4)
        let mv4: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_MOVE, 4 as u32, touch, true, 180.0, oy4, ot4)
        steps = steps + 1
    }
    check(lay.scroll_offset(0) == 0.0, "pulling past the top keeps the offset at 0")
    check(lay.scroll_over(0) < 0.0 - 10.0, "pulling past the top stretches the rubber band")
    ot4 = ot4 + 400
    fuiwirt.host_tick(w, ot4)
    let u4: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 4 as u32, touch, true, 180.0, oy4, ot4)
    ms = 0
    while ms < 1500 {
        ms = ms + 16
        fuiwirt.host_tick(w, ot4 + ms)
    }
    check(lay.scroll_over(0) == 0.0 && lay.scroll_offset(0) == 0.0, "the band springs back after the lift")
    say("-- horizontal area\n")
    let ht: i64 = ot4 + 5000
    fuiwirt.host_tick(w, ht)
    let d5: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_DOWN, 5 as u32, touch, true, 300.0, 570.0, ht)
    var hx: f64 = 300.0
    var ht5: i64 = ht
    steps = 0
    while steps < 8 {
        ht5 = ht5 + 16
        hx = hx - 12.0
        fuiwirt.host_tick(w, ht5)
        let mv5: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_MOVE, 5 as u32, touch, true, hx, 570.0, ht5)
        steps = steps + 1
    }
    let hheld: f64 = lay.scroll_offset_x(1)
    check(hheld > 50.0 && hheld < 110.0, "a horizontal area follows a sideways drag")
    check(lay.scroll_offset(1) == 0.0, "a sideways drag does not scroll it vertically")
    ht5 = ht5 + 8
    fuiwirt.host_tick(w, ht5)
    let u5: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 5 as u32, touch, true, hx, 570.0, ht5)
    let hat: f64 = lay.scroll_offset_x(1)
    ms = 0
    while ms < 800 {
        ms = ms + 16
        fuiwirt.host_tick(w, ht5 + ms)
    }
    check(lay.scroll_offset_x(1) > hat + 20.0, "a sideways flick runs out")
    check(scene.node_w(app.app_scene(a), lay.scroll_node(1)) > 0.0, "the horizontal area has a width")
    say("-- horizontal area: mouse wheel, keyboard, scroll bar\n")
    lay.scroll_to_x(1, 0.0)
    settle2(a, s)
    let hv: *mut viewport.Viewport = scene.node_viewport(app.app_scene(a), lay.scroll_node(1))
    var bx: f64 = 0.0
    var by: f64 = 0.0
    var bw: f64 = 0.0
    var bh: f64 = 0.0
    check(viewport.viewport_bar_rect_h(hv, &bx, &by, &bw, &bh), "the horizontal area has a scroll bar")
    let px: f64 = bx + bw / 2.0
    let py: f64 = by - 20.0
    let wr0: u32 = fuiwirt.host_pointer_move(w, px, py)
    let wr1: u32 = fuiwirt.host_pointer_down(w, px, py, fuiwirt.BTN_WHEEL_DOWN)
    settle2(a, s)
    check(lay.scroll_offset_x(1) > 0.0, "the plain wheel scrolls a horizontal area sideways")
    check(lay.scroll_offset(0) == 0.0, "... and not the vertical area")
    lay.scroll_to_x(1, 0.0)
    let wr2: u32 = fuiwirt.host_pointer_down(w, px, py, fuiwirt.BTN_WHEEL_RIGHT)
    settle2(a, s)
    check(lay.scroll_offset_x(1) > 0.0, "the sideways wheel scrolls a horizontal area")
    lay.scroll_to_x(1, 0.0)
    fuiwirt.host_set_mods(w, fuiwirt.MOD_SHIFT)
    let wr3: u32 = fuiwirt.host_pointer_down(w, px, py, fuiwirt.BTN_WHEEL_DOWN)
    fuiwirt.host_set_mods(w, 0 as u32)
    settle2(a, s)
    check(lay.scroll_offset_x(1) > 0.0, "shift + wheel scrolls sideways")
    lay.scroll_to_x(1, 0.0)
    let k0: u32 = fuiwirt.host_key(w, fuiwirt.KEY_RIGHT, 0 as u32)
    settle2(a, s)
    check(lay.scroll_offset_x(1) > 0.0, "the right arrow scrolls a horizontal area")
    let k1: u32 = fuiwirt.host_key(w, fuiwirt.KEY_LEFT, 0 as u32)
    settle2(a, s)
    check(lay.scroll_offset_x(1) == 0.0, "the left arrow scrolls it back")
    let k2: u32 = fuiwirt.host_key(w, fuiwirt.KEY_END, 0 as u32)
    settle2(a, s)
    let hmax: f64 = viewport.viewport_max_x(hv)
    check(hmax > 0.0 && lay.scroll_offset_x(1) == hmax, "End goes to the right end")
    let k3: u32 = fuiwirt.host_key(w, fuiwirt.KEY_HOME, 0 as u32)
    settle2(a, s)
    check(lay.scroll_offset_x(1) == 0.0, "Home goes to the left end")
    let k4: u32 = fuiwirt.host_key(w, fuiwirt.KEY_PAGE_DOWN, 0 as u32)
    settle2(a, s)
    check(lay.scroll_offset_x(1) > 100.0, "Page Down moves a page sideways")
    lay.scroll_to_x(1, 0.0)
    settle2(a, s)
    let bd0: u32 = fuiwirt.host_pointer_down(w, bx + 4.0, by + bh / 2.0, fuiwirt.BTN_LEFT)
    let bm0: u32 = fuiwirt.host_pointer_move(w, bx + 64.0, by + bh / 2.0)
    settle2(a, s)
    let bu0: u32 = fuiwirt.host_pointer_up(w, bx + 64.0, by + bh / 2.0, fuiwirt.BTN_LEFT)
    check(lay.scroll_offset_x(1) > 20.0, "dragging the bar thumb scrolls sideways")
    lay.scroll_to_x(1, 0.0)
    settle2(a, s)
    text_area_checks()
    say("\n")
    num("checks: ", TOTAL as i64)
    num("wrong: ", BAD as i64)
    if BAD == 0 {
        say("TOUCHSCROLL PASSED\n")
        return 0
    }
    say("TOUCHSCROLL FAILED\n")
    return 1
}
