import std.rt
import paint.canvas
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.widget
import fui.sheet
import fui.style
import fui.syspref
import fui.flex
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.lay
import fui.a11y
import fui.appctl
import fui.safeout
import fui.event
import fui.touchscroll
import fui.viewport

static mut BAD: usize = 0
static mut TOTAL: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    TOTAL = TOTAL + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn num(tag: str, v: i64) {
    say(tag)
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
}

fn near_rgb(a: u32, b: u32, tol: i64) -> bool {
    var s: u32 = 0
    while s <= 16 {
        let x: i64 = ((a >> s) & 255 as u32) as i64
        let y: i64 = ((b >> s) & 255 as u32) as i64
        var d: i64 = x - y
        if d < 0 { d = 0 - d }
        if d > tol { return false }
        s = s + 8
    }
    return true
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    fuiwirt.host_bind(app.app_host(a))
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

fn settle2(a: *mut app.App, s: *mut Surface) {
    lay.scroll_sync(a)
    frame(a, s)
    lay.scroll_sync(a)
    frame(a, s)
    lay.scroll_sync(a)
    frame(a, s)
}

fn nh(a: *mut app.App, n: usize) -> i64 { return scene.node_h(app.app_scene(a), n) as i64 }
fn ny(a: *mut app.App, n: usize) -> i64 { return scene.node_y(app.app_scene(a), n) as i64 }

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("touchscroll: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let W: usize = 360
    let H: usize = 600
    let a: *mut app.App = app.window("Scroll", W, H)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, W, H)
    if s as u64 == 0 {
        return 9
    }
    lay.page(a)
    let bar: usize = lay.vbox(a)
    lay.min_h(a, bar, 56)
    lay.grow(a, bar, 0)
    app.end(a)
    let inner: usize = lay.scroll_v(a)
    var k: usize = 0
    while k < 30 {
        let row: usize = app.spacer(a, 0, 40)
        k = k + 1
    }
    app.end(a)
    settle2(a, s)
    let w: *mut fuiwirt.Host = app.app_host(a)
    let touch: u32 = event.PT_TOUCH
    say("-- tap\n")
    fuiwirt.host_tick(w, 1000)
    let d0: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_DOWN, 1 as u32, touch, true, 180.0, 300.0, 1000)
    fuiwirt.host_tick(w, 1010)
    let m0: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_MOVE, 1 as u32, touch, true, 180.0, 292.0, 1010)
    fuiwirt.host_tick(w, 1020)
    let u0: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 1 as u32, touch, true, 180.0, 292.0, 1020)
    check(lay.scroll_offset(0) == 0.0, "a tap that stays inside the slop does not scroll")
    say("-- drag\n")
    fuiwirt.host_tick(w, 2000)
    let d1: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_DOWN, 2 as u32, touch, true, 180.0, 500.0, 2000)
    var t: i64 = 2000
    var y: f64 = 500.0
    var steps: usize = 0
    while steps < 10 {
        t = t + 16
        y = y - 12.0
        fuiwirt.host_tick(w, t)
        let mv: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_MOVE, 2 as u32, touch, true, 180.0, y, t)
        steps = steps + 1
    }
    let held: f64 = lay.scroll_offset(0)
    check(held > 60.0 && held < 130.0, "the content follows the finger (offset between 60 and 130 after 120 px of drag)")
    t = t + 8
    fuiwirt.host_tick(w, t)
    let u1: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 2 as u32, touch, true, 180.0, y, t)
    let at_up: f64 = lay.scroll_offset(0)
    var ms: i64 = 0
    while ms < 600 {
        ms = ms + 16
        fuiwirt.host_tick(w, t + ms)
    }
    let after: f64 = lay.scroll_offset(0)
    check(after > at_up + 20.0, "a flick runs out after the finger lifts")
    num("offset at lift: ", at_up as i64)
    num("offset after run-out: ", after as i64)
    say("-- stop\n")
    ms = ms + 16
    fuiwirt.host_tick(w, t + ms)
    let still: f64 = lay.scroll_offset(0)
    ms = ms + 16
    fuiwirt.host_tick(w, t + ms)
    check(lay.scroll_offset(0) == still, "the run-out has ended")
    say("-- slow drag, no fling\n")
    lay.scroll_to(0, 0.0)
    let base_t: i64 = t + ms + 1000
    fuiwirt.host_tick(w, base_t)
    let d2: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_DOWN, 3 as u32, touch, true, 180.0, 500.0, base_t)
    var t2: i64 = base_t
    var y2: f64 = 500.0
    steps = 0
    while steps < 5 {
        t2 = t2 + 16
        y2 = y2 - 12.0
        fuiwirt.host_tick(w, t2)
        let mv2: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_MOVE, 3 as u32, touch, true, 180.0, y2, t2)
        steps = steps + 1
    }
    t2 = t2 + 400
    fuiwirt.host_tick(w, t2)
    let u2: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 3 as u32, touch, true, 180.0, y2, t2)
    let rest: f64 = lay.scroll_offset(0)
    fuiwirt.host_tick(w, t2 + 300)
    check(lay.scroll_offset(0) == rest, "a finger that rested before the lift does not fling")
    say("-- mouse\n")
    lay.scroll_to(0, 0.0)
    fuiwirt.host_tick(w, t2 + 2000)
    let d3: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_DOWN, 9 as u32, event.PT_MOUSE, true, 180.0, 500.0, t2 + 2000)
    let m3: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_MOVE, 9 as u32, event.PT_MOUSE, true, 180.0, 300.0, t2 + 2016)
    let u3: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 9 as u32, event.PT_MOUSE, true, 180.0, 300.0, t2 + 2032)
    check(lay.scroll_offset(0) == 0.0, "a mouse drag does not scroll the area")
    say("\n")
    num("checks: ", TOTAL as i64)
    num("wrong: ", BAD as i64)
    if BAD == 0 {
        say("TOUCHSCROLL PASSED\n")
        return 0
    }
    say("TOUCHSCROLL FAILED\n")
    return 1
}
