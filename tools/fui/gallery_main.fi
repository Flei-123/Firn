// SPDX-License-Identifier: GPL-2.0-only
// tools/fui/schauseite_main.fi -- fUi ZEIGT SICH SELBST.
//
// ====================================================== WARUM ES SIE GIBT
//
// Justins Forderung: "EINE SCHAUSEITE, die jedes fertige Widget in
// allen Zustaenden zeigt, hell und dark -- ein einziges Programm, das
// man startet und alles sieht."
//
// Sie ist zweierlei zugleich: Justins Vorschau und unsere Abnahme. Ein
// Widget, das hier nicht auftaucht, gilt als nicht fertig.
//
//     schauseite_main <align.png> [hell|dark] [<schrift.ttf>]
//
// Gemalt wird OHNE Fenster -- direkt auf eine Leinwand und als PNG
// heraus. Damit laeuft die Abnahme auf einem Server ohne Bildschirm,
// und die Bilder sind bildpunktgenau vergleichbar.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.layout
import fui.core

const FONTSET_BYTES: usize = 4096
const W: usize = 1200
const H: usize = 760

// Ein Widget anlegen, legen, beschriften -- der immer gleiche
// Dreisatz, damit die Schauseite selbst lesbar bleibt.
fn mach(kind: u32, x: f64, y: f64, w: f64, h: f64, p: u64,
    n: usize) -> widget.Widget {
    var e: widget.Widget = widget.widget_new(kind)
    widget.w_place(&e, x, y, w, h)
    widget.w_set_text(&e, p, n)
    return e
}

// Eine Ueberschrift ueber einen Abschnitt.
fn kopf(c: *mut render.Ctx, x: f64, y: f64, p: u64, n: usize) {
    var e: widget.Widget = mach(widget.KIND_LABEL, x, y,
        400.0, 20.0, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(style.TOK_TEXT_MUTED))
    *s = style.style_set_font(*s, 0, 12)
    render.draw_label(c, &e)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 52] = "gallery_main <aus.png> [hell|dunkel] [font.ttf]\n\0\0\0\0"
        rt.write_everything(2, (&u[0]) as u64, 50)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    var dark: bool = true
    if rt.arg_count(start) >= 3 {
        if rt.ld8(rt.arg_ptr(start, 2), 0) == 104 as u8 {
            dark = false
        }
    }

    // ---- die Schrift
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
        rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }

    // ---- Leinwand, Painter, Theme
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, 1200, 120) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(dark)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque((*f).base))

    let ch: f64 = 32.0
    let bw: f64 = 150.0
    var y: f64 = 24.0

    // ==================================================================
    // ABSCHNITT 1: DER KNOPF IN ALLEN FUENF ZUSTAENDEN
    // ==================================================================
    var t_k1: [u8; 40] = "KNOPF -- die fuenf Zustaende            "
    kopf(&c, 24.0, y, (&t_k1[0]) as u64, 32)
    y = y + 26.0

    var t_norm: [u8; 6] = "Normal"
    var t_ueb: [u8; 9] = "Ueberfahr"
    var t_dru: [u8; 9] = "Gedrueckt"
    var t_fok: [u8; 10] = "Fokussiert"
    var t_sp: [u8; 8] = "Gesperrt"
    var x: f64 = 24.0

    var k1: widget.Widget = mach(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_norm[0]) as u64, 6)
    render.draw_widget(&c, &k1)
    x = x + bw + 12.0

    var k2: widget.Widget = mach(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_ueb[0]) as u64, 9)
    widget.w_set_hover(&k2, true)
    render.draw_widget(&c, &k2)
    x = x + bw + 12.0

    var k3: widget.Widget = mach(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_dru[0]) as u64, 9)
    widget.w_set_active(&k3, true)
    render.draw_widget(&c, &k3)
    x = x + bw + 12.0

    var k4: widget.Widget = mach(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_fok[0]) as u64, 10)
    widget.w_set_focus(&k4, true)
    render.draw_widget(&c, &k4)
    x = x + bw + 12.0

    var k5: widget.Widget = mach(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_sp[0]) as u64, 8)
    widget.w_set_disabled(&k5, true)
    render.draw_widget(&c, &k5)

    // ==================================================================
    // ABSCHNITT 2: DIE FUENF STILVARIANTEN
    // ==================================================================
    y = y + ch + 34.0
    var t_s1: [u8; 46] = "STIL -- dasselbe Widget, fuenf Gestaltungen   "
    kopf(&c, 24.0, y, (&t_s1[0]) as u64, 44)
    y = y + 26.0

    // Eine Tafel darunter, damit "kein Hintergrund" SICHTBAR wird:
    // ueber einer eigenen Flaeche sieht man, dass nichts gemalt wird.
    // Die Tafel geht genau ueber die sechs Varianten. Sie ist der
    // BEWEIS fuer "kein Hintergrund": wo nichts gemalt wird, steht
    // hinterher die TAFELfarbe -- nicht die Fensterfarbe. Waere
    // `transparent` in Wahrheit "male Fensterfarbe drueber" (Justins
    // Punkt 4), stuende hier ein heller Fleck im dunklen Feld.
    painter.round_rect(&z, 16.0, y - 8.0, 980.0, ch + 16.0,
        theme.theme_px(&m, 10) as f64, (*f).surface_raised)

    var t_v1: [u8; 14] = "kein Hintergr."
    var t_v2: [u8; 13] = "nur bei hover"
    var t_v3: [u8; 10] = "rot fest  "
    var t_v4: [u8; 11] = "Theme-Token"
    var t_v5: [u8; 12] = "eigener Font"
    x = 24.0

    // 1 -- kein Hintergrund
    var v1: widget.Widget = mach(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_v1[0]) as u64, 14)
    let sv1: *mut style.Style = widget.w_style(&v1)
    *sv1 = style.style_set_bg(*sv1, style.color_transparent())
    render.draw_widget(&c, &v1)
    x = x + bw + 12.0

    // 2 -- Hintergrund NUR bei hover. Zweimal gezeigt: align und an.
    var v2: widget.Widget = mach(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_v2[0]) as u64, 13)
    let sv2: *mut style.Style = widget.w_style(&v2)
    *sv2 = style.style_set_bg(*sv2, style.color_transparent())
    style.styleset_set_override(widget.w_styleset(&v2), style.STATE_HOVER,
        style.override_set_bg(style.override_new(),
            style.color_token(style.TOK_ACCENT)))
    render.draw_widget(&c, &v2)
    x = x + bw + 12.0

    var v2b: widget.Widget = mach(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_v2[0]) as u64, 13)
    let sv2b: *mut style.Style = widget.w_style(&v2b)
    *sv2b = style.style_set_bg(*sv2b, style.color_transparent())
    *sv2b = style.style_set_fg(*sv2b,
        style.color_token(style.TOK_TEXT_ON_ACCENT))
    style.styleset_set_override(widget.w_styleset(&v2b), style.STATE_HOVER,
        style.override_set_bg(style.override_new(),
            style.color_token(style.TOK_ACCENT)))
    widget.w_set_hover(&v2b, true)
    render.draw_widget(&c, &v2b)
    x = x + bw + 12.0

    // 3 -- feste rote Fuellung, weisser Text
    var v3: widget.Widget = mach(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_v3[0]) as u64, 8)
    let sv3: *mut style.Style = widget.w_style(&v3)
    *sv3 = style.style_set_bg(*sv3, style.color_literal(13976616 as u32))
    *sv3 = style.style_set_fg(*sv3,
        style.color_literal(16777215 as u32))
    render.draw_widget(&c, &v3)
    x = x + bw + 12.0

    // 4 -- Theme-Token
    var v4: widget.Widget = mach(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_v4[0]) as u64, 11)
    let sv4: *mut style.Style = widget.w_style(&v4)
    *sv4 = style.style_set_bg(*sv4, style.color_token(style.TOK_ACCENT))
    *sv4 = style.style_set_fg(*sv4,
        style.color_token(style.TOK_TEXT_ON_ACCENT))
    render.draw_widget(&c, &v4)
    x = x + bw + 12.0

    // 5 -- eigene Schriftfarbe, groesser, fett, Rahmen statt Fuellung
    var v5: widget.Widget = mach(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_v5[0]) as u64, 12)
    let sv5: *mut style.Style = widget.w_style(&v5)
    *sv5 = style.style_set_bg(*sv5, style.color_transparent())
    *sv5 = style.style_set_border(*sv5, style.color_token(style.TOK_ACCENT), 2)
    *sv5 = style.style_set_fg(*sv5, style.color_token(style.TOK_ACCENT))
    *sv5 = style.style_set_font(*sv5, 0, 17)
    render.draw_widget(&c, &v5)

    // ==================================================================
    // ABSCHNITT 3: BESCHRIFTUNGEN
    // ==================================================================
    y = y + ch + 34.0
    var t_b1: [u8; 46] = "BESCHRIFTUNG -- Ausrichtung und Schriftgroesse"
    kopf(&c, 24.0, y, (&t_b1[0]) as u64, 44)
    y = y + 26.0

    var t_li: [u8; 5] = "left "
    var t_mi: [u8; 6] = "mittig"
    var t_re: [u8; 6] = "right "
    // Eine Tafel als Grund, damit man die Ausrichtung im Rect sieht.
    painter.round_rect(&z, 24.0, y, 360.0, ch, 6.0, (*f).surface_raised)
    var b1: widget.Widget = mach(widget.KIND_LABEL, 24.0, y,
        360.0, ch, (&t_li[0]) as u64, 5)
    let sb1: *mut style.Style = widget.w_style(&b1)
    *sb1 = style.style_set_pad(*sb1, 12, 0)
    render.draw_widget(&c, &b1)
    var b2: widget.Widget = mach(widget.KIND_LABEL, 24.0, y,
        360.0, ch, (&t_mi[0]) as u64, 6)
    let sb2: *mut style.Style = widget.w_style(&b2)
    *sb2 = style.style_set_align(*sb2, style.ALIGN_CENTER)
    render.draw_widget(&c, &b2)
    var b3: widget.Widget = mach(widget.KIND_LABEL, 24.0, y,
        360.0, ch, (&t_re[0]) as u64, 6)
    let sb3: *mut style.Style = widget.w_style(&b3)
    *sb3 = style.style_set_align(*sb3, style.ALIGN_RIGHT)
    *sb3 = style.style_set_pad(*sb3, 12, 0)
    render.draw_widget(&c, &b3)

    // Groessen
    var t_gr: [u8; 8] = "12 15 20"
    var xg: f64 = 420.0
    var gi: usize = 0
    var groessen: [usize; 3] = [12, 15, 20]
    while gi < 3 {
        var bg: widget.Widget = mach(widget.KIND_LABEL, xg, y,
            90.0, ch, (&t_gr[0]) as u64, 2)
        let sg: *mut style.Style = widget.w_style(&bg)
        *sg = style.style_set_font(*sg, 0, groessen[gi])
        render.draw_widget(&c, &bg)
        xg = xg + 60.0
        gi = gi + 1
    }

    // ==================================================================
    // ABSCHNITT 4: DIE ANORDNUNG, ECHT GERECHNET
    // ==================================================================
    y = y + ch + 34.0
    var t_a1: [u8; 46] = "ANORDNUNG -- Box mit dehnbarem Feld           "
    kopf(&c, 24.0, y, (&t_a1[0]) as u64, 40)
    y = y + 26.0

    // Genau die Leiste von Certus: drei Knoepfe fest, Adressfeld dehnbar.
    var st: layout.Box = layout.box_new(layout.HORIZONTAL)
    layout.box_set_margin(&st, 8, 0, 8, 0)
    layout.box_set_gap(&st, 8)
    var pref: [i64; 4] = [40, 40, 40, 100]
    var grow: [i64; 4] = [0, 0, 0, 1]
    var cross: [i64; 4] = [32, 32, 32, 32]
    var kaesten: [layout.Rect; 4] =
        [layout.rect_new(0,0,0,0); 4]
    layout.box_layout(&st,
        layout.rect_new(24, y as i64, 1152, 32),
        (&pref[0]) as *mut i64, (&grow[0]) as *mut i64,
        (&cross[0]) as *mut i64,
        (&kaesten[0]) as *mut layout.Rect, 4)

    var t_zu: [u8; 1] = "<"
    var t_vo: [u8; 1] = ">"
    var t_ne: [u8; 1] = "R"
    var t_ad: [u8; 21] = "https://de.wikipedia."
    var ai: usize = 0
    while ai < 4 {
        var kind: u32 = widget.KIND_BUTTON
        var tp: u64 = (&t_zu[0]) as u64
        var tn: usize = 1
        if ai == 1 {
            tp = (&t_vo[0]) as u64
        } else if ai == 2 {
            tp = (&t_ne[0]) as u64
        } else if ai == 3 {
            kind = widget.KIND_TEXTBOX
            tp = (&t_ad[0]) as u64
            tn = 21
        }
        var ea: widget.Widget = mach(kind,
            layout.rect_x(&kaesten[ai]) as f64,
            layout.rect_y(&kaesten[ai]) as f64,
            layout.rect_w(&kaesten[ai]) as f64,
            layout.rect_h(&kaesten[ai]) as f64, tp, tn)
        render.draw_widget(&c, &ea)
        ai = ai + 1
    }

    // ==================================================================
    // ABSCHNITT 5: DAS RASTER
    // ==================================================================
    y = y + ch + 34.0
    var t_r1: [u8; 40] = "RASTER -- 6 x 2, Abstaende, exakte Summe"
    kopf(&c, 24.0, y, (&t_r1[0]) as u64, 39)
    y = y + 26.0

    var ra: layout.Grid = layout.grid_new(6, 2)
    layout.grid_set_gap(&ra, 10, 10)
    let rraum: layout.Rect =
        layout.rect_new(24, y as i64, 1152, 76)
    var t_z: [u8; 5] = "Feld "
    var rz: usize = 0
    while rz < 2 {
        var rs: usize = 0
        while rs < 6 {
            var zk: layout.Rect =
                layout.grid_cell(&ra, rraum, rs, rz)
            var er: widget.Widget = mach(widget.KIND_TILE,
                layout.rect_x(&zk) as f64,
                layout.rect_y(&zk) as f64,
                layout.rect_w(&zk) as f64,
                layout.rect_h(&zk) as f64,
                (&t_z[0]) as u64, 4)
            // Jede zweite Kachel im Akzent -- damit man die Zellen
            // wirklich abzaehlen kann.
            if (rs + rz) % 2 == 1 {
                let sr: *mut style.Style = widget.w_style(&er)
                *sr = style.style_set_bg(*sr,
                    style.color_token(style.TOK_SURFACE_RAISED))
            }
            render.draw_widget(&c, &er)
            rs = rs + 1
        }
        rz = rz + 1
    }

    // ==================================================================
    // ABSCHNITT 6: DIE FENSTERKNOEPFE AUS DEM KERN
    // ==================================================================
    y = y + 76.0 + 34.0
    var t_f1: [u8; 52] = "FENSTERKNOEPFE -- align dem Kern, skaliert 1x 2x 3x "
    kopf(&c, 24.0, y, (&t_f1[0]) as u64, 49)
    y = y + 26.0

    // Sie werden hier ueber die Kern-Schnittstelle gemalt -- derselbe
    // Quelltext, den der Fenstermanager von OrientOS im Kernprofil
    // einbindet. Dafuer braucht es die Bildpunkte der Leinwand als
    // rohen Puffer.
    // Die Leinwand ist 0xAARRGGBB, der Kern schreibt BGRX. Beide legen
    // B, G, R in derselben Reihenfolge ab -- der Kern setzt nur das
    // vierte Oktett auf 0 statt auf 255. Fuer ein PNG, das die
    // Leinwand als deckend liest, muss das Alpha aber stehen bleiben;
    // darum malt der Kern hier in einen EIGENEN Puffer, und der wird
    // danach mit gesetztem Alpha uebertragen. Auf einem echten Fenster
    // faellt das weg -- dort IST der Puffer BGRX.
    let kbytes: usize = W * H * 4
    let kp: u64 = rt.heap_alloc(kbytes)
    if kp == 0 as u64 {
        return 8
    }
    rt.mem_set(kp, 0 as u8, kbytes)
    var zi: core.Target = core.target_new(kp, W, H, W * 4)
    var sk: usize = 1
    var kx: f64 = 24.0
    while sk <= 3 {
        let cap_w: usize = 30 * sk
        let d: usize = 10 * sk
        let sb: usize = sk
        let height: usize = 32 * sk
        // Die Flaeche: dieselbe Rundung how jeder Knopf.
        var i2: usize = 0
        while i2 < 3 {
            let bx: f64 = kx + ((i2 * cap_w) as f64)
            painter.round_rect(&z, bx, y, cap_w as f64, height as f64, 0.0,
                (*f).surface)
            i2 = i2 + 1
        }
        let oy: usize = (y as usize) + (height - d) / 2
        let ox0: usize = (kx as usize) + (cap_w - d) / 2
        core.cap_minimize(&zi, ox0, oy, d, sb, (*f).text)
        core.cap_maximize(&zi, ox0 + cap_w, oy, d, sb, (*f).text)
        core.cap_close(&zi, ox0 + 2 * cap_w, oy, d, sb,
            (*f).text)
        kx = kx + ((3 * cap_w) as f64) + 24.0
        sk = sk + 1
    }

    // Den Kernpuffer auf die Leinwand legen: was der Kern set_mask hat,
    // gewinnt. Erkennbar an einem Oktett ungleich null -- der Puffer
    // war vorher genullt.
    let cvp: u64 = canvas.canvas_pixels(&cv) as u64
    var pi: usize = 0
    while pi < W * H {
        let o: u64 = (pi * 4) as u64
        // ==============================================================
        // R UND B TAUSCHEN -- SONST IST DAS ZEICHEN FALSCHFARBEN
        // ==============================================================
        //
        // EIN FEHLER DIESER RUNDE, IM BILD GEFUNDEN. Die erste Fassung
        // kopierte die vier Oktett unveraendert, und im PNG stand
        // 0xFEFBFB statt 0xFBFBFE -- rot und blau vertauscht. Bei einem
        // fast weissen Zeichen sieht man das nicht; bei einem farbigen
        // waere es sofort aufgefallen.
        //
        // Der Grund ist der Vertrag: lib/fenster/fenster.fi legt in F3
        // BGRX fest (B, G, R, X im Speicher), und der Kern haelt sich
        // daran. lib/paint/canvas.fi legt dagegen R, G, B, A ab. Auf
        // einem echten Fenster faellt der Tausch weg -- dort schiebt
        // `fenster.bild` einen BGRX-Puffer, und der Kern hat direkt
        // hineingemalt. Nur DIESES Werkzeug malt in eine Leinwand.
        //
        // Dieselbe Verwechslung steht als Warnung in
        // lib/fenster/fenster.fi bei `rgb_nach_bgrx`: "eine erste
        // Fassung von `to_bgrx` tauschte R und B, und das Fenster
        // zeigte die Seite in Falschfarben."
        let b: u8 = *((kp + o) as *mut u8)
        let g: u8 = *((kp + o + 1 as u64) as *mut u8)
        let r: u8 = *((kp + o + 2 as u64) as *mut u8)
        if b != 0 as u8 || g != 0 as u8 || r != 0 as u8 {
            *((cvp + o) as *mut u8) = r
            *((cvp + o + 1 as u64) as *mut u8) = g
            *((cvp + o + 2 as u64) as *mut u8) = b
            *((cvp + o + 3 as u64) as *mut u8) = 255 as u8
        }
        pi = pi + 1
    }

    // ---- HERAUSSCHREIBEN
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&cv, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < rt.c_length(path) {
        rt.buf_push(&pf, rt.ld8(path, k))
        k = k + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 12] = "SCHAUSEITE\n\0"
    rt.write_everything(1, (&okm[0]) as u64, 11)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    return 0
}
