// SPDX-License-Identifier: MPL-2.0
// tools/fui/gallery_main.fi -- fUi SHOWS ITSELF.
//
// ====================================================== WHY IT EXISTS
//
// Justin's demand: "ONE GALLERY that shows every finished widget in
// all its states, light and dark -- a single program you start and
// see everything."
//
// It is two things at once: Justin's preview and our acceptance. A
// widget that does not show up here counts as unfinished.
//
//     gallery_main <out.png> [light|dark] [<font.ttf>]
//
// It paints WITHOUT a window -- straight onto a canvas and out as a
// PNG. That way the acceptance runs on a server with no screen, and
// the images are comparable pixel by pixel.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.layout
import fui.core

const FONTSET_BYTES: usize = 4096
const W: usize = 1200
const H: usize = 760

// Create a widget, place it, label it -- always the same three
// steps, so the gallery itself stays readable.
fn make_widget(kind: u32, x: f64, y: f64, w: f64, h: f64, p: u64,
    n: usize) -> widget.Widget {
    var e: widget.Widget = widget.widget_new(kind)
    widget.w_place(&e, x, y, w, h)
    widget.w_set_text(&e, p, n)
    return e
}

// A heading above a section.
fn heading(c: *mut render.Ctx, x: f64, y: f64, p: u64, n: usize) {
    var e: widget.Widget = make_widget(widget.KIND_LABEL, x, y,
        400.0, 20.0, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(style.TOK_TEXT_MUTED))
    *s = style.style_set_font(*s, 0, 12)
    render.draw_label(c, &e)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 47] = "gallery_main <out.png> [light|dark] [font.ttf]\n"
        rt.write_everything(2, (&u[0]) as u64, 47)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    var dark: bool = true
    if rt.arg_count(start) >= 3 {
        if rt.ld8(rt.arg_ptr(start, 2), 0) == 108 as u8 {
            dark = false
        }
    }

    // ---- the font
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
        rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }

    // ---- canvas, painter, theme
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, 1200, 120) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(dark)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque((*f).base))

    let ch: f64 = 32.0
    let bw: f64 = 150.0
    var y: f64 = 24.0

    // ==================================================================
    // SECTION 1: THE BUTTON IN ALL FIVE STATES
    // ==================================================================
    var t_k1: [u8; 40] = "BUTTON -- the five states               "
    heading(&c, 24.0, y, (&t_k1[0]) as u64, 38)
    y = y + 26.0

    var t_norm: [u8; 6] = "Normal"
    var t_hover: [u8; 5] = "Hover"
    var t_pressed: [u8; 7] = "Pressed"
    var t_focus: [u8; 7] = "Focused"
    var t_disabled: [u8; 8] = "Disabled"
    var x: f64 = 24.0

    var k1: widget.Widget = make_widget(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_norm[0]) as u64, 6)
    render.draw_widget(&c, &k1)
    x = x + bw + 12.0

    var k2: widget.Widget = make_widget(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_hover[0]) as u64, 5)
    widget.w_set_hover(&k2, true)
    render.draw_widget(&c, &k2)
    x = x + bw + 12.0

    var k3: widget.Widget = make_widget(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_pressed[0]) as u64, 7)
    widget.w_set_active(&k3, true)
    render.draw_widget(&c, &k3)
    x = x + bw + 12.0

    var k4: widget.Widget = make_widget(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_focus[0]) as u64, 7)
    widget.w_set_focus(&k4, true)
    render.draw_widget(&c, &k4)
    x = x + bw + 12.0

    var k5: widget.Widget = make_widget(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_disabled[0]) as u64, 8)
    widget.w_set_disabled(&k5, true)
    render.draw_widget(&c, &k5)

    // ==================================================================
    // SECTION 2: THE FIVE STYLE VARIANTS
    // ==================================================================
    y = y + ch + 34.0
    var t_s1: [u8; 46] = "STYLE -- the same widget, five looks          "
    heading(&c, 24.0, y, (&t_s1[0]) as u64, 44)
    y = y + 26.0

    // A panel beneath it so that "no background" becomes VISIBLE:
    // on top of its own surface you can see that nothing is painted.
    // The panel spans exactly the six variants. It is the PROOF for
    // "no background": where nothing is painted, the PANEL colour is
    // there afterwards -- not the window colour. If `transparent`
    // really meant "paint the window colour over it" (Justin's point
    // 4), there would be a light patch in the dark field here.
    painter.round_rect(&z, 16.0, y - 8.0, 980.0, ch + 16.0,
        theme.theme_px(&m, 10) as f64, (*f).surface_raised)

    var t_v1: [u8; 13] = "no background"
    var t_v2: [u8; 10] = "hover only"
    var t_v3: [u8; 10] = "red fixed "
    var t_v4: [u8; 11] = "theme token"
    var t_v5: [u8; 8] = "own font"
    x = 24.0

    // 1 -- no background
    var v1: widget.Widget = make_widget(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_v1[0]) as u64, 13)
    let sv1: *mut style.Style = widget.w_style(&v1)
    *sv1 = style.style_set_bg(*sv1, style.color_transparent())
    render.draw_widget(&c, &v1)
    x = x + bw + 12.0

    // 2 -- background ONLY on hover. Shown twice: off and on.
    var v2: widget.Widget = make_widget(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_v2[0]) as u64, 10)
    let sv2: *mut style.Style = widget.w_style(&v2)
    *sv2 = style.style_set_bg(*sv2, style.color_transparent())
    style.styleset_set_override(widget.w_styleset(&v2), style.STATE_HOVER,
        style.override_set_bg(style.override_new(),
            style.color_token(style.TOK_ACCENT)))
    render.draw_widget(&c, &v2)
    x = x + bw + 12.0

    var v2b: widget.Widget = make_widget(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_v2[0]) as u64, 10)
    let sv2b: *mut style.Style = widget.w_style(&v2b)
    *sv2b = style.style_set_bg(*sv2b, style.color_transparent())
    *sv2b = style.style_set_fg(*sv2b,
        style.color_token(style.TOK_TEXT_ON_ACCENT))
    style.styleset_set_override(widget.w_styleset(&v2b), style.STATE_HOVER,
        style.override_set_bg(style.override_new(),
            style.color_token(style.TOK_ACCENT)))
    widget.w_set_hover(&v2b, true)
    render.draw_widget(&c, &v2b)
    x = x + bw + 12.0

    // 3 -- fixed red fill, white text
    var v3: widget.Widget = make_widget(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_v3[0]) as u64, 8)
    let sv3: *mut style.Style = widget.w_style(&v3)
    *sv3 = style.style_set_bg(*sv3, style.color_literal(13976616 as u32))
    *sv3 = style.style_set_fg(*sv3,
        style.color_literal(16777215 as u32))
    render.draw_widget(&c, &v3)
    x = x + bw + 12.0

    // 4 -- theme token
    var v4: widget.Widget = make_widget(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_v4[0]) as u64, 11)
    let sv4: *mut style.Style = widget.w_style(&v4)
    *sv4 = style.style_set_bg(*sv4, style.color_token(style.TOK_ACCENT))
    *sv4 = style.style_set_fg(*sv4,
        style.color_token(style.TOK_TEXT_ON_ACCENT))
    render.draw_widget(&c, &v4)
    x = x + bw + 12.0

    // 5 -- own text colour, larger, bold, border instead of fill
    var v5: widget.Widget = make_widget(widget.KIND_BUTTON, x, y, bw, ch,
        (&t_v5[0]) as u64, 8)
    let sv5: *mut style.Style = widget.w_style(&v5)
    *sv5 = style.style_set_bg(*sv5, style.color_transparent())
    *sv5 = style.style_set_border(*sv5, style.color_token(style.TOK_ACCENT), 2)
    *sv5 = style.style_set_fg(*sv5, style.color_token(style.TOK_ACCENT))
    *sv5 = style.style_set_font(*sv5, 0, 17)
    render.draw_widget(&c, &v5)

    // ==================================================================
    // SECTION 3: LABELS
    // ==================================================================
    y = y + ch + 34.0
    var t_b1: [u8; 45] = "LABEL -- alignment and font size             "
    heading(&c, 24.0, y, (&t_b1[0]) as u64, 43)
    y = y + 26.0

    var t_left: [u8; 6] = "left  "
    var t_centre: [u8; 6] = "centre"
    var t_right: [u8; 6] = "right "
    // A panel as a ground so the alignment inside the rect is visible.
    painter.round_rect(&z, 24.0, y, 360.0, ch, 6.0, (*f).surface_raised)
    var b1: widget.Widget = make_widget(widget.KIND_LABEL, 24.0, y,
        360.0, ch, (&t_left[0]) as u64, 5)
    let sb1: *mut style.Style = widget.w_style(&b1)
    *sb1 = style.style_set_pad(*sb1, 12, 0)
    render.draw_widget(&c, &b1)
    var b2: widget.Widget = make_widget(widget.KIND_LABEL, 24.0, y,
        360.0, ch, (&t_centre[0]) as u64, 6)
    let sb2: *mut style.Style = widget.w_style(&b2)
    *sb2 = style.style_set_align(*sb2, style.ALIGN_CENTER)
    render.draw_widget(&c, &b2)
    var b3: widget.Widget = make_widget(widget.KIND_LABEL, 24.0, y,
        360.0, ch, (&t_right[0]) as u64, 6)
    let sb3: *mut style.Style = widget.w_style(&b3)
    *sb3 = style.style_set_align(*sb3, style.ALIGN_RIGHT)
    *sb3 = style.style_set_pad(*sb3, 12, 0)
    render.draw_widget(&c, &b3)

    // sizes
    var t_sizes: [u8; 8] = "12 15 20"
    var xg: f64 = 420.0
    var gi: usize = 0
    var groessen: [usize; 3] = [12, 15, 20]
    while gi < 3 {
        var bg: widget.Widget = make_widget(widget.KIND_LABEL, xg, y,
            90.0, ch, (&t_sizes[0]) as u64, 2)
        let sg: *mut style.Style = widget.w_style(&bg)
        *sg = style.style_set_font(*sg, 0, groessen[gi])
        render.draw_widget(&c, &bg)
        xg = xg + 60.0
        gi = gi + 1
    }

    // ==================================================================
    // SECTION 4: THE LAYOUT, REALLY COMPUTED
    // ==================================================================
    y = y + ch + 34.0
    var t_a1: [u8; 46] = "LAYOUT -- box with a stretchy field           "
    heading(&c, 24.0, y, (&t_a1[0]) as u64, 44)
    y = y + 26.0

    // Exactly the Certus bar: three fixed buttons, address field stretchy.
    var st: layout.Box = layout.box_new(layout.HORIZONTAL)
    layout.box_set_margin(&st, 8, 0, 8, 0)
    layout.box_set_gap(&st, 8)
    var pref: [i64; 4] = [40, 40, 40, 100]
    var grow: [i64; 4] = [0, 0, 0, 1]
    var cross: [i64; 4] = [32, 32, 32, 32]
    var boxes: [layout.Rect; 4] =
        [layout.rect_new(0,0,0,0); 4]
    layout.box_layout(&st,
        layout.rect_new(24, y as i64, 1152, 32),
        (&pref[0]) as *mut i64, (&grow[0]) as *mut i64,
        (&cross[0]) as *mut i64,
        (&boxes[0]) as *mut layout.Rect, 4)

    var t_back: [u8; 1] = "<"
    var t_fwd: [u8; 1] = ">"
    var t_reload: [u8; 1] = "R"
    var t_addr: [u8; 21] = "https://en.wikipedia."
    var ai: usize = 0
    while ai < 4 {
        var kind: u32 = widget.KIND_BUTTON
        var tp: u64 = (&t_back[0]) as u64
        var tn: usize = 1
        if ai == 1 {
            tp = (&t_fwd[0]) as u64
        } else if ai == 2 {
            tp = (&t_reload[0]) as u64
        } else if ai == 3 {
            kind = widget.KIND_TEXTBOX
            tp = (&t_addr[0]) as u64
            tn = 21
        }
        var ea: widget.Widget = make_widget(kind,
            layout.rect_x(&boxes[ai]) as f64,
            layout.rect_y(&boxes[ai]) as f64,
            layout.rect_w(&boxes[ai]) as f64,
            layout.rect_h(&boxes[ai]) as f64, tp, tn)
        render.draw_widget(&c, &ea)
        ai = ai + 1
    }

    // ==================================================================
    // SECTION 5: THE GRID
    // ==================================================================
    y = y + ch + 34.0
    var t_r1: [u8; 40] = "GRID -- 6 x 2, gaps, exact sum          "
    heading(&c, 24.0, y, (&t_r1[0]) as u64, 38)
    y = y + 26.0

    var ra: layout.Grid = layout.grid_new(6, 2)
    layout.grid_set_gap(&ra, 10, 10)
    let rraum: layout.Rect =
        layout.rect_new(24, y as i64, 1152, 76)
    var t_z: [u8; 5] = "cell "
    var rz: usize = 0
    while rz < 2 {
        var rs: usize = 0
        while rs < 6 {
            var zk: layout.Rect =
                layout.grid_cell(&ra, rraum, rs, rz)
            var er: widget.Widget = make_widget(widget.KIND_TILE,
                layout.rect_x(&zk) as f64,
                layout.rect_y(&zk) as f64,
                layout.rect_w(&zk) as f64,
                layout.rect_h(&zk) as f64,
                (&t_z[0]) as u64, 5)
            // Every other tile in the accent -- so the cells can
            // really be counted.
            if (rs + rz) % 2 == 1 {
                let sr: *mut style.Style = widget.w_style(&er)
                *sr = style.style_set_bg(*sr,
                    style.color_token(style.TOK_SURFACE_RAISED))
            }
            render.draw_widget(&c, &er)
            rs = rs + 1
        }
        rz = rz + 1
    }

    // ==================================================================
    // SECTION 6: THE WINDOW BUTTONS FROM THE CORE
    // ==================================================================
    y = y + 76.0 + 34.0
    var t_f1: [u8; 49] = "WINDOW BUTTONS -- from the core, scaled 1x 2x 3x "
    heading(&c, 24.0, y, (&t_f1[0]) as u64, 48)
    y = y + 26.0

    // They are painted here through the core interface -- the same
    // source the OrientOS window manager links in under the kernel
    // profile. For that the canvas pixels are needed as a raw
    // buffer.
    // The canvas is 0xAARRGGBB, the core writes BGRX. Both store B,
    // G, R in the same order -- the core only sets the fourth octet
    // to 0 instead of 255. But for a PNG that reads the canvas as
    // opaque, the alpha has to stay; that is why the core paints into
    // its OWN buffer here, which is then transferred with the alpha
    // set. On a real window this falls away -- there the buffer IS
    // BGRX.
    let kbytes: usize = W * H * 4
    let kp: u64 = rt.heap_alloc(kbytes)
    if kp == 0 as u64 {
        return 8
    }
    rt.mem_set(kp, 0 as u8, kbytes)
    var zi: core.Target = core.target_new(kp, W, H, W * 4)
    var sk: usize = 1
    var kx: f64 = 24.0
    while sk <= 3 {
        let cap_w: usize = 30 * sk
        let d: usize = 10 * sk
        let sb: usize = sk
        let height: usize = 32 * sk
        // The surface: the same rounding as every button.
        var i2: usize = 0
        while i2 < 3 {
            let bx: f64 = kx + ((i2 * cap_w) as f64)
            painter.round_rect(&z, bx, y, cap_w as f64, height as f64, 0.0,
                (*f).surface)
            i2 = i2 + 1
        }
        let oy: usize = (y as usize) + (height - d) / 2
        let ox0: usize = (kx as usize) + (cap_w - d) / 2
        core.cap_minimize(&zi, ox0, oy, d, sb, (*f).text)
        core.cap_maximize(&zi, ox0 + cap_w, oy, d, sb, (*f).text)
        core.cap_close(&zi, ox0 + 2 * cap_w, oy, d, sb,
            (*f).text)
        kx = kx + ((3 * cap_w) as f64) + 24.0
        sk = sk + 1
    }

    // Put the core buffer onto the canvas: what the core has painted
    // wins. Recognisable by an octet not equal to zero -- the buffer
    // was zeroed beforehand.
    let cvp: u64 = canvas.canvas_pixels(&cv) as u64
    var pi: usize = 0
    while pi < W * H {
        let o: u64 = (pi * 4) as u64
        // ==============================================================
        // SWAP R AND B -- OTHERWISE THE GLYPH IS IN FALSE COLOURS
        // ==============================================================
        //
        // A BUG OF THIS ROUND, FOUND IN THE IMAGE. The first version
        // copied the four octets unchanged, and the PNG showed
        // 0xFEFBFB instead of 0xFBFBFE -- red and blue swapped. On an
        // almost white glyph you cannot see it; on a coloured one it
        // would have been obvious at once.
        //
        // The reason is the contract: lib/fenster/fenster.fi fixes BGRX
        // in F3 (B, G, R, X in memory), and the core abides by it.
        // lib/paint/canvas.fi stores R, G, B, A instead. On a real
        // window the swap falls away -- there `window.image` pushes a
        // BGRX buffer and the core painted straight into it. Only
        // THIS tool paints into a canvas.
        //
        // The same mix-up is documented as a warning in
        // lib/fenster/fenster.fi at `rgb_nach_bgrx`: "an early version
        // `to_bgrx` swapped R and B, and the window showed the page
        // in false colours."
        let b: u8 = *((kp + o) as *mut u8)
        let g: u8 = *((kp + o + 1 as u64) as *mut u8)
        let r: u8 = *((kp + o + 2 as u64) as *mut u8)
        if b != 0 as u8 || g != 0 as u8 || r != 0 as u8 {
            *((cvp + o) as *mut u8) = r
            *((cvp + o + 1 as u64) as *mut u8) = g
            *((cvp + o + 2 as u64) as *mut u8) = b
            *((cvp + o + 3 as u64) as *mut u8) = 255 as u8
        }
        pi = pi + 1
    }

    // ---- WRITING IT OUT
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&cv, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < rt.c_length(path) {
        rt.buf_push(&pf, rt.ld8(path, k))
        k = k + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 8] = "GALLERY\n"
    rt.write_everything(1, (&okm[0]) as u64, 8)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    return 0
}
