// tools/fui/preset_main.fi -- CHECK OF lib/fui/preset.fi + lib/fui/palette.fi + lib/plat/uifont.fi (no window).
//
//     FIRNLIB=$PWD/lib firnc -o /tmp/preset tools/fui/preset_main.fi && FIRNLIB=$PWD/lib /tmp/preset
import std.io
import font.metrics
import fui.palette
import fui.preset
import fui.theme
import plat.uifont

static mut BAD: usize = 0

fn expect(ok: bool, what: str) {
    if !ok {
        BAD = BAD + 1
        io.print_line(what)
    }
}

fn base_of(m: *mut theme.Theme) -> u32 {
    return (*theme.theme_colors(m)).base & 16777215 as u32
}

fn accent_of(m: *mut theme.Theme) -> u32 {
    return (*theme.theme_colors(m)).accent & 16777215 as u32
}

fn main() -> i32 {
    var m: theme.Theme = theme.theme_new(true)
    preset.launcher(&m, true)
    expect(base_of(&m) == 0x07090F as u32 && accent_of(&m) == 0x1BD96A as u32, "launcher dark")
    preset.studio(&m, true)
    expect(base_of(&m) == 0x0C0F1A as u32 && accent_of(&m) == 0x5B8CFF as u32, "studio dark")
    preset.studio(&m, false)
    expect(base_of(&m) == 0xF3F5FB as u32 && accent_of(&m) == 0x3D6DF0 as u32, "studio light")
    preset.messenger(&m, true)
    expect(base_of(&m) == 0x0B0E17 as u32 && accent_of(&m) == 0x3D6DF0 as u32, "messenger dark")
    preset.look(&m, palette.STUDIO, true, 0x3DDC84 as u32)
    expect(base_of(&m) == 0x0C0F1A as u32 && accent_of(&m) == 0x3DDC84 as u32, "look with accent")
    var k: usize = 0
    while k < palette.COUNT {
        let p: palette.Pal = palette.get(k, true)
        expect(palette.accent_of(k, true) != 0 as u32, "accent registered")
        expect(k == palette.LAUNCHER || p.base != 0 as u32, "dark set has a ground")
        k = k + 1
    }

    var fs: metrics.FontSet = metrics.fontset_new()
    if uifont.family_dir() {
        var w: usize = 0
        while w < uifont.FACE_COUNT {
            expect(uifont.load_face(w, &fs), "inter face loads")
            w = w + 1
        }
        expect(uifont.face_weight(0) == 400 && uifont.face_weight(3) == 700, "weights")
    } else {
        io.print_line("  (no Inter directory: skipped the face loads)")
    }
    var mono: metrics.FontSet = metrics.fontset_new()
    expect(uifont.load_mono(&mono), "mono face loads")

    if BAD == 0 { io.print_line("preset OK") }
    return BAD as i32
}
