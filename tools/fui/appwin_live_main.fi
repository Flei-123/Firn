import std.rt
import fui.app
import fui.appwin

static mut STEPS: i64 = 0
static mut MAIN_APP: u64 = 0
static mut CHILD_APP: u64 = 0

const OPEN_AT: i64 = 3
const QUIT_AT: i64 = 150
const TICK_MS: i64 = 40

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn close_child(a: *mut app.App) {
    appwin.close(a)
}

fn child_closed(a: *mut app.App) {
    say("child closed\n")
}

fn pump_fd(ud: u64) -> i32 {
    return 0 - 1
}

fn pump_ms(ud: u64, ms: i64) -> i64 {
    return TICK_MS
}

fn pump_step(ud: u64) -> bool {
    STEPS = STEPS + 1
    if STEPS == OPEN_AT {
        let c: *mut app.App = appwin.open("Live child", 300, 160)
        if c as u64 == 0 {
            say("child refused\n")
        } else {
            CHILD_APP = c as u64
            app.button(c, "Close", close_child)
            appwin.on_close(c, child_closed)
            say("child opened\n")
        }
    }
    if STEPS == QUIT_AT {
        say("main quit\n")
        app.quit(MAIN_APP as *mut app.App)
    }
    return true
}

fn main(start: u64) -> i32 {
    let a: *mut app.App = app.window("Live main", 360, 200)
    MAIN_APP = a as u64
    app.label(a, "I am the main window", 0)
    app.set_pump(a, 0, pump_fd, pump_ms, pump_step)
    return app.run(a)
}
