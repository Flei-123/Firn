// SPDX-License-Identifier: MPL-2.0
// tools/fui/qrview_main.fi -- THE CHECK OF lib/fui/qrview.fi (the QR code widget).
//
// The widget paints into a canvas; the pixels are read back and compared with
// the module matrix (every module centre must have the colour of its module,
// the quiet zone and the corners must be light, nothing outside the square may
// change), and then the PAINTED PICTURE is handed to the decoder of lib/qr:
// the widget's output must read back to the text that went in -- on the light
// and on the dark theme, with whole-pixel modules and with a square so small
// that the modules are fractional.
//
//     firnc -o /tmp/qrview tools/fui/qrview_main.fi && /tmp/qrview
import std.rt
import std.io
import paint.canvas
import fui.theme
import fui.painter
import fui.render
import fui.style
import fui.qrview
import qr.qr
import qr.qrdec
import plat.sysfont
import font.metrics

static mut BAD: usize = 0
static mut CHECKS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn checkp(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn check(ok: bool, what: io.Fmt) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    io.fmt_print_line(what)
}

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
    w: usize,
    h: usize,
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    (*p).w = w
    (*p).h = h
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn px(p: *mut Page, x: i64, y: i64) -> u32 {
    return canvas.canvas_get(&(*p).cv, x as usize, y as usize) & 16777215 as u32
}

// the canvas as gray octets (what a camera would give)
fn gray_of(p: *mut Page, out: u64) {
    var y: usize = 0
    while y < (*p).h {
        var x: usize = 0
        while x < (*p).w {
            let c: u32 = canvas.canvas_get(&(*p).cv, x, y)
            let r: u32 = (c >> 16) & 255 as u32
            let g: u32 = (c >> 8) & 255 as u32
            let b: u32 = c & 255 as u32
            rt.st8(out, y * (*p).w + x, ((r * 299 as u32 + g * 587 as u32 + b * 114 as u32) / 1000 as u32) as u8)
            x++
        }
        y++
    }
}

fn read_back(p: *mut Page, want: str) -> bool {
    let g: u64 = rt.heap_alloc((*p).w * (*p).h)
    gray_of(p, g)
    var r: qrdec.QrResult = qrdec.qrdec_result_new()
    let ok: bool = qrdec.qrdec_gray(g, (*p).w, (*p).h, &r) catch false
    var good: bool = ok && rt.buf_len(&r.payload) == want.n && rt.mem_eq(rt.buf_ptr(&r.payload), want.p as u64, want.n)
    qrdec.qrdec_result_free(&r)
    rt.heap_free(g, (*p).w * (*p).h)
    return good
}

fn run_page(p: *mut Page, q: *mut qr.QrCode, text: str, tag: str) {
    let base: u32 = 16764057 as u32 // a pale yellow ground, to see what is not painted
    canvas.canvas_clear(&(*p).cv, base | (255 as u32 << 24))
    let side: f64 = 300.0
    let quiet: i64 = 4
    let x0: f64 = 40.0
    let y0: f64 = 30.0
    qrview.qrview_draw(&(*p).c, q, x0, y0, side, quiet, qrview.BLACK, qrview.WHITE)
    let n: i64 = qr.qr_size(q) as i64
    let mpx: i64 = qrview.qrview_module_px(q, side, quiet)
    check(mpx >= 8, f"{tag}: {mpx} pixels per module")
    var geo: [f64; 4] = [0.0; 4]
    qrview.qrview_rect(q, x0, y0, side, quiet, &geo)
    let whole: i64 = mpx * (n + 2 * quiet)
    let ox: i64 = (x0 as i64) + (side as i64 - whole) / 2
    let oy: i64 = (y0 as i64) + (side as i64 - whole) / 2
    check((geo[0] as i64) == ox + mpx * quiet && (geo[2] as i64) == mpx * n, f"{tag}: qrview_rect names the symbol")
    // every module centre has its module's colour
    var wrong: i64 = 0
    var row: i64 = 0
    while row < n {
        var col: i64 = 0
        while col < n {
            let cx: i64 = ox + mpx * (col + quiet) + mpx / 2
            let cy: i64 = oy + mpx * (row + quiet) + mpx / 2
            var want: u32 = 16777215 as u32
            if qr.qr_dark(q, col, row) {
                want = 0 as u32
            }
            if px(p, cx, cy) != want {
                wrong = wrong + 1
            }
            // and the module's corners (whole pixels: no grey seams)
            if px(p, cx - mpx / 2, cy - mpx / 2) != want || px(p, cx + (mpx - 1) / 2, cy + (mpx - 1) / 2) != want {
                wrong = wrong + 1
            }
            col = col + 1
        }
        row = row + 1
    }
    check(wrong == 0, f"{tag}: every module has the colour of its module ({n * n} modules)")
    check(px(p, ox + 1, oy + 1) == 16777215 as u32 && px(p, ox + whole - 2, oy + whole - 2) == 16777215 as u32,
        f"{tag}: the quiet zone is light")
    check(px(p, ox - 2, oy + whole / 2) == base && px(p, ox + whole + 1, oy + whole / 2) == base
        && px(p, ox + whole / 2, oy - 2) == base, f"{tag}: nothing painted outside the square")
    check(read_back(p, text), f"{tag}: the painted picture reads back to the text")
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("qrview: no font (DejaVu Sans)\n")
        return 9
    }
    let text: str = "https://example.org/fui?login=7f3a9c"
    var q: qr.QrCode = qr.qr_new()
    qr.qr_encode_text(text, qr.QR_ECC_M, &q) catch false
    var d: usize = 0
    while d < 2 {
        var tag: str = "light"
        if d == 1 {
            tag = "dark"
        }
        let p: *mut Page = page_new(400, 400, d == 1, fs as u64)
        run_page(p, &q, text, tag)
        d = d + 1
    }
    // a square too small for whole pixels: fractional modules, no crash, the code
    // is still drawn (and still reads when each module has about 2.5 pixels)
    let p: *mut Page = page_new(300, 300, false, fs as u64)
    canvas.canvas_clear(&(*p).cv, 16777215 as u32 | (255 as u32 << 24))
    let small: f64 = qrview.qrview_min_side(&q, 4) * 2.5
    checkp(qrview.qrview_module_px(&q, small, 4) == 2, "a square of 2.5 pixels per module holds 2 whole pixels")
    qrview.qrview_draw(&(*p).c, &q, 10.0, 10.0, qrview.qrview_min_side(&q, 4) * 0.8, 4, qrview.BLACK, qrview.WHITE)
    checkp(true, "a square smaller than one pixel per module is drawn without a crash")
    canvas.canvas_clear(&(*p).cv, 16777215 as u32 | (255 as u32 << 24))
    qrview.qrview_draw(&(*p).c, &q, 10.0, 10.0, small, 4, qrview.BLACK, qrview.WHITE)
    checkp(read_back(p, text), "2 pixels per module still reads")

    checkp(qrview.qrview_contrast_ok(qrview.BLACK, qrview.WHITE), "black on white is a readable pair")
    checkp(!qrview.qrview_contrast_ok(qrview.WHITE, qrview.BLACK), "light modules on a dark ground is not")
    checkp(!qrview.qrview_contrast_ok(0xFF777777 as u32, 0xFF888888 as u32), "two greys are not")
    checkp(qrview.qrview_contrast_ok(0xFF1B5E20 as u32, 0xFFF1F8E9 as u32), "dark green on pale green is")
    var alt: [u8; 64] = [0 as u8; 64]
    let k: usize = qrview.qrview_alt(36, &alt)
    let want: str = "QR code, 36 characters"
    checkp(k == want.n && rt.mem_eq((&alt[0]) as u64, want.p as u64, k), "the accessible name")
    qr.qr_free(&q)

    say("checks: ")
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&nb, CHECKS as u64)
    rt.write_everything(1, rt.buf_ptr(&nb), rt.buf_len(&nb))
    rt.buf_free(&nb)
    say("\n")
    if BAD == 0 {
        say("QRVIEW PASSED\n")
        return 0
    }
    say("QRVIEW FAILED\n")
    return 1
}
