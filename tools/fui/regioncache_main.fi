import std.rt
import paint.canvas
import fui.theme
import fui.painter
import fui.render
import fui.kit
import fui.kitapp
import fui.kitcolor
import fui.regioncache
import fui.kitdata
import fui.kitplot
import fui.kitdash
import fui.kitfmt

static mut BAD: usize = 0
static mut CHECKS: usize = 0
static mut SEED: u64 = 12345

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
}

fn page_new(w: usize, h: usize) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(true)
    kitcolor.kit_theme(&(*p).m, true)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn next_rand() -> u32 {
    SEED = SEED *% 6364136223846793005 +% 1442695040888963407
    return ((SEED >> 33) & 255) as u32
}

fn noise(p: *mut Page, w: usize, h: usize, salt: u32) {
    SEED = 777 + salt as u64
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            let v: u32 = next_rand()
            canvas.canvas_set_raw(&(*p).cv, x, y, 4278190080 as u32 | (v << 16) | (((v * 7) & 255 as u32) << 8) | ((v * 13) & 255 as u32))
            x = x + 1
        }
        y = y + 1
    }
}

fn paint_kind(p: *mut Page, kind: usize, shift: f64) {
    let c: *mut render.Ctx = &(*p).c
    if kind == 0 {
        kit.soft_shadow(c, 90.0 + shift, 70.0, 180.0, 110.0, 12.0, 20.0, 6.0, 200 as u32)
    } else if kind == 1 {
        kit.soft_shadow_under(c, 90.0 + shift, 70.0, 180.0, 110.0, 12.0, 24.0, 8.0, 200 as u32)
    } else if kind == 2 {
        kit.glow_rect(c, 90.0 + shift, 70.0, 180.0, 110.0, 12.0, 0x1BD96A as u32, 16.0, 6.0, 90 as u32)
    } else {
        kitapp.card_r_t(c, 90.0 + shift, 70.0, 180.0, 110.0, 12.0, 0.0, 0 as u32)
    }
}

fn same_canvas(a: *mut Page, b: *mut Page, w: usize, h: usize) -> bool {
    return rt.mem_eq(canvas.canvas_pixels(&(*a).cv) as u64, canvas.canvas_pixels(&(*b).cv) as u64, w * h * 4)
}

fn outside_untouched(a: *mut Page, ref_page: *mut Page, w: usize, h: usize) -> bool {
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            let inside: bool = x + 70 >= 90 && x < 90 + 180 + 70 && y + 70 >= 70 && y < 70 + 110 + 70
            if !inside && canvas.canvas_get(&(*a).cv, x, y) != canvas.canvas_get(&(*ref_page).cv, x, y) {
                return false
            }
            x = x + 1
        }
        y = y + 1
    }
    return true
}

fn run_kind(kind: usize, name: str) {
    let w: usize = 400
    let h: usize = 300
    let a: *mut Page = page_new(w, h)
    let b: *mut Page = page_new(w, h)
    let bg: *mut Page = page_new(w, h)
    noise(bg, w, h, 1)

    regioncache.clear()
    noise(a, w, h, 1)
    paint_kind(a, kind, 0.0)
    check(regioncache.misses() > 0, name)
    check(outside_untouched(a, bg, w, h), "nothing outside the box is written")

    let hits0: u64 = regioncache.hits()
    noise(b, w, h, 1)
    paint_kind(b, kind, 0.0)
    check(regioncache.hits() == hits0 + 1, "same backdrop, same parameters: a hit")
    check(same_canvas(a, b, w, h), "the hit is octet for octet the fresh picture")

    noise(b, w, h, 2)
    let hits1: u64 = regioncache.hits()
    paint_kind(b, kind, 0.0)
    check(regioncache.hits() == hits1, "another backdrop: a miss")
    let c2: *mut Page = page_new(w, h)
    regioncache.clear()
    noise(c2, w, h, 2)
    paint_kind(c2, kind, 0.0)
    check(same_canvas(b, c2, w, h), "the miss equals a picture made without any kept one")

    noise(b, w, h, 2)
    canvas.canvas_set_raw(&(*b).cv, 150, 100, 4294967295 as u32)
    let hits2: u64 = regioncache.hits()
    paint_kind(b, kind, 0.0)
    check(regioncache.hits() == hits2, "one pixel of the backdrop differs: a miss")
    let c3: *mut Page = page_new(w, h)
    regioncache.clear()
    noise(c3, w, h, 2)
    canvas.canvas_set_raw(&(*c3).cv, 150, 100, 4294967295 as u32)
    paint_kind(c3, kind, 0.0)
    check(same_canvas(b, c3, w, h), "that miss equals the fresh picture")

    noise(b, w, h, 2)
    let hits3: u64 = regioncache.hits()
    paint_kind(b, kind, 0.5)
    check(regioncache.hits() == hits3, "another position: a miss")
    let c4: *mut Page = page_new(w, h)
    regioncache.clear()
    noise(c4, w, h, 2)
    paint_kind(c4, kind, 0.5)
    check(same_canvas(b, c4, w, h), "the moved picture equals the fresh one")
}

fn paint_area(p: *mut Page, d: *mut kitdata.Doc, first: usize, cnt: usize, px: f64, py: f64) {
    let list: u32 = kitdata.get(d, kitdata.root(d), "line_90d")
    let s: kitplot.Ser = kitplot.ser_fmt(kitplot.ser(d, list, "value", "date"), "EUR ", "", 0)
    kitplot.area_draw(&(*p).c, 40.0, 60.0, 300.0, 160.0, s, first, cnt, 0x4C8DFF as u32, px, py)
}

fn run_area() {
    let w: usize = 400
    let h: usize = 300
    let d: *mut kitdata.Doc = kitdata.load("metrics.json")
    check(d != 0 as u64 as *mut kitdata.Doc, "metrics data loaded")
    let a: *mut Page = page_new(w, h)
    let b: *mut Page = page_new(w, h)
    let f: *mut Page = page_new(w, h)

    regioncache.clear()
    noise(a, w, h, 1)
    let m0: u64 = regioncache.misses()
    paint_area(a, d, 60, 30, 0.0 - 1.0, 0.0 - 1.0)
    check(regioncache.misses() == m0 + 1, "area chart: a miss on the first draw")

    noise(b, w, h, 1)
    let h0: u64 = regioncache.hits()
    paint_area(b, d, 60, 30, 0.0 - 1.0, 0.0 - 1.0)
    check(regioncache.hits() == h0 + 1, "area chart: same data and backdrop: a hit")
    check(same_canvas(a, b, w, h), "area chart: the hit is octet for octet the fresh picture")

    noise(b, w, h, 1)
    let h1: u64 = regioncache.hits()
    paint_area(b, d, 60, 30, 150.0, 120.0)
    check(regioncache.hits() == h1 + 1, "area chart: hovering still hits")
    regioncache.clear()
    noise(f, w, h, 1)
    paint_area(f, d, 60, 30, 150.0, 120.0)
    check(same_canvas(b, f, w, h), "area chart: the hovered hit equals a fresh hovered picture")

    noise(b, w, h, 1)
    let h2: u64 = regioncache.hits()
    paint_area(b, d, 61, 29, 0.0 - 1.0, 0.0 - 1.0)
    check(regioncache.hits() == h2, "area chart: another data window: a miss")
    regioncache.clear()
    noise(f, w, h, 1)
    paint_area(f, d, 61, 29, 0.0 - 1.0, 0.0 - 1.0)
    check(same_canvas(b, f, w, h), "area chart: that miss equals the fresh picture")

    noise(b, w, h, 2)
    let h3: u64 = regioncache.hits()
    paint_area(b, d, 61, 29, 0.0 - 1.0, 0.0 - 1.0)
    check(regioncache.hits() == h3, "area chart: another backdrop: a miss")
}

fn unit_count(d: *mut kitdata.Doc, which: usize) -> u64 {
    if which == 2 { return kitdata.count(d, kitdata.get(d, kitdata.root(d), "kpis")) as u64 }
    if which == 3 || which == 4 { return 2 }
    return 1
}

fn paint_unit(p: *mut Page, d: *mut kitdata.Doc, sg: *mut kitdash.Seg, which: usize, variant: usize, w: f64, h: f64) {
    let c: *mut render.Ctx = &(*p).c
    let pg: kitdash.Page = kitdash.page(c, w, h, kit.ln(c, 42), kit.ln(c, 101), 1.0, 1.05, 0.0)
    (*sg).on = variant
    if which == 0 {
        var title: str = "Revenue"
        if variant == 1 { title = "Revenues" }
        kitdash.card_body(c, pg.rev.x, pg.rev.y, pg.rev.w, pg.rev.h, title)
    }
    if which == 1 {
        let bars: kitplot.Ser = kitplot.ser(d, kitdata.get(d, kitdata.root(d), "bars_12"), "value", "label")
        var hx: f64 = 0.0 - 1.0
        if variant == 1 { hx = pg.ord.x + 20.0 }
        kitplot.bars_draw(c, pg.ord.x, pg.ord.y, pg.ord.w, pg.ord.h, bars, 0x4C8DFF as u32, hx, pg.ord.y + 20.0)
    }
    if which == 2 {
        var kw: f64 = w
        if variant == 1 { kw = w - 40.0 }
        kitdash.kpi_row(c, d, kitdata.get(d, kitdata.root(d), "kpis"), pg, kw)
    }
    if which == 3 {
        var from: usize = 11
        if variant == 1 { from = 5 }
        kitdash.table_card(c, pg.evt.x, pg.evt.y, pg.evt.w, pg.evt.h, "Recent events", d, kitdata.get(d, kitdata.root(d), "events"), "ts", from, 5, "text")
    }
    if which == 4 {
        var sub: str = "Overview"
        if variant == 1 { sub = "Overview 2" }
        kitdash.head_draw(c, sg, d, kitdata.get(d, kitdata.root(d), "ranges"), pg, w, "Dashboard", sub)
    }
    if which == 5 {
        var prefix: str = ""
        if variant == 1 { prefix = "$" }
        kitplot.donut_legend_draw(c, pg.src.x, pg.src.y, pg.src.w, pg.src.h, kitplot.ser_fmt(kitplot.ser(d, kitdata.get(d, kitdata.root(d), "donut"), "share", "label"), prefix, "%", 0), 130.0)
    }
}

fn run_unit(which: usize, name: str) {
    let w: usize = 1100
    let h: usize = 700
    let d: *mut kitdata.Doc = kitdata.load("metrics.json")
    let a: *mut Page = page_new(w, h)
    let b: *mut Page = page_new(w, h)
    let f: *mut Page = page_new(w, h)
    var sg: kitdash.Seg = kitdash.seg_new()
    let n: u64 = unit_count(d, which)
    let wf: f64 = w as f64
    let hf: f64 = h as f64

    regioncache.clear()
    noise(a, w, h, 1)
    let m0: u64 = regioncache.misses()
    paint_unit(a, d, &sg, which, 0, wf, hf)
    check(regioncache.misses() >= m0 + n, kitfmt.join(name, ": first draw misses"))

    noise(b, w, h, 1)
    let h0: u64 = regioncache.hits()
    paint_unit(b, d, &sg, which, 0, wf, hf)
    check(regioncache.hits() == h0 + n, kitfmt.join(name, ": same content and backdrop: all hits"))
    check(same_canvas(a, b, w, h), kitfmt.join(name, ": the hit is octet for octet the fresh picture"))

    noise(b, w, h, 1)
    let h1: u64 = regioncache.hits()
    paint_unit(b, d, &sg, which, 1, wf, hf)
    check(regioncache.hits() < h1 + n, kitfmt.join(name, ": changed content: at least one miss"))
    regioncache.clear()
    noise(f, w, h, 1)
    paint_unit(f, d, &sg, which, 1, wf, hf)
    check(same_canvas(b, f, w, h), kitfmt.join(name, ": that result equals the fresh picture"))

    noise(b, w, h, 2)
    let h2: u64 = regioncache.hits()
    paint_unit(b, d, &sg, which, 1, wf, hf)
    check(regioncache.hits() < h2 + n, kitfmt.join(name, ": another backdrop: at least one miss"))
}

fn main() -> i32 {
    run_kind(0, "soft_shadow")
    run_kind(1, "soft_shadow_under")
    run_kind(2, "glow_rect")
    run_kind(3, "card_r_t")
    run_area()
    run_unit(0, "card_body")
    run_unit(1, "bars")
    run_unit(2, "kpi_row")
    run_unit(3, "table_card")
    run_unit(4, "head")
    run_unit(5, "donut_legend")
    if BAD == 0 {
        say("REGIONCACHE PASSED\n")
        return 0
    }
    say("REGIONCACHE FAILED\n")
    return 1
}
