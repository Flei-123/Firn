import std.rt
import paint.canvas
import font.metrics
import fui.app
import fui.combofilter
import fui.editor
import fui.kit
import fui.kitcolor
import fui.painter
import fui.screenax
import fui.render
import fui.style
import fui.theme
import fui.ds_combo
import fui.ds_fbtok
import fui.ds_infobar
import fui.ds_swatch
import fui.ds_toast
import plat.sysfont

static mut BAD: usize = 0

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }

fn check(ok: bool, what: str) {
    if ok { say("  ok    ") } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    kitcolor.kit_theme(&(*p).m, dark)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) { return 0 as u64 as *mut Page }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn clear(p: *mut Page) { canvas.canvas_clear(&(*p).cv, 0xff202020 as u32) }

fn painted(p: *mut Page, x: usize, y: usize, w: usize, h: usize) -> usize {
    var n: usize = 0
    var j: usize = y
    while j < y + h {
        var i: usize = x
        while i < x + w {
            if canvas.canvas_get(&(*p).cv, i, j) != 0xff202020 as u32 { n = n + 1 }
            i = i + 1
        }
        j = j + 1
    }
    return n
}

fn infobar_checks(p: *mut Page) {
    say("== infobar\n")
    let c: *mut render.Ctx = &(*p).c
    let b: *mut ds_infobar.Bar = ds_infobar.bar_new()
    clear(p)
    let h: f64 = ds_infobar.draw(b, c, 20.0, 20.0, 600.0, ds_fbtok.WARNING, "Low disk space", "Free 2 GB.", "Clean up", true, 0.0 - 1.0, 0.0 - 1.0)
    check(h >= 44.0 && painted(p, 20, 20, 600, 44) > 2000, "infobar paints with a height >= 44")
    var ar: [f64; 4] = [0.0; 4]
    var cr: [f64; 4] = [0.0; 4]
    ds_infobar.action_rect(b, &ar)
    ds_infobar.close_rect(b, &cr)
    check(ar[2] > 0.0 && cr[2] > 0.0 && ar[0] + ar[2] < cr[0] + 1.0, "action sits left of close")
    let narrow_h: f64 = ds_infobar.draw(b, c, 20.0, 20.0, 260.0, ds_fbtok.ERROR, "Upload failed", "The server did not answer after three tries, check the network.", "Retry", true, 0.0 - 1.0, 0.0 - 1.0)
    check(narrow_h > h + 15.0, "long text wraps to a taller bar")
    ds_infobar.draw(b, c, 20.0, 20.0, 600.0, ds_fbtok.INFO, "Update", "Ready.", "Restart", true, 0.0 - 1.0, 0.0 - 1.0)
    ds_infobar.action_rect(b, &ar)
    ds_infobar.close_rect(b, &cr)
    check(ds_infobar.press(b, ar[0] + 3.0, ar[1] + 3.0) == ds_infobar.EV_ACTION && ds_infobar.action_count(b) == 1, "click action fires")
    check(ds_infobar.press(b, 1.0, 1.0) == ds_infobar.EV_NONE, "click outside does nothing")
    check(ds_infobar.key(b, editor.KEY_TAB, 0 as u32) == ds_infobar.EV_FOCUS && ds_infobar.focused(b) == ds_infobar.FOCUS_ACTION, "Tab focuses action")
    check(ds_infobar.key(b, editor.KEY_RIGHT, 0 as u32) == ds_infobar.EV_FOCUS && ds_infobar.focused(b) == ds_infobar.FOCUS_CLOSE, "Right moves to close")
    check(ds_infobar.key(b, editor.KEY_TAB, 0 as u32) == ds_infobar.EV_NONE && ds_infobar.focused(b) == ds_infobar.FOCUS_NONE, "Tab leaves the bar")
    ds_infobar.set_focus(b, ds_infobar.FOCUS_ACTION)
    check(ds_infobar.text(b, 32 as u32, 0 as u32) == ds_infobar.EV_ACTION && ds_infobar.action_count(b) == 2, "Space fires the focused action")
    check(ds_infobar.press(b, cr[0] + 3.0, cr[1] + 3.0) == ds_infobar.EV_CLOSE && !ds_infobar.is_open(b), "click close closes")
    check(ds_infobar.draw(b, c, 20.0, 20.0, 600.0, ds_fbtok.INFO, "x", "y", "", true, 0.0, 0.0) == 0.0, "closed bar takes no space")
    ds_infobar.set_open(b, true)
    ds_infobar.draw(b, c, 20.0, 20.0, 600.0, ds_fbtok.INFO, "x", "y", "", true, 0.0, 0.0)
    ds_infobar.set_focus(b, ds_infobar.FOCUS_CLOSE)
    check(ds_infobar.key(b, editor.KEY_ESC, 0 as u32) == ds_infobar.EV_CLOSE && !ds_infobar.is_open(b), "Esc closes the bar")
}

fn toast_checks(p: *mut Page) {
    say("== toast\n")
    let c: *mut render.Ctx = &(*p).c
    let f: *mut ds_toast.Feed = ds_toast.feed_new()
    app.set_clock_us(1000000)
    var now: i64 = ds_toast.ms_of_us(app.mono_us())
    check(now == 1000, "virtual clock feeds the toast clock")
    let a: u32 = ds_toast.push(f, ds_fbtok.INFO, "Saved", "Profile stored", "Undo", now, ds_toast.DUR_AUTO)
    let e: u32 = ds_toast.push(f, ds_fbtok.ERROR, "Failed", "Disk full", "", now, ds_toast.DUR_AUTO)
    check(ds_toast.count(f) == 2 && ds_toast.state_of(f, a) == ds_toast.SHOWING, "two toasts stacked")
    check(ds_toast.live_rev(f) == 2 && ds_toast.live_urgent(f), "live region announces the error as urgent")
    clear(p)
    ds_toast.draw(f, c, 800.0, 600.0, now + 300)
    check(painted(p, 400, 440, 400, 160) > 3000, "stack paints bottom right")
    app.set_clock_us(5200000)
    now = ds_toast.ms_of_us(app.mono_us())
    ds_toast.tick(f, now, 0 as u32)
    check(ds_toast.state_of(f, a) == ds_toast.CLOSING && ds_toast.state_of(f, e) == ds_toast.SHOWING, "info auto-dismisses after 4 s, error stays")
    app.set_clock_us(5500000)
    ds_toast.tick(f, ds_toast.ms_of_us(app.mono_us()), 0 as u32)
    check(ds_toast.state_of(f, a) == ds_toast.GONE, "faded toast is gone")
    let h: u32 = ds_toast.push(f, ds_fbtok.SUCCESS, "Copied", "", "", 6000, ds_toast.DUR_AUTO)
    ds_toast.tick(f, 6000, h)
    ds_toast.tick(f, 9000, h)
    ds_toast.tick(f, 12000, h)
    check(ds_toast.state_of(f, h) == ds_toast.SHOWING, "hover pauses the timer")
    ds_toast.tick(f, 15900, 0 as u32)
    check(ds_toast.state_of(f, h) == ds_toast.SHOWING, "still showing before the extended deadline")
    ds_toast.tick(f, 16600, 0 as u32)
    check(ds_toast.state_of(f, h) == ds_toast.CLOSING, "timer resumes after hover")
    check(ds_toast.key(f, editor.KEY_TAB, 0 as u32, 16600) == ds_toast.EV_FOCUS && ds_toast.focused_id(f) != 0 as u32, "Tab focuses a toast button")
    var guard: usize = 0
    while ds_toast.focused_id(f) != e && guard < 6 {
        ds_toast.key(f, editor.KEY_TAB, 0 as u32, 16600)
        guard = guard + 1
    }
    check(ds_toast.key(f, editor.KEY_ESC, 0 as u32, 16600) == ds_toast.EV_CLOSE && ds_toast.last_id(f) == e && ds_toast.state_of(f, e) == ds_toast.CLOSING, "Esc dismisses the focused toast")
    ds_toast.push(f, ds_fbtok.INFO, "Sent", "", "Open", 20000, 4000)
    clear(p)
    ds_toast.draw(f, c, 800.0, 600.0, 20300)
    var x: f64 = 0.0
    var y: f64 = 0.0
    var w: f64 = 0.0
    var hh: f64 = 0.0
    var slot: usize = 0
    var found: bool = false
    while slot < kit.TOAST_MAX && !found {
        if (*f).q.t[slot].alive && (*f).q.t[slot].closing == 0 { found = kit.toasts_geometry(c, &(*f).q, 800.0, 600.0, slot, &x, &y, &w, &hh) }
        slot = slot + 1
    }
    check(found, "geometry of the live toast")
    check(ds_toast.press(f, c, 800.0, 600.0, 5.0, 5.0, 20000) == ds_toast.EV_NONE, "click elsewhere is no toast event")
    check(ds_toast.press(f, c, 800.0, 600.0, x + w - 22.0, y + hh / 2.0, 20300) == ds_toast.EV_CLOSE, "click on the cross closes")
    app.set_clock_us(0 - 1)
}

fn live_checks(p: *mut Page) {
    say("== live region + toast title\n")
    let c: *mut render.Ctx = &(*p).c
    screenax.install()
    let base: u64 = screenax.ann_seq()
    let b: *mut ds_infobar.Bar = ds_infobar.bar_new()
    clear(p)
    ds_infobar.draw(b, c, 20.0, 20.0, 600.0, ds_fbtok.WARNING, "Low disk space", "Free 2 GB.", "", true, 0.0 - 1.0, 0.0 - 1.0)
    ds_infobar.draw(b, c, 20.0, 20.0, 600.0, ds_fbtok.WARNING, "Low disk space", "Free 2 GB.", "", true, 0.0 - 1.0, 0.0 - 1.0)
    check(screenax.ann_seq() == base, "an infobar that is there from the start is not announced")
    ds_infobar.draw(b, c, 20.0, 20.0, 600.0, ds_fbtok.WARNING, "Low disk space", "Free 1 GB.", "", true, 0.0 - 1.0, 0.0 - 1.0)
    check(screenax.ann_seq() == base + 1, "a changed message is announced once")
    var out: [u8; 160] = [0 as u8; 160]
    var mode: u32 = 0 as u32
    let n: usize = screenax.ann_get(base + 1, (&out[0]) as u64, 160, &mode)
    check(n == 35 && mode == 2 as u32, "warning text is announced assertively")
    ds_infobar.set_open(b, false)
    ds_infobar.draw(b, c, 20.0, 20.0, 600.0, ds_fbtok.WARNING, "Low disk space", "Free 1 GB.", "", true, 0.0 - 1.0, 0.0 - 1.0)
    check(screenax.ann_seq() == base + 1, "a closed infobar says nothing")
    ds_infobar.set_open(b, true)
    ds_infobar.draw(b, c, 20.0, 20.0, 600.0, ds_fbtok.INFO, "Update", "Ready.", "", true, 0.0 - 1.0, 0.0 - 1.0)
    check(screenax.ann_seq() == base + 2, "reopening announces again")
    let n2: usize = screenax.ann_get(base + 2, (&out[0]) as u64, 160, &mode)
    check(n2 > 0 && mode == 1 as u32, "information is announced politely")

    let f: *mut ds_toast.Feed = ds_toast.feed_new()
    ds_toast.push(f, ds_fbtok.INFO, "Saved", "Profile stored", "Undo", 1000, 60000)
    check(screenax.ann_seq() == base + 3, "a toast announces on push")
    ds_toast.push(f, ds_fbtok.SUCCESS, "Copied", "", "", 1000, 60000)
    var x: f64 = 0.0
    var y: f64 = 0.0
    var w: f64 = 0.0
    var h1: f64 = 0.0
    var h2: f64 = 0.0
    check(kit.toasts_geometry(c, &(*f).q, 800.0, 600.0, 0, &x, &y, &w, &h1) && kit.toasts_geometry(c, &(*f).q, 800.0, 600.0, 1, &x, &y, &w, &h2), "both toasts have geometry")
    check(h1 > h2 && h1 == kit.ln(c, 64) && h2 == kit.ln(c, 48), "title + text toast is two lines tall, title only stays one line")
    clear(p)
    ds_toast.draw(f, c, 800.0, 600.0, 1400)
    check(painted(p, 400, 400, 400, 200) > 3000, "titled stack paints")
}

fn swatch_checks(p: *mut Page) {
    say("== swatch\n")
    let c: *mut render.Ctx = &(*p).c
    let s: *mut ds_swatch.Swatch = ds_swatch.swatch_new()
    ds_swatch.set_custom(s, true)
    clear(p)
    let h: f64 = ds_swatch.draw(s, c, 20.0, 20.0, 400.0, "Accent", 0.0 - 1.0, 0.0 - 1.0)
    check(h > 32.0 && painted(p, 20, 20, 400, 80) > 3000, "grid paints")
    check(ds_swatch.columns(s) == 10 && ds_swatch.count(s) == 33, "400 px = 10 columns, 32 swatches + custom")
    var r: [f64; 4] = [0.0; 4]
    ds_swatch.cell_rect(s, 11, &r)
    check(ds_swatch.press(s, r[0] + 4.0, r[1] + 4.0) == 11 && ds_swatch.selected(s) == 11, "click selects")
    check(ds_swatch.rgb(s) == 0xca5010 as u32 || ds_swatch.rgb(s) == 0xc30052 as u32, "rgb of the selected swatch")
    ds_swatch.draw(s, c, 20.0, 20.0, 400.0, "Accent", r[0] + 4.0, r[1] + 4.0)
    check(ds_swatch.press(s, 2.0, 2.0) == ds_swatch.NONE && ds_swatch.selected(s) == 11, "miss keeps selection")
    check(ds_swatch.key(s, editor.KEY_TAB, 0 as u32) && ds_swatch.foc(s) == 11, "Tab enters at the selection")
    ds_swatch.key(s, editor.KEY_RIGHT, 0 as u32)
    check(ds_swatch.selected(s) == 12, "Right selects the next")
    ds_swatch.key(s, editor.KEY_DOWN, 0 as u32)
    check(ds_swatch.selected(s) == 22, "Down moves one row")
    ds_swatch.key(s, editor.KEY_HOME, 0 as u32)
    check(ds_swatch.selected(s) == 0, "Home selects the first")
    ds_swatch.key(s, editor.KEY_LEFT, 0 as u32)
    check(ds_swatch.selected(s) == 0, "Left stops at the start")
    check(!ds_swatch.key(s, editor.KEY_TAB, 0 as u32) && ds_swatch.foc(s) == ds_swatch.NONE, "Tab leaves the grid")
    ds_swatch.cell_rect(s, 32, &r)
    check(ds_swatch.press(s, r[0] + 4.0, r[1] + 4.0) == 32 && ds_swatch.editing(s), "custom cell opens the hex field")
    ds_swatch.draw(s, c, 20.0, 20.0, 400.0, "Accent", 0.0 - 1.0, 0.0 - 1.0)
    ds_swatch.text(s, 35 as u32, 0 as u32)
    ds_swatch.text(s, 49 as u32, 0 as u32)
    check(!ds_swatch.key(s, editor.KEY_ENTER, 0 as u32) || ds_swatch.selected(s) == 0, "invalid hex is not applied")
    var k: usize = 0
    while k < 5 {
        ds_swatch.text(s, 97 as u32, 0 as u32)
        k = k + 1
    }
    check(ds_swatch.key(s, editor.KEY_ENTER, 0 as u32) && ds_swatch.selected(s) == 32 && ds_swatch.rgb(s) == 0x1aaaaa as u32, "valid hex becomes the custom colour")
    ds_swatch.set_rgb(s, 0x0078d4 as u32)
    check(ds_swatch.selected(s) == 16, "set_rgb finds a palette entry")
    check(kitcolor.parse_hex("#0078D4") == 0x0078d4 && kitcolor.parse_hex("fa0") == 0xffaa00 && kitcolor.parse_hex("12345") < 0 && kitcolor.parse_hex("#gggggg") < 0, "parse_hex")
}

fn combo_checks(p: *mut Page) {
    say("== combo\n")
    let c: *mut render.Ctx = &(*p).c
    let cb: *mut ds_combo.Combo = ds_combo.combo_new()
    ds_combo.set_items(cb, "Apple|Apricot|Banana|Blueberry|Cherry|Grape|Lemon|Mango|Orange|Peach|Pear|Plum")
    check(ds_combo.item_count(cb) == 12 && ds_combo.item_label(cb, 2).n == 6, "items split")
    clear(p)
    ds_combo.draw(cb, c, 40.0, 40.0, 260.0, "Fruit", "Search", 0.0 - 1.0, 0.0 - 1.0, 400.0)
    check(painted(p, 40, 40, 260, 38) > 500, "field paints")
    check(ds_combo.press(cb, 60.0, 55.0) && ds_combo.is_open(cb) && ds_combo.result_count(cb) == 12, "click opens the full list")
    ds_combo.end(cb, c)
    check(ds_combo.visible_rows(cb) == 8 && painted(p, 40, 90, 260, 280) > 5000, "popup shows 8 rows")
    ds_combo.text(cb, 112 as u32, 0 as u32)
    check(ds_combo.result_count(cb) == 6 && ds_combo.is_open(cb), "typing p filters")
    check(ds_combo.result_item(cb, 0) == 9 || ds_combo.result_item(cb, 0) == 10, "ranked: prefix first")
    ds_combo.text(cb, 108 as u32, 0 as u32)
    check(ds_combo.result_count(cb) >= 1 && ds_combo.item_label(cb, ds_combo.result_item(cb, 0)).n == 4, "pl matches Plum first")
    check(ds_combo.announce_rev(cb) >= 2, "result count announced")
    ds_combo.key(cb, editor.KEY_DOWN, 0 as u32)
    check(ds_combo.active_row(cb) == 0, "Down enters row 0")
    check(ds_combo.key(cb, editor.KEY_ENTER, 0 as u32) && ds_combo.value(cb) == 11 && !ds_combo.is_open(cb), "Enter picks Plum")
    check(ds_combo.text_of(cb).n == 4, "field shows the label")
    ds_combo.key(cb, editor.KEY_DOWN, 0 as u32)
    check(ds_combo.is_open(cb) && ds_combo.result_count(cb) == 12 && ds_combo.active_row(cb) == 11, "reopen shows all, active on the value")
    check(ds_combo.key(cb, editor.KEY_ESC, 0 as u32) && !ds_combo.is_open(cb), "Esc closes")
    ds_combo.key(cb, editor.KEY_UP, 0 as u32)
    ds_combo.draw(cb, c, 40.0, 40.0, 260.0, "Fruit", "Search", 0.0 - 1.0, 0.0 - 1.0, 400.0)
    ds_combo.end(cb, c)
    var q: [f64; 4] = [0.0; 4]
    ds_combo.row_rect(cb, c, 1, &q)
    let at: i64 = ds_combo.top_row(cb)
    check(ds_combo.press(cb, q[0] + 5.0, q[1] + 5.0) && ds_combo.value(cb) == at + 1 && !ds_combo.is_open(cb), "click on a row picks it")
    ds_combo.set_items(cb, "A|B|C|D|E|F|G|H|I|J|K|L|M|N|O|P")
    ds_combo.place(cb, 40.0, 320.0, 260.0, 38.0, 400.0)
    ds_combo.focus(cb, true)
    ds_combo.open_list(cb)
    ds_combo.layout(cb, c)
    check(ds_combo.flipped(cb) && ds_combo.visible_rows(cb) >= 1, "popup flips above near the window bottom")
    ds_combo.key(cb, editor.KEY_END, 0 as u32)
    check(ds_combo.active_row(cb) == 15 && ds_combo.top_row(cb) == 16 - ds_combo.visible_rows(cb), "End scrolls to the last row")
    ds_combo.text(cb, 122 as u32, 0 as u32)
    check(ds_combo.result_count(cb) == 0 && !ds_combo.is_open(cb), "no match closes the list")
    check(ds_combo.announce_text(cb).n == 10, "announces No results")
}

fn main() -> i32 {
    var fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("no system font\n")
        return 2
    }
    let p: *mut Page = page_new(900, 650, true, fs as u64)
    infobar_checks(p)
    toast_checks(p)
    live_checks(p)
    swatch_checks(p)
    combo_checks(p)
    if BAD == 0 {
        say("DS_FEEDBACK PASSED\n")
        return 0
    }
    say("DS_FEEDBACK FAILED\n")
    return 1
}
