import std.rt
import std.fs
import fui.safeout
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.style
import fui.kitview
import fui.kitplayer
import fui.kpplayer
import fui.kpmodel
import fui.kplayout
import plat.sysfont

static mut BAD: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    theme.theme_set_accent(&(*p).m, 0x1BD96A as u32)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn tok(p: *mut Page, t: u32) -> u32 {
    return theme.opaque(render.color_of(&(*p).c, style.color_token(t)))
}

fn px(p: *mut Page, x: f64, y: f64) -> u32 {
    return canvas.canvas_get(&(*p).cv, x as usize, y as usize)
}

fn count_col(p: *mut Page, rc: *mut kplayout.Rect, col: u32) -> usize {
    var n: usize = 0
    var y: f64 = (*rc).y
    while y < (*rc).y + (*rc).h {
        var x: f64 = (*rc).x
        while x < (*rc).x + (*rc).w {
            if px(p, x, y) == col {
                n = n + 1
            }
            x = x + 1.0
        }
        y = y + 1.0
    }
    return n
}

fn put16(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, (v & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 8) & 255 as u32) as u8)
}

fn put32(b: *mut rt.Buf, v: u32) {
    put16(b, v & 65535 as u32)
    put16(b, v >> 16)
}

fn tag(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, 4)
}

fn make_wav(b: *mut rt.Buf, frames: u32) {
    tag(b, "RIFF")
    put32(b, 36 as u32 + frames * 4 as u32)
    tag(b, "WAVE")
    tag(b, "fmt ")
    put32(b, 16 as u32)
    put16(b, 1 as u32)
    put16(b, 2 as u32)
    put32(b, 8000 as u32)
    put32(b, 32000 as u32)
    put16(b, 4 as u32)
    put16(b, 16 as u32)
    tag(b, "data")
    put32(b, frames * 4 as u32)
    var i: u32 = 0 as u32
    while i < frames {
        put16(b, (i * 7 as u32) & 32767 as u32)
        put16(b, (i * 5 as u32) & 32767 as u32)
        i = i + 1 as u32
    }
}

fn run_audio(dir: u64, font: u64, dark: bool, w: usize, h: usize, name: str, png_name: str) {
    say(name)
    say("\n")
    var wav: rt.Buf = rt.buf_new()
    make_wav(&wav, 240000 as u32)
    var v: kitview.View = kitview.view_new()
    kitview.view_open(&v, rt.buf_ptr(&wav), rt.buf_len(&wav), "Morning tone.wav")
    let pv: *mut kitplayer.PlayerView = kitview.view_media(&v)
    kpplayer.pl_set_discard(kitplayer.pv_player(pv), true)
    let p: *mut Page = page_new(w, h, dark, font)
    canvas.canvas_clear(&(*p).cv, tok(p, style.TOK_BASE))
    kitview.view_draw(&(*p).c, &v, 0.0, 0.0, w as f64, h as f64)
    let l: *mut kplayout.Layout = kitplayer.pv_layout_ptr(pv)
    let accent: u32 = tok(p, style.TOK_ACCENT)
    let ink: u32 = tok(p, style.TOK_TEXT)
    check(count_col(p, &(*l).surface, accent) > 2000, "the play disc is painted in the accent colour")
    check(count_col(p, &(*l).surface, ink) > 80, "the file name is painted in the text colour")
    check(count_col(p, &(*l).play, ink) > 12, "the play icon is painted in the text colour")
    check(count_col(p, &(*l).cur, tok(p, style.TOK_SURFACE)) + 40 < ((*l).cur.w * (*l).cur.h) as usize, "the time text is painted on the bar")
    check(count_col(p, &(*l).bar, tok(p, style.TOK_SURFACE)) > 1000, "the bar ground is the surface token")
    check(px(p, (*l).bar.x + 4.0, (*l).bar.y - 4.0) == tok(p, style.TOK_BASE), "above the bar is the base ground")
    check(kplayout.lay_hit(l, (*l).play.x + 5.0, (*l).play.y + 5.0) == kplayout.HIT_PLAY, "the play button is hit")
    save(&(*p).cv, dir, png_name)
    kitview.view_press(&v, (*l).play.x + 5.0, (*l).play.y + 5.0)
    kitview.view_press(&v, (*l).seek.x + (*l).seek.w * 0.4, (*l).seek.y + (*l).seek.h / 2.0)
    kitview.view_release(&v, (*l).seek.x + (*l).seek.w * 0.4, (*l).seek.y + (*l).seek.h / 2.0)
    canvas.canvas_clear(&(*p).cv, tok(p, style.TOK_BASE))
    kitview.view_draw(&(*p).c, &v, 0.0, 0.0, w as f64, h as f64)
    check(count_col(p, &(*l).seek, accent) > 100, "the seek bar shows progress in the accent colour")
    kitview.view_free(&v)
    rt.buf_free(&wav)
}

fn run_video(dir: u64, font: u64, dark: bool, w: usize, h: usize, name: str, png_name: str) {
    say(name)
    say("\n")
    var b: rt.Buf = rt.buf_new()
    let got: usize = fs.read_file("testdata/media_video/av_main.mp4", &b) catch | e | (0 -% 1)
    check(got != (0 -% 1), "the sample video was read")
    var v: kitview.View = kitview.view_new()
    kitview.view_open(&v, rt.buf_ptr(&b), rt.buf_len(&b), "av_main.mp4")
    let pv: *mut kitplayer.PlayerView = kitview.view_media(&v)
    let pl: *mut kpplayer.Player = kitplayer.pv_player(pv)
    kpplayer.pl_set_discard(pl, true)
    check(kpplayer.pl_has_video(pl) && kpplayer.pl_has_frame(pl), "video with a first frame")
    let p: *mut Page = page_new(w, h, dark, font)
    canvas.canvas_clear(&(*p).cv, tok(p, style.TOK_BASE))
    kitview.view_draw(&(*p).c, &v, 0.0, 0.0, w as f64, h as f64)
    let l: *mut kplayout.Layout = kitplayer.pv_layout_ptr(pv)
    var fit: kplayout.Rect = kplayout.Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 }
    kplayout.fit_rect(kpplayer.pl_frame_width(pl) as f64, kpplayer.pl_frame_height(pl) as f64, &(*l).surface, &fit)
    check(fit.w > 0.0 && fit.x >= (*l).surface.x && fit.x + fit.w <= (*l).surface.x + (*l).surface.w + 0.5, "the frame fits inside the surface")
    check(count_col(p, &fit, 4278190080 as u32) < ((fit.w * fit.h) as usize) * 3 / 4, "the frame is not black")
    save(&(*p).cv, dir, png_name)
    let no0: u64 = kpplayer.pl_frame_no(pl)
    kpplayer.pl_seek_ms(pl, 1500 as u64)
    kitview.view_tick(&v)
    canvas.canvas_clear(&(*p).cv, tok(p, style.TOK_BASE))
    kitview.view_draw(&(*p).c, &v, 0.0, 0.0, w as f64, h as f64)
    check(kpplayer.pl_frame_no(pl) != no0, "a seek shows another frame")
    kitview.view_free(&v)
    rt.buf_free(&b)
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("kpview: no font (DejaVu Sans)\n")
        return 9
    }
    run_audio(dir, fs as u64, true, 640, 420, "== audio dark", "kpview-audio-dark.png")
    run_audio(dir, fs as u64, false, 640, 420, "== audio light", "kpview-audio-light.png")
    run_audio(dir, fs as u64, true, 360, 640, "== audio narrow", "kpview-audio-narrow.png")
    run_video(dir, fs as u64, true, 640, 420, "== video dark", "kpview-video-dark.png")
    run_video(dir, fs as u64, false, 360, 640, "== video narrow", "kpview-video-narrow.png")
    if BAD == 0 {
        say("KPVIEW PASSED\n")
        return 0
    }
    say("KPVIEW FAILED\n")
    return 1
}
