import ds_testpage
import fui.ds_icons_full
import fui.ds_settings
import fui.ds_tpl_files
import fui.ds_tpl_files_model
import fui.ds_tpl_settings
import fui.ds_tpl_wizard
import fui.ds_scroller
import fui.event
import fui.render
import fui.screenax
import plat.fuiwirt

static mut PARENTS: [i64; 4] = [0 as i64; 4]
static mut CALLS: usize = 0

fn on_apply(ud: u64, id: usize, v: i64) { CALLS = CALLS + 1 }
fn on_fire(ud: u64, id: usize) {}
fn wdraw(ud: u64, c: *mut render.Ctx, step: usize, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) {}
fn wgate(ud: u64, step: usize) -> bool { return true }
fn wfinish(ud: u64) {}

fn parent(ud: u64, node: i64) -> i64 { return PARENTS[node as usize] }
fn name_of(ud: u64, node: i64) -> str { return "Root" }
fn count(ud: u64, node: i64) -> usize {
    if node == 0 { return 60 }
    return 0
}
fn entry(ud: u64, node: i64, i: usize, out: *mut ds_tpl_files_model.Entry) {
    *out = ds_tpl_files_model.Entry { name: "file", id: 0 - 1, size: 10 as i64, modified: "2026-01-01", icon: 0 - 1 }
}

fn swipe(s: u64, dn: fn(u64, f64, f64, i64), mv: fn(u64, f64, f64, i64) -> bool, upf: fn(u64, f64, f64, i64) -> bool,
    x0: f64, y0: f64, dx: f64, dy: f64, steps: usize, t0: i64, hold_ms: i64) -> i64 {
    var t: i64 = t0
    dn(s, x0, y0, t * 1000 as i64)
    var k: usize = 1
    while k <= steps {
        t = t + 16 as i64
        mv(s, x0 + dx * (k as f64) / (steps as f64), y0 + dy * (k as f64) / (steps as f64), t * 1000 as i64)
        k = k + 1
    }
    t = t + hold_ms
    upf(s, x0 + dx, y0 + dy, t * 1000 as i64)
    return t
}

fn run_out(s: u64, c: *mut render.Ctx, tick: fn(u64, i64) -> bool, moving: fn(u64) -> bool, t0: i64) -> i64 {
    var t: i64 = t0
    var n: usize = 0
    while moving(s) && n < 600 {
        t = t + 16 as i64
        render.ctx_set_time(c, t)
        tick(s, t)
        n = n + 1
    }
    return t
}

fn build_settings() -> *mut ds_tpl_settings.Tpl {
    let t: *mut ds_tpl_settings.Tpl = ds_tpl_settings.new("Settings", on_apply, on_fire, 0)
    ds_tpl_settings.page(t, 0 - 1, "System")
    ds_tpl_settings.slider(t, 3, 0 - 1, "Brightness", "", 0, 100, "%")
    var i: usize = 0
    while i < 20 {
        ds_tpl_settings.toggle(t, 10 + i, 0 - 1, "Option", "Some detail")
        i = i + 1
    }
    var p: usize = 0
    while p < 11 {
        ds_tpl_settings.page(t, 0 - 1, "Page")
        ds_tpl_settings.toggle(t, 31 + p, 0 - 1, "Extra", "")
        p = p + 1
    }
    return t
}

fn spaint(t: *mut ds_tpl_settings.Tpl, pg: *mut ds_testpage.Page, c: *mut render.Ctx, w: f64, h: f64, now: i64) {
    render.ctx_set_time(c, now)
    ds_testpage.clear(pg)
    ds_tpl_settings.paint(t as u64, c, w, h, 0.0 - 1.0, 0.0 - 1.0)
}

fn settings_wide(font: u64) {
    ds_testpage.say("== settings wide\n")
    let pg: *mut ds_testpage.Page = ds_testpage.page_new(1100, 420, false, font)
    let c: *mut render.Ctx = &(*pg).c
    let t: *mut ds_tpl_settings.Tpl = build_settings()
    let s: u64 = t as u64
    var now: i64 = 1000
    spaint(t, pg, c, 1100.0, 420.0, now)
    ds_testpage.check(ds_tpl_settings.rows_scroll_y(s) == 0.0, "rows start at the top")
    now = swipe(s, ds_tpl_settings.touch_down, ds_tpl_settings.touch_move, ds_tpl_settings.touch_up, 700.0, 380.0, 0.0, 0.0 - 200.0, 10, now, 0 as i64)
    spaint(t, pg, c, 1100.0, 420.0, now)
    let dragged: f64 = ds_tpl_settings.rows_scroll_y(s)
    ds_testpage.check(dragged > 100.0, "vertical swipe scrolls the rows")
    ds_testpage.check(ds_tpl_settings.moving(s), "a fast release keeps moving")
    now = run_out(s, c, ds_tpl_settings.tick, ds_tpl_settings.moving, now)
    spaint(t, pg, c, 1100.0, 420.0, now)
    ds_testpage.check(ds_tpl_settings.rows_scroll_y(s) > dragged, "the fling carries on after the lift")
    ds_testpage.check(!ds_tpl_settings.moving(s), "the fling comes to rest")
    let rest: f64 = ds_tpl_settings.rows_scroll_y(s)
    now = swipe(s, ds_tpl_settings.touch_down, ds_tpl_settings.touch_move, ds_tpl_settings.touch_up, 700.0, 380.0, 0.0, 0.0 - 60.0, 6, now, 200 as i64)
    spaint(t, pg, c, 1100.0, 420.0, now)
    ds_testpage.check(!ds_tpl_settings.moving(s) && ds_tpl_settings.rows_scroll_y(s) > rest, "a held finger scrolls without a fling")
    now = swipe(s, ds_tpl_settings.touch_down, ds_tpl_settings.touch_move, ds_tpl_settings.touch_up, 700.0, 100.0, 0.0, 0.0 + 900.0, 12, now, 0 as i64)
    now = run_out(s, c, ds_tpl_settings.tick, ds_tpl_settings.moving, now)
    spaint(t, pg, c, 1100.0, 420.0, now)
    ds_testpage.check(ds_tpl_settings.rows_scroll_y(s) == 0.0, "the rows stop at their start")
    let before_nav: f64 = ds_tpl_settings.rows_scroll_y(s)
    now = swipe(s, ds_tpl_settings.touch_down, ds_tpl_settings.touch_move, ds_tpl_settings.touch_up, 100.0, 380.0, 0.0, 0.0 - 200.0, 10, now, 200 as i64)
    ds_testpage.check(ds_tpl_settings.rows_scroll_y(s) == before_nav, "a swipe on the pane does not scroll the rows")
    now = run_out(s, c, ds_tpl_settings.tick, ds_tpl_settings.moving, now)

    ds_testpage.say("== settings slider and tap\n")
    spaint(t, pg, c, 1100.0, 420.0, now)
    var q: [f64; 4] = [0.0; 4]
    ds_settings.control_rect(ds_tpl_settings.panel_of(t), 3, &q)
    let v0: i64 = ds_tpl_settings.get(t, 3)
    now = swipe(s, ds_tpl_settings.touch_down, ds_tpl_settings.touch_move, ds_tpl_settings.touch_up, q[0] + q[2] * 0.3, q[1] + q[3] / 2.0, q[2] * 0.4, 0.0, 8, now, 40 as i64)
    ds_testpage.check(ds_tpl_settings.get(t, 3) != v0, "a horizontal drag moves a slider")
    ds_testpage.check(ds_tpl_settings.rows_scroll_y(s) == 0.0, "a horizontal drag does not scroll")
    spaint(t, pg, c, 1100.0, 420.0, now)
    ds_settings.control_rect(ds_tpl_settings.panel_of(t), 10, &q)
    let calls: usize = CALLS
    ds_tpl_settings.touch_down(s, q[0] + q[2] / 2.0, q[1] + q[3] / 2.0, now * 1000 as i64)
    now = now + 60 as i64
    ds_tpl_settings.touch_up(s, q[0] + q[2] / 2.0, q[1] + q[3] / 2.0, now * 1000 as i64)
    ds_testpage.check(CALLS == calls + 1 && ds_tpl_settings.get(t, 10) == 1, "a tap flips a toggle")

    ds_testpage.say("== settings pointer records\n")
    ds_testpage.check(!ds_tpl_settings.touch_pointer(s, fuiwirt.PE_DOWN, 1 as u32, event.PT_MOUSE, 700.0, 300.0, 0.0), "mouse records pass through")
    ds_testpage.check(ds_tpl_settings.touch_pointer(s, fuiwirt.PE_DOWN, 1 as u32, event.PT_TOUCH, 700.0, 300.0, 0.0), "a touch down is consumed")
    ds_testpage.check(ds_tpl_settings.touch_pointer(s, fuiwirt.PE_DOWN, 2 as u32, event.PT_TOUCH, 300.0, 300.0, 0.0), "a second finger is consumed")
    now = now + 16 as i64
    ds_tpl_settings.touch_pointer(s, fuiwirt.PE_MOVE, 1 as u32, event.PT_TOUCH, 700.0, 250.0, 0.0)
    now = now + 16 as i64
    ds_tpl_settings.touch_pointer(s, fuiwirt.PE_MOVE, 1 as u32, event.PT_TOUCH, 700.0, 200.0, 0.0)
    spaint(t, pg, c, 1100.0, 420.0, now)
    ds_testpage.check(ds_tpl_settings.rows_scroll_y(s) > 0.0, "touch records drive the rows")
    ds_tpl_settings.touch_pointer(s, fuiwirt.PE_CANCEL, 1 as u32, event.PT_TOUCH, 700.0, 200.0, 0.0)
    ds_testpage.check(!ds_tpl_settings.moving(s), "a cancel starts no fling")
}

fn settings_stacked(font: u64) {
    ds_testpage.say("== settings stacked\n")
    let pg: *mut ds_testpage.Page = ds_testpage.page_new(400, 420, false, font)
    let c: *mut render.Ctx = &(*pg).c
    let t: *mut ds_tpl_settings.Tpl = build_settings()
    let s: u64 = t as u64
    var now: i64 = 1000
    spaint(t, pg, c, 400.0, 420.0, now)
    ds_testpage.check(!(*t).opened && ds_tpl_settings.list_scroll_y(s) == 0.0, "the page list starts at the top")
    now = swipe(s, ds_tpl_settings.touch_down, ds_tpl_settings.touch_move, ds_tpl_settings.touch_up, 200.0, 380.0, 0.0, 0.0 - 220.0, 10, now, 0 as i64)
    spaint(t, pg, c, 400.0, 420.0, now)
    ds_testpage.check(ds_tpl_settings.list_scroll_y(s) > 50.0, "vertical swipe scrolls the page list")
    now = run_out(s, c, ds_tpl_settings.tick, ds_tpl_settings.moving, now)
    spaint(t, pg, c, 400.0, 420.0, now)
    ds_testpage.check(!(*t).opened, "swiping does not open a page")
    now = swipe(s, ds_tpl_settings.touch_down, ds_tpl_settings.touch_move, ds_tpl_settings.touch_up, 200.0, 100.0, 0.0, 0.0 + 900.0, 12, now, 0 as i64)
    now = run_out(s, c, ds_tpl_settings.tick, ds_tpl_settings.moving, now)
    spaint(t, pg, c, 400.0, 420.0, now)
    ds_testpage.check(ds_tpl_settings.list_scroll_y(s) == 0.0, "the page list stops at its start")
    var q: [f64; 4] = [0.0; 4]
    ds_settings.row_rect(ds_tpl_settings.list_of(t), 0, &q)
    ds_tpl_settings.touch_down(s, q[0] + q[2] / 2.0, q[1] + q[3] / 2.0, now * 1000 as i64)
    now = now + 60 as i64
    ds_tpl_settings.touch_up(s, q[0] + q[2] / 2.0, q[1] + q[3] / 2.0, now * 1000 as i64)
    ds_testpage.check((*t).opened && (*t).page == 0, "a tap opens the page")
    spaint(t, pg, c, 400.0, 420.0, now)
    now = swipe(s, ds_tpl_settings.touch_down, ds_tpl_settings.touch_move, ds_tpl_settings.touch_up, 200.0, 380.0, 0.0, 0.0 - 220.0, 10, now, 0 as i64)
    spaint(t, pg, c, 400.0, 420.0, now)
    ds_testpage.check(ds_tpl_settings.rows_scroll_y(s) > 50.0, "vertical swipe scrolls the open page")
}

fn files_wide(font: u64) {
    ds_testpage.say("== files\n")
    let pg: *mut ds_testpage.Page = ds_testpage.page_new(1100, 420, false, font)
    let c: *mut render.Ctx = &(*pg).c
    let h: i64 = 0
    let spec: ds_tpl_files_model.Spec = ds_tpl_files_model.Spec { ud: 0, title: "Files", places: "Root", place_nodes: [0, 0, 0, 0, 0, 0, 0, 0],
        place_icons: [h, 0, 0, 0, 0, 0, 0, 0], root: 0, parent: parent, name_of: name_of, count: count, entry: entry }
    let f: *mut ds_tpl_files.Files = ds_tpl_files.files_new(spec)
    ds_tpl_files.go(f, 0 as i64, true)
    let s: u64 = f as u64
    var now: i64 = 1000
    render.ctx_set_time(c, now)
    ds_testpage.clear(pg)
    ds_tpl_files.paint(s, c, 1100.0, 420.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(ds_tpl_files.grid_scroll_y(s) == 0.0, "the list starts at the top")
    now = swipe(s, ds_tpl_files.touch_down, ds_tpl_files.touch_move, ds_tpl_files.touch_up, 700.0, 380.0, 0.0, 0.0 - 220.0, 10, now, 0 as i64)
    render.ctx_set_time(c, now)
    ds_testpage.clear(pg)
    ds_tpl_files.paint(s, c, 1100.0, 420.0, 0.0 - 1.0, 0.0 - 1.0)
    let dragged: f64 = ds_tpl_files.grid_scroll_y(s)
    ds_testpage.check(dragged > 100.0, "vertical swipe scrolls the list")
    ds_testpage.check(ds_tpl_files.moving(s), "a fast release keeps moving")
    now = run_out(s, c, ds_tpl_files.tick, ds_tpl_files.moving, now)
    ds_testpage.check(ds_tpl_files.grid_scroll_y(s) > dragged, "the fling carries on")
    ds_testpage.check(!ds_tpl_files.moving(s), "the fling comes to rest")
    let rest: f64 = ds_tpl_files.grid_scroll_y(s)
    now = swipe(s, ds_tpl_files.touch_down, ds_tpl_files.touch_move, ds_tpl_files.touch_up, 700.0, 380.0, 0.0 - 200.0, 0.0, 8, now, 0 as i64)
    ds_testpage.check(ds_tpl_files.grid_scroll_y(s) == rest, "horizontal swipe does nothing")
    now = swipe(s, ds_tpl_files.touch_down, ds_tpl_files.touch_move, ds_tpl_files.touch_up, 700.0, 380.0, 0.0, 0.0 + 1500.0, 12, now, 0 as i64)
    now = run_out(s, c, ds_tpl_files.tick, ds_tpl_files.moving, now)
    ds_testpage.check(ds_tpl_files.grid_scroll_y(s) == 0.0, "the list stops at its start")
    render.ctx_set_time(c, now)
    ds_testpage.clear(pg)
    ds_tpl_files.paint(s, c, 1100.0, 420.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check((*f).sel == ds_tpl_files.NONE, "nothing is selected before the tap")
    ds_tpl_files.touch_down(s, 700.0, 110.0, now * 1000 as i64)
    now = now + 60 as i64
    ds_tpl_files.touch_up(s, 700.0, 110.0, now * 1000 as i64)
    ds_testpage.check((*f).sel != ds_tpl_files.NONE, "a tap selects an entry")
    ds_testpage.check(ds_tpl_files.grid_scroll_y(s) == 0.0, "a tap does not scroll")
    ds_testpage.check(!ds_tpl_files.touch_pointer(s, fuiwirt.PE_DOWN, 1 as u32, event.PT_MOUSE, 700.0, 300.0, 0.0), "mouse records pass through")
    ds_testpage.check(ds_tpl_files.touch_pointer(s, fuiwirt.PE_DOWN, 1 as u32, event.PT_TOUCH, 700.0, 300.0, 0.0), "a touch down is consumed")
    now = now + 16 as i64
    ds_tpl_files.touch_pointer(s, fuiwirt.PE_MOVE, 1 as u32, event.PT_TOUCH, 700.0, 250.0, 0.0)
    now = now + 16 as i64
    ds_tpl_files.touch_pointer(s, fuiwirt.PE_MOVE, 1 as u32, event.PT_TOUCH, 700.0, 200.0, 0.0)
    ds_testpage.check(ds_tpl_files.grid_scroll_y(s) > 0.0, "touch records drive the list")
    ds_tpl_files.touch_pointer(s, fuiwirt.PE_CANCEL, 1 as u32, event.PT_TOUCH, 700.0, 200.0, 0.0)
    ds_testpage.check(!ds_tpl_files.moving(s), "a cancel starts no fling")
}

fn wizard_narrow(font: u64) {
    ds_testpage.say("== wizard\n")
    let pg: *mut ds_testpage.Page = ds_testpage.page_new(400, 300, false, font)
    let c: *mut render.Ctx = &(*pg).c
    let w: *mut ds_tpl_wizard.Wiz = ds_tpl_wizard.new("Setup", wdraw, wgate, wfinish, 0)
    (*w).ud = w as u64
    ds_tpl_wizard.welcome(w, 0 - 1, "Welcome", "Hello")
    ds_tpl_wizard.step(w, "Long", "a|b|c|d|e|f|g|h|i|j")
    ds_tpl_wizard.step(w, "Body", "x")
    ds_tpl_wizard.set_body_height(w, 2, 500.0)
    ds_tpl_wizard.step(w, "Short", "x")
    let s: u64 = w as u64
    var now: i64 = 1000
    render.ctx_set_time(c, now)
    ds_testpage.clear(pg)
    ds_tpl_wizard.paint(s, c, 400.0, 300.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_tpl_wizard.go_next(w)
    render.ctx_set_time(c, now)
    ds_testpage.clear(pg)
    ds_tpl_wizard.paint(s, c, 400.0, 300.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check((*w).scrollable && ds_tpl_wizard.scroll_y(s) == 0.0, "an overflowing step is scrollable")
    now = swipe(s, ds_tpl_wizard.touch_down, ds_tpl_wizard.touch_move, ds_tpl_wizard.touch_up, 200.0, 180.0, 0.0, 0.0 - 120.0, 8, now, 0 as i64)
    render.ctx_set_time(c, now)
    ds_testpage.clear(pg)
    ds_tpl_wizard.paint(s, c, 400.0, 300.0, 0.0 - 1.0, 0.0 - 1.0)
    let dragged: f64 = ds_tpl_wizard.scroll_y(s)
    ds_testpage.check(dragged > 40.0, "vertical swipe scrolls the step")
    now = run_out(s, c, ds_tpl_wizard.tick, ds_tpl_wizard.moving, now)
    ds_testpage.check(ds_tpl_wizard.current(w) == 1, "swiping does not leave the step")
    ds_testpage.check(ds_tpl_wizard.scroll_y(s) >= dragged, "the fling never runs backwards")
    now = swipe(s, ds_tpl_wizard.touch_down, ds_tpl_wizard.touch_move, ds_tpl_wizard.touch_up, 200.0, 100.0, 0.0, 0.0 + 900.0, 12, now, 0 as i64)
    now = run_out(s, c, ds_tpl_wizard.tick, ds_tpl_wizard.moving, now)
    render.ctx_set_time(c, now)
    ds_testpage.clear(pg)
    ds_tpl_wizard.paint(s, c, 400.0, 300.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(ds_tpl_wizard.scroll_y(s) == 0.0, "the step stops at its start")
    now = swipe(s, ds_tpl_wizard.touch_down, ds_tpl_wizard.touch_move, ds_tpl_wizard.touch_up, 200.0, 180.0, 0.0, 0.0 - 120.0, 8, now, 0 as i64)
    let bx: f64 = (*w).r[ds_tpl_wizard.BTN_NEXT * 4] + (*w).r[ds_tpl_wizard.BTN_NEXT * 4 + 2] / 2.0
    let by: f64 = (*w).r[ds_tpl_wizard.BTN_NEXT * 4 + 1] + (*w).r[ds_tpl_wizard.BTN_NEXT * 4 + 3] / 2.0
    ds_tpl_wizard.touch_down(s, bx, by, now * 1000 as i64)
    now = now + 60 as i64
    ds_tpl_wizard.touch_up(s, bx, by, now * 1000 as i64)
    ds_testpage.check(ds_tpl_wizard.current(w) == 2, "a tap on Next advances")
    ds_testpage.check(ds_tpl_wizard.scroll_y(s) == 0.0, "a new step starts at the top")
    render.ctx_set_time(c, now)
    ds_testpage.clear(pg)
    ds_tpl_wizard.paint(s, c, 400.0, 300.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check((*w).scrollable, "a declared body height makes the step scrollable")
    ds_tpl_wizard.go_next(w)
    render.ctx_set_time(c, now)
    ds_testpage.clear(pg)
    ds_tpl_wizard.paint(s, c, 400.0, 300.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(!(*w).scrollable, "a short step does not scroll")
    ds_testpage.check(!ds_tpl_wizard.touch_pointer(s, fuiwirt.PE_DOWN, 1 as u32, event.PT_MOUSE, 200.0, 180.0, 0.0), "mouse records pass through")
    ds_testpage.check(ds_tpl_wizard.touch_pointer(s, fuiwirt.PE_DOWN, 1 as u32, event.PT_TOUCH, 200.0, 180.0, 0.0), "a touch down is consumed")
    ds_tpl_wizard.touch_pointer(s, fuiwirt.PE_CANCEL, 1 as u32, event.PT_TOUCH, 200.0, 180.0, 0.0)
}

fn welcome_frame(pg: *mut ds_testpage.Page, c: *mut render.Ctx, s: u64, w: f64, h: f64, now: i64) {
    render.ctx_set_time(c, now)
    ds_testpage.clear(pg)
    ds_tpl_wizard.paint(s, c, w, h, 0.0 - 1.0, 0.0 - 1.0)
}

fn wizard_welcome(font: u64) {
    ds_testpage.say("== wizard welcome\n")
    let pg: *mut ds_testpage.Page = ds_testpage.page_new(400, 300, false, font)
    let c: *mut render.Ctx = &(*pg).c
    let wz: *mut ds_tpl_wizard.Wiz = ds_tpl_wizard.new("Setup", wdraw, wgate, wfinish, 0)
    (*wz).ud = wz as u64
    ds_tpl_wizard.welcome(wz, 0 - 1, "Welcome", "Hello|World")
    ds_tpl_wizard.step(wz, "Next", "x")
    let s: u64 = wz as u64
    var now: i64 = 1000
    welcome_frame(pg, c, s, 400.0, 900.0, now)
    ds_testpage.check(!(*wz).scrollable, "a tall welcome page does not scroll")
    ds_testpage.check(!ds_tpl_wizard.wheel(s, 200.0, 100.0, 0.0, 1.0), "a tall welcome page ignores the wheel")
    welcome_frame(pg, c, s, 400.0, 300.0, now)
    ds_testpage.check((*wz).scrollable && ds_tpl_wizard.scroll_y(s) == 0.0, "a short window makes the welcome page scrollable")
    ds_testpage.check(ds_tpl_wizard.wheel(s, 200.0, 100.0, 0.0, 1.0), "the wheel scrolls the welcome page")
    welcome_frame(pg, c, s, 400.0, 300.0, now)
    ds_testpage.check(ds_tpl_wizard.scroll_y(s) > 20.0, "the wheel moves the welcome offset")
    ds_tpl_wizard.wheel(s, 200.0, 100.0, 0.0, 0.0 - 50.0)
    welcome_frame(pg, c, s, 400.0, 300.0, now)
    ds_testpage.check(ds_tpl_wizard.scroll_y(s) == 0.0, "the welcome offset stops at the start")
    now = swipe(s, ds_tpl_wizard.touch_down, ds_tpl_wizard.touch_move, ds_tpl_wizard.touch_up, 200.0, 180.0, 0.0, 0.0 - 120.0, 8, now, 0 as i64)
    welcome_frame(pg, c, s, 400.0, 300.0, now)
    let dragged: f64 = ds_tpl_wizard.scroll_y(s)
    ds_testpage.check(dragged > 40.0, "a swipe scrolls the welcome page")
    now = run_out(s, c, ds_tpl_wizard.tick, ds_tpl_wizard.moving, now)
    welcome_frame(pg, c, s, 400.0, 300.0, now)
    ds_testpage.check(ds_tpl_wizard.scroll_y(s) >= dragged, "the welcome fling never runs backwards")
    ds_testpage.check(ds_tpl_wizard.current(wz) == 0, "swiping does not leave the welcome page")
    ds_tpl_wizard.wheel(s, 200.0, 100.0, 0.0, 50.0)
    welcome_frame(pg, c, s, 400.0, 300.0, now)
    ds_testpage.check(ds_tpl_wizard.scroll_y(s) <= ds_scroller.limit(&(*wz).sc) + 0.5, "the welcome offset stops at the end")
    let bx: f64 = (*wz).r[ds_tpl_wizard.BTN_NEXT * 4] + (*wz).r[ds_tpl_wizard.BTN_NEXT * 4 + 2] / 2.0
    let by: f64 = (*wz).r[ds_tpl_wizard.BTN_NEXT * 4 + 1] + (*wz).r[ds_tpl_wizard.BTN_NEXT * 4 + 3] / 2.0
    ds_testpage.check(by < 300.0 - 56.0, "the start button is reachable at the end")
    ds_tpl_wizard.touch_down(s, bx, by, now * 1000 as i64)
    now = now + 60 as i64
    ds_tpl_wizard.touch_up(s, bx, by, now * 1000 as i64)
    ds_testpage.check(ds_tpl_wizard.current(wz) == 1, "a tap on Start advances after scrolling")
    ds_testpage.check(ds_tpl_wizard.scroll_y(s) == 0.0, "the next step starts at the top")
}

fn main() -> i32 {
    let font: u64 = ds_testpage.font_load()
    if font == 0 {
        ds_testpage.say("no system font\n")
        return 2
    }
    screenax.install()
    ds_icons_full.install()
    PARENTS[0] = 0 - 1
    settings_wide(font)
    settings_stacked(font)
    files_wide(font)
    wizard_narrow(font)
    wizard_welcome(font)
    return ds_testpage.finish("ds_tpl_touch")
}
