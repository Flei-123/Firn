// SPDX-License-Identifier: MPL-2.0
// tools/fui/listrow_main.fi -- THE CHECK OF lib/fui/listrow.fi (roadmap r129).
//
// Rows with a symbol on the left, the text, and an optional detail and
// badge on the right, in a scene tree. Without a window: the list is built,
// laid out into a canvas, painted, and read back.
//
//     firnc -o /tmp/listrow tools/fui/listrow_main.fi && /tmp/listrow [dir]
//
// With a directory the pictures listrow-light.png / listrow-dark.png /
// listrow-narrow.png are written there. The last line is LISTROW PASSED
// or LISTROW FAILED.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.scene
import fui.sheet
import fui.style
import fui.flex
import fui.widget
import fui.listrow
import plat.sysfont

static mut BAD: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = rt.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64,
            mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
    sh: sheet.Sheet,
    sc: scene.Scene,
    list: usize,
    w: usize,
    h: usize,
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    (*p).w = w
    (*p).h = h
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    (*p).sh = sheet.sheet_new()
    (*p).sc = scene.scene_new()
    listrow.listrow_rules(&(*p).sh)
    return p
}

fn paint(p: *mut Page) {
    let base: u32 = theme.opaque(render.color_of(&(*p).c, style.color_token(style.TOK_BASE)))
    canvas.canvas_clear(&(*p).cv, base)
    scene.scene_run(&(*p).sc, &(*p).c, &(*p).sh, 0.0, 0.0, (*p).w as f64, (*p).h as f64)
}

fn px(p: *mut Page, x: f64, y: f64) -> u32 {
    return canvas.canvas_get(&(*p).cv, x as usize, y as usize)
}

fn tok(p: *mut Page, t: u32) -> u32 {
    return theme.opaque(render.color_of(&(*p).c, style.color_token(t)))
}

// a list of the rows an explorer needs
fn fill(p: *mut Page) {
    check(listrow.icon_named("folder") >= 0 as i64 && listrow.icon_named("no-such-icon-x") == listrow.ICON_NONE,
        "icon_named finds a Lucide name and answers ICON_NONE for an unknown one")
    (*p).list = listrow.listrow_list(&(*p).sc, scene.SCENE_NONE)
    var r1: listrow.Row = listrow.row_new(1 as u32, "Documents")
    r1.icon = listrow.icon_named("folder")
    r1.detail = "12 items"
    r1.badge = "3"
    let n1: usize = listrow.listrow_add(&(*p).sc, (*p).list, &r1)
    var r2: listrow.Row = listrow.row_new(2 as u32, "notes.txt")
    r2.icon = listrow.icon_named("pencil")
    r2.detail = "2 KB"
    let n2: usize = listrow.listrow_add(&(*p).sc, (*p).list, &r2)
    var r3: listrow.Row = listrow.row_new(3 as u32, "Plain row without symbol")
    let n3: usize = listrow.listrow_add(&(*p).sc, (*p).list, &r3)
    var r4: listrow.Row = listrow.row_new(4 as u32, "Locked")
    r4.icon = listrow.icon_named("lock")
    r4.disabled = true
    let n4: usize = listrow.listrow_add(&(*p).sc, (*p).list, &r4)
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    return d <= tol
}

fn child_of(sc: *mut scene.Scene, row: usize, n: usize) -> usize {
    return scene.scene_child_at(sc, row, n)
}

fn run_theme(dir: u64, font: u64, dark: bool) {
    if dark {
        say("== dark theme\n")
    } else {
        say("== light theme\n")
    }
    let p: *mut Page = page_new(360, 200, dark, font)
    fill(p)
    let sc: *mut scene.Scene = &(*p).sc
    paint(p)
    let r1: usize = listrow.listrow_row_of(sc, (*p).list, 1 as u32)
    let r2: usize = listrow.listrow_row_of(sc, (*p).list, 2 as u32)
    let r3: usize = listrow.listrow_row_of(sc, (*p).list, 3 as u32)
    let r4: usize = listrow.listrow_row_of(sc, (*p).list, 4 as u32)
    check(r1 != scene.SCENE_NONE && r4 != scene.SCENE_NONE, "every row is found by its key")
    check(scene.node_y(sc, r2) > scene.node_y(sc, r1) && scene.node_y(sc, r3) > scene.node_y(sc, r2),
        "the rows stand one under the other, in the order they were added")
    check(near(scene.node_w(sc, r1), scene.node_w(sc, (*p).list), 0.5),
        "a row is as wide as its list")
    // the parts of row 1: symbol, text, detail, badge
    let ic: usize = child_of(sc, r1, 0)
    let tx: usize = child_of(sc, r1, 1)
    let dt: usize = child_of(sc, r1, 2)
    let bd: usize = child_of(sc, r1, 3)
    check(scene.scene_child_count(sc, r1) == 4, "symbol + text + detail + badge are four children")
    check(scene.node_x(sc, ic) < scene.node_x(sc, tx) && scene.node_w(sc, ic) > 0.0,
        "the symbol is on the left of the text")
    check(scene.node_x(sc, tx) + scene.node_w(sc, tx) <= scene.node_x(sc, dt) + 0.5
        && scene.node_x(sc, dt) + scene.node_w(sc, dt) <= scene.node_x(sc, bd) + 0.5,
        "text, detail and badge do not overlap, left to right")
    let rx: f64 = scene.node_x(sc, r1) + scene.node_w(sc, r1)
    check(near(rx - (scene.node_x(sc, bd) + scene.node_w(sc, bd)), 10.0, 1.5),
        "the badge sits at the right end of the row (the row's inner margin)")
    check(scene.node_w(sc, tx) > scene.node_w(sc, dt) * 2.0,
        "the text takes the free width, the right side only what it needs")
    // the symbol is drawn: some pixel of its box differs from the ground
    let ground: u32 = px(p, scene.node_x(sc, r1) + 1.0, scene.node_y(sc, r1) + 1.0)
    var ink: usize = 0
    var yy: f64 = scene.node_y(sc, ic)
    while yy < scene.node_y(sc, ic) + scene.node_h(sc, ic) {
        var xx: f64 = scene.node_x(sc, ic)
        while xx < scene.node_x(sc, ic) + scene.node_w(sc, ic) {
            if px(p, xx, yy) != ground {
                ink = ink + 1
            }
            xx = xx + 1.0
        }
        yy = yy + 1.0
    }
    check(ink > 12, "the symbol's box holds ink")
    let r3ic: usize = scene.scene_child_count(sc, r3)
    check(r3ic == 1, "a row without symbol, detail and badge is just its text")
    // hit
    let cy: f64 = scene.node_y(sc, r2) + scene.node_h(sc, r2) / 2.0
    check(listrow.listrow_hit(sc, 40.0, cy) == 2 as u32, "a point in row 2 answers key 2")
    check(listrow.listrow_hit(sc, scene.node_x(sc, tx) + 2.0, scene.node_y(sc, r1) + 6.0) == 1 as u32,
        "a point on the text of row 1 answers key 1 (the row, not the text node)")
    check(listrow.listrow_hit(sc, 40.0, scene.node_y(sc, r4) + 6.0) == 0 as u32, "a disabled row answers 0")
    check(listrow.listrow_hit(sc, 5.0, 199.0) == 0 as u32, "below the rows nothing answers")

    // the ground: a row is transparent
    let g1: u32 = px(p, scene.node_x(sc, r2) + 3.0, scene.node_y(sc, r2) + 2.0)
    check(g1 == tok(p, style.TOK_BASE), "a plain row has the page's ground behind it")
    // hover
    check(listrow.listrow_hover(sc, (*p).list, 2 as u32), "hover on row 2 changes something")
    check(!listrow.listrow_hover(sc, (*p).list, 2 as u32), "the same hover again changes nothing")
    paint(p)
    let h2: u32 = px(p, scene.node_x(sc, r2) + 3.0, scene.node_y(sc, r2) + 2.0)
    check(h2 == tok(p, style.TOK_BUTTON_HOVER), "the hovered row has the hover colour")
    check(h2 != g1, "and it is not the ground's colour")
    let hn: bool = listrow.listrow_hover(sc, (*p).list, 0 as u32)
    // select
    check(listrow.listrow_select(sc, (*p).list, 1 as u32), "choosing row 1 changes something")
    check(listrow.listrow_selected(sc, (*p).list) == 1 as u32, "row 1 is the chosen one")
    let sk: bool = listrow.listrow_select(sc, (*p).list, 2 as u32)
    check(listrow.listrow_selected(sc, (*p).list) == 2 as u32, "choosing row 2 takes row 1 off: one choice at a time")
    paint(p)
    let s2: u32 = px(p, scene.node_x(sc, r2) + 3.0, scene.node_y(sc, r2) + 2.0)
    let s1: u32 = px(p, scene.node_x(sc, r1) + 3.0, scene.node_y(sc, r1) + 2.0)
    check(s2 == tok(p, style.TOK_SELECTION), "the chosen row has the selection colour")
    check(s1 == tok(p, style.TOK_BASE), "the row that is no longer chosen has the ground again")
    // the chosen row is readable: ink in the selection-text colour on it
    var found: bool = false
    let rt2: usize = child_of(sc, r2, 1)
    var y2: f64 = scene.node_y(sc, rt2)
    while y2 < scene.node_y(sc, rt2) + scene.node_h(sc, rt2) {
        var x2: f64 = scene.node_x(sc, rt2)
        while x2 < scene.node_x(sc, rt2) + 60.0 {
            if px(p, x2, y2) == tok(p, style.TOK_SELECTION_TEXT) {
                found = true
            }
            x2 = x2 + 1.0
        }
        y2 = y2 + 1.0
    }
    check(found, "text in a chosen row is painted in the selection-text colour")
    // a disabled row
    let dg: u32 = px(p, scene.node_x(sc, r4) + 3.0, scene.node_y(sc, r4) + 2.0)
    check(dg == tok(p, style.TOK_BASE), "a disabled row is not highlighted")
    let nh: bool = listrow.listrow_hover(sc, (*p).list, 4 as u32)
    check(scene.node_state(sc, r4) == style.STATE_DISABLED, "hover cannot wake a disabled row")
    // the badge of a chosen row swaps its colours (row 1 chosen again)
    let sk1: bool = listrow.listrow_select(sc, (*p).list, 1 as u32)
    paint(p)
    let bsel: u32 = px(p, scene.node_x(sc, bd) + 2.0, scene.node_y(sc, bd) + scene.node_h(sc, bd) / 2.0)
    check(bsel == tok(p, style.TOK_SELECTION_TEXT), "in a chosen row the badge is in the selection-text colour (swapped)")
    check(bsel != tok(p, style.TOK_SELECTION), "and it is not the chosen row's own colour")
    if dark {
        save(&(*p).cv, dir, "listrow-dark.png")
    } else {
        save(&(*p).cv, dir, "listrow-light.png")
    }
}

fn run_narrow(dir: u64, font: u64) {
    say("== a narrow list: the long text gives way\n")
    let p: *mut Page = page_new(200, 120, false, font)
    (*p).list = listrow.listrow_list(&(*p).sc, scene.SCENE_NONE)
    var r1: listrow.Row = listrow.row_new(1 as u32, "A very long file name that does not fit into this list at all.txt")
    r1.icon = listrow.icon_named("pencil")
    r1.detail = "1.2 MB"
    r1.badge = "new"
    let n1: usize = listrow.listrow_add(&(*p).sc, (*p).list, &r1)
    paint(p)
    let sc: *mut scene.Scene = &(*p).sc
    let r: usize = listrow.listrow_row_of(sc, (*p).list, 1 as u32)
    check(scene.scene_child_count(sc, r) == 4, "the narrow row has its four parts")
    let bd: usize = child_of(sc, r, 3)
    let tx: usize = child_of(sc, r, 1)
    let dt: usize = child_of(sc, r, 2)
    check(scene.node_x(sc, bd) + scene.node_w(sc, bd) <= scene.node_x(sc, r) + scene.node_w(sc, r) + 0.5,
        "the badge stays inside the row")
    check(scene.node_x(sc, tx) + scene.node_w(sc, tx) <= scene.node_x(sc, dt) + 0.5,
        "the text is cut before the detail, not over it")
    check(scene.scene_size_drift(sc) == 0, "no node paints outside its box (drift 0)")
    save(&(*p).cv, dir, "listrow-narrow.png")
}

// a shape as wide / as tall as the canvas is painted (painter.raster_window gave
// it one column too many and refused it until 03.10.2026): fill, ring, gradient
fn run_edge(font: u64) {
    say("== shapes that span the whole canvas\n")
    let p: *mut Page = page_new(100, 40, false, font)
    let ink: u32 = 4278190080 as u32
    canvas.canvas_clear(&(*p).cv, 4294967295 as u32)
    painter.round_rect(&(*p).z, 0.0, 0.0, 100.0, 40.0, 6.0, ink)
    check(px(p, 50.0, 20.0) == ink && px(p, 99.0, 20.0) == ink && px(p, 50.0, 39.0) == ink,
        "a round rectangle as large as the canvas is painted, up to its last column and row")
    canvas.canvas_clear(&(*p).cv, 4294967295 as u32)
    painter.round_ring(&(*p).z, 0.0, 0.0, 100.0, 40.0, 6.0, 2.0, ink)
    check(px(p, 50.0, 0.0) == ink && px(p, 0.0, 20.0) == ink && px(p, 99.0, 20.0) == ink
        && px(p, 50.0, 39.0) == ink && px(p, 50.0, 20.0) == 4294967295 as u32,
        "a ring as large as the canvas is painted on all four edges, the inside stays empty")
    canvas.canvas_clear(&(*p).cv, 4294967295 as u32)
    painter.round_rect_grad(&(*p).z, 0.0, 0.0, 100.0, 40.0, 6.0, ink, 4278190335 as u32, 0.0, 1.0)
    check(px(p, 50.0, 20.0) != 4294967295 as u32 && px(p, 99.0, 20.0) != 4294967295 as u32,
        "a gradient as large as the canvas is painted")
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("listrow: no font (DejaVu Sans)\n")
        return 9
    }
    run_theme(dir, fs as u64, false)
    run_theme(dir, fs as u64, true)
    run_narrow(dir, fs as u64)
    run_edge(fs as u64)
    if BAD == 0 {
        say("LISTROW PASSED\n")
        return 0
    }
    say("LISTROW FAILED\n")
    return 1
}
