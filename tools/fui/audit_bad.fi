// tools/fui/audit_bad.fi -- A fui.app PROGRAM THAT MUST FAIL ITS AUDIT.
// A text field with an empty hint has no accessible name. tools/fui/audit.sh
// runs this one with FUI_AUDIT=1 and requires the exit code 1 -- the proof
// that the audit of every program (tools/fui/audit.sh) is not a rubber stamp.
import fui.app

fn main() -> i32 {
    let a: *mut app.App = app.window("Bad", 300, 200)
    app.label(a, "A field nobody can name", 14)
    app.entry(a, "")
    return app.run(a)
}
