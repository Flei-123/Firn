// SPDX-License-Identifier: MPL-2.0
// tools/fui/blurref_main.fi -- DER ANDERE KASTENWEICHZEICHNER, GEMESSEN.
//
// ========================================================= WARUM ES DAS GIBT
//
// Dieser Baum hat zwei Kastenweichzeichner, und das ist begruendet:
// `lib/paint/painter.blur_line` mittelt DECKUNGSGRADE (ein f64 je
// Pixel, draussen Null), `lib/fui/effect.blur_buffer` mittelt eine
// PREMULTIPLIZIERTE u8-LEINWAND (vier Kanaele, draussen der
// fortgesetzte Randwert). Eine Begruendung ist aber nur so viel wert
// wie ihre Nachpruefung -- also wird hier GEMESSEN, dass beide bei
// demselben sigma denselben Tonwert liefern.
//
// DIE TABELLE UNTEN IST DER VERTRAG. Dieselbe Stufenkante (links 0,
// ab Stelle 32 voll), dasselbe sigma 4.0, in beiden Faellen ein
// Fenster von neun Abtastwerten, dreimal angewandt. Dieses Programm
// rechnet die f64-Seite, tools/fui/effect_main.fi (Abschnitt 12) die
// u8-Seite, und beide halten ihr Ergebnis gegen genau diese Zahlen.
//
// WARUM ZWEI PROGRAMME UND NICHT EINES: Firn loest ein Modul nach dem
// LETZTEN Abschnitt seines Pfades auf. `paint.painter` und
// `fui.painter` heissen beide `painter` und koennen darum nicht in
// dasselbe Programm; deshalb importiert diese Datei NICHTS aus
// lib/fui. Die Tabelle ist das Band zwischen den beiden.
import std.rt
import paint.painter

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    var w: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&w[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// DIE STUFENKANTE. 64 Abtastwerte, ab 32 voll -- weit genug von
// beiden Enden, dass der Rand die verglichene Mitte nicht erreicht
// (drei Durchgaenge mit Halbfenster 4 reichen zwoelf Stellen weit).
const N: usize = 64
const EDGE: usize = 32
const SIGMA: f64 = 4.0

// Der Tonwert an der Stelle x, aus dem Deckungsgrad: mal 255,
// kaufmaennisch gerundet -- genau das, was eine Leinwand daraus
// machen wuerde.
fn ton(v: f64) -> i64 {
    var t: f64 = v * 255.0 + 0.5
    if t < 0.0 {
        t = 0.0
    }
    if t > 255.0 {
        t = 255.0
    }
    return t as i64
}

fn main() -> i32 {
    // DIE TABELLE (Stellen 18..45). Sie steht ebenso in
    // tools/fui/effect_main.fi, Abschnitt 12.
    var should: [i64; 28] = [
        0, 0, 0, 1, 3, 7, 12, 20, 29, 42, 58, 76, 96, 117,
        138, 159, 179, 197, 213, 226, 235, 243, 248, 252, 254, 255,
        255, 255]

    // DAS FENSTER. `box_size` nimmt den CSS-Unschaerferadius, und der
    // ist nach css-backgrounds-3 6.2 das DOPPELTE von sigma; das halbe
    // Fenster ist d/2. Bei sigma 4 kommt 4 heraus, also neun
    // Abtastwerte -- dieselbe Zahl, die `effect.radius_for_sigma(4.0)`
    // in tools/fui/effect_main.fi liefert.
    let d: i64 = painter.box_size(2.0 * SIGMA)
    var n1: [u8; 44] = "12 the CSS box at sigma 4 is 8 wide (d)     "
    report((&n1[0]) as u64, 43, d == 8, d, 8)
    let half: i64 = d / 2
    var n2: [u8; 44] = "12 so the half window is 4 (nine samples)   "
    report((&n2[0]) as u64, 43, half == 4, half, 4)

    let a: u64 = rt.heap_alloc(N * 8)
    if a == 0 {
        return 2
    }
    let b: u64 = rt.heap_alloc(N * 8)
    if b == 0 {
        rt.heap_free(a, N * 8)
        return 2
    }
    var i: usize = 0
    while i < N {
        var v: f64 = 0.0
        if i >= EDGE {
            v = 1.0
        }
        *((a + (i * 8) as u64) as *mut f64) = v
        i = i + 1
    }
    // Drei Durchgaenge, abwechselnd zwischen den Puffern -- das
    // Ergebnis steht danach in `b`.
    painter.blur_line(a, 8, b, 8, N as i64, half)
    painter.blur_line(b, 8, a, 8, N as i64, half)
    painter.blur_line(a, 8, b, 8, N as i64, half)

    // Jede einzelne Stelle gegen die Tabelle -- und zwar EXAKT: die
    // f64-Seite rundet nur einmal, am Ende.
    var abw: i64 = 0
    var x: usize = 0
    while x < 28 {
        let g: i64 = ton(*((b + ((x + 18) * 8) as u64) as *mut f64))
        var d2: i64 = g - should[x]
        if d2 < 0 {
            d2 = 0 - d2
        }
        if d2 > abw {
            abw = d2
        }
        x = x + 1
    }
    var n3: [u8; 44] = "12 every one of the 28 spots is the table   "
    report((&n3[0]) as u64, 43, abw == 0, abw, 0)
    // Die drei Stellen, an denen ein Fehler am ehesten auffiele: der
    // Fuss der Flanke, ihre Mitte und ihr Kopf.
    let m0: i64 = ton(*((b + (24 * 8) as u64) as *mut f64))
    var n4: [u8; 44] = "12 at 24 the coverage path gives 12         "
    report((&n4[0]) as u64, 43, m0 == 12, m0, 12)
    let m1: i64 = ton(*((b + (32 * 8) as u64) as *mut f64))
    var n5: [u8; 44] = "12 at the edge itself it gives 138          "
    report((&n5[0]) as u64, 43, m1 == 138, m1, 138)
    let m2: i64 = ton(*((b + (40 * 8) as u64) as *mut f64))
    var n6: [u8; 44] = "12 at 40 it gives 248                       "
    report((&n6[0]) as u64, 43, m2 == 248, m2, 248)
    // DIE SUMME ZEIGT DIE RANDREGEL. Ein Kasten verteilt Licht, er
    // frisst keines -- aber diese Seite fuellt DRAUSSEN MIT NULL, und
    // die volle Haelfte reicht bis an das rechte Ende der Reihe. Was
    // ueber dieses Ende hinauslaeuft, ist weg: von den 32.00 vollen
    // Stellen bleiben 29.54. Genau darin unterscheidet sich
    // lib/fui/effect.fi, das den Randwert FORTSETZT und deshalb die
    // 32.00 behaelt; die Mitte, die oben verglichen wird, beruehrt das
    // nicht (drei Durchgaenge reichen zwoelf Stellen weit).
    var sum: f64 = 0.0
    var k: usize = 0
    while k < N {
        sum = sum + *((b + (k * 8) as u64) as *mut f64)
        k = k + 1
    }
    let si: i64 = (sum * 100.0 + 0.5) as i64
    var n7: [u8; 44] = "12 zero padding loses 2.46 at the right end "
    report((&n7[0]) as u64, 43, si == 2954, si, 2954)

    rt.heap_free(b, N * 8)
    rt.heap_free(a, N * 8)

    var t: rt.Buf = rt.buf_new()
    rt.buf_push(&t, 10 as u8)
    if G_ERRORS > 0 {
        var f: [u8; 26] = "BLUR REF IS NOT IN ORDER.\n"
        rt.buf_push_bytes(&t, (&f[0]) as u64, 26)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
        return 1
    }
    var o: [u8; 16] = "BLURREF PASSED.\n"
    rt.buf_push_bytes(&t, (&o[0]) as u64, 16)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 0
}
