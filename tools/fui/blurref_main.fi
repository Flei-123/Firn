// SPDX-License-Identifier: MPL-2.0
// tools/fui/blurref_main.fi -- THE OTHER BOX BLUR, MEASURED.
//
// ========================================================= WHY IT EXISTS
//
// This tree has two box blurs, and that is justified:
// `lib/paint/painter.blur_line` averages OPACITIES (one f64 per
// pixel, zero outside), `lib/fui/effect.blur_buffer` averages a
// PREMULTIPLIED u8 CANVAS (four channels, outside the
// continued edge value). A justification is, however, worth only as much as
// its verification -- so here it is MEASURED that both at
// the same sigma yield the same tone value.
//
// THE TABLE BELOW IS THE CONTRACT. The same step edge (left 0,
// from position 32 full), the same sigma 4.0, in both cases a
// window of nine samples, applied three times. This program
// calculates the f64 side, tools/fui/effect_main.fi (section 12) the
// u8 side, and both hold their result against exactly these numbers.
//
// WHY TWO PROGRAMS AND NOT ONE: Firn resolves a module by the
// LAST segment of its path. `paint.painter` and
// `fui.painter` are both called `painter` and therefore cannot go into the
// same program; that is why this file imports NOTHING from
// lib/fui. The table is the link between the two.
import std.rt
import paint.painter

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    var w: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&w[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// THE STEP EDGE. 64 samples, full from 32 -- far enough from
// both ends that the edge does not reach the compared middle
// (three passes with half-window 4 reach twelve positions far).
const N: usize = 64
const EDGE: usize = 32
const SIGMA: f64 = 4.0

// The tone value at position x, from the opacity: times 255,
// commercially rounded -- exactly what a canvas would
// make of it.
fn ton(v: f64) -> i64 {
    var t: f64 = v * 255.0 + 0.5
    if t < 0.0 {
        t = 0.0
    }
    if t > 255.0 {
        t = 255.0
    }
    return t as i64
}

fn main() -> i32 {
    // THE TABLE (positions 18..45). It stands likewise in
    // tools/fui/effect_main.fi, section 12.
    var should: [i64; 28] = [
        0, 0, 0, 1, 3, 7, 12, 20, 29, 42, 58, 76, 96, 117,
        138, 159, 179, 197, 213, 226, 235, 243, 248, 252, 254, 255,
        255, 255]

    // THE WINDOW. `box_size` takes the CSS blur radius, and that
    // is, by css-backgrounds-3 6.2, TWICE sigma; the half
    // window is d/2. At sigma 4 4 comes out, so nine
    // samples -- the same number that `effect.radius_for_sigma(4.0)`
    // delivers in tools/fui/effect_main.fi.
    let d: i64 = painter.box_size(2.0 * SIGMA)
    var n1: [u8; 44] = "12 the CSS box at sigma 4 is 8 wide (d)     "
    report((&n1[0]) as u64, 43, d == 8, d, 8)
    let half: i64 = d / 2
    var n2: [u8; 44] = "12 so the half window is 4 (nine samples)   "
    report((&n2[0]) as u64, 43, half == 4, half, 4)

    let a: u64 = rt.heap_alloc(N * 8)
    if a == 0 {
        return 2
    }
    let b: u64 = rt.heap_alloc(N * 8)
    if b == 0 {
        rt.heap_free(a, N * 8)
        return 2
    }
    var i: usize = 0
    while i < N {
        var v: f64 = 0.0
        if i >= EDGE {
            v = 1.0
        }
        *((a + (i * 8) as u64) as *mut f64) = v
        i = i + 1
    }
    // Three passes, alternating between the buffers -- the
    // result then stands in `b`.
    painter.blur_line(a, 8, b, 8, N as i64, half)
    painter.blur_line(b, 8, a, 8, N as i64, half)
    painter.blur_line(a, 8, b, 8, N as i64, half)

    // Every single position against the table -- and EXACTLY: the
    // f64 side rounds only once, at the end.
    var abw: i64 = 0
    var x: usize = 0
    while x < 28 {
        let g: i64 = ton(*((b + ((x + 18) * 8) as u64) as *mut f64))
        var d2: i64 = g - should[x]
        if d2 < 0 {
            d2 = 0 - d2
        }
        if d2 > abw {
            abw = d2
        }
        x = x + 1
    }
    var n3: [u8; 44] = "12 every one of the 28 spots is the table   "
    report((&n3[0]) as u64, 43, abw == 0, abw, 0)
    // The three places at which an error would most likely be noticed: the
    // foot of the flank, its middle and its head.
    let m0: i64 = ton(*((b + (24 * 8) as u64) as *mut f64))
    var n4: [u8; 44] = "12 at 24 the coverage path gives 12         "
    report((&n4[0]) as u64, 43, m0 == 12, m0, 12)
    let m1: i64 = ton(*((b + (32 * 8) as u64) as *mut f64))
    var n5: [u8; 44] = "12 at the edge itself it gives 138          "
    report((&n5[0]) as u64, 43, m1 == 138, m1, 138)
    let m2: i64 = ton(*((b + (40 * 8) as u64) as *mut f64))
    var n6: [u8; 44] = "12 at 40 it gives 248                       "
    report((&n6[0]) as u64, 43, m2 == 248, m2, 248)
    // THE SUM SHOWS THE EDGE RULE. A box distributes light, it
    // eats none -- but this side fills OUTSIDE WITH ZERO, and
    // the full half reaches to the right end of the row. What
    // runs out beyond this end is gone: of the 32.00 full
    // positions 29.54 remain. Exactly in that lib/fui/effect.fi differs,
    // which CONTINUES the edge value and therefore keeps the
    // 32.00; the middle that is compared above is not touched by this
    // (three passes reach twelve positions far).
    var sum: f64 = 0.0
    var k: usize = 0
    while k < N {
        sum = sum + *((b + (k * 8) as u64) as *mut f64)
        k = k + 1
    }
    let si: i64 = (sum * 100.0 + 0.5) as i64
    var n7: [u8; 44] = "12 zero padding loses 2.46 at the right end "
    report((&n7[0]) as u64, 43, si == 2954, si, 2954)

    rt.heap_free(b, N * 8)
    rt.heap_free(a, N * 8)

    var t: rt.Buf = rt.buf_new()
    rt.buf_push(&t, 10 as u8)
    if G_ERRORS > 0 {
        var f: [u8; 26] = "BLUR REF IS NOT IN ORDER.\n"
        rt.buf_push_bytes(&t, (&f[0]) as u64, 26)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
        return 1
    }
    var o: [u8; 16] = "BLURREF PASSED.\n"
    rt.buf_push_bytes(&t, (&o[0]) as u64, 16)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 0
}
