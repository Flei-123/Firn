// SPDX-License-Identifier: MPL-2.0
// tools/fui/xcut_main.fi -- r456: painter.round_rect cuts its raster window to the clip in x (between the corners). Inside the clip the
// picture must be byte-identical to the one a wide window paints.
//
//     firnc -o /tmp/xcut tools/fui/xcut_main.fi && /tmp/xcut
import std.rt
import std.time
import paint.canvas
import fui.painter

static mut BAD: usize = 0
static mut SEED: u64 = 88172645463325252

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn rnd(n: u64) -> u64 {
    SEED = SEED ^ (SEED << 13)
    SEED = SEED ^ (SEED >> 7)
    SEED = SEED ^ (SEED << 17)
    return SEED % n
}

fn rndf(lo: u64, hi: u64) -> f64 {
    // quarter pixels
    return ((lo * 4 + rnd((hi - lo) * 4 + 1)) as f64) / 4.0
}

fn main(start: u64) -> i32 {
    let cw: usize = 640
    let ch: usize = 360
    var ca: canvas.Canvas = canvas.canvas_new()
    var cb: canvas.Canvas = canvas.canvas_new()
    var za: painter.Painter = painter.painter_new()
    var zb: painter.Painter = painter.painter_new()
    if !canvas.canvas_init(&ca, cw, ch) || !canvas.canvas_init(&cb, cw, ch)
    || !painter.painter_init(&za, &ca, cw, ch) || !painter.painter_init(&zb, &cb, cw, ch) {
        say("xcut: no canvas\n")
        return 9
    }
    var trial: usize = 0
    var wrong: usize = 0
    var cut_used: usize = 0
    while trial < 400 {
        canvas.canvas_clear(&ca, 0xff203040 as u32)
        canvas.canvas_clear(&cb, 0xff203040 as u32)
        // a shape: wide cards, small buttons, thin pills
        let x: f64 = rndf(0, 200)
        let y: f64 = rndf(0, 100)
        let w: f64 = rndf(20, 400)
        let h: f64 = rndf(10, 240)
        let r: f64 = rndf(1, 60)
        // a clip somewhere over it
        let cx0: f64 = rndf(0, 500)
        let cy0: f64 = rndf(0, 280)
        let cx1: f64 = cx0 + rndf(1, 140)
        let cy1: f64 = cy0 + rndf(1, 120)
        let col: u32 = (0x80000000 as u32) | (rnd(16777216) as u32)
        let pushed: bool = canvas.clip_push_rect(&ca, cx0, cy0, cx1, cy1)
        painter.round_rect(&za, x, y, w, h, r, col)
        if pushed {
            canvas.clip_pop(&ca)
        }
        painter.round_rect(&zb, x, y, w, h, r, col)
        // compare inside the clip
        var yy: usize = cy0 as usize
        var bad: bool = false
        while yy < (cy1 as usize) + 1 && yy < ch {
            var xx: usize = cx0 as usize
            while xx < (cx1 as usize) + 1 && xx < cw {
                if canvas.canvas_get(&ca, xx, yy) != canvas.canvas_get(&cb, xx, yy) {
                    // a partial pixel at the clip edge may differ by the clip factor; only whole pixels count
                    if (xx as f64) >= cx0 + 1.0 && (xx as f64) + 1.0 <= cx1 - 1.0 && (yy as f64) >= cy0 + 1.0 && (yy as f64) + 1.0 <= cy1 - 1.0 {
                        bad = true
                    }
                }
                xx = xx + 1
            }
            yy = yy + 1
        }
        if bad {
            wrong = wrong + 1
        }
        trial = trial + 1
    }
    // speed: a wide card under a clip as high as a spinner square
    canvas.canvas_clear(&ca, 0xff203040 as u32)
    let t0: i64 = time.now_unix_ns()
    var n: usize = 0
    let pu: bool = canvas.clip_push_rect(&ca, 200.0, 100.0, 330.0, 230.0)
    while n < 2000 {
        painter.round_rect(&za, 10.0, 20.0, 620.0, 320.0, 24.0, 0xff405060 as u32)
        n = n + 1
    }
    if pu {
        canvas.clip_pop(&ca)
    }
    let t1: i64 = time.now_unix_ns()
    say("  card 620x320 under a 130x130 clip, us per call: ")
    var tt: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&tt, (t1 - t0) / 2000 / 1000)
    rt.write_everything(1, rt.buf_ptr(&tt), rt.buf_len(&tt))
    rt.buf_free(&tt)
    say("\n")
    say("  trials 400, pictures that differ inside the clip: ")
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, wrong as i64)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
    if wrong == 0 {
        say("XCUT PASSED\n")
        return 0
    }
    say("XCUT FAILED\n")
    return 1
}
