// SPDX-License-Identifier: MPL-2.0
// tools/fui/control_main.fi -- DOES THE INTERACTION REALLY WORK?
//
// ====================================================== WHY IT EXISTS
//
// Justin, 11.09.2026: "Hover must really work (mouse move -> state
// change -> repaint), not just a field in the struct." And: "A slider
// must be draggable and deliver a value, not just look drawn."
//
// Both are claims that a PICTURE CANNOT DISPROVE. A screenshot of a
// slider looks the same whether the handle sits there because it was
// dragged or because it was painted at a fixed place. That is exactly
// the "fake switch" the brief forbids -- and the only way to rule it
// out is to move the mouse and READ THE NUMBER BACK.
//
// So this program sends real events into a real Panel and checks the
// state afterwards. No canvas, no font, no picture.
import std.rt
import fui.style
import fui.widget
import fui.control

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, got: i64, want: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var h1: [u8; 5] = " got "
    rt.buf_push_bytes(&t, (&h1[0]) as u64, 5)
    rt.buf_push_dec_i64(&t, got)
    var h2: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&h2[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, want)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn b2i(b: bool) -> i64 {
    if b { return 1 }
    return 0
}

fn main(start: u64) -> i32 {
    // Three buttons in a row, 100 wide, 32 high, 10 apart.
    var ws: [widget.Widget; 4] =
        [widget.widget_new(widget.KIND_BUTTON); 4]
    var i: usize = 0
    while i < 3 {
        widget.w_place(&ws[i], (10 + i * 110) as f64, 10.0, 100.0, 32.0)
        i = i + 1
    }
    // the fourth is a slider
    ws[3] = widget.widget_new(widget.KIND_SLIDER)
    widget.w_place(&ws[3], 10.0, 100.0, 200.0, 20.0)

    var pn: control.Panel = control.panel_new()
    control.panel_attach(&pn, (&ws[0]) as u64, 4)

    // ==================================================================
    // 1. HOVER REALLY FOLLOWS THE MOUSE
    // ==================================================================
    var t1: [u8; 34] = "1 nobody hovered at the start     "
    report((&t1[0]) as u64, 32,
        control.panel_hot(&pn) == control.NOBODY,
        b2i(control.panel_hot(&pn) == control.NOBODY), 1)

    // into the middle of button 0
    var ch: u32 = control.mouse_move(&pn, 60.0, 26.0)
    var t2: [u8; 34] = "1 move onto button 0 -> hover     "
    report((&t2[0]) as u64, 32, control.panel_hot(&pn) == 0,
        control.panel_hot(&pn) as i64, 0)
    var t2b: [u8; 38] = "1 the widget itself carries the bit   "
    report((&t2b[0]) as u64, 36, widget.w_is_hover(&ws[0]),
        b2i(widget.w_is_hover(&ws[0])), 1)
    // AND it asked for a repaint. That is the half everybody forgets.
    var t2c: [u8; 38] = "1 and it demands a repaint            "
    report((&t2c[0]) as u64, 36,
        (ch & control.CH_REPAINT) != 0 as u32,
        b2i((ch & control.CH_REPAINT) != 0 as u32), 1)

    // moving WITHIN the same button changes nothing -- no repaint
    ch = control.mouse_move(&pn, 70.0, 26.0)
    var t3: [u8; 42] = "1 moving inside it wants no repaint       "
    report((&t3[0]) as u64, 40, ch == control.CH_NONE,
        ch as i64, 0)

    // onto button 1: the old one must LOSE it
    ch = control.mouse_move(&pn, 170.0, 26.0)
    var t4: [u8; 40] = "1 hover moves on, the old one loses it  "
    report((&t4[0]) as u64, 38,
        !widget.w_is_hover(&ws[0]) && widget.w_is_hover(&ws[1]),
        b2i(widget.w_is_hover(&ws[1])), 1)

    // into empty space
    ch = control.mouse_move(&pn, 600.0, 600.0)
    var t5: [u8; 38] = "1 into empty space -> nobody hovered  "
    report((&t5[0]) as u64, 36,
        control.panel_hot(&pn) == control.NOBODY
        && !widget.w_is_hover(&ws[1]),
        b2i(!widget.w_is_hover(&ws[1])), 1)

    // ==================================================================
    // 2. A DISABLED WIDGET IS NOT HOVERED
    // ==================================================================
    widget.w_set_disabled(&ws[2], true)
    ch = control.mouse_move(&pn, 280.0, 26.0)
    var t6: [u8; 40] = "2 disabled takes no hover               "
    report((&t6[0]) as u64, 38,
        control.panel_hot(&pn) == control.NOBODY,
        b2i(control.panel_hot(&pn) == control.NOBODY), 1)

    // ==================================================================
    // 3. PRESS AND RELEASE -- AND THE WAY OUT
    // ==================================================================
    control.mouse_move(&pn, 60.0, 26.0)
    ch = control.mouse_down(&pn, 60.0, 26.0)
    var t7: [u8; 34] = "3 press -> active and focus       "
    report((&t7[0]) as u64, 32,
        widget.w_is_active(&ws[0]) && widget.w_is_focus(&ws[0]),
        b2i(widget.w_is_active(&ws[0])), 1)

    ch = control.mouse_up(&pn, 60.0, 26.0)
    var t8: [u8; 40] = "3 release on it -> activation           "
    report((&t8[0]) as u64, 38,
        (ch & control.CH_ACTIVATE) != 0 as u32,
        b2i((ch & control.CH_ACTIVATE) != 0 as u32), 1)

    // THE WAY OUT: press, slide off, release -- must NOT trigger.
    control.mouse_down(&pn, 60.0, 26.0)
    control.mouse_move(&pn, 600.0, 600.0)
    ch = control.mouse_up(&pn, 600.0, 600.0)
    var t9: [u8; 44] = "3 sliding off cancels the activation        "
    report((&t9[0]) as u64, 42,
        (ch & control.CH_ACTIVATE) == 0 as u32,
        b2i((ch & control.CH_ACTIVATE) == 0 as u32), 1)
    var t9b: [u8; 40] = "3 and the pressed look is gone          "
    report((&t9b[0]) as u64, 38, !widget.w_is_active(&ws[0]),
        b2i(!widget.w_is_active(&ws[0])), 1)

    // ==================================================================
    // 4. THE SLIDER REALLY DELIVERS A VALUE
    // ==================================================================
    // The slider is at x=10, 200 wide, the handle is as high as it is
    // deep (20). Travel is therefore 180, from 20 to 200.
    //
    // Grabbing it at the far left has to give 0, at the far right 1000,
    // in the middle 500 -- and pulling has to move it CONTINUOUSLY.
    ch = control.mouse_down(&pn, 10.0, 110.0)
    var s1: [u8; 38] = "4 grabbed at the left -> value 0      "
    report((&s1[0]) as u64, 36, widget.w_value(&ws[3]) == 0,
        widget.w_value(&ws[3]), 0)

    ch = control.mouse_move(&pn, 110.0, 110.0)
    var s2: [u8; 40] = "4 pulled to the middle -> about 500     "
    let vm: i64 = widget.w_value(&ws[3])
    report((&s2[0]) as u64, 38, vm > 480 && vm < 520, vm, 500)
    var s2b: [u8; 38] = "4 and it reports the value change     "
    report((&s2b[0]) as u64, 36,
        (ch & control.CH_VALUE) != 0 as u32,
        b2i((ch & control.CH_VALUE) != 0 as u32), 1)

    ch = control.mouse_move(&pn, 500.0, 110.0)
    var s3: [u8; 44] = "4 pulled past the end -> caps at 1000       "
    report((&s3[0]) as u64, 42, widget.w_value(&ws[3]) == 1000,
        widget.w_value(&ws[3]), 1000)

    // THE POINT OF THE DRAG: the pointer has long left the slider
    // (y=110 is on it, y=400 is not) and it MUST still follow.
    ch = control.mouse_move(&pn, 110.0, 400.0)
    let vd: i64 = widget.w_value(&ws[3])
    var s4: [u8; 46] = "4 keeps following when sliding off vertically "
    report((&s4[0]) as u64, 44, vd > 480 && vd < 520, vd, 500)

    control.mouse_up(&pn, 110.0, 400.0)
    // after releasing, movement does NOTHING any more
    let vbefore: i64 = widget.w_value(&ws[3])
    control.mouse_move(&pn, 200.0, 110.0)
    var s5: [u8; 40] = "4 after releasing it stands still       "
    report((&s5[0]) as u64, 38,
        widget.w_value(&ws[3]) == vbefore,
        widget.w_value(&ws[3]), vbefore)

    // ==================================================================
    // 5. THE CHECKBOX REALLY FLIPS
    // ==================================================================
    var cb: [widget.Widget; 1] =
        [widget.widget_new(widget.KIND_CHECKBOX); 1]
    widget.w_place(&cb[0], 0.0, 0.0, 20.0, 20.0)
    var pc: control.Panel = control.panel_new()
    control.panel_attach(&pc, (&cb[0]) as u64, 1)

    var c1: [u8; 30] = "5 checkbox starts off         "
    report((&c1[0]) as u64, 30, widget.w_value(&cb[0]) == 0,
        widget.w_value(&cb[0]), 0)

    control.mouse_move(&pc, 10.0, 10.0)
    control.mouse_down(&pc, 10.0, 10.0)
    var chc: u32 = control.mouse_up(&pc, 10.0, 10.0)
    var c2: [u8; 35] = "5 one click -> on                  "
    report((&c2[0]) as u64, 34, widget.w_value(&cb[0]) == 1,
        widget.w_value(&cb[0]), 1)
    var c2b: [u8; 39] = "5 and selected follows the value       "
    report((&c2b[0]) as u64, 38, widget.w_is_selected(&cb[0]),
        b2i(widget.w_is_selected(&cb[0])), 1)

    control.mouse_down(&pc, 10.0, 10.0)
    control.mouse_up(&pc, 10.0, 10.0)
    var c3: [u8; 35] = "5 a second click -> off again      "
    report((&c3[0]) as u64, 34, widget.w_value(&cb[0]) == 0,
        widget.w_value(&cb[0]), 0)

    // THE KEYBOARD HAS TO FLIP EXACTLY THE SAME THING
    control.panel_set_focus(&pc, 0)
    control.activate_focused(&pc)
    var c4: [u8; 42] = "5 space flips it just like the mouse      "
    report((&c4[0]) as u64, 40, widget.w_value(&cb[0]) == 1,
        widget.w_value(&cb[0]), 1)

    // ==================================================================
    // 6. THE TAB ORDER SKIPS WHAT CANNOT BE FOCUSED
    // ==================================================================
    var tw: [widget.Widget; 4] =
        [widget.widget_new(widget.KIND_BUTTON); 4]
    tw[0] = widget.widget_new(widget.KIND_BUTTON)
    tw[1] = widget.widget_new(widget.KIND_LABEL)      // not focusable
    tw[2] = widget.widget_new(widget.KIND_BUTTON)
    tw[3] = widget.widget_new(widget.KIND_BUTTON)
    widget.w_set_disabled(&tw[3], true)               // not focusable
    var i2: usize = 0
    while i2 < 4 {
        widget.w_place(&tw[i2], 0.0, (i2 * 40) as f64, 100.0, 30.0)
        i2 = i2 + 1
    }
    var pt: control.Panel = control.panel_new()
    control.panel_attach(&pt, (&tw[0]) as u64, 4)

    control.key_tab(&pt, false)
    var k1: [u8; 34] = "6 tab reaches the first           "
    report((&k1[0]) as u64, 32, control.panel_focus(&pt) == 0,
        control.panel_focus(&pt) as i64, 0)
    control.key_tab(&pt, false)
    var k2: [u8; 40] = "6 tab skips the label                   "
    report((&k2[0]) as u64, 38, control.panel_focus(&pt) == 2,
        control.panel_focus(&pt) as i64, 2)
    control.key_tab(&pt, false)
    var k3: [u8; 44] = "6 tab skips the disabled one and wraps      "
    report((&k3[0]) as u64, 42, control.panel_focus(&pt) == 0,
        control.panel_focus(&pt) as i64, 0)
    control.key_tab(&pt, true)
    var k4: [u8; 38] = "6 shift+tab goes back                 "
    report((&k4[0]) as u64, 36, control.panel_focus(&pt) == 2,
        control.panel_focus(&pt) as i64, 2)

    // ==================================================================
    // 7. WHAT LIES ON TOP TAKES THE CLICK
    // ==================================================================
    // Two widgets on the SAME spot. The later one was painted last and
    // therefore lies on top -- a menu over a button.
    var ov: [widget.Widget; 2] =
        [widget.widget_new(widget.KIND_BUTTON); 2]
    widget.w_place(&ov[0], 0.0, 0.0, 100.0, 100.0)
    widget.w_place(&ov[1], 50.0, 50.0, 100.0, 100.0)
    var po: control.Panel = control.panel_new()
    control.panel_attach(&po, (&ov[0]) as u64, 2)
    control.mouse_move(&po, 60.0, 60.0)
    var o1: [u8; 42] = "7 the one on top takes the pointer        "
    report((&o1[0]) as u64, 40, control.panel_hot(&po) == 1,
        control.panel_hot(&po) as i64, 1)

    // ---- the verdict
    var end: [u8; 21] = "\nINTERACTION PASSED.\n"
    if G_ERRORS != 0 {
        var bad: [u8; 21] = "\nINTERACTION FAILED.\n"
        rt.write_everything(2, (&bad[0]) as u64, 21)
        return 1
    }
    rt.write_everything(1, (&end[0]) as u64, 21)
    return 0
}
