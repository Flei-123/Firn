// SPDX-License-Identifier: MPL-2.0
// tools/fui/access_main.fi -- W5: KEYBOARD + ACCESSIBILITY TREE CHECKS (headless).
//
//   1. the whole keyboard on a control.Panel: Tab / Shift+Tab, Space, Enter, the
//      arrows on slider + radio, Home / End / PgUp / PgDn, Esc, disabled widgets
//   2. the key numbers of control.fi are those of editor.fi
//   3. the a11y tree: heading level, description (text + describedby), the
//      pointer path (a11y_hit), the text dump and the JSON export
//
//     firnc -o /tmp/access tools/fui/access_main.fi && /tmp/access
import std.rt
import paint.canvas
import font.metrics
import fui.theme
import fui.widget
import fui.painter
import fui.render
import fui.control
import fui.scene
import fui.editor
import fui.a11y

static mut BAD: usize = 0
static mut OKS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
        OKS = OKS + 1
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn has(p: u64, n: usize, t: str) -> bool {
    if t.n == 0 || n < t.n {
        return false
    }
    var i: usize = 0
    while i + t.n <= n {
        var k: usize = 0
        while k < t.n && *((p + (i + k) as u64) as *mut u8) == *(((t.p) as u64 + k as u64) as *mut u8) {
            k = k + 1
        }
        if k == t.n {
            return true
        }
        i = i + 1
    }
    return false
}

fn val(ws: *mut [widget.Widget; 8], i: usize) -> i64 {
    return widget.w_value(&(*ws)[i])
}

fn main(start: u64) -> i32 {
    // ============================================ 1. THE KEYBOARD
    // 0 button, 1 checkbox, 2/3/4 radios, 5 slider, 6 slider (disabled), 7 label
    var ws: [widget.Widget; 8] = [widget.widget_new(widget.KIND_BUTTON); 8]
    ws[1] = widget.widget_new(widget.KIND_CHECKBOX)
    ws[2] = widget.widget_new(widget.KIND_RADIO)
    ws[3] = widget.widget_new(widget.KIND_RADIO)
    ws[4] = widget.widget_new(widget.KIND_RADIO)
    ws[5] = widget.widget_new(widget.KIND_SLIDER)
    ws[6] = widget.widget_new(widget.KIND_SLIDER)
    ws[7] = widget.widget_new(widget.KIND_LABEL)
    var i: usize = 0
    while i < 8 {
        widget.w_place(&ws[i], 10.0, (10 + i * 40) as f64, 200.0, 30.0)
        i = i + 1
    }
    widget.w_set_disabled(&ws[6], true)
    widget.w_set_value(&ws[2], 1)
    widget.w_set_selected(&ws[2], true)
    var pn: control.Panel = control.panel_new()
    control.panel_attach(&pn, (&ws[0]) as u64, 8)

    say("-- Tab order\n")
    control.panel_key(&pn, editor.KEY_TAB, false)
    check(control.panel_focus(&pn) == 0, "Tab from nothing: the first widget")
    control.panel_key(&pn, editor.KEY_TAB, false)
    check(control.panel_focus(&pn) == 1, "Tab: next")
    control.panel_key(&pn, editor.KEY_TAB, true)
    check(control.panel_focus(&pn) == 0, "Shift+Tab: back")
    var t: usize = 0
    while t < 5 {
        control.panel_key(&pn, editor.KEY_TAB, false)
        t = t + 1
    }
    check(control.panel_focus(&pn) == 5, "Tab walks 1,2,3,4,5")
    control.panel_key(&pn, editor.KEY_TAB, false)
    check(control.panel_focus(&pn) == 0, "Tab skips the disabled slider and the label, and wraps")
    control.panel_key(&pn, editor.KEY_TAB, true)
    check(control.panel_focus(&pn) == 5, "Shift+Tab wraps backwards to the last focusable")

    say("-- Space / Enter\n")
    control.panel_set_focus(&pn, 1)
    let sp: u32 = control.panel_char(&pn, 32 as u32)
    check(val(&ws, 1) == 1 && (sp & control.CH_VALUE) != 0 as u32, "Space ticks the checkbox")
    control.panel_char(&pn, 32 as u32)
    check(val(&ws, 1) == 0, "Space again unticks it")
    let en: u32 = control.panel_key(&pn, editor.KEY_ENTER, false)
    check(val(&ws, 1) == 0 && (en & control.CH_ACTIVATE) == 0 as u32, "Enter does not flip a checkbox")
    control.panel_set_focus(&pn, 0)
    let eb: u32 = control.panel_key(&pn, editor.KEY_ENTER, false)
    check((eb & control.CH_ACTIVATE) != 0 as u32, "Enter triggers a button")
    let sb: u32 = control.panel_char(&pn, 32 as u32)
    check((sb & control.CH_ACTIVATE) != 0 as u32, "Space triggers a button")
    check(control.panel_char(&pn, 97 as u32) == control.CH_NONE, "another character does nothing")

    say("-- radio arrows\n")
    control.panel_set_focus(&pn, 2)
    control.panel_key(&pn, editor.KEY_RIGHT, false)
    check(control.panel_focus(&pn) == 3 && val(&ws, 3) == 1 && val(&ws, 2) == 0, "Right: next radio, selected, the old one off")
    control.panel_key(&pn, editor.KEY_DOWN, false)
    check(control.panel_focus(&pn) == 4 && val(&ws, 4) == 1 && val(&ws, 3) == 0, "Down: next radio")
    control.panel_key(&pn, editor.KEY_RIGHT, false)
    check(control.panel_focus(&pn) == 2 && val(&ws, 2) == 1 && val(&ws, 4) == 0, "Right at the end wraps to the first radio")
    control.panel_key(&pn, editor.KEY_LEFT, false)
    check(control.panel_focus(&pn) == 4 && val(&ws, 4) == 1, "Left at the start wraps to the last radio")
    control.panel_key(&pn, editor.KEY_UP, false)
    check(control.panel_focus(&pn) == 3, "Up: previous radio")
    check(control.panel_key(&pn, editor.KEY_PGUP, false) == control.CH_NONE, "PgUp on a radio does nothing")

    say("-- slider keys\n")
    control.panel_set_focus(&pn, 5)
    widget.w_set_value(&ws[5], 500)
    control.panel_key(&pn, editor.KEY_RIGHT, false)
    check(val(&ws, 5) == 510, "Right: +10")
    control.panel_key(&pn, editor.KEY_DOWN, false)
    check(val(&ws, 5) == 500, "Down: -10")
    control.panel_key(&pn, editor.KEY_PGUP, false)
    check(val(&ws, 5) == 600, "PgUp: +100")
    control.panel_key(&pn, editor.KEY_PGDN, false)
    control.panel_key(&pn, editor.KEY_PGDN, false)
    check(val(&ws, 5) == 400, "PgDn twice: -200")
    control.panel_key(&pn, editor.KEY_HOME, false)
    check(val(&ws, 5) == 0, "Home: 0")
    check(control.panel_key(&pn, editor.KEY_LEFT, false) == control.CH_NONE && val(&ws, 5) == 0, "Left at 0 changes nothing (and says so)")
    control.panel_key(&pn, editor.KEY_END, false)
    check(val(&ws, 5) == 1000, "End: 1000")
    widget.w_set_value(&ws[5], 995)
    control.panel_key(&pn, editor.KEY_RIGHT, false)
    check(val(&ws, 5) == 1000, "Right clamps at 1000")
    control.panel_set_focus(&pn, 6)
    widget.w_set_value(&ws[6], 300)
    control.panel_key(&pn, editor.KEY_RIGHT, false)
    check(val(&ws, 6) == 300, "a disabled slider ignores the keys")

    say("-- Esc\n")
    control.mouse_down(&pn, 20.0, 10.0 + 5.0 * 40.0 + 10.0)
    check(control.panel_pressed(&pn) != control.NOBODY, "a pressed pointer is held")
    control.panel_key(&pn, editor.KEY_ESC, false)
    check(control.panel_pressed(&pn) == control.NOBODY, "Esc lets go of it")

    say("-- the key numbers are those of editor.fi\n")
    check(control.KN_LEFT == editor.KEY_LEFT && control.KN_RIGHT == editor.KEY_RIGHT
        && control.KN_HOME == editor.KEY_HOME && control.KN_END == editor.KEY_END
        && control.KN_ENTER == editor.KEY_ENTER && control.KN_ESC == editor.KEY_ESC
        && control.KN_TAB == editor.KEY_TAB && control.KN_UP == editor.KEY_UP
        && control.KN_DOWN == editor.KEY_DOWN && control.KN_PGUP == editor.KEY_PGUP
        && control.KN_PGDN == editor.KEY_PGDN, "control.KN_* equals editor.KEY_*")

    // ============================================ 2. THE TREE
    var fbuf: rt.Buf = rt.buf_new()
    var fpath: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
    let has_font: bool = rt.read_file((&fpath[0]) as u64, &fbuf)
    let fsp: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if has_font {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    canvas.canvas_init(&cv, 400, 400)
    var z: painter.Painter = painter.painter_new()
    painter.painter_init(&z, &cv, 400, 400)
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(true)
    var c: render.Ctx = render.ctx_new(&m, &z)

    var t_h: [u8; 8] = "Settings"
    var t_hint: [u8; 22] = "At least three letters"
    var t_nm: [u8; 4] = "Name"
    var t_ab: [u8; 2] = "ab"
    var t_ok: [u8; 2] = "OK"
    var sd: scene.Scene = scene.scene_new()
    var ad: a11y.A11y = a11y.a11y_new()
    let root: usize = scene.scene_add(&sd, scene.SCENE_NONE, scene.N_BOX)
    let h: usize = scene.scene_add(&sd, root, scene.N_TEXT)
    scene.node_set_text(&sd, h, (&t_h[0]) as u64, 8)
    a11y.a11y_set_role(&ad, h, a11y.ROLE_HEADING)
    a11y.a11y_set_level(&ad, h, 3 as u32)
    let hint: usize = scene.scene_add(&sd, root, scene.N_TEXT)
    scene.node_set_text(&sd, hint, (&t_hint[0]) as u64, 22)
    scene.node_set_id(&sd, hint, 41 as u32)
    let tb: usize = scene.scene_widget(&sd, root, widget.KIND_TEXTBOX, (&t_ab[0]) as u64, 2)
    a11y.a11y_set_name(&ad, tb, (&t_nm[0]) as u64, 4)
    a11y.a11y_set_described_by(&ad, tb, 41 as u32)
    let bt: usize = scene.scene_widget(&sd, root, widget.KIND_BUTTON, 0, 0)
    let bt_t: usize = scene.scene_add(&sd, bt, scene.N_TEXT)
    scene.node_set_text(&sd, bt_t, (&t_ok[0]) as u64, 2)
    let h2: usize = scene.scene_add(&sd, root, scene.N_TEXT)
    scene.node_set_text(&sd, h2, (&t_h[0]) as u64, 8)
    a11y.a11y_set_role(&ad, h2, a11y.ROLE_HEADING)
    var k: usize = 1
    while k <= 4 {
        scene.node_set_size(&sd, scene.scene_child_at(&sd, root, k - 1), 300.0, 30.0)
        k = k + 1
    }
    scene.scene_measure(&sd, &c)
    scene.scene_layout(&sd, &c, 0.0, 0.0, 300.0, 200.0)

    say("-- heading level, description\n")
    check(a11y.a11y_level(&sd, &ad, h) == 3, "level 3 is kept")
    check(a11y.a11y_level(&sd, &ad, h2) == 2, "a heading without a level counts as 2")
    check(a11y.a11y_level(&sd, &ad, tb) == 0, "a textbox has no level")
    a11y.a11y_set_level(&ad, h, 9 as u32)
    check(a11y.a11y_level(&sd, &ad, h) == 3, "level 9 is ignored")
    var db: [u8; 64] = [0 as u8; 64]
    let dn: usize = a11y.a11y_description(&sd, &ad, tb, (&db[0]) as u64, 64)
    check(dn == 22 && db[0] == (65 as u8) && db[21] == (115 as u8), "describedby reads the text of the connected node")
    check(a11y.a11y_description(&sd, &ad, bt, (&db[0]) as u64, 64) == 0, "no description: 0")
    var t_ex: [u8; 5] = "Extra"
    a11y.a11y_set_description(&ad, bt, (&t_ex[0]) as u64, 5)
    check(a11y.a11y_description(&sd, &ad, bt, (&db[0]) as u64, 64) == 5, "an explicit description")

    say("-- the text dump\n")
    let tbuf: u64 = rt.heap_alloc(8192)
    let tn: usize = a11y.a11y_dump(&sd, &ad, tbuf, 8192)
    rt.write_everything(1, tbuf, tn)
    check(has(tbuf, tn, "heading \"Settings\" level=3 @"), "dump: heading with level")
    check(has(tbuf, tn, "textbox \"Name\" focusable value=\"ab\" desc=\"At least three letters\" @"), "dump: textbox with description")
    check(has(tbuf, tn, "button \"OK\" focusable desc=\"Extra\" @"), "dump: button named from content")
    check(a11y.a11y_unnamed(&sd, &ad) == 0, "no operable element without a name")

    say("-- the JSON export\n")
    let jn: usize = a11y.a11y_dump_json(&sd, &ad, tbuf, 8192)
    check(*(tbuf as *mut u8) == (123 as u8) && *((tbuf + (jn - 2) as u64) as *mut u8) == (125 as u8), "starts with { and ends with }")
    check(has(tbuf, jn, "{\"role\":\"heading\",\"name\":\"Settings\",\"states\":[],\"level\":3"), "json: heading + level")
    check(has(tbuf, jn, "\"role\":\"textbox\",\"name\":\"Name\",\"states\":[\"focusable\"],\"text\":\"ab\",\"desc\":\"At least three letters\""), "json: textbox + text + desc")
    check(has(tbuf, jn, "\"role\":\"button\",\"name\":\"OK\""), "json: button")
    check(!has(tbuf, jn, "unnamed"), "json: nothing unnamed")
    // brackets and braces balance
    var depth: i64 = 0
    var minimum: i64 = 0
    var q: usize = 0
    var instr: bool = false
    while q < jn {
        let b: u8 = *((tbuf + q as u64) as *mut u8)
        if b == (34 as u8) {
            instr = !instr
        } else if !instr {
            if b == (123 as u8) || b == (91 as u8) { depth = depth + 1 }
            if b == (125 as u8) || b == (93 as u8) { depth = depth - 1 }
            if depth < minimum { minimum = depth }
        }
        q = q + 1
    }
    check(depth == 0 && minimum == 0 && !instr, "json: braces, brackets and quotes balance")

    say("-- the pointer path\n")
    check(a11y.a11y_hit(&sd, &ad, 10.0, 75.0) == tb, "a point on the textbox hits the textbox")
    check(a11y.a11y_hit(&sd, &ad, 10.0, 105.0) == bt, "a point on the button hits the button")
    check(a11y.a11y_hit(&sd, &ad, 10.0, 10.0) == h, "a point on a heading (text) hits the heading")
    check(a11y.a11y_hit(&sd, &ad, 900.0, 900.0) == scene.SCENE_NONE, "a point outside hits nothing")

    canvas.canvas_free(&cv)
    painter.painter_free(&z)
    rt.buf_free(&fbuf)
    say("checks ok: ")
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&nb, OKS as i64)
    rt.buf_push(&nb, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&nb), rt.buf_len(&nb))
    rt.buf_free(&nb)
    if BAD > 0 {
        say("ACCESS FAILED\n")
        return 1
    }
    say("ACCESS PASSED\n")
    return 0
}
