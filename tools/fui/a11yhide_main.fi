// SPDX-License-Identifier: MPL-2.0
// tools/fui/a11yhide_main.fi -- hidden nodes are NOT in the accessibility tree: scene.node_set_hidden and a11y.a11y_set_hidden both drop the node and its subtree from a11y_dump / JSON / AT-SPI / UIA / tab order, and un-hiding brings them back.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.grid
import fui.inspect
import fui.safeout
import fui.sheet
import fui.anim
import fui.style
import fui.a11y
import fui.render
import fui.atspi
import fui.uia

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn num(tag: str, v: f64) {
    say(tag)
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v as i64)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

#[allow_escape]
fn dlen(a: *mut app.App, node: usize) -> usize {
    var db: [u8; 192] = [0 as u8; 192]
    let n: usize = a11y.a11y_description(app.app_scene(a), app.ax(a), node, (&db[0]) as u64, 192)
    return n
}

fn click(w: *mut fuiwirt.Host, x: f64, y: f64) {
    let m: u32 = fuiwirt.host_pointer_move(w, x, y)
    let d: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let u: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

fn pressed(a: *mut app.App) {
    CHANGES = CHANGES + 1
}

fn has(buf: u64, n: usize, what: str) -> bool {
    if what.n > n {
        return false
    }
    var i: usize = 0
    while i + what.n <= n {
        var j: usize = 0
        while j < what.n && *((buf + (i + j) as u64) as *mut u8) == *((what.p as u64 + j as u64) as *mut u8) {
            j = j + 1
        }
        if j == what.n {
            return true
        }
        i = i + 1
    }
    return false
}

fn dump_has(a: *mut app.App, name: str) -> bool {
    var db: [u8; 4096] = [0 as u8; 4096]
    let n: usize = a11y.a11y_dump(app.app_scene(a), app.ax(a), (&db[0]) as u64, 4096)
    return has((&db[0]) as u64, n, name)
}

fn json_has(a: *mut app.App, name: str) -> bool {
    var db: [u8; 8192] = [0 as u8; 8192]
    let n: usize = a11y.a11y_dump_json(app.app_scene(a), app.ax(a), (&db[0]) as u64, 8192)
    return has((&db[0]) as u64, n, name)
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("a11yhide: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Hide", 360, 240)
    let alpha: usize = app.button(a, "Alpha", pressed)
    let beta: usize = app.button(a, "Beta", pressed)
    let gamma: usize = app.button(a, "Gamma", pressed)
    let g: usize = appctl.grid(a, "1fr", "auto")
    let inner: usize = app.button(a, "Inner", pressed)
    app.end(a)
    let s: *mut Surface = surface_for(a, 360, 240)
    settle(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    let ax: *mut a11y.A11y = app.ax(a)
    var br: atspi.Bridge = atspi.bridge_new(sc, ax, "Hide")
    var pv: uia.Provider = uia.provider_new(sc, ax, "Hide")
    let par: usize = scene.scene_parent(sc, beta)
    let ep: uia.El = uia.el_from_node(&pv, par)
    let total0: usize = atspi.bridge_node_total(&br)
    let kids0: usize = uia.el_child_count(&pv, ep)
    let ord0: usize = a11y.a11y_order(sc, ax)
    check(dump_has(a, "Alpha") && dump_has(a, "Beta") && dump_has(a, "Gamma") && dump_has(a, "Inner"), "baseline: all four buttons are in the dump")
    check(json_has(a, "Beta") && json_has(a, "Inner"), "baseline: JSON has Beta and Inner")
    // ---- a scene-hidden node is gone everywhere
    scene.node_set_hidden(sc, beta, true)
    check(!dump_has(a, "Beta") && dump_has(a, "Alpha") && dump_has(a, "Gamma"), "scene-hidden Beta: not in the dump, neighbours stay")
    check(!json_has(a, "Beta") && json_has(a, "Alpha"), "scene-hidden Beta: not in the JSON")
    check(atspi.bridge_node_total(&br) == total0 - 1, "AT-SPI: one object fewer")
    check(uia.el_child_count(&pv, ep) == kids0 - 1, "UIA: parent has one child fewer")
    check(a11y.a11y_order(sc, ax) == ord0 - 1, "tab order: Beta is skipped")
    // ---- the explicit flag does the same for a painted node
    a11y.a11y_set_hidden(ax, gamma, true)
    check(a11y.a11y_hidden(sc, ax, gamma) && !scene.node_hidden(sc, gamma), "explicit flag: hidden for a11y, still painted")
    check(!dump_has(a, "Gamma") && !json_has(a, "Gamma"), "explicit flag: Gamma is not in the dump or JSON")
    check(atspi.bridge_node_total(&br) == total0 - 2 && uia.el_child_count(&pv, ep) == kids0 - 2, "AT-SPI and UIA agree: two fewer")
    // ---- hiding is inherited: the whole grid goes, Inner with it
    scene.node_set_hidden(sc, g, true)
    check(!dump_has(a, "Inner") && !json_has(a, "Inner"), "hidden container: its child is gone with it")
    check(atspi.bridge_node_total(&br) < total0 - 2, "AT-SPI: the subtree is not counted")
    // ---- un-hide: everything comes back
    scene.node_set_hidden(sc, beta, false)
    scene.node_set_hidden(sc, g, false)
    a11y.a11y_set_hidden(ax, gamma, false)
    check(dump_has(a, "Beta") && dump_has(a, "Gamma") && dump_has(a, "Inner"), "un-hidden: all back in the dump")
    check(atspi.bridge_node_total(&br) == total0 && uia.el_child_count(&pv, ep) == kids0 && a11y.a11y_order(sc, ax) == ord0, "un-hidden: counts are the baseline again")
    check(!a11y.a11y_hidden(sc, ax, 99999), "bad node id is not hidden (and harmless)")
    a11y.a11y_set_hidden(ax, 99999, true)
    if BAD == 0 {
        say("A11YHIDE PASSED\n")
        return 0
    }
    say("A11YHIDE FAILED\n")
    return 1
}
