// tools/fui/appw8_main.fi -- the range slider (appctl.range_slider) and the window timelines (appctl.timeline*) in the ten-line API.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.wave9
import fui.style
import fui.a11y
import fui.render

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

fn has_text(buf: *mut u8, n: usize, t: str) -> bool {
    if t.n == 0 || n < t.n {
        return false
    }
    var i: usize = 0
    while i + t.n <= n {
        var j: usize = 0
        while j < t.n && *(buf + i + j) == *((t.p as u64 + j as u64) as *mut u8) {
            j = j + 1
        }
        if j == t.n {
            return true
        }
        i = i + 1
    }
    return false
}

fn dump_has(a: *mut app.App, t: str) -> bool {
    let cap: usize = 16384
    let buf: *mut u8 = rt.heap_alloc(cap) as *mut u8
    let n: usize = a11y.a11y_dump(app.app_scene(a), app.ax(a), buf as u64, cap)
    var m: usize = n
    if m > cap {
        m = cap
    }
    return has_text(buf, m, t)
}

fn click(w: *mut fuiwirt.Host, x: f64, y: f64) {
    let m: u32 = fuiwirt.host_pointer_move(w, x, y)
    let d: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let u: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
}

fn streq(a: str, b: str) -> bool {
    if a.n != b.n { return false }
    var i: usize = 0
    while i < a.n {
        if *((a.p as u64 + i as u64) as *mut u8) != *((b.p as u64 + i as u64) as *mut u8) { return false }
        i = i + 1
    }
    return true
}

fn type_text(a: *mut app.App, s: str) {
    var i: usize = 0
    while i < s.n {
        let ch: u8 = *((s.p as u64 + i as u64) as *mut u8)
        let r: bool = app.app_char(a as u64, ch as u32, 0 as u32)
        i = i + 1
    }
}

fn key(a: *mut app.App, k: u32) -> bool {
    return app.app_key(a as u64, k, 0 as u32)
}

static mut PICKS: usize = 0
fn picked(a: *mut app.App, id: usize) {
    PICKS = PICKS + 1
}
static mut BOXES: usize = 0
fn boxed(a: *mut app.App, id: usize) {
    BOXES = BOXES + 1
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appw8: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Wave9", 600, 400)
    let cb: usize = appctl.combobox(a, "Country", picked)
    let box: usize = appctl.checkbox(a, "Under the list", false, boxed)
    let names: [str; 12] = ["Austria", "Australia", "Germany", "France", "Italy", "Spain", "Switzerland", "Belgium",
        "Sweden", "Norway", "Denmark", "Netherlands"]
    var ni: usize = 0
    var added: usize = 0
    while ni < 12 {
        if appctl.combobox_add(a, cb, names[ni]) { added = added + 1 }
        ni = ni + 1
    }
    let s: *mut Surface = surface_for(a, 600, 400)
    settle(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    let w: *mut fuiwirt.Host = app.app_host(a)
    check(cb != appctl.NONE && box != appctl.NONE && added == 12 && appctl.combobox_count(a, cb) == 12, "combobox and 12 items")
    check(a11y.a11y_role(sc, app.ax(a), cb) == a11y.ROLE_COMBOBOX, "the field is a combobox for the screen reader")
    check(!appctl.combobox_is_open(a, cb), "starts closed")
    check(dump_has(a, "combobox") && !dump_has(a, "listitem"), "closed: no list rows in the dump")
    // ---- typing filters and opens
    app.set_focus(a, cb)
    type_text(a, "au")
    settle(a, s)
    check(appctl.combobox_is_open(a, cb), "typing opens the list")
    check(appctl.combobox_results(a, cb) >= 2, "two letters match at least Austria and Australia")
    check(appctl.combobox_active(a, cb) == appctl.NONE, "no row active while typing")
    var rr: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    check(appctl.combobox_rect(a, cb, &rr) && rr[3] > 20.0 && rr[2] > 100.0, "the popup has a rectangle")
    var db: [u8; 64] = [0 as u8; 64]
    let dn: usize = a11y.a11y_description(sc, app.ax(a), cb, (&db[0]) as u64, 64)
    check(dn >= 9 && db[1] == 32 as u8, "the field carries 'N results'")
    check(dump_has(a, "listitem"), "open: the dump lists the rows")
    let li: usize = appctl.combobox_item_node(a, cb, 0)
    check(li != appctl.NONE && !scene.node_hidden(sc, li) && scene.node_w(sc, li) > 50.0, "row 0 is a visible node with a size")
    // ---- keys
    let k1: bool = key(a, editor.KEY_DOWN)
    check(k1 && appctl.combobox_active(a, cb) == 0, "Down: first row active")
    let k2: bool = key(a, editor.KEY_DOWN)
    check(appctl.combobox_active(a, cb) == 1, "Down again: second row")
    let k3: bool = key(a, editor.KEY_UP)
    check(appctl.combobox_active(a, cb) == 0, "Up: back to the first row")
    let want: str = appctl.combobox_row_text(a, cb, 0)
    PICKS = 0
    let k4: bool = key(a, editor.KEY_ENTER)
    check(k4 && PICKS == 1 && !appctl.combobox_is_open(a, cb), "Enter takes the row and shuts the list")
    check(streq(app.text(a, cb), want) && want.n > 0, "the field shows the picked item")
    check(appctl.combobox_picked(a, cb) != appctl.NONE && appctl.combobox_picked(a, cb) < 12, "the item index is known")
    settle(a, s)
    check(!dump_has(a, "listitem"), "after the pick the rows are gone from the dump")
    // an arrow key that only moves the caret does not reopen the list after a pick: Down does (opens on purpose)
    let k5: bool = key(a, editor.KEY_DOWN)
    check(k5 && appctl.combobox_is_open(a, cb), "Down on a closed list opens it")
    let k6: bool = key(a, editor.KEY_ESC)
    check(k6 && !appctl.combobox_is_open(a, cb), "Esc shuts it")
    let k7: bool = key(a, editor.KEY_ESC)
    check(!k7 || !appctl.combobox_is_open(a, cb), "Esc on a closed list is the app's")
    // ---- empty field: Down shows all, only 8 rows
    app.set_text(a, cb, "")
    settle(a, s)
    let k8: bool = key(a, editor.KEY_DOWN)
    settle(a, s)
    check(appctl.combobox_is_open(a, cb) && appctl.combobox_results(a, cb) == 12, "empty field: Down lists all 12")
    check(appctl.combobox_item_node(a, cb, 7) != appctl.NONE && appctl.combobox_item_node(a, cb, 8) == appctl.NONE, "8 rows at most")
    // ---- pointer: a click on row 1 picks it, and the checkbox under the popup stays untouched
    var r1: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    let ok1: bool = appctl.combobox_row_rect(a, cb, 1, &r1)
    check(ok1 && r1[3] > 10.0, "row 1 has a rectangle")
    let want1: str = appctl.combobox_row_text(a, cb, 1)
    PICKS = 0
    BOXES = 0
    click(w, r1[0] + r1[2] / 2.0, r1[1] + r1[3] / 2.0)
    settle(a, s)
    check(PICKS == 1 && streq(app.text(a, cb), want1) && !appctl.combobox_is_open(a, cb), "a click on a row takes it")
    check(BOXES == 0 && !appctl.checked(a, box), "the page control under the popup heard nothing")
    // ---- a click elsewhere shuts the list
    app.set_text(a, cb, "")
    let k9: bool = key(a, editor.KEY_DOWN)
    settle(a, s)
    check(appctl.combobox_is_open(a, cb), "open again")
    click(w, 580.0, 380.0)
    settle(a, s)
    check(!appctl.combobox_is_open(a, cb), "a click outside shuts the list")
    // ---- losing the focus shuts it
    app.set_focus(a, cb)
    app.set_text(a, cb, "")
    let k10: bool = key(a, editor.KEY_DOWN)
    check(appctl.combobox_is_open(a, cb), "open for the focus test")
    app.set_focus(a, box)
    settle(a, s)
    check(!appctl.combobox_is_open(a, cb), "another focus shuts the list")
    // ---- wheel scrolls the list
    app.set_focus(a, cb)
    app.set_text(a, cb, "")
    let k11: bool = key(a, editor.KEY_DOWN)
    settle(a, s)
    var rw: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    let okw: bool = appctl.combobox_rect(a, cb, &rw)
    let m0: u32 = fuiwirt.host_pointer_move(w, rw[0] + 10.0, rw[1] + 10.0)
    let wh: u32 = fuiwirt.host_pointer_down(w, rw[0] + 10.0, rw[1] + 10.0, fuiwirt.BTN_WHEEL_DOWN)
    check(okw && appctl.combobox_top(a, cb) == 3, "the wheel scrolls the list by three rows")
    // bad ids are harmless
    check(appctl.combobox_count(a, 9999) == 0 && !appctl.combobox_open(a, box), "bad ids are harmless")
    if BAD == 0 {
        say("APPW8 PASSED\n")
        return 0
    }
    say("APPW8 FAILED\n")
    return 1
}
