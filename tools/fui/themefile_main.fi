// SPDX-License-Identifier: MPL-2.0
// tools/fui/themefile_main.fi -- THE THEME FILE KEEPS ITS WORD.
//
// Two jobs.
//
//   themefile                 the acceptance cases of lib/fui/themefile.fi
//   themefile --builtin       check every theme of lib/fui/themelist.fi
//   themefile --print <n>     print built-in theme n (a start for your own)
//   themefile a.theme ...     check theme files: one line per file,
//                             exit 1 if any of them would be refused
//
// The second form is what a person who writes a theme runs -- the same
// check the program does before it applies the file, with the reason
// in words when it refuses.
import std.rt
import fui.theme
import fui.themefile
import fui.themelist

static mut G_BAD: usize = 0
static mut G_TOTAL: usize = 0

fn out(t: *mut rt.Buf) {
    rt.write_everything(1, rt.buf_ptr(t), rt.buf_len(t))
    rt.buf_free(t)
}

fn push_lit(t: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push_bytes(t, p, n)
}

fn dec2(t: *mut rt.Buf, h: i64) {
    rt.buf_push_dec_i64(t, h / 100)
    rt.buf_push(t, 46 as u8)
    if h % 100 < 10 {
        rt.buf_push(t, 48 as u8)
    }
    rt.buf_push_dec_i64(t, h % 100)
}

// One line of the report: what the file is called and what became of it.
fn report(t: *mut rt.Buf, r: *mut themefile.ThemeFile) {
    let e: u32 = themefile.themefile_err(r)
    if e == themefile.ERR_NONE {
        var s1: [u8; 23] = "accepted, weakest pair "
        push_lit(t, (&s1[0]) as u64, 23 as usize)
        var n: usize = 0
        let p: u64 = themefile.check_pair_name(themefile.themefile_worst(r), &n)
        rt.buf_push_bytes(t, p, n)
        rt.buf_push(t, 32 as u8)
        dec2(t, themefile.themefile_min(r))
        var s2: [u8; 2] = ":1"
        push_lit(t, (&s2[0]) as u64, 2 as usize)
        return
    }
    var s3: [u8; 9] = "REFUSED: "
    push_lit(t, (&s3[0]) as u64, 9 as usize)
    if e == themefile.ERR_SYNTAX {
        var a: [u8; 17] = "line without '=' "
        push_lit(t, (&a[0]) as u64, 17 as usize)
    } else if e == themefile.ERR_KEY {
        var b: [u8; 12] = "unknown key "
        push_lit(t, (&b[0]) as u64, 12 as usize)
    } else if e == themefile.ERR_VALUE {
        var c: [u8; 14] = "bad value for "
        push_lit(t, (&c[0]) as u64, 14 as usize)
    } else if e == themefile.ERR_CONTRAST {
        var d: [u8; 24] = "contrast under 4.5:1 in "
        push_lit(t, (&d[0]) as u64, 24 as usize)
    } else {
        var f: [u8; 16] = "ranking broken: "
        push_lit(t, (&f[0]) as u64, 16 as usize)
    }
    rt.buf_push_bytes(t, themefile.themefile_err_key(r),
        themefile.themefile_err_key_len(r))
    if themefile.themefile_err_line(r) > 0 {
        var g: [u8; 7] = " (line "
        push_lit(t, (&g[0]) as u64, 7 as usize)
        rt.buf_push_dec_i64(t, themefile.themefile_err_line(r) as i64)
        rt.buf_push(t, 41 as u8)
    }
    if e == themefile.ERR_CONTRAST {
        rt.buf_push(t, 32 as u8)
        dec2(t, themefile.themefile_min(r))
        var h: [u8; 4] = ":1, "
        push_lit(t, (&h[0]) as u64, 4 as usize)
        rt.buf_push_dec_i64(t, themefile.themefile_fails(r) as i64)
        var i: [u8; 8] = " pair(s)"
        push_lit(t, (&i[0]) as u64, 8 as usize)
    }
}

fn themefile_same(a: u64, b: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if rt.ld8(a, i) != rt.ld8(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// ============================================================ THE CASES
fn expect(nm: u64, nn: usize, ok: bool) {
    G_TOTAL = G_TOTAL + 1
    var t: rt.Buf = rt.buf_new()
    var s: [u8; 2] = "  "
    push_lit(&t, (&s[0]) as u64, 2 as usize)
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 52 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK\n"
        push_lit(&t, (&o[0]) as u64, 3 as usize)
    } else {
        G_BAD = G_BAD + 1
        var w: [u8; 10] = "WRONG <<<\n"
        push_lit(&t, (&w[0]) as u64, 10 as usize)
    }
    out(&t)
}

fn same_theme(a: *mut theme.Theme, b: *mut theme.Theme) -> bool {
    let fa: *mut theme.Colors = theme.theme_colors(a)
    let fb: *mut theme.Colors = theme.theme_colors(b)
    let sa: *mut theme.Shape = theme.theme_shape(a)
    let sb: *mut theme.Shape = theme.theme_shape(b)
    return (*fa).base == (*fb).base && (*fa).text == (*fb).text
    && (*fa).accent == (*fb).accent && (*fa).button == (*fb).button
    && (*fa).text_on_accent == (*fb).text_on_accent
    && (*fa).selection == (*fb).selection
    && (*fa).dark == (*fb).dark
    && (*sa).r_button == (*sb).r_button && (*sa).ctrl_h == (*sb).ctrl_h
    && (*sa).focus_w == (*sb).focus_w
    && theme.theme_scale(a) == theme.theme_scale(b)
}

// Is the key the last error named exactly `lit`?
fn key_is(r: *mut themefile.ThemeFile, lit: str) -> bool {
    if themefile.themefile_err_key_len(r) != lit.n {
        return false
    }
    var i: usize = 0
    while i < lit.n {
        if rt.ld8(themefile.themefile_err_key(r), i) != rt.ld8(lit.p as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn cases() {
    var r: themefile.ThemeFile = themefile.themefile_new()

    // 1. A good dark file: applied, colours and shape changed, the
    //    accent's partners derived, the scale kept.
    var m: theme.Theme = theme.theme_new(false)
    theme.theme_set_scale(&m, 1500)
    var f1: [u8; 268] = "# nord-ish\nname = Test Dark\nmode = dark\naccent = #88C0D0\nbase = #2E3440\nsurface = #3B4252\nsurface_raised = #3E475A\nbutton = #434C5E\nbutton_hover = #4C566A\nbutton_active = #5A657C\ntext = #ECEFF4\ntext_muted = #B4BCCB\ntext_disabled = #B4BCCB\nerror = #F09AA3\nr_button = 6\n"
    let ok1: bool = themefile.themefile_apply(&m, (&f1[0]) as u64, 268 as usize, &r)
    var c1: [u8; 20] = "good file is applied"
    expect((&c1[0]) as u64, 20 as usize, ok1 && themefile.themefile_ok(&r))
    let f: *mut theme.Colors = theme.theme_colors(&m)
    var c2: [u8; 35] = "colours, mode and length taken over"
    expect((&c2[0]) as u64, 35 as usize, (*f).base == 3028032 as u32
        && (*f).accent == 8962256 as u32 && theme.theme_is_dark(&m)
        && (*theme.theme_shape(&m)).r_button == 6)
    var c3: [u8; 45] = "text_on_accent derived (dark base on #88C0D0)"
    expect((&c3[0]) as u64, 45 as usize, (*f).text_on_accent == 3028032 as u32)
    var c4: [u8; 41] = "scale belongs to the device, not the file"
    expect((&c4[0]) as u64, 41 as usize, theme.theme_scale(&m) == 1500)
    var nm: [u8; 9] = "Test Dark"
    var c5: [u8; 9] = "name read"
    let nlen: usize = themefile.themefile_name_len(&r)
    var name_ok: bool = nlen == 9 as usize
    var i: usize = 0
    while name_ok && i < nlen {
        if rt.ld8(themefile.themefile_name(&r), i) != nm[i] {
            name_ok = false
        }
        i = i + 1
    }
    expect((&c5[0]) as u64, 9 as usize, name_ok)

    // 2. A typo is refused with its line, and the theme stays.
    var before: theme.Theme = m
    var f2: [u8; 25] = "name = X\nacent = #FF0000\n"
    let ok2: bool = themefile.themefile_apply(&m, (&f2[0]) as u64, 25 as usize, &r)
    var c6: [u8; 27] = "unknown key refused, line 2"
    expect((&c6[0]) as u64, 27 as usize, !ok2
        && themefile.themefile_err(&r) == themefile.ERR_KEY
        && themefile.themefile_err_line(&r) == 2)
    var c7: [u8; 39] = "refused file leaves the theme as it was"
    expect((&c7[0]) as u64, 39 as usize, same_theme(&m, &before))

    // 3. Not a colour.
    var f3: [u8; 15] = "text = #12345G\n"
    let ok3: bool = themefile.themefile_apply(&m, (&f3[0]) as u64, 15 as usize, &r)
    var c8: [u8; 18] = "bad colour refused"
    expect((&c8[0]) as u64, 18 as usize, !ok3
        && themefile.themefile_err(&r) == themefile.ERR_VALUE)

    // 4. A length out of range, and a line without '='.
    var f4: [u8; 11] = "ctrl_h = 4\n"
    let ok4: bool = themefile.themefile_apply(&m, (&f4[0]) as u64, 11 as usize, &r)
    var c9: [u8; 27] = "length out of range refused"
    expect((&c9[0]) as u64, 27 as usize, !ok4
        && themefile.themefile_err(&r) == themefile.ERR_VALUE)
    var f5: [u8; 23] = "mode = dark\njust words\n"
    let ok5: bool = themefile.themefile_apply(&m, (&f5[0]) as u64, 23 as usize, &r)
    var ca: [u8; 24] = "line without '=' refused"
    expect((&ca[0]) as u64, 24 as usize, !ok5
        && themefile.themefile_err(&r) == themefile.ERR_SYNTAX
        && themefile.themefile_err_line(&r) == 2)

    // 5. THE CONTRAST CHECK: grey on grey is legible to nobody.
    var f6: [u8; 34] = "mode = light\ntext_muted = #AAAAAA\n"
    let ok6: bool = themefile.themefile_apply(&m, (&f6[0]) as u64, 34 as usize, &r)
    var cb: [u8; 39] = "text_muted #AAAAAA refused for contrast"
    expect((&cb[0]) as u64, 39 as usize, !ok6
        && themefile.themefile_err(&r) == themefile.ERR_CONTRAST
        && themefile.themefile_worst(&r) == 8
        && themefile.themefile_min(&r) < 450)
    var cc: [u8; 23] = "... and the theme stays"
    expect((&cc[0]) as u64, 23 as usize, same_theme(&m, &before))

    // 6. A yellow accent in the light set: the derivation must put
    //    DARK text on it, otherwise white on yellow (1.4:1) would pass
    //    unnoticed.
    var m2: theme.Theme = theme.theme_new(false)
    var f7: [u8; 17] = "accent = #FFD400\n"
    let ok7: bool = themefile.themefile_apply(&m2, (&f7[0]) as u64, 17 as usize, &r)
    var cd: [u8; 40] = "yellow accent: dark text on it, accepted"
    expect((&cd[0]) as u64, 40 as usize, ok7
        && (*theme.theme_colors(&m2)).text_on_accent
        == (*theme.theme_colors(&m2)).text)

    // 7. An explicit text_on_accent that is unreadable is refused --
    //    the check does not trust the file.
    var f8: [u8; 42] = "accent = #FFD400\ntext_on_accent = #FFFFFF\n"
    let ok8: bool = themefile.themefile_apply(&m2, (&f8[0]) as u64, 42 as usize, &r)
    var ce: [u8; 23] = "white on yellow refused"
    expect((&ce[0]) as u64, 23 as usize, !ok8
        && themefile.themefile_worst(&r) == 11)

    // 8. The ranking: a hover that looks like rest is no feedback.
    var f9: [u8; 23] = "button_hover = #EDEDF0\n"
    let ok9: bool = themefile.themefile_apply(&m2, (&f9[0]) as u64, 23 as usize, &r)
    var cf: [u8; 29] = "equal button surfaces refused"
    expect((&cf[0]) as u64, 29 as usize, !ok9
        && themefile.themefile_err(&r) == themefile.ERR_RANK)

    // 8b. THE FILL RULE (Justin, 02.10.2026): a bordered widget must not have
    //     the fill of the ground under it. Each file below breaks it in one
    //     place and is refused as a RANK error naming the pair; the last one
    //     keeps it and is accepted.
    var m3: theme.Theme = theme.theme_new(false)
    var g1: [u8; 28] = "mode = dark\nfield = #2B2A33\n"
    let okg1: bool = themefile.themefile_apply(&m3, (&g1[0]) as u64, 28 as usize, &r)
    var cl1: [u8; 43] = "field = the surface: refused (field-ground)"
    expect((&cl1[0]) as u64, 43 as usize, !okg1
        && themefile.themefile_err(&r) == themefile.ERR_RANK
        && key_is(&r, "field-ground"))
    var g2: [u8; 34] = "mode = dark\nfield_focus = #1C1B22\n"
    let okg2: bool = themefile.themefile_apply(&m3, (&g2[0]) as u64, 34 as usize, &r)
    var cl2: [u8; 48] = "focused field = the page: refused (focus-ground)"
    expect((&cl2[0]) as u64, 48 as usize, !okg2
        && themefile.themefile_err(&r) == themefile.ERR_RANK
        && key_is(&r, "focus-ground"))
    var g3: [u8; 76] = "mode = dark\nbutton = #37373F\nbutton_hover = #4A4A55\nbutton_active = #5A5A66\n"
    let okg3: bool = themefile.themefile_apply(&m3, (&g3[0]) as u64, 76 as usize, &r)
    var cl3: [u8; 49] = "button = the raised card: refused (button-ground)"
    expect((&cl3[0]) as u64, 49 as usize, !okg3
        && themefile.themefile_err(&r) == themefile.ERR_RANK
        && key_is(&r, "button-ground"))
    var g4: [u8; 35] = "mode = light\nfield_focus = #EDEDF0\n"
    let okg4: bool = themefile.themefile_apply(&m3, (&g4[0]) as u64, 35 as usize, &r)
    var cl4: [u8; 46] = "focused = resting field: refused (field-focus)"
    expect((&cl4[0]) as u64, 46 as usize, !okg4
        && themefile.themefile_err(&r) == themefile.ERR_RANK
        && key_is(&r, "field-focus"))
    var g5: [u8; 50] = "mode = dark\nfield = #50505C\nfield_focus = #101015\n"
    let okg5: bool = themefile.themefile_apply(&m3, (&g5[0]) as u64, 50 as usize, &r)
    var cl5: [u8; 40] = "a field apart from every ground: applied"
    expect((&cl5[0]) as u64, 40 as usize, okg5 && themefile.themefile_ok(&r))

    // 9. Line order does not matter: accent above mode gives the same
    //    theme as accent below mode.
    var ma: theme.Theme = theme.theme_new(false)
    var mb: theme.Theme = theme.theme_new(false)
    var fa: [u8; 41] = "accent = #8040C0\nmode = dark\nr_panel = 4\n"
    var fb: [u8; 41] = "r_panel = 4\nmode = dark\naccent = #8040C0\n"
    let oka: bool = themefile.themefile_apply(&ma, (&fa[0]) as u64, 41 as usize, &r)
    let okb: bool = themefile.themefile_apply(&mb, (&fb[0]) as u64, 41 as usize, &r)
    var cg: [u8; 26] = "line order does not matter"
    expect((&cg[0]) as u64, 26 as usize, oka && okb && same_theme(&ma, &mb))

    // 10. B after A is B alone -- a file starts from the built-in set,
    //     not from the file loaded before.
    var mc: theme.Theme = theme.theme_new(true)
    var fc: [u8; 16] = "shape = classic\n"
    let okc: bool = themefile.themefile_apply(&ma, (&fc[0]) as u64, 16 as usize, &r)
    let okc2: bool = themefile.themefile_apply(&mc, (&fc[0]) as u64, 16 as usize, &r)
    var ch: [u8; 39] = "second file does not stack on the first"
    expect((&ch[0]) as u64, 39 as usize, okc && okc2 && same_theme(&ma, &mc)
        && (*theme.theme_shape(&ma)).r_button == 0)

    // 11. The empty file is the built-in theme.
    var md: theme.Theme = theme.theme_new(true)
    var me: theme.Theme = theme.theme_new(true)
    var fe: [u8; 12] = "\n# nothing\n\n"
    let oke: bool = themefile.themefile_apply(&md, (&fe[0]) as u64, 12 as usize, &r)
    var ci: [u8; 27] = "empty file = built-in theme"
    expect((&ci[0]) as u64, 27 as usize, oke && same_theme(&md, &me))

    // 12. The built-in sets pass the same check (the list is shared
    //     with contrast_main).
    var lt: theme.Colors = theme.colors_light()
    var dk: theme.Colors = theme.colors_dark()
    var r2: themefile.ThemeFile = themefile.themefile_new()
    let okl: bool = themefile.themefile_check(&lt, &r2)
    var r3: themefile.ThemeFile = themefile.themefile_new()
    let okd: bool = themefile.themefile_check(&dk, &r3)
    var cj: [u8; 38] = "built-in light and dark pass the check"
    expect((&cj[0]) as u64, 38 as usize, okl && okd)

    // 13. CRLF files (written on Windows) read the same.
    var mf: theme.Theme = theme.theme_new(false)
    var ff: [u8; 27] = "mode = dark\r\nr_button = 6\r\n"
    let okf: bool = themefile.themefile_apply(&mf, (&ff[0]) as u64, 27 as usize, &r)
    var ck: [u8; 19] = "CRLF line ends read"
    expect((&ck[0]) as u64, 19 as usize, okf && theme.theme_is_dark(&mf)
        && (*theme.theme_shape(&mf)).r_button == 6)
}

// ===================================================== BUILT-IN THEMES
fn check_one(t: *mut rt.Buf, p: u64, n: usize) -> bool {
    var m: theme.Theme = theme.theme_new(false)
    var r: themefile.ThemeFile = themefile.themefile_new()
    let ok: bool = themefile.themefile_apply(&m, p, n, &r)
    if ok {
        rt.buf_push(t, 34 as u8)
        rt.buf_push_bytes(t, themefile.themefile_name(&r),
            themefile.themefile_name_len(&r))
        rt.buf_push(t, 34 as u8)
        rt.buf_push(t, 32 as u8)
    }
    report(t, &r)
    rt.buf_push(t, 10 as u8)
    return ok
}

fn check_builtin() -> i32 {
    var bad: i32 = 0
    var i: usize = 0
    while i < themelist.THEME_COUNT {
        var n: usize = 0
        let p: u64 = themelist.builtin_text(i, &n)
        var t: rt.Buf = rt.buf_new()
        var s: [u8; 11] = "  built-in "
        push_lit(&t, (&s[0]) as u64, 11 as usize)
        rt.buf_push_dec_i64(&t, i as i64)
        var s2: [u8; 2] = ": "
        push_lit(&t, (&s2[0]) as u64, 2 as usize)
        if !check_one(&t, p, n) {
            bad = 1
        }
        out(&t)
        i = i + 1
    }
    return bad
}

// ======================================================= FILES FROM ARGV
fn check_files(start: u64) -> i32 {
    var bad: i32 = 0
    var i: usize = 1
    while i < rt.arg_count(start) {
        let path: u64 = rt.arg_ptr(start, i)
        var b: rt.Buf = rt.buf_new()
        var t: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&t, path, rt.c_length(path))
        var s: [u8; 2] = ": "
        push_lit(&t, (&s[0]) as u64, 2 as usize)
        if !rt.read_file(path, &b) {
            var e: [u8; 11] = "cannot read"
            push_lit(&t, (&e[0]) as u64, 11 as usize)
            rt.buf_push(&t, 10 as u8)
            bad = 1
        } else if !check_one(&t, rt.buf_ptr(&b), rt.buf_len(&b)) {
            bad = 1
        }
        out(&t)
        rt.buf_free(&b)
        i = i + 1
    }
    return bad
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) > 1 {
        let a: u64 = rt.arg_ptr(start, 1)
        var o1: [u8; 9] = "--builtin"
        var o2: [u8; 7] = "--print"
        if rt.c_length(a) == 9 as usize && themefile_same(a, (&o1[0]) as u64, 9 as usize) {
            return check_builtin()
        }
        if rt.c_length(a) == 7 as usize && themefile_same(a, (&o2[0]) as u64, 7 as usize) {
            if rt.arg_count(start) < 3 {
                return 2
            }
            let d: u64 = rt.arg_ptr(start, 2)
            let k: usize = (rt.ld8(d, 0) - 48 as u8) as usize
            var n: usize = 0
            let p: u64 = themelist.builtin_text(k, &n)
            if n == 0 {
                return 2
            }
            rt.write_everything(1, p, n)
            return 0
        }
        return check_files(start)
    }
    cases()
    var t: rt.Buf = rt.buf_new()
    var z1: [u8; 13] = "\nTHEME FILE: "
    push_lit(&t, (&z1[0]) as u64, 13 as usize)
    rt.buf_push_dec_i64(&t, (G_TOTAL - G_BAD) as i64)
    rt.buf_push(&t, 47 as u8)
    rt.buf_push_dec_i64(&t, G_TOTAL as i64)
    var z2: [u8; 12] = " cases hold\n"
    push_lit(&t, (&z2[0]) as u64, 12 as usize)
    out(&t)
    if G_BAD > 0 {
        return 1
    }
    return 0
}
