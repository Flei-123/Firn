import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.widget
import fui.sheet
import fui.style
import fui.syspref
import fui.flex
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.lay
import fui.a11y
import fui.appctl
import fui.safeout

static mut BAD: usize = 0
static mut TOTAL: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    TOTAL = TOTAL + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn num(tag: str, v: i64) {
    say(tag)
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    say("\n")
}

fn near_rgb(a: u32, b: u32, tol: i64) -> bool {
    var s: u32 = 0
    while s <= 16 {
        let x: i64 = ((a >> s) & 255 as u32) as i64
        let y: i64 = ((b >> s) & 255 as u32) as i64
        var d: i64 = x - y
        if d < 0 { d = 0 - d }
        if d > tol { return false }
        s = s + 8
    }
    return true
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    fuiwirt.host_bind(app.app_host(a))
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}


fn settle2(a: *mut app.App, s: *mut Surface) {
    lay.scroll_sync(a)
    frame(a, s)
    lay.scroll_sync(a)
    frame(a, s)
    lay.scroll_sync(a)
    frame(a, s)
}

fn nh(a: *mut app.App, n: usize) -> i64 { return scene.node_h(app.app_scene(a), n) as i64 }
fn ny(a: *mut app.App, n: usize) -> i64 { return scene.node_y(app.app_scene(a), n) as i64 }

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("layscroll: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let W: usize = 360
    let H: usize = 600
    let a: *mut app.App = app.window("Scroll", W, H)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, W, H)
    if s as u64 == 0 {
        return 9
    }
    lay.page(a)
    let bar: usize = lay.vbox(a)
    lay.min_h(a, bar, 56)
    lay.grow(a, bar, 0)
    app.end(a)
    let inner: usize = lay.scroll_v(a)
    let first: usize = app.spacer(a, 0, 40)
    var k: usize = 1
    var last: usize = first
    while k < 30 {
        last = app.spacer(a, 0, 40)
        k = k + 1
    }
    app.end(a)
    let foot: usize = lay.vbox(a)
    lay.min_h(a, foot, 50)
    lay.grow(a, foot, 0)
    app.end(a)
    settle2(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    let vn: usize = scene.scene_parent(sc, inner)
    say("-- area\n")
    check(nh(a, vn) == (H as i64) - 56 - 50, "the scroll area takes the room between bar and footer")
    check(ny(a, vn) == 56, "it starts below the bar")
    check(ny(a, foot) + nh(a, foot) == H as i64, "the footer still ends at the window bottom")
    check(nh(a, inner) >= 1200, "the inner column is as high as its 30 rows (1200)")
    check(ny(a, inner) == 56, "scrolled to the top")
    say("-- wheel\n")
    let w: *mut fuiwirt.Host = app.app_host(a)
    let r0: u32 = fuiwirt.host_pointer_move(w, 180.0, 300.0)
    let r1: u32 = fuiwirt.host_pointer_down(w, 180.0, 300.0, fuiwirt.BTN_WHEEL_DOWN)
    settle2(a, s)
    check(lay.scroll_offset(0) > 0.0, "the wheel scrolls the area")
    check(ny(a, inner) < 56, "the content moved up")
    check(nh(a, foot) == 50 && ny(a, foot) + 50 == H as i64, "bar and footer stay put")
    lay.scroll_to(0, 100000.0)
    settle2(a, s)
    check(ny(a, inner) + nh(a, inner) == ny(a, vn) + nh(a, vn), "offset clamps: the end of the content meets the end of the area")
    lay.scroll_to(0, 0.0)
    settle2(a, s)
    check(ny(a, inner) == 56, "back to the top")
    say("\n")
    num("checks: ", TOTAL as i64)
    num("wrong: ", BAD as i64)
    if BAD == 0 {
        say("LAYSCROLL PASSED\n")
        return 0
    }
    say("LAYSCROLL FAILED\n")
    return 1
}
