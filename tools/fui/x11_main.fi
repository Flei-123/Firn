    var h55: [u8; 28] = [18, 0, 7, 0, 1, 0, 32, 0, 240, 0, 0, 0, 4, 0, 0, 0, 32, 0, 0, 0, 1, 0, 0, 0, 241, 0, 0, 0]
    var t54: [u8; 38] = "1 ChangeProperty WM_PROTOCOLS = 1 Atom"
