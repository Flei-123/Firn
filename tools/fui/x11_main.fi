    rt.buf_clear(&b)
    backend.req_put_image_head(&b, WID, WID + 1 as u32, 1240, 13, 0, 26, 24 as u32, 64480)
    var h59: [u8; 24] = [72, 2, 254, 62, 1, 0, 32, 0, 2, 0, 32, 0, 216, 4, 13, 0, 0, 0, 26, 0, 0, 24, 0, 0]
    var t58: [u8; 41] = "1 PutImage-Kopf, 13 Zeilen (Laenge 16126)"
    hexchk((&t58[0]) as u64, 41, &b, (&h59[0]) as u64, 24)
