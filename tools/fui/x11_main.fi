    var su: backend.Setup = backend.setup_new()
    let grund: u32 = backend.setup_parse(sb.ptr, sb.len, &su)
    var t67: [u8; 29] = "2 Aufbau angenommen (Grund 0)"
    chk((&t67[0]) as u64, 29, grund == 0 as u32, (grund) as i64, (0) as i64)
    var t68: [u8; 44] = "2 Wurzelfenster 1293 (xwininfo -root: 0x50d)"
    chk((&t68[0]) as u64, 44, su.root == 1293 as u32, (su.root) as i64, (1293) as i64)
    var t69: [u8; 24] = "2 Kennungsbasis 0x200000"
    chk((&t69[0]) as u64, 24, su.id_base == 2097152 as u32, (su.id_base) as i64, (2097152) as i64)
    var t70: [u8; 24] = "2 Kennungsmaske 0x1fffff"
    chk((&t70[0]) as u64, 24, su.id_mask == 2097151 as u32, (su.id_mask) as i64, (2097151) as i64)
    var t71: [u8; 37] = "2 Schirm 1400 Punkte breit (xdpyinfo)"
    chk((&t71[0]) as u64, 37, su.s_px_w == 1400, (su.s_px_w) as i64, (1400) as i64)
    var t72: [u8; 35] = "2 Schirm 900 Punkte hoch (xdpyinfo)"
    chk((&t72[0]) as u64, 35, su.s_px_h == 900, (su.s_px_h) as i64, (900) as i64)
    var t73: [u8; 32] = "2 Schirm 370 mm breit (xdpyinfo)"
    chk((&t73[0]) as u64, 32, su.s_mm_w == 370, (su.s_mm_w) as i64, (370) as i64)
    var t74: [u8; 39] = "2 24-Bit-Visual 0x21 (xdpyinfo default)"
    chk((&t74[0]) as u64, 39, su.visual == 33 as u32 && su.depth == 24 as u32, (su.visual) as i64, (33) as i64)
    var t75: [u8; 35] = "2 Tastencodes 8..255 (xmodmap -pke)"
    chk((&t75[0]) as u64, 35, su.kmin == 8 as u32 && su.kmax == 255 as u32, (su.kmax) as i64, (255) as i64)
    let dpi_mm: usize = backend.dpi_from_mm(su.s_px_w, su.s_mm_w)
    var t76: [u8; 36] = "2 Dichte aus mm: 96 (xdpyinfo 96x96)"
    chk((&t76[0]) as u64, 36, dpi_mm == 96, (dpi_mm) as i64, (96) as i64)
    var t77: [u8; 33] = "2 und 2800 Punkte auf 370 mm: 192"
    chk((&t77[0]) as u64, 33, backend.dpi_from_mm(2800, 370) == 192, (backend.dpi_from_mm(2800, 370)) as i64, (192) as i64)
    var abgelehnt: [u8; 8] = [0, 5, 11, 0, 0, 0, 2, 0]
    var su2: backend.Setup = backend.setup_new()
    let g2: u32 = backend.setup_parse((&abgelehnt[0]) as u64, 8, &su2)
    var t78: [u8; 32] = "2 Status 0 = abgelehnt (Grund 5)"
    chk((&t78[0]) as u64, 32, g2 == 5 as u32, (g2) as i64, (5) as i64)
    let g3: u32 = backend.setup_parse(sb.ptr, 30, &su2)
    var t79: [u8; 25] = "2 abgeschnitten = Grund 7"
    chk((&t79[0]) as u64, 25, g3 == 7 as u32, (g3) as i64, (7) as i64)

    // ----------------------------------- 3: Xft.dpi AUS DEM SERVER
    var p_res: [u8; 24] = "testdata/x11/resman.bin\0"
    var rb: rt.Buf = rt.buf_new()
    let da_r: bool = rt.read_file((&p_res[0]) as u64, &rb)
    let d144: usize = backend.resman_dpi(rb.ptr, rb.len)
    var t80: [u8; 43] = "3 RESOURCE_MANAGER nach xrdb 'Xft.dpi: 144'"
    chk((&t80[0]) as u64, 43, da_r && d144 == 144, (d144) as i64, (144) as i64)
    var r192: [u8; 47] = "Xcursor.size: 24\nXft.dpi:\t192\nXft.antialias:\t1\n"
    let d192: usize = backend.xft_dpi_in((&r192[0]) as u64, 47)
    var t81: [u8; 29] = "3 Xft.dpi mitten im Text: 192"
    chk((&t81[0]) as u64, 29, d192 == 192, (d192) as i64, (192) as i64)
    var r0: [u8; 17] = "Xft.antialias:\t1\n"
    var t82: [u8; 38] = "3 ohne Xft.dpi: 0 (dann gelten die mm)"
    chk((&t82[0]) as u64, 38, backend.xft_dpi_in((&r0[0]) as u64, 17) == 0, (backend.xft_dpi_in((&r0[0]) as u64, 17)) as i64, (0) as i64)

    // ------------------------------------------- 4: DIE TASTATUR
    var p_kus: [u8; 27] = "testdata/x11/keymap_us.bin\0"
    var p_kde: [u8; 27] = "testdata/x11/keymap_de.bin\0"
    var p_mus: [u8; 27] = "testdata/x11/modmap_us.bin\0"
    var p_mde: [u8; 27] = "testdata/x11/modmap_de.bin\0"
    var kb: rt.Buf = rt.buf_new()
    var mb: rt.Buf = rt.buf_new()
    var us: backend.Keymap = backend.keymap_new()
    var de: backend.Keymap = backend.keymap_new()
    let a1: bool = rt.read_file((&p_kus[0]) as u64, &kb)
    let a2: bool = backend.keymap_from_reply(&us, kb.ptr, kb.len, 8 as u32)
    rt.buf_clear(&kb)
    let a3: bool = rt.read_file((&p_kde[0]) as u64, &kb)
    let a4: bool = backend.keymap_from_reply(&de, kb.ptr, kb.len, 8 as u32)
    let a5: bool = rt.read_file((&p_mus[0]) as u64, &mb)
    let a6: bool = backend.keymap_mods_from_reply(&us, mb.ptr, mb.len)
    rt.buf_clear(&mb)
    let a7: bool = rt.read_file((&p_mde[0]) as u64, &mb)
    let a8: bool = backend.keymap_mods_from_reply(&de, mb.ptr, mb.len)
    var t83: [u8; 45] = "4 Belegung US: 7 Keysyms je Taste, 248 Tasten"
    chk((&t83[0]) as u64, 45, a1 && a2 && us.per == 7 && us.n == 248, (us.n) as i64, (248) as i64)
    var t84: [u8; 28] = "4 Belegung DE ebenso gelesen"
    chk((&t84[0]) as u64, 28, a3 && a4 && de.per == 7 && de.n == 248, (de.n) as i64, (248) as i64)
    var t85: [u8; 38] = "4 AltGr ist Mod5 = 128 (Tasten 92/203)"
    chk((&t85[0]) as u64, 38, a8 && de.lvl3 == 128 as u32, (de.lvl3) as i64, (128) as i64)
    var t86: [u8; 34] = "4 NumLock ist Mod2 = 16 (Taste 77)"
    chk((&t86[0]) as u64, 34, de.numlock == 16 as u32, (de.numlock) as i64, (16) as i64)
    var t87: [u8; 19] = "4 US 38 -> a (0x61)"
    chk((&t87[0]) as u64, 19, backend.keymap_sym(&us, 38 as u32, 0 as u32) == 97 as u32, (backend.keymap_sym(&us, 38 as u32, 0 as u32)) as i64, (97) as i64)
    var t88: [u8; 30] = "4 US 38 + Umschalt -> A (0x41)"
    chk((&t88[0]) as u64, 30, backend.keymap_sym(&us, 38 as u32, 1 as u32) == 65 as u32, (backend.keymap_sym(&us, 38 as u32, 1 as u32)) as i64, (65) as i64)
    var t89: [u8; 23] = "4 US 38 + CapsLock -> A"
    chk((&t89[0]) as u64, 23, backend.keymap_sym(&us, 38 as u32, 2 as u32) == 65 as u32, (backend.keymap_sym(&us, 38 as u32, 2 as u32)) as i64, (65) as i64)
    var t90: [u8; 34] = "4 US 38 + CapsLock + Umschalt -> a"
    chk((&t90[0]) as u64, 34, backend.keymap_sym(&us, 38 as u32, 3 as u32) == 97 as u32, (backend.keymap_sym(&us, 38 as u32, 3 as u32)) as i64, (97) as i64)
    var t91: [u8; 35] = "4 US 47 + Umschalt -> colon (C-033)"
    chk((&t91[0]) as u64, 35, backend.keymap_sym(&us, 47 as u32, 1 as u32) == 58 as u32, (backend.keymap_sym(&us, 47 as u32, 1 as u32)) as i64, (58) as i64)
    var t92: [u8; 44] = "4 US 10 + CapsLock bleibt 1 (kein Buchstabe)"
    chk((&t92[0]) as u64, 44, backend.keymap_sym(&us, 10 as u32, 2 as u32) == 49 as u32, (backend.keymap_sym(&us, 10 as u32, 2 as u32)) as i64, (49) as i64)
    var t93: [u8; 40] = "4 US 20 -> minus, DE 20 -> ssharp (0xdf)"
    chk((&t93[0]) as u64, 40, backend.keymap_sym(&us, 20 as u32, 0 as u32) == 45 as u32 && backend.keymap_sym(&de, 20 as u32, 0 as u32) == 223 as u32, (backend.keymap_sym(&de, 20 as u32, 0 as u32)) as i64, (223) as i64)
    var t94: [u8; 30] = "4 DE 20 + Umschalt -> question"
    chk((&t94[0]) as u64, 30, backend.keymap_sym(&de, 20 as u32, 1 as u32) == 63 as u32, (backend.keymap_sym(&de, 20 as u32, 1 as u32)) as i64, (63) as i64)
    var t95: [u8; 24] = "4 US 29 -> y, DE 29 -> z"
    chk((&t95[0]) as u64, 24, backend.keymap_sym(&us, 29 as u32, 0 as u32) == 121 as u32 && backend.keymap_sym(&de, 29 as u32, 0 as u32) == 122 as u32, (backend.keymap_sym(&de, 29 as u32, 0 as u32)) as i64, (122) as i64)
    var t96: [u8; 28] = "4 DE 24 + AltGr -> at (0x40)"
    chk((&t96[0]) as u64, 28, backend.keymap_sym(&de, 24 as u32, 128 as u32) == 64 as u32, (backend.keymap_sym(&de, 24 as u32, 128 as u32)) as i64, (64) as i64)
    var t97: [u8; 34] = "4 DE 34 -> udiaeresis, Zeichen 252"
    chk((&t97[0]) as u64, 34, backend.ks_char(backend.keymap_sym(&de, 34 as u32, 0 as u32)) == 252 as u32, (backend.ks_char(backend.keymap_sym(&de, 34 as u32, 0 as u32))) as i64, (252) as i64)
    var t98: [u8; 41] = "4 US 23 + Umschalt -> ISO_Left_Tab 0xfe20"
    chk((&t98[0]) as u64, 41, backend.keymap_sym(&us, 23 as u32, 1 as u32) == 65056 as u32, (backend.keymap_sym(&us, 23 as u32, 1 as u32)) as i64, (65056) as i64)
    var t99: [u8; 34] = "4 ISO_Left_Tab ist die Taste K_TAB"
    chk((&t99[0]) as u64, 34, backend.ks_key(65056 as u32) == window.K_TAB, (backend.ks_key(65056 as u32)) as i64, (window.K_TAB) as i64)
    var t100: [u8; 28] = "4 US 9 -> Escape -> K_ESCAPE"
    chk((&t100[0]) as u64, 28, backend.ks_key(backend.keymap_sym(&us, 9 as u32, 0 as u32)) == window.K_ESCAPE, (backend.ks_key(backend.keymap_sym(&us, 9 as u32, 0 as u32))) as i64, (window.K_ESCAPE) as i64)
    var t101: [u8; 22] = "4 US 111 -> Up -> K_UP"
    chk((&t101[0]) as u64, 22, backend.ks_key(backend.keymap_sym(&us, 111 as u32, 0 as u32)) == window.K_UP, (backend.ks_key(backend.keymap_sym(&us, 111 as u32, 0 as u32))) as i64, (window.K_UP) as i64)
    var t102: [u8; 32] = "4 KP_Enter (0xff8d) ist K_RETURN"
    chk((&t102[0]) as u64, 32, backend.ks_key(65421 as u32) == window.K_RETURN, (backend.ks_key(65421 as u32)) as i64, (window.K_RETURN) as i64)
    // Spalte 6 von Taste 20 in der deutschen Belegung ist U1E9E
    // (xmodmap_de.txt: "keycode 20 = ssharp question ... U1E9E").
    let eszett: u32 = backend.keymap_col(&de, 20 as u32, 6)
    var t103: [u8; 35] = "4 DE 20 Spalte 6 = Keysym 0x1001e9e"
    chk((&t103[0]) as u64, 35, eszett == 16785054 as u32, (eszett) as i64, (16785054) as i64)
    var t104: [u8; 42] = "4 U1E9E (grosses Eszett) -> Zeichen 0x1e9e"
    chk((&t104[0]) as u64, 42, backend.ks_char(eszett) == 7838 as u32, (backend.ks_char(eszett)) as i64, (7838) as i64)
    var t105: [u8; 22] = "4 KP_5 (0xffb5) -> '5'"
    chk((&t105[0]) as u64, 22, backend.ks_char(65461 as u32) == 53 as u32, (backend.ks_char(65461 as u32)) as i64, (53) as i64)
    var t106: [u8; 43] = "4 tote Taste dead_diaeresis -> kein Zeichen"
    chk((&t106[0]) as u64, 43, backend.ks_char(65111 as u32) == 0 as u32, (backend.ks_char(65111 as u32)) as i64, (0) as i64)

    // ------------------------------------------- 5: DIE EREIGNISSE
    var p_ev: [u8; 24] = "testdata/x11/events.bin\0"
    var eb: rt.Buf = rt.buf_new()
    let da_e: bool = rt.read_file((&p_ev[0]) as u64, &eb)
    var t107: [u8; 29] = "5 16 Ereignisse im Mitschnitt"
    chk((&t107[0]) as u64, 29, da_e && eb.len == 512, (eb.len) as i64, (512) as i64)
    var k: u32 = 0 as u32
    var ea: u32 = 0 as u32
    var ex: u32 = 0 as u32
    var ey: u32 = 0 as u32
    var es: u32 = 0 as u32
    var ok: bool = backend.decode_event(eb.ptr, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t108: [u8; 10] = "5 0 Expose"
    chk((&t108[0]) as u64, 10, ok && k == window.EV_EXPOSE, (k) as i64, (window.EV_EXPOSE) as i64)
    ok = backend.decode_event(eb.ptr + 32 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t109: [u8; 40] = "5 1 Motion bei 50,40 (xdotool mousemove)"
    chk((&t109[0]) as u64, 40, ok && k == window.EV_MOTION && ex == 50 as u32 && ey == 40 as u32, (ex * 1000 as u32 + ey) as i64, (50040) as i64)
    ok = backend.decode_event(eb.ptr + 64 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t110: [u8; 21] = "5 2 Knopf 1 gedrueckt"
    chk((&t110[0]) as u64, 21, ok && k == window.EV_BUTTON && ea == 1 as u32, (ea) as i64, (1) as i64)
    ok = backend.decode_event(eb.ptr + 96 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t111: [u8; 46] = "5 3 Knopf 1 losgelassen, Zustand Button1 (256)"
    chk((&t111[0]) as u64, 46, ok && k == window.EV_RELEASE && ea == 1 as u32 && es == 256 as u32, (es) as i64, (256) as i64)
    ok = backend.decode_event(eb.ptr + 96 as u64, A_DELETE, &us, false, &k, &ea, &ex, &ey, &es)
    var t112: [u8; 35] = "5 3 ohne full_input: kein Loslassen"
    chk((&t112[0]) as u64, 35, !ok, (b2i(ok)) as i64, (0) as i64)
    ok = backend.decode_event(eb.ptr + 128 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t113: [u8; 24] = "5 4 Rad runter = Knopf 5"
    chk((&t113[0]) as u64, 24, ok && k == window.EV_BUTTON && ea == 5 as u32, (ea) as i64, (5) as i64)
    ok = backend.decode_event(eb.ptr + 192 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t114: [u8; 41] = "5 6 Taste a -> Zeichen 97, Keysym in ev_x"
    chk((&t114[0]) as u64, 41, ok && k == window.EV_CHAR && ea == 97 as u32 && ex == 97 as u32, (ea) as i64, (97) as i64)
    ok = backend.decode_event(eb.ptr + 224 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t115: [u8; 43] = "5 7 a losgelassen: EV_KEY_UP, Tastencode 38"
    chk((&t115[0]) as u64, 43, ok && k == window.EV_KEY_UP && ea == 38 as u32, (ea) as i64, (38) as i64)
    ok = backend.decode_event(eb.ptr + 288 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t116: [u8; 28] = "5 9 Umschalt+a -> Zeichen 65"
    chk((&t116[0]) as u64, 28, ok && k == window.EV_CHAR && ea == 65 as u32, (ea) as i64, (65) as i64)
    ok = backend.decode_event(eb.ptr + 320 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t117: [u8; 24] = "5 10 Tab -> EV_KEY K_TAB"
    chk((&t117[0]) as u64, 24, ok && k == window.EV_KEY && ea == window.K_TAB, (ea) as i64, (window.K_TAB) as i64)
    ok = backend.decode_event(eb.ptr + 352 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t118: [u8; 30] = "5 11 Escape -> EV_KEY K_ESCAPE"
    chk((&t118[0]) as u64, 30, ok && k == window.EV_KEY && ea == window.K_ESCAPE, (ea) as i64, (window.K_ESCAPE) as i64)
    ok = backend.decode_event(eb.ptr + 384 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t119: [u8; 23] = "5 12 Hinaus bei 600,500"
    chk((&t119[0]) as u64, 23, ok && k == window.EV_LEAVE && ex == 600 as u32 && ey == 500 as u32, (ex) as i64, (600) as i64)
    ok = backend.decode_event(eb.ptr + 416 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t120: [u8; 21] = "5 13 Hinein bei 20,30"
    chk((&t120[0]) as u64, 21, ok && k == window.EV_ENTER && ex == 20 as u32 && ey == 30 as u32, (ey) as i64, (30) as i64)
    ok = backend.decode_event(eb.ptr + 448 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t121: [u8; 28] = "5 14 ConfigureNotify 320x240"
    chk((&t121[0]) as u64, 28, ok && k == window.EV_CONFIGURE && ex == 320 as u32 && ey == 240 as u32, (ex) as i64, (320) as i64)
    ok = backend.decode_event(eb.ptr + 480 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t122: [u8; 46] = "5 15 SendEvent-Code 161 WM_DELETE -> EV_CLOSED"
    chk((&t122[0]) as u64, 46, ok && k == window.EV_CLOSED && rt.ld8(eb.ptr, 480) == 161 as u8, (rt.ld8(eb.ptr, 480)) as i64, (161) as i64)
    var leer: backend.Keymap = backend.keymap_new()
    ok = backend.decode_event(eb.ptr + 192 as u64, A_DELETE, &leer, true, &k, &ea, &ex, &ey, &es)
    var t123: [u8; 41] = "5 ohne Belegung: alter Weg key_ascii -> a"
    chk((&t123[0]) as u64, 41, ok && k == window.EV_CHAR && ea == 97 as u32, (ea) as i64, (97) as i64)

    // ----------------------------------------------- 6: ~/.Xauthority
    var p_xa: [u8; 24] = "testdata/x11/xauthority\0"
    var xb: rt.Buf = rt.buf_new()
    var an: rt.Buf = rt.buf_new()
    var ad: rt.Buf = rt.buf_new()
    let da_x: bool = rt.read_file((&p_xa[0]) as u64, &xb)
    let x7: bool = backend.auth_pick(xb.ptr, xb.len, 7, &an, &ad)
    var t124: [u8; 41] = "6 Anzeige 7: Keks 0f1e..f0 (xauth add :7)"
    chk((&t124[0]) as u64, 41, da_x && x7 && ad.len == 16 && rt.ld8(ad.ptr, 0) == 15 as u8 && rt.ld8(ad.ptr, 15) == 240 as u8, (rt.ld8(ad.ptr, 0)) as i64, (15) as i64)
    var t125: [u8; 30] = "6 Name MIT-MAGIC-COOKIE-1 (18)"
    chk((&t125[0]) as u64, 30, an.len == 18 && rt.ld8(an.ptr, 0) == 77 as u8, (an.len) as i64, (18) as i64)
    let x12: bool = backend.auth_pick(xb.ptr, xb.len, 12, &an, &ad)
    var t126: [u8; 39] = "6 Anzeige 12 (zweistellig): Keks dead.."
    chk((&t126[0]) as u64, 39, x12 && rt.ld8(ad.ptr, 0) == 222 as u8, (rt.ld8(ad.ptr, 0)) as i64, (222) as i64)
    let x9: bool = backend.auth_pick(xb.ptr, xb.len, 9, &an, &ad)
    var t127: [u8; 45] = "6 Anzeige 9 fehlt: der erste Eintrag (0011..)"
    chk((&t127[0]) as u64, 45, x9 && rt.ld8(ad.ptr, 1) == 17 as u8, (rt.ld8(ad.ptr, 1)) as i64, (17) as i64)

    // ------------------------------------------------ 7: DAS BILDFORMAT
    var q: [u8; 8] = [17, 34, 51, 255, 1, 2, 3, 255]
    var zq: [u8; 8] = [0; 8]
    fuiwirt.rgba_to_bgrx((&q[0]) as u64, (&zq[0]) as u64, 2)
    var t128: [u8; 38] = "7 RGBA 11 22 33 ff -> BGRX 33 22 11 00"
    chk((&t128[0]) as u64, 38, zq[0] == 51 as u8 && zq[1] == 34 as u8 && zq[2] == 17 as u8 && zq[3] == 0 as u8, (zq[0]) as i64, (51) as i64)
    var t129: [u8; 39] = "7 zweiter Punkt 01 02 03 -> 03 02 01 00"
    chk((&t129[0]) as u64, 39, zq[4] == 3 as u8 && zq[6] == 1 as u8 && zq[7] == 0 as u8, (zq[4]) as i64, (3) as i64)
    var cv: canvas.Canvas = canvas.canvas_new()
    let ci: bool = canvas.canvas_init(&cv, 4, 2)
    canvas.canvas_clear(&cv, 4281558681 as u32)
    var px8: [u8; 32] = [0; 32]
    fuiwirt.rgba_to_bgrx(canvas.canvas_pixels(&cv) as u64, (&px8[0]) as u64, 8)
    let pixel: u32 = ld32((&px8[0]) as u64, 20)
    var t130: [u8; 41] = "7 Leinwand 0xFF336699 -> X-Pixel 0x336699"
    chk((&t130[0]) as u64, 41, pixel == 3368601 as u32, (pixel) as i64, (3368601) as i64)
    canvas.canvas_free(&cv)

    // ------------------------------------ 8..10: DIE SEITE AUS gallery9
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 2 {
        have = rt.read_file(rt.arg_ptr(start, 1), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet = rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    var t131: [u8; 44] = "8 Schrift geladen (ohne Schrift keine Masse)"
    chk((&t131[0]) as u64, 44, fm != 0, (b2i(fm != 0)) as i64, (1) as i64)
    let texte: u64 = rt.heap_alloc(640)
    let feld: u64 = rt.heap_alloc(gallery9_main.ZEILEN * gallery9_main.SCHRITT)
    gallery9_main.schreibe_texte(texte)
    gallery9_main.schreibe_zeilen(feld)
    // 1000: die Zahlen, die gallery9 am Bild belegt (168, 56, 34, 1130).
    massstab(fm, texte, feld, 1000, 168, 56, 34, 1130)
    // 2000: jede davon genau doppelt -- der Beweis, dass der Baum keinen
    // zweiten Rechenweg hat.
    massstab(fm, texte, feld, 2000, 336, 112, 68, 2260)
    // 1500: 168 * 1,5 = 252, 56 -> 84, 34 -> 51; der Inhalt aus
    // 12 + 28*51 + 27*9 + 12 = 1695.
    massstab(fm, texte, feld, 1500, 252, 84, 51, 1695)
    bedienung(fm, texte, feld)

    var t132: [u8; 47] = "11 Zahl der Behauptungen in diesem Lauf (>= 30)"
    chk((&t132[0]) as u64, 47, G_ZAHL >= 30, (G_ZAHL) as i64, (30) as i64)
    if G_FEHLER != 0 {
        var r1: [u8; 30] = "X11 NOT PASSED -- WRONG above\n"
        rt.write_everything(1, (&r1[0]) as u64, 30)
        return 1
    }
    var s1: [u8; 12] = "X11 PASSED.\n"
    rt.write_everything(1, (&s1[0]) as u64, 12)
    return 0
}
