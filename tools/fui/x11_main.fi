    let x12: bool = backend.auth_pick(xb.ptr, xb.len, 12, &an, &ad)
    var t128: [u8; 39] = "6 Anzeige 12 (zweistellig): Keks dead.."
    chk((&t128[0]) as u64, 39, x12 && rt.ld8(ad.ptr, 0) == 222 as u8, (rt.ld8(ad.ptr, 0)) as i64, (222) as i64)
    let x9: bool = backend.auth_pick(xb.ptr, xb.len, 9, &an, &ad)
    var t129: [u8; 45] = "6 Anzeige 9 fehlt: der erste Eintrag (0011..)"
