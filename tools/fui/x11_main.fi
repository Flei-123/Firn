    var t116: [u8; 41] = "5 6 Taste a -> Zeichen 97, Keysym in ev_x"
    chk((&t116[0]) as u64, 41, ok && k == window.EV_CHAR && ea == 97 as u32 && ex == 97 as u32, (ea) as i64, (97) as i64)
    ok = backend.decode_event(eb.ptr + 224 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t117: [u8; 43] = "5 7 a losgelassen: EV_KEY_UP, Tastencode 38"
