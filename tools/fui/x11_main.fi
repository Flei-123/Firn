    var h45: [u8; 48] = [108, 0, 11, 0, 0, 0, 18, 0, 16, 0, 0, 0, 77, 73, 84, 45, 77, 65, 71, 73, 67, 45, 67, 79, 79, 75, 73, 69, 45, 49, 0, 0, 15, 30, 45, 60, 75, 90, 105, 120, 135, 150, 165, 180, 195, 210, 225, 240]
