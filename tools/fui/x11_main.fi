// SPDX-License-Identifier: MPL-2.0
// tools/fui/x11_main.fi -- DIE PLATTFORMSCHICHT OHNE BILDSCHIRM NACHGERECHNET.
//
// ===================================================== WARUM ES DAS GIBT
//
// Auf dem Rechner, auf dem dieser Lauf meist laeuft, gibt es keinen
// X-Server. Wer die X11-Rueckwand (lib/window/x11.fi) und den Wirt
// (lib/plat/fuiwirt.fi) trotzdem pruefen will, darf nicht die eigene
// Rechnung gegen sich selbst halten -- sonst prueft er nur, dass er
// zweimal denselben Fehler macht. Also stehen hier drei Arten von
// Sollwerten, und keine davon stammt aus dem Code, den sie prueft:
//
//   1. VON HAND BESTIMMTE OKTETTS fuer jede Anfrage (Abschnitt 1),
//      nach dem Oktettformat im Anhang B des X11-Protokolls.
//   2. ECHTE MITSCHNITTE eines Xvfb (testdata/x11/, erzeugt von
//      tools/fui/x11_capture.py, das roh und ohne Firn mit dem Server
//      spricht), und daneben die Zahlen, die FREMDE Programme ueber
//      denselben Server sagen: `xdpyinfo` (1400x900 Punkte, 370x238
//      mm, 96x96 dpi, Visual 0x21, Masken ff0000/ff00/ff) und
//      `xmodmap -pke` (testdata/x11/xmodmap_us.txt, xmodmap_de.txt).
//   3. DIE ZAHLEN DER BESCHRIEBENEN SEITE aus tools/fui/gallery9_main.fi
//      (Ausschnitt bei y = 168, Leiste 56, Inhalt 1130), die dort schon
//      am Bild belegt sind -- hier bei Massstab 1000 UND 2000.
//
// Gezaehlt wird am Ende; eine einzige falsche Zahl macht den Lauf rot.
//
//     x11_main <font.ttf>     (Vorgabe DejaVuSans) -- aus der Wurzel des
//                             Baums aufrufen, die Mitschnitte liegen
//                             unter testdata/x11/.
//
// WIE DIE RUECKWAND HIER HEREINKOMMT. `import window.backend` wird neben
// der Wurzeldatei gesucht (compiler/src/modules.rs, Regel 2); in
// tools/fui/window/ liegt dafuer ein Verweis backend.fi ->
// ../../../lib/window/x11.fi, genau wie in demos/x11demo/window/.
import std.rt
import paint.canvas
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.layout
import fui.scene
import fui.sheet
import fui.viewport
import fui.control
import fui.anim
import window.window
import window.backend
import plat.fuiwirt
import gallery9_main

const FONTSET_BYTES: usize = 4096
// Aus testdata/x11/events.txt: die Atome, die der Server beim Mitschnitt
// vergeben hat, und das Fenster.
const A_DELETE: u32 = 241
const WID: u32 = 2097153

static mut G_FEHLER: usize = 0
static mut G_ZAHL: usize = 0

fn chk(t: u64, n: usize, ok: bool, got: i64, want: i64) {
    G_ZAHL = G_ZAHL + 1
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, t, n)
    var i: usize = n
    while i < 50 {
        rt.buf_push(&b, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&b, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&b, (&f[0]) as u64, 8)
        G_FEHLER = G_FEHLER + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&b, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&b, got)
    var w: [u8; 6] = " want "
    rt.buf_push_bytes(&b, (&w[0]) as u64, 6)
    rt.buf_push_dec_i64(&b, want)
    rt.buf_push(&b, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

// Oktett fuer Oktett. `got` ist die Zahl der gleichen Oktett, `want`
// die Laenge des Sollwerts -- und nur gleich lang UND ganz gleich ist
// OK. Bei einem Fehler steht die Anfrage in hex darunter.
fn hexchk(t: u64, n: usize, b: *mut rt.Buf, soll: u64, sn: usize) {
    var gleich: usize = 0
    var i: usize = 0
    while i < sn && i < (*b).len {
        if rt.ld8((*b).ptr, i) == rt.ld8(soll, i) {
            gleich = gleich + 1
        }
        i = i + 1
    }
    let ok: bool = (*b).len == sn && gleich == sn
    chk(t, n, ok, gleich as i64, sn as i64)
    if !ok {
        var d: rt.Buf = rt.buf_new()
        var k: usize = 0
        while k < (*b).len {
            rt.buf_push_hex_u64(&d, rt.ld8((*b).ptr, k) as u64, 2)
            k = k + 1
        }
        rt.buf_push(&d, 10 as u8)
        rt.write_everything(1, rt.buf_ptr(&d), rt.buf_len(&d))
        rt.buf_free(&d)
    }
}

fn b2i(b: bool) -> i64 {
    if b {
        return 1
    }
    return 0
}

fn ld32(p: u64, off: usize) -> u32 {
    return (rt.ld8(p, off) as u32) | ((rt.ld8(p, off + 1) as u32) << 8)
    | ((rt.ld8(p, off + 2) as u32) << 16)
    | ((rt.ld8(p, off + 3) as u32) << 24)
}

// ======================================================================
// DIE SEITE AUS gallery9 -- dieselben Funktionen, kein Nachbau
// ======================================================================

fn px(m: *mut theme.Theme, n: f64) -> f64 {
    return theme.theme_px(m, (n + 0.5) as usize) as f64
}

// Die Hoehe des Inhalts wird GEMESSEN (letzte Zeile unten minus erste
// Zeile oben plus zweimal der Innenrand) und nicht hingeschrieben --
// sonst stuende hier bei jedem Massstab eine eigene Zahl.
fn inhalt_messen(sc: *mut scene.Scene, v: *mut viewport.Viewport,
    m: *mut theme.Theme, kasten: usize) -> f64 {
    let n: usize = scene.scene_child_count(sc, kasten)
    let erste: usize = scene.scene_child_at(sc, kasten, 0)
    let letzte: usize = scene.scene_child_at(sc, kasten, n - 1)
    let pad: f64 = theme.theme_px(m, 8) as f64
    let h: f64 = scene.node_y(sc, letzte) + scene.node_h(sc, letzte)
    - scene.node_y(sc, erste) + 2.0 * pad
    viewport.viewport_set_content(v, viewport.viewport_content_w(v), h)
    return h
}

fn baue_seite(sc: *mut scene.Scene, v: *mut viewport.Viewport,
    sh: *mut sheet.Sheet, m: *mut theme.Theme, c: *mut render.Ctx,
    texte: u64, feld: u64, breite: usize, hoehe: usize) -> usize {
    var nleiste: [u8; 6] = "leiste"
    var ntitel: [u8; 5] = "titel"
    var nkarte: [u8; 5] = "karte"
    var nueber: [u8; 5] = "ueber"
    var nnotiz: [u8; 5] = "notiz"
    var nliste: [u8; 5] = "liste"
    var nzeile: [u8; 5] = "zeile"
    var ngerade: [u8; 6] = "gerade"
    var nakzent: [u8; 6] = "akzent"
    let k_leiste: u32 = sheet.sheet_name((&nleiste[0]) as u64, 6)
    let k_titel: u32 = sheet.sheet_name((&ntitel[0]) as u64, 5)
    let k_karte: u32 = sheet.sheet_name((&nkarte[0]) as u64, 5)
    let k_ueber: u32 = sheet.sheet_name((&nueber[0]) as u64, 5)
    let k_notiz: u32 = sheet.sheet_name((&nnotiz[0]) as u64, 5)
    let k_liste: u32 = sheet.sheet_name((&nliste[0]) as u64, 5)
    let k_zeile: u32 = sheet.sheet_name((&nzeile[0]) as u64, 5)
    let k_gerade: u32 = sheet.sheet_name((&ngerade[0]) as u64, 6)
    let k_akzent: u32 = sheet.sheet_name((&nakzent[0]) as u64, 6)
    *v = viewport.viewport_new(0.0, 0.0, px(m, gallery9_main.LISTE_W),
        px(m, 400.0), px(m, gallery9_main.INHALT_W),
        px(m, gallery9_main.INHALT_H))
    viewport.viewport_set_bar(v, theme.theme_px(m, gallery9_main.BALKEN))
    viewport.viewport_set_inset(v, px(m, gallery9_main.POLSTER))
    *sh = sheet.sheet_new()
    let spurfarbe: u32 = theme.color_from_token(m, style.TOK_SURFACE)
    let grund_liste: u32 = theme.mix(spurfarbe,
        theme.color_from_token(m, style.TOK_TEXT), 500)
    gallery9_main.baue_blatt(sh, k_leiste, k_titel, k_karte, k_ueber,
        k_notiz, k_liste, k_zeile, k_gerade, k_akzent,
        style.color_literal(grund_liste))
    *sc = scene.scene_new()
    let kasten: usize = gallery9_main.baue_baum(sc, v, feld, k_leiste,
        k_titel, k_karte, k_ueber, k_notiz, k_liste, k_zeile, k_gerade,
        k_akzent, texte)
    scene.scene_style(sc, sh)
    scene.scene_measure(sc, c)
    scene.scene_layout(sc, c, 0.0, 0.0, breite as f64, hoehe as f64)
    let h: f64 = inhalt_messen(sc, v, m, kasten)
    scene.scene_layout(sc, c, 0.0, 0.0, breite as f64, hoehe as f64)
    return kasten
}

// Wie viele Text- und Widget-Knoten sind schmaler als ihr Text?
fn zu_schmal(sc: *mut scene.Scene, c: *mut render.Ctx) -> usize {
    var n: usize = 0
    var k: usize = 0
    while k < scene.scene_count(sc) {
        if scene.node_kind(sc, k) == scene.N_TEXT
        || scene.node_kind(sc, k) == scene.N_WIDGET {
            var pw: f64 = 0.0
            var ph: f64 = 0.0
            render.pref_of(c, scene.node_widget(sc, k), &pw, &ph)
            if pw > scene.node_w(sc, k) + 0.5 {
                n = n + 1
            }
        }
        k = k + 1
    }
    return n
}

fn mitte_x(sc: *mut scene.Scene, i: usize) -> f64 {
    return scene.node_x(sc, i) + scene.node_w(sc, i) / 2.0
}

fn mitte_y(sc: *mut scene.Scene, i: usize) -> f64 {
    return scene.node_y(sc, i) + scene.node_h(sc, i) / 2.0
}

// ======================================================================
// ABSCHNITT 8: DER MASSSTAB IM BAUM -- 1000 gegen 2000
// ======================================================================
fn massstab(fm: u64, texte: u64, feld: u64, promille: usize, soll_y: i64,
    soll_leiste: i64, soll_zeile: i64, soll_inhalt: i64) {
    var cv: canvas.Canvas = canvas.canvas_new()
    let ok0: bool = canvas.canvas_init(&cv, 64, 64)
    var z: painter.Painter = painter.painter_new()
    let ok1: bool = painter.painter_init(&z, &cv, 64, 64)
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(true)
    var c: render.Ctx = render.ctx_new(&m, &z)
    var sc: scene.Scene = scene.scene_new()
    var v: viewport.Viewport = viewport.viewport_new(0.0, 0.0, 1.0, 1.0,
        1.0, 1.0)
    var sh: sheet.Sheet = sheet.sheet_new()
    var w: fuiwirt.Wirt = fuiwirt.wirt_new(&sc, &c)
    // Der Massstab geht EINMAL ins Theme -- ueber den Wirt, wie im Fenster.
    fuiwirt.wirt_set_scale(&w, &m, promille)
    let breite: usize = (gallery9_main.W_STD * promille) / 1000
    let hoehe: usize = (gallery9_main.H * promille) / 1000
    let kasten: usize = baue_seite(&sc, &v, &sh, &m, &c, texte, feld, breite,
        hoehe)
    let wurzel: usize = scene.scene_root(&sc)
    let kopf: usize = scene.scene_child_at(&sc, wurzel, 0)
    let zeile: usize = scene.scene_child_at(&sc, kasten, 0)
    var t1: [u8; 37] = "8 Theme traegt den Massstab des Wirts"
    chk((&t1[0]) as u64, 37, theme.theme_scale(&m) == promille, (theme.theme_scale(&m)) as i64, (promille) as i64)
    var t2: [u8; 28] = "8 die Kopfleiste ist so hoch"
    chk((&t2[0]) as u64, 28, (scene.node_h(&sc, kopf) as i64) == soll_leiste, (scene.node_h(&sc, kopf)) as i64, (soll_leiste) as i64)
    var t3: [u8; 30] = "8 der Ausschnitt beginnt bei y"
    chk((&t3[0]) as u64, 30, (viewport.viewport_y(&v) as i64) == soll_y, (viewport.viewport_y(&v)) as i64, (soll_y) as i64)
    var t4: [u8; 34] = "8 eine Zeile der Liste ist so hoch"
    chk((&t4[0]) as u64, 34, (scene.node_h(&sc, zeile) as i64) == soll_zeile, (scene.node_h(&sc, zeile)) as i64, (soll_zeile) as i64)
    var t5: [u8; 29] = "8 gemessener Inhalt der Liste"
    chk((&t5[0]) as u64, 29, (viewport.viewport_content_h(&v) as i64) == soll_inhalt, (viewport.viewport_content_h(&v)) as i64, (soll_inhalt) as i64)
    let schmal: usize = zu_schmal(&sc, &c)
    var t6: [u8; 40] = "8 kein Knoten zu schmal fuer seinen Text"
    chk((&t6[0]) as u64, 40, schmal == 0, (schmal) as i64, (0) as i64)
    var t7: [u8; 37] = "8 der Baum ist vollstaendig (Grund 0)"
    chk((&t7[0]) as u64, 37, scene.scene_overflow_reason(&sc) == scene.OF_NONE, (scene.scene_overflow_reason(&sc)) as i64, (0) as i64)
    // Das Rad rollt eine Strecke aus dem Entwurf: 72 Punkte, also 72 *
    // Massstab Bildpunkte.
    let r: u32 = fuiwirt.wirt_pointer_down(&w, mitte_x(&sc, kasten), viewport.viewport_y(&v) + 60.0, fuiwirt.BTN_WHEEL_DOWN)
    let soll_rad: i64 = ((72 * promille) / 1000) as i64
    var t8: [u8; 36] = "8 ein Rasten rollt 72 Entwurfspunkte"
    chk((&t8[0]) as u64, 36, (viewport.viewport_off_y(&v) as i64) == soll_rad, (viewport.viewport_off_y(&v)) as i64, (soll_rad) as i64)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
}

// ======================================================================
// ABSCHNITT 9 UND 10: DIE BEDIENUNG UND DER LEERLAUF
// ======================================================================
fn bedienung(fm: u64, texte: u64, feld: u64) {
    var cv: canvas.Canvas = canvas.canvas_new()
    let ok0: bool = canvas.canvas_init(&cv, 64, 64)
    var z: painter.Painter = painter.painter_new()
    let ok1: bool = painter.painter_init(&z, &cv, 64, 64)
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(true)
    var c: render.Ctx = render.ctx_new(&m, &z)
    var sc: scene.Scene = scene.scene_new()
    var v: viewport.Viewport = viewport.viewport_new(0.0, 0.0, 1.0, 1.0,
        1.0, 1.0)
    var sh: sheet.Sheet = sheet.sheet_new()
    let kasten: usize = baue_seite(&sc, &v, &sh, &m, &c, texte, feld,
        gallery9_main.W_STD, gallery9_main.H)
    var w: fuiwirt.Wirt = fuiwirt.wirt_new(&sc, &c)
    fuiwirt.wirt_bind(&w)
    let pn: *mut control.Panel = fuiwirt.wirt_panel(&w)
    let wurzel: usize = scene.scene_root(&sc)
    let kopf: usize = scene.scene_child_at(&sc, wurzel, 0)
    let knopf1: usize = scene.scene_child_at(&sc, kopf, 1)
    let rumpf: usize = scene.scene_child_at(&sc, wurzel, 2)
    let rechts: usize = scene.scene_child_at(&sc, rumpf, 1)
    let karte2: usize = scene.scene_child_at(&sc, rechts, 1)
    let kbox: usize = scene.scene_child_at(&sc, karte2, 1)
    let schalter: usize = scene.scene_child_at(&sc, karte2, 2)
    let regler: usize = scene.scene_child_at(&sc, karte2, 4)
    let sx: f64 = mitte_x(&sc, schalter)
    let sy: f64 = mitte_y(&sc, schalter)

    var t9: [u8; 34] = "9 das Panel haengt an allen Knoten"
    chk((&t9[0]) as u64, 34, control.panel_count(pn) == scene.scene_count(&sc), (control.panel_count(pn)) as i64, (scene.scene_count(&sc)) as i64)
    var t10: [u8; 35] = "9 Panel-Widget = Widget des Knotens"
    chk((&t10[0]) as u64, 35, control.panel_widget(pn, schalter) as u64 == scene.node_widget(&sc, schalter) as u64, (1) as i64, (1) as i64)
    let ch1: u32 = fuiwirt.wirt_pointer_move(&w, sx, sy)
    var t11: [u8; 47] = "9 Zeiger auf den Schalter -> er ist ueberfahren"
    chk((&t11[0]) as u64, 47, control.panel_hot(pn) == schalter, (control.panel_hot(pn)) as i64, (schalter) as i64)
    var t12: [u8; 33] = "9 und das verlangt ein neues Bild"
    chk((&t12[0]) as u64, 33, (ch1 & control.CH_REPAINT) != 0 as u32, (ch1 & control.CH_REPAINT) as i64, (1) as i64)
    let vorher: i64 = widget.w_value(scene.node_widget(&sc, schalter))
    let d1: u32 = fuiwirt.wirt_pointer_down(&w, sx, sy, fuiwirt.BTN_LEFT)
    let u1: u32 = fuiwirt.wirt_pointer_up(&w, sx, sy, fuiwirt.BTN_LEFT)
    let nachher: i64 = widget.w_value(scene.node_widget(&sc, schalter))
    var t13: [u8; 46] = "9 Druecken+Loslassen kippt den Schalter 1 -> 0"
    chk((&t13[0]) as u64, 46, vorher == 1 && nachher == 0, (nachher) as i64, (0) as i64)
    let akt: usize = fuiwirt.wirt_take_activated(&w)
    var t14: [u8; 39] = "9 ausgeloest meldet genau diesen Knoten"
    chk((&t14[0]) as u64, 39, akt == schalter, (akt) as i64, (schalter) as i64)
    let d2: u32 = fuiwirt.wirt_pointer_down(&w, sx, sy, fuiwirt.BTN_LEFT)
    let m2: u32 = fuiwirt.wirt_pointer_move(&w, 5.0, 5.0)
    let u2: u32 = fuiwirt.wirt_pointer_up(&w, 5.0, 5.0, fuiwirt.BTN_LEFT)
    var t15: [u8; 31] = "9 Loslassen daneben kippt NICHT"
    chk((&t15[0]) as u64, 31, widget.w_value(scene.node_widget(&sc, schalter)) == 0, (widget.w_value(scene.node_widget(&sc, schalter))) as i64, (0) as i64)
    let zeile: usize = scene.scene_child_at(&sc, kasten, 1)
    var t16: [u8; 36] = "9 eine Textzeile ist keine Bedienung"
    chk((&t16[0]) as u64, 36, control.hit_test(pn, mitte_x(&sc, zeile), mitte_y(&sc, zeile)) == control.NOBODY, (0) as i64, (0) as i64)
    // Weggerollte Zeile unter der Werkzeugleiste: nach dem Rollen liegt
    // die erste Zeile mit ihrem Rechteck ueber dem Ausschnitt. Dort steht
    // der erste Knopf der zweiten Leiste -- und nur ER darf getroffen werden.
    let leiste: usize = scene.scene_child_at(&sc, wurzel, 1)
    let lknopf: usize = scene.scene_child_at(&sc, leiste, 0)
    var t17: [u8; 37] = "9 ein Knopf der Leiste wird getroffen"
    chk((&t17[0]) as u64, 37, control.hit_test(pn, mitte_x(&sc, lknopf), mitte_y(&sc, lknopf)) == lknopf, (control.hit_test(pn, mitte_x(&sc, lknopf), mitte_y(&sc, lknopf))) as i64, (lknopf) as i64)
    // Das Rad ueber der Liste und ueber den Karten.
    let lx: f64 = mitte_x(&sc, kasten)
    let ly: f64 = viewport.viewport_y(&v) + 100.0
    let r1: u32 = fuiwirt.wirt_pointer_down(&w, lx, ly, fuiwirt.BTN_WHEEL_DOWN)
    var t18: [u8; 36] = "9 Rad ueber der Liste: 72 nach unten"
    chk((&t18[0]) as u64, 36, (viewport.viewport_off_y(&v) as i64) == 72, (viewport.viewport_off_y(&v)) as i64, (72) as i64)
    let r2: u32 = fuiwirt.wirt_pointer_down(&w, sx, sy, fuiwirt.BTN_WHEEL_DOWN)
    var t19: [u8; 35] = "9 Rad ueber den Karten rollt nichts"
    chk((&t19[0]) as u64, 35, r2 == control.CH_NONE && (viewport.viewport_off_y(&v) as i64) == 72, (viewport.viewport_off_y(&v)) as i64, (72) as i64)
    let r3: u32 = fuiwirt.wirt_pointer_down(&w, lx, ly, fuiwirt.BTN_WHEEL_UP)
    var t20: [u8; 24] = "9 Rad hoch: wieder bei 0"
    chk((&t20[0]) as u64, 24, (viewport.viewport_off_y(&v) as i64) == 0, (viewport.viewport_off_y(&v)) as i64, (0) as i64)
    // Tasten: Pfeil (24 Punkte), Ende, Anfang.
    let k1: u32 = fuiwirt.wirt_key(&w, fuiwirt.KEY_DOWN, 0)
    var t21: [u8; 18] = "9 Pfeil runter: 24"
    chk((&t21[0]) as u64, 18, (viewport.viewport_off_y(&v) as i64) == 24, (viewport.viewport_off_y(&v)) as i64, (24) as i64)
    let k2: u32 = fuiwirt.wirt_key(&w, fuiwirt.KEY_END, 0)
    var t22: [u8; 26] = "9 Ende: ganz unten (max_y)"
    chk((&t22[0]) as u64, 26, viewport.viewport_off_y(&v) == viewport.viewport_max_y(&v) && viewport.viewport_max_y(&v) > 0.0, (viewport.viewport_off_y(&v)) as i64, (viewport.viewport_max_y(&v)) as i64)
    let k3: u32 = fuiwirt.wirt_key(&w, fuiwirt.KEY_HOME, 0)
    var t23: [u8; 19] = "9 Pos1: wieder oben"
    chk((&t23[0]) as u64, 19, (viewport.viewport_off_y(&v) as i64) == 0, (viewport.viewport_off_y(&v)) as i64, (0) as i64)
    // Die Fokuskette.
    control.panel_clear(pn)
    let t1: u32 = fuiwirt.wirt_key(&w, fuiwirt.KEY_TAB, 0)
    var t24: [u8; 47] = "9 Tab: Fokus auf den ersten Knopf der Kopfzeile"
    chk((&t24[0]) as u64, 47, control.panel_focus(pn) == knopf1, (control.panel_focus(pn)) as i64, (knopf1) as i64)
    let t2: u32 = fuiwirt.wirt_key(&w, fuiwirt.KEY_TAB, fuiwirt.MOD_SHIFT)
    var t25: [u8; 42] = "9 Umschalt+Tab davor: der Regler (letzter)"
    chk((&t25[0]) as u64, 42, control.panel_focus(pn) == regler, (control.panel_focus(pn)) as i64, (regler) as i64)
    // Die Eingabetaste und die Leertaste auf dem Kaestchen.
    let kd: u32 = fuiwirt.wirt_pointer_down(&w, mitte_x(&sc, kbox), mitte_y(&sc, kbox), fuiwirt.BTN_LEFT)
    let ku: u32 = fuiwirt.wirt_pointer_up(&w, mitte_x(&sc, kbox), mitte_y(&sc, kbox), fuiwirt.BTN_LEFT)
    let akt2: usize = fuiwirt.wirt_take_activated(&w)
    var t26: [u8; 40] = "9 Klick aufs Kaestchen: 1 -> 0, im Fokus"
    chk((&t26[0]) as u64, 40, widget.w_value(scene.node_widget(&sc, kbox)) == 0 && control.panel_focus(pn) == kbox, (widget.w_value(scene.node_widget(&sc, kbox))) as i64, (0) as i64)
    let e1: u32 = fuiwirt.wirt_key(&w, fuiwirt.KEY_RETURN, 0)
    var t27: [u8; 37] = "9 Eingabetaste kippt es zurueck auf 1"
    chk((&t27[0]) as u64, 37, widget.w_value(scene.node_widget(&sc, kbox)) == 1, (widget.w_value(scene.node_widget(&sc, kbox))) as i64, (1) as i64)
    let e2: u32 = fuiwirt.wirt_char(&w, 32 as u32, 0)
    var t28: [u8; 33] = "9 Leertaste kippt es wieder auf 0"
    chk((&t28[0]) as u64, 33, widget.w_value(scene.node_widget(&sc, kbox)) == 0 && fuiwirt.wirt_take_activated(&w) == kbox, (widget.w_value(scene.node_widget(&sc, kbox))) as i64, (0) as i64)
    // Der Rollbalken: am Schieber packen und 100 Punkte ziehen.
    var bx: f64 = 0.0
    var by: f64 = 0.0
    var bw: f64 = 0.0
    var bh: f64 = 0.0
    let hat: bool = viewport.viewport_bar_rect_v(&v, &bx, &by, &bw, &bh)
    // Der Weg des Schiebers wird an der LEINWANDFORM des Schiebers
    // abgelesen (oben bei 0, unten bei max) -- nicht aus dem Code, der
    // das Ziehen rechnet.
    viewport.viewport_set_offset(&v, 0.0, viewport.viewport_max_y(&v))
    let t_ende: layout.Rect = viewport.viewport_bar_thumb(&c, &v, viewport.VP_BAR_V)
    viewport.viewport_set_offset(&v, 0.0, 0.0)
    let tr: layout.Rect = viewport.viewport_bar_thumb(&c, &v, viewport.VP_BAR_V)
    let tx: f64 = bx + bw / 2.0
    let ty: f64 = (layout.rect_y(&tr) + layout.rect_h(&tr) / 2) as f64
    let weg: f64 = (layout.rect_y(&t_ende) - layout.rect_y(&tr)) as f64
    // Ein ganzer Bildpunkt Schieber ist max/weg Punkte Inhalt: so genau
    // (plus Rundung) muss es stimmen.
    let tol: f64 = viewport.viewport_max_y(&v) / weg + 0.5
    let b1: u32 = fuiwirt.wirt_pointer_down(&w, tx, ty, fuiwirt.BTN_LEFT)
    let b2: u32 = fuiwirt.wirt_pointer_move(&w, tx, ty + 100.0)
    let soll_b: f64 = 100.0 * viewport.viewport_max_y(&v) / weg
    var t29: [u8; 43] = "9 Schieber 100 gezogen: 100*max/Weg gerollt"
    chk((&t29[0]) as u64, 43, hat && weg > 0.0 && (viewport.viewport_off_y(&v) - soll_b) < tol && (soll_b - viewport.viewport_off_y(&v)) < tol, (viewport.viewport_off_y(&v)) as i64, (soll_b) as i64)
    let b3: u32 = fuiwirt.wirt_pointer_up(&w, tx, ty + 100.0, fuiwirt.BTN_LEFT)
    let stand: f64 = viewport.viewport_off_y(&v)
    let b4: u32 = fuiwirt.wirt_pointer_move(&w, tx, ty + 300.0)
    var t30: [u8; 38] = "9 nach dem Loslassen zieht nichts mehr"
    chk((&t30[0]) as u64, 38, viewport.viewport_off_y(&v) == stand, (viewport.viewport_off_y(&v)) as i64, (stand) as i64)
    let lv: u32 = fuiwirt.wirt_pointer_move(&w, sx, sy)
    let lv2: u32 = fuiwirt.wirt_pointer_leave(&w)
    var t31: [u8; 34] = "9 Hinaus: niemand mehr ueberfahren"
    chk((&t31[0]) as u64, 34, control.panel_hot(pn) == control.NOBODY && (lv2 & control.CH_REPAINT) != 0 as u32, (0) as i64, (0) as i64)

    // ------------------------------------------------ 10: DER LEERLAUF
    var w2: fuiwirt.Wirt = fuiwirt.wirt_new(&sc, &c)
    fuiwirt.wirt_bind(&w2)
    var t32: [u8; 45] = "10 ein neuer Wirt will sofort ein Bild (0 ms)"
    chk((&t32[0]) as u64, 45, fuiwirt.wirt_wait_ms(&w2) == 0, (fuiwirt.wirt_wait_ms(&w2)) as i64, (0) as i64)
    fuiwirt.wirt_painted(&w2)
    var t33: [u8; 39] = "10 gemalt, nichts laeuft: schlafen (-1)"
    chk((&t33[0]) as u64, 39, fuiwirt.wirt_wait_ms(&w2) == fuiwirt.WAIT_FOREVER, (fuiwirt.wirt_wait_ms(&w2)) as i64, (-1) as i64)
    let q1: u32 = fuiwirt.wirt_pointer_move(&w2, 3.0, 3.0)
    fuiwirt.wirt_painted(&w2)
    let q2: u32 = fuiwirt.wirt_pointer_move(&w2, 4.0, 4.0)
    var t34: [u8; 45] = "10 Zeiger bewegt, nichts geaendert: kein Bild"
    chk((&t34[0]) as u64, 45, q2 == control.CH_NONE && !fuiwirt.wirt_dirty(&w2), (q2) as i64, (0) as i64)
    var t: i64 = 0
    var bilder: u64 = fuiwirt.wirt_frames(&w2)
    while t < 1600 {
        fuiwirt.wirt_tick(&w2, t)
        if fuiwirt.wirt_dirty(&w2) {
            fuiwirt.wirt_painted(&w2)
        }
        t = t + 16
    }
    var t35: [u8; 31] = "10 100 Takte Leerlauf: 0 Bilder"
    chk((&t35[0]) as u64, 31, fuiwirt.wirt_frames(&w2) == bilder, (fuiwirt.wirt_frames(&w2) - bilder) as i64, (0) as i64)
    var g: anim.Animator = anim.animator_new()
    fuiwirt.wirt_set_animator(&w2, &g)
    let ai: usize = anim.animator_add(&g, anim.anim_new(2000, 160, 0.0, 1.0, anim.easing_linear()))
    var t36: [u8; 31] = "10 ein Tween laeuft: alle 16 ms"
    chk((&t36[0]) as u64, 31, fuiwirt.wirt_wait_ms(&w2) == fuiwirt.FRAME_MS, (fuiwirt.wirt_wait_ms(&w2)) as i64, (16) as i64)
    bilder = fuiwirt.wirt_frames(&w2)
    t = 2000
    while t <= 2400 {
        fuiwirt.wirt_tick(&w2, t)
        if fuiwirt.wirt_dirty(&w2) {
            fuiwirt.wirt_painted(&w2)
        }
        t = t + 16
    }
    // 2000..2160 in Schritten von 16: 2016 .. 2160 bewegen den Wert
    // (10 Takte), 2000 selbst nicht (Fortschritt 0 == Startwert).
    var t37: [u8; 41] = "10 160 ms Tween bei 16 ms Takt: 10 Bilder"
    chk((&t37[0]) as u64, 41, fuiwirt.wirt_frames(&w2) - bilder == 10, (fuiwirt.wirt_frames(&w2) - bilder) as i64, (10) as i64)
    var t38: [u8; 30] = "10 danach wieder schlafen (-1)"
    chk((&t38[0]) as u64, 30, fuiwirt.wirt_wait_ms(&w2) == fuiwirt.WAIT_FOREVER, (fuiwirt.wirt_wait_ms(&w2)) as i64, (-1) as i64)
    var t39: [u8; 46] = "10 animator_dirty ist nach dem Ende wieder aus"
    chk((&t39[0]) as u64, 46, !anim.animator_dirty(&g), (0) as i64, (0) as i64)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
}

fn main(start: u64) -> i32 {
    // ------------------------------------------------ 1: DIE ANFRAGEN
    var b: rt.Buf = rt.buf_new()
