    ok = backend.decode_event(eb.ptr + 320 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t119: [u8; 24] = "5 10 Tab -> EV_KEY K_TAB"
    chk((&t119[0]) as u64, 24, ok && k == window.EV_KEY && ea == window.K_TAB, (ea) as i64, (window.K_TAB) as i64)
    ok = backend.decode_event(eb.ptr + 352 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t120: [u8; 30] = "5 11 Escape -> EV_KEY K_ESCAPE"
