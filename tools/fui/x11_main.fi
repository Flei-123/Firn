// SPDX-License-Identifier: MPL-2.0
// tools/fui/x11_main.fi -- THE PLATFORM LAYER RE-CALCULATED WITHOUT A SCREEN.
//
// ===================================================== WHY IT EXISTS
//
// On the machine on which this run mostly runs there is no
// X server. Whoever wants to check the X11 backend (lib/window/x11.fi) and the
// host (lib/plat/fuiwirt.fi) nevertheless must not hold their own
// calculation against itself -- otherwise they only check that they make
// the same error twice. So three kinds of target values stand here,
// and none of them comes from the code that it checks:
//
//   1. OCTETS DETERMINED BY HAND for every request (section 1),
//      by the octet format in appendix B of the X11 protocol.
//   2. REAL CAPTURES of an Xvfb (testdata/x11/, generated by
//      tools/fui/x11_capture.py, which talks raw and without Firn to the server),
//      and beside them the numbers that FOREIGN programs state about
//      the same server: `xdpyinfo` (1400x900 points, 370x238
//      mm, 96x96 dpi, visual 0x21, masks ff0000/ff00/ff) and
//      `xmodmap -pke` (testdata/x11/xmodmap_us.txt, xmodmap_de.txt).
//   3. THE NUMBERS OF THE DESCRIBED PAGE from tools/fui/gallery9_main.fi
//      (section at y = 168, bar 56, content 1130), which are already proven
//      there on the image -- here at scale 1000 AND 2000.
//
// Counting is done at the end; a single wrong number makes the run red.
//
//     x11_main <font.ttf>     (default DejaVuSans) -- call from the root of
//                             the tree, the captures lie
//                             under testdata/x11/.
//
// HOW THE BACKEND GETS IN HERE. `import window.backend` is searched beside
// the root file (compiler/src/modules.rs, rule 2); in
// tools/fui/window/ there lies for that a link backend.fi ->
// ../../../lib/window/x11.fi, exactly as in demos/x11demo/window/.
import std.rt
import paint.canvas
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.layout
import fui.scene
import fui.sheet
import fui.viewport
import fui.control
import fui.anim
import window.window
import window.backend
import window.pointers
import plat.fuiwirt
import gallery9_main

const FONTSET_BYTES: usize = 4096
// From testdata/x11/events.txt: the atoms that the server assigned
// during the capture, and the window.
const A_DELETE: u32 = 241
const WID: u32 = 2097153

static mut G_ERROR: usize = 0
static mut G_NUMBER: usize = 0

fn chk(t: u64, n: usize, ok: bool, got: i64, want: i64) {
    G_NUMBER = G_NUMBER + 1
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, t, n)
    var i: usize = n
    while i < 50 {
        rt.buf_push(&b, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&b, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&b, (&f[0]) as u64, 8)
        G_ERROR = G_ERROR + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&b, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&b, got)
    var w: [u8; 6] = " want "
    rt.buf_push_bytes(&b, (&w[0]) as u64, 6)
    rt.buf_push_dec_i64(&b, want)
    rt.buf_push(&b, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

// Octet for octet. `got` is the number of equal octets, `want`
// the length of the target value -- and only equally long AND entirely equal is
// OK. On an error the request stands below it in hex.
fn hexchk(t: u64, n: usize, b: *mut rt.Buf, should: u64, sn: usize) {
    var equal: usize = 0
    var i: usize = 0
    while i < sn && i < (*b).len {
        if rt.ld8((*b).ptr, i) == rt.ld8(should, i) {
            equal = equal + 1
        }
        i = i + 1
    }
    let ok: bool = (*b).len == sn && equal == sn
    chk(t, n, ok, equal as i64, sn as i64)
    if !ok {
        var d: rt.Buf = rt.buf_new()
        var k: usize = 0
        while k < (*b).len {
            rt.buf_push_hex_u64(&d, rt.ld8((*b).ptr, k) as u64, 2)
            k = k + 1
        }
        rt.buf_push(&d, 10 as u8)
        rt.write_everything(1, rt.buf_ptr(&d), rt.buf_len(&d))
        rt.buf_free(&d)
    }
}

fn b2i(b: bool) -> i64 {
    if b {
        return 1
    }
    return 0
}

fn ld32(p: u64, off: usize) -> u32 {
    return (rt.ld8(p, off) as u32) | ((rt.ld8(p, off + 1) as u32) << 8)
    | ((rt.ld8(p, off + 2) as u32) << 16)
    | ((rt.ld8(p, off + 3) as u32) << 24)
}

// ======================================================================
// THE PAGE FROM gallery9 -- the same functions, no imitation
// ======================================================================

fn px(m: *mut theme.Theme, n: f64) -> f64 {
    return theme.theme_px(m, (n + 0.5) as usize) as f64
}

// The height of the content is MEASURED (last row at the bottom minus first
// row at the top plus twice the inner margin) and not written down --
// otherwise at every scale an own number would stand here.
fn content_measure(sc: *mut scene.Scene, v: *mut viewport.Viewport,
    m: *mut theme.Theme, frame_box: usize) -> f64 {
    let n: usize = scene.scene_child_count(sc, frame_box)
    let first: usize = scene.scene_child_at(sc, frame_box, 0)
    let last: usize = scene.scene_child_at(sc, frame_box, n - 1)
    let pad: f64 = theme.theme_px(m, 8) as f64
    let h: f64 = scene.node_y(sc, last) + scene.node_h(sc, last)
    -scene.node_y(sc, first) + 2.0 * pad
    viewport.viewport_set_content(v, viewport.viewport_content_w(v), h)
    return h
}

fn build_page(sc: *mut scene.Scene, v: *mut viewport.Viewport,
    sh: *mut sheet.Sheet, m: *mut theme.Theme, c: *mut render.Ctx,
    texts: u64, field: u64, width: usize, height: usize) -> usize {
    var nleiste: [u8; 6] = "leiste"
    var ntitel: [u8; 5] = "titel"
    var nkarte: [u8; 5] = "karte"
    var nueber: [u8; 5] = "ueber"
    var nnotiz: [u8; 5] = "notiz"
    var nliste: [u8; 5] = "liste"
    var nzeile: [u8; 5] = "zeile"
    var ngerade: [u8; 6] = "gerade"
    var nakzent: [u8; 6] = "akzent"
    let k_bar: u32 = sheet.sheet_name((&nleiste[0]) as u64, 6)
    let k_titel: u32 = sheet.sheet_name((&ntitel[0]) as u64, 5)
    let k_karte: u32 = sheet.sheet_name((&nkarte[0]) as u64, 5)
    let k_over: u32 = sheet.sheet_name((&nueber[0]) as u64, 5)
    let k_notiz: u32 = sheet.sheet_name((&nnotiz[0]) as u64, 5)
    let k_list: u32 = sheet.sheet_name((&nliste[0]) as u64, 5)
    let k_line: u32 = sheet.sheet_name((&nzeile[0]) as u64, 5)
    let k_even: u32 = sheet.sheet_name((&ngerade[0]) as u64, 6)
    let k_accent: u32 = sheet.sheet_name((&nakzent[0]) as u64, 6)
    *v = viewport.viewport_new(0.0, 0.0, px(m, gallery9_main.LIST_W),
        px(m, 400.0), px(m, gallery9_main.CONTENT_W),
        px(m, gallery9_main.CONTENT_H))
    viewport.viewport_set_bar(v, theme.theme_px(m, gallery9_main.BAR))
    viewport.viewport_set_inset(v, px(m, gallery9_main.PADDING))
    *sh = sheet.sheet_new()
    let spurfarbe: u32 = theme.color_from_token(m, style.TOK_SURFACE)
    let basic_list: u32 = theme.mix(spurfarbe,
        theme.color_from_token(m, style.TOK_TEXT), 500)
    gallery9_main.build_leaf(sh, k_bar, k_titel, k_karte, k_over,
        k_notiz, k_list, k_line, k_even, k_accent,
        style.color_literal(basic_list))
    *sc = scene.scene_new()
    let frame_box: usize = gallery9_main.build_tree(sc, v, field, k_bar,
        k_titel, k_karte, k_over, k_notiz, k_list, k_line, k_even,
        k_accent, texts)
    scene.scene_style(sc, sh)
    scene.scene_measure(sc, c)
    scene.scene_layout(sc, c, 0.0, 0.0, width as f64, height as f64)
    let h: f64 = content_measure(sc, v, m, frame_box)
    scene.scene_layout(sc, c, 0.0, 0.0, width as f64, height as f64)
    return frame_box
}

// How many text and widget nodes are narrower than their text?
fn too_narrow(sc: *mut scene.Scene, c: *mut render.Ctx) -> usize {
    var n: usize = 0
    var k: usize = 0
    while k < scene.scene_count(sc) {
        if scene.node_kind(sc, k) == scene.N_TEXT
        || scene.node_kind(sc, k) == scene.N_WIDGET {
            var pw: f64 = 0.0
            var ph: f64 = 0.0
            render.pref_of(c, scene.node_widget(sc, k), &pw, &ph)
            if pw > scene.node_w(sc, k) + 0.5 {
                n = n + 1
            }
        }
        k = k + 1
    }
    return n
}

fn mid_x(sc: *mut scene.Scene, i: usize) -> f64 {
    return scene.node_x(sc, i) + scene.node_w(sc, i) / 2.0
}

fn mid_y(sc: *mut scene.Scene, i: usize) -> f64 {
    return scene.node_y(sc, i) + scene.node_h(sc, i) / 2.0
}

// ======================================================================
// SECTION 8: THE SCALE IN THE TREE -- 1000 against 2000
// ======================================================================
fn massstab(fm: u64, texts: u64, field: u64, promille: usize, should_y: i64,
    should_bar: i64, should_line: i64, should_content: i64) {
    var cv: canvas.Canvas = canvas.canvas_new()
    let ok0: bool = canvas.canvas_init(&cv, 64, 64)
    var z: painter.Painter = painter.painter_new()
    let ok1: bool = painter.painter_init(&z, &cv, 64, 64)
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(true)
    var c: render.Ctx = render.ctx_new(&m, &z)
    var sc: scene.Scene = scene.scene_new()
    var v: viewport.Viewport = viewport.viewport_new(0.0, 0.0, 1.0, 1.0,
        1.0, 1.0)
    var sh: sheet.Sheet = sheet.sheet_new()
    var w: fuiwirt.Host = fuiwirt.host_new(&sc, &c)
    // The scale goes ONCE into the theme -- via the host, as in the window.
    fuiwirt.host_set_scale(&w, &m, promille)
    let width: usize = (gallery9_main.W_STD * promille) / 1000
    let height: usize = (gallery9_main.H * promille) / 1000
    let frame_box: usize = build_page(&sc, &v, &sh, &m, &c, texts, field, width,
        height)
    let root: usize = scene.scene_root(&sc)
    let header: usize = scene.scene_child_at(&sc, root, 0)
    let line: usize = scene.scene_child_at(&sc, frame_box, 0)
    var t1: [u8; 37] = "8 Theme traegt den Massstab des Wirts"
    chk((&t1[0]) as u64, 37, theme.theme_scale(&m) == promille, (theme.theme_scale(&m)) as i64, (promille) as i64)
    var t2: [u8; 28] = "8 die Kopfleiste ist so hoch"
    chk((&t2[0]) as u64, 28, (scene.node_h(&sc, header) as i64) == should_bar, (scene.node_h(&sc, header)) as i64, (should_bar) as i64)
    var t3: [u8; 30] = "8 der Ausschnitt beginnt bei y"
    chk((&t3[0]) as u64, 30, (viewport.viewport_y(&v) as i64) == should_y, (viewport.viewport_y(&v)) as i64, (should_y) as i64)
    var t4: [u8; 34] = "8 eine Zeile der Liste ist so hoch"
    chk((&t4[0]) as u64, 34, (scene.node_h(&sc, line) as i64) == should_line, (scene.node_h(&sc, line)) as i64, (should_line) as i64)
    var t5: [u8; 29] = "8 gemessener Inhalt der Liste"
    chk((&t5[0]) as u64, 29, (viewport.viewport_content_h(&v) as i64) == should_content, (viewport.viewport_content_h(&v)) as i64, (should_content) as i64)
    let narrow: usize = too_narrow(&sc, &c)
    var t6: [u8; 40] = "8 kein Knoten zu schmal fuer seinen Text"
    chk((&t6[0]) as u64, 40, narrow == 0, (narrow) as i64, (0) as i64)
    var t7: [u8; 37] = "8 der Baum ist vollstaendig (Grund 0)"
    chk((&t7[0]) as u64, 37, scene.scene_overflow_reason(&sc) == scene.OF_NONE, (scene.scene_overflow_reason(&sc)) as i64, (0) as i64)
    // The wheel scrolls a distance from the design: 72 points, so 72 *
    // scale pixels.
    let r: u32 = fuiwirt.host_pointer_down(&w, mid_x(&sc, frame_box), viewport.viewport_y(&v) + 60.0, fuiwirt.BTN_WHEEL_DOWN)
    let should_rad: i64 = ((72 * promille) / 1000) as i64
    var t8: [u8; 36] = "8 ein Rasten rollt 72 Entwurfspunkte"
    chk((&t8[0]) as u64, 36, (viewport.viewport_off_y(&v) as i64) == should_rad, (viewport.viewport_off_y(&v)) as i64, (should_rad) as i64)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
}

// ======================================================================
// SECTION 9 AND 10: THE OPERATION AND THE IDLE STATE
// ======================================================================
fn bedienung(fm: u64, texts: u64, field: u64) {
    var cv: canvas.Canvas = canvas.canvas_new()
    let ok0: bool = canvas.canvas_init(&cv, 64, 64)
    var z: painter.Painter = painter.painter_new()
    let ok1: bool = painter.painter_init(&z, &cv, 64, 64)
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(true)
    var c: render.Ctx = render.ctx_new(&m, &z)
    var sc: scene.Scene = scene.scene_new()
    var v: viewport.Viewport = viewport.viewport_new(0.0, 0.0, 1.0, 1.0,
        1.0, 1.0)
    var sh: sheet.Sheet = sheet.sheet_new()
    let frame_box: usize = build_page(&sc, &v, &sh, &m, &c, texts, field,
        gallery9_main.W_STD, gallery9_main.H)
    var w: fuiwirt.Host = fuiwirt.host_new(&sc, &c)
    fuiwirt.host_bind(&w)
    let pn: *mut control.Panel = fuiwirt.host_panel(&w)
    let root: usize = scene.scene_root(&sc)
    let header: usize = scene.scene_child_at(&sc, root, 0)
    let knopf1: usize = scene.scene_child_at(&sc, header, 1)
    let body: usize = scene.scene_child_at(&sc, root, 2)
    let right: usize = scene.scene_child_at(&sc, body, 1)
    let karte2: usize = scene.scene_child_at(&sc, right, 1)
    let kbox: usize = scene.scene_child_at(&sc, karte2, 1)
    let flag: usize = scene.scene_child_at(&sc, karte2, 2)
    let regler: usize = scene.scene_child_at(&sc, karte2, 4)
    let sx: f64 = mid_x(&sc, flag)
    let sy: f64 = mid_y(&sc, flag)

    var t9: [u8; 34] = "9 das Panel haengt an allen Knoten"
    chk((&t9[0]) as u64, 34, control.panel_count(pn) == scene.scene_count(&sc), (control.panel_count(pn)) as i64, (scene.scene_count(&sc)) as i64)
    var t10: [u8; 35] = "9 Panel-Widget = Widget des Knotens"
    chk((&t10[0]) as u64, 35, control.panel_widget(pn, flag) as u64 == scene.node_widget(&sc, flag) as u64, (1) as i64, (1) as i64)
    let ch1: u32 = fuiwirt.host_pointer_move(&w, sx, sy)
    var t11: [u8; 47] = "9 Zeiger auf den Schalter -> er ist ueberfahren"
    chk((&t11[0]) as u64, 47, control.panel_hot(pn) == flag, (control.panel_hot(pn)) as i64, (flag) as i64)
    var t12: [u8; 33] = "9 und das verlangt ein neues Bild"
    chk((&t12[0]) as u64, 33, (ch1 & control.CH_REPAINT) != 0 as u32, (ch1 & control.CH_REPAINT) as i64, (1) as i64)
    let before: i64 = widget.w_value(scene.node_widget(&sc, flag))
    let d1: u32 = fuiwirt.host_pointer_down(&w, sx, sy, fuiwirt.BTN_LEFT)
    let u1: u32 = fuiwirt.host_pointer_up(&w, sx, sy, fuiwirt.BTN_LEFT)
    let after: i64 = widget.w_value(scene.node_widget(&sc, flag))
    var t13: [u8; 46] = "9 Druecken+Loslassen kippt den Schalter 1 -> 0"
    chk((&t13[0]) as u64, 46, before == 1 && after == 0, (after) as i64, (0) as i64)
    let akt: usize = fuiwirt.host_take_activated(&w)
    var t14: [u8; 39] = "9 ausgeloest meldet genau diesen Knoten"
    chk((&t14[0]) as u64, 39, akt == flag, (akt) as i64, (flag) as i64)
    let d2: u32 = fuiwirt.host_pointer_down(&w, sx, sy, fuiwirt.BTN_LEFT)
    let m2: u32 = fuiwirt.host_pointer_move(&w, 5.0, 5.0)
    let u2: u32 = fuiwirt.host_pointer_up(&w, 5.0, 5.0, fuiwirt.BTN_LEFT)
    var t15: [u8; 31] = "9 Loslassen daneben kippt NICHT"
    chk((&t15[0]) as u64, 31, widget.w_value(scene.node_widget(&sc, flag)) == 0, (widget.w_value(scene.node_widget(&sc, flag))) as i64, (0) as i64)
    let line: usize = scene.scene_child_at(&sc, frame_box, 1)
    var t16: [u8; 36] = "9 eine Textzeile ist keine Bedienung"
    chk((&t16[0]) as u64, 36, control.hit_test(pn, mid_x(&sc, line), mid_y(&sc, line)) == control.NOBODY, (0) as i64, (0) as i64)
    // Scrolled-away row under the toolbar: after scrolling
    // the first row lies with its rectangle above the section. There stands
    // the first button of the second bar -- and only IT may be hit.
    let bar: usize = scene.scene_child_at(&sc, root, 1)
    let lknopf: usize = scene.scene_child_at(&sc, bar, 0)
    var t17: [u8; 37] = "9 ein Knopf der Leiste wird getroffen"
    chk((&t17[0]) as u64, 37, control.hit_test(pn, mid_x(&sc, lknopf), mid_y(&sc, lknopf)) == lknopf, (control.hit_test(pn, mid_x(&sc, lknopf), mid_y(&sc, lknopf))) as i64, (lknopf) as i64)
    // The wheel over the list and over the cards.
    let lx: f64 = mid_x(&sc, frame_box)
    let ly: f64 = viewport.viewport_y(&v) + 100.0
    let r1: u32 = fuiwirt.host_pointer_down(&w, lx, ly, fuiwirt.BTN_WHEEL_DOWN)
    var t18: [u8; 36] = "9 Rad ueber der Liste: 72 nach unten"
    chk((&t18[0]) as u64, 36, (viewport.viewport_off_y(&v) as i64) == 72, (viewport.viewport_off_y(&v)) as i64, (72) as i64)
    let r2: u32 = fuiwirt.host_pointer_down(&w, sx, sy, fuiwirt.BTN_WHEEL_DOWN)
    var t19: [u8; 35] = "9 Rad ueber den Karten rollt nichts"
    chk((&t19[0]) as u64, 35, r2 == control.CH_NONE && (viewport.viewport_off_y(&v) as i64) == 72, (viewport.viewport_off_y(&v)) as i64, (72) as i64)
    let r3: u32 = fuiwirt.host_pointer_down(&w, lx, ly, fuiwirt.BTN_WHEEL_UP)
    var t20: [u8; 24] = "9 Rad hoch: wieder bei 0"
    chk((&t20[0]) as u64, 24, (viewport.viewport_off_y(&v) as i64) == 0, (viewport.viewport_off_y(&v)) as i64, (0) as i64)
    // Tasten: Pfeil (24 Punkte), Ende, Anfang.
    let k1: u32 = fuiwirt.host_key(&w, fuiwirt.KEY_DOWN, 0)
    var t21: [u8; 18] = "9 Pfeil runter: 24"
    chk((&t21[0]) as u64, 18, (viewport.viewport_off_y(&v) as i64) == 24, (viewport.viewport_off_y(&v)) as i64, (24) as i64)
    let k2: u32 = fuiwirt.host_key(&w, fuiwirt.KEY_END, 0)
    var t22: [u8; 26] = "9 Ende: ganz unten (max_y)"
    chk((&t22[0]) as u64, 26, viewport.viewport_off_y(&v) == viewport.viewport_max_y(&v) && viewport.viewport_max_y(&v) > 0.0, (viewport.viewport_off_y(&v)) as i64, (viewport.viewport_max_y(&v)) as i64)
    let k3: u32 = fuiwirt.host_key(&w, fuiwirt.KEY_HOME, 0)
    var t23: [u8; 19] = "9 Pos1: wieder oben"
    chk((&t23[0]) as u64, 19, (viewport.viewport_off_y(&v) as i64) == 0, (viewport.viewport_off_y(&v)) as i64, (0) as i64)
    // Die Fokuskette.
    control.panel_clear(pn)
    let t1: u32 = fuiwirt.host_key(&w, fuiwirt.KEY_TAB, 0)
    var t24: [u8; 47] = "9 Tab: Fokus auf den ersten Knopf der Kopfzeile"
    chk((&t24[0]) as u64, 47, control.panel_focus(pn) == knopf1, (control.panel_focus(pn)) as i64, (knopf1) as i64)
    let t2: u32 = fuiwirt.host_key(&w, fuiwirt.KEY_TAB, fuiwirt.MOD_SHIFT)
    var t25: [u8; 42] = "9 Umschalt+Tab davor: der Regler (letzter)"
    chk((&t25[0]) as u64, 42, control.panel_focus(pn) == regler, (control.panel_focus(pn)) as i64, (regler) as i64)
    // The Enter key and the space bar on the checkbox.
    let kd: u32 = fuiwirt.host_pointer_down(&w, mid_x(&sc, kbox), mid_y(&sc, kbox), fuiwirt.BTN_LEFT)
    let ku: u32 = fuiwirt.host_pointer_up(&w, mid_x(&sc, kbox), mid_y(&sc, kbox), fuiwirt.BTN_LEFT)
    let akt2: usize = fuiwirt.host_take_activated(&w)
    var t26: [u8; 40] = "9 Klick aufs Kaestchen: 1 -> 0, im Fokus"
    chk((&t26[0]) as u64, 40, widget.w_value(scene.node_widget(&sc, kbox)) == 0 && control.panel_focus(pn) == kbox, (widget.w_value(scene.node_widget(&sc, kbox))) as i64, (0) as i64)
    let e1: u32 = fuiwirt.host_key(&w, fuiwirt.KEY_RETURN, 0)
    var t27: [u8; 37] = "9 Eingabetaste kippt es zurueck auf 1"
    chk((&t27[0]) as u64, 37, widget.w_value(scene.node_widget(&sc, kbox)) == 1, (widget.w_value(scene.node_widget(&sc, kbox))) as i64, (1) as i64)
    let e2: u32 = fuiwirt.host_char(&w, 32 as u32, 0)
    var t28: [u8; 33] = "9 Leertaste kippt es wieder auf 0"
    chk((&t28[0]) as u64, 33, widget.w_value(scene.node_widget(&sc, kbox)) == 0 && fuiwirt.host_take_activated(&w) == kbox, (widget.w_value(scene.node_widget(&sc, kbox))) as i64, (0) as i64)
    // The scroll bar: grab the slider and drag 100 points.
    var bx: f64 = 0.0
    var by: f64 = 0.0
    var bw: f64 = 0.0
    var bh: f64 = 0.0
    let hat: bool = viewport.viewport_bar_rect_v(&v, &bx, &by, &bw, &bh)
    // The travel of the slider is read off the CANVAS SHAPE of the slider
    // (at the top 0, at the bottom max) -- not from the code that
    // calculates the dragging.
    viewport.viewport_set_offset(&v, 0.0, viewport.viewport_max_y(&v))
    let t_end: layout.Rect = viewport.viewport_bar_thumb(&c, &v, viewport.VP_BAR_V)
    viewport.viewport_set_offset(&v, 0.0, 0.0)
    let tr: layout.Rect = viewport.viewport_bar_thumb(&c, &v, viewport.VP_BAR_V)
    let tx: f64 = bx + bw / 2.0
    let ty: f64 = (layout.rect_y(&tr) + layout.rect_h(&tr) / 2) as f64
    let weg: f64 = (layout.rect_y(&t_end) - layout.rect_y(&tr)) as f64
    // A whole pixel of slider is max/travel points of content: that exactly
    // (plus rounding) must be right.
    let tol: f64 = viewport.viewport_max_y(&v) / weg + 0.5
    let b1: u32 = fuiwirt.host_pointer_down(&w, tx, ty, fuiwirt.BTN_LEFT)
    let b2: u32 = fuiwirt.host_pointer_move(&w, tx, ty + 100.0)
    let should_b: f64 = 100.0 * viewport.viewport_max_y(&v) / weg
    var t29: [u8; 43] = "9 Schieber 100 gezogen: 100*max/Weg gerollt"
    chk((&t29[0]) as u64, 43, hat && weg > 0.0 && (viewport.viewport_off_y(&v) - should_b) < tol && (should_b - viewport.viewport_off_y(&v)) < tol, (viewport.viewport_off_y(&v)) as i64, (should_b) as i64)
    let b3: u32 = fuiwirt.host_pointer_up(&w, tx, ty + 100.0, fuiwirt.BTN_LEFT)
    let state: f64 = viewport.viewport_off_y(&v)
    let b4: u32 = fuiwirt.host_pointer_move(&w, tx, ty + 300.0)
    var t30: [u8; 38] = "9 nach dem Loslassen zieht nichts mehr"
    chk((&t30[0]) as u64, 38, viewport.viewport_off_y(&v) == state, (viewport.viewport_off_y(&v)) as i64, (state) as i64)
    let lv: u32 = fuiwirt.host_pointer_move(&w, sx, sy)
    let lv2: u32 = fuiwirt.host_pointer_leave(&w)
    var t31: [u8; 34] = "9 Hinaus: niemand mehr ueberfahren"
    chk((&t31[0]) as u64, 34, control.panel_hot(pn) == control.NOBODY && (lv2 & control.CH_REPAINT) != 0 as u32, (0) as i64, (0) as i64)

    // ------------------------------------------------ 10: THE IDLE STATE
    var w2: fuiwirt.Host = fuiwirt.host_new(&sc, &c)
    fuiwirt.host_bind(&w2)
    var t32: [u8; 39] = "10 KEINER des Wirts == scene.SCENE_NONE"
    chk((&t32[0]) as u64, 39, fuiwirt.KEINER == scene.SCENE_NONE, (fuiwirt.KEINER) as i64, (scene.SCENE_NONE) as i64)
    var t33: [u8; 30] = "10 nichts ausgeloest -> KEINER"
    chk((&t33[0]) as u64, 30, fuiwirt.host_take_activated(&w) == fuiwirt.KEINER, (0) as i64, (0) as i64)
    var t34: [u8; 45] = "10 ein neuer Wirt will sofort ein Bild (0 ms)"
    chk((&t34[0]) as u64, 45, fuiwirt.host_wait_ms(&w2) == 0, (fuiwirt.host_wait_ms(&w2)) as i64, (0) as i64)
    fuiwirt.host_painted(&w2)
    var t35: [u8; 39] = "10 gemalt, nichts laeuft: schlafen (-1)"
    chk((&t35[0]) as u64, 39, fuiwirt.host_wait_ms(&w2) == fuiwirt.WAIT_FOREVER, (fuiwirt.host_wait_ms(&w2)) as i64, (-1) as i64)
    let q1: u32 = fuiwirt.host_pointer_move(&w2, 3.0, 3.0)
    fuiwirt.host_painted(&w2)
    let q2: u32 = fuiwirt.host_pointer_move(&w2, 4.0, 4.0)
    var t36: [u8; 45] = "10 Zeiger bewegt, nichts geaendert: kein Bild"
    chk((&t36[0]) as u64, 45, q2 == control.CH_NONE && !fuiwirt.host_dirty(&w2), (q2) as i64, (0) as i64)
    var t: i64 = 0
    var images: u64 = fuiwirt.host_frames(&w2)
    while t < 1600 {
        fuiwirt.host_tick(&w2, t)
        if fuiwirt.host_dirty(&w2) {
            fuiwirt.host_painted(&w2)
        }
        t = t + 16
    }
    var t37: [u8; 31] = "10 100 Takte Leerlauf: 0 Bilder"
    chk((&t37[0]) as u64, 31, fuiwirt.host_frames(&w2) == images, (fuiwirt.host_frames(&w2) - images) as i64, (0) as i64)
    var g: anim.Animator = anim.animator_new()
    fuiwirt.host_set_animator(&w2, &g)
    let ai: usize = anim.animator_add(&g, anim.anim_new(2000, 160, 0.0, 1.0, anim.easing_linear()))
    var t38: [u8; 31] = "10 ein Tween laeuft: alle 16 ms"
    chk((&t38[0]) as u64, 31, fuiwirt.host_wait_ms(&w2) == fuiwirt.FRAME_MS, (fuiwirt.host_wait_ms(&w2)) as i64, (16) as i64)
    images = fuiwirt.host_frames(&w2)
    t = 2000
    while t <= 2400 {
        fuiwirt.host_tick(&w2, t)
        if fuiwirt.host_dirty(&w2) {
            fuiwirt.host_painted(&w2)
        }
        t = t + 16
    }
    // 2000..2160 in steps of 16: 2016 .. 2160 move the value
    // (10 ticks), 2000 itself does not (progress 0 == start value).
    var t39: [u8; 41] = "10 160 ms Tween bei 16 ms Takt: 10 Bilder"
    chk((&t39[0]) as u64, 41, fuiwirt.host_frames(&w2) - images == 10, (fuiwirt.host_frames(&w2) - images) as i64, (10) as i64)
    var t40: [u8; 30] = "10 danach wieder schlafen (-1)"
    chk((&t40[0]) as u64, 30, fuiwirt.host_wait_ms(&w2) == fuiwirt.WAIT_FOREVER, (fuiwirt.host_wait_ms(&w2)) as i64, (-1) as i64)
    var t41: [u8; 46] = "10 animator_dirty ist nach dem Ende wieder aus"
    chk((&t41[0]) as u64, 46, !anim.animator_dirty(&g), (0) as i64, (0) as i64)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
}

fn main(start: u64) -> i32 {
    // ------------------------------------------------ 1: DIE ANFRAGEN
    var b: rt.Buf = rt.buf_new()
    backend.req_setup(&b, 0 as u64, 0, 0 as u64, 0)
    var h43: [u8; 12] = [108, 0, 11, 0, 0, 0, 0, 0, 0, 0, 0, 0]
    var t42: [u8; 38] = "1 Aufbau ohne Berechtigung (12 Oktett)"
