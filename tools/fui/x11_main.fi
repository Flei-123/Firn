    chk((&t96[0]) as u64, 30, backend.keymap_sym(&de, 20 as u32, 1 as u32) == 63 as u32, (backend.keymap_sym(&de, 20 as u32, 1 as u32)) as i64, (63) as i64)
    var t97: [u8; 24] = "4 US 29 -> y, DE 29 -> z"
    chk((&t97[0]) as u64, 24, backend.keymap_sym(&us, 29 as u32, 0 as u32) == 121 as u32 && backend.keymap_sym(&de, 29 as u32, 0 as u32) == 122 as u32, (backend.keymap_sym(&de, 29 as u32, 0 as u32)) as i64, (122) as i64)
    var t98: [u8; 28] = "4 DE 24 + AltGr -> at (0x40)"
