    ok = backend.decode_event(eb.ptr + 480 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t124: [u8; 46] = "5 15 SendEvent-Code 161 WM_DELETE -> EV_CLOSED"
    chk((&t124[0]) as u64, 46, ok && k == window.EV_CLOSED && rt.ld8(eb.ptr, 480) == 161 as u8, (rt.ld8(eb.ptr, 480)) as i64, (161) as i64)
    var empty: backend.Keymap = backend.keymap_new()
    ok = backend.decode_event(eb.ptr + 192 as u64, A_DELETE, &empty, true, &k, &ea, &ex, &ey, &es)
    var t125: [u8; 41] = "5 ohne Belegung: alter Weg key_ascii -> a"
    chk((&t125[0]) as u64, 41, ok && k == window.EV_CHAR && ea == 97 as u32, (ea) as i64, (97) as i64)

    // ----------------------------------------------- 6: ~/.Xauthority
    var p_xa: [u8; 24] = "testdata/x11/xauthority\0"
    var xb: rt.Buf = rt.buf_new()
    var an: rt.Buf = rt.buf_new()
    var ad: rt.Buf = rt.buf_new()
    let da_x: bool = rt.read_file((&p_xa[0]) as u64, &xb)
    let x7: bool = backend.auth_pick(xb.ptr, xb.len, 7, &an, &ad)
    var t126: [u8; 41] = "6 Anzeige 7: Keks 0f1e..f0 (xauth add :7)"
    chk((&t126[0]) as u64, 41, da_x && x7 && ad.len == 16 && rt.ld8(ad.ptr, 0) == 15 as u8 && rt.ld8(ad.ptr, 15) == 240 as u8, (rt.ld8(ad.ptr, 0)) as i64, (15) as i64)
    var t127: [u8; 30] = "6 Name MIT-MAGIC-COOKIE-1 (18)"
