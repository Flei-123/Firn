    var fui3: [u8; 3] = "fUi"
    rt.buf_clear(&b)
    backend.req_change_property(&b, WID, 39 as u32, 31 as u32, 8 as u32, (&fui3[0]) as u64, 3)
    var h53: [u8; 28] = [18, 0, 7, 0, 1, 0, 32, 0, 39, 0, 0, 0, 31, 0, 0, 0, 8, 0, 0, 0, 3, 0, 0, 0, 102, 85, 105, 0]
    var t52: [u8; 42] = "1 ChangeProperty WM_NAME fUi (+1 Fuellung)"
    hexchk((&t52[0]) as u64, 42, &b, (&h53[0]) as u64, 28)
    var del: [u32; 1] = [A_DELETE; 1]
    rt.buf_clear(&b)
