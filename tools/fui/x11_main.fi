    rt.buf_clear(&b)
    backend.req_create_window(&b, WID, 1293 as u32, 24 as u32, 33 as u32, 1240, 720, 16777215 as u32, 163967 as u32)
    var h51: [u8; 40] = [1, 24, 10, 0, 1, 0, 32, 0, 13, 5, 0, 0, 0, 0, 0, 0, 216, 4, 208, 2, 0, 0, 1, 0, 33, 0, 0, 0, 2, 8, 0, 0, 255, 255, 255, 0, 127, 128, 2, 0]
    var t50: [u8; 35] = "1 CreateWindow 1240x720, zwei Werte"
