    // ------------------------------------------- 5: DIE EREIGNISSE
    var p_ev: [u8; 24] = "testdata/x11/events.bin\0"
    var eb: rt.Buf = rt.buf_new()
    let da_e: bool = rt.read_file((&p_ev[0]) as u64, &eb)
    var t109: [u8; 29] = "5 16 Ereignisse im Mitschnitt"
    chk((&t109[0]) as u64, 29, da_e && eb.len == 512, (eb.len) as i64, (512) as i64)
    var k: u32 = 0 as u32
    var ea: u32 = 0 as u32
    var ex: u32 = 0 as u32
    var ey: u32 = 0 as u32
    var es: u32 = 0 as u32
    var ok: bool = backend.decode_event(eb.ptr, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t110: [u8; 10] = "5 0 Expose"
