    var t71: [u8; 24] = "2 Kennungsbasis 0x200000"
    chk((&t71[0]) as u64, 24, su.id_base == 2097152 as u32, (su.id_base) as i64, (2097152) as i64)
    var t72: [u8; 24] = "2 Kennungsmaske 0x1fffff"
    chk((&t72[0]) as u64, 24, su.id_mask == 2097151 as u32, (su.id_mask) as i64, (2097151) as i64)
    var t73: [u8; 37] = "2 Schirm 1400 Punkte breit (xdpyinfo)"
    chk((&t73[0]) as u64, 37, su.s_px_w == 1400, (su.s_px_w) as i64, (1400) as i64)
    var t74: [u8; 35] = "2 Schirm 900 Punkte hoch (xdpyinfo)"
    chk((&t74[0]) as u64, 35, su.s_px_h == 900, (su.s_px_h) as i64, (900) as i64)
    var t75: [u8; 32] = "2 Schirm 370 mm breit (xdpyinfo)"
    chk((&t75[0]) as u64, 32, su.s_mm_w == 370, (su.s_mm_w) as i64, (370) as i64)
    var t76: [u8; 39] = "2 24-Bit-Visual 0x21 (xdpyinfo default)"
    chk((&t76[0]) as u64, 39, su.visual == 33 as u32 && su.depth == 24 as u32, (su.visual) as i64, (33) as i64)
    var t77: [u8; 35] = "2 Tastencodes 8..255 (xmodmap -pke)"
    chk((&t77[0]) as u64, 35, su.kmin == 8 as u32 && su.kmax == 255 as u32, (su.kmax) as i64, (255) as i64)
    let dpi_mm: usize = backend.dpi_from_mm(su.s_px_w, su.s_mm_w)
    var t78: [u8; 36] = "2 Dichte aus mm: 96 (xdpyinfo 96x96)"
    chk((&t78[0]) as u64, 36, dpi_mm == 96, (dpi_mm) as i64, (96) as i64)
    var t79: [u8; 33] = "2 und 2800 Punkte auf 370 mm: 192"
    chk((&t79[0]) as u64, 33, backend.dpi_from_mm(2800, 370) == 192, (backend.dpi_from_mm(2800, 370)) as i64, (192) as i64)
    var rejected: [u8; 8] = [0, 5, 11, 0, 0, 0, 2, 0]
    var su2: backend.Setup = backend.setup_new()
    let g2: u32 = backend.setup_parse((&rejected[0]) as u64, 8, &su2)
    var t80: [u8; 32] = "2 Status 0 = abgelehnt (Grund 5)"
    chk((&t80[0]) as u64, 32, g2 == 5 as u32, (g2) as i64, (5) as i64)
    let g3: u32 = backend.setup_parse(sb.ptr, 30, &su2)
    var t81: [u8; 25] = "2 abgeschnitten = Grund 7"
    chk((&t81[0]) as u64, 25, g3 == 7 as u32, (g3) as i64, (7) as i64)

    // ----------------------------------- 3: Xft.dpi FROM THE SERVER
    var p_res: [u8; 24] = "testdata/x11/resman.bin\0"
    var rb: rt.Buf = rt.buf_new()
    let da_r: bool = rt.read_file((&p_res[0]) as u64, &rb)
    let d144: usize = backend.resman_dpi(rb.ptr, rb.len)
    var t82: [u8; 43] = "3 RESOURCE_MANAGER nach xrdb 'Xft.dpi: 144'"
    chk((&t82[0]) as u64, 43, da_r && d144 == 144, (d144) as i64, (144) as i64)
    var r192: [u8; 47] = "Xcursor.size: 24\nXft.dpi:\t192\nXft.antialias:\t1\n"
    let d192: usize = backend.xft_dpi_in((&r192[0]) as u64, 47)
    var t83: [u8; 29] = "3 Xft.dpi mitten im Text: 192"
    chk((&t83[0]) as u64, 29, d192 == 192, (d192) as i64, (192) as i64)
    var r0: [u8; 17] = "Xft.antialias:\t1\n"
    var t84: [u8; 38] = "3 ohne Xft.dpi: 0 (dann gelten die mm)"
    chk((&t84[0]) as u64, 38, backend.xft_dpi_in((&r0[0]) as u64, 17) == 0, (backend.xft_dpi_in((&r0[0]) as u64, 17)) as i64, (0) as i64)

    // ------------------------------------------- 4: DIE TASTATUR
    var p_kus: [u8; 27] = "testdata/x11/keymap_us.bin\0"
    var p_kde: [u8; 27] = "testdata/x11/keymap_de.bin\0"
    var p_mus: [u8; 27] = "testdata/x11/modmap_us.bin\0"
    var p_mde: [u8; 27] = "testdata/x11/modmap_de.bin\0"
    var kb: rt.Buf = rt.buf_new()
    var mb: rt.Buf = rt.buf_new()
    var us: backend.Keymap = backend.keymap_new()
    var de: backend.Keymap = backend.keymap_new()
    let a1: bool = rt.read_file((&p_kus[0]) as u64, &kb)
    let a2: bool = backend.keymap_from_reply(&us, kb.ptr, kb.len, 8 as u32)
    rt.buf_clear(&kb)
    let a3: bool = rt.read_file((&p_kde[0]) as u64, &kb)
    let a4: bool = backend.keymap_from_reply(&de, kb.ptr, kb.len, 8 as u32)
    let a5: bool = rt.read_file((&p_mus[0]) as u64, &mb)
    let a6: bool = backend.keymap_mods_from_reply(&us, mb.ptr, mb.len)
    rt.buf_clear(&mb)
    let a7: bool = rt.read_file((&p_mde[0]) as u64, &mb)
    let a8: bool = backend.keymap_mods_from_reply(&de, mb.ptr, mb.len)
    var t85: [u8; 45] = "4 Belegung US: 7 Keysyms je Taste, 248 Tasten"
    chk((&t85[0]) as u64, 45, a1 && a2 && us.per == 7 && us.n == 248, (us.n) as i64, (248) as i64)
    var t86: [u8; 28] = "4 Belegung DE ebenso gelesen"
    chk((&t86[0]) as u64, 28, a3 && a4 && de.per == 7 && de.n == 248, (de.n) as i64, (248) as i64)
    var t87: [u8; 38] = "4 AltGr ist Mod5 = 128 (Tasten 92/203)"
    chk((&t87[0]) as u64, 38, a8 && de.lvl3 == 128 as u32, (de.lvl3) as i64, (128) as i64)
    var t88: [u8; 34] = "4 NumLock ist Mod2 = 16 (Taste 77)"
    chk((&t88[0]) as u64, 34, de.numlock == 16 as u32, (de.numlock) as i64, (16) as i64)
    var t89: [u8; 19] = "4 US 38 -> a (0x61)"
    chk((&t89[0]) as u64, 19, backend.keymap_sym(&us, 38 as u32, 0 as u32) == 97 as u32, (backend.keymap_sym(&us, 38 as u32, 0 as u32)) as i64, (97) as i64)
    var t90: [u8; 30] = "4 US 38 + Umschalt -> A (0x41)"
    chk((&t90[0]) as u64, 30, backend.keymap_sym(&us, 38 as u32, 1 as u32) == 65 as u32, (backend.keymap_sym(&us, 38 as u32, 1 as u32)) as i64, (65) as i64)
    var t91: [u8; 23] = "4 US 38 + CapsLock -> A"
    chk((&t91[0]) as u64, 23, backend.keymap_sym(&us, 38 as u32, 2 as u32) == 65 as u32, (backend.keymap_sym(&us, 38 as u32, 2 as u32)) as i64, (65) as i64)
    var t92: [u8; 34] = "4 US 38 + CapsLock + Umschalt -> a"
    chk((&t92[0]) as u64, 34, backend.keymap_sym(&us, 38 as u32, 3 as u32) == 97 as u32, (backend.keymap_sym(&us, 38 as u32, 3 as u32)) as i64, (97) as i64)
    var t93: [u8; 35] = "4 US 47 + Umschalt -> colon (C-033)"
    chk((&t93[0]) as u64, 35, backend.keymap_sym(&us, 47 as u32, 1 as u32) == 58 as u32, (backend.keymap_sym(&us, 47 as u32, 1 as u32)) as i64, (58) as i64)
    var t94: [u8; 44] = "4 US 10 + CapsLock bleibt 1 (kein Buchstabe)"
    chk((&t94[0]) as u64, 44, backend.keymap_sym(&us, 10 as u32, 2 as u32) == 49 as u32, (backend.keymap_sym(&us, 10 as u32, 2 as u32)) as i64, (49) as i64)
    var t95: [u8; 40] = "4 US 20 -> minus, DE 20 -> ssharp (0xdf)"
    chk((&t95[0]) as u64, 40, backend.keymap_sym(&us, 20 as u32, 0 as u32) == 45 as u32 && backend.keymap_sym(&de, 20 as u32, 0 as u32) == 223 as u32, (backend.keymap_sym(&de, 20 as u32, 0 as u32)) as i64, (223) as i64)
