    rt.buf_clear(&b)
    backend.req_create_gc(&b, WID + 1 as u32, WID)
    var h53: [u8; 16] = [55, 0, 4, 0, 2, 0, 32, 0, 1, 0, 32, 0, 0, 0, 0, 0]
    var t52: [u8; 21] = "1 CreateGC ohne Werte"
    hexchk((&t52[0]) as u64, 21, &b, (&h53[0]) as u64, 16)
    var fui3: [u8; 3] = "fUi"
    rt.buf_clear(&b)
    backend.req_change_property(&b, WID, 39 as u32, 31 as u32, 8 as u32, (&fui3[0]) as u64, 3)
    var h55: [u8; 28] = [18, 0, 7, 0, 1, 0, 32, 0, 39, 0, 0, 0, 31, 0, 0, 0, 8, 0, 0, 0, 3, 0, 0, 0, 102, 85, 105, 0]
    var t54: [u8; 42] = "1 ChangeProperty WM_NAME fUi (+1 Fuellung)"
    hexchk((&t54[0]) as u64, 42, &b, (&h55[0]) as u64, 28)
    var del: [u32; 1] = [A_DELETE; 1]
    rt.buf_clear(&b)
    backend.req_change_property(&b, WID, 240 as u32, 4 as u32, 32 as u32, (&del[0]) as u64, 4)
    var h57: [u8; 28] = [18, 0, 7, 0, 1, 0, 32, 0, 240, 0, 0, 0, 4, 0, 0, 0, 32, 0, 0, 0, 1, 0, 0, 0, 241, 0, 0, 0]
    var t56: [u8; 38] = "1 ChangeProperty WM_PROTOCOLS = 1 Atom"
