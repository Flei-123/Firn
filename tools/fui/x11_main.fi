    ok = backend.decode_event(eb.ptr + 64 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t112: [u8; 21] = "5 2 Knopf 1 gedrueckt"
    chk((&t112[0]) as u64, 21, ok && k == window.EV_BUTTON && ea == 1 as u32, (ea) as i64, (1) as i64)
    ok = backend.decode_event(eb.ptr + 96 as u64, A_DELETE, &us, true, &k, &ea, &ex, &ey, &es)
    var t113: [u8; 46] = "5 3 Knopf 1 losgelassen, Zustand Button1 (256)"
