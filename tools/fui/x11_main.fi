    var su: backend.Setup = backend.setup_new()
    let basic: u32 = backend.setup_parse(sb.ptr, sb.len, &su)
    var t69: [u8; 29] = "2 Aufbau angenommen (Grund 0)"
    chk((&t69[0]) as u64, 29, basic == 0 as u32, (basic) as i64, (0) as i64)
    var t70: [u8; 44] = "2 Wurzelfenster 1293 (xwininfo -root: 0x50d)"
