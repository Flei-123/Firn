// SPDX-License-Identifier: MPL-2.0
// tools/fui/sheet_main.fi -- DIE RANGFOLGE WIRD NACHGERECHNET.
//
// Ein Stilblatt ist nur so viel wert wie die Frage "welche von zwei
// widersprechenden Regeln gilt". Wer sie mit "die letzte" beantwortet,
// hat kein Stilblatt, sondern eine Aufrufliste. Darum stehen hier
// ABSICHTLICH widerspruechliche Faelle, und jede Zahl ist von Hand
// gerechnet:
//
//   1. Die Raenge selbst: Kennung 10000, Klasse 100, Zustand 100,
//      Art 1 -- und die Teile eines Vorfahren zaehlen mit.
//   2. Drei Regeln setzen denselben Wert: Kennung schlaegt Klasse
//      schlaegt Art.
//   3. Gleichstand: zwei Klassenregeln, die spaetere gewinnt.
//   4. Eine ranghohe Regel, die NUR die Schriftfarbe nennt, loescht
//      den Grund einer rangniedrigen nicht.
//   5. Vererbung: Schriftfarbe/-groesse/-familie/Zeilenhoehe kommen
//      beim Kind an, der Grund NICHT.
//   6. Die Schrittweite von sheet.NodeDesc wird GEMESSEN --
//      `chain_at` holt sie aus sheet.sheet_desc_stride, und hier steht
//      sie gegen die echte Adressdifferenz zweier Kettenglieder.
//   7. VIER Regeln, die alle auf denselben Knoten passen und alle
//      denselben Wert setzen, an einer Kette der Tiefe 4
//      ("Klasse in Klasse in Kennung"): zwei von ihnen stehen im
//      Gleichstand, und der Vorfahr mit Kennung schlaegt sie alle.
//      Dazu die Gegenprobe, dass ein Knoten nicht sein eigener
//      Vorfahr ist.
//   8. Der Zustand: DIESELBE Auswahl am DEMSELBEN Knoten, einmal im
//      Stand und einmal unter dem Zeiger -- die Zahlen muessen kippen
//      und beim Zuruecksetzen zurueckkippen.
//   9. Die Grenze der Vererbung mit je einer Zahl fuer JEDEN nicht
//      vererbbaren Wert: Grund, Rahmen, Radius, Polster, Ausrichtung,
//      Alpha.
//  10. Die Bruecken: dass `transition` wirklich in einem
//      anim.Transition ankommt und `transform` wirklich am Punkt
//      zieht. Gerechnet wird in anim.fi und lib/svg/matrix.fi --
//      sheet.fi reicht nur durch, und genau das wird hier gemessen.
//  11. Die beiden Schranken, die sonst schweigen wuerden: das 65.
//      Regelpaar und die fuenfte Klasse einer Auswahl. Beide werden
//      GEZAEHLT (`sheet_rule_overflow`, `sel_class_overflow`), beide
//      mit Gegenprobe an der genau vollen Schranke.
import std.rt
import fui.style
import fui.sheet
import fui.anim
import fui.transform

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    var w: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&w[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// Auf Tausendstel gerundet, SYMMETRISCH um die Null -- `as i64`
// schneidet zur Null hin ab, und eine Pruefung, die an ihrer eigenen
// Rundung scheitert, hilft niemandem. Dieselbe Fassung wie in
// tools/fui/transform_main.fi, weil dort dieselben Punkte gemessen
// werden.
fn milli(x: f64) -> i64 {
    if x < 0.0 {
        return 0 - (((0.0 - x) * 1000.0 + 0.5) as i64)
    }
    return (x * 1000.0 + 0.5) as i64
}

// Ein Grundwert als Farbe, damit sich die Faelle unterscheiden lassen.
fn bg_decl(v: u32) -> sheet.Decl {
    var d: sheet.Decl = sheet.decl_new()
    sheet.decl_set_style(&d,
        style.style_set_bg(style.style_new(), style.color_literal(v)))
    return d
}

fn resolved_bg(sh: *mut sheet.Sheet, chain: *mut sheet.NodeDesc,
    depth: usize) -> i64 {
    var d: sheet.Decl = sheet.decl_new()
    sheet.sheet_resolve(sh, chain, depth, &d)
    return style.color_value((*sheet.decl_style(&d)).bg) as i64
}

fn main(start: u64) -> i32 {
    // =================================================== 1. DIE RAENGE
    var k1: [u8; 5] = "knopf"
    var k2: [u8; 4] = "kopf"
    let C_KNOPF: u32 = sheet.sheet_name((&k1[0]) as u64, 5)
    let C_KOPF: u32 = sheet.sheet_name((&k2[0]) as u64, 4)
    let ID_OK: u32 = sheet.sheet_name((&k2[0]) as u64, 4) + 7 as u32

    var s_art: sheet.Sel = sheet.sel_kind(1005 as u32)
    var s_cls: sheet.Sel = sheet.sel_class(C_KNOPF)
    var s_id: sheet.Sel = sheet.sel_id(ID_OK)
    var s_cs: sheet.Sel = sheet.sel_with_state(sheet.sel_class(C_KNOPF),
        style.STATE_HOVER)
    var s_in: sheet.Sel = sheet.sel_within_class(sheet.sel_class(C_KNOPF),
        C_KOPF)

    var n1: [u8; 20] = "1 Art zaehlt 1      "
    report((&n1[0]) as u64, 20, sheet.sel_specificity(&s_art) == 1,
        sheet.sel_specificity(&s_art), 1)
    var n2: [u8; 20] = "1 Klasse zaehlt 100 "
    report((&n2[0]) as u64, 20, sheet.sel_specificity(&s_cls) == 100,
        sheet.sel_specificity(&s_cls), 100)
    var n3: [u8; 24] = "1 Kennung zaehlt 10000  "
    report((&n3[0]) as u64, 24, sheet.sel_specificity(&s_id) == 10000,
        sheet.sel_specificity(&s_id), 10000)
    var n4: [u8; 26] = "1 Klasse+Zustand sind 200 "
    report((&n4[0]) as u64, 26, sheet.sel_specificity(&s_cs) == 200,
        sheet.sel_specificity(&s_cs), 200)
    var n5: [u8; 26] = "1 Klasse in Klasse ist 200"
    report((&n5[0]) as u64, 26, sheet.sel_specificity(&s_in) == 200,
        sheet.sel_specificity(&s_in), 200)

    // ============================== 2. DREI REGELN, DERSELBE WERT
    //
    // Sie stehen in der UNGUENSTIGSTEN Reihenfolge: die Kennung zuerst,
    // die Art zuletzt. Gewinnt trotzdem die Kennung, entscheidet
    // wirklich der Rang und nicht die Reihenfolge.
    var sh: sheet.Sheet = sheet.sheet_new()
    sheet.sheet_add(&sh, s_id, bg_decl(3 as u32))
    sheet.sheet_add(&sh, s_cls, bg_decl(2 as u32))
    sheet.sheet_add(&sh, s_art, bg_decl(1 as u32))

    var chain: [sheet.NodeDesc; 4] = [sheet.desc_new(0 as u32, 0 as u32); 4]
    chain[0] = sheet.desc_new(1001 as u32, 0 as u32)
    sheet.desc_add_class(&chain[0], C_KOPF)
    chain[1] = sheet.desc_new(1005 as u32, ID_OK)
    sheet.desc_add_class(&chain[1], C_KNOPF)

    let v: i64 = resolved_bg(&sh, &chain[0], 2)
    var n6: [u8; 30] = "2 Kennung schlaegt Klasse+Art "
    report((&n6[0]) as u64, 30, v == 3, v, 3)

    // Dasselbe ohne die Kennung: jetzt muss die Klasse gewinnen.
    var sh2: sheet.Sheet = sheet.sheet_new()
    sheet.sheet_add(&sh2, s_cls, bg_decl(2 as u32))
    sheet.sheet_add(&sh2, s_art, bg_decl(1 as u32))
    let v2: i64 = resolved_bg(&sh2, &chain[0], 2)
    var n7: [u8; 24] = "2 Klasse schlaegt Art   "
    report((&n7[0]) as u64, 24, v2 == 2, v2, 2)

    // ====================================== 3. GLEICHSTAND
    var sh3: sheet.Sheet = sheet.sheet_new()
    sheet.sheet_add(&sh3, s_cls, bg_decl(7 as u32))
    sheet.sheet_add(&sh3, sheet.sel_class(C_KNOPF), bg_decl(9 as u32))
    let v3: i64 = resolved_bg(&sh3, &chain[0], 2)
    var n8: [u8; 32] = "3 bei Gleichstand die spaetere  "
    report((&n8[0]) as u64, 32, v3 == 9, v3, 9)

    // ========================= 4. EINE RANGHOHE REGEL LOESCHT NICHTS
    var d_fg: sheet.Decl = sheet.decl_new()
    sheet.decl_set_style(&d_fg, style.style_set_fg(style.style_new(),
            style.color_literal(42 as u32)))
    var sh4: sheet.Sheet = sheet.sheet_new()
    sheet.sheet_add(&sh4, s_cls, bg_decl(5 as u32))
    sheet.sheet_add(&sh4, s_id, d_fg)
    var d4: sheet.Decl = sheet.decl_new()
    sheet.sheet_resolve(&sh4, &chain[0], 2, &d4)
    let bg4: i64 = style.color_value((*sheet.decl_style(&d4)).bg) as i64
    let fg4: i64 = style.color_value((*sheet.decl_style(&d4)).fg) as i64
    var n9: [u8; 34] = "4 der Grund der Klasse bleibt     "
    report((&n9[0]) as u64, 34, bg4 == 5, bg4, 5)
    var n10: [u8; 34] = "4 die Schriftfarbe der Kennung    "
    report((&n10[0]) as u64, 34, fg4 == 42, fg4, 42)

    // ==================================== 5. DIE VERERBUNG UND IHR ENDE
    var eltern: sheet.Decl = sheet.decl_new()
    var es: style.Style = style.style_new()
    es = style.style_set_fg(es, style.color_literal(11 as u32))
    es = style.style_set_bg(es, style.color_literal(22 as u32))
    es = style.style_set_font(es, 0, 19)
    sheet.decl_set_style(&eltern, es)
    var kind: sheet.Decl = sheet.decl_new()
    sheet.decl_inherit(&kind, &eltern)
    let kfg: i64 = style.color_value((*sheet.decl_style(&kind)).fg) as i64
    let kpx: i64 = (*sheet.decl_style(&kind)).font_px as i64
    let khat_bg: bool = sheet.decl_has(&kind, style.SF_BG, false)
    var n11: [u8; 32] = "5 Schriftfarbe wird vererbt     "
    report((&n11[0]) as u64, 32, kfg == 11, kfg, 11)
    var n12: [u8; 32] = "5 Schriftgroesse wird vererbt   "
    report((&n12[0]) as u64, 32, kpx == 19, kpx, 19)
    var n13: [u8; 32] = "5 der Grund wird NICHT vererbt  "
    report((&n13[0]) as u64, 32, !khat_bg, khat_bg as i64, 0)

    // Und das eigene Wort des Kindes schlaegt das Erbe.
    var kind2: sheet.Decl = sheet.decl_new()
    sheet.decl_set_style(&kind2, style.style_set_fg(style.style_new(),
            style.color_literal(99 as u32)))
    sheet.decl_inherit(&kind2, &eltern)
    let k2fg: i64 = style.color_value((*sheet.decl_style(&kind2)).fg) as i64
    var n14: [u8; 32] = "5 eigener Wert schlaegt das Erbe"
    report((&n14[0]) as u64, 32, k2fg == 99, k2fg, 99)

    let mask: i64 = sheet.INHERIT_MASK as i64
    let soll: i64 = (style.SF_FG | style.SF_FONT_PX | style.SF_FONT_ID
        | style.SF_LINE_HEIGHT) as i64
    var n15: [u8; 32] = "5 die Erbmaske sind genau vier  "
    report((&n15[0]) as u64, 32, mask == soll, mask, soll)

    // ============================= 6. DIE SCHRITTWEITE WIRD GEMESSEN
    //
    // `chain_at` rechnet die Adresse des i-ten Kettengliedes aus. Die
    // Zahl dafuer steht nirgends als Ziffer, sondern in
    // sheet.sheet_desc_stride -- und die wird hier gegen die ECHTE
    // Adressdifferenz zweier Nachbarn dieser Kette gehalten. Eine 56 an
    // dieser Stelle waere derselbe Fehler noch einmal: ein zweiter Ort
    // fuer eine Zahl, die der Uebersetzer bestimmt.
    let schritt: i64 = ((&chain[1]) as u64 - (&chain[0]) as u64) as i64
    var n16: [u8; 32] = "6 die Schrittweite stimmt       "
    report((&n16[0]) as u64, 32,
        sheet.sheet_desc_stride() as i64 == schritt,
        sheet.sheet_desc_stride() as i64, schritt)
    // Und die Gegenprobe, dass sie wirklich benutzt wird: das zweite
    // Glied, ueber chain_at geholt, ist dasselbe wie &chain[1].
    let zweites: i64 = ((&chain[0]) as u64
        +(sheet.sheet_desc_stride()) as u64) as i64
    var n16b: [u8; 32] = "6 chain_at trifft Glied 1       "
    report((&n16b[0]) as u64, 32, zweites == ((&chain[1]) as u64) as i64,
        zweites, ((&chain[1]) as u64) as i64)

    // ========== 7. VIER PASSENDE REGELN, PAARWEISE IM WIDERSPRUCH
    //
    // Alle vier passen auf DENSELBEN Knoten und setzen ALLE den Grund --
    // sie koennen also nicht alle gelten. Eingetragen sind sie in der
    // unguenstigsten Reihenfolge (die schwaechste zuerst waere zu
    // einfach; hier steht die staerkste NICHT am Schluss), damit die
    // Reihenfolge nicht zufaellig dasselbe liefert wie der Rang:
    //
    //   A  Art 1005                             Rang     1   -> 10
    //   B  Klasse `knopf`                       Rang   100   -> 20
    //   C  Klasse `knopf` UND `gross`           Rang   200   -> 30
    //   D  Klasse `gross` innerhalb `liste`     Rang   200   -> 40
    //
    // C und D stehen im Gleichstand; D ist spaeter geschrieben, also
    // gewinnt D. Von Hand: 40.
    var k3: [u8; 5] = "gross"
    var k4: [u8; 5] = "liste"
    var k5: [u8; 5] = "seite"
    let C_GROSS: u32 = sheet.sheet_name((&k3[0]) as u64, 5)
    let C_LISTE: u32 = sheet.sheet_name((&k4[0]) as u64, 5)
    let ID_SEITE: u32 = sheet.sheet_name((&k5[0]) as u64, 5)

    // DIE KETTE DER TIEFE 4. Wurzel zuerst, der Knopf zuletzt:
    // Seite (Kennung) > Liste (Klasse) > Zeile > Knopf.
    var kette: [sheet.NodeDesc; 4] = [sheet.desc_new(0 as u32, 0 as u32); 4]
    kette[0] = sheet.desc_new(1001 as u32, ID_SEITE)
    sheet.desc_add_class(&kette[0], C_KOPF)
    kette[1] = sheet.desc_new(1002 as u32, 0 as u32)
    sheet.desc_add_class(&kette[1], C_LISTE)
    kette[2] = sheet.desc_new(1003 as u32, 0 as u32)
    kette[3] = sheet.desc_new(1005 as u32, ID_OK)
    sheet.desc_add_class(&kette[3], C_KNOPF)
    sheet.desc_add_class(&kette[3], C_GROSS)

    var r_a: sheet.Sel = sheet.sel_kind(1005 as u32)
    var r_b: sheet.Sel = sheet.sel_class(C_KNOPF)
    var r_c: sheet.Sel = sheet.sel_with_class(sheet.sel_class(C_KNOPF),
        C_GROSS)
    var r_d: sheet.Sel = sheet.sel_within_class(sheet.sel_class(C_GROSS),
        C_LISTE)
    var r_e: sheet.Sel = sheet.sel_within_id(sheet.sel_class(C_KNOPF),
        ID_SEITE)

    var n17: [u8; 34] = "7 zwei Klassen zaehlen 200        "
    report((&n17[0]) as u64, 34, sheet.sel_specificity(&r_c) == 200,
        sheet.sel_specificity(&r_c), 200)
    var n18: [u8; 34] = "7 Klasse in Kennung zaehlt 10100  "
    report((&n18[0]) as u64, 34, sheet.sel_specificity(&r_e) == 10100,
        sheet.sel_specificity(&r_e), 10100)

    var sh7: sheet.Sheet = sheet.sheet_new()
    sheet.sheet_add(&sh7, r_c, bg_decl(30 as u32))
    sheet.sheet_add(&sh7, r_a, bg_decl(10 as u32))
    sheet.sheet_add(&sh7, r_d, bg_decl(40 as u32))
    sheet.sheet_add(&sh7, r_b, bg_decl(20 as u32))
    let v7: i64 = resolved_bg(&sh7, &kette[0], 4)
    var n19: [u8; 34] = "7 von vier Regeln gewinnt D       "
    report((&n19[0]) as u64, 34, v7 == 40, v7, 40)

    // Und die fuenfte, die ueber die KENNUNG eines Vorfahren geht,
    // schlaegt sie alle: 100 + 10000 = 10100 gegen hoechstens 200.
    sheet.sheet_add(&sh7, r_e, bg_decl(50 as u32))
    let v8: i64 = resolved_bg(&sh7, &kette[0], 4)
    var n20: [u8; 34] = "7 der Vorfahr mit Kennung schlaegt"
    report((&n20[0]) as u64, 34, v8 == 50, v8, 50)

    // DER VORFAHR IST EIN ECHTER VORFAHR. `gross` sitzt am Knoten
    // SELBST; eine Auswahl "knopf innerhalb gross" darf darum NICHT
    // passen -- sonst waere jeder Knoten sein eigener Vorfahr. Uebrig
    // bleibt allein die Artregel mit 10.
    var sh8: sheet.Sheet = sheet.sheet_new()
    sheet.sheet_add(&sh8, r_a, bg_decl(10 as u32))
    sheet.sheet_add(&sh8, sheet.sel_within_class(sheet.sel_class(C_KNOPF),
            C_GROSS), bg_decl(60 as u32))
    let v9: i64 = resolved_bg(&sh8, &kette[0], 4)
    var n21: [u8; 35] = "7 der Knoten ist nicht sein Vorfahr"
    report((&n21[0]) as u64, 35, v9 == 10, v9, 10)

    // ========================== 8. DERSELBE KNOTEN, EINMAL UEBERFAHREN
    //
    // Zwei Regeln auf denselben Knoten: die eine ohne Zustand (Rang
    // 100), die andere mit STATE_HOVER (Rang 200). Im Stand kann die
    // zweite gar nicht passen -- 55. Sobald der Zeiger darauf steht,
    // passt sie UND hat den hoeheren Rang -- 77. Die Zahlen kippen,
    // ohne dass am Blatt etwas geaendert wurde.
    var sh9: sheet.Sheet = sheet.sheet_new()
    sheet.sheet_add(&sh9, sheet.sel_class(C_KNOPF), bg_decl(55 as u32))
    sheet.sheet_add(&sh9, sheet.sel_with_state(sheet.sel_class(C_KNOPF),
            style.STATE_HOVER), bg_decl(77 as u32))
    let v_ruhe: i64 = resolved_bg(&sh9, &kette[0], 4)
    var n22: [u8; 34] = "8 im Stand gilt die Klassenregel  "
    report((&n22[0]) as u64, 34, v_ruhe == 55, v_ruhe, 55)
    sheet.desc_set_state(&kette[3], style.STATE_HOVER)
    let v_hover: i64 = resolved_bg(&sh9, &kette[0], 4)
    var n23: [u8; 34] = "8 unter dem Zeiger kippt es       "
    report((&n23[0]) as u64, 34, v_hover == 77, v_hover, 77)
    sheet.desc_set_state(&kette[3], style.STATE_NORMAL)
    let v_zurueck: i64 = resolved_bg(&sh9, &kette[0], 4)
    var n24: [u8; 34] = "8 und zurueck ist es wieder 55    "
    report((&n24[0]) as u64, 34, v_zurueck == 55, v_zurueck, 55)

    // ====================== 9. DIE GRENZE DER VERERBUNG, WERT FUER WERT
    //
    // Das Elternteil setzt SECHS nicht vererbbare Werte, jeden mit
    // einer eigenen, wiedererkennbaren Zahl. Beim Kind muss JEDER von
    // ihnen auf der Vorgabe stehen bleiben -- ein vererbter Grund malt
    // jede Schachtel noch einmal aus, ein vererbter Rand saesse um
    // jedes Kind herum, ein vererbtes Polster addierte sich mit jeder
    // Ebene.
    var e2: style.Style = style.style_new()
    e2 = style.style_set_bg(e2, style.color_literal(22 as u32))
    e2 = style.style_set_border(e2, style.color_literal(33 as u32), 5)
    e2 = style.style_set_radius(e2, 9)
    e2 = style.style_set_pad(e2, 13, 14)
    e2 = style.style_set_align(e2, style.ALIGN_RIGHT)
    e2 = style.style_set_alpha(e2, 128)
    // Und EIN vererbbarer Wert daneben, damit die Pruefung nicht
    // deshalb gruen ist, weil ueberhaupt nichts ankommt.
    e2 = style.style_set_font(e2, 0, 17)
    var eltern2: sheet.Decl = sheet.decl_new()
    sheet.decl_set_style(&eltern2, e2)
    var kind3: sheet.Decl = sheet.decl_new()
    sheet.decl_inherit(&kind3, &eltern2)
    let ks: *mut style.Style = sheet.decl_style(&kind3)

    let g_bg: i64 = style.color_value((*ks).bg) as i64
    var n25: [u8; 34] = "9 Grund bleibt beim Kind leer     "
    report((&n25[0]) as u64, 34, g_bg == 0, g_bg, 0)
    let g_bor: i64 = (*ks).border_w as i64
    var n26: [u8; 34] = "9 Rahmen bleibt 0 (Elternteil 5)  "
    report((&n26[0]) as u64, 34, g_bor == 0, g_bor, 0)
    let g_rad: i64 = (*ks).radius as i64
    var n27: [u8; 34] = "9 Radius bleibt 0 (Elternteil 9)  "
    report((&n27[0]) as u64, 34, g_rad == 0, g_rad, 0)
    let g_pad: i64 = ((*ks).pad_x + (*ks).pad_y) as i64
    var n28: [u8; 34] = "9 Polster bleibt 0 (Eltern 13+14) "
    report((&n28[0]) as u64, 34, g_pad == 0, g_pad, 0)
    let g_al: i64 = (*ks).align as i64
    var n29: [u8; 34] = "9 Ausrichtung bleibt links (0)    "
    report((&n29[0]) as u64, 34, g_al == 0, g_al, 0)
    let g_alpha: i64 = (*ks).alpha as i64
    var n30: [u8; 34] = "9 Alpha bleibt 255 (Elternteil 128"
    report((&n30[0]) as u64, 34, g_alpha == 255, g_alpha, 255)
    // Die Gegenprobe: die Schriftgroesse IST angekommen.
    let g_px: i64 = (*ks).font_px as i64
    var n31: [u8; 34] = "9 die Schriftgroesse kommt aber an"
    report((&n31[0]) as u64, 34, g_px == 17, g_px, 17)
    // Und kein einziges der sechs Bits steht in der Maske des Kindes.
    let verboten: u32 = style.SF_BG | style.SF_BORDER | style.SF_BORDER_W
    | style.SF_RADIUS | style.SF_PAD_X | style.SF_PAD_Y
    | style.SF_ALIGN | style.SF_ALPHA
    let g_mask: i64 = ((*ks).set_mask & verboten) as i64
    var n32: [u8; 34] = "9 kein verbotenes Bit in der Maske"
    report((&n32[0]) as u64, 34, g_mask == 0, g_mask, 0)

    // ================== 10. DIE BRUECKEN: DER WERT WIRD ZUR WIRKUNG
    //
    // Ein `transition` im Blatt, das niemand abholt, ist eine
    // Behauptung. Hier wird gemessen, dass die Dauer wirklich in einem
    // anim.Transition ankommt und die Umformung wirklich am Punkt
    // zieht. Gerechnet wird dabei in anim.fi und in lib/svg/matrix.fi;
    // sheet.fi reicht nur durch.
    var d_tr: sheet.Decl = sheet.decl_new()
    sheet.decl_set_transition(&d_tr, 250, anim.EASE_IN_OUT)
    var tr: anim.Transition = anim.trans_new(0 as u32, 0.0, 0.0, 1.0)
    let hat: bool = sheet.decl_apply_transition(&d_tr, &tr)
    let dauer: i64 = anim.trans_duration(&tr)
    var n33: [u8; 34] = "10 die Dauer kommt bei anim an    "
    report((&n33[0]) as u64, 34, hat && dauer == 250, dauer, 250)
    var kurve: anim.Easing = sheet.decl_easing(&d_tr)
    var n34: [u8; 34] = "10 die Kurve ist ease-in-out (3)  "
    report((&n34[0]) as u64, 34, kurve.kind == anim.EASE_IN_OUT,
        kurve.kind as i64, anim.EASE_IN_OUT as i64)

    // Ein Decl OHNE `transition` fasst den Uebergang nicht an: die 120
    // sind die Vorgabe aus anim.trans_new, und sie muss stehen bleiben.
    var d_leer: sheet.Decl = sheet.decl_new()
    var tr2: anim.Transition = anim.trans_new(0 as u32, 0.0, 0.0, 1.0)
    let hat2: bool = sheet.decl_apply_transition(&d_leer, &tr2)
    let dauer2: i64 = anim.trans_duration(&tr2)
    var n35: [u8; 34] = "10 ohne Angabe bleibt die Vorgabe "
    report((&n35[0]) as u64, 34, !hat2 && dauer2 == 120, dauer2, 120)
    var kurve2: anim.Easing = sheet.decl_easing(&d_leer)
    var n36: [u8; 34] = "10 und die Kurve ist linear (0)   "
    report((&n36[0]) as u64, 34, kurve2.kind == anim.EASE_LINEAR,
        kurve2.kind as i64, anim.EASE_LINEAR as i64)

    // Die Verschiebung: der Ursprung landet bei (10, 5).
    var d_v: sheet.Decl = sheet.decl_new()
    sheet.decl_set_translate(&d_v, 10.0, 5.0)
    var xf: transform.Xform = transform.xf_new()
    sheet.decl_apply_transform(&d_v, &xf)
    let vx: i64 = milli(transform.xf_point_x(&xf, 0.0, 0.0))
    let vy: i64 = milli(transform.xf_point_y(&xf, 0.0, 0.0))
    var n37: [u8; 34] = "10 verschoben: x = 10 (in Milli)  "
    report((&n37[0]) as u64, 34, vx == 10000, vx, 10000)
    var n38: [u8; 34] = "10 verschoben: y = 5 (in Milli)   "
    report((&n38[0]) as u64, 34, vy == 5000, vy, 5000)

    // Die Streckung um den Ursprung: (4, 6) wird zu (8, 18).
    var d_s: sheet.Decl = sheet.decl_new()
    sheet.decl_set_scale(&d_s, 2.0, 3.0)
    var xf2: transform.Xform = transform.xf_new()
    sheet.decl_apply_transform(&d_s, &xf2)
    let sx2: i64 = milli(transform.xf_point_x(&xf2, 4.0, 6.0))
    let sy2: i64 = milli(transform.xf_point_y(&xf2, 4.0, 6.0))
    var n39: [u8; 34] = "10 gestreckt: 4 mal 2 sind 8      "
    report((&n39[0]) as u64, 34, sx2 == 8000, sx2, 8000)
    var n40: [u8; 34] = "10 gestreckt: 6 mal 3 sind 18     "
    report((&n40[0]) as u64, 34, sy2 == 18000, sy2, 18000)

    // Die Drehung IN GRAD, um die Mitte eines Kastens von 20 mal 20:
    // der linke obere Punkt (0, 0) faellt bei 90 Grad auf (20, 0).
    var d_r: sheet.Decl = sheet.decl_new()
    sheet.decl_set_rotate(&d_r, 90.0)
    var xf3: transform.Xform = transform.xf_new()
    sheet.decl_apply_transform_at(&d_r, &xf3, 10.0, 10.0)
    let rx: i64 = milli(transform.xf_point_x(&xf3, 0.0, 0.0))
    let ry: i64 = milli(transform.xf_point_y(&xf3, 0.0, 0.0))
    var n41: [u8; 34] = "10 gedreht um 90 Grad: x wird 20  "
    report((&n41[0]) as u64, 34, rx == 20000, rx, 20000)
    var n42: [u8; 34] = "10 gedreht um 90 Grad: y wird 0   "
    report((&n42[0]) as u64, 34, ry == 0, ry, 0)

    // Ein Decl ohne Umformung laesst den Stapel in Ruhe: der Punkt
    // (7, 7) bleibt (7, 7), und die Bruecke sagt es auch.
    var xf4: transform.Xform = transform.xf_new()
    let hat3: bool = sheet.decl_apply_transform(&d_leer, &xf4)
    let nx: i64 = milli(transform.xf_point_x(&xf4, 7.0, 7.0))
    var n43: [u8; 34] = "10 ohne Umformung bleibt 7 bei 7  "
    report((&n43[0]) as u64, 34, !hat3 && nx == 7000, nx, 7000)

    // ================== 11. DIE ZWEI SCHRANKEN, DIE SONST SCHWIEGEN
    //
    // Ein Blatt fasst RULE_MAX = 64 Regeln, eine Auswahl
    // SEL_CLASS_MAX = 4 Klassen. Beides sind feste Felder -- und beides
    // verschluckte bis zum 21.09.2026 still, was nicht mehr hineinpasste.
    // Eine fehlende Regel laesst einen Teil der Oberflaeche unbemalt;
    // eine fehlende Klasse macht die Auswahl WEITER, als sie geschrieben
    // steht, und trifft damit Knoten, die niemand gemeint hat. Also
    // zaehlen beide, und hier stehen die Zahlen -- samt Gegenprobe, dass
    // der Zaehler nicht jeden Aufruf meldet.
    var blatt_voll: sheet.Sheet = sheet.sheet_new()
    var d_f: sheet.Decl = sheet.decl_new()
    var i_f: usize = 0
    while i_f < sheet.RULE_MAX {
        sheet.sheet_add(&blatt_voll, sheet.sel_kind(i_f as u32), d_f)
        i_f = i_f + 1
    }
    var n44: [u8; 44] = "11 das Blatt fasst genau 64 Regeln          "
    report((&n44[0]) as u64, 44,
        sheet.sheet_count(&blatt_voll) == 64,
        sheet.sheet_count(&blatt_voll) as i64, 64)
    var n45: [u8; 44] = "11 und bis dahin laeuft nichts ueber        "
    report((&n45[0]) as u64, 44,
        sheet.sheet_rule_overflow(&blatt_voll) == 0,
        sheet.sheet_rule_overflow(&blatt_voll) as i64, 0)
    // Drei Regeln zu viel: drei Meldungen, und keine 65. Regel.
    sheet.sheet_add(&blatt_voll, sheet.sel_any(), d_f)
    sheet.sheet_add(&blatt_voll, sheet.sel_any(), d_f)
    let nr67: usize = sheet.sheet_add(&blatt_voll, sheet.sel_any(), d_f)
    var n46: [u8; 44] = "11 drei Regeln zu viel werden gemeldet      "
    report((&n46[0]) as u64, 44,
        sheet.sheet_rule_overflow(&blatt_voll) == 3,
        sheet.sheet_rule_overflow(&blatt_voll) as i64, 3)
    var n47: [u8; 44] = "11 der Rueckgabewert ist RULE_MAX           "
    report((&n47[0]) as u64, 44, nr67 == sheet.RULE_MAX, nr67 as i64,
        sheet.RULE_MAX as i64)
    var n48: [u8; 44] = "11 und das Blatt hat noch 64 Regeln         "
    report((&n48[0]) as u64, 44,
        sheet.sheet_count(&blatt_voll) == 64,
        sheet.sheet_count(&blatt_voll) as i64, 64)

    // Und dieselbe Rechnung an einer Auswahl. Vier Klassen passen, die
    // fuenfte und sechste nicht -- die Auswahl traegt danach vier
    // Klassen und die Zahl 2.
    var s_vier: sheet.Sel = sheet.sel_class(4001 as u32)
    s_vier = sheet.sel_with_class(s_vier, 4002 as u32)
    s_vier = sheet.sel_with_class(s_vier, 4003 as u32)
    s_vier = sheet.sel_with_class(s_vier, 4004 as u32)
    var n49: [u8; 44] = "11 vier Klassen passen in die Auswahl       "
    report((&n49[0]) as u64, 44,
        sheet.sel_class_overflow(&s_vier) == 0,
        sheet.sel_class_overflow(&s_vier) as i64, 0)
    var s_sechs: sheet.Sel = sheet.sel_with_class(s_vier, 4005 as u32)
    s_sechs = sheet.sel_with_class(s_sechs, 4006 as u32)
    var n50: [u8; 44] = "11 die fuenfte und sechste werden gemeldet  "
    report((&n50[0]) as u64, 44,
        sheet.sel_class_overflow(&s_sechs) == 2,
        sheet.sel_class_overflow(&s_sechs) as i64, 2)
    // DER RANG BLEIBT DER DER VIER KLASSEN -- 4 mal 100. Genau darum ist
    // die verschluckte Klasse gefaehrlich: die Auswahl sieht
    // spezifischer aus, als sie ist.
    var n51: [u8; 44] = "11 der Rang bleibt bei vier Klassen (400)   "
    report((&n51[0]) as u64, 44,
        sheet.sel_specificity(&s_sechs) == 400,
        sheet.sel_specificity(&s_sechs), 400)
    // Und die Gegenprobe, dass die urspruengliche Auswahl unberuehrt
    // bleibt: `Sel` ist ein WERT, der Zaehler wird mitkopiert und nicht
    // geteilt.
    var n52: [u8; 44] = "11 die Auswahl mit vier Klassen bleibt bei 0"
    report((&n52[0]) as u64, 44,
        sheet.sel_class_overflow(&s_vier) == 0,
        sheet.sel_class_overflow(&s_vier) as i64, 0)

    // ================================ 12. DIE REGEL AUS EINEM STIL
    //
    // `sheet_rule` ist die Kurzform von decl_new + decl_set_style +
    // sheet_add. Dass sie DASSELBE tut, wird nicht behauptet, sondern
    // gemessen: zwei Blaetter, links die Langform, rechts die
    // Kurzform, und beide Male dieselbe Farbe an derselben laufenden
    // Nummer.
    var bl_lang: sheet.Sheet = sheet.sheet_new()
    var bl_kurz: sheet.Sheet = sheet.sheet_new()
    var st_r: style.Style = style.style_new()
    st_r = style.style_set_bg(st_r, style.color_literal(3407871 as u32))
    var d_lang: sheet.Decl = sheet.decl_new()
    sheet.decl_set_style(&d_lang, st_r)
    let nr_lang: usize = sheet.sheet_add(&bl_lang, sheet.sel_kind(7 as u32),
        d_lang)
    let nr_kurz: usize = sheet.sheet_rule(&bl_kurz, sheet.sel_kind(7 as u32),
        st_r)
    var n60: [u8; 44] = "12 beide Regeln bekommen die Nummer 0       "
    report((&n60[0]) as u64, 43, nr_lang == 0 && nr_kurz == 0,
        nr_kurz as i64, 0)
    let bg_lang: u32 = (*sheet.decl_style(
        sheet.sheet_decl(&bl_lang, 0))).bg
    let bg_kurz: u32 = (*sheet.decl_style(
        sheet.sheet_decl(&bl_kurz, 0))).bg
    var n61: [u8; 44] = "12 und dieselbe Farbe steht darin           "
    report((&n61[0]) as u64, 43, bg_lang == bg_kurz, bg_kurz as i64,
        bg_lang as i64)
    var n62: [u8; 44] = "12 das Blatt zaehlt danach eine Regel       "
    report((&n62[0]) as u64, 43, sheet.sheet_count(&bl_kurz) == 1,
        sheet.sheet_count(&bl_kurz) as i64, 1)

    // =========================== 13. DIE GROESSE IST EIN STILWERT
    //
    // `width`/`height` gehen durch dieselbe Rangfolge wie jede Farbe:
    // eine Regel nach Klasse setzt die Hoehe, eine nach Kennung setzt
    // sie anders -- die Kennung (Rang 10000) gewinnt gegen die Klasse
    // (Rang 100). Und die beiden Werte stehen EINZELN: die zweite
    // Regel nennt nur die Hoehe, also bleibt die Breite der ersten
    // stehen, statt auf null zu fallen.
    var gr: sheet.Sheet = sheet.sheet_new()
    var g1: style.Style = style.style_new()
    g1 = style.style_set_size(g1, 220, 30)
    sheet.sheet_rule(&gr, sheet.sel_class(C_KNOPF), g1)
    var g2: style.Style = style.style_new()
    g2 = style.style_set_height(g2, 44)
    sheet.sheet_rule(&gr, sheet.sel_id(ID_OK), g2)
    var gchain: [sheet.NodeDesc; 2] = [sheet.desc_new(0 as u32, 0 as u32); 2]
    gchain[0] = sheet.desc_new(1005 as u32, ID_OK)
    sheet.desc_add_class(&gchain[0], C_KNOPF)
    var gd: sheet.Decl = sheet.decl_new()
    sheet.sheet_resolve(&gr, &gchain[0], 1, &gd)
    let gs: *mut style.Style = sheet.decl_style(&gd)
    var n70: [u8; 44] = "13 die Kennung setzt die Hoehe auf 44       "
    report((&n70[0]) as u64, 43, style.style_height(gs) == 44,
        style.style_height(gs) as i64, 44)
    var n71: [u8; 44] = "13 die Breite der Klassenregel bleibt 220   "
    report((&n71[0]) as u64, 43, style.style_width(gs) == 220,
        style.style_width(gs) as i64, 220)
    // Ein Knoten OHNE diese Klasse bekommt gar keine Groesse -- das
    // Bit steht nicht, und dann gilt "gemessen", nicht "0 Punkte".
    var gchain2: [sheet.NodeDesc; 2] = [sheet.desc_new(0 as u32, 0 as u32); 2]
    gchain2[0] = sheet.desc_new(1005 as u32, 0 as u32)
    var gd2: sheet.Decl = sheet.decl_new()
    sheet.sheet_resolve(&gr, &gchain2[0], 1, &gd2)
    var n72: [u8; 44] = "13 ohne Regel steht kein Groessenbit        "
    report((&n72[0]) as u64, 43,
        !style.style_has_height(sheet.decl_style(&gd2)),
        style.style_has_height(sheet.decl_style(&gd2)) as i64, 0)
    // UND SIE WIRD NICHT VERERBT. Ein Kind, das die Hoehe seines
    // Kastens erbte, waere immer so hoch wie sein Elternteil.
    var ge: sheet.Decl = sheet.decl_new()
    sheet.decl_inherit(&ge, &gd)
    var n73: [u8; 44] = "13 das Kind erbt die Hoehe NICHT            "
    report((&n73[0]) as u64, 43,
        !style.style_has_height(sheet.decl_style(&ge)),
        style.style_has_height(sheet.decl_style(&ge)) as i64, 0)
    // UND DER WEG ZURUECK. Ein Stil, der von einem anderen abgeleitet
    // wird, erbt auch dessen feste Hoehe -- style_unset gibt sie
    // wieder frei, und zwar NUR sie: die Breite bleibt stehen.
    let gefrei: style.Style = style.style_unset(g1, style.SF_HEIGHT)
    var gf: style.Style = gefrei
    var n75: [u8; 44] = "13 style_unset nimmt die Hoehe wieder weg   "
    report((&n75[0]) as u64, 43, !style.style_has_height(&gf),
        style.style_has_height(&gf) as i64, 0)
    var n76: [u8; 44] = "13 und laesst die Breite stehen (220)       "
    report((&n76[0]) as u64, 43,
        style.style_has_width(&gf) && style.style_width(&gf) == 220,
        style.style_width(&gf) as i64, 220)
    var n74: [u8; 44] = "13 SF_WIDTH steht nicht in INHERIT_MASK     "
    report((&n74[0]) as u64, 43,
        !sheet.sheet_inheritable(style.SF_WIDTH)
        && !sheet.sheet_inheritable(style.SF_HEIGHT),
        sheet.sheet_inheritable(style.SF_WIDTH) as i64, 0)

    var t: rt.Buf = rt.buf_new()
    rt.buf_push(&t, 10 as u8)
    if G_ERRORS > 0 {
        var f: [u8; 23] = "SHEET IS NOT IN ORDER.\n"
        rt.buf_push_bytes(&t, (&f[0]) as u64, 23)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
        return 1
    }
    var o: [u8; 14] = "SHEET PASSED.\n"
    rt.buf_push_bytes(&t, (&o[0]) as u64, 14)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 0
}
