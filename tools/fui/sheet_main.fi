// SPDX-License-Identifier: MPL-2.0
// tools/fui/sheet_main.fi -- THE PRECEDENCE IS RE-CALCULATED.
//
// A style sheet is worth only as much as the answer to the question "which of two
// contradicting rules applies". Whoever answers it with "the last one"
// has no style sheet, but a call list. That is why DELIBERATELY
// contradictory cases stand here, and every number is calculated by
// hand:
//
//   1. The ranks themselves: id 10000, class 100, state 100,
//      kind 1 -- and the parts of an ancestor count too.
//   2. Three rules set the same value: id beats class
//      beats kind.
//   3. A tie: two class rules, the later one wins.
//   4. A high-ranking rule that names ONLY the font colour does not delete
//      the background of a low-ranking one.
//   5. Inheritance: font colour/size/family/line height arrive
//      at the child, the background does NOT.
//   6. The stride of sheet.NodeDesc is MEASURED --
//      `chain_at` fetches it from sheet.sheet_desc_stride, and here it stands
//      against the real address difference of two chain members.
//   7. FOUR rules that all match the same node and all set the
//      same value, on a chain of depth 4
//      ("class in class in id"): two of them are tied,
//      and the ancestor with an id beats them all.
//      In addition the counter-test that a node is not its own
//      ancestor.
//   8. The state: the SAME selection at the SAME node, once at
//      rest and once under the pointer -- the numbers must flip
//      and flip back on resetting.
//   9. The limit of inheritance with one number for EACH non-
//      inheritable value: background, border, radius, padding, alignment,
//      alpha.
//  10. The bridges: that `transition` really arrives in an
//      anim.Transition and `transform` really pulls at the point.
//      Calculation is done in anim.fi and lib/svg/matrix.fi --
//      sheet.fi only passes through, and exactly that is measured here.
//  11. The two limits that would otherwise be silent: the 65th
//      rule pair and the fifth class of a selection. Both are
//      COUNTED (`sheet_rule_overflow`, `sel_class_overflow`), both
//      with a counter-test at the exactly full limit.
import std.rt
import fui.style
import fui.sheet
import fui.anim
import fui.transform

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    var w: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&w[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// Rounded to thousandths, SYMMETRICALLY around zero -- `as i64`
// truncates towards zero, and a check that fails on its own
// rounding helps nobody. The same version as in
// tools/fui/transform_main.fi, because the same points are measured
// there.
fn milli(x: f64) -> i64 {
    if x < 0.0 {
        return 0 - (((0.0 - x) * 1000.0 + 0.5) as i64)
    }
    return (x * 1000.0 + 0.5) as i64
}

// A background value as a colour, so that the cases can be told apart.
fn bg_decl(v: u32) -> sheet.Decl {
    var d: sheet.Decl = sheet.decl_new()
    sheet.decl_set_style(&d,
        style.style_set_bg(style.style_new(), style.color_literal(v)))
    return d
}

fn resolved_bg(sh: *mut sheet.Sheet, chain: *mut sheet.NodeDesc,
    depth: usize) -> i64 {
    var d: sheet.Decl = sheet.decl_new()
    sheet.sheet_resolve(sh, chain, depth, &d)
    return style.color_value((*sheet.decl_style(&d)).bg) as i64
}

fn main(start: u64) -> i32 {
    // =================================================== 1. DIE RAENGE
    var k1: [u8; 5] = "knopf"
    var k2: [u8; 4] = "kopf"
    let C_KNOPF: u32 = sheet.sheet_name((&k1[0]) as u64, 5)
    let C_HEADER: u32 = sheet.sheet_name((&k2[0]) as u64, 4)
    let ID_OK: u32 = sheet.sheet_name((&k2[0]) as u64, 4) + 7 as u32

    var s_art: sheet.Sel = sheet.sel_kind(1005 as u32)
    var s_cls: sheet.Sel = sheet.sel_class(C_KNOPF)
    var s_id: sheet.Sel = sheet.sel_id(ID_OK)
    var s_cs: sheet.Sel = sheet.sel_with_state(sheet.sel_class(C_KNOPF),
        style.STATE_HOVER)
    var s_in: sheet.Sel = sheet.sel_within_class(sheet.sel_class(C_KNOPF),
        C_HEADER)

    var n1: [u8; 20] = "1 Art zaehlt 1      "
    report((&n1[0]) as u64, 20, sheet.sel_specificity(&s_art) == 1,
        sheet.sel_specificity(&s_art), 1)
    var n2: [u8; 20] = "1 Klasse zaehlt 100 "
    report((&n2[0]) as u64, 20, sheet.sel_specificity(&s_cls) == 100,
        sheet.sel_specificity(&s_cls), 100)
    var n3: [u8; 24] = "1 Kennung zaehlt 10000  "
    report((&n3[0]) as u64, 24, sheet.sel_specificity(&s_id) == 10000,
        sheet.sel_specificity(&s_id), 10000)
    var n4: [u8; 26] = "1 Klasse+Zustand sind 200 "
    report((&n4[0]) as u64, 26, sheet.sel_specificity(&s_cs) == 200,
        sheet.sel_specificity(&s_cs), 200)
    var n5: [u8; 26] = "1 Klasse in Klasse ist 200"
    report((&n5[0]) as u64, 26, sheet.sel_specificity(&s_in) == 200,
        sheet.sel_specificity(&s_in), 200)

    // ============================== 2. THREE RULES, THE SAME VALUE
    //
    // They stand in the LEAST FAVOURABLE order: the id first,
    // the kind last. If the id wins nevertheless, the rank really decides
    // and not the order.
    var sh: sheet.Sheet = sheet.sheet_new()
    sheet.sheet_add(&sh, s_id, bg_decl(3 as u32))
    sheet.sheet_add(&sh, s_cls, bg_decl(2 as u32))
    sheet.sheet_add(&sh, s_art, bg_decl(1 as u32))

    var chain: [sheet.NodeDesc; 4] = [sheet.desc_new(0 as u32, 0 as u32); 4]
    chain[0] = sheet.desc_new(1001 as u32, 0 as u32)
    sheet.desc_add_class(&chain[0], C_HEADER)
    chain[1] = sheet.desc_new(1005 as u32, ID_OK)
    sheet.desc_add_class(&chain[1], C_KNOPF)

    let v: i64 = resolved_bg(&sh, &chain[0], 2)
    var n6: [u8; 30] = "2 Kennung schlaegt Klasse+Art "
    report((&n6[0]) as u64, 30, v == 3, v, 3)

    // The same without the id: now the class must win.
    var sh2: sheet.Sheet = sheet.sheet_new()
    sheet.sheet_add(&sh2, s_cls, bg_decl(2 as u32))
    sheet.sheet_add(&sh2, s_art, bg_decl(1 as u32))
    let v2: i64 = resolved_bg(&sh2, &chain[0], 2)
    var n7: [u8; 24] = "2 Klasse schlaegt Art   "
    report((&n7[0]) as u64, 24, v2 == 2, v2, 2)

    // ====================================== 3. GLEICHSTAND
    var sh3: sheet.Sheet = sheet.sheet_new()
    sheet.sheet_add(&sh3, s_cls, bg_decl(7 as u32))
    sheet.sheet_add(&sh3, sheet.sel_class(C_KNOPF), bg_decl(9 as u32))
    let v3: i64 = resolved_bg(&sh3, &chain[0], 2)
    var n8: [u8; 32] = "3 bei Gleichstand die spaetere  "
    report((&n8[0]) as u64, 32, v3 == 9, v3, 9)

    // ========================= 4. A HIGH-RANKING RULE DELETES NOTHING
    var d_fg: sheet.Decl = sheet.decl_new()
    sheet.decl_set_style(&d_fg, style.style_set_fg(style.style_new(),
            style.color_literal(42 as u32)))
    var sh4: sheet.Sheet = sheet.sheet_new()
    sheet.sheet_add(&sh4, s_cls, bg_decl(5 as u32))
    sheet.sheet_add(&sh4, s_id, d_fg)
    var d4: sheet.Decl = sheet.decl_new()
    sheet.sheet_resolve(&sh4, &chain[0], 2, &d4)
    let bg4: i64 = style.color_value((*sheet.decl_style(&d4)).bg) as i64
    let fg4: i64 = style.color_value((*sheet.decl_style(&d4)).fg) as i64
    var n9: [u8; 34] = "4 der Grund der Klasse bleibt     "
    report((&n9[0]) as u64, 34, bg4 == 5, bg4, 5)
    var n10: [u8; 34] = "4 die Schriftfarbe der Kennung    "
    report((&n10[0]) as u64, 34, fg4 == 42, fg4, 42)

    // ==================================== 5. THE INHERITANCE AND ITS END
    var parent: sheet.Decl = sheet.decl_new()
    var es: style.Style = style.style_new()
    es = style.style_set_fg(es, style.color_literal(11 as u32))
    es = style.style_set_bg(es, style.color_literal(22 as u32))
    es = style.style_set_font(es, 0, 19)
    sheet.decl_set_style(&parent, es)
    var kind: sheet.Decl = sheet.decl_new()
    sheet.decl_inherit(&kind, &parent)
    let kfg: i64 = style.color_value((*sheet.decl_style(&kind)).fg) as i64
    let kpx: i64 = (*sheet.decl_style(&kind)).font_px as i64
    let khat_bg: bool = sheet.decl_has(&kind, style.SF_BG, false)
    var n11: [u8; 32] = "5 Schriftfarbe wird vererbt     "
    report((&n11[0]) as u64, 32, kfg == 11, kfg, 11)
    var n12: [u8; 32] = "5 Schriftgroesse wird vererbt   "
    report((&n12[0]) as u64, 32, kpx == 19, kpx, 19)
    var n13: [u8; 32] = "5 der Grund wird NICHT vererbt  "
    report((&n13[0]) as u64, 32, !khat_bg, khat_bg as i64, 0)

    // And the child's own word beats the inheritance.
    var kind2: sheet.Decl = sheet.decl_new()
    sheet.decl_set_style(&kind2, style.style_set_fg(style.style_new(),
            style.color_literal(99 as u32)))
    sheet.decl_inherit(&kind2, &parent)
    let k2fg: i64 = style.color_value((*sheet.decl_style(&kind2)).fg) as i64
    var n14: [u8; 32] = "5 eigener Wert schlaegt das Erbe"
    report((&n14[0]) as u64, 32, k2fg == 99, k2fg, 99)

    let mask: i64 = sheet.INHERIT_MASK as i64
    // Since 23.09.2026 five: the writing direction has been added
    // (round Bidi). The number is still calculated from the bits and
    // not copied.
    let should: i64 = (style.SF_FG | style.SF_FONT_PX | style.SF_FONT_ID
        | style.SF_LINE_HEIGHT | style.SF_DIRECTION) as i64
    var n15: [u8; 32] = "5 die Erbmaske sind genau fuenf "
    report((&n15[0]) as u64, 32, mask == should, mask, should)

    // ============================= 6. THE STRIDE IS MEASURED
    //
    // `chain_at` calculates the address of the i-th chain member. The
    // number for that stands nowhere as a digit, but in
    // sheet.sheet_desc_stride -- and it is held here against the REAL
    // address difference of two neighbours of this chain. A 56 at
    // this place would be the same error once more: a second place
    // for a number that the compiler determines.
    let step: i64 = ((&chain[1]) as u64 - (&chain[0]) as u64) as i64
    var n16: [u8; 32] = "6 die Schrittweite stimmt       "
    report((&n16[0]) as u64, 32,
        sheet.sheet_desc_stride() as i64 == step,
        sheet.sheet_desc_stride() as i64, step)
    // And the counter-test that it is really used: the second
    // member, fetched via chain_at, is the same as &chain[1].
    let zweites: i64 = ((&chain[0]) as u64
        +(sheet.sheet_desc_stride()) as u64) as i64
    var n16b: [u8; 32] = "6 chain_at trifft Glied 1       "
    report((&n16b[0]) as u64, 32, zweites == ((&chain[1]) as u64) as i64,
        zweites, ((&chain[1]) as u64) as i64)

    // ========== 7. FOUR MATCHING RULES, CONTRADICTING PAIRWISE
    //
    // All four match the SAME node and ALL set the background --
    // so they cannot all apply. They are entered in the
    // least favourable order (the weakest first would be too
    // easy; here the strongest does NOT stand last), so that the
    // order does not happen to give the same as the rank:
    //
    //   A  kind 1005                            rank     1   -> 10
    //   B  class `knopf`                        rank   100   -> 20
    //   C  class `knopf` AND `gross`            rank   200   -> 30
    //   D  class `gross` within `liste`         rank   200   -> 40
    //
    // C and D are tied; D is written later, so
    // D wins. By hand: 40.
    var k3: [u8; 5] = "gross"
    var k4: [u8; 5] = "liste"
    var k5: [u8; 5] = "seite"
    let C_BIG: u32 = sheet.sheet_name((&k3[0]) as u64, 5)
    let C_LIST: u32 = sheet.sheet_name((&k4[0]) as u64, 5)
    let ID_PAGE: u32 = sheet.sheet_name((&k5[0]) as u64, 5)

    // THE CHAIN OF DEPTH 4. Root first, the button last:
    // page (id) > list (class) > row > button.
    var chain_list: [sheet.NodeDesc; 4] = [sheet.desc_new(0 as u32, 0 as u32); 4]
    chain_list[0] = sheet.desc_new(1001 as u32, ID_PAGE)
    sheet.desc_add_class(&chain_list[0], C_HEADER)
    chain_list[1] = sheet.desc_new(1002 as u32, 0 as u32)
    sheet.desc_add_class(&chain_list[1], C_LIST)
    chain_list[2] = sheet.desc_new(1003 as u32, 0 as u32)
    chain_list[3] = sheet.desc_new(1005 as u32, ID_OK)
    sheet.desc_add_class(&chain_list[3], C_KNOPF)
    sheet.desc_add_class(&chain_list[3], C_BIG)

    var r_a: sheet.Sel = sheet.sel_kind(1005 as u32)
    var r_b: sheet.Sel = sheet.sel_class(C_KNOPF)
    var r_c: sheet.Sel = sheet.sel_with_class(sheet.sel_class(C_KNOPF),
        C_BIG)
    var r_d: sheet.Sel = sheet.sel_within_class(sheet.sel_class(C_BIG),
        C_LIST)
    var r_e: sheet.Sel = sheet.sel_within_id(sheet.sel_class(C_KNOPF),
        ID_PAGE)

    var n17: [u8; 34] = "7 zwei Klassen zaehlen 200        "
    report((&n17[0]) as u64, 34, sheet.sel_specificity(&r_c) == 200,
        sheet.sel_specificity(&r_c), 200)
    var n18: [u8; 34] = "7 Klasse in Kennung zaehlt 10100  "
    report((&n18[0]) as u64, 34, sheet.sel_specificity(&r_e) == 10100,
        sheet.sel_specificity(&r_e), 10100)

    var sh7: sheet.Sheet = sheet.sheet_new()
    sheet.sheet_add(&sh7, r_c, bg_decl(30 as u32))
    sheet.sheet_add(&sh7, r_a, bg_decl(10 as u32))
    sheet.sheet_add(&sh7, r_d, bg_decl(40 as u32))
    sheet.sheet_add(&sh7, r_b, bg_decl(20 as u32))
    let v7: i64 = resolved_bg(&sh7, &chain_list[0], 4)
    var n19: [u8; 34] = "7 von vier Regeln gewinnt D       "
    report((&n19[0]) as u64, 34, v7 == 40, v7, 40)

    // And the fifth, which goes via the ID of an ancestor,
    // beats them all: 100 + 10000 = 10100 against at most 200.
    sheet.sheet_add(&sh7, r_e, bg_decl(50 as u32))
    let v8: i64 = resolved_bg(&sh7, &chain_list[0], 4)
    var n20: [u8; 34] = "7 der Vorfahr mit Kennung schlaegt"
    report((&n20[0]) as u64, 34, v8 == 50, v8, 50)

    // THE ANCESTOR IS A REAL ANCESTOR. `gross` sits at the node
    // ITSELF; a selection "knopf within gross" must therefore NOT
    // match -- otherwise every node would be its own ancestor. What remains
    // is only the kind rule with 10.
    var sh8: sheet.Sheet = sheet.sheet_new()
    sheet.sheet_add(&sh8, r_a, bg_decl(10 as u32))
    sheet.sheet_add(&sh8, sheet.sel_within_class(sheet.sel_class(C_KNOPF),
            C_BIG), bg_decl(60 as u32))
    let v9: i64 = resolved_bg(&sh8, &chain_list[0], 4)
    var n21: [u8; 35] = "7 der Knoten ist nicht sein Vorfahr"
    report((&n21[0]) as u64, 35, v9 == 10, v9, 10)

    // ========================== 8. THE SAME NODE, HOVERED ONCE
    //
    // Two rules on the same node: one without a state (rank
    // 100), the other with STATE_HOVER (rank 200). At rest the
    // second cannot match at all -- 55. As soon as the pointer stands on it,
    // it matches AND has the higher rank -- 77. The numbers flip
    // without anything on the sheet having been changed.
    var sh9: sheet.Sheet = sheet.sheet_new()
    sheet.sheet_add(&sh9, sheet.sel_class(C_KNOPF), bg_decl(55 as u32))
    sheet.sheet_add(&sh9, sheet.sel_with_state(sheet.sel_class(C_KNOPF),
            style.STATE_HOVER), bg_decl(77 as u32))
    let v_ruhe: i64 = resolved_bg(&sh9, &chain_list[0], 4)
    var n22: [u8; 34] = "8 im Stand gilt die Klassenregel  "
    report((&n22[0]) as u64, 34, v_ruhe == 55, v_ruhe, 55)
    sheet.desc_set_state(&chain_list[3], style.STATE_HOVER)
    let v_hover: i64 = resolved_bg(&sh9, &chain_list[0], 4)
    var n23: [u8; 34] = "8 unter dem Zeiger kippt es       "
    report((&n23[0]) as u64, 34, v_hover == 77, v_hover, 77)
    sheet.desc_set_state(&chain_list[3], style.STATE_NORMAL)
    let v_back: i64 = resolved_bg(&sh9, &chain_list[0], 4)
    var n24: [u8; 34] = "8 und zurueck ist es wieder 55    "
    report((&n24[0]) as u64, 34, v_back == 55, v_back, 55)

    // ====================== 9. THE LIMIT OF INHERITANCE, VALUE BY VALUE
    //
    // The parent sets SIX non-inheritable values, each with
    // its own recognisable number. At the child EVERY one of
    // them must stay at the default -- an inherited background paints
    // every box once more, an inherited border would sit around
    // every child, an inherited padding would add up with every
    // level.
    var e2: style.Style = style.style_new()
    e2 = style.style_set_bg(e2, style.color_literal(22 as u32))
    e2 = style.style_set_border(e2, style.color_literal(33 as u32), 5)
    e2 = style.style_set_radius(e2, 9)
    e2 = style.style_set_pad(e2, 13, 14)
    e2 = style.style_set_align(e2, style.ALIGN_RIGHT)
    e2 = style.style_set_alpha(e2, 128)
    // And ONE inheritable value beside them, so that the check is not green
    // because nothing arrives at all.
    e2 = style.style_set_font(e2, 0, 17)
    var parents2: sheet.Decl = sheet.decl_new()
    sheet.decl_set_style(&parents2, e2)
    var kind3: sheet.Decl = sheet.decl_new()
    sheet.decl_inherit(&kind3, &parents2)
    let ks: *mut style.Style = sheet.decl_style(&kind3)

    let g_bg: i64 = style.color_value((*ks).bg) as i64
    var n25: [u8; 34] = "9 Grund bleibt beim Kind leer     "
    report((&n25[0]) as u64, 34, g_bg == 0, g_bg, 0)
    let g_bor: i64 = (*ks).border_w as i64
    var n26: [u8; 34] = "9 Rahmen bleibt 0 (Elternteil 5)  "
    report((&n26[0]) as u64, 34, g_bor == 0, g_bor, 0)
    let g_rad: i64 = (*ks).radius as i64
    var n27: [u8; 34] = "9 Radius bleibt 0 (Elternteil 9)  "
    report((&n27[0]) as u64, 34, g_rad == 0, g_rad, 0)
    let g_pad: i64 = ((*ks).pad_x + (*ks).pad_y) as i64
    var n28: [u8; 34] = "9 Polster bleibt 0 (Eltern 13+14) "
    report((&n28[0]) as u64, 34, g_pad == 0, g_pad, 0)
    let g_al: i64 = (*ks).align as i64
    var n29: [u8; 34] = "9 Ausrichtung bleibt links (0)    "
    report((&n29[0]) as u64, 34, g_al == 0, g_al, 0)
    let g_alpha: i64 = (*ks).alpha as i64
    var n30: [u8; 34] = "9 Alpha bleibt 255 (Elternteil 128"
    report((&n30[0]) as u64, 34, g_alpha == 255, g_alpha, 255)
    // Die Gegenprobe: die Schriftgroesse IST angekommen.
    let g_px: i64 = (*ks).font_px as i64
    var n31: [u8; 34] = "9 die Schriftgroesse kommt aber an"
    report((&n31[0]) as u64, 34, g_px == 17, g_px, 17)
    // And not a single one of the six bits stands in the mask of the child.
    let forbidden: u32 = style.SF_BG | style.SF_BORDER | style.SF_BORDER_W
    | style.SF_RADIUS | style.SF_PAD_X | style.SF_PAD_Y
    | style.SF_ALIGN | style.SF_ALPHA
    let g_mask: i64 = ((*ks).set_mask & forbidden) as i64
    var n32: [u8; 34] = "9 kein verbotenes Bit in der Maske"
    report((&n32[0]) as u64, 34, g_mask == 0, g_mask, 0)

    // ================== 10. THE BRIDGES: THE VALUE BECOMES AN EFFECT
    //
    // A `transition` in the sheet that nobody picks up is a
    // claim. Here it is measured that the duration really arrives in an
    // anim.Transition and the transformation really pulls at the point.
    // Calculation is done in anim.fi and in lib/svg/matrix.fi;
    // sheet.fi only passes through.
    var d_tr: sheet.Decl = sheet.decl_new()
    sheet.decl_set_transition(&d_tr, 250, anim.EASE_IN_OUT)
    var tr: anim.Transition = anim.trans_new(0 as u32, 0.0, 0.0, 1.0)
    let hat: bool = sheet.decl_apply_transition(&d_tr, &tr)
    let duration: i64 = anim.trans_duration(&tr)
    var n33: [u8; 34] = "10 die Dauer kommt bei anim an    "
    report((&n33[0]) as u64, 34, hat && duration == 250, duration, 250)
    var kurve: anim.Easing = sheet.decl_easing(&d_tr)
    var n34: [u8; 34] = "10 die Kurve ist ease-in-out (3)  "
    report((&n34[0]) as u64, 34, kurve.kind == anim.EASE_IN_OUT,
        kurve.kind as i64, anim.EASE_IN_OUT as i64)

    // A Decl WITHOUT `transition` does not touch the transition: the 120
    // are the default from anim.trans_new, and it must stay standing.
    var d_empty: sheet.Decl = sheet.decl_new()
    var tr2: anim.Transition = anim.trans_new(0 as u32, 0.0, 0.0, 1.0)
    let hat2: bool = sheet.decl_apply_transition(&d_empty, &tr2)
    let duration2: i64 = anim.trans_duration(&tr2)
    var n35: [u8; 34] = "10 ohne Angabe bleibt die Vorgabe "
    report((&n35[0]) as u64, 34, !hat2 && duration2 == 120, duration2, 120)
    var kurve2: anim.Easing = sheet.decl_easing(&d_empty)
    var n36: [u8; 34] = "10 und die Kurve ist linear (0)   "
    report((&n36[0]) as u64, 34, kurve2.kind == anim.EASE_LINEAR,
        kurve2.kind as i64, anim.EASE_LINEAR as i64)

    // The translation: the origin lands at (10, 5).
    var d_v: sheet.Decl = sheet.decl_new()
    sheet.decl_set_translate(&d_v, 10.0, 5.0)
    var xf: transform.Xform = transform.xf_new()
    sheet.decl_apply_transform(&d_v, &xf)
    let vx: i64 = milli(transform.xf_point_x(&xf, 0.0, 0.0))
    let vy: i64 = milli(transform.xf_point_y(&xf, 0.0, 0.0))
    var n37: [u8; 34] = "10 verschoben: x = 10 (in Milli)  "
    report((&n37[0]) as u64, 34, vx == 10000, vx, 10000)
    var n38: [u8; 34] = "10 verschoben: y = 5 (in Milli)   "
    report((&n38[0]) as u64, 34, vy == 5000, vy, 5000)

    // The scaling about the origin: (4, 6) becomes (8, 18).
    var d_s: sheet.Decl = sheet.decl_new()
    sheet.decl_set_scale(&d_s, 2.0, 3.0)
    var xf2: transform.Xform = transform.xf_new()
    sheet.decl_apply_transform(&d_s, &xf2)
    let sx2: i64 = milli(transform.xf_point_x(&xf2, 4.0, 6.0))
    let sy2: i64 = milli(transform.xf_point_y(&xf2, 4.0, 6.0))
    var n39: [u8; 34] = "10 gestreckt: 4 mal 2 sind 8      "
    report((&n39[0]) as u64, 34, sx2 == 8000, sx2, 8000)
    var n40: [u8; 34] = "10 gestreckt: 6 mal 3 sind 18     "
    report((&n40[0]) as u64, 34, sy2 == 18000, sy2, 18000)

    // The rotation IN DEGREES, about the centre of a box of 20 by 20:
    // the upper left point (0, 0) falls at 90 degrees onto (20, 0).
    var d_r: sheet.Decl = sheet.decl_new()
    sheet.decl_set_rotate(&d_r, 90.0)
    var xf3: transform.Xform = transform.xf_new()
    sheet.decl_apply_transform_at(&d_r, &xf3, 10.0, 10.0)
    let rx: i64 = milli(transform.xf_point_x(&xf3, 0.0, 0.0))
    let ry: i64 = milli(transform.xf_point_y(&xf3, 0.0, 0.0))
    var n41: [u8; 34] = "10 gedreht um 90 Grad: x wird 20  "
    report((&n41[0]) as u64, 34, rx == 20000, rx, 20000)
    var n42: [u8; 34] = "10 gedreht um 90 Grad: y wird 0   "
    report((&n42[0]) as u64, 34, ry == 0, ry, 0)

    // A Decl without a transformation leaves the stack alone: the point
    // (7, 7) stays (7, 7), and the bridge says so too.
    var xf4: transform.Xform = transform.xf_new()
    let hat3: bool = sheet.decl_apply_transform(&d_empty, &xf4)
    let nx: i64 = milli(transform.xf_point_x(&xf4, 7.0, 7.0))
    var n43: [u8; 34] = "10 ohne Umformung bleibt 7 bei 7  "
    report((&n43[0]) as u64, 34, !hat3 && nx == 7000, nx, 7000)

    // ================== 11. THE TWO LIMITS THAT WERE OTHERWISE SILENT
    //
    // A sheet holds RULE_MAX = 64 rules, a selection
    // SEL_CLASS_MAX = 4 classes. Both are fixed arrays -- and until
    // 21.09.2026 both silently swallowed what no longer fitted in.
    // A missing rule leaves part of the surface unpainted;
    // a missing class makes the selection WIDER than it is
    // written, and thereby hits nodes that nobody meant. So
    // both count, and here the numbers stand -- including a counter-test that
    // the counter does not report every call.
    var leaf_full: sheet.Sheet = sheet.sheet_new()
    var d_f: sheet.Decl = sheet.decl_new()
    var i_f: usize = 0
    while i_f < sheet.RULE_MAX {
        sheet.sheet_add(&leaf_full, sheet.sel_kind(i_f as u32), d_f)
        i_f = i_f + 1
    }
    var n44: [u8; 44] = "11 das Blatt fasst genau 64 Regeln          "
    report((&n44[0]) as u64, 44,
        sheet.sheet_count(&leaf_full) == 64,
        sheet.sheet_count(&leaf_full) as i64, 64)
    var n45: [u8; 44] = "11 und bis dahin laeuft nichts ueber        "
    report((&n45[0]) as u64, 44,
        sheet.sheet_rule_overflow(&leaf_full) == 0,
        sheet.sheet_rule_overflow(&leaf_full) as i64, 0)
    // Three rules too many: three reports, and no 65th rule.
    sheet.sheet_add(&leaf_full, sheet.sel_any(), d_f)
    sheet.sheet_add(&leaf_full, sheet.sel_any(), d_f)
    let nr67: usize = sheet.sheet_add(&leaf_full, sheet.sel_any(), d_f)
    var n46: [u8; 44] = "11 drei Regeln zu viel werden gemeldet      "
    report((&n46[0]) as u64, 44,
        sheet.sheet_rule_overflow(&leaf_full) == 3,
        sheet.sheet_rule_overflow(&leaf_full) as i64, 3)
    var n47: [u8; 44] = "11 der Rueckgabewert ist RULE_MAX           "
    report((&n47[0]) as u64, 44, nr67 == sheet.RULE_MAX, nr67 as i64,
        sheet.RULE_MAX as i64)
    var n48: [u8; 44] = "11 und das Blatt hat noch 64 Regeln         "
    report((&n48[0]) as u64, 44,
        sheet.sheet_count(&leaf_full) == 64,
        sheet.sheet_count(&leaf_full) as i64, 64)

    // And the same calculation on a selection. Four classes fit, the
    // fifth and sixth do not -- the selection afterwards carries four
    // classes and the number 2.
    var s_four: sheet.Sel = sheet.sel_class(4001 as u32)
    s_four = sheet.sel_with_class(s_four, 4002 as u32)
    s_four = sheet.sel_with_class(s_four, 4003 as u32)
    s_four = sheet.sel_with_class(s_four, 4004 as u32)
    var n49: [u8; 44] = "11 vier Klassen passen in die Auswahl       "
    report((&n49[0]) as u64, 44,
        sheet.sel_class_overflow(&s_four) == 0,
        sheet.sel_class_overflow(&s_four) as i64, 0)
    var s_six: sheet.Sel = sheet.sel_with_class(s_four, 4005 as u32)
    s_six = sheet.sel_with_class(s_six, 4006 as u32)
    var n50: [u8; 44] = "11 die fuenfte und sechste werden gemeldet  "
    report((&n50[0]) as u64, 44,
        sheet.sel_class_overflow(&s_six) == 2,
        sheet.sel_class_overflow(&s_six) as i64, 2)
    // THE RANK STAYS THAT OF THE FOUR CLASSES -- 4 times 100. Exactly because of that
    // the swallowed class is dangerous: the selection looks
    // more specific than it is.
    var n51: [u8; 44] = "11 der Rang bleibt bei vier Klassen (400)   "
    report((&n51[0]) as u64, 44,
        sheet.sel_specificity(&s_six) == 400,
        sheet.sel_specificity(&s_six), 400)
    // And the counter-test that the original selection stays
    // untouched: `Sel` is a VALUE, the counter is copied along and not
    // shared.
    var n52: [u8; 44] = "11 die Auswahl mit vier Klassen bleibt bei 0"
    report((&n52[0]) as u64, 44,
        sheet.sel_class_overflow(&s_four) == 0,
        sheet.sel_class_overflow(&s_four) as i64, 0)

    // ================================ 12. THE RULE FROM A STYLE
    //
    // `sheet_rule` is the short form of decl_new + decl_set_style +
    // sheet_add. That it does THE SAME is not claimed, but
    // measured: two sheets, on the left the long form, on the right the
    // short form, and both times the same colour at the same running
    // number.
    var bl_long: sheet.Sheet = sheet.sheet_new()
    var bl_short: sheet.Sheet = sheet.sheet_new()
    var st_r: style.Style = style.style_new()
    st_r = style.style_set_bg(st_r, style.color_literal(3407871 as u32))
    var d_long: sheet.Decl = sheet.decl_new()
    sheet.decl_set_style(&d_long, st_r)
    let nr_long: usize = sheet.sheet_add(&bl_long, sheet.sel_kind(7 as u32),
        d_long)
    let nr_short: usize = sheet.sheet_rule(&bl_short, sheet.sel_kind(7 as u32),
        st_r)
    var n60: [u8; 44] = "12 beide Regeln bekommen die Nummer 0       "
    report((&n60[0]) as u64, 43, nr_long == 0 && nr_short == 0,
        nr_short as i64, 0)
    let bg_long: u32 = (*sheet.decl_style(
            sheet.sheet_decl(&bl_long, 0))).bg
    let bg_short: u32 = (*sheet.decl_style(
            sheet.sheet_decl(&bl_short, 0))).bg
    var n61: [u8; 44] = "12 und dieselbe Farbe steht darin           "
    report((&n61[0]) as u64, 43, bg_long == bg_short, bg_short as i64,
        bg_long as i64)
    var n62: [u8; 44] = "12 das Blatt zaehlt danach eine Regel       "
    report((&n62[0]) as u64, 43, sheet.sheet_count(&bl_short) == 1,
        sheet.sheet_count(&bl_short) as i64, 1)

    // =========================== 13. THE SIZE IS A STYLE VALUE
    //
    // `width`/`height` go through the same precedence as every colour:
    // a rule by class sets the height, one by id sets
    // it differently -- the id (rank 10000) wins against the class
    // (rank 100). And the two values stand INDIVIDUALLY: the second
    // rule names only the height, so the width of the first
    // stays standing instead of falling to zero.
    var gr: sheet.Sheet = sheet.sheet_new()
    var g1: style.Style = style.style_new()
    g1 = style.style_set_size(g1, 220, 30)
    sheet.sheet_rule(&gr, sheet.sel_class(C_KNOPF), g1)
    var g2: style.Style = style.style_new()
    g2 = style.style_set_height(g2, 44)
    sheet.sheet_rule(&gr, sheet.sel_id(ID_OK), g2)
    var gchain: [sheet.NodeDesc; 2] = [sheet.desc_new(0 as u32, 0 as u32); 2]
    gchain[0] = sheet.desc_new(1005 as u32, ID_OK)
    sheet.desc_add_class(&gchain[0], C_KNOPF)
    var gd: sheet.Decl = sheet.decl_new()
    sheet.sheet_resolve(&gr, &gchain[0], 1, &gd)
    let gs: *mut style.Style = sheet.decl_style(&gd)
    var n70: [u8; 44] = "13 die Kennung setzt die Hoehe auf 44       "
    report((&n70[0]) as u64, 43, style.style_height(gs) == 44,
        style.style_height(gs) as i64, 44)
    var n71: [u8; 44] = "13 die Breite der Klassenregel bleibt 220   "
    report((&n71[0]) as u64, 43, style.style_width(gs) == 220,
        style.style_width(gs) as i64, 220)
    // A node WITHOUT this class gets no size at all -- the
    // bit does not stand, and then "measured" applies, not "0 points".
    var gchain2: [sheet.NodeDesc; 2] = [sheet.desc_new(0 as u32, 0 as u32); 2]
    gchain2[0] = sheet.desc_new(1005 as u32, 0 as u32)
    var gd2: sheet.Decl = sheet.decl_new()
    sheet.sheet_resolve(&gr, &gchain2[0], 1, &gd2)
    var n72: [u8; 44] = "13 ohne Regel steht kein Groessenbit        "
    report((&n72[0]) as u64, 43,
        !style.style_has_height(sheet.decl_style(&gd2)),
        style.style_has_height(sheet.decl_style(&gd2)) as i64, 0)
    // AND IT IS NOT INHERITED. A child that inherited the height of its
    // box would always be as high as its parent.
    var ge: sheet.Decl = sheet.decl_new()
    sheet.decl_inherit(&ge, &gd)
    var n73: [u8; 44] = "13 das Kind erbt die Hoehe NICHT            "
    report((&n73[0]) as u64, 43,
        !style.style_has_height(sheet.decl_style(&ge)),
        style.style_has_height(sheet.decl_style(&ge)) as i64, 0)
    // AND THE WAY BACK. A style that is derived from another
    // also inherits its fixed height -- style_unset releases it
    // again, and ONLY it: the width stays standing.
    let gefrei: style.Style = style.style_unset(g1, style.SF_HEIGHT)
    var gf: style.Style = gefrei
    var n75: [u8; 44] = "13 style_unset nimmt die Hoehe wieder weg   "
    report((&n75[0]) as u64, 43, !style.style_has_height(&gf),
        style.style_has_height(&gf) as i64, 0)
    var n76: [u8; 44] = "13 und laesst die Breite stehen (220)       "
    report((&n76[0]) as u64, 43,
        style.style_has_width(&gf) && style.style_width(&gf) == 220,
        style.style_width(&gf) as i64, 220)
    var n74: [u8; 44] = "13 SF_WIDTH steht nicht in INHERIT_MASK     "
    report((&n74[0]) as u64, 43,
        !sheet.sheet_inheritable(style.SF_WIDTH)
        && !sheet.sheet_inheritable(style.SF_HEIGHT),
        sheet.sheet_inheritable(style.SF_WIDTH) as i64, 0)

    // ============================ 14. THE WRITING DIRECTION (round Bidi)
    //
    // `direction` is an ordinary style value like the size from
    // section 13 -- with the one difference that it is INHERITED:
    // a dialog set to RTL switches its children along with it.
    var dn: style.Style = style.style_new()
    var n80: [u8; 44] = "14 ohne Angabe gilt DIR_AUTO (0)            "
    report((&n80[0]) as u64, 43, style.style_direction(&dn) == style.DIR_AUTO,
        style.style_direction(&dn) as i64, style.DIR_AUTO as i64)
    var de: sheet.Decl = sheet.decl_new()
    sheet.decl_set_style(&de, style.style_set_direction(style.style_new(),
            style.DIR_RTL))
    var dk: sheet.Decl = sheet.decl_new()
    sheet.decl_inherit(&dk, &de)
    let dkd: u32 = style.style_direction(sheet.decl_style(&dk))
    var n81: [u8; 44] = "14 das Kind erbt RTL (2)                    "
    report((&n81[0]) as u64, 43, dkd == style.DIR_RTL, dkd as i64,
        style.DIR_RTL as i64)
    var dk2: sheet.Decl = sheet.decl_new()
    sheet.decl_set_style(&dk2, style.style_set_direction(style.style_new(),
            style.DIR_LTR))
    sheet.decl_inherit(&dk2, &de)
    let dk2d: u32 = style.style_direction(sheet.decl_style(&dk2))
    var n82: [u8; 44] = "14 eigenes LTR (1) schlaegt das Erbe        "
    report((&n82[0]) as u64, 43, dk2d == style.DIR_LTR, dk2d as i64,
        style.DIR_LTR as i64)
    // Merging: the higher-ranking rule names ONLY the direction and
    // does not delete the background of the other.
    var dm: sheet.Decl = sheet.decl_new()
    sheet.decl_set_style(&dm, style.style_set_bg(style.style_new(),
            style.color_literal(33 as u32)))
    sheet.decl_merge(&dm, &de)
    let dmd: u32 = style.style_direction(sheet.decl_style(&dm))
    let dmbg: i64 = style.color_value((*sheet.decl_style(&dm)).bg) as i64
    var n83: [u8; 44] = "14 decl_merge uebernimmt RTL (2)            "
    report((&n83[0]) as u64, 43, dmd == style.DIR_RTL, dmd as i64,
        style.DIR_RTL as i64)
    var n84: [u8; 44] = "14 und laesst den Grund 33 stehen           "
    report((&n84[0]) as u64, 43, dmbg == 33, dmbg, 33)
    var n85: [u8; 44] = "14 SF_DIRECTION steht in INHERIT_MASK       "
    report((&n85[0]) as u64, 43, sheet.sheet_inheritable(style.SF_DIRECTION),
        sheet.sheet_inheritable(style.SF_DIRECTION) as i64, 1)

    var t: rt.Buf = rt.buf_new()
    rt.buf_push(&t, 10 as u8)
    if G_ERRORS > 0 {
        var f: [u8; 23] = "SHEET IS NOT IN ORDER.\n"
        rt.buf_push_bytes(&t, (&f[0]) as u64, 23)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
        return 1
    }
    var o: [u8; 14] = "SHEET PASSED.\n"
    rt.buf_push_bytes(&t, (&o[0]) as u64, 14)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 0
}
