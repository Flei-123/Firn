// SPDX-License-Identifier: MPL-2.0
// tools/fui/grid_main.fi -- THE GRID TRACK SOLVER IS RE-CALCULATED (lib/fui/grid.fi).
//
// Every claim is a pixel value worked out BY HAND (see the comment above
// each block), no "looks plausible". Pure: no window. Exit 1 on any WRONG.
import std.rt
import fui.grid
import fui.flex
import fui.layout

static mut BAD: usize = 0
static mut N: usize = 0

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }

fn check(ok: bool, what: str) {
    N = N + 1
    if ok { say("  ok    ") } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

// one rectangle must be exactly (x, y, w, h)
fn want(out: *mut layout.Rect, i: usize, x: i64, y: i64, w: i64, h: i64,
    what: str) {
    let r: *mut layout.Rect = (out as u64 + (i * 32) as u64) as *mut layout.Rect
    let ok: bool = layout.rect_x(r) == x && layout.rect_y(r) == y &&
    layout.rect_w(r) == w && layout.rect_h(r) == h
    check(ok, what)
    if !ok {
        var t: rt.Buf = rt.buf_new()
        rt.buf_push_dec_i64(&t, layout.rect_x(r))
        rt.buf_push(&t, 32 as u8)
        rt.buf_push_dec_i64(&t, layout.rect_y(r))
        rt.buf_push(&t, 32 as u8)
        rt.buf_push_dec_i64(&t, layout.rect_w(r))
        rt.buf_push(&t, 32 as u8)
        rt.buf_push_dec_i64(&t, layout.rect_h(r))
        rt.buf_push(&t, 10 as u8)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
    }
}

fn cellat(out: *mut layout.Rect, i: usize) -> *mut layout.Rect {
    return (out as u64 + (i * 32) as u64) as *mut layout.Rect
}

fn main() -> i32 {
    var out: [layout.Rect; 16] = [layout.rect_new(0, 0, 0, 0); 16]
    var it: [grid.GridItem; 16] = [grid.grid_item(10, 10); 16]
    let po: *mut layout.Rect = (&out[0]) as *mut layout.Rect
    let pi: *mut grid.GridItem = (&it[0]) as *mut grid.GridItem

    // ---- 1. px columns + gap; the single auto row stretches over 100.
    //   x: 0 | 100 + 10 = 110; widths 100, 200; the row takes all 100.
    var g1: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g1, grid.tk_px(100))
    grid.gs_add_col(&g1, grid.tk_px(200))
    grid.gs_set_gap(&g1, 10, 0)
    grid.grid_layout(&g1, layout.rect_new(0, 0, 400, 100), pi, 2, po)
    want(po, 0, 0, 0, 100, 100, "1 px col 0 stretches over the single row")
    want(po, 1, 110, 0, 200, 100, "1 px col 1 after width + gap")

    // ---- 2. 100px | 1fr | 2fr in 400: rest 300 -> 100 and 200.
    var g2: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g2, grid.tk_px(100))
    grid.gs_add_col(&g2, grid.tk_fr(1000))
    grid.gs_add_col(&g2, grid.tk_fr(2000))
    grid.grid_layout(&g2, layout.rect_new(0, 0, 400, 50), pi, 3, po)
    want(po, 0, 0, 0, 100, 50, "2 fixed track keeps 100")
    want(po, 1, 100, 0, 100, 50, "2 1fr of the rest 300 = 100")
    want(po, 2, 200, 0, 200, 50, "2 2fr of the rest 300 = 200")

    // ---- 3. 3 x 1fr in 100: 33 each, the remainder 1 goes to the FIRST.
    var g3: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g3, grid.tk_fr(1000))
    grid.gs_add_col(&g3, grid.tk_fr(1000))
    grid.gs_add_col(&g3, grid.tk_fr(1000))
    grid.grid_layout(&g3, layout.rect_new(0, 0, 100, 20), pi, 3, po)
    want(po, 0, 0, 0, 34, 20, "3 first fr gets the remainder pixel")
    want(po, 1, 34, 0, 33, 20, "3 second 33")
    want(po, 2, 67, 0, 33, 20, "3 third 33; the sum is exactly 100")

    // ---- 4. minmax(150px, 1fr) | 1fr in 200: hypothetical 100 < 150, so
    // the first track is taken OUT (150) and the second gets 200-150 = 50.
    var g4: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g4, grid.tk_minfr(150, 1000))
    grid.gs_add_col(&g4, grid.tk_fr(1000))
    grid.grid_layout(&g4, layout.rect_new(0, 0, 200, 20), pi, 2, po)
    want(po, 0, 0, 0, 150, 20, "4 minmax(150, 1fr) keeps its minimum")
    want(po, 1, 150, 0, 50, 20, "4 the other fr gets what is left (redistribution)")

    // ---- 5. auto | auto, items 40 and 70 wide, container 300.
    // Stretch: free 300-110 = 190, 95 each: 135 and 165.
    var g5: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g5, grid.tk_auto())
    grid.gs_add_col(&g5, grid.tk_auto())
    it[0] = grid.grid_item(40, 10)
    it[1] = grid.grid_item(70, 10)
    grid.grid_layout(&g5, layout.rect_new(0, 0, 300, 10), pi, 2, po)
    want(po, 1, 135, 0, 165, 10, "5 auto tracks share the free space equally")
    // with justify start the tracks stay at their content size
    grid.gs_set_content(&g5, grid.GC_START, grid.GC_STRETCH)
    grid.grid_layout(&g5, layout.rect_new(0, 0, 300, 10), pi, 2, po)
    want(po, 0, 0, 0, 40, 10, "5b justify start: track 0 = 40")
    want(po, 1, 40, 0, 70, 10, "5b justify start: track 1 = 70")

    // ---- 6. auto | 1fr: auto = its item (50), fr = 300 - 50 = 250.
    var g6: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g6, grid.tk_auto())
    grid.gs_add_col(&g6, grid.tk_fr(1000))
    it[0] = grid.grid_item(50, 10)
    it[1] = grid.grid_item(10, 10)
    grid.grid_layout(&g6, layout.rect_new(0, 0, 300, 10), pi, 2, po)
    want(po, 0, 0, 0, 50, 10, "6 auto next to fr = content")
    want(po, 1, 50, 0, 250, 10, "6 fr takes the rest")

    // ---- 7. spanning item (300 wide) over px(100) | auto, measured:
    // the auto track grows by 300 - 100 = 200; the whole is 300.
    var g7: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g7, grid.tk_px(100))
    grid.gs_add_col(&g7, grid.tk_auto())
    it[0] = grid.grid_item(300, 20)
    grid.gitem_place(&it[0], 0, 0, 2, 1)
    var mw: i64 = 0
    var mh: i64 = 0
    grid.grid_measure(&g7, pi, 1, &mw, &mh)
    check(mw == 300, "7 a spanning item raises the auto track it crosses (w 300)")
    check(mh == 20, "7 measured height = row 20")

    // ---- 8. auto flow, 3 columns, 7 items: rows 0..2, item 3 -> (1,0).
    var g8: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g8, grid.tk_px(10))
    grid.gs_add_col(&g8, grid.tk_px(10))
    grid.gs_add_col(&g8, grid.tk_px(10))
    grid.gs_set_items(&g8, flex.AL_START, flex.AL_START)
    var i: usize = 0
    while i < 7 {
        it[i] = grid.grid_item(10, 10)
        i = i + 1
    }
    grid.grid_layout(&g8, layout.rect_new(0, 0, 30, 90), pi, 7, po)
    check(grid.grid_row_count(&g8, pi, 7) == 3, "8 7 items in 3 columns = 3 rows")
    // rows are auto: stretched over 90 -> 30 each
    want(po, 3, 0, 30, 10, 10, "8 item 3 wraps to row 1, column 0")
    want(po, 6, 0, 60, 10, 10, "8 item 6 is alone in row 2")

    // ---- 9. spans in the flow, 3 columns: A(2) B(2) C(1).
    // sparse: A (0,0) B does not fit at col 2 -> (1,0), C -> (1,2).
    // dense:  C goes back into the hole (0,2).
    var g9: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g9, grid.tk_px(10))
    grid.gs_add_col(&g9, grid.tk_px(10))
    grid.gs_add_col(&g9, grid.tk_px(10))
    grid.gs_set_items(&g9, flex.AL_START, flex.AL_START)
    it[0] = grid.grid_item(10, 10)
    grid.gitem_place(&it[0], 0 - 1, 0 - 1, 2, 1)
    it[1] = grid.grid_item(10, 10)
    grid.gitem_place(&it[1], 0 - 1, 0 - 1, 2, 1)
    it[2] = grid.grid_item(10, 10)
    grid.grid_layout(&g9, layout.rect_new(0, 0, 30, 20), pi, 3, po)
    want(po, 1, 0, 10, 10, 10, "9 sparse: B wraps to row 1")
    want(po, 2, 20, 10, 10, 10, "9 sparse: C stays behind B (1,2)")
    grid.gs_set_flow(&g9, grid.FLOW_ROW, true)
    grid.grid_layout(&g9, layout.rect_new(0, 0, 30, 20), pi, 3, po)
    want(po, 2, 20, 0, 10, 10, "9 dense: C fills the hole (0,2)")

    // ---- 10. column flow, 2 explicit rows, 5 items: 3 columns.
    var g10: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_row(&g10, grid.tk_px(10))
    grid.gs_add_row(&g10, grid.tk_px(10))
    grid.gs_set_flow(&g10, grid.FLOW_COLUMN, false)
    grid.gs_set_items(&g10, flex.AL_START, flex.AL_START)
    grid.gs_set_auto(&g10, grid.tk_px(10), grid.tk_auto())
    i = 0
    while i < 5 {
        it[i] = grid.grid_item(10, 10)
        i = i + 1
    }
    grid.grid_layout(&g10, layout.rect_new(0, 0, 30, 20), pi, 5, po)
    check(grid.grid_col_count(&g10, pi, 5) == 3, "10 column flow: 5 items in 2 rows = 3 columns")
    want(po, 1, 0, 10, 10, 10, "10 column flow: item 1 below item 0")
    want(po, 2, 10, 0, 10, 10, "10 column flow: item 2 starts column 1")
    want(po, 4, 20, 0, 10, 10, "10 column flow: item 4 starts column 2")

    // ---- 11. explicit cell among auto items: auto, (0,2), auto -> the
    // automatic ones take (0,0) and (0,1).
    it[0] = grid.grid_item(10, 10)
    it[1] = grid.grid_item(10, 10)
    grid.gitem_place(&it[1], 2, 0, 1, 1)
    it[2] = grid.grid_item(10, 10)
    grid.grid_layout(&g8, layout.rect_new(0, 0, 30, 30), pi, 3, po)
    want(po, 0, 0, 0, 10, 10, "11 auto item 0 -> (0,0)")
    want(po, 1, 20, 0, 10, 10, "11 explicit column 2 stays")
    want(po, 2, 10, 0, 10, 10, "11 auto item 2 -> (0,1), around the explicit one")

    // ---- 12. row given, column automatic: both land in row 1.
    it[0] = grid.grid_item(10, 10)
    grid.gitem_place(&it[0], 0 - 1, 1, 1, 1)
    it[1] = grid.grid_item(10, 10)
    grid.gitem_place(&it[1], 0 - 1, 1, 1, 1)
    grid.grid_layout(&g8, layout.rect_new(0, 0, 30, 60), pi, 2, po)
    want(po, 0, 0, 25, 10, 10, "12 row-only item: first free column of row 1 (empty row 0 stretches too)")
    want(po, 1, 10, 25, 10, 10, "12 second row-only item: next column")

    // ---- 13. RTL: 3 x px(100) in 400, stretch items. Column 0 sits at the
    // right edge: x = 300, 200, 100.
    var g13: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g13, grid.tk_px(100))
    grid.gs_add_col(&g13, grid.tk_px(100))
    grid.gs_add_col(&g13, grid.tk_px(100))
    grid.gs_set_rtl(&g13, true)
    i = 0
    while i < 3 {
        it[i] = grid.grid_item(10, 10)
        i = i + 1
    }
    grid.grid_layout(&g13, layout.rect_new(0, 0, 400, 10), pi, 3, po)
    want(po, 0, 300, 0, 100, 10, "13 rtl: column 0 at the right edge")
    want(po, 2, 100, 0, 100, 10, "13 rtl: column 2 at x 100 (free 100 stays left)")
    // with centred content the three are mirrored inside the centre
    grid.gs_set_content(&g13, grid.GC_CENTER, grid.GC_STRETCH)
    grid.grid_layout(&g13, layout.rect_new(0, 0, 400, 10), pi, 3, po)
    want(po, 0, 250, 0, 100, 10, "13b rtl + centre: column 0 = 250")
    // an END aligned item sits at the LEFT of its cell in rtl
    grid.gs_set_content(&g13, grid.GC_STRETCH, grid.GC_STRETCH)
    grid.gs_set_items(&g13, flex.AL_END, flex.AL_START)
    grid.grid_layout(&g13, layout.rect_new(0, 0, 400, 10), pi, 1, po)
    want(po, 0, 300, 0, 10, 10, "13c rtl: AL_END is the LEFT side of the cell (x 300)")
    grid.gs_set_items(&g13, flex.AL_START, flex.AL_START)
    grid.grid_layout(&g13, layout.rect_new(0, 0, 400, 10), pi, 1, po)
    want(po, 0, 390, 0, 10, 10, "13d rtl: AL_START is the RIGHT side (x 390)")

    // ---- 14. centre alignment: item 40 in a column of 100 -> x 30.
    var g14: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g14, grid.tk_px(100))
    grid.gs_add_row(&g14, grid.tk_px(50))
    grid.gs_set_items(&g14, flex.AL_CENTER, flex.AL_END)
    it[0] = grid.grid_item(40, 20)
    grid.grid_layout(&g14, layout.rect_new(5, 5, 100, 50), pi, 1, po)
    want(po, 0, 35, 35, 40, 20, "14 centre x, end y inside the cell")

    // ---- 15. a span includes the gap inside it: 2 x 100 + gap 10 = 210.
    var g15: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g15, grid.tk_px(100))
    grid.gs_add_col(&g15, grid.tk_px(100))
    grid.gs_set_gap(&g15, 10, 0)
    it[0] = grid.grid_item(10, 10)
    grid.gitem_place(&it[0], 0, 0, 2, 1)
    grid.grid_layout(&g15, layout.rect_new(0, 0, 210, 10), pi, 1, po)
    want(po, 0, 0, 0, 210, 10, "15 a span of 2 columns is 210 wide")

    // ---- 16. rows: 50px | 1fr in height 200 -> 50 and 150.
    var g16: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g16, grid.tk_px(100))
    grid.gs_add_row(&g16, grid.tk_px(50))
    grid.gs_add_row(&g16, grid.tk_fr(1000))
    it[0] = grid.grid_item(10, 10)
    it[1] = grid.grid_item(10, 10)
    grid.grid_layout(&g16, layout.rect_new(0, 0, 100, 200), pi, 2, po)
    want(po, 0, 0, 0, 100, 50, "16 fixed row 50")
    want(po, 1, 0, 50, 100, 150, "16 fr row takes 150")

    // ---- 17. content distribution of 2 x 100 in 400 (free 200).
    var g17: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g17, grid.tk_px(100))
    grid.gs_add_col(&g17, grid.tk_px(100))
    it[0] = grid.grid_item(10, 10)
    it[1] = grid.grid_item(10, 10)
    grid.gs_set_content(&g17, grid.GC_CENTER, grid.GC_STRETCH)
    grid.grid_layout(&g17, layout.rect_new(0, 0, 400, 10), pi, 2, po)
    want(po, 0, 100, 0, 100, 10, "17 centre: starts at 100")
    grid.gs_set_content(&g17, grid.GC_BETWEEN, grid.GC_STRETCH)
    grid.grid_layout(&g17, layout.rect_new(0, 0, 400, 10), pi, 2, po)
    want(po, 1, 300, 0, 100, 10, "17 space-between: the last sits flush right")
    grid.gs_set_content(&g17, grid.GC_EVENLY, grid.GC_STRETCH)
    grid.grid_layout(&g17, layout.rect_new(0, 0, 400, 10), pi, 2, po)
    want(po, 0, 66, 0, 100, 10, "17 evenly: 200/3 = 66 before the first")
    want(po, 1, 232, 0, 100, 10, "17 evenly: 66 + 100 + 66 = 232")
    grid.gs_set_content(&g17, grid.GC_END, grid.GC_STRETCH)
    grid.grid_layout(&g17, layout.rect_new(0, 0, 400, 10), pi, 2, po)
    want(po, 0, 200, 0, 100, 10, "17 end: starts at 200")

    // ---- 18. implicit rows of grid-auto-rows 40.
    var g18: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g18, grid.tk_px(10))
    grid.gs_add_col(&g18, grid.tk_px(10))
    grid.gs_add_col(&g18, grid.tk_px(10))
    grid.gs_set_auto(&g18, grid.tk_auto(), grid.tk_px(40))
    grid.gs_set_items(&g18, flex.AL_START, flex.AL_START)
    i = 0
    while i < 6 {
        it[i] = grid.grid_item(10, 10)
        i = i + 1
    }
    grid.grid_layout(&g18, layout.rect_new(0, 0, 30, 80), pi, 6, po)
    want(po, 3, 0, 40, 10, 10, "18 implicit row 1 starts at y 40")
    var gw: i64 = 0
    var gh: i64 = 0
    grid.grid_measure(&g18, pi, 6, &gw, &gh)
    check(gh == 80 && gw == 30, "18 measured: 2 implicit rows of 40 = 80, 3 x 10 = 30")

    // ---- 19. measuring fr tracks: all fr tracks become as large as the
    // largest item needs (30 and 50 -> both 50 -> 100).
    var g19: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g19, grid.tk_fr(1000))
    grid.gs_add_col(&g19, grid.tk_fr(1000))
    it[0] = grid.grid_item(30, 10)
    it[1] = grid.grid_item(50, 10)
    grid.gs_set_gap(&g19, 6, 0)
    grid.grid_measure(&g19, pi, 2, &gw, &gh)
    check(gw == 106, "19 two fr tracks measured equal to the largest item (50+50+gap 6)")

    // ---- 20. minmax(50px, 200px) in 400: maximise stops at the limit.
    var g20: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g20, grid.tk_minmax(grid.TK_PX, 50, grid.TK_PX, 200))
    it[0] = grid.grid_item(10, 10)
    grid.grid_layout(&g20, layout.rect_new(0, 0, 400, 10), pi, 1, po)
    want(po, 0, 0, 0, 200, 10, "20 minmax(50, 200) grows to its limit only")

    // ---- 21. padding: space 120x70, pad 10 -> inner 100x50.
    var g21: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g21, grid.tk_fr(1000))
    grid.gs_add_row(&g21, grid.tk_fr(1000))
    grid.gs_set_padding(&g21, 10, 10, 10, 10)
    grid.grid_layout(&g21, layout.rect_new(0, 0, 120, 70), pi, 1, po)
    want(po, 0, 10, 10, 100, 50, "21 padding is taken off before the tracks")
    grid.grid_measure(&g21, pi, 1, &gw, &gh)
    check(gw == 30 && gh == 30, "21 measured: item 10 + padding 20 = 30")

    // ---- 22. a fixed-size item is not stretched
    it[0] = grid.grid_item(40, 20)
    grid.gitem_fixed(&it[0], true, true)
    grid.grid_layout(&g21, layout.rect_new(0, 0, 120, 70), pi, 1, po)
    want(po, 0, 10, 10, 40, 20, "22 a fixed-size item keeps its size (start)")

    // ---- 23. the item stride is MEASURED
    check(grid.grid_item_stride() == 80, "23 a GridItem is 80 octets")

    // ---- 24. hash: equal specs equal, any difference differs
    var ha: grid.GridSpec = grid.grid_spec_new()
    var hb: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&ha, grid.tk_fr(1000))
    grid.gs_add_col(&hb, grid.tk_fr(1000))
    check(grid.gs_hash(&ha) == grid.gs_hash(&hb), "24 equal specs, equal hash")
    grid.gs_set_rtl(&hb, true)
    check(grid.gs_hash(&ha) != grid.gs_hash(&hb), "24 rtl changes the hash")

    // ---- 25. too many tracks / far cells are clamped, nothing written behind
    var g25: grid.GridSpec = grid.grid_spec_new()
    i = 0
    var added: usize = 0
    while i < 20 {
        if grid.gs_add_col(&g25, grid.tk_px(5)) {
            added = added + 1
        }
        i = i + 1
    }
    check(added == 16, "25 the 17th explicit track is refused")
    it[0] = grid.grid_item(10, 10)
    grid.gitem_place(&it[0], 500, 500, 100, 100)
    grid.grid_layout(&g25, layout.rect_new(0, 0, 100, 100), pi, 1, po)
    check(grid.grid_col_count(&g25, pi, 1) <= 32, "25 far cell: at most 32 columns")

    // ---- 26. a grid with a zero-width container does not divide by zero
    var g26: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g26, grid.tk_fr(1000))
    grid.gs_add_col(&g26, grid.tk_fr(1000))
    it[0] = grid.grid_item(10, 10)
    it[1] = grid.grid_item(10, 10)
    grid.grid_layout(&g26, layout.rect_new(0, 0, 0, 0), pi, 2, po)
    check(layout.rect_w(cellat(po, 0)) >= 0, "26 empty space is no crash")

    // ---- 27. a spanning item over fr tracks raises them by factor
    // cols 1fr | 3fr (min auto), spanning item min 80, measured: base 0 each
    // -> 20 | 60 (factor), per = max(ceil(20*1000/1000), ceil(60*1000/3000)) = 20,
    // sizes 20 and 60.
    var g27: grid.GridSpec = grid.grid_spec_new()
    grid.gs_add_col(&g27, grid.tk_fr(1000))
    grid.gs_add_col(&g27, grid.tk_fr(3000))
    it[0] = grid.grid_item(80, 10)
    grid.gitem_place(&it[0], 0, 0, 2, 1)
    grid.grid_measure(&g27, pi, 1, &gw, &gh)
    check(gw == 80, "27 a spanning item over fr tracks measures 80")

    say("\n")
    if BAD > 0 {
        say("GRID IS NOT IN ORDER.\n")
        return 1
    }
    say("GRID PASSED.\n")
    return 0
}
