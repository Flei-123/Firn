// SPDX-License-Identifier: MPL-2.0
// tools/fui/wave7_main.fi -- the Range-Slider of lib/fui/wave7.fi (r146): snapping, ordering, press / drag / keys, mirrored (RTL), pixels.
//
//     wave7_main            prints one line per check, exit 0 when all hold
import std.rt
import fui.safeout
import html.mem
import paint.png
import paint.canvas
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.style
import fui.editor
import fui.kit
import fui.kitcolor
import fui.lucide
import fui.wave7
import plat.sysfont

static mut BAD: usize = 0
static mut CHECKS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
    w: usize,
    h: usize,
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    kitcolor.kit_theme(&(*p).m, dark)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    (*p).w = w
    (*p).h = h
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn tok(p: *mut Page, t: u32) -> u32 {
    return theme.opaque(render.color_of(&(*p).c, style.color_token(t)))
}

fn clear(p: *mut Page) {
    canvas.canvas_clear(&(*p).cv, tok(p, style.TOK_BASE))
}

fn px(p: *mut Page, x: f64, y: f64) -> u32 {
    return canvas.canvas_get(&(*p).cv, x as usize, y as usize)
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

// One picture (320x200): four range sliders -- plain, focused low thumb, focused high thumb, disabled -- and one mirrored (RTL).
fn run_picture(dir: u64, font: u64, dark: bool, name: str) {
    let p: *mut Page = page_new(320, 200, dark, font)
    if p as u64 == 0 {
        return
    }
    let c: *mut render.Ctx = &(*p).c
    kit.kit_set_rtl(false)
    clear(p)
    var r1: wave7.Range = wave7.range_new(0, 100, 5, 20, 80)
    var r2: wave7.Range = wave7.range_new(0, 100, 5, 35, 60)
    r2.focus = wave7.RANGE_LO
    var r3: wave7.Range = wave7.range_new(0, 100, 5, 0, 45)
    r3.focus = wave7.RANGE_HI
    var r4: wave7.Range = wave7.range_new(0, 100, 5, 50, 50)
    wave7.range_draw(c, 20.0, 10.0, 280.0, &r1, 0 as u32)
    wave7.range_draw(c, 20.0, 50.0, 280.0, &r2, kit.ST_FOCUS)
    wave7.range_draw(c, 20.0, 90.0, 280.0, &r3, kit.ST_FOCUS)
    wave7.range_draw(c, 20.0, 130.0, 280.0, &r4, kit.ST_DISABLED)
    kit.kit_set_rtl(true)
    wave7.range_draw(c, 20.0, 165.0, 280.0, &r1, 0 as u32)
    kit.kit_set_rtl(false)
    save(&(*p).cv, dir, name)
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("wave7: no font (DejaVu Sans)\n")
        return 9
    }
    let font: u64 = fs as u64
    var d: usize = 0
    while d < 2 {
        let dark: bool = d == 1
        let p: *mut Page = page_new(320, 80, dark, font)
        if p as u64 == 0 {
            say("no page\n")
            return 2
        }
        let c: *mut render.Ctx = &(*p).c
        kit.kit_set_rtl(false)
        var r: wave7.Range = wave7.range_new(0, 100, 5, 20, 80)
        check(r.lo == 20 && r.hi == 80, "new keeps lo/hi on the step")
        wave7.range_set(&r, 83, 12)
        check(r.lo == 10 && r.hi == 85, "set snaps (12 -> 10, 83 -> 85) and orders")
        wave7.range_set(&r, 20, 80)
        let x: f64 = 20.0
        let w: f64 = 280.0
        let xl: f64 = wave7.range_thumb_x(c, &r, x, w, r.lo)
        let xh: f64 = wave7.range_thumb_x(c, &r, x, w, r.hi)
        check(xl < xh, "low thumb left of the high thumb")
        check(wave7.range_value_at(c, &r, x, w, xl) == 20 && wave7.range_value_at(c, &r, x, w, xh) == 80, "value_at inverts thumb_x")
        check(wave7.range_value_at(c, &r, x, w, -50.0) == 0 && wave7.range_value_at(c, &r, x, w, 900.0) == 100, "value_at clamps")
        // press nearer the high thumb picks it and moves it
        let pk: usize = wave7.range_press(c, &r, x, w, xh + 10.0)
        check(pk == wave7.RANGE_HI && r.picked == wave7.RANGE_HI, "press near the high thumb picks it")
        wave7.range_drag(c, &r, x, w, 900.0)
        check(r.hi == 100 && r.lo == 20, "drag far right: hi 100, lo untouched")
        wave7.range_drag(c, &r, x, w, xl - 40.0)
        check(r.hi == r.lo && r.lo == 20, "the high thumb stops at the low one (no crossing)")
        wave7.range_release(&r)
        check(r.picked == wave7.RANGE_NONE, "release")
        // both on one spot: press left of it picks the low one so they can part
        let xs: f64 = wave7.range_thumb_x(c, &r, x, w, 20)
        let pk2: usize = wave7.range_press(c, &r, x, w, xs - 3.0)
        check(pk2 == wave7.RANGE_LO, "same spot, press left: low thumb")
        wave7.range_release(&r)
        let pk3: usize = wave7.range_press(c, &r, x, w, xs + 3.0)
        check(pk3 == wave7.RANGE_HI, "same spot, press right: high thumb")
        wave7.range_release(&r)
        // keys
        wave7.range_set(&r, 20, 80)
        r.focus = wave7.RANGE_LO
        check(wave7.range_key(&r, editor.KEY_RIGHT) && r.lo == 25, "right: lo + step")
        check(wave7.range_key(&r, editor.KEY_END) && r.lo == 80, "End: lo stops at hi")
        check(!wave7.range_key(&r, editor.KEY_RIGHT), "right at the limit: no change")
        wave7.range_focus_next(&r)
        check(!wave7.range_key(&r, editor.KEY_HOME) && r.hi == 80, "Home on hi stops at lo (no change when lo is there)")
        wave7.range_set(&r, 20, 80)
        // RTL
        kit.kit_set_rtl(true)
        let xlr: f64 = wave7.range_thumb_x(c, &r, x, w, r.lo)
        let xhr: f64 = wave7.range_thumb_x(c, &r, x, w, r.hi)
        check(xlr > xhr, "RTL: the low thumb is on the right")
        check(wave7.range_value_at(c, &r, x, w, xlr) == 20, "RTL: value_at inverts thumb_x")
        r.focus = wave7.RANGE_LO
        check(wave7.range_key(&r, editor.KEY_LEFT) && r.lo == 25, "RTL: left arrow = more")
        kit.kit_set_rtl(false)
        wave7.range_set(&r, 20, 80)
        // pixels: knob colour at both centres, the accent fill between them, the bare track outside
        clear(p)
        wave7.range_draw(c, x, 10.0, w, &r, 0 as u32)
        let cy: f64 = 10.0 + wave7.range_height(c) / 2.0
        let knob: u32 = tok(p, style.TOK_TEXT)
        check(px(p, xl, cy) == knob && px(p, xh, cy) == knob, "draw: knob colour at both thumb centres")
        let mid: u32 = px(p, (xl + xh) / 2.0, cy)
        check(mid != tok(p, style.TOK_BASE) && mid != px(p, x + w - 2.0, cy), "draw: the part between the thumbs is filled, not the track")
        d = d + 1
    }
    if rt.arg_count(start) >= 2 {
        let pdir: u64 = rt.arg_ptr(start, 1)
        run_picture(pdir, font, true, "wave7-dark.png")
        run_picture(pdir, font, false, "wave7-light.png")
    }
    if BAD == 0 {
        say("wave7: ALL OK\n")
        return 0
    }
    say("wave7: BROKEN\n")
    return 1
}
