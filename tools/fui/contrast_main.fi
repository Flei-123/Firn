// SPDX-License-Identifier: MPL-2.0
// tools/fui/contrast_main.fi -- THE BRAND CHECKS ITS OWN PROMISE.
//
// The design system puts ONE requirement first
// (.../skills/ui-ux-pro-max/SKILL.md, priority 1, "Accessibility,
// CRITICAL"): contrast 4.5:1 for ordinary text.
//
// A promise nobody recomputes is just a claim. This program
// recomputes every text pair of the theme -- in BOTH schemes -- and
// exits with 1 if any of them falls below. That way a colour someone
// changes "just quickly" fails in the build and not on Justin's
// screen.
//
// It has already found three real bugs, two of them in shipped
// Certus; they are documented in the header of lib/fui/theme.fi.
//
//     contrast_main              only the summary and what fails
//     contrast_main --verbose    every single pair
import std.rt
import fui.theme
import fui.anim
import svg.matrix

static mut G_VERBOSE: u32 = 0
static mut G_BAD: usize = 0
static mut G_TOTAL: usize = 0
static mut G_MIN: i64 = 9900

// Two decimal places, integer only -- Firn stage 0 has no formatting.
fn dec2(t: *mut rt.Buf, hundredths: i64) {
    rt.buf_push_dec_i64(t, hundredths / 100)
    rt.buf_push(t, 46 as u8)
    let rest: i64 = hundredths % 100
    if rest < 10 {
        rt.buf_push(t, 48 as u8)
    }
    rt.buf_push_dec_i64(t, rest)
}

// Check one pair and report it. The threshold is 4.5:1 = 450
// hundredths.
fn expect(nm: u64, nn: usize, vg: u32, bg: u32) {
    let k: f64 = theme.contrast(vg, bg)
    let h: i64 = (k * 100.0 + 0.5) as i64
    G_TOTAL = G_TOTAL + 1
    if h < G_MIN {
        G_MIN = h
    }
    let bad: bool = h < 450
    if bad {
        G_BAD = G_BAD + 1
    }
    if G_VERBOSE == 0 && !bad {
        return
    }
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 30 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    dec2(&t, h)
    var s_v: [u8; 3] = ":1 "
    rt.buf_push_bytes(&t, (&s_v[0]) as u64, 3)
    if bad {
        var s_n: [u8; 12] = "TOO LOW <<<\n"
        rt.buf_push_bytes(&t, (&s_n[0]) as u64, 12)
    } else {
        var s_o: [u8; 3] = "OK\n"
        rt.buf_push_bytes(&t, (&s_o[0]) as u64, 3)
    }
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// All text pairs of ONE scheme. The list is the complete set of
// cases where fUi paints text onto a surface -- whoever adds a
// control that needs a new pair enters it here.
//
fn scheme(f: *mut theme.Colors) {
    var n1: [u8; 22] = "  text/button         "
    var n2: [u8; 22] = "  text/button_hover   "
    var n3: [u8; 22] = "  text/button_active  "
    var n4: [u8; 22] = "  text/field          "
    var n5: [u8; 22] = "  text/field_focus    "
    var n6: [u8; 22] = "  text/surface        "
    var n7: [u8; 22] = "  text/surface_raised "
    var n8: [u8; 22] = "  text/base           "
    var n9: [u8; 22] = "  text_muted/surface  "
    var na: [u8; 22] = "  text_disabled/button"
    var nb: [u8; 22] = "  sel_text/selection  "
    var nc: [u8; 22] = "  on_accent/accent    "
    var nd: [u8; 22] = "  err_col/surface     "
    var ne: [u8; 22] = "  warning/surface     "
    var nf: [u8; 22] = "  success/surface     "
    expect((&n1[0]) as u64, 22, (*f).text, (*f).button)
    expect((&n2[0]) as u64, 22, (*f).text, (*f).button_hover)
    expect((&n3[0]) as u64, 22, (*f).text, (*f).button_active)
    expect((&n4[0]) as u64, 22, (*f).text, (*f).field)
    expect((&n5[0]) as u64, 22, (*f).text, (*f).field_focus)
    expect((&n6[0]) as u64, 22, (*f).text, (*f).surface)
    expect((&n7[0]) as u64, 22, (*f).text, (*f).surface_raised)
    expect((&n8[0]) as u64, 22, (*f).text, (*f).base)
    expect((&n9[0]) as u64, 22, (*f).text_muted, (*f).surface)
    expect((&na[0]) as u64, 22, (*f).text_disabled, (*f).button)
    expect((&nb[0]) as u64, 22, (*f).selection_text, (*f).selection)
    expect((&nc[0]) as u64, 22, (*f).text_on_accent, (*f).accent)
    expect((&nd[0]) as u64, 22, (*f).err_col, (*f).surface)
    expect((&ne[0]) as u64, 22, (*f).warning, (*f).surface)
    expect((&nf[0]) as u64, 22, (*f).success, (*f).surface)
}

// THE SECOND CHECK: THE RANKING.
//
// Contrast alone is not enough. A DISABLED widget must look weaker
// than an active one -- otherwise "disabled" is readable but not
// recognisable. And the three button surfaces must differ, or the
// feedback to a pointer is no feedback at all.
fn ranking(f: *mut theme.Colors) -> usize {
    var bad: usize = 0
    var t: rt.Buf = rt.buf_new()
    let k_norm: f64 = theme.contrast((*f).text, (*f).button)
    let k_disabled: f64 = theme.contrast((*f).text_disabled, (*f).button)
    var s1: [u8; 28] = "  disabled is weaker:       "
    rt.buf_push_bytes(&t, (&s1[0]) as u64, 28)
    if k_disabled < k_norm {
        var ok: [u8; 3] = "OK\n"
        rt.buf_push_bytes(&t, (&ok[0]) as u64, 3)
    } else {
        var no: [u8; 6] = "WRONG\n"
        rt.buf_push_bytes(&t, (&no[0]) as u64, 6)
        bad = bad + 1
    }
    var s2: [u8; 28] = "  three button surfaces:    "
    rt.buf_push_bytes(&t, (&s2[0]) as u64, 28)
    if (*f).button != (*f).button_hover && (*f).button_hover != (*f).button_active
        && (*f).button != (*f).button_active {
        var ok2: [u8; 3] = "OK\n"
        rt.buf_push_bytes(&t, (&ok2[0]) as u64, 3)
    } else {
        var no2: [u8; 6] = "WRONG\n"
        rt.buf_push_bytes(&t, (&no2[0]) as u64, 6)
        bad = bad + 1
    }
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return bad
}

// THE THIRD CHECK: THE THREE LAYERS ARE THREE.
//
// 20.09.2026: in the light scheme `base` and `surface_raised` were
// both 0xFFFFFF. A menu, a card, a dialog then had no surface of
// their own -- only a hairline border said where they began, and
// wherever a shadow was supposed to do that work the layering was
// simply invisible. A scheme that ranks its layers has to SEPARATE
// them, and the separation is measured, not asserted: the distance
// in OKLab (lib/fui/anim.fi has the conversion, there is no second
// place for it) between two neighbouring layers has to be at least
// 0.012 -- about five steps of 255 in the bright range, which is the
// smallest step a person still sees on a flat panel.
const DE_MIN: i64 = 12

fn delta_e(a: u32, b: u32) -> f64 {
    var l0: f64 = 0.0
    var a0: f64 = 0.0
    var b0: f64 = 0.0
    var l1: f64 = 0.0
    var a1: f64 = 0.0
    var b1: f64 = 0.0
    anim.srgb_to_oklab(((a >> 16) & 255) as f64 / 255.0,
        ((a >> 8) & 255) as f64 / 255.0, (a & 255) as f64 / 255.0,
        &l0, &a0, &b0)
    anim.srgb_to_oklab(((b >> 16) & 255) as f64 / 255.0,
        ((b >> 8) & 255) as f64 / 255.0, (b & 255) as f64 / 255.0,
        &l1, &a1, &b1)
    let dl: f64 = l1 - l0
    let da: f64 = a1 - a0
    let db: f64 = b1 - b0
    return matrix.m_sqrt(dl * dl + da * da + db * db)
}

fn layer_step(t: *mut rt.Buf, nm: u64, nn: usize, a: u32, b: u32) -> usize {
    rt.buf_push_bytes(t, nm, nn)
    var i: usize = nn
    while i < 30 {
        rt.buf_push(t, 32 as u8)
        i = i + 1
    }
    let d: i64 = (delta_e(a, b) * 1000.0 + 0.5) as i64
    var s_d: [u8; 4] = "dE 0"
    rt.buf_push_bytes(t, (&s_d[0]) as u64, 3)
    rt.buf_push_dec_i64(t, d)
    var s_t: [u8; 7] = "/1000  "
    rt.buf_push_bytes(t, (&s_t[0]) as u64, 7)
    if a != b && d >= DE_MIN {
        var ok: [u8; 3] = "OK\n"
        rt.buf_push_bytes(t, (&ok[0]) as u64, 3)
        return 0
    }
    var no: [u8; 14] = "TOO CLOSE <<<\n"
    rt.buf_push_bytes(t, (&no[0]) as u64, 14)
    return 1
}

fn layers(f: *mut theme.Colors) -> usize {
    var bad: usize = 0
    var t: rt.Buf = rt.buf_new()
    var s1: [u8; 30] = "  base vs surface:            "
    var s2: [u8; 30] = "  surface vs surface_raised:  "
    var s3: [u8; 30] = "  base vs surface_raised:     "
    bad = bad + layer_step(&t, (&s1[0]) as u64, 30, (*f).base,
        (*f).surface)
    bad = bad + layer_step(&t, (&s2[0]) as u64, 30, (*f).surface,
        (*f).surface_raised)
    bad = bad + layer_step(&t, (&s3[0]) as u64, 30, (*f).base,
        (*f).surface_raised)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return bad
}

fn main(start: u64) -> i32 {
    var i: usize = 1
    while i < rt.arg_count(start) {
        let p: u64 = rt.arg_ptr(start, i)
        // "--verbose" -- the third octet is 'v'
        if rt.c_length(p) == 9 && rt.ld8(p, 2) == 118 as u8 {
            G_VERBOSE = 1
        }
        i = i + 1
    }

    var light: theme.Colors = theme.colors_light()
    var dark: theme.Colors = theme.colors_dark()

    var v1: [u8; 7] = "LIGHT:\n"
    rt.write_everything(1, (&v1[0]) as u64, 7)
    scheme(&light)
    var b1: usize = ranking(&light)
    b1 = b1 + layers(&light)

    var v2: [u8; 6] = "DARK:\n"
    rt.write_everything(1, (&v2[0]) as u64, 6)
    scheme(&dark)
    var b2: usize = ranking(&dark)
    b2 = b2 + layers(&dark)

    // ---- THE SUMMARY
    var t: rt.Buf = rt.buf_new()
    var z1: [u8; 9] = "\nCHECKED "
    rt.buf_push_bytes(&t, (&z1[0]) as u64, 9)
    rt.buf_push_dec_i64(&t, G_TOTAL as i64)
    var z2: [u8; 13] = " text pairs, "
    rt.buf_push_bytes(&t, (&z2[0]) as u64, 13)
    rt.buf_push_dec_i64(&t, G_BAD as i64)
    var z3: [u8; 18] = " under 4.5:1, min "
    rt.buf_push_bytes(&t, (&z3[0]) as u64, 18)
    dec2(&t, G_MIN)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)

    if G_BAD > 0 || b1 > 0 || b2 > 0 {
        var f1: [u8; 33] = "BRAND DOES NOT KEEP ITS PROMISE.\n"
        rt.write_everything(1, (&f1[0]) as u64, 33)
        return 1
    }
    var o1: [u8; 14] = "BRAND PASSED.\n"
    rt.write_everything(1, (&o1[0]) as u64, 14)
    return 0
}
