// SPDX-License-Identifier: MPL-2.0
// tools/fui/contrast_main.fi -- THE BRAND CHECKS ITS OWN PROMISE.
//
// The design system puts ONE requirement first
// (.../skills/ui-ux-pro-max/SKILL.md, priority 1, "Accessibility,
// CRITICAL"): contrast 4.5:1 for ordinary text.
//
// A promise nobody recomputes is just a claim. This program
// recomputes every text pair of the theme -- in BOTH schemes -- and
// exits with 1 if any of them falls below. That way a colour someone
// changes "just quickly" fails in the build and not on Justin's
// screen.
//
// It has already found three real bugs, two of them in shipped
// Certus; they are documented in the header of lib/fui/theme.fi.
//
//     contrast_main              only the summary and what fails
//     contrast_main --verbose    every single pair
import std.rt
import fui.theme
import fui.themefile
import fui.anim
import svg.matrix

static mut G_VERBOSE: u32 = 0
static mut G_BAD: usize = 0
static mut G_TOTAL: usize = 0
static mut G_MIN: i64 = 9900

// Two decimal places, integer only -- Firn stage 0 has no formatting.
fn dec2(t: *mut rt.Buf, hundredths: i64) {
    rt.buf_push_dec_i64(t, hundredths / 100)
    rt.buf_push(t, 46 as u8)
    let rest: i64 = hundredths % 100
    if rest < 10 {
        rt.buf_push(t, 48 as u8)
    }
    rt.buf_push_dec_i64(t, rest)
}

// Check one pair and report it. The threshold is 4.5:1 = 450
// hundredths.
fn expect(nm: u64, nn: usize, vg: u32, bg: u32) {
    let k: f64 = theme.contrast(vg, bg)
    let h: i64 = (k * 100.0 + 0.5) as i64
    G_TOTAL = G_TOTAL + 1
    if h < G_MIN {
        G_MIN = h
    }
    let bad: bool = h < 450
    if bad {
        G_BAD = G_BAD + 1
    }
    if G_VERBOSE == 0 && !bad {
        return
    }
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 30 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    dec2(&t, h)
    var s_v: [u8; 3] = ":1 "
    rt.buf_push_bytes(&t, (&s_v[0]) as u64, 3)
    if bad {
        var s_n: [u8; 12] = "TOO LOW <<<\n"
        rt.buf_push_bytes(&t, (&s_n[0]) as u64, 12)
    } else {
        var s_o: [u8; 3] = "OK\n"
        rt.buf_push_bytes(&t, (&s_o[0]) as u64, 3)
    }
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// All text pairs of ONE scheme. The list is the complete set of
// cases where fUi paints text onto a surface. It stands ONCE, in
// lib/fui/themefile.fi (`check_pair`), because a theme file is checked
// against the same list before it is applied -- whoever adds a control
// that needs a new pair enters it there, and both checks see it.
fn scheme(f: *mut theme.Colors) {
    var i: usize = 0
    while i < themefile.check_pair_count() {
        var fg: u32 = 0
        var bg: u32 = 0
        themefile.check_pair(f, i, &fg, &bg)
        var n: usize = 0
        let p: u64 = themefile.check_pair_name(i, &n)
        var nm: [u8; 32] = [0; 32]
        nm[0] = 32 as u8
        nm[1] = 32 as u8
        var k: usize = 0
        while k < n && k < 30 {
            nm[2 + k] = rt.ld8(p, k)
            k = k + 1
        }
        expect((&nm[0]) as u64, 2 + k, fg, bg)
        i = i + 1
    }
}

// THE SECOND CHECK: THE RANKING.
//
// Contrast alone is not enough. A DISABLED widget must look weaker
// than an active one -- otherwise "disabled" is readable but not
// recognisable. And the three button surfaces must differ, or the
// feedback to a pointer is no feedback at all.
fn ranking(f: *mut theme.Colors) -> usize {
    var bad: usize = 0
    var t: rt.Buf = rt.buf_new()
    var s1: [u8; 28] = "  disabled is weaker:       "
    rt.buf_push_bytes(&t, (&s1[0]) as u64, 28)
    if themefile.check_rank_disabled(f) {
        var ok: [u8; 3] = "OK\n"
        rt.buf_push_bytes(&t, (&ok[0]) as u64, 3)
    } else {
        var no: [u8; 6] = "WRONG\n"
        rt.buf_push_bytes(&t, (&no[0]) as u64, 6)
        bad = bad + 1
    }
    var s2: [u8; 28] = "  three button surfaces:    "
    rt.buf_push_bytes(&t, (&s2[0]) as u64, 28)
    if themefile.check_rank_surfaces(f) {
        var ok2: [u8; 3] = "OK\n"
        rt.buf_push_bytes(&t, (&ok2[0]) as u64, 3)
    } else {
        var no2: [u8; 6] = "WRONG\n"
        rt.buf_push_bytes(&t, (&no2[0]) as u64, 6)
        bad = bad + 1
    }
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return bad
}

// THE THIRD CHECK: THE THREE LAYERS ARE THREE.
//
// 20.09.2026: in the light scheme `base` and `surface_raised` were
// both 0xFFFFFF. A menu, a card, a dialog then had no surface of
// their own -- only a hairline border said where they began, and
// wherever a shadow was supposed to do that work the layering was
// simply invisible. A scheme that ranks its layers has to SEPARATE
// them, and the separation is measured, not asserted: the distance
// in OKLab (lib/fui/anim.fi has the conversion, there is no second
// place for it) between two neighbouring layers has to be at least
// 0.012 -- about five steps of 255 in the bright range, which is the
// smallest step a person still sees on a flat panel.
const DE_MIN: i64 = 12

fn delta_e(a: u32, b: u32) -> f64 {
    var l0: f64 = 0.0
    var a0: f64 = 0.0
    var b0: f64 = 0.0
    var l1: f64 = 0.0
    var a1: f64 = 0.0
    var b1: f64 = 0.0
    anim.srgb_to_oklab(((a >> 16) & 255) as f64 / 255.0,
        ((a >> 8) & 255) as f64 / 255.0, (a & 255) as f64 / 255.0,
        &l0, &a0, &b0)
    anim.srgb_to_oklab(((b >> 16) & 255) as f64 / 255.0,
        ((b >> 8) & 255) as f64 / 255.0, (b & 255) as f64 / 255.0,
        &l1, &a1, &b1)
    let dl: f64 = l1 - l0
    let da: f64 = a1 - a0
    let db: f64 = b1 - b0
    return matrix.m_sqrt(dl * dl + da * da + db * db)
}

fn layer_step(t: *mut rt.Buf, nm: u64, nn: usize, a: u32, b: u32) -> usize {
    rt.buf_push_bytes(t, nm, nn)
    var i: usize = nn
    while i < 30 {
        rt.buf_push(t, 32 as u8)
        i = i + 1
    }
    let d: i64 = (delta_e(a, b) * 1000.0 + 0.5) as i64
    var s_d: [u8; 4] = "dE 0"
    rt.buf_push_bytes(t, (&s_d[0]) as u64, 3)
    rt.buf_push_dec_i64(t, d)
    var s_t: [u8; 7] = "/1000  "
    rt.buf_push_bytes(t, (&s_t[0]) as u64, 7)
    if a != b && d >= DE_MIN {
        var ok: [u8; 3] = "OK\n"
        rt.buf_push_bytes(t, (&ok[0]) as u64, 3)
        return 0
    }
    var no: [u8; 14] = "TOO CLOSE <<<\n"
    rt.buf_push_bytes(t, (&no[0]) as u64, 14)
    return 1
}

fn layers(f: *mut theme.Colors) -> usize {
    var bad: usize = 0
    var t: rt.Buf = rt.buf_new()
    var s1: [u8; 30] = "  base vs surface:            "
    var s2: [u8; 30] = "  surface vs surface_raised:  "
    var s3: [u8; 30] = "  base vs surface_raised:     "
    bad = bad + layer_step(&t, (&s1[0]) as u64, 30, (*f).base,
        (*f).surface)
    bad = bad + layer_step(&t, (&s2[0]) as u64, 30, (*f).surface,
        (*f).surface_raised)
    bad = bad + layer_step(&t, (&s3[0]) as u64, 30, (*f).base,
        (*f).surface_raised)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return bad
}

// THE FILL RULE (Justin, 02.10.2026): a widget with a border must not have the
// same fill as the ground under it. The resting field, the focused field and
// the button each stand apart from base, surface and surface_raised by the
// same OKLab step the layers are held to (DE_MIN), and the resting field from
// the focused one. The focused field of the dark scheme WAS the page colour
// and the light one the white of the raised card -- exactly the case.
// lib/fui/themefile.fi `check_fill_distinct` is the one rule: theme files are
// refused by it, and here the two built-in schemes show their numbers.
fn fills(f: *mut theme.Colors) -> usize {
    var bad: usize = 0
    var t: rt.Buf = rt.buf_new()
    var a1: [u8; 30] = "  field vs base:              "
    var a2: [u8; 30] = "  field vs surface:           "
    var a3: [u8; 30] = "  field vs surface_raised:    "
    var b1: [u8; 30] = "  focus vs base:              "
    var b2: [u8; 30] = "  focus vs surface:           "
    var b3: [u8; 30] = "  focus vs surface_raised:    "
    var c1: [u8; 30] = "  button vs base:             "
    var c2: [u8; 30] = "  button vs surface:          "
    var c3: [u8; 30] = "  button vs surface_raised:   "
    var d1: [u8; 30] = "  field vs focused field:     "
    bad = bad + layer_step(&t, (&a1[0]) as u64, 30, (*f).field, (*f).base)
    bad = bad + layer_step(&t, (&a2[0]) as u64, 30, (*f).field, (*f).surface)
    bad = bad + layer_step(&t, (&a3[0]) as u64, 30, (*f).field, (*f).surface_raised)
    bad = bad + layer_step(&t, (&b1[0]) as u64, 30, (*f).field_focus, (*f).base)
    bad = bad + layer_step(&t, (&b2[0]) as u64, 30, (*f).field_focus, (*f).surface)
    bad = bad + layer_step(&t, (&b3[0]) as u64, 30, (*f).field_focus, (*f).surface_raised)
    bad = bad + layer_step(&t, (&c1[0]) as u64, 30, (*f).button, (*f).base)
    bad = bad + layer_step(&t, (&c2[0]) as u64, 30, (*f).button, (*f).surface)
    bad = bad + layer_step(&t, (&c3[0]) as u64, 30, (*f).button, (*f).surface_raised)
    bad = bad + layer_step(&t, (&d1[0]) as u64, 30, (*f).field, (*f).field_focus)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    // the shared rule must agree with the table above
    if themefile.check_fill_distinct(f) != 0 as u32 {
        bad = bad + 1
    }
    return bad
}

// THE FOURTH CHECK: THE SCRIM IS VISIBLE.
//
// 20.09.2026: the scrim behind a modal dialog was `base` pushed 55 %
// towards black -- in BOTH schemes. In the dark scheme that is a
// veil nobody sees: the dark page is already at luminance 0.0116,
// and against pure black there remains a distance of 0.0116 and a
// contrast of 1.19:1. A modal state you cannot see is the worst of
// all: the window looks operable and is not.
//
// So the numbers are nailed down here, for both schemes, against the
// PAGE BACKGROUND the scrim lies on:
//
//   L_MIN   0.050 luminance distance -- the step at which a large
//           area still separates itself from its neighbour
//   K_MIN   1.30:1 contrast
//   T_MIN   20 tone values on the strongest channel -- the same
//           requirement Justin puts on the shadow samples
const SCRIM_L_MIN: i64 = 50
const SCRIM_K_MIN: i64 = 130
const SCRIM_T_MIN: i64 = 20

// The largest per-channel distance of two colours, in tone values.
fn tone_gap(a: u32, b: u32) -> i64 {
    var best: i64 = 0
    var s: u32 = 16
    while true {
        let ca: i64 = ((a >> s) & 255 as u32) as i64
        let cb: i64 = ((b >> s) & 255 as u32) as i64
        var d: i64 = ca - cb
        if d < 0 {
            d = 0 - d
        }
        if d > best {
            best = d
        }
        if s == 0 as u32 {
            break
        }
        s = s - 8 as u32
    }
    return best
}

fn scrim(nm: u64, nn: usize, dark: bool) -> usize {
    var m: theme.Theme = theme.theme_new(dark)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    let basic: u32 = (*f).base
    let sc: u32 = theme.scrim_color(&m) & 16777215 as u32

    let dl: f64 = theme.luminance(sc) - theme.luminance(basic)
    var dli: i64 = (dl * 1000.0 + 0.5) as i64
    if dli < 0 {
        dli = 0 - (dl * 1000.0 - 0.5) as i64
    }
    let k: i64 = (theme.contrast(sc, basic) * 100.0 + 0.5) as i64
    let t: i64 = tone_gap(sc, basic)

    var bad: usize = 0
    if dli < SCRIM_L_MIN {
        bad = 1
    }
    if k < SCRIM_K_MIN {
        bad = 1
    }
    if t < SCRIM_T_MIN {
        bad = 1
    }

    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, nm, nn)
    var i: usize = nn
    while i < 20 {
        rt.buf_push(&b, 32 as u8)
        i = i + 1
    }
    var s_l: [u8; 4] = "dL 0"
    rt.buf_push_bytes(&b, (&s_l[0]) as u64, 3)
    rt.buf_push_dec_i64(&b, dli)
    var s_m: [u8; 8] = "/1000  K"
    rt.buf_push_bytes(&b, (&s_m[0]) as u64, 8)
    rt.buf_push(&b, 32 as u8)
    dec2(&b, k)
    var s_n: [u8; 7] = ":1  Ton"
    rt.buf_push_bytes(&b, (&s_n[0]) as u64, 7)
    rt.buf_push(&b, 32 as u8)
    rt.buf_push_dec_i64(&b, t)
    rt.buf_push(&b, 32 as u8)
    rt.buf_push(&b, 32 as u8)
    if bad == 0 {
        var ok: [u8; 3] = "OK\n"
        rt.buf_push_bytes(&b, (&ok[0]) as u64, 3)
    } else {
        var no: [u8; 15] = "SCRIM BLIND <<\n"
        rt.buf_push_bytes(&b, (&no[0]) as u64, 15)
    }
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    return bad
}

fn main(start: u64) -> i32 {
    var i: usize = 1
    while i < rt.arg_count(start) {
        let p: u64 = rt.arg_ptr(start, i)
        // "--verbose" -- the third octet is 'v'
        if rt.c_length(p) == 9 && rt.ld8(p, 2) == 118 as u8 {
            G_VERBOSE = 1
        }
        i = i + 1
    }

    var light: theme.Colors = theme.colors_light()
    var dark: theme.Colors = theme.colors_dark()

    var v1: [u8; 7] = "LIGHT:\n"
    rt.write_everything(1, (&v1[0]) as u64, 7)
    scheme(&light)
    var b1: usize = ranking(&light)
    b1 = b1 + layers(&light)
    b1 = b1 + fills(&light)
    var sl: [u8; 20] = "  scrim vs base:    "
    b1 = b1 + scrim((&sl[0]) as u64, 18, false)

    var v2: [u8; 6] = "DARK:\n"
    rt.write_everything(1, (&v2[0]) as u64, 6)
    scheme(&dark)
    var b2: usize = ranking(&dark)
    b2 = b2 + layers(&dark)
    b2 = b2 + fills(&dark)
    var sd: [u8; 20] = "  scrim vs base:    "
    b2 = b2 + scrim((&sd[0]) as u64, 18, true)

    // ---- THE SUMMARY
    var t: rt.Buf = rt.buf_new()
    var z1: [u8; 9] = "\nCHECKED "
    rt.buf_push_bytes(&t, (&z1[0]) as u64, 9)
    rt.buf_push_dec_i64(&t, G_TOTAL as i64)
    var z2: [u8; 13] = " text pairs, "
    rt.buf_push_bytes(&t, (&z2[0]) as u64, 13)
    rt.buf_push_dec_i64(&t, G_BAD as i64)
    var z3: [u8; 18] = " under 4.5:1, min "
    rt.buf_push_bytes(&t, (&z3[0]) as u64, 18)
    dec2(&t, G_MIN)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)

    if G_BAD > 0 || b1 > 0 || b2 > 0 {
        var f1: [u8; 33] = "BRAND DOES NOT KEEP ITS PROMISE.\n"
        rt.write_everything(1, (&f1[0]) as u64, 33)
        return 1
    }
    var o1: [u8; 14] = "BRAND PASSED.\n"
    rt.write_everything(1, (&o1[0]) as u64, 14)
    return 0
}
