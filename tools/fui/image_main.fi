// SPDX-License-Identifier: MPL-2.0
// tools/fui/image_main.fi -- PICTURES AT THE PIXEL.
//
// What is checked, and why each one is here:
//
//   1. A picture drawn 1:1 keeps its COLOUR EXACTLY. This is the
//      red/blue swap check. In this project a channel swap has already
//      shipped unnoticed, because a swapped icon still looks like an
//      icon. So the channels are read back as NUMBERS and compared with
//      the colour that was asked for -- not looked at.
//
//   2. Alpha really composites. A half transparent white over black has
//      to land near 128, not at 0 and not at 255.
//
//   3. Shrinking uses every source pixel. A 64x64 chequerboard scaled to
//      8x8 must come out as a FLAT MID GREY -- if nearest neighbour crept
//      back in, it would come out as a chequerboard again, and that is the
//      "stairs" this was built to avoid.
//
//   4. Growing does not turn into blocks. A 2x2 picture at 32x32 must
//      have a gradient along its middle row, i.e. many distinct values,
//      not two.
//
//   5. Nothing is painted outside the destination rectangle.
//
//   6. A tint replaces the colour but keeps the SHAPE (the alpha).
//
//   7. FIT_CONTAIN keeps the aspect ratio and centres.
import std.rt
import paint.canvas
import fui.painter
import fui.uiimage

const W: usize = 160
const H: usize = 160

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, got: i64, want: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var h1: [u8; 5] = " got "
    rt.buf_push_bytes(&t, (&h1[0]) as u64, 5)
    rt.buf_push_dec_i64(&t, got)
    var h2: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&h2[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, want)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn say(s: u64, n: usize) {
    rt.write_everything(1, s, n)
}

// Build a picture in memory: w*h pixels of straight RGBA 0xAARRGGBB.
fn make(w: usize, h: usize) -> u64 {
    let p: *mut u8 = rt.heap_alloc(w * h * 4) as *mut u8
    return p as u64
}

fn put(p: u64, w: usize, x: usize, y: usize, a: u32, r: u32, g: u32,
    b: u32) {
    let o: usize = (y * w + x) * 4
    rt.st8(p, o, r as u8)
    rt.st8(p, o + 1, g as u8)
    rt.st8(p, o + 2, b as u8)
    rt.st8(p, o + 3, a as u8)
}

// Read a canvas pixel back as straight, un-premultiplied channels.
//
// The canvas is PREMULTIPLIED (lib/paint/canvas.fi). Comparing a
// premultiplied pixel against the colour that was asked for would fail on
// anything transparent, so the multiplication is undone here -- the same
// way lib/paint/png.fi does it on the way out.
fn chan(cv: *mut canvas.Canvas, x: usize, y: usize, which: usize) -> i64 {
    let v: u32 = canvas.canvas_get(cv, x, y)
    let a: u32 = (v >> 24) & 255 as u32
    if which == 3 {
        return a as i64
    }
    var c: u32 = 0
    if which == 0 { c = (v >> 16) & 255 as u32 }
    if which == 1 { c = (v >> 8) & 255 as u32 }
    if which == 2 { c = v & 255 as u32 }
    if a == 0 as u32 {
        return 0
    }
    // Round-trip of the premultiply.
    return ((c as f64) * 255.0 / (a as f64) + 0.5) as i64
}

fn near(a: i64, b: i64, tol: i64) -> bool {
    var d: i64 = a - b
    if d < 0 { d = 0 - d }
    return d <= tol
}

fn main() -> i32 {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 2
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, H) {
        return 2
    }

    // ---------------------------------------------------------------
    var t1: [u8; 38] = "== 1. THE CHANNELS ARE NOT SWAPPED ==\n"
    say((&t1[0]) as u64, 38)

    // A picture of ONE pixel in a colour whose three channels are all
    // different -- that is the whole point. A grey or a pure red would
    // survive a swap unnoticed.
    let R: u32 = 200
    let G: u32 = 100
    let B: u32 = 50
    let one: u64 = make(1, 1)
    put(one, 1, 0, 0, 255, R, G, B)
    var im1: uiimage.Image = uiimage.image_wrap(one, 1, 1, 0)

    canvas.canvas_clear(&cv, 4278190080 as u32) // opaque black
    uiimage.image_draw_rect(&z, &im1, 10.0, 10.0, 20.0, 20.0, 0)

    var n1: [u8; 31] = "1 red channel comes back as red"
    report((&n1[0]) as u64, 31, near(chan(&cv, 20, 20, 0), R as i64, 2),
        chan(&cv, 20, 20, 0), R as i64)
    var n2: [u8; 35] = "1 green channel comes back as green"
    report((&n2[0]) as u64, 35, near(chan(&cv, 20, 20, 1), G as i64, 2),
        chan(&cv, 20, 20, 1), G as i64)
    var n3: [u8; 33] = "1 blue channel comes back as blue"
    report((&n3[0]) as u64, 33, near(chan(&cv, 20, 20, 2), B as i64, 2),
        chan(&cv, 20, 20, 2), B as i64)

    // ---------------------------------------------------------------
    var t2: [u8; 27] = "\n== 2. ALPHA COMPOSITES ==\n"
    say((&t2[0]) as u64, 27)

    let half: u64 = make(1, 1)
    put(half, 1, 0, 0, 128, 255, 255, 255)
    var im2: uiimage.Image = uiimage.image_wrap(half, 1, 1, 0)
    canvas.canvas_clear(&cv, 4278190080 as u32) // opaque black
    uiimage.image_draw_rect(&z, &im2, 40.0, 40.0, 20.0, 20.0, 0)
    // white at alpha 128 over black -> about 128 on every channel
    var n4: [u8; 42] = "2 half transparent white over black is mid"
    report((&n4[0]) as u64, 42, near(chan(&cv, 50, 50, 0), 128, 4),
        chan(&cv, 50, 50, 0), 128)

    // and over RED the green channel must rise but stay under 255
    canvas.canvas_clear(&cv, 4294901760 as u32) // opaque red
    uiimage.image_draw_rect(&z, &im2, 40.0, 40.0, 20.0, 20.0, 0)
    let gg: i64 = chan(&cv, 50, 50, 1)
    var n5: [u8; 41] = "2 over red the green channel rises to mid"
    report((&n5[0]) as u64, 41, gg > 100 && gg < 160, gg, 128)

    // ---------------------------------------------------------------
    var t3: [u8; 44] = "\n== 3. SHRINKING USES EVERY SOURCE PIXEL ==\n"
    say((&t3[0]) as u64, 44)

    // A 64x64 chequerboard of black and white, one pixel per square.
    // Box sampled down to 8x8 every destination pixel covers 8x8 source
    // pixels = 32 white and 32 black -> a flat mid grey.
    let chk: u64 = make(64, 64)
    var y: usize = 0
    while y < 64 {
        var x: usize = 0
        while x < 64 {
            if (x + y) % 2 == 0 {
                put(chk, 64, x, y, 255, 255, 255, 255)
            } else {
                put(chk, 64, x, y, 255, 0, 0, 0)
            }
            x = x + 1
        }
        y = y + 1
    }
    var im3: uiimage.Image = uiimage.image_wrap(chk, 64, 64, 0)
    canvas.canvas_clear(&cv, 4278190080 as u32)
    uiimage.image_draw_rect(&z, &im3, 0.0, 0.0, 8.0, 8.0, 0)

    // Every one of the 64 destination pixels has to be mid grey. The
    // SPREAD is what is measured: nearest neighbour would give 0 and 255.
    var lo: i64 = 255
    var hi: i64 = 0
    y = 0
    while y < 8 {
        var x: usize = 0
        while x < 8 {
            let v: i64 = chan(&cv, x, y, 0)
            if v < lo { lo = v }
            if v > hi { hi = v }
            x = x + 1
        }
        y = y + 1
    }
    var n6: [u8; 49] = "3 a chequerboard shrunk 8x is FLAT (spread small)"
    report((&n6[0]) as u64, 49, (hi - lo) <= 6, hi - lo, 0)
    var n7: [u8; 26] = "3 and it lands on mid grey"
    report((&n7[0]) as u64, 26, near((lo + hi) / 2, 128, 12),
        (lo + hi) / 2, 128)

    // ---------------------------------------------------------------
    var t4: [u8; 31] = "\n== 4. GROWING INTERPOLATES ==\n"
    say((&t4[0]) as u64, 31)

    // 2x2: black left, white right. Grown to 32x32 the middle row must
    // pass through many values -- with nearest neighbour there are two.
    let two: u64 = make(2, 2)
    put(two, 2, 0, 0, 255, 0, 0, 0)
    put(two, 2, 1, 0, 255, 255, 255, 255)
    put(two, 2, 0, 1, 255, 0, 0, 0)
    put(two, 2, 1, 1, 255, 255, 255, 255)
    var im4: uiimage.Image = uiimage.image_wrap(two, 2, 2, 0)
    canvas.canvas_clear(&cv, 4278190080 as u32)
    uiimage.image_draw_rect(&z, &im4, 0.0, 0.0, 32.0, 32.0, 0)

    // Count DISTINCT values along the middle row.
    var seen: [u8; 256] = [0; 256]
    var distinct: i64 = 0
    var x2: usize = 0
    while x2 < 32 {
        let v: i64 = chan(&cv, x2, 16, 0)
        if seen[v as usize] == 0 as u8 {
            seen[v as usize] = 1 as u8
            distinct = distinct + 1
        }
        x2 = x2 + 1
    }
    var n8: [u8; 42] = "4 a 2x2 grown to 32x32 has a real gradient"
    report((&n8[0]) as u64, 42, distinct >= 10, distinct, 10)

    // ---------------------------------------------------------------
    var t5: [u8; 40] = "\n== 5. NOTHING LEAKS OUT OF THE RECT ==\n"
    say((&t5[0]) as u64, 40)

    canvas.canvas_clear(&cv, 0 as u32) // fully transparent
    uiimage.image_draw_rect(&z, &im1, 50.0, 50.0, 20.0, 20.0, 0)
    // one pixel outside on each side must still be untouched
    var out: i64 = 0
    out = out + chan(&cv, 49, 60, 3)
    out = out + chan(&cv, 70, 60, 3)
    out = out + chan(&cv, 60, 49, 3)
    out = out + chan(&cv, 60, 70, 3)
    var n9: [u8; 40] = "5 the four pixels just outside are empty"
    report((&n9[0]) as u64, 40, out == 0, out, 0)
    var n10: [u8; 33] = "5 and inside it really is painted"
    report((&n10[0]) as u64, 33, chan(&cv, 60, 60, 3) == 255,
        chan(&cv, 60, 60, 3), 255)

    // ---------------------------------------------------------------
    var t6: [u8; 33] = "\n== 6. A TINT KEEPS THE SHAPE ==\n"
    say((&t6[0]) as u64, 33)

    // Left half opaque, right half transparent.
    let shp: u64 = make(2, 1)
    put(shp, 2, 0, 0, 255, 255, 255, 255)
    put(shp, 2, 1, 0, 0, 255, 255, 255)
    var im6: uiimage.Image = uiimage.image_wrap(shp, 2, 1, 0)
    canvas.canvas_clear(&cv, 0 as u32)
    // tinted pure green
    uiimage.image_draw_rect(&z, &im6, 0.0, 0.0, 20.0, 10.0, 65280 as u32)
    var n11: [u8; 37] = "6 the tinted half is green, not white"
    report((&n11[0]) as u64, 37,
        chan(&cv, 4, 5, 0) < 20 && chan(&cv, 4, 5, 1) > 235,
        chan(&cv, 4, 5, 1), 255)
    var n12: [u8; 38] = "6 and the transparent half stays empty"
    report((&n12[0]) as u64, 38, chan(&cv, 17, 5, 3) == 0,
        chan(&cv, 17, 5, 3), 0)

    // ---------------------------------------------------------------
    var t7: [u8; 38] = "\n== 7. FIT_CONTAIN KEEPS THE RATIO ==\n"
    say((&t7[0]) as u64, 38)

    // A 4:1 picture in a 40x40 box -> 40x10, centred vertically.
    let wide: u64 = make(4, 1)
    var i4: usize = 0
    while i4 < 4 {
        put(wide, 4, i4, 0, 255, 255, 255, 255)
        i4 = i4 + 1
    }
    var im7: uiimage.Image = uiimage.image_wrap(wide, 4, 1, 0)
    var ox: f64 = 0.0
    var oy: f64 = 0.0
    var ow: f64 = 0.0
    var oh: f64 = 0.0
    uiimage.image_fit(&im7, 0.0, 0.0, 40.0, 40.0, uiimage.FIT_CONTAIN,
        &ox, &oy, &ow, &oh)
    var n13: [u8; 41] = "7 a 4:1 picture in a 40x40 box is 40 wide"
    report((&n13[0]) as u64, 41, near(ow as i64, 40, 0), ow as i64, 40)
    var n14: [u8; 13] = "7 and 10 high"
    report((&n14[0]) as u64, 13, near(oh as i64, 10, 0), oh as i64, 10)
    var n15: [u8; 21] = "7 and centred: y = 15"
    report((&n15[0]) as u64, 21, near(oy as i64, 15, 0), oy as i64, 15)

    painter.painter_free(&z)
    canvas.canvas_free(&cv)

    if G_ERRORS != 0 {
        var bad: [u8; 15] = "\nIMAGE FAILED.\n"
        say((&bad[0]) as u64, 15)
        return 1
    }
    var good: [u8; 15] = "\nIMAGE PASSED.\n"
    say((&good[0]) as u64, 15)
    return 0
}
