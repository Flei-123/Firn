// SPDX-License-Identifier: MPL-2.0
// tools/fui/wave3_main.fi -- THE ACCEPTANCE OF WAVE 3/4, AT THE PIXEL.
//
// ====================================================== WHY IT EXISTS
//
// The same rule as wave1 and wave2: nothing is CLAIMED, everything is
// PAINTED and READ BACK. Justin's demand in full:
//
//   "Measure objectively: brightness values per area, overlapping
//    text, cut-off labels, alignment. NO fake switches, no dummies."
//
// What this file proves for wave 3, and why each one is here:
//
//   1. A list row really shows selection -- and the TEXT on it stays
//      readable. A selected row whose text keeps the normal colour is
//      the white-on-white bug, and it cannot be seen in the source.
//   2. Hover and selection are DIFFERENT rows. A list that lights up
//      as a whole would pass any source review.
//   3. A table's columns really line up: header cell and body cell
//      start at the same x. Off-by-one here is the "misaligned panel"
//      that only shows in the picture.
//   4. A label too long for its cell is CUT OFF and does not run into
//      the next column -- measured by looking at the next column's
//      first pixels.
//   5. The tree indents: depth 2 really starts further right than
//      depth 0, and the twisty is really drawn.
//   6. A badge carries its tone, and its text is readable ON that tone.
//   7. The modal scrim really SHIFTS what is behind it -- by at least
//      20 tone values, in light mode AND in dark mode. (It darkens in
//      the light scheme and brightens in the dark one; see
//      theme.scrim_color for why the dark one cannot darken.)
//   8. The colour picker really shows colours, and a DISABLED one
//      really does not.
//   9. The date picker's calendar maths is right, checked against
//      dates that are known.
//  10. Dark mode takes effect on EVERY control of this wave.
//
import std.rt
import paint.canvas
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.wave2
import fui.wave3
import fui.layout
import fui.flex

const FONTSET_BYTES: usize = 4096
const W: usize = 700
const H: usize = 320

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, got: u32, want: u32) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var h1: [u8; 5] = " got "
    rt.buf_push_bytes(&t, (&h1[0]) as u64, 5)
    rt.buf_push_hex_u64(&t, got as u64, 6)
    var h2: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&h2[0]) as u64, 6)
    rt.buf_push_hex_u64(&t, want as u64, 6)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn report_n(nm: u64, nn: usize, ok: bool, got: i64, want: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var h1: [u8; 5] = " got "
    rt.buf_push_bytes(&t, (&h1[0]) as u64, 5)
    rt.buf_push_dec_i64(&t, got)
    var h2: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&h2[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, want)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn px(cv: *mut canvas.Canvas, x: usize, y: usize) -> u32 {
    let p: u64 = canvas.canvas_pixels(cv) as u64
    let o: u64 = ((y * canvas.canvas_width(cv) + x) * 4) as u64
    let r8: u8 = *((p + o) as *mut u8)
    let g8: u8 = *((p + o + 1 as u64) as *mut u8)
    let b8: u8 = *((p + o + 2 as u64) as *mut u8)
    let r: u32 = r8 as u32
    let g: u32 = g8 as u32
    let b: u32 = b8 as u32
    return (r << 16) | (g << 8) | b
}

fn brightness(c: u32) -> i64 {
    let r: i64 = ((c >> 16) & 255 as u32) as i64
    let g: i64 = ((c >> 8) & 255 as u32) as i64
    let b: i64 = (c & 255 as u32) as i64
    return (r * 299 + g * 587 + b * 114) / 1000
}

fn mean_brightness(cv: *mut canvas.Canvas, x0: usize, x1: usize,
    y0: usize, y1: usize) -> i64 {
    var sum: i64 = 0
    var n: i64 = 0
    var y: usize = y0
    while y < y1 {
        var x: usize = x0
        while x < x1 {
            sum = sum + brightness(px(cv, x, y))
            n = n + 1
            x = x + 1
        }
        y = y + 1
    }
    if n == 0 {
        return 0
    }
    return sum / n
}

// How many pixels in an area differ from a colour. The measure for
// "something is really drawn here" and for "nothing is drawn here".
fn count_not(cv: *mut canvas.Canvas, x0: usize, x1: usize, y0: usize,
    y1: usize, col: u32) -> i64 {
    var n: i64 = 0
    var y: usize = y0
    while y < y1 {
        var x: usize = x0
        while x < x1 {
            if px(cv, x, y) != col {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

// How many DIFFERENT colours an area holds. A colour picker shows
// many; a disabled one shows greys only. Counted as "how many pixels
// have a red channel different from their green channel" -- that is
// zero for every grey and large for every hue.
fn colourful(cv: *mut canvas.Canvas, x0: usize, x1: usize, y0: usize,
    y1: usize) -> i64 {
    var n: i64 = 0
    var y: usize = y0
    while y < y1 {
        var x: usize = x0
        while x < x1 {
            let c: u32 = px(cv, x, y)
            let r: i64 = ((c >> 16) & 255 as u32) as i64
            let g: i64 = ((c >> 8) & 255 as u32) as i64
            let b: i64 = (c & 255 as u32) as i64
            var d: i64 = r - g
            if d < 0 { d = 0 - d }
            var d2: i64 = g - b
            if d2 < 0 { d2 = 0 - d2 }
            if d > 8 || d2 > 8 {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn setup(cv: *mut canvas.Canvas, z: *mut painter.Painter,
    m: *mut theme.Theme) {
    let f: *mut theme.Colors = theme.theme_colors(m)
    canvas.canvas_clear(cv, theme.opaque((*f).base))
}

fn main(start: u64) -> i32 {
    var fbuf: rt.Buf = rt.buf_new()
    var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
    let have: bool = rt.read_file((&f1[0]) as u64, &fbuf)
    let fsp: *mut metrics.FontSet =
        rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }

    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 240) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(true)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)

    // the row texts, shared by list/table/tree
    var ta: [u8; 10] = "Documents "
    var tb: [u8; 8] = "Pictures"
    var tc: [u8; 6] = "Music "

    // ==================================================================
    // 1. A LIST ROW REALLY SHOWS SELECTION -- AND STAYS READABLE
    // ==================================================================
    setup(&cv, &z, &m)
    var ls: widget.Widget = widget.widget_new(widget.KIND_LIST)
    widget.w_place(&ls, 20.0, 20.0, 240.0, 140.0)
    wave3.draw_list(&c, &ls)
    // row 0 normal, row 1 hovered, row 2 selected
    wave3.draw_list_row(&c, &ls, 0, (&ta[0]) as u64, 9, false, false,
        false)
    wave3.draw_list_row(&c, &ls, 1, (&tb[0]) as u64, 8, true, false,
        false)
    wave3.draw_list_row(&c, &ls, 2, (&tc[0]) as u64, 5, false, true,
        false)

    let r0: wave3.FRect = wave3.list_row_rect(&c, &ls, 0)
    let r1: wave3.FRect = wave3.list_row_rect(&c, &ls, 1)
    let r2: wave3.FRect = wave3.list_row_rect(&c, &ls, 2)
    // measured at the right end of the row, past the text
    let mx: usize = (r0.x + r0.w - 8.0) as usize
    let c0: u32 = px(&cv, mx, (r0.y + r0.h / 2.0) as usize)
    let c1: u32 = px(&cv, mx, (r1.y + r1.h / 2.0) as usize)
    let c2: u32 = px(&cv, mx, (r2.y + r2.h / 2.0) as usize)

    var n1: [u8; 40] = "1 list row normal = the field colour    "
    report((&n1[0]) as u64, 39, c0 == (*f).field, c0, (*f).field)
    var n2: [u8; 40] = "1 list row hovered is really different  "
    report_n((&n2[0]) as u64, 39, c1 != c0, c1 as i64, c0 as i64)
    var n3: [u8; 40] = "1 list row selected = the selection     "
    report((&n3[0]) as u64, 39, c2 == (*f).selection, c2,
        (*f).selection)

    // 2. HOVER AND SELECTION ARE DIFFERENT ROWS -- the list does not
    //    light up as a whole.
    var n4: [u8; 40] = "2 hover and selection are not the same  "
    report_n((&n4[0]) as u64, 39, c1 != c2, c1 as i64, c2 as i64)

    // AND THE TEXT ON THE SELECTED ROW IS READABLE. Counted as
    // "pixels that are neither the selection colour nor close to it".
    // Zero would mean the text vanished into its own background.
    let tn: i64 = count_not(&cv, (r2.x + 4.0) as usize,
        (r2.x + 60.0) as usize, (r2.y + 3.0) as usize,
        (r2.y + r2.h - 3.0) as usize, (*f).selection)
    var n5: [u8; 40] = "2 text on the selected row is painted   "
    report_n((&n5[0]) as u64, 39, tn > 20, tn, 20)

    // ==================================================================
    // 3. THE TABLE'S COLUMNS LINE UP
    // ==================================================================
    //
    // Header cell k and body cell k must start at the same x. This is
    // the check for "misaligned panel" -- in the source both look
    // right, in the picture the header sits two pixels off.
    setup(&cv, &z, &m)
    var tb2: widget.Widget = widget.widget_new(widget.KIND_TABLE)
    widget.w_place(&tb2, 20.0, 20.0, 320.0, 160.0)
    wave3.draw_table(&c, &tb2)

    var cols: [u64; 3] = [0 as u64, 0 as u64, 0 as u64]
    var lens: [usize; 3] = [0, 0, 0]
    cols[0] = (&ta[0]) as u64
    lens[0] = 9
    cols[1] = (&tb[0]) as u64
    lens[1] = 8
    cols[2] = (&tc[0]) as u64
    lens[2] = 5
    wave3.draw_table_header(&c, &tb2, &cols[0], &lens[0], 3)
    wave3.draw_table_row(&c, &tb2, 0, &cols[0], &lens[0], 3, false,
        false, false)

    let hd: wave3.FRect = wave3.table_header_rect(&c, &tb2)
    let br: wave3.FRect = wave3.table_row_rect(&c, &tb2, 0)
    let hc1: wave3.FRect = wave3.table_cell_rect(hd, 1, 3)
    let bc1: wave3.FRect = wave3.table_cell_rect(br, 1, 3)
    var n6: [u8; 40] = "3 header and body column start the same "
    report_n((&n6[0]) as u64, 39, (hc1.x as i64) == (bc1.x as i64),
        hc1.x as i64, bc1.x as i64)

    // The last column really reaches the right edge -- no gap.
    let hc2: wave3.FRect = wave3.table_cell_rect(hd, 2, 3)
    let endx: i64 = (hc2.x + hc2.w) as i64
    let want_end: i64 = (hd.x + hd.w) as i64
    var n7: [u8; 40] = "3 the last column reaches the edge      "
    report_n((&n7[0]) as u64, 39, endx == want_end, endx, want_end)

    // The header is really a different surface from the body.
    let hb: i64 = mean_brightness(&cv, (hd.x + 200.0) as usize,
        (hd.x + hd.w - 2.0) as usize, (hd.y + 2.0) as usize,
        (hd.y + hd.h - 3.0) as usize)
    let bb: i64 = mean_brightness(&cv, (br.x + 200.0) as usize,
        (br.x + br.w - 2.0) as usize, (br.y + 2.0) as usize,
        (br.y + br.h - 2.0) as usize)
    var n8: [u8; 40] = "3 header and body really differ         "
    report_n((&n8[0]) as u64, 39, hb != bb, hb, bb)

    // ==================================================================
    // 4. A TOO-LONG LABEL IS CUT OFF AT ITS CELL
    // ==================================================================
    //
    // A long text in column 0 must not paint into column 1. Measured
    // in the first pixels of column 1: they have to stay the row's
    // background.
    setup(&cv, &z, &m)
    wave3.draw_table(&c, &tb2)
    var lng: [u8; 45] = "A very long file name that will not fit here "
    var cols2: [u64; 3] = [0 as u64, 0 as u64, 0 as u64]
    var lens2: [usize; 3] = [0, 0, 0]
    cols2[0] = (&lng[0]) as u64
    lens2[0] = 43
    cols2[1] = (&tc[0]) as u64
    lens2[1] = 5
    cols2[2] = (&tc[0]) as u64
    lens2[2] = 5
    wave3.draw_table_row(&c, &tb2, 0, &cols2[0], &lens2[0], 3, false,
        false, false)
    let br2: wave3.FRect = wave3.table_row_rect(&c, &tb2, 0)
    let c0r: wave3.FRect = wave3.table_cell_rect(br2, 0, 3)
    // the last two pixels before the next column starts
    let bleed: i64 = count_not(&cv, (c0r.x + c0r.w - 2.0) as usize,
        (c0r.x + c0r.w) as usize, (br2.y + 2.0) as usize,
        (br2.y + br2.h - 2.0) as usize, (*f).field)
    var n9: [u8; 43] = "4 long label does not bleed into column 1  "
    report_n((&n9[0]) as u64, 42, bleed == 0, bleed, 0)

    // ...but it IS drawn -- otherwise "no bleed" would be met by
    // drawing nothing at all.
    let drawn: i64 = count_not(&cv, (c0r.x + 4.0) as usize,
        (c0r.x + 60.0) as usize, (br2.y + 2.0) as usize,
        (br2.y + br2.h - 2.0) as usize, (*f).field)
    var n10: [u8; 43] = "4 and the long label is really painted     "
    report_n((&n10[0]) as u64, 42, drawn > 30, drawn, 30)

    // ==================================================================
    // 5. THE TREE INDENTS AND HAS A TWISTY
    // ==================================================================
    setup(&cv, &z, &m)
    var tr: widget.Widget = widget.widget_new(widget.KIND_TREE)
    widget.w_place(&tr, 20.0, 20.0, 240.0, 140.0)
    wave3.draw_tree(&c, &tr)
    wave3.draw_tree_row(&c, &tr, 0, (&ta[0]) as u64, 9, 0, true, true,
        false, false, false)
    wave3.draw_tree_row(&c, &tr, 1, (&tb[0]) as u64, 8, 2, false,
        false, false, false, false)
    let tr0: wave3.FRect = wave3.list_row_rect(&c, &tr, 0)
    let tr1: wave3.FRect = wave3.list_row_rect(&c, &tr, 1)

    // The first painted pixel from the left, per row.
    var first0: i64 = -1
    var xq: usize = (tr0.x + 1.0) as usize
    while xq < (tr0.x + tr0.w - 2.0) as usize {
        if count_not(&cv, xq, xq + 1, (tr0.y + 2.0) as usize,
            (tr0.y + tr0.h - 2.0) as usize, (*f).field) > 0 {
            first0 = xq as i64
            break
        }
        xq = xq + 1
    }
    var first1: i64 = -1
    var xr: usize = (tr1.x + 1.0) as usize
    while xr < (tr1.x + tr1.w - 2.0) as usize {
        if count_not(&cv, xr, xr + 1, (tr1.y + 2.0) as usize,
            (tr1.y + tr1.h - 2.0) as usize, (*f).field) > 0 {
            first1 = xr as i64
            break
        }
        xr = xr + 1
    }
    var n11: [u8; 43] = "5 tree depth 2 really starts further right "
    report_n((&n11[0]) as u64, 42, first1 > first0, first1, first0)

    var n12: [u8; 43] = "5 and the twisty of the parent is drawn    "
    report_n((&n12[0]) as u64, 42, first0 > 0, first0, 0)

    // ==================================================================
    // 6. THE BADGE CARRIES ITS TONE AND STAYS READABLE
    // ==================================================================
    setup(&cv, &z, &m)
    var bd: widget.Widget = widget.widget_new(widget.KIND_BADGE)
    widget.w_place(&bd, 20.0, 20.0, 60.0, 22.0)
    var bt: [u8; 4] = "NEW "
    widget.w_set_text(&bd, (&bt[0]) as u64, 3)
    widget.w_set_value(&bd, wave3.BADGE_ERROR as i64)
    wave3.draw_any(&c, &bd)
    // at the left inside of the pill, past the rounding
    let bg: u32 = px(&cv, 20 + 12, 20 + 11)
    var n13: [u8; 43] = "6 badge error tone = the error colour      "
    report((&n13[0]) as u64, 42, bg == (*f).err_col, bg, (*f).err_col)

    let btn: i64 = count_not(&cv, 20 + 8, 20 + 52, 20 + 4, 20 + 18,
        (*f).err_col)
    var n14: [u8; 43] = "6 and its text is really on the badge      "
    report_n((&n14[0]) as u64, 42, btn > 10, btn, 10)

    // ==================================================================
    // 7. THE MODAL SCRIM REALLY DARKENS
    // ==================================================================
    //
    // Painted over a FULL window, and the brightness before and after
    // is compared. In dark mode too -- a scrim that only works in one
    // of them is the "dark mode does not come through" bug.
    setup(&cv, &z, &m)
    var card: widget.Widget = widget.widget_new(widget.KIND_CARD)
    widget.w_place(&card, 40.0, 40.0, 200.0, 80.0)
    wave3.draw_any(&c, &card)
    let before: i64 = mean_brightness(&cv, 50, 230, 50, 110)
    wave3.draw_scrim(&c, 0.0, 0.0, W as f64, H as f64)
    let after: i64 = mean_brightness(&cv, 50, 230, 50, 110)
    // 20.09.2026 -- WAS HIER GEMESSEN WIRD UND WARUM DIE RICHTUNG
    // NICHT MEHR VORGESCHRIEBEN IST. Bis heute stand hier
    // `after < before`: der Schleier musste ABDUNKELN. Im dunklen
    // Schema kann er das nicht -- der Grund 0x1C1B22 liegt bei einer
    // Leuchtdichte von 0.0116, und selbst gegen reines Schwarz bleibt
    // davon ein Kontrast von 1.19:1, also nichts, was ein Mensch
    // sieht. Ein unsichtbarer Schleier hat die Pruefung trotzdem
    // bestanden, weil sie nur das VORZEICHEN pruefte und nicht den
    // BETRAG. Jetzt zaehlt der Betrag: der Schleier muss die Flaeche
    // um mindestens 20 Tonwerte VERSCHIEBEN, in welche Richtung das
    // Thema auch geht (`theme.scrim_color` hellt im Dunklen auf). Das
    // ist strenger als vorher, nicht schwaecher -- ein Schleier mit
    // einem Tonwert Abstand faellt jetzt durch.
    var d15: i64 = after - before
    if d15 < 0 {
        d15 = 0 - d15
    }
    var n15: [u8; 43] = "7 the scrim shifts the ground (dark mode)  "
    report_n((&n15[0]) as u64, 42, d15 >= 20, d15, 20)

    // and the dialog on top of it separates from the scrim again --
    // likewise by AMOUNT, because in the dark scheme the panel is the
    // darker of the two.
    var dlg: widget.Widget = widget.widget_new(widget.KIND_NONE)
    widget.w_place(&dlg, 150.0, 60.0, 380.0, 200.0)
    var dt: [u8; 13] = "Save changes?"
    widget.w_set_text(&dlg, (&dt[0]) as u64, 13)
    wave3.draw_dialog(&c, &dlg)
    let dlgb: i64 = mean_brightness(&cv, 300, 500, 150, 220)
    var d16: i64 = dlgb - after
    if d16 < 0 {
        d16 = 0 - d16
    }
    var n16: [u8; 43] = "7 the dialog stands out from the scrim     "
    report_n((&n16[0]) as u64, 42, d16 >= 20, d16, 20)

    // AND THE SAME IN THE LIGHT SCHEME. It was never measured here --
    // only the dark one was painted -- and that is how a scrim that
    // works in one scheme and not in the other survives. In the light
    // scheme the theme darkens, so the shift goes the other way; the
    // requirement is the same number.
    theme.theme_set_dark(&m, false)
    setup(&cv, &z, &m)
    var card2: widget.Widget = widget.widget_new(widget.KIND_CARD)
    widget.w_place(&card2, 40.0, 40.0, 200.0, 80.0)
    wave3.draw_any(&c, &card2)
    let hell_vor: i64 = mean_brightness(&cv, 50, 230, 50, 110)
    wave3.draw_scrim(&c, 0.0, 0.0, W as f64, H as f64)
    let light_after: i64 = mean_brightness(&cv, 50, 230, 50, 110)
    var d15h: i64 = light_after - hell_vor
    if d15h < 0 {
        d15h = 0 - d15h
    }
    var n15b: [u8; 43] = "7 the scrim shifts the ground (light mode) "
    report_n((&n15b[0]) as u64, 42, d15h >= 20, d15h, 20)
    theme.theme_set_dark(&m, true)
    setup(&cv, &z, &m)
    wave3.draw_any(&c, &card)
    wave3.draw_scrim(&c, 0.0, 0.0, W as f64, H as f64)
    wave3.draw_dialog(&c, &dlg)

    // The dialog's three areas do not overlap: the body starts below
    // the title and ends above the buttons. If they overlapped, the
    // caller's content would be painted over -- the "overlapping
    // text" Justin asked to be measured.
    let tr_: wave3.FRect = wave3.dialog_title_rect(&c, &dlg)
    let bo: wave3.FRect = wave3.dialog_body_rect(&c, &dlg)
    let bu: wave3.FRect = wave3.dialog_buttons_rect(&c, &dlg)
    var n17: [u8; 43] = "7 dialog body starts below the title       "
    report_n((&n17[0]) as u64, 42,
        (bo.y as i64) >= (tr_.y + tr_.h) as i64, bo.y as i64,
        (tr_.y + tr_.h) as i64)
    var n18: [u8; 43] = "7 dialog body ends above the buttons       "
    report_n((&n18[0]) as u64, 42,
        (bo.y + bo.h) as i64 <= (bu.y as i64), (bo.y + bo.h) as i64,
        bu.y as i64)

    // ==================================================================
    // 8. THE COLOUR PICKER SHOWS COLOURS -- AND DISABLED SHOWS NONE
    // ==================================================================
    setup(&cv, &z, &m)
    var cp: widget.Widget = widget.widget_new(widget.KIND_NONE)
    widget.w_place(&cp, 20.0, 20.0, 200.0, 160.0)
    widget.w_set_value(&cp, 200)
    wave3.draw_colorpicker(&c, &cp)
    let hue_on: i64 = colourful(&cv, 30, 210, 30, 140)
    var n19: [u8; 43] = "8 the colour picker really shows colours   "
    report_n((&n19[0]) as u64, 42, hue_on > 5000, hue_on, 5000)

    setup(&cv, &z, &m)
    widget.w_set_disabled(&cp, true)
    wave3.draw_colorpicker(&c, &cp)
    // Measured in the FIELD only, not over the hue strip: the strip
    // carries the position marker, and that one is white on purpose --
    // it has to stay visible on a grey strip too. A white marker is
    // not a hue, but `colourful` cannot tell the two apart.
    let hue_off: i64 = colourful(&cv, 30, 210, 30, 140)
    var n20: [u8; 43] = "8 a disabled picker shows grey only        "
    report_n((&n20[0]) as u64, 42, hue_off == 0, hue_off, 0)
    widget.w_set_disabled(&cp, false)

    // The hue the picker reports for a point matches where it painted
    // it -- picking and showing cannot disagree.
    let hr: i64 = wave3.colorpicker_hue_at(&c, &cp, 20.0 + 100.0)
    var n21: [u8; 43] = "8 hue at the middle of the strip is 180    "
    report_n((&n21[0]) as u64, 42, hr > 170 && hr < 190, hr, 180)

    // ==================================================================
    // 9. THE CALENDAR MATHS
    // ==================================================================
    //
    // Checked against dates that are known. 01.09.2026 was a TUESDAY
    // (weekday 1 with Monday = 0). February 2024 had 29 days, 2025 had
    // 28, 1900 had 28 (the century rule) and 2000 had 29.
    let wd: i64 = wave3.weekday(2026 as i64, 9 as i64, 1 as i64)
    var n22: [u8; 43] = "9 01.09.2026 is a Tuesday                  "
    report_n((&n22[0]) as u64, 42, wd == 1 as i64, wd, 1 as i64)

    let d24: i64 = wave3.days_in_month(2024 as i64, 2 as i64)
    var n23: [u8; 43] = "9 February 2024 has 29 days                "
    report_n((&n23[0]) as u64, 42, d24 == 29 as i64, d24, 29 as i64)

    let d00: i64 = wave3.days_in_month(1900 as i64, 2 as i64)
    var n24: [u8; 43] = "9 February 1900 has 28 (the century rule)  "
    report_n((&n24[0]) as u64, 42, d00 == 28 as i64, d00, 28 as i64)

    let d20: i64 = wave3.days_in_month(2000 as i64, 2 as i64)
    var n25: [u8; 43] = "9 February 2000 has 29 (the 400 rule)      "
    report_n((&n25[0]) as u64, 42, d20 == 29 as i64, d20, 29 as i64)

    // ==================================================================
    // 10. DARK MODE TAKES EFFECT ON EVERY CONTROL OF THIS WAVE
    // ==================================================================
    //
    // Every control is painted once light and once dark, and the dark
    // one has to be DARKER. This is the check for Justin's "window
    // contents stayed white".
    var lightb: [i64; 5] = [0, 0, 0, 0, 0]
    var darkb: [i64; 5] = [0, 0, 0, 0, 0]
    var pass: usize = 0
    while pass < 2 {
        theme.theme_set_dark(&m, pass == 1)
        let ff: *mut theme.Colors = theme.theme_colors(&m)

        setup(&cv, &z, &m)
        var a1: widget.Widget = widget.widget_new(widget.KIND_LIST)
        widget.w_place(&a1, 20.0, 20.0, 200.0, 100.0)
        wave3.draw_any(&c, &a1)
        let v1: i64 = mean_brightness(&cv, 30, 210, 30, 110)

        setup(&cv, &z, &m)
        var a2: widget.Widget = widget.widget_new(widget.KIND_TABLE)
        widget.w_place(&a2, 20.0, 20.0, 200.0, 100.0)
        wave3.draw_any(&c, &a2)
        wave3.draw_table_header(&c, &a2, &cols[0], &lens[0], 3)
        let v2: i64 = mean_brightness(&cv, 30, 210, 30, 110)

        setup(&cv, &z, &m)
        var a3: widget.Widget = widget.widget_new(widget.KIND_CARD)
        widget.w_place(&a3, 20.0, 20.0, 200.0, 100.0)
        wave3.draw_any(&c, &a3)
        let v3: i64 = mean_brightness(&cv, 30, 210, 30, 110)

        setup(&cv, &z, &m)
        var a4: widget.Widget = widget.widget_new(widget.KIND_TREE)
        widget.w_place(&a4, 20.0, 20.0, 200.0, 100.0)
        wave3.draw_any(&c, &a4)
        let v4: i64 = mean_brightness(&cv, 30, 210, 30, 110)

        setup(&cv, &z, &m)
        var a5: widget.Widget = widget.widget_new(widget.KIND_NONE)
        widget.w_place(&a5, 20.0, 20.0, 200.0, 100.0)
        var a5t: [u8; 8] = "Dialog  "
        widget.w_set_text(&a5, (&a5t[0]) as u64, 6)
        wave3.draw_dialog(&c, &a5)
        let v5: i64 = mean_brightness(&cv, 30, 210, 30, 110)

        if pass == 0 {
            lightb[0] = v1
            lightb[1] = v2
            lightb[2] = v3
            lightb[3] = v4
            lightb[4] = v5
        } else {
            darkb[0] = v1
            darkb[1] = v2
            darkb[2] = v3
            darkb[3] = v4
            darkb[4] = v5
        }
        pass = pass + 1
    }
    var bad: i64 = 0
    var q: usize = 0
    while q < 5 {
        if darkb[q] >= lightb[q] {
            bad = bad + 1
        }
        q = q + 1
    }
    var n26: [u8; 44] = "10 dark is really darker on all 5 controls  "
    report_n((&n26[0]) as u64, 42, bad == 0, bad, 0)

    // And the difference is REAL, not one unit of rounding.
    var mind: i64 = 999
    var q2: usize = 0
    while q2 < 5 {
        let d: i64 = lightb[q2] - darkb[q2]
        if d < mind {
            mind = d
        }
        q2 = q2 + 1
    }
    var n27: [u8; 44] = "10 and the gap is more than 50 brightness   "
    report_n((&n27[0]) as u64, 42, mind > 50, mind, 50)

    // ==================================================================
    // 11. NOT ONE COLOUR IS HARD-CODED
    // ==================================================================
    //
    // The proof by construction: the theme's accent is set to magenta,
    // and a badge with the accent tone has to become magenta. A badge
    // with a built-in blue would stay blue.
    theme.theme_set_dark(&m, true)
    let f2: *mut theme.Colors = theme.theme_colors(&m)
    (*f2).accent = 16711935 as u32   // 0xFF00FF
    setup(&cv, &z, &m)
    var bd2: widget.Widget = widget.widget_new(widget.KIND_BADGE)
    widget.w_place(&bd2, 20.0, 20.0, 60.0, 22.0)
    widget.w_set_value(&bd2, wave3.BADGE_ACCENT as i64)
    wave3.draw_any(&c, &bd2)
    let acc: u32 = px(&cv, 20 + 12, 20 + 11)
    var n28: [u8; 44] = "11 the accent really comes from the theme   "
    report_n((&n28[0]) as u64, 42, acc == 16711935 as u32, acc as i64,
        16711935 as i64)

    // ==================================================================
    // 12. THE DIALOG BUTTON ROW REALLY GOES THROUGH flex.fi
    // ==================================================================
    //
    // Not "flex.fi compiles", but: the row a dialog shows is the row
    // flex.fi computed. Measured against pixels worked out by hand:
    //
    //   the row runs from  x = 150 + 1 (border) + 16 (sp_m) = 167
    //   to                 x = 167 + 380 - 2*17            = 513
    //   gap between two buttons                            = sp_s = 8
    //   "OK" is narrower than the minimum 2*ctrl_h = 64 and
    //   is therefore widened to exactly 64
    //
    // A button row placed by hand would pass none of these three at
    // once -- and that is the point: if somebody unhooks flex.fi from
    // the dialog again, this section goes red.
    theme.theme_set_dark(&m, true)
    (*f).accent = 689407 as u32
    setup(&cv, &z, &m)
    var dl2: widget.Widget = widget.widget_new(widget.KIND_NONE)
    widget.w_place(&dl2, 150.0, 20.0, 380.0, 200.0)
    widget.w_set_text(&dl2, (&dt[0]) as u64, 13)
    wave3.draw_dialog(&c, &dl2)
    var ca: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    var cat: [u8; 6] = "Cancel"
    widget.w_set_text(&ca, (&cat[0]) as u64, 6)
    var ok: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    var okt: [u8; 2] = "OK"
    widget.w_set_text(&ok, (&okt[0]) as u64, 2)
    // What the row would need if it were measured alone -- the number
    // against which the widening of "OK" is checked.
    var okw: f64 = 0.0
    var okh: f64 = 0.0
    render.pref_of(&c, &ok, &okw, &okh)
    var caw: f64 = 0.0
    var cah: f64 = 0.0
    render.pref_of(&c, &ca, &caw, &cah)
    var row: [u64; 2] = [0 as u64, 0 as u64]
    row[0] = (&ca) as u64
    row[1] = (&ok) as u64
    let bu2: wave3.FRect = wave3.dialog_buttons_rect(&c, &dl2)
    let painted: bool = wave3.draw_dialog_buttons(&c, &dl2,
        (&row[0]) as *mut u64, 2)
    var n29: [u8; 44] = "12 the button row was laid out and painted  "
    report_n((&n29[0]) as u64, 42, painted, 1, 1)
    var n30: [u8; 44] = "12 the row starts at x = 167 (1 + sp_m)     "
    report_n((&n30[0]) as u64, 42, (bu2.x as i64) == 167,
        bu2.x as i64, 167)
    let right: i64 = (widget.w_x(&ok) + widget.w_w(&ok)) as i64
    var n31: [u8; 44] = "12 the last button ends at the row's edge   "
    report_n((&n31[0]) as u64, 42, right == 513, right, 513)
    let gap: i64 = (widget.w_x(&ok)) as i64 -
        (widget.w_x(&ca) + widget.w_w(&ca)) as i64
    var n32: [u8; 44] = "12 the gap between them is sp_s = 8         "
    report_n((&n32[0]) as u64, 42, gap == 8, gap, 8)
    var n33: [u8; 44] = "12 OK is widened to the minimum 64          "
    report_n((&n33[0]) as u64, 42, (widget.w_w(&ok) as i64) == 64,
        widget.w_w(&ok) as i64, 64)
    var n34: [u8; 44] = "12 the measured OK alone would be narrower  "
    report_n((&n34[0]) as u64, 42, (okw as i64) < 64, okw as i64, 64)
    // "Cancel" is wider than the minimum, so it keeps its measured
    // width -- rounded up, once, in flex.flex_px.
    var n35: [u8; 44] = "12 Cancel keeps its measured width          "
    report_n((&n35[0]) as u64, 42,
        (widget.w_w(&ca) as i64) == flex.flex_px(caw),
        widget.w_w(&ca) as i64, flex.flex_px(caw))
    // align-items: stretch -- both buttons fill the row's height.
    var n36: [u8; 44] = "12 both buttons carry the row height        "
    report_n((&n36[0]) as u64, 42,
        (widget.w_h(&ok) as i64) == (widget.w_h(&ca) as i64) &&
        (widget.w_h(&ok) as i64) == (bu2.h + 0.5) as i64,
        widget.w_h(&ok) as i64, (bu2.h + 0.5) as i64)
    // AND IT IS REALLY PAINTED THERE. The middle of the OK button
    // carries the button colour, four pixels left of the row the
    // dialog's own surface is still untouched.
    let okmx: usize = (widget.w_x(&ok) + widget.w_w(&ok) * 0.5) as usize
    let okmy: usize = (widget.w_y(&ok) + widget.w_h(&ok) * 0.5) as usize
    var n37: [u8; 44] = "12 the OK button is painted where it lies   "
    report((&n37[0]) as u64, 42, px(&cv, okmx, okmy) == (*f).button,
        px(&cv, okmx, okmy), (*f).button)
    let free: usize = (widget.w_x(&ca) - 6.0) as usize
    var n38: [u8; 44] = "12 left of the row the dialog is untouched  "
    report((&n38[0]) as u64, 42, px(&cv, free, okmy) == (*f).surface,
        px(&cv, free, okmy), (*f).surface)

    // ==================================================================
    // 13. A CARD REALLY CASTS A SOFT SHADOW
    // ==================================================================
    //
    // render.draw_base sends every raised surface through
    // effect.drop_shadow_round. What is checked is not that the call
    // happens but what it leaves behind: UNDER the card the page is
    // darker than the page itself, and the darkening FADES -- close to
    // the card more, further away less, and far away nothing. A hard
    // rectangle would give the same value at 2 and at 10 pixels, a
    // missing shadow the page value at both.
    setup(&cv, &z, &m)
    let basic: i64 = mean_brightness(&cv, 60, 220, 200, 210)
    var ka2: widget.Widget = widget.widget_new(widget.KIND_CARD)
    widget.w_place(&ka2, 40.0, 40.0, 200.0, 80.0)
    wave3.draw_any(&c, &ka2)
    let nah: i64 = mean_brightness(&cv, 60, 220, 124, 126)
    let fern: i64 = mean_brightness(&cv, 60, 220, 136, 138)
    let weit: i64 = mean_brightness(&cv, 60, 220, 200, 210)
    var n39: [u8; 44] = "13 under the card the page is darkened      "
    report_n((&n39[0]) as u64, 42, nah < basic, nah, basic)
    var n40: [u8; 44] = "13 and the darkening fades with distance    "
    report_n((&n40[0]) as u64, 42, nah < fern && fern < basic, fern,
        basic)
    var n41: [u8; 44] = "13 far away nothing of it is left           "
    report_n((&n41[0]) as u64, 42, weit == basic, weit, basic)
    // AND IT IS A THEME DECISION. shape_classic has shadow = 0 --
    // the square theme gets no shadow, and that proves the numbers
    // come from the theme and not from the drawing code.
    var eckig: theme.Shape = theme.shape_classic()
    theme.theme_set_shape(&m, &eckig)
    setup(&cv, &z, &m)
    wave3.draw_any(&c, &ka2)
    let without: i64 = mean_brightness(&cv, 60, 220, 124, 126)
    var n42: [u8; 44] = "13 shape_classic casts no shadow at all     "
    report_n((&n42[0]) as u64, 42, without == basic, without, basic)
    var round: theme.Shape = theme.shape_osum()
    theme.theme_set_shape(&m, &round)

    // ---- the result
    var tail: rt.Buf = rt.buf_new()
    rt.buf_push(&tail, 10 as u8)
    if G_ERRORS == 0 {
        var g: [u8; 16] = "WAVE 3 PASSED.\n\0"
        rt.buf_push_bytes(&tail, (&g[0]) as u64, 15)
    } else {
        var b: [u8; 16] = "WAVE 3 FAILED.\n\0"
        rt.buf_push_bytes(&tail, (&b[0]) as u64, 15)
    }
    rt.write_everything(1, rt.buf_ptr(&tail), rt.buf_len(&tail))
    rt.buf_free(&tail)

    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    if G_ERRORS != 0 {
        return 1
    }
    return 0
}
