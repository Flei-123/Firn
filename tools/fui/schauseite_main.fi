// SPDX-License-Identifier: GPL-2.0-only
// tools/fui/schauseite_main.fi -- fUi ZEIGT SICH SELBST.
//
// ====================================================== WARUM ES SIE GIBT
//
// Justins Forderung: "EINE SCHAUSEITE, die jedes fertige Element in
// allen Zustaenden zeigt, hell und dunkel -- ein einziges Programm, das
// man startet und alles sieht."
//
// Sie ist zweierlei zugleich: Justins Vorschau und unsere Abnahme. Ein
// Element, das hier nicht auftaucht, gilt als nicht fertig.
//
//     schauseite_main <aus.png> [hell|dunkel] [<schrift.ttf>]
//
// Gemalt wird OHNE Fenster -- direkt auf eine Leinwand und als PNG
// heraus. Damit laeuft die Abnahme auf einem Server ohne Bildschirm,
// und die Bilder sind bildpunktgenau vergleichbar.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.marke
import fui.stil
import fui.element
import fui.zeichnen
import fui.male
import fui.anordnung
import fui.kern

const FONTSET_BYTES: usize = 4096
const W: usize = 1200
const H: usize = 760

// Ein Element anlegen, legen, beschriften -- der immer gleiche
// Dreisatz, damit die Schauseite selbst lesbar bleibt.
fn mach(art: u32, x: f64, y: f64, w: f64, h: f64, p: u64,
    n: usize) -> element.Element {
    var e: element.Element = element.element_neu(art)
    element.el_lege(&e, x, y, w, h)
    element.el_setz_text(&e, p, n)
    return e
}

// Eine Ueberschrift ueber einen Abschnitt.
fn kopf(c: *mut male.Ctx, x: f64, y: f64, p: u64, n: usize) {
    var e: element.Element = mach(element.AR_BESCHRIFTUNG, x, y,
        400.0, 20.0, p, n)
    let s: *mut stil.Stil = element.el_stil(&e)
    *s = stil.stil_setz_textfarbe(*s, stil.farb_token(stil.TK_TEXT_BLASS))
    *s = stil.stil_setz_font(*s, 0, 12)
    male.male_beschriftung(c, &e)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 52] = "schauseite_main <aus.png> [hell|dunkel] [font.ttf]\n\0"
        rt.write_everything(2, (&u[0]) as u64, 50)
        return 2
    }
    let pfad: u64 = rt.arg_ptr(start, 1)
    var dunkel: bool = true
    if rt.arg_count(start) >= 3 {
        if rt.ld8(rt.arg_ptr(start, 2), 0) == 104 as u8 {
            dunkel = false
        }
    }

    // ---- die Schrift
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
        rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }

    // ---- Leinwand, Zeichner, Marke
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: zeichnen.Zeichner = zeichnen.zeichner_neu()
    if !zeichnen.zeichner_init(&z, &cv, 1200, 120) {
        return 5
    }
    zeichnen.zeichner_setz_schrift(&z, fm)
    var m: marke.Marke = marke.marke_neu(dunkel)
    var c: male.Ctx = male.ctx_neu(&m, &z)
    let f: *mut marke.Farben = marke.marke_farben(&m)
    canvas.canvas_clear(&cv, marke.deck((*f).grund))

    let ch: f64 = 32.0
    let bw: f64 = 150.0
    var y: f64 = 24.0

    // ==================================================================
    // ABSCHNITT 1: DER KNOPF IN ALLEN FUENF ZUSTAENDEN
    // ==================================================================
    var t_k1: [u8; 40] = "KNOPF -- die fuenf Zustaende            "
    kopf(&c, 24.0, y, (&t_k1[0]) as u64, 32)
    y = y + 26.0

    var t_norm: [u8; 6] = "Normal"
    var t_ueb: [u8; 9] = "Ueberfahr"
    var t_dru: [u8; 9] = "Gedrueckt"
    var t_fok: [u8; 10] = "Fokussiert"
    var t_sp: [u8; 8] = "Gesperrt"
    var x: f64 = 24.0

    var k1: element.Element = mach(element.AR_KNOPF, x, y, bw, ch,
        (&t_norm[0]) as u64, 6)
    male.male_element(&c, &k1)
    x = x + bw + 12.0

    var k2: element.Element = mach(element.AR_KNOPF, x, y, bw, ch,
        (&t_ueb[0]) as u64, 9)
    element.el_setz_ueber(&k2, true)
    male.male_element(&c, &k2)
    x = x + bw + 12.0

    var k3: element.Element = mach(element.AR_KNOPF, x, y, bw, ch,
        (&t_dru[0]) as u64, 9)
    element.el_setz_druck(&k3, true)
    male.male_element(&c, &k3)
    x = x + bw + 12.0

    var k4: element.Element = mach(element.AR_KNOPF, x, y, bw, ch,
        (&t_fok[0]) as u64, 10)
    element.el_setz_fokus(&k4, true)
    male.male_element(&c, &k4)
    x = x + bw + 12.0

    var k5: element.Element = mach(element.AR_KNOPF, x, y, bw, ch,
        (&t_sp[0]) as u64, 8)
    element.el_setz_sperr(&k5, true)
    male.male_element(&c, &k5)

    // ==================================================================
    // ABSCHNITT 2: DIE FUENF STILVARIANTEN
    // ==================================================================
    y = y + ch + 34.0
    var t_s1: [u8; 46] = "STIL -- dasselbe Element, fuenf Gestaltungen  "
    kopf(&c, 24.0, y, (&t_s1[0]) as u64, 44)
    y = y + 26.0

    // Eine Tafel darunter, damit "kein Hintergrund" SICHTBAR wird:
    // ueber einer eigenen Flaeche sieht man, dass nichts gemalt wird.
    // Die Tafel geht genau ueber die sechs Varianten. Sie ist der
    // BEWEIS fuer "kein Hintergrund": wo nichts gemalt wird, steht
    // hinterher die TAFELfarbe -- nicht die Fensterfarbe. Waere
    // `transparent` in Wahrheit "male Fensterfarbe drueber" (Justins
    // Punkt 4), stuende hier ein heller Fleck im dunklen Feld.
    zeichnen.rund(&z, 16.0, y - 8.0, 980.0, ch + 16.0,
        marke.marke_px(&m, 10) as f64, (*f).flaeche_hoch)

    var t_v1: [u8; 14] = "kein Hintergr."
    var t_v2: [u8; 13] = "nur bei hover"
    var t_v3: [u8; 10] = "rot fest  "
    var t_v4: [u8; 11] = "Theme-Token"
    var t_v5: [u8; 12] = "eigener Font"
    x = 24.0

    // 1 -- kein Hintergrund
    var v1: element.Element = mach(element.AR_KNOPF, x, y, bw, ch,
        (&t_v1[0]) as u64, 14)
    let sv1: *mut stil.Stil = element.el_stil(&v1)
    *sv1 = stil.stil_setz_hg(*sv1, stil.farb_transparent())
    male.male_element(&c, &v1)
    x = x + bw + 12.0

    // 2 -- Hintergrund NUR bei hover. Zweimal gezeigt: aus und an.
    var v2: element.Element = mach(element.AR_KNOPF, x, y, bw, ch,
        (&t_v2[0]) as u64, 13)
    let sv2: *mut stil.Stil = element.el_stil(&v2)
    *sv2 = stil.stil_setz_hg(*sv2, stil.farb_transparent())
    stil.satz_setz_ueber(element.el_satz(&v2), stil.ZU_UEBER,
        stil.ueber_setz_hg(stil.ueber_neu(),
            stil.farb_token(stil.TK_AKZENT)))
    male.male_element(&c, &v2)
    x = x + bw + 12.0

    var v2b: element.Element = mach(element.AR_KNOPF, x, y, bw, ch,
        (&t_v2[0]) as u64, 13)
    let sv2b: *mut stil.Stil = element.el_stil(&v2b)
    *sv2b = stil.stil_setz_hg(*sv2b, stil.farb_transparent())
    *sv2b = stil.stil_setz_textfarbe(*sv2b,
        stil.farb_token(stil.TK_TEXT_AUF_AKZENT))
    stil.satz_setz_ueber(element.el_satz(&v2b), stil.ZU_UEBER,
        stil.ueber_setz_hg(stil.ueber_neu(),
            stil.farb_token(stil.TK_AKZENT)))
    element.el_setz_ueber(&v2b, true)
    male.male_element(&c, &v2b)
    x = x + bw + 12.0

    // 3 -- feste rote Fuellung, weisser Text
    var v3: element.Element = mach(element.AR_KNOPF, x, y, bw, ch,
        (&t_v3[0]) as u64, 8)
    let sv3: *mut stil.Stil = element.el_stil(&v3)
    *sv3 = stil.stil_setz_hg(*sv3, stil.farb_literal(13976616 as u32))
    *sv3 = stil.stil_setz_textfarbe(*sv3,
        stil.farb_literal(16777215 as u32))
    male.male_element(&c, &v3)
    x = x + bw + 12.0

    // 4 -- Theme-Token
    var v4: element.Element = mach(element.AR_KNOPF, x, y, bw, ch,
        (&t_v4[0]) as u64, 11)
    let sv4: *mut stil.Stil = element.el_stil(&v4)
    *sv4 = stil.stil_setz_hg(*sv4, stil.farb_token(stil.TK_AKZENT))
    *sv4 = stil.stil_setz_textfarbe(*sv4,
        stil.farb_token(stil.TK_TEXT_AUF_AKZENT))
    male.male_element(&c, &v4)
    x = x + bw + 12.0

    // 5 -- eigene Schriftfarbe, groesser, fett, Rahmen statt Fuellung
    var v5: element.Element = mach(element.AR_KNOPF, x, y, bw, ch,
        (&t_v5[0]) as u64, 12)
    let sv5: *mut stil.Stil = element.el_stil(&v5)
    *sv5 = stil.stil_setz_hg(*sv5, stil.farb_transparent())
    *sv5 = stil.stil_setz_rahmen(*sv5, stil.farb_token(stil.TK_AKZENT), 2)
    *sv5 = stil.stil_setz_textfarbe(*sv5, stil.farb_token(stil.TK_AKZENT))
    *sv5 = stil.stil_setz_font(*sv5, 0, 17)
    male.male_element(&c, &v5)

    // ==================================================================
    // ABSCHNITT 3: BESCHRIFTUNGEN
    // ==================================================================
    y = y + ch + 34.0
    var t_b1: [u8; 46] = "BESCHRIFTUNG -- Ausrichtung und Schriftgroesse"
    kopf(&c, 24.0, y, (&t_b1[0]) as u64, 44)
    y = y + 26.0

    var t_li: [u8; 5] = "links"
    var t_mi: [u8; 6] = "mittig"
    var t_re: [u8; 6] = "rechts"
    // Eine Tafel als Grund, damit man die Ausrichtung im Kasten sieht.
    zeichnen.rund(&z, 24.0, y, 360.0, ch, 6.0, (*f).flaeche_hoch)
    var b1: element.Element = mach(element.AR_BESCHRIFTUNG, 24.0, y,
        360.0, ch, (&t_li[0]) as u64, 5)
    let sb1: *mut stil.Stil = element.el_stil(&b1)
    *sb1 = stil.stil_setz_pad(*sb1, 12, 0)
    male.male_element(&c, &b1)
    var b2: element.Element = mach(element.AR_BESCHRIFTUNG, 24.0, y,
        360.0, ch, (&t_mi[0]) as u64, 6)
    let sb2: *mut stil.Stil = element.el_stil(&b2)
    *sb2 = stil.stil_setz_ausricht(*sb2, stil.AUS_MITTE)
    male.male_element(&c, &b2)
    var b3: element.Element = mach(element.AR_BESCHRIFTUNG, 24.0, y,
        360.0, ch, (&t_re[0]) as u64, 6)
    let sb3: *mut stil.Stil = element.el_stil(&b3)
    *sb3 = stil.stil_setz_ausricht(*sb3, stil.AUS_RECHTS)
    *sb3 = stil.stil_setz_pad(*sb3, 12, 0)
    male.male_element(&c, &b3)

    // Groessen
    var t_gr: [u8; 8] = "12 15 20"
    var xg: f64 = 420.0
    var gi: usize = 0
    var groessen: [usize; 3] = [12, 15, 20]
    while gi < 3 {
        var bg: element.Element = mach(element.AR_BESCHRIFTUNG, xg, y,
            90.0, ch, (&t_gr[0]) as u64, 2)
        let sg: *mut stil.Stil = element.el_stil(&bg)
        *sg = stil.stil_setz_font(*sg, 0, groessen[gi])
        male.male_element(&c, &bg)
        xg = xg + 60.0
        gi = gi + 1
    }

    // ==================================================================
    // ABSCHNITT 4: DIE ANORDNUNG, ECHT GERECHNET
    // ==================================================================
    y = y + ch + 34.0
    var t_a1: [u8; 46] = "ANORDNUNG -- Stapel mit dehnbarem Feld        "
    kopf(&c, 24.0, y, (&t_a1[0]) as u64, 40)
    y = y + 26.0

    // Genau die Leiste von Certus: drei Knoepfe fest, Adressfeld dehnbar.
    var st: anordnung.Stapel = anordnung.stapel_neu(anordnung.WAAGRECHT)
    anordnung.stapel_setz_rand(&st, 8, 0, 8, 0)
    anordnung.stapel_setz_abstand(&st, 8)
    var wunsch: [i64; 4] = [40, 40, 40, 100]
    var dehnt: [i64; 4] = [0, 0, 0, 1]
    var quer: [i64; 4] = [32, 32, 32, 32]
    var kaesten: [anordnung.Kasten; 4] =
        [anordnung.kasten_neu(0,0,0,0); 4]
    anordnung.stapel_legen(&st,
        anordnung.kasten_neu(24, y as i64, 1152, 32),
        (&wunsch[0]) as *mut i64, (&dehnt[0]) as *mut i64,
        (&quer[0]) as *mut i64,
        (&kaesten[0]) as *mut anordnung.Kasten, 4)

    var t_zu: [u8; 1] = "<"
    var t_vo: [u8; 1] = ">"
    var t_ne: [u8; 1] = "R"
    var t_ad: [u8; 21] = "https://de.wikipedia."
    var ai: usize = 0
    while ai < 4 {
        var art: u32 = element.AR_KNOPF
        var tp: u64 = (&t_zu[0]) as u64
        var tn: usize = 1
        if ai == 1 {
            tp = (&t_vo[0]) as u64
        } else if ai == 2 {
            tp = (&t_ne[0]) as u64
        } else if ai == 3 {
            art = element.AR_TEXTFELD
            tp = (&t_ad[0]) as u64
            tn = 21
        }
        var ea: element.Element = mach(art,
            anordnung.kasten_x(&kaesten[ai]) as f64,
            anordnung.kasten_y(&kaesten[ai]) as f64,
            anordnung.kasten_w(&kaesten[ai]) as f64,
            anordnung.kasten_h(&kaesten[ai]) as f64, tp, tn)
        male.male_element(&c, &ea)
        ai = ai + 1
    }

    // ==================================================================
    // ABSCHNITT 5: DAS RASTER
    // ==================================================================
    y = y + ch + 34.0
    var t_r1: [u8; 40] = "RASTER -- 6 x 2, Abstaende, exakte Summe"
    kopf(&c, 24.0, y, (&t_r1[0]) as u64, 39)
    y = y + 26.0

    var ra: anordnung.Raster = anordnung.raster_neu(6, 2)
    anordnung.raster_setz_abstand(&ra, 10, 10)
    let rraum: anordnung.Kasten =
        anordnung.kasten_neu(24, y as i64, 1152, 76)
    var t_z: [u8; 5] = "Feld "
    var rz: usize = 0
    while rz < 2 {
        var rs: usize = 0
        while rs < 6 {
            var zk: anordnung.Kasten =
                anordnung.raster_zelle(&ra, rraum, rs, rz)
            var er: element.Element = mach(element.AR_KACHEL,
                anordnung.kasten_x(&zk) as f64,
                anordnung.kasten_y(&zk) as f64,
                anordnung.kasten_w(&zk) as f64,
                anordnung.kasten_h(&zk) as f64,
                (&t_z[0]) as u64, 4)
            // Jede zweite Kachel im Akzent -- damit man die Zellen
            // wirklich abzaehlen kann.
            if (rs + rz) % 2 == 1 {
                let sr: *mut stil.Stil = element.el_stil(&er)
                *sr = stil.stil_setz_hg(*sr,
                    stil.farb_token(stil.TK_FLAECHE_HOCH))
            }
            male.male_element(&c, &er)
            rs = rs + 1
        }
        rz = rz + 1
    }

    // ==================================================================
    // ABSCHNITT 6: DIE FENSTERKNOEPFE AUS DEM KERN
    // ==================================================================
    y = y + 76.0 + 34.0
    var t_f1: [u8; 52] = "FENSTERKNOEPFE -- aus dem Kern, skaliert 1x 2x 3x   "
    kopf(&c, 24.0, y, (&t_f1[0]) as u64, 49)
    y = y + 26.0

    // Sie werden hier ueber die Kern-Schnittstelle gemalt -- derselbe
    // Quelltext, den der Fenstermanager von OrientOS im Kernprofil
    // einbindet. Dafuer braucht es die Bildpunkte der Leinwand als
    // rohen Puffer.
    // Die Leinwand ist 0xAARRGGBB, der Kern schreibt BGRX. Beide legen
    // B, G, R in derselben Reihenfolge ab -- der Kern setzt nur das
    // vierte Oktett auf 0 statt auf 255. Fuer ein PNG, das die
    // Leinwand als deckend liest, muss das Alpha aber stehen bleiben;
    // darum malt der Kern hier in einen EIGENEN Puffer, und der wird
    // danach mit gesetztem Alpha uebertragen. Auf einem echten Fenster
    // faellt das weg -- dort IST der Puffer BGRX.
    let kbytes: usize = W * H * 4
    let kp: u64 = rt.heap_alloc(kbytes)
    if kp == 0 as u64 {
        return 8
    }
    rt.mem_set(kp, 0 as u8, kbytes)
    var zi: kern.Ziel = kern.ziel_neu(kp, W, H, W * 4)
    var sk: usize = 1
    var kx: f64 = 24.0
    while sk <= 3 {
        let cap_w: usize = 30 * sk
        let d: usize = 10 * sk
        let sb: usize = sk
        let hoehe: usize = 32 * sk
        // Die Flaeche: dieselbe Rundung wie jeder Knopf.
        var i2: usize = 0
        while i2 < 3 {
            let bx: f64 = kx + ((i2 * cap_w) as f64)
            zeichnen.rund(&z, bx, y, cap_w as f64, hoehe as f64, 0.0,
                (*f).flaeche)
            i2 = i2 + 1
        }
        let oy: usize = (y as usize) + (hoehe - d) / 2
        let ox0: usize = (kx as usize) + (cap_w - d) / 2
        kern.kn_minimieren(&zi, ox0, oy, d, sb, (*f).text)
        kern.kn_maximieren(&zi, ox0 + cap_w, oy, d, sb, (*f).text)
        kern.kn_schliessen(&zi, ox0 + 2 * cap_w, oy, d, sb,
            (*f).text)
        kx = kx + ((3 * cap_w) as f64) + 24.0
        sk = sk + 1
    }

    // Den Kernpuffer auf die Leinwand legen: was der Kern gesetzt hat,
    // gewinnt. Erkennbar an einem Oktett ungleich null -- der Puffer
    // war vorher genullt.
    let cvp: u64 = canvas.canvas_pixels(&cv) as u64
    var pi: usize = 0
    while pi < W * H {
        let o: u64 = (pi * 4) as u64
        // ==============================================================
        // R UND B TAUSCHEN -- SONST IST DAS ZEICHEN FALSCHFARBEN
        // ==============================================================
        //
        // EIN FEHLER DIESER RUNDE, IM BILD GEFUNDEN. Die erste Fassung
        // kopierte die vier Oktett unveraendert, und im PNG stand
        // 0xFEFBFB statt 0xFBFBFE -- rot und blau vertauscht. Bei einem
        // fast weissen Zeichen sieht man das nicht; bei einem farbigen
        // waere es sofort aufgefallen.
        //
        // Der Grund ist der Vertrag: lib/fenster/fenster.fi legt in F3
        // BGRX fest (B, G, R, X im Speicher), und der Kern haelt sich
        // daran. lib/paint/canvas.fi legt dagegen R, G, B, A ab. Auf
        // einem echten Fenster faellt der Tausch weg -- dort schiebt
        // `fenster.bild` einen BGRX-Puffer, und der Kern hat direkt
        // hineingemalt. Nur DIESES Werkzeug malt in eine Leinwand.
        //
        // Dieselbe Verwechslung steht als Warnung in
        // lib/fenster/fenster.fi bei `rgb_nach_bgrx`: "eine erste
        // Fassung von `to_bgrx` tauschte R und B, und das Fenster
        // zeigte die Seite in Falschfarben."
        let b: u8 = *((kp + o) as *mut u8)
        let g: u8 = *((kp + o + 1 as u64) as *mut u8)
        let r: u8 = *((kp + o + 2 as u64) as *mut u8)
        if b != 0 as u8 || g != 0 as u8 || r != 0 as u8 {
            *((cvp + o) as *mut u8) = r
            *((cvp + o + 1 as u64) as *mut u8) = g
            *((cvp + o + 2 as u64) as *mut u8) = b
            *((cvp + o + 3 as u64) as *mut u8) = 255 as u8
        }
        pi = pi + 1
    }

    // ---- HERAUSSCHREIBEN
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&cv, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < rt.c_length(pfad) {
        rt.buf_push(&pf, rt.ld8(pfad, k))
        k = k + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 12] = "SCHAUSEITE\n\0"
    rt.write_everything(1, (&okm[0]) as u64, 11)
    zeichnen.zeichner_frei(&z)
    canvas.canvas_free(&cv)
    return 0
}
