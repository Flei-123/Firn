// SPDX-License-Identifier: MPL-2.0
// tools/fui/gpu_probe_main.fi -- fUi GPU path, step 1 (W18-F): is there a Vulkan loader, an instance and a device
// (Mesa lavapipe counts), can the device clear a 16x16 target and give the pixels back?
//
//     gpu_probe_main            prints one line per step, exit 0 = all fine
//
// Exit codes: 0 = ok, 4 = no Vulkan loader or no device (gpuparity.sh prints SKIP), 3 = device there, clear/read-back wrong.
import std.rt
import std.io
import gpu.vk

fn main() -> i32 {
    var v: vk.Vk = vk.vk_new()
    if !vk.open(&v, false, true) {
        io.fmt_print(f"gpu_probe: no vulkan (step={v.step})\n")
        return 4
    }
    io.print("gpu_probe: device ")
    io.print_c(vk.device_name(&v))
    io.new_line()
    let ver: u64 = vk.api_version(&v)
    let major: u64 = ver >> 22
    let minor: u64 = (ver >> 12) & 1023
    let cpu: bool = vk.is_cpu(&v)
    io.fmt_print(f"gpu_probe: api {major}.{minor} cpu={cpu}\n")
    var t: vk.Target = vk.target_new_blank()
    if !vk.target_new(&v, &t, 16, 16) {
        io.print("gpu_probe: FAIL target_new\n")
        return 3
    }
    var p: vk.Pipe = vk.pipe_blank()
    if !vk.pipeline_tri(&v, &p, t.rpass) {
        io.print("gpu_probe: FAIL pipeline\n")
        return 3
    }
    var b: vk.Buf = vk.buf_blank()
    if !vk.buf_new(&v, &b, 3 * 20) {
        io.print("gpu_probe: FAIL buffer\n")
        return 3
    }
    // zeroed vertices = a degenerate triangle: only the clear colour lands in the target
    var zero: [u8; 60] = [0; 60]
    vk.buf_write(&b, (&zero[0]) as u64, 60)
    if !vk.draw(&v, &t, &p, &b, 3, 0xFF0000FF) {
        io.print("gpu_probe: FAIL draw\n")
        return 3
    }
    var px: [u8; 1024] = [0; 1024]
    if !vk.read_pixels(&t, (&px[0]) as u64) {
        io.print("gpu_probe: FAIL read_pixels\n")
        return 3
    }
    let r: u32 = px[0] as u32
    let g: u32 = px[1] as u32
    let bl: u32 = px[2] as u32
    let a: u32 = px[3] as u32
    io.fmt_print(f"gpu_probe: pixel {r} {g} {bl} {a}\n")
    // every one of the 256 pixels must hold the same colour and be opaque
    var i: usize = 0
    var same: bool = true
    while i < 256 {
        if px[i * 4] != px[0] || px[i * 4 + 1] != px[1] || px[i * 4 + 2] != px[2] || px[i * 4 + 3] != px[3] {
            same = false
        }
        i = i + 1
    }
    if !same || a != 255 as u32 {
        io.print("gpu_probe: FAIL clear colour\n")
        return 3
    }
    vk.buf_free(&v, &b)
    vk.pipeline_free(&v, &p)
    vk.target_free(&v, &t)
    vk.close(&v)
    io.print("gpu_probe: OK\n")
    return 0
}
