// SPDX-License-Identifier: MPL-2.0
// tools/fui/appctl_main.fi -- THE CHECK OF lib/fui/appctl.fi, WITHOUT A WINDOW.
//
// Builds a settings window through the public appctl calls only, paints it, and drives it through
// the entry points the platform hosts call (fuiwirt pointer, app_key, app_char, app_act).
//
//     firnc -o /tmp/appctl tools/fui/appctl_main.fi && /tmp/appctl [dir-for-pngs]
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut LAST_ID: usize = 0

static mut MAIL_ID: usize = 0
static mut OUT_ID: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_num(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

static mut FONT: u64 = 0

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn settle(a: *mut app.App) {
    let i: usize = fuiwirt.host_take_activated(app.app_host(a))
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
}

fn click_at(a: *mut app.App, s: *mut Surface, x: f64, y: f64) {
    let w: *mut fuiwirt.Host = app.app_host(a)
    let c1: u32 = fuiwirt.host_pointer_move(w, x, y)
    let c2: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let c3: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
    settle(a)
    frame(a, s)
}

fn click(a: *mut app.App, s: *mut Surface, id: usize) {
    let sc: *mut scene.Scene = app.app_scene(a)
    click_at(a, s, scene.node_x(sc, id) + scene.node_w(sc, id) / 2.0,
        scene.node_y(sc, id) + scene.node_h(sc, id) / 2.0)
}

fn key(a: *mut app.App, s: *mut Surface, k: u32) {
    let used: bool = app.app_key(a as u64, k, 0 as u32)
    if !used {
        let h: u32 = fuiwirt.host_key(app.app_host(a), 0 as u32, 0 as u32)
    }
    frame(a, s)
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
    LAST_ID = id
}

fn focus_on(a: *mut app.App, id: usize) {
    let r: u32 = fuiwirt.host_pointer_move(app.app_host(a), 1.0, 1.0)
    let f: bool = false
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appctl: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Settings", 520, 700)
    let cb: usize = appctl.checkbox(a, "Dark mode", false, changed)
    let tg: usize = appctl.toggle(a, "Notifications", false, changed)
    let r1: usize = appctl.radio(a, 1, "Small", true, changed)
    let r2: usize = appctl.radio(a, 1, "Large", false, changed)
    let sl: usize = appctl.slider(a, "Volume", 0, 100, 40, changed)
    let pg: usize = appctl.progress(a, "Download", 0, 100, 25)
    let sp: usize = appctl.spinbox(a, "Count", 0, 10, 1, 3, changed)
    let dd: usize = appctl.dropdown(a, "Language", changed)
    let o1: bool = appctl.dropdown_add(a, dd, "English")
    let o2: bool = appctl.dropdown_add(a, dd, "Deutsch")
    let tb: usize = appctl.tabs(a)
    let t1: usize = appctl.tab(a, tb, "General", changed)
    let t2: usize = appctl.tab(a, tb, "Advanced", changed)
    appctl.tabs_end(a)
    let p1: usize = appctl.tab_page(a, tb)
    let l1: usize = app.label(a, "page one", 0)
    app.end(a)
    let p2: usize = appctl.tab_page(a, tb)
    let l2: usize = app.label(a, "page two", 0)
    app.end(a)
    let ex: usize = appctl.expander(a, "More", false, changed)
    let eb: usize = appctl.expander_body(a, ex)
    let l3: usize = app.label(a, "hidden body", 0)
    app.end(a)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 520, 700)
    frame(a, s)
    frame(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)

    click(a, s, cb)
    check(appctl.checked(a, cb) && CHANGES == 1 && LAST_ID == cb, "click flips the check box and calls back once")
    click(a, s, tg)
    check(appctl.checked(a, tg) && CHANGES == 2, "click flips the switch")
    click(a, s, r2)
    check(appctl.checked(a, r2) && !appctl.checked(a, r1) && CHANGES == 3, "radio: the second takes the first's place")
    click(a, s, sl)
    check(appctl.value(a, sl) != 40 && CHANGES == 4, "click on the slider track moves the value")
    let v0: i64 = appctl.value(a, sl)
    key(a, s, editor.KEY_RIGHT)
    check(appctl.value(a, sl) == v0 + 1 && CHANGES == 5, "Right arrow: slider +1")
    key(a, s, editor.KEY_HOME)
    check(appctl.value(a, sl) == 0, "Home: slider to its minimum")
    appctl.set_value(a, pg, 80)
    check(appctl.value(a, pg) == 80 && CHANGES == 6, "progress value set, no callback")
    click_at(a, s, scene.node_x(sc, sp) + scene.node_w(sc, sp) - 5.0, scene.node_y(sc, sp) + 5.0)
    check(appctl.value(a, sp) == 4 && app.number(a, sp) == 4, "spin box: + zone adds the step and shows it")
    click(a, s, sp)
    key(a, s, editor.KEY_DOWN)
    check(appctl.value(a, sp) == 3, "spin box: Down arrow subtracts the step")
    check(appctl.selected(a, dd) == 0, "drop-down starts on its first entry")
    click(a, s, dd)
    check(appctl.dropdown_is_open(a), "click opens the drop-down list")
    key(a, s, editor.KEY_DOWN)
    key(a, s, editor.KEY_ENTER)
    check(!appctl.dropdown_is_open(a) && appctl.selected(a, dd) == 1, "Down + Enter chooses the second entry and closes")
    check(!scene.node_hidden(sc, p1) && scene.node_hidden(sc, p2), "tabs: first page shown, second hidden")
    click(a, s, t2)
    check(scene.node_hidden(sc, p1) && !scene.node_hidden(sc, p2) && appctl.selected(a, t2) == 1, "tabs: click shows page two")
    check(scene.node_hidden(sc, eb) && !appctl.expanded(a, ex), "expander starts collapsed")
    click(a, s, ex)
    check(!scene.node_hidden(sc, eb) && appctl.expanded(a, ex), "expander: click opens the body")
    check(app.audit(a) == 0, "accessibility audit: no unnamed element")
    if BAD == 0 {
        say("APPCTL PASSED\n")
        return 0
    }
    say("APPCTL FAILED (")
    say_num(BAD as i64)
    say(")\n")
    return 1
}
