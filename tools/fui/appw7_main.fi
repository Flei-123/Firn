// tools/fui/appw7_main.fi -- the range slider (appctl.range_slider) and the window timelines (appctl.timeline*) in the ten-line API.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.wave7
import fui.timeline
import fui.anim
import fui.style
import fui.a11y
import fui.render

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appw7: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Wave7", 600, 400)
    let rg: usize = appctl.range_slider(a, "Price", 280, 0, 100, 5, 20, 80, changed)
    let tid: usize = appctl.timeline(a)
    let tid2: usize = appctl.timeline(a)
    let s: *mut Surface = surface_for(a, 600, 400)
    settle(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    let w: *mut fuiwirt.Host = app.app_host(a)
    let rc: *mut render.Ctx = app.app_ctx(a)
    check(rg != appctl.NONE && tid == 0 && tid2 == 1, "range slider and two timelines exist")
    check(appctl.range_lo(a, rg) == 20 && appctl.range_hi(a, rg) == 80, "range starts at 20..80")
    check(scene.node_w(sc, rg) > 200.0 && scene.node_h(sc, rg) > 20.0, "range has a size")
    check(appctl.range_slider(a, "Bad", 280, 5, 5, 1, 5, 5, changed) == appctl.NONE, "an empty span is refused")
    // ---- press on the high thumb, drag far right, release
    let nx: f64 = scene.node_x(sc, rg)
    let nw: f64 = scene.node_w(sc, rg)
    let ny: f64 = scene.node_y(sc, rg) + scene.node_h(sc, rg) / 2.0
    var r0: wave7.Range = wave7.range_new(0, 100, 5, 20, 80)
    let xh: f64 = wave7.range_thumb_x(rc, &r0, nx, nw, 80)
    var t: i64 = fuiwirt.host_now(w)
    let m0: u32 = fuiwirt.host_pointer_move(w, xh, ny)
    let d0: u32 = fuiwirt.host_pointer_down(w, xh, ny, fuiwirt.BTN_LEFT)
    check(appctl.range_focus_thumb(a, rg) == wave7.RANGE_HI, "a press near the high thumb picks it")
    t = t + 16
    fuiwirt.host_tick(w, t)
    let m1: u32 = fuiwirt.host_pointer_move(w, nx + nw + 200.0, ny)
    check(appctl.range_hi(a, rg) == 100 && appctl.range_lo(a, rg) == 20, "dragging far right: high 100, low untouched")
    check(CHANGES >= 1, "the user's drag calls back")
    let m2: u32 = fuiwirt.host_pointer_move(w, nx - 200.0, ny)
    check(appctl.range_hi(a, rg) == 20 && appctl.range_lo(a, rg) == 20, "dragging far left: the high thumb stops at the low one")
    let u0: u32 = fuiwirt.host_pointer_up(w, nx - 200.0, ny, fuiwirt.BTN_LEFT)
    let m3: u32 = fuiwirt.host_pointer_move(w, nx + nw / 2.0, ny - 30.0)
    check(appctl.range_hi(a, rg) == 20, "after the release the thumb stays")
    // ---- keys on the focused thumb
    appctl.set_range_values(a, rg, 20, 80)
    app.set_focus(a, rg)
    let before: usize = CHANGES
    let k1: bool = app.app_key(a as u64, editor.KEY_LEFT, 0 as u32)
    check(k1 && appctl.range_hi(a, rg) == 75, "Left moves the focused thumb one step")
    let k2: bool = app.app_key(a as u64, editor.KEY_HOME, 0 as u32)
    check(appctl.range_hi(a, rg) >= appctl.range_lo(a, rg), "thumbs never cross")
    check(CHANGES > before, "keys call back")
    appctl.set_range_values(a, rg, 30, 70)
    check(appctl.range_lo(a, rg) == 30 && appctl.range_hi(a, rg) == 70, "set_range_values")
    appctl.set_range_values(a, rg, 90, 10)
    check(appctl.range_lo(a, rg) == 10 && appctl.range_hi(a, rg) == 90, "set_range_values orders the ends")
    settle(a, s)
    check(widget.w_value(scene.node_widget(sc, rg)) >= 0, "the a11y value is set")
    // ---- timeline: dt-based, real time
    let tl: *mut timeline.Timeline = appctl.timeline_ref(a, tid)
    check(tl as u64 != 0, "timeline_ref gives the timeline")
    let t0: usize = timeline.seq(tl, 200, 0.0, 1.0, anim.easing_linear())
    let t1: usize = timeline.seq(tl, 100, 1.0, 0.0, anim.easing_linear())
    check(!appctl.timeline_playing(a, tid) && near(appctl.timeline_value(a, tid, t0), 0.0, 0.0001), "idle: first value, not playing")
    appctl.timeline_play(a, tid)
    check(appctl.timeline_playing(a, tid), "play starts it")
    var g: usize = 0
    while g < 6 {
        t = t + 16
        fuiwirt.host_tick(w, t)
        g = g + 1
    }
    // 96 ms after the start: linear track 0 at 96 / 200
    check(near(appctl.timeline_value(a, tid, t0), 0.48, 0.1), "after about 96 ms the value is near 0.48 (dt-based)")
    check(appctl.timeline_playing(a, tid), "still playing")
    g = 0
    while g < 30 {
        t = t + 16
        fuiwirt.host_tick(w, t)
        g = g + 1
    }
    check(!appctl.timeline_playing(a, tid) && appctl.timeline_finished(a, tid), "ends after its total time")
    check(near(appctl.timeline_value(a, tid, t1), 0.0, 0.0001) && near(appctl.timeline_value(a, tid, t0), 1.0, 0.0001), "end values")
    // a slow frame: one tick of 500 ms jumps to the end (time, not frames)
    let tl2: *mut timeline.Timeline = appctl.timeline_ref(a, tid2)
    let u0b: usize = timeline.seq(tl2, 300, 0.0, 10.0, anim.easing_linear())
    appctl.timeline_play(a, tid2)
    t = t + 500
    fuiwirt.host_tick(w, t)
    check(near(appctl.timeline_value(a, tid2, u0b), 10.0, 0.0001) && !appctl.timeline_playing(a, tid2), "one slow frame of 500 ms ends a 300 ms timeline")
    // pause / stop
    appctl.timeline_stop(a, tid2)
    appctl.timeline_play(a, tid2)
    t = t + 16
    fuiwirt.host_tick(w, t)
    appctl.timeline_pause(a, tid2)
    let vp: f64 = appctl.timeline_value(a, tid2, u0b)
    t = t + 160
    fuiwirt.host_tick(w, t)
    check(near(appctl.timeline_value(a, tid2, u0b), vp, 0.0001), "pause holds the value")
    check(appctl.timeline_ref(a, 7) as u64 == 0 && appctl.timeline_value(a, 7, 0) == 0.0, "a bad id is harmless")
    // ---- reduced motion: the theme's motion 0 -> the end at once, no frame in between
    (*theme.theme_shape(app.app_theme(a))).motion = 0
    check(appctl.timeline_reduced(a), "motion 0 = reduced")
    appctl.timeline_stop(a, tid)
    appctl.timeline_play(a, tid)
    check(!appctl.timeline_playing(a, tid) && near(appctl.timeline_value(a, tid, t0), 1.0, 0.0001), "reduced motion: play jumps to the end at once")
    (*theme.theme_shape(app.app_theme(a))).motion = 160
    check(!appctl.timeline_reduced(a), "motion back: not reduced")
    // the system setting on the registry (syspref.motion_apply puts it there)
    var tr: anim.TransReg = anim.transreg_new()
    anim.transreg_set_fluent(&tr)
    check(!anim.transreg_reduced(&tr), "fluent registry: not reduced")
    anim.transreg_set_reduced(&tr)
    check(anim.transreg_reduced(&tr), "reduced registry: reduced")
    anim.transreg_set_fluent(&tr)
    check(!anim.transreg_reduced(&tr), "fluent again: not reduced")
    if BAD == 0 {
        say("APPW7 PASSED\n")
        return 0
    }
    say("APPW7 FAILED\n")
    return 1
}
