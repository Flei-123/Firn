// SPDX-License-Identifier: MPL-2.0
// tools/fui/mdextras_main.fi -- THE CHECK OF THE MARKDOWN VIEW'S EXTRAS: syntax highlighting
// of fenced code and text selection with copy.
//
// Highlighting: a fenced block whose info string names a language is painted in the colours
// of lib/fui/syntaxcolor.fi -- the pixels are read back (a JSON key, number and constant each
// in its colour on the code ground, light AND dark), an unknown language and the switch
// `mdv_set_highlight(false)` paint none of them, and every colour of every kind is at least
// 4.5:1 on the ground in both themes.
//
// Selection: Select all copies the whole document as text (headings and paragraphs as blocks,
// tight list items as lines, code lines as lines, table cells with tabs); a mouse drag, a double
// click (the word), a third click (the block), Ctrl+C into a clipboard hook, the selection colour
// on screen, and a relayout (new width) dropping the selection.
//
//     firnc -o /tmp/mdextras tools/fui/mdextras_main.fi && /tmp/mdextras [dir]
import std.rt
import std.io
import paint.canvas
import paint.png
import html.mem
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.style
import fui.viewport
import fui.markdownview
import fui.syntaxcolor
import fui.editor
import highlight.highlight
import markdown.doc
import plat.sysfont

static mut BAD: usize = 0
static mut CHECKS: usize = 0
static mut CLIP_N: usize = 0
static mut CLIP: [u8; 512] = [0 as u8; 512]

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: io.Fmt) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    io.fmt_print_line(what)
}

fn checkp(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn on_clip(p: u64, n: usize) -> bool {
    CLIP_N = n
    if n > 512 {
        CLIP_N = 512
    }
    var i: usize = 0
    while i < CLIP_N {
        CLIP[i] = rt.ld8(p, i)
        i = i + 1
    }
    return true
}

fn clip_is(s: str) -> bool {
    if CLIP_N != s.n {
        return false
    }
    var i: usize = 0
    while i < s.n {
        if CLIP[i] != rt.ld8(s.p as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
    w: usize,
    h: usize,
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    theme.theme_set_accent(&(*p).m, 0x1BD96A as u32)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    (*p).w = w
    (*p).h = h
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn tok(p: *mut Page, t: u32) -> u32 {
    return theme.opaque(render.color_of(&(*p).c, style.color_token(t)))
}

fn clear(p: *mut Page) {
    canvas.canvas_clear(&(*p).cv, tok(p, style.TOK_BASE))
}

fn chan_near(a: u32, b: u32, sh: u32, t: u32) -> bool {
    let x: u32 = (a >> sh) & 255 as u32
    let y: u32 = (b >> sh) & 255 as u32
    var d: u32 = 0 as u32
    if x >= y {
        d = x - y
    } else {
        d = y - x
    }
    return d <= t
}

fn count_near(p: *mut Page, col: u32, tol: u32) -> usize {
    var n: usize = 0
    var y: usize = 0
    while y < (*p).h {
        var x: usize = 0
        while x < (*p).w {
            let v: u32 = canvas.canvas_get(&(*p).cv, x, y)
            if chan_near(v, col, 0 as u32, tol) && chan_near(v, col, 8 as u32, tol) && chan_near(v, col, 16 as u32, tol) {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = rt.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

const CODE_DOC: str = "# Config\n\n```json\n{\"name\": \"launcher\", \"count\": 12, \"on\": true}\n```\n"
const PLAIN_DOC: str = "# Config\n\n```brainfuck\n{\"name\": \"launcher\", \"count\": 12, \"on\": true}\n```\n"

fn run_highlight(dir: u64, font: u64, dark: bool) {
    var tag: str = "light"
    if dark {
        tag = "dark"
    }
    let p: *mut Page = page_new(520, 200, dark, font)
    let c: *mut render.Ctx = &(*p).c
    let ground: u32 = tok(p, style.TOK_SURFACE) & 16777215 as u32
    let key: u32 = theme.opaque(syntaxcolor.syntax_color(&(*p).m, highlight.TK_KEY, ground))
    let num: u32 = theme.opaque(syntaxcolor.syntax_color(&(*p).m, highlight.TK_NUMBER, ground))
    let con: u32 = theme.opaque(syntaxcolor.syntax_color(&(*p).m, highlight.TK_CONSTANT, ground))
    let strc: u32 = theme.opaque(syntaxcolor.syntax_color(&(*p).m, highlight.TK_STRING, ground))
    check(syntaxcolor.syntax_contrast_ok(&(*p).m, ground), f"{tag}: every syntax colour has 4.5:1 on the code ground")
    check(key != num && num != strc && strc != key, f"{tag}: key, number and string colours differ")
    var v: markdownview.MdView = markdownview.mdv_new()
    markdownview.mdv_set_markdown(&v, CODE_DOC, doc.opts_default())
    markdownview.mdv_set_background(&v, style.TOK_BASE)
    markdownview.mdv_set_rect(&v, 0.0, 0.0, 520.0, 200.0)
    clear(p)
    markdownview.mdv_paint(&v, c)
    let nk: usize = count_near(p, key, 20 as u32)
    let nn: usize = count_near(p, num, 20 as u32)
    let ns: usize = count_near(p, strc, 20 as u32)
    check(nk > 10 && nn > 3 && ns > 10, f"{tag}: JSON key/number/string pixels on screen ({nk}/{nn}/{ns})")
    if dark {
        save(&(*p).cv, dir, "mdextras-code-dark.png")
    } else {
        save(&(*p).cv, dir, "mdextras-code-light.png")
    }
    // switched off: none of them
    markdownview.mdv_set_highlight(&v, false)
    clear(p)
    markdownview.mdv_paint(&v, c)
    check(count_near(p, key, 20 as u32) == 0 && count_near(p, strc, 20 as u32) == 0,
        f"{tag}: with highlighting off the code is plain")
    markdownview.mdv_free(&v)
    // an unknown language: plain too
    var v2: markdownview.MdView = markdownview.mdv_new()
    markdownview.mdv_set_markdown(&v2, PLAIN_DOC, doc.opts_default())
    markdownview.mdv_set_background(&v2, style.TOK_BASE)
    markdownview.mdv_set_rect(&v2, 0.0, 0.0, 520.0, 200.0)
    clear(p)
    markdownview.mdv_paint(&v2, c)
    check(count_near(p, key, 20 as u32) == 0 && count_near(p, strc, 20 as u32) == 0,
        f"{tag}: an unknown language is plain")
    markdownview.mdv_free(&v2)
}

const SEL_DOC: str = "# Title\n\nHello brave new world.\n\nSecond paragraph here.\n\n- one\n- two\n\n1. first\n2. second\n\n```\ncode a\ncode b\n```\n\n| A | B |\n|---|---|\n| 1 | 2 |\n"

// the content-space box of the first text item whose octets are exactly `word`
fn find_word(v: *mut markdownview.MdView, word: str, x: *mut f64, y: *mut f64, w: *mut f64, h: *mut f64) -> bool {
    var i: usize = 0
    while i < markdownview.mdv_item_count(v) {
        var p: u64 = 0
        var n: usize = 0
        if markdownview.mdv_item_text(v, i, x, y, w, h, &p, &n) {
            if n == word.n && rt.mem_eq(p, word.p as u64, n) {
                return true
            }
        }
        i = i + 1
    }
    return false
}

fn sel_text(v: *mut markdownview.MdView) -> rt.Buf {
    var b: rt.Buf = rt.buf_new()
    markdownview.mdv_selection_text(v, &b)
    return b
}

fn buf_is(b: *mut rt.Buf, s: str) -> bool {
    return rt.buf_len(b) == s.n && rt.mem_eq(rt.buf_ptr(b), s.p as u64, s.n)
}

fn run_selection(dir: u64, font: u64, dark: bool) {
    var tag: str = "light"
    if dark {
        tag = "dark"
    }
    let p: *mut Page = page_new(520, 640, dark, font)
    let c: *mut render.Ctx = &(*p).c
    var v: markdownview.MdView = markdownview.mdv_new()
    markdownview.mdv_set_markdown(&v, SEL_DOC, doc.opts_default())
    markdownview.mdv_set_background(&v, style.TOK_BASE)
    markdownview.mdv_set_rect(&v, 0.0, 0.0, 520.0, 640.0)
    markdownview.mdv_set_clipboard(&v, on_clip)
    clear(p)
    markdownview.mdv_paint(&v, c)
    let ox: f64 = viewport.viewport_content_x(&v.vp)
    let oy: f64 = viewport.viewport_content_y(&v.vp)
    check(!markdownview.mdv_has_selection(&v), f"{tag}: nothing selected at the start")
    // all of it
    markdownview.mdv_select_all(&v)
    var all: rt.Buf = sel_text(&v)
    checkp(buf_is(&all, "Title\n\nHello brave new world.\n\nSecond paragraph here.\n\none\ntwo\n\n1. first\n2. second\n\ncode a\ncode b\n\nA\tB\n1\t2"),
        "select all copies headings and paragraphs as blocks, list items as lines, code lines as lines, cells with tabs")
    let got: str = str { p: rt.ptr_of(rt.buf_ptr(&all)), n: rt.buf_len(&all) }
    io.fmt_print_line(f"  copy: [{got}]")
    rt.buf_free(&all)
    // the selection is painted
    clear(p)
    markdownview.mdv_paint(&v, c)
    let selc: u32 = tok(p, style.TOK_SELECTION)
    check(count_near(p, selc, 2 as u32) > 800, f"{tag}: the selection colour covers the text")
    if dark {
        save(&(*p).cv, dir, "mdextras-selected-dark.png")
    } else {
        save(&(*p).cv, dir, "mdextras-selected-light.png")
    }
    // Ctrl+A / Ctrl+C
    markdownview.mdv_clear_selection(&v)
    check(!markdownview.mdv_has_selection(&v), f"{tag}: cleared")
    check(markdownview.mdv_char(&v, 1 as u32, 0 as u32) && markdownview.mdv_has_selection(&v), f"{tag}: Ctrl+A selects all")
    CLIP_N = 0
    check(markdownview.mdv_char(&v, 99 as u32, editor.MOD_CTRL) && CLIP_N > 40, f"{tag}: Ctrl+C puts the text on the clipboard ({CLIP_N} octets)")
    markdownview.mdv_clear_selection(&v)
    // a drag from "brave" to "new"
    var bx: f64 = 0.0
    var by: f64 = 0.0
    var bw: f64 = 0.0
    var bh: f64 = 0.0
    var nx: f64 = 0.0
    var ny: f64 = 0.0
    var nw: f64 = 0.0
    var nh: f64 = 0.0
    check(find_word(&v, "brave", &bx, &by, &bw, &bh) && find_word(&v, "new", &nx, &ny, &nw, &nh), f"{tag}: the words are laid out")
    markdownview.mdv_set_time(&v, 1000)
    check(markdownview.mdv_pointer_down(&v, c, ox + bx + 1.0, oy + by + bh / 2.0), f"{tag}: a press on text starts a selection")
    check(markdownview.mdv_pointer_move(&v, c, ox + nx + nw - 1.0, oy + ny + nh / 2.0), f"{tag}: the drag changes the picture")
    markdownview.mdv_pointer_up(&v, c, ox + nx + nw - 1.0, oy + ny + nh / 2.0)
    var d1: rt.Buf = sel_text(&v)
    checkp(buf_is(&d1, "brave new"), "a drag from one word to another copies exactly those words")
    rt.buf_free(&d1)
    // double click: the word (punctuation is not part of it)
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    var ww: f64 = 0.0
    var wh: f64 = 0.0
    check(find_word(&v, "world.", &wx, &wy, &ww, &wh), f"{tag}: 'world.' is laid out")
    markdownview.mdv_clear_selection(&v)
    markdownview.mdv_set_time(&v, 10000)
    markdownview.mdv_pointer_down(&v, c, ox + wx + 3.0, oy + wy + wh / 2.0)
    markdownview.mdv_pointer_up(&v, c, ox + wx + 3.0, oy + wy + wh / 2.0)
    markdownview.mdv_set_time(&v, 10200)
    markdownview.mdv_pointer_down(&v, c, ox + wx + 3.0, oy + wy + wh / 2.0)
    markdownview.mdv_pointer_up(&v, c, ox + wx + 3.0, oy + wy + wh / 2.0)
    var d2: rt.Buf = sel_text(&v)
    checkp(buf_is(&d2, "world"), "a double click selects the word under the pointer")
    rt.buf_free(&d2)
    // third click: the whole paragraph
    markdownview.mdv_set_time(&v, 10400)
    markdownview.mdv_pointer_down(&v, c, ox + wx + 3.0, oy + wy + wh / 2.0)
    markdownview.mdv_pointer_up(&v, c, ox + wx + 3.0, oy + wy + wh / 2.0)
    var d3: rt.Buf = sel_text(&v)
    checkp(buf_is(&d3, "Hello brave new world."), "a third click selects the block")
    rt.buf_free(&d3)
    // a relayout (a new width) drops the selection: the items it named are gone
    markdownview.mdv_set_rect(&v, 0.0, 0.0, 300.0, 640.0)
    clear(p)
    markdownview.mdv_paint(&v, c)
    check(!markdownview.mdv_has_selection(&v), f"{tag}: a new width drops the selection")
    // a press on empty space far below the text takes the nearest word, not nothing
    markdownview.mdv_free(&v)
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("mdextras: no font (DejaVu Sans)\n")
        return 9
    }
    run_highlight(dir, fs as u64, false)
    run_highlight(dir, fs as u64, true)
    run_selection(dir, fs as u64, false)
    run_selection(dir, fs as u64, true)
    say("checks: ")
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&nb, CHECKS as u64)
    rt.write_everything(1, rt.buf_ptr(&nb), rt.buf_len(&nb))
    rt.buf_free(&nb)
    say("\n")
    if BAD == 0 {
        say("MDEXTRAS PASSED\n")
        return 0
    }
    say("MDEXTRAS FAILED\n")
    return 1
}
