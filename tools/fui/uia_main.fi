// SPDX-License-Identifier: MPL-2.0
// tools/fui/uia_main.fi -- THE CHECK OF lib/fui/uia.fi (the UIA model), WITHOUT A WINDOW.
// Builds the same settings window as atspi_main.fi, paints it and asks the UIA model: control types,
// patterns, states, navigation consistency, runtime ids, rectangles, hit test; the element count must equal
// the AT-SPI bridge's (same tree). Run:  FIRNLIB=lib firnc --opt-level=dev -o X tools/fui/uia_main.fi && X
import std.rt
import fui.safeout
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.a11y
import fui.atspi
import fui.uia
import fui.control
import fui.vlist
import std.env

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut LAST_ID: usize = 0

static mut MAIL_ID: usize = 0
static mut OUT_ID: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_num(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

static mut FONT: u64 = 0

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn settle(a: *mut app.App) {
    let i: usize = fuiwirt.host_take_activated(app.app_host(a))
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
}

fn click_at(a: *mut app.App, s: *mut Surface, x: f64, y: f64) {
    let w: *mut fuiwirt.Host = app.app_host(a)
    let c1: u32 = fuiwirt.host_pointer_move(w, x, y)
    let c2: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let c3: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
    settle(a)
    frame(a, s)
}

fn click(a: *mut app.App, s: *mut Surface, id: usize) {
    let sc: *mut scene.Scene = app.app_scene(a)
    click_at(a, s, scene.node_x(sc, id) + scene.node_w(sc, id) / 2.0,
        scene.node_y(sc, id) + scene.node_h(sc, id) / 2.0)
}

fn key(a: *mut app.App, s: *mut Surface, k: u32) {
    let used: bool = app.app_key(a as u64, k, 0 as u32)
    if !used {
        let h: u32 = fuiwirt.host_key(app.app_host(a), 0 as u32, 0 as u32)
    }
    frame(a, s)
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
    LAST_ID = id
}

fn focus_on(a: *mut app.App, id: usize) {
    let r: u32 = fuiwirt.host_pointer_move(app.app_host(a), 1.0, 1.0)
    let f: bool = false
}

static mut QUIT: bool = false
static mut APP: u64 = 0
static mut SURF: u64 = 0
static mut QUIT_ID: usize = 0
static mut SERVED_ACTIONS: usize = 0

#[allow_escape]
fn row_of(ud: u64, i: usize, out: *mut vlist.VRow) {
    var d: [u8; 8] = [82, 111, 119, 32, 48, 48, 0, 0]
    d[4] = (48 + (i / 10) % 10) as u8
    d[5] = (48 + i % 10) as u8
    vlist.vrow_text(out, str { p: &d[0], n: 6 })
}

fn on_quit(a: *mut app.App) {
    QUIT = true
}

// DoAction over the bus -> the same path as a click (the hit test of the pointer path)
fn on_action(ud: u64, node: usize, row: usize) -> bool {
    SERVED_ACTIONS = SERVED_ACTIONS + 1
    if node == QUIT_ID {
        QUIT = true
        return true
    }
    if row != app.NONE {
        return true
    }
    click(APP as *mut app.App, SURF as *mut Surface, node)
    return true
}

fn on_focus(ud: u64, node: usize) -> bool {
    let w: *mut fuiwirt.Host = app.app_host(APP as *mut app.App)
    let r: u32 = control.panel_set_focus(fuiwirt.host_panel(w), node)
    fuiwirt.host_touch(w)
    return true
}

fn name_is(pv: *mut uia.Provider, e: uia.El, want: str) -> bool {
    var b: [u8; 256] = [0; 256]
    let n: usize = uia.el_name(pv, e, (&b[0]) as u64, 256)
    if n != want.n { return false }
    return rt.mem_eq((&b[0]) as u64, (want.p) as u64, n)
}

static mut WALKED: usize = 0
static mut NAV_BAD: usize = 0
static mut RID_BAD: usize = 0
static mut RIDS: [u64; 256] = [0; 256]

fn rid_key(e: uia.El) -> u64 {
    var r: [i32; 3] = [0; 3]
    uia.el_runtime_id(e, &r)
    return ((r[1] as u64) * 100000) + (r[2] as u64)
}

fn walk(pv: *mut uia.Provider, e: uia.El, depth: usize) {
    if WALKED < 256 {
        let key: u64 = rid_key(e)
        var j: usize = 0
        while j < WALKED {
            if RIDS[j] == key { RID_BAD = RID_BAD + 1 }
            j = j + 1
        }
        RIDS[WALKED] = key
    }
    WALKED = WALKED + 1
    if depth > 30 { return }
    let kc: usize = uia.el_child_count(pv, e)
    let f: uia.El = uia.el_first_child(pv, e)
    let l: uia.El = uia.el_last_child(pv, e)
    if kc == 0 {
        if !uia.el_is_none(f) || !uia.el_is_none(l) { NAV_BAD = NAV_BAD + 1 }
    } else {
        if !uia.el_equal(uia.el_parent(pv, f), e) { NAV_BAD = NAV_BAD + 1 }
        if !uia.el_equal(uia.el_parent(pv, l), e) { NAV_BAD = NAV_BAD + 1 }
        if !uia.el_is_none(uia.el_prev(pv, f)) { NAV_BAD = NAV_BAD + 1 }
        if !uia.el_is_none(uia.el_next(pv, l)) { NAV_BAD = NAV_BAD + 1 }
    }
    var c: uia.El = f
    var k: usize = 0
    while !uia.el_is_none(c) && k < kc + 1 {
        let nx: uia.El = uia.el_next(pv, c)
        if !uia.el_is_none(nx) && !uia.el_equal(uia.el_prev(pv, nx), c) { NAV_BAD = NAV_BAD + 1 }
        walk(pv, c, depth + 1)
        c = nx
        k = k + 1
    }
    if k != kc { NAV_BAD = NAV_BAD + 1 }
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("uia: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Settings", 520, 700)
    let hd: usize = app.label(a, "Preferences", 0)
    a11y.a11y_set_role(app.ax(a), hd, a11y.ROLE_HEADING)
    a11y.a11y_set_level(app.ax(a), hd, 1 as u32)
    let cb: usize = appctl.checkbox(a, "Dark mode", false, changed)
    let tg: usize = appctl.toggle(a, "Notifications", false, changed)
    let r1: usize = appctl.radio(a, 1, "Small", true, changed)
    let r2: usize = appctl.radio(a, 1, "Large", false, changed)
    let sl: usize = appctl.slider(a, "Volume", 0, 100, 40, changed)
    let pg: usize = appctl.progress(a, "Download", 0, 100, 25)
    let dd: usize = appctl.dropdown(a, "Language", changed)
    let o1: bool = appctl.dropdown_add(a, dd, "English")
    let en: usize = app.entry(a, "Search")
    let vl: usize = app.vlist_new(a, "Big list", 480, 150, 50, row_of, 0)
    let qb: usize = app.button(a, "Quit", on_quit)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 520, 700)
    APP = a as u64
    SURF = s as u64
    frame(a, s)
    frame(a, s)
    let sc: *mut scene.Scene = app.app_scene(a)
    var pv: uia.Provider = uia.provider_new(sc, app.ax(a), "Settings")
    uia.provider_set_origin(&pv, 100, 50)
    say("== UIA model ==\n")
    let root: uia.El = uia.el_root(&pv)
    check(!uia.el_is_none(root), "root element exists")
    check(uia.el_control_type(&pv, root) == uia.CT_WINDOW, "root: control type Window (50032)")
    check(name_is(&pv, root, "Settings") || uia.el_name(&pv, root, 0, 0) == 0, "root: name is the title or empty")
    check(uia.el_is_none(uia.el_parent(&pv, root)), "root has no parent")
    // types
    check(uia.el_control_type(&pv, uia.el_from_node(&pv, cb)) == uia.CT_CHECKBOX, "check box -> CheckBox (50002)")
    check(uia.el_control_type(&pv, uia.el_from_node(&pv, qb)) == uia.CT_BUTTON, "button -> Button (50000)")
    check(uia.el_control_type(&pv, uia.el_from_node(&pv, sl)) == uia.CT_SLIDER, "slider -> Slider (50015)")
    check(uia.el_control_type(&pv, uia.el_from_node(&pv, en)) == uia.CT_EDIT, "entry -> Edit (50004)")
    check(uia.el_control_type(&pv, uia.el_from_node(&pv, pg)) == uia.CT_PROGRESSBAR, "progress -> ProgressBar (50012)")
    check(uia.el_control_type(&pv, uia.el_from_node(&pv, r1)) == uia.CT_RADIOBUTTON, "radio -> RadioButton (50013)")
    check(uia.el_control_type(&pv, uia.el_from_node(&pv, tg)) == uia.CT_BUTTON, "toggle switch -> Button + Toggle")
    check(uia.el_control_type(&pv, uia.el_from_node(&pv, vl)) == uia.CT_LIST, "virtual list -> List (50008)")
    check(uia.el_control_type(&pv, uia.el_from_node(&pv, dd)) == uia.CT_COMBOBOX, "dropdown -> ComboBox (50003)")
    check(name_is(&pv, uia.el_from_node(&pv, cb), "Dark mode"), "check box name 'Dark mode'")
    check(name_is(&pv, uia.el_from_node(&pv, qb), "Quit"), "button name 'Quit'")
    check(uia.el_is_heading(&pv, uia.el_from_node(&pv, hd)), "heading is a heading")
    // patterns
    let pcb: u32 = uia.el_patterns(&pv, uia.el_from_node(&pv, cb))
    check((pcb & uia.PAT_TOGGLE) != 0 as u32 && (pcb & uia.PAT_INVOKE) == 0 as u32, "check box: Toggle, not Invoke")
    let pqb: u32 = uia.el_patterns(&pv, uia.el_from_node(&pv, qb))
    check((pqb & uia.PAT_INVOKE) != 0 as u32 && (pqb & uia.PAT_TOGGLE) == 0 as u32, "button: Invoke, not Toggle")
    check(uia.el_has_pattern(&pv, uia.el_from_node(&pv, sl), uia.PAT_RANGE), "slider: RangeValue")
    check(uia.el_has_pattern(&pv, uia.el_from_node(&pv, pg), uia.PAT_RANGE), "progress: RangeValue")
    check(uia.el_has_pattern(&pv, uia.el_from_node(&pv, en), uia.PAT_VALUE), "entry: Value")
    check(uia.el_has_pattern(&pv, uia.el_from_node(&pv, r1), uia.PAT_SELITEM), "radio: SelectionItem")
    check(uia.el_has_pattern(&pv, uia.el_from_node(&pv, dd), uia.PAT_EXPAND), "dropdown: ExpandCollapse")
    check(uia.pattern_id(uia.PAT_INVOKE) == 10000 as u32 && uia.pattern_id(uia.PAT_TOGGLE) == 10015 as u32
        && uia.pattern_id(uia.PAT_RANGE) == 10003 as u32 && uia.pattern_id(uia.PAT_VALUE) == 10002 as u32,
        "UIA_PatternIds: Invoke 10000, Value 10002, RangeValue 10003, Toggle 10015")
    // state
    check(uia.el_enabled(&pv, uia.el_from_node(&pv, cb)) && uia.el_focusable(&pv, uia.el_from_node(&pv, cb)), "check box enabled + keyboard focusable")
    check(uia.el_toggle_state(&pv, uia.el_from_node(&pv, cb)) == uia.TOG_OFF, "check box starts Off")
    click(a, s, cb)
    check(uia.el_toggle_state(&pv, uia.el_from_node(&pv, cb)) == uia.TOG_ON, "after the click: On")
    check(uia.el_range_value(&pv, uia.el_from_node(&pv, sl)) == 400, "slider value 40 of 100 = 400 of 0..1000")
    check(uia.el_range_min() == 0 && uia.el_range_max() > 0, "range min 0, max > 0")
    // geometry
    var q: [i64; 4] = [0; 4]
    uia.el_rect(&pv, uia.el_from_node(&pv, cb), &q)
    check(q[0] == (scene.node_x(sc, cb) as i64) + 100 && q[1] == (scene.node_y(sc, cb) as i64) + 50
        && q[2] == (scene.node_w(sc, cb) as i64) && q[3] > 0, "rect = scene rect + window origin (100,50)")
    let hit: uia.El = uia.el_from_point(&pv, q[0] + q[2] / 2, q[1] + q[3] / 2)
    check(uia.el_equal(hit, uia.el_from_node(&pv, cb)), "hit test at the check box centre returns the check box")
    check(uia.el_is_none(uia.el_from_point(&pv, 5, 5)), "hit test outside the window returns none")
    // tree
    walk(&pv, root, 0)
    say("  walked ")
    say_num(WALKED as i64)
    say(" elements\n")
    check(NAV_BAD == 0, "navigation: parent(first/last) = e, prev(first) none, next(last) none, next/prev inverse, counts agree")
    check(RID_BAD == 0, "runtime ids are unique")
    // parity with the AT-SPI bridge: same tree
    var br: atspi.Bridge = atspi.bridge_new(sc, app.ax(a), "Settings")
    let total: usize = atspi.bridge_node_total(&br)
    check(WALKED + 1 == total, "same element count as the AT-SPI bridge (UIA tree + the application object)")
    // virtual rows
    let vrow: uia.El = uia.el_first_child(&pv, uia.el_from_node(&pv, vl))
    check(uia.el_control_type(&pv, vrow) == uia.CT_LISTITEM && name_is(&pv, vrow, "Row 00"), "first virtual row: ListItem 'Row 00'")
    var ab: rt.Buf = rt.buf_new()
    check(uia.el_automation_id(vrow, &ab) > 3, "virtual row has an automation id v<i>_<row>")
    rt.buf_free(&ab)
    check(uia.el_has_pattern(&pv, vrow, uia.PAT_SELITEM), "virtual row: SelectionItem")
    check(uia.control_type_of(a11y.ROLE_LINK) == uia.CT_HYPERLINK && uia.control_type_of(a11y.ROLE_GENERIC) == uia.CT_CUSTOM,
        "role table: link -> Hyperlink, generic -> Custom")
    say("UIA bad=")
    say_num(BAD as i64)
    say("\n")
    atspi.bridge_free(&br)
    if BAD > 0 { return 1 }
    return 0
}
