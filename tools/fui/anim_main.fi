// SPDX-License-Identifier: MPL-2.0
// tools/fui/anim_main.fi -- THE CHECK OF lib/fui/uianim.fi (animated GIF and WebP in fUi).
//
// The frames and delays of the test pictures come from Pillow (the expectation below is
// Pillow's, not this library's): for every frame the CRC-32 of its RGBA octets, for every
// frame its delay, and the loop count. The clock is then run millisecond by millisecond and
// the frame on screen is compared with the frame a table of the cumulative delays says:
// the first tick starts the show, a delay under 20 ms is 100 ms for a GIF (0 for 100 in the
// last frame of anim.gif), loops end on the last frame (anim_ll.webp: 3 passes), forever
// loops wrap, pause and resume keep the time the frame had left, a program stopped for ten
// minutes jumps to the right frame and does not play the missed ones. Then the Markdown
// view: an image whose hook gives an animation changes its pixels with `mdv_tick`, and
// `mdv_next_ms` says when.
//
//     firnc -o /tmp/anim tools/fui/anim_main.fi && /tmp/anim     (run from the repository root)
import std.rt
import std.io
import std.deflate
import paint.canvas
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.style
import fui.viewport
import fui.markdownview
import fui.uianim
import fui.uiimage
import markdown.doc
import plat.sysfont

static mut BAD: usize = 0
static mut CHECKS: usize = 0
static mut ANIM_PTR: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: io.Fmt) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    io.fmt_print_line(what)
}

fn load(path: str, out: *mut rt.Buf) -> bool {
    var p: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&p, path.p as u64, path.n)
    rt.buf_push(&p, 0 as u8)
    let ok: bool = rt.read_file(rt.buf_ptr(&p), out)
    rt.buf_free(&p)
    return ok
}

fn frame_crc(a: *mut uianim.Animation, i: usize) -> u32 {
    uianim.anim_set_frame(a, i)
    var im: uiimage.Image = uianim.anim_frame_image(a)
    return deflate.crc32(im.px, uianim.anim_width(a) * uianim.anim_height(a) * 4)
}

// the frame a cumulative table says is on screen `t` ms after the first tick, with `loops`
// passes (0 = forever); `delays` are the PLAYED delays
fn expect_frame(delays: *mut [i64; 8], n: usize, loops: u32, t: i64) -> usize {
    var total: i64 = 0
    var i: usize = 0
    while i < n {
        total = total + (*delays)[i]
        i = i + 1
    }
    if loops != 0 as u32 && t >= total * (loops as i64) {
        return n - 1
    }
    var r: i64 = t % total
    i = 0
    while i < n {
        if r < (*delays)[i] {
            return i
        }
        r = r - (*delays)[i]
        i = i + 1
    }
    return n - 1
}

// runs the clock for `span` ms in steps of `step` and counts the frames that differ from the table
fn run_clock(a: *mut uianim.Animation, delays: *mut [i64; 8], n: usize, loops: u32, span: i64, step: i64, start: i64) -> usize {
    uianim.anim_reset(a)
    uianim.anim_tick(a, start)
    var wrong: usize = 0
    var t: i64 = 0
    while t <= span {
        uianim.anim_tick(a, start + t)
        if uianim.anim_frame_index(a) != expect_frame(delays, n, loops, t) {
            wrong = wrong + 1
        }
        t = t + step
    }
    return wrong
}

fn run_file(path: str, w: usize, h: usize, count: usize, loops: u32, crcs: *mut [u32; 8], delays: *mut [i64; 8], total: i64) {
    var data: rt.Buf = rt.buf_new()
    if !load(path, &data) {
        check(false, f"{path}: readable (run from the repository root)")
        return
    }
    var a: uianim.Animation = uianim.anim_new()
    check(uianim.anim_from_bytes(rt.buf_ptr(&data), rt.buf_len(&data), &a), f"{path}: decodes")
    check(uianim.anim_count(&a) == count && uianim.anim_width(&a) == w && uianim.anim_height(&a) == h,
        f"{path}: {count} frames of {w} x {h}")
    check(uianim.anim_loops(&a) == loops, f"{path}: loop count {loops}")
    var bad: usize = 0
    var i: usize = 0
    while i < count {
        if frame_crc(&a, i) != (*crcs)[i] {
            bad = bad + 1
        }
        i = i + 1
    }
    check(bad == 0, f"{path}: every frame's pixels are Pillow's ({count} frames)")
    var dok: bool = true
    i = 0
    while i < count {
        if uianim.anim_delay_ms(&a, i) != (*delays)[i] {
            dok = false
        }
        i = i + 1
    }
    check(dok && uianim.anim_total_ms(&a) == total, f"{path}: the played delays and the pass length ({total} ms)")
    // the clock, 1 ms steps over four passes
    let wrong: usize = run_clock(&a, delays, count, loops, total * 4 + 50, 1, 1000)
    check(wrong == 0, f"{path}: the frame on screen follows the delays for 4 passes (1 ms steps), {wrong} wrong")
    // coarse steps (a slow program ticking every 37 ms) land on the same frames
    let wrong2: usize = run_clock(&a, delays, count, loops, total * 4 + 50, 37, 5)
    check(wrong2 == 0, f"{path}: ticking every 37 ms gives the same frames, {wrong2} wrong")
    // the first tick starts the show and changes nothing; frame 0 is on screen
    uianim.anim_reset(&a)
    check(!uianim.anim_tick(&a, 777) && uianim.anim_frame_index(&a) == 0, f"{path}: the first tick starts the clock")
    check(uianim.anim_next_ms(&a, 777) == (*delays)[0], f"{path}: next change in {(*delays)[0]} ms")
    check(!uianim.anim_tick(&a, 777 + (*delays)[0] - 1), f"{path}: one ms early: no change")
    check(uianim.anim_tick(&a, 777 + (*delays)[0]) && uianim.anim_frame_index(&a) == 1, f"{path}: on time: frame 1")
    // pause keeps the time the frame had left
    let at: i64 = 777 + (*delays)[0]
    uianim.anim_pause(&a, at + 10)
    check(!uianim.anim_tick(&a, at + 100000) && uianim.anim_next_ms(&a, at + 100000) == 0 - 1, f"{path}: paused: no change, nothing to wait for")
    uianim.anim_resume(&a, at + 100010)
    check(uianim.anim_next_ms(&a, at + 100010) == (*delays)[1] - 10, f"{path}: resumed with the {(*delays)[1] - 10} ms the frame had left")
    // a program stopped for ten minutes: one tick jumps to the right frame
    uianim.anim_reset(&a)
    uianim.anim_tick(&a, 0)
    let late: i64 = 600000 + 13
    uianim.anim_tick(&a, late)
    var want: usize = expect_frame(delays, count, loops, late)
    check(uianim.anim_frame_index(&a) == want, f"{path}: after ten minutes of no ticks: frame {want} (is {uianim.anim_frame_index(&a)})")
    if loops != 0 as u32 {
        check(uianim.anim_finished(&a) && uianim.anim_frame_index(&a) == count - 1, f"{path}: {loops} passes used up: stands on the last frame")
        check(uianim.anim_next_ms(&a, late) == 0 - 1, f"{path}: finished: nothing to wait for")
    } else {
        check(!uianim.anim_finished(&a), f"{path}: loops forever")
    }
    uianim.anim_free(&a)
    rt.buf_free(&data)
}

// -------------------------------------------------------------- the Markdown view

fn on_image(ud: u64, url: u64, n: usize, info: *mut markdownview.ImgInfo) -> u32 {
    let a: *mut uianim.Animation = ANIM_PTR as *mut uianim.Animation
    (*info).w = uianim.anim_width(a)
    (*info).h = uianim.anim_height(a)
    (*info).anim = ANIM_PTR
    return markdownview.IMG_READY
}

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
    w: usize,
    h: usize,
}

fn page_new(w: usize, h: usize, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(false)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    (*p).w = w
    (*p).h = h
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

// a hash of the canvas
fn canvas_hash(p: *mut Page) -> u32 {
    var h: u32 = 2166136261 as u32
    var y: usize = 0
    while y < (*p).h {
        var x: usize = 0
        while x < (*p).w {
            h = (h ^ canvas.canvas_get(&(*p).cv, x, y)) *% 16777619 as u32
            x = x + 1
        }
        y = y + 1
    }
    return h
}

#[allow_escape]
fn run_view(font: u64) {
    var data: rt.Buf = rt.buf_new()
    if !load("tests/data/gif/anim.gif", &data) {
        check(false, f"anim.gif readable")
        return
    }
    var a: uianim.Animation = uianim.anim_new()
    uianim.anim_from_bytes(rt.buf_ptr(&data), rt.buf_len(&data), &a)
    ANIM_PTR = (&a) as u64
    let p: *mut Page = page_new(300, 200, font)
    var v: markdownview.MdView = markdownview.mdv_new()
    markdownview.mdv_set_markdown(&v, "# Picture\n\n![spinner](anim.gif)\n", doc.opts_default())
    markdownview.mdv_set_image_cb(&v, 0, on_image)
    markdownview.mdv_set_background(&v, style.TOK_BASE)
    markdownview.mdv_set_rect(&v, 0.0, 0.0, 300.0, 200.0)
    canvas.canvas_clear(&(*p).cv, 0xFFF4F4F6 as u32)
    markdownview.mdv_paint(&v, &(*p).c)
    let h0: u32 = canvas_hash(p)
    check(markdownview.mdv_next_ms(&v, 0) == 0, f"the view says an animation wants its first tick")
    markdownview.mdv_tick(&v, 5000)
    check(markdownview.mdv_next_ms(&v, 5000) == 50, f"the view: next change in 50 ms (the first frame's delay)")
    check(!markdownview.mdv_tick(&v, 5049), f"no change one ms early")
    check(markdownview.mdv_tick(&v, 5050), f"the tick on time says: repaint")
    canvas.canvas_clear(&(*p).cv, 0xFFF4F4F6 as u32)
    markdownview.mdv_paint(&v, &(*p).c)
    let h1: u32 = canvas_hash(p)
    check(h0 != h1, f"frame 1 paints other pixels than frame 0")
    // after a whole pass the picture is the first again
    markdownview.mdv_tick(&v, 5050 + 100 + 70 + 20 + 100)
    canvas.canvas_clear(&(*p).cv, 0xFFF4F4F6 as u32)
    markdownview.mdv_paint(&v, &(*p).c)
    check(canvas_hash(p) == h0, f"a whole pass later it is frame 0 again")
    // a view without an animated picture has nothing to wait for
    var v2: markdownview.MdView = markdownview.mdv_new()
    markdownview.mdv_set_markdown(&v2, "# No picture\n", doc.opts_default())
    check(markdownview.mdv_next_ms(&v2, 0) == 0 - 1, f"no animated image: nothing to wait for")
    markdownview.mdv_free(&v2)
    markdownview.mdv_free(&v)
    uianim.anim_free(&a)
    rt.buf_free(&data)
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("anim: no font (DejaVu Sans)\n")
        return 9
    }
    var c1: [u32; 8] = [127307801 as u32, 2909372847 as u32, 3034097713 as u32, 1689689223 as u32, 431876796 as u32, 0 as u32, 0 as u32, 0 as u32]
    var d1: [i64; 8] = [50, 100, 70, 20, 100, 0, 0, 0]
    run_file("tests/data/gif/anim.gif", 50, 40, 5, 0 as u32, &c1, &d1, 340)
    var c2: [u32; 8] = [3993169432 as u32, 1246377520 as u32, 75956809 as u32, 818208761 as u32, 3142957108 as u32, 2036291222 as u32, 0 as u32, 0 as u32]
    var d2: [i64; 8] = [40, 80, 120, 40, 40, 200, 0, 0]
    run_file("tests/data/webp/anim_ll.webp", 48, 32, 6, 3 as u32, &c2, &d2, 520)
    var c3: [u32; 8] = [873858455 as u32, 2012417856 as u32, 3877206944 as u32, 3092053462 as u32, 474199550 as u32, 1963128999 as u32, 0 as u32, 0 as u32]
    var d3: [i64; 8] = [100, 100, 100, 100, 100, 100, 0, 0]
    run_file("tests/data/webp/anim_lossy.webp", 48, 32, 6, 0 as u32, &c3, &d3, 600)
    var c4: [u32; 8] = [2142182662 as u32, 71501888 as u32, 2955616923 as u32, 2960452949 as u32, 294095467 as u32, 2468994545 as u32, 0 as u32, 0 as u32]
    var d4: [i64; 8] = [80, 80, 80, 80, 80, 80, 0, 0]
    run_file("tests/data/gif/disp.gif", 48, 32, 6, 2 as u32, &c4, &d4, 480)
    run_view(fs as u64)
    say("checks: ")
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&nb, CHECKS as u64)
    rt.write_everything(1, rt.buf_ptr(&nb), rt.buf_len(&nb))
    rt.buf_free(&nb)
    say("\n")
    if BAD == 0 {
        say("ANIM PASSED\n")
        return 0
    }
    say("ANIM FAILED\n")
    return 1
}
