// SPDX-License-Identifier: MPL-2.0
// tools/fui/fuzz_main.fi -- FUZZ + SOAK: random events into a real fUi window, no crash, stable memory.
//
//     fuzz_main [events] [seed]      default 100000 events, seed 1
//
// Builds a window with a menu bar, a button with a tooltip, a context menu, a checkbox, a toggle, a
// slider, a spin box, a drop-down, an expander, an entry and a text area, then throws N random events
// at it through the entry points the platform hosts call (fuiwirt pointer / key / char / tick, app_key,
// app_char), repaints every few events and opens message/confirm/input dialogs now and then.
//
// What is checked:
//   1. the program is still running after N events (a crash would end it with a signal)
//   2. SOAK: the resident set (VmRSS) after the first 25 % of the events versus the end. The window
//      grows its caches in the first quarter; after that it must not grow by more than SOAK_KB.
//   3. the heap of the process does not shrink the frame: a final frame paints and the window still
//      answers a click on the checkbox with a change callback.
// Prints FUZZ events=.. rss_kb_start=.. rss_kb_quarter=.. rss_kb_end=.. and FUZZ PASSED / FAILED.
import std.rt
import paint.canvas
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.action

const SOAK_KB: i64 = 6144
static mut CHANGES: usize = 0
static mut ANSWERS: usize = 0
static mut FONT: u64 = 0
static mut RNG: u64 = 1

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_num(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// xorshift64
fn rnd() -> u64 {
    var x: u64 = RNG
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    RNG = x
    return x
}

fn rnd_to(n: u64) -> u64 {
    return (rnd() >> 11) % n
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h) || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn answered(a: *mut app.App, ans: u32) {
    ANSWERS = ANSWERS + 1
}

fn btn_none(a: *mut app.App) {
}

// VmRSS of this process in KB (0 if /proc is not readable)
fn rss_kb() -> i64 {
    var buf: rt.Buf = rt.buf_new()
    var path: [u8; 18] = "/proc/self/status\0"
    if !rt.read_file((&path[0]) as u64, &buf) {
        return 0
    }
    let p: u64 = rt.buf_ptr(&buf)
    let n: usize = rt.buf_len(&buf)
    var i: usize = 0
    while i + 6 < n {
        if rt.ld8(p, i) == 86 as u8 && rt.ld8(p, i + 1) == 109 as u8 && rt.ld8(p, i + 2) == 82 as u8
        && rt.ld8(p, i + 3) == 83 as u8 && rt.ld8(p, i + 4) == 83 as u8 && rt.ld8(p, i + 5) == 58 as u8 {
            var j: usize = i + 6
            var v: i64 = 0
            while j < n && (rt.ld8(p, j) < 48 as u8 || rt.ld8(p, j) > 57 as u8) {
                j = j + 1
            }
            while j < n && rt.ld8(p, j) >= 48 as u8 && rt.ld8(p, j) <= 57 as u8 {
                v = v * 10 + ((rt.ld8(p, j) as i64) - 48)
                j = j + 1
            }
            rt.buf_free(&buf)
            return v
        }
        i = i + 1
    }
    rt.buf_free(&buf)
    return 0
}

fn arg_num(start: u64, i: usize, dflt: u64) -> u64 {
    if rt.arg_count(start) <= i {
        return dflt
    }
    let p: u64 = rt.arg_ptr(start, i)
    var v: u64 = 0
    var k: usize = 0
    while rt.ld8(p, k) >= 48 as u8 && rt.ld8(p, k) <= 57 as u8 {
        v = v * 10 + ((rt.ld8(p, k) as u64) - 48)
        k = k + 1
    }
    if k == 0 {
        return dflt
    }
    return v
}

fn one_event(a: *mut app.App, s: *mut Surface, ms: i64) {
    let w: *mut fuiwirt.Host = app.app_host(a)
    let kind: u64 = rnd_to(100)
    let x: f64 = (rnd_to(700) as f64) - 60.0
    let y: f64 = (rnd_to(560) as f64) - 60.0
    if kind < 30 {
        let c: u32 = fuiwirt.host_pointer_move(w, x, y)
    } else if kind < 42 {
        let c: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    } else if kind < 54 {
        let c: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
    } else if kind < 58 {
        let c: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_RIGHT)
    } else if kind < 60 {
        let c: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_RIGHT)
    } else if kind < 62 {
        let c: u32 = fuiwirt.host_pointer_leave(w)
    } else if kind < 64 {
        let c: u32 = fuiwirt.host_pointer_cancel(w)
    } else if kind < 78 {
        let k: u32 = (rnd_to(14) as u32) + 1 as u32
        let m: u32 = rnd_to(16) as u32
        let used: bool = app.app_key(a as u64, k, m)
        if !used {
            let h: u32 = fuiwirt.host_key(w, k, m)
        }
    } else if kind < 92 {
        // a character: ASCII mostly, sometimes any code point in the BMP or beyond
        var cp: u32 = (rnd_to(95) as u32) + 32 as u32
        if rnd_to(8) == 0 {
            cp = rnd_to(1114112) as u32
        }
        var m: u32 = 0 as u32
        if rnd_to(6) == 0 {
            m = editor.MOD_ALT
        }
        let used: bool = app.app_char(a as u64, cp, m)
        if !used {
            let h: u32 = fuiwirt.host_char(w, cp, m)
        }
    } else {
        fuiwirt.host_tick(w, ms)
    }
    let i: usize = fuiwirt.host_take_activated(w)
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("fuzz: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let total: u64 = arg_num(start, 1, 100000)
    RNG = arg_num(start, 2, 1) * 2654435761 + 88172645463325252
    let a: *mut app.App = app.window("Fuzz", 640, 480)
    let bar: usize = appctl.menubar(a)
    let mf: usize = appctl.menu(a, "&File")
    let i_new: usize = appctl.menu_item(a, mf, "file.new", "&New", changed)
    let i_open: usize = appctl.menu_item(a, mf, "file.open", "&Open", changed)
    let sp: bool = appctl.menu_sep(a, mf)
    let i_quit: usize = appctl.menu_item(a, mf, "file.quit", "&Quit", changed)
    let me: usize = appctl.menu(a, "&Edit")
    let i_wrap: usize = appctl.menu_check(a, me, "edit.wrap", "&Wrap", true, changed)
    appctl.menubar_end(a)
    let bt: usize = app.button(a, "Save", btn_none)
    let tp: bool = appctl.tooltip(a, bt, "Save the file")
    let lb: usize = app.label(a, "Right-click me", 0)
    let pm: usize = appctl.popup_menu(a)
    let i_copy: usize = appctl.menu_item(a, pm, "ctx.copy", "&Copy", changed)
    let cm: bool = appctl.context_menu(a, lb, pm)
    let cbx: usize = appctl.checkbox(a, "Behind", false, changed)
    let tg: usize = appctl.toggle(a, "Wi-Fi", true, changed)
    let sl: usize = appctl.slider(a, "Volume", 0, 100, 30, changed)
    let sb: usize = appctl.spinbox(a, "Count", 0, 50, 1, 5, changed)
    let dd: usize = appctl.dropdown(a, "Language", changed)
    let d1: bool = appctl.dropdown_add(a, dd, "English")
    let d2: bool = appctl.dropdown_add(a, dd, "Deutsch")
    let d3: bool = appctl.dropdown_add(a, dd, "Russian")
    let ex: usize = appctl.expander(a, "More", false, changed)
    let en: usize = app.entry(a, "type here")
    let ta: usize = app.textarea(a, "notes", 4)
    fuiwirt.host_bind(app.app_host(a))
    let s: *mut Surface = surface_for(a, 640, 480)
    if s as u64 == 0 {
        say("fuzz: no surface\n")
        return 8
    }
    frame(a, s)
    frame(a, s)
    let rss0: i64 = rss_kb()
    var rssq: i64 = 0
    var ms: i64 = 1000
    var n: u64 = 0
    while n < total {
        one_event(a, s, ms)
        ms = ms + 7
        if n % 5 == 4 {
            frame(a, s)
        }
        if n % 997 == 996 {
            // dialogs come and go: the random events answer or leave them
            let k: u64 = rnd_to(3)
            if k == 0 {
                let ok: bool = appctl.message(a, "Note", "A message that was opened by the fuzzer.", answered)
            } else if k == 1 {
                let ok: bool = appctl.confirm(a, "Sure?", "Delete everything?", answered)
            } else {
                let ok: bool = appctl.input(a, "Name", "Your name:", "x", answered)
            }
        }
        n = n + 1
        if n == total / 4 {
            rssq = rss_kb()
        }
    }
    frame(a, s)
    let rss1: i64 = rss_kb()
    say("FUZZ events=")
    say_num(total as i64)
    say(" changes=")
    say_num(CHANGES as i64)
    say(" answers=")
    say_num(ANSWERS as i64)
    say(" rss_kb_start=")
    say_num(rss0)
    say(" rss_kb_quarter=")
    say_num(rssq)
    say(" rss_kb_end=")
    say_num(rss1)
    say("\n")
    if rssq > 0 && rss1 - rssq > SOAK_KB {
        say("FUZZ FAILED: resident set grew after the first quarter\n")
        return 1
    }
    say("FUZZ PASSED\n")
    return 0
}
