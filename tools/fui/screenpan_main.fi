import std.rt
import fui.editor
import fui.kitscroll
import fui.render
import fui.screen
import fui.screenext
import fui.screenpan
import plat.fuiwirt

static mut BAD: usize = 0
static mut PRESSES: usize = 0
static mut PRESS_X: f64 = 0.0
static mut PRESS_Y: f64 = 0.0
static mut PANS: usize = 0
static mut PAN_SUM: f64 = 0.0
static mut POINTER_UPS: usize = 0
static mut OPEN: bool = false
static mut BACKS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn on_press(ud: u64, x: f64, y: f64) {
    PRESSES = PRESSES + 1
    PRESS_X = x
    PRESS_Y = y
}

fn on_pan(ud: u64, x: f64, y: f64, dy: f64) -> bool {
    PANS = PANS + 1
    PAN_SUM = PAN_SUM + dy
    return true
}

fn on_pointer(ud: u64, kind: u32, x: f64, y: f64) -> bool {
    if kind == fuiwirt.HOOK_UP { POINTER_UPS = POINTER_UPS + 1 }
    return false
}

fn on_key(ud: u64, k: u32, mods: u32) -> bool { return false }
fn wanted(ud: u64) -> bool { return OPEN }
fn go(ud: u64) {
    OPEN = false
    BACKS = BACKS + 1
}

fn state_machine() {
    var p: screenpan.Pan = screenpan.pan_new()
    check(screenpan.pan_up(&p) == screenpan.UP_NONE, "release without a press is nothing")
    screenpan.pan_down(&p, 100.0, 100.0)
    check(screenpan.pan_move(&p, 104.0, 108.0) == 0.0 && !screenpan.pan_active(&p), "movement inside the slop is not a pan")
    check(screenpan.pan_up(&p) == screenpan.UP_TAP, "a press and release inside the slop is a tap")
    screenpan.pan_down(&p, 100.0, 100.0)
    let a: f64 = screenpan.pan_move(&p, 100.0, 130.0)
    check(a == 0.0 && screenpan.pan_active(&p), "crossing the slop starts the pan without a jump")
    check(screenpan.pan_move(&p, 100.0, 150.0) == 20.0, "the next move reports the step")
    check(screenpan.pan_move(&p, 100.0, 140.0) == 0.0 - 10.0, "moving back reports a negative step")
    check(screenpan.pan_up(&p) == screenpan.UP_PAN, "a release after a pan is not a tap")
    screenpan.pan_down(&p, 10.0, 10.0)
    let b: f64 = screenpan.pan_move(&p, 60.0, 12.0)
    check(screenpan.pan_active(&p), "a sideways swipe also leaves the tap")
    screenpan.pan_cancel(&p)
    check(screenpan.pan_up(&p) == screenpan.UP_NONE, "cancel forgets the press")
}

fn scroll() {
    var s: kitscroll.Scroll = kitscroll.scroll_new()
    kitscroll.scroll_fit(&s, 1000.0, 400.0, 48.0)
    check(!kitscroll.scroll_pan(&s, 50.0) && s.pos == 0.0, "pulling down at the top does not move")
    check(kitscroll.scroll_pan(&s, 0.0 - 120.0) && s.pos == 120.0, "dragging up by 120 scrolls 120 down")
    check(kitscroll.scroll_pan(&s, 0.0 - 900.0) && s.pos == 600.0, "the end clamps at content - view")
    check(kitscroll.scroll_pan(&s, 1000.0) && s.pos == 0.0, "the start clamps at 0")
    check(kitscroll.scroll_by(&s, 2.0) && s.pos == 96.0, "wheel notches still use the step")
}

fn on_screen() {
    let p: u64 = rt.heap_alloc(screen.size_of_screen())
    let s: *mut screen.Screen = p as *mut screen.Screen
    *s = screen.screen_blank()
    (*s).press = on_press
    (*s).pointer = on_pointer
    (*s).key = on_key
    (*s).ex = screenext.extras_back(screenext.extras_pan(screenext.extras_blank(), on_pan), wanted, go)
    screen.on_press(p, 50.0, 60.0)
    check(PRESSES == 0, "a press is held until the release")
    let r1: bool = screen.on_hook(p, fuiwirt.HOOK_UP, 50.0, 60.0)
    check(PRESSES == 1 && PRESS_X == 50.0 && PRESS_Y == 60.0 && POINTER_UPS == 1, "a tap presses at the release with the down position")
    screen.on_press(p, 50.0, 60.0)
    let m1: bool = screen.on_hook(p, fuiwirt.HOOK_MOVE, 50.0, 90.0)
    let m2: bool = screen.on_hook(p, fuiwirt.HOOK_MOVE, 50.0, 110.0)
    let m3: bool = screen.on_hook(p, fuiwirt.HOOK_MOVE, 50.0, 100.0)
    check(PANS == 2 && PAN_SUM == 10.0, "a drag calls pan with the steps after the slop")
    let r2: bool = screen.on_hook(p, fuiwirt.HOOK_UP, 50.0, 100.0)
    check(PRESSES == 1 && POINTER_UPS == 1, "a drag is no press and no pointer release")
    screen.on_press(p, 50.0, 60.0)
    let l1: bool = screen.on_hook(p, fuiwirt.HOOK_LEAVE, 0.0, 0.0)
    let r3: bool = screen.on_hook(p, fuiwirt.HOOK_UP, 50.0, 60.0)
    check(PRESSES == 1, "leaving the window cancels the held press")
    check(!screen.on_key(p, editor.KEY_ESC, 0 as u32) && BACKS == 0, "Escape with no detail open is not taken")
    OPEN = true
    check(screen.on_key(p, editor.KEY_ESC, 0 as u32) && BACKS == 1 && !OPEN, "Escape with a detail open goes back")
}

fn main(start: u64) -> i32 {
    state_machine()
    scroll()
    on_screen()
    if BAD == 0 {
        say("SCREENPAN PASSED\n")
        return 0
    }
    say("SCREENPAN FAILED\n")
    return 1
}
