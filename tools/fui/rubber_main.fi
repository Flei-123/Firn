// SPDX-License-Identifier: MPL-2.0
import std.rt
import fui.viewport

static mut ERRORS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_int(v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn check(name: str, ok: bool) {
    say("  ")
    say(name)
    var k: usize = name.n
    while k < 62 {
        say(" ")
        k = k + 1
    }
    if ok {
        say("OK\n")
    } else {
        say("WRONG\n")
        ERRORS = ERRORS + 1
    }
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.00001
}

fn apart(a: f64, b: f64, by: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d > by
}

fn old_brake(os: f64, d: f64, lim: f64) -> f64 {
    var a: f64 = os
    if a < 0.0 { a = 0.0 - a }
    var k: f64 = 1.0 - a / lim
    if k < 0.0 { k = 0.0 }
    var r: f64 = os + d * k * 0.5
    if r > lim { r = lim }
    if r < 0.0 - lim { r = 0.0 - lim }
    return r
}

fn tall() -> viewport.Viewport {
    var v: viewport.Viewport = viewport.viewport_new(0.0, 0.0, 200.0, 100.0, 200.0, 400.0)
    viewport.viewport_set_bar(&v, 0)
    return v
}

fn wide() -> viewport.Viewport {
    var v: viewport.Viewport = viewport.viewport_new(0.0, 0.0, 200.0, 100.0, 800.0, 100.0)
    viewport.viewport_set_bar(&v, 0)
    return v
}

fn rest(vp: *mut viewport.Viewport, t0: i64) -> bool {
    var t: i64 = t0
    while t < t0 + 3000 {
        viewport.viewport_tick(vp, t)
        t = t + 16
    }
    return viewport.viewport_over_y(vp) == 0.0 && viewport.viewport_over_x(vp) == 0.0 && !viewport.viewport_moving(vp)
}

fn vertical(x: f64, want: f64) {
    var vp: viewport.Viewport = tall()
    viewport.viewport_drag(&vp, 0.0, 0.0 - x, 100)
    check("pull at the top", near(viewport.viewport_over_y(&vp), 0.0 - want))
    var ve: viewport.Viewport = tall()
    viewport.viewport_set_offset(&ve, 0.0, 300.0)
    viewport.viewport_drag(&ve, 0.0, x, 100)
    check("pull at the bottom", near(viewport.viewport_over_y(&ve), want))
    check("the logic offset stays at the edge", viewport.viewport_off_y(&ve) == 300.0 && viewport.viewport_off_y(&vp) == 0.0)
}

fn horizontal(x: f64, want: f64) {
    var vp: viewport.Viewport = wide()
    viewport.viewport_drag(&vp, 0.0 - x, 0.0, 100)
    check("pull at the left", near(viewport.viewport_over_x(&vp), 0.0 - want))
    var ve: viewport.Viewport = wide()
    viewport.viewport_set_offset(&ve, 600.0, 0.0)
    viewport.viewport_drag(&ve, x, 0.0, 100)
    check("pull at the right", near(viewport.viewport_over_x(&ve), want))
}

fn main() -> i32 {
    say("-- reference values, vertical, d = 100\n")
    vertical(10.0, 5.213270)
    vertical(30.0, 14.163090)
    vertical(100.0, 35.483871)
    vertical(300.0, 62.264151)
    vertical(1000.0, 84.615385)
    say("-- reference values, horizontal, d = 200\n")
    horizontal(20.0, 10.426540)
    horizontal(100.0, 43.137255)
    horizontal(400.0, 104.761905)

    say("-- the band depends on the total pull, not on how it is cut up\n")
    var vs: viewport.Viewport = tall()
    var k: i64 = 0
    while k < 10 {
        viewport.viewport_drag(&vs, 0.0, 0.0 - 10.0, 100 + k)
        k = k + 1
    }
    check("ten pulls of 10 equal one pull of 100", near(viewport.viewport_over_y(&vs), 0.0 - 35.483871))
    viewport.viewport_drag(&vs, 0.0, 0.0 - 200.0, 120)
    check("a further 200 reaches the value for 300", near(viewport.viewport_over_y(&vs), 0.0 - 62.264151))
    viewport.viewport_drag(&vs, 0.0, 100.0, 130)
    check("pulling back 100 gives the value for 200", near(viewport.viewport_over_y(&vs), 0.0 - viewport.viewport_rubber(200.0, 100.0)))
    check("value for 200 is 52.4", near(viewport.viewport_over_y(&vs), 0.0 - 52.380952))
    viewport.viewport_drag(&vs, 0.0, 500.0, 140)
    check("pulling back past the start ends the band at 0", viewport.viewport_over_y(&vs) == 0.0)

    say("-- the formula\n")
    check("rubber(0) = 0", viewport.viewport_rubber(0.0, 100.0) == 0.0)
    check("rubber stays below the viewport size", viewport.viewport_rubber(100000.0, 100.0) < 100.0)
    check("rubber(x, d) = (1 - 1 / (0.55 x / d + 1)) d", near(viewport.viewport_rubber(50.0, 120.0), (1.0 - 1.0 / (0.55 * 50.0 / 120.0 + 1.0)) * 120.0))
    check("inverse round trip", near(viewport.viewport_rubber_raw(viewport.viewport_rubber(77.0, 100.0), 100.0), 77.0))

    say("-- release returns to 0\n")
    var vr: viewport.Viewport = tall()
    viewport.viewport_drag(&vr, 0.0, 0.0 - 300.0, 100)
    check("band is out before the release", viewport.viewport_over_y(&vr) < 0.0 - 50.0)
    check("the band springs back to exactly 0 and rests", rest(&vr, 200))
    var vb: viewport.Viewport = tall()
    viewport.viewport_set_offset(&vb, 0.0, 300.0)
    viewport.viewport_drag(&vb, 0.0, 300.0, 100)
    check("bottom band springs back", rest(&vb, 200) && viewport.viewport_off_y(&vb) == 300.0)
    var vh: viewport.Viewport = wide()
    viewport.viewport_drag(&vh, 0.0 - 300.0, 0.0, 100)
    check("left band springs back", rest(&vh, 200))
    var vh2: viewport.Viewport = wide()
    viewport.viewport_set_offset(&vh2, 600.0, 0.0)
    viewport.viewport_drag(&vh2, 300.0, 0.0, 100)
    check("right band springs back", rest(&vh2, 200))

    say("-- switches\n")
    var vo: viewport.Viewport = tall()
    viewport.viewport_set_overscroll(&vo, false)
    viewport.viewport_drag(&vo, 0.0, 0.0 - 50.0, 100)
    check("touch overscroll can be switched off", viewport.viewport_over_y(&vo) == 0.0)
    viewport.viewport_set_overscroll(&vo, true)
    viewport.viewport_drag(&vo, 0.0, 0.0 - 50.0, 100)
    check("and on again", viewport.viewport_over_y(&vo) < 0.0)
    var vw: viewport.Viewport = tall()
    viewport.viewport_pull(&vw, 0.0, 0.0 - 50.0, 100)
    check("the wheel path stays off by default", viewport.viewport_over_y(&vw) == 0.0)
    viewport.viewport_set_wheel_overscroll(&vw, true)
    viewport.viewport_pull(&vw, 0.0, 0.0 - 100.0, 100)
    check("the wheel path follows the same formula once on", near(viewport.viewport_over_y(&vw), 0.0 - 35.483871))
    var vi: viewport.Viewport = tall()
    viewport.viewport_set_wheel_overscroll(&vi, false)
    viewport.viewport_drag(&vi, 0.0, 0.0 - 50.0, 100)
    check("the wheel switch leaves touch alone", viewport.viewport_over_y(&vi) < 0.0)

    say("-- counter-test: the old linear brake does not match the reference\n")
    let lim: f64 = 30.0
    check("old brake differs at x = 10", apart(old_brake(0.0, 0.0 - 10.0, lim), 0.0 - 5.213270, 0.1))
    check("old brake differs at x = 30", apart(old_brake(0.0, 0.0 - 30.0, lim), 0.0 - 14.163090, 0.5))
    check("old brake differs at x = 100", apart(old_brake(0.0, 0.0 - 100.0, lim), 0.0 - 35.483871, 3.0))
    check("old brake is capped at 30 % of the height", old_brake(0.0, 0.0 - 1000.0, lim) == 0.0 - 30.0)
    var ov: viewport.Viewport = tall()
    viewport.viewport_drag(&ov, 0.0, 0.0 - 1000.0, 100)
    check("the new band passes the old cap", viewport.viewport_over_y(&ov) < 0.0 - 80.0)

    say("\n")
    if ERRORS == 0 {
        say("RUBBER PASSED.\n")
        return 0
    }
    say("RUBBER FAILED: ")
    say_int(ERRORS as i64)
    say("\n")
    return 1
}
