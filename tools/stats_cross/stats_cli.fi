// tools/stats_cross/stats_cli.fi -- `lib/std/stats.fi` as a program (SKRIPT-LIBS r316).
//
//     stats_cli <in> <out>
//
// <in> is binary, little endian u64 words:
//     ndatasets, then per dataset:  n, lo(bits), hi(bits), then n values as f64 bits
// <out> has OUTW u64 words per dataset (f64 bits unless noted):
//     0 sum  1 mean  2 min  3 max  4 median
//     5..24 percentile at PCTS[0..20]
//     25 variance  26 stdev  27 pvariance  28 pstdev
//     29 histogram count (integer)  30 mismatches between the forms (integer; must be 0)
//     31..46 histogram counts of 16 bins over [lo, hi] (integers)
//     47 sum_exact  48 mean_exact
// The checker is tools/stats_cross/cross.py.
import std.rt
import std.vec
import std.math
import std.stats

fn bits(x: f64) -> u64 {
    return math.math_bits(x)
}

fn out(o: *mut Vec[u64], x: f64) {
    vec_push[u64](o, bits(x))
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 2
    }
    var src: rt.Buf = rt.buf_new()
    defer rt.buf_free(&src)
    if !rt.read_file(rt.arg_ptr(start, 1), &src) {
        return 4
    }
    let base: u64 = rt.buf_ptr(&src)
    var pcts: [f64; 20] = [0.0, 1.0, 5.0, 10.0, 20.0, 25.0, 30.0, 33.3, 40.0, 50.0, 60.0, 66.6, 70.0, 75.0, 80.0, 90.0, 95.0, 99.0, 99.9, 100.0]
    var res: Vec[u64] = vec_new[u64]()
    defer vec_free[u64](&res)
    let nsets: usize = rt.ld64(base, 0) as usize
    var pos: usize = 1
    var s: usize = 0
    while s < nsets {
        let n: usize = rt.ld64(base, pos) as usize
        let lo: f64 = math.math_f64(rt.ld64(base, pos + 1))
        let hi: f64 = math.math_f64(rt.ld64(base, pos + 2))
        pos = pos + 3
        var v: Vec[f64] = vec_new[f64]()
        var i: usize = 0
        while i < n {
            vec_push[f64](&v, math.math_f64(rt.ld64(base, pos + i)))
            i = i + 1
        }
        pos = pos + n
        let p: *mut f64 = vec_elem_ptr[f64](&v, 0)
        var bad: u64 = 0
        // sum .. median, raw pointer form and Vec form must agree bit for bit
        if bits(stats.sum(p, n)) != bits(stats.sum_vec(&v)) { bad = bad + 1 }
        if bits(stats.mean(p, n)) != bits(stats.mean_vec(&v)) { bad = bad + 1 }
        if bits(stats.min(p, n)) != bits(stats.min_vec(&v)) { bad = bad + 1 }
        if bits(stats.max(p, n)) != bits(stats.max_vec(&v)) { bad = bad + 1 }
        out(&res, stats.sum(p, n))
        out(&res, stats.mean(p, n))
        out(&res, stats.min(p, n))
        out(&res, stats.max(p, n))
        let med: f64 = stats.median(p, n)
        if bits(med) != bits(stats.median_vec(&v)) { bad = bad + 1 }
        var w: Vec[f64] = vec_new[f64]()
        vec_copy[f64](&v, &w)
        if bits(med) != bits(stats.median_vec_inplace(&w)) { bad = bad + 1 }
        out(&res, med)
        var k: usize = 0
        while k < 20 {
            let a: f64 = stats.percentile(p, n, pcts[k])
            if bits(a) != bits(stats.percentile_vec(&v, pcts[k])) { bad = bad + 1 }
            vec_copy[f64](&v, &w)
            if bits(a) != bits(stats.percentile_vec_inplace(&w, pcts[k])) { bad = bad + 1 }
            out(&res, a)
            k = k + 1
        }
        out(&res, stats.variance(p, n))
        out(&res, stats.stdev(p, n))
        out(&res, stats.pvariance(p, n))
        out(&res, stats.pstdev(p, n))
        if bits(stats.variance(p, n)) != bits(stats.variance_vec(&v)) { bad = bad + 1 }
        if bits(stats.pstdev(p, n)) != bits(stats.pstdev_vec(&v)) { bad = bad + 1 }
        // the plain forms did not touch the data: checked against the copy made before
        var cmp: Vec[f64] = vec_new[f64]()
        var j: usize = 0
        while j < n {
            vec_push[f64](&cmp, math.math_f64(rt.ld64(base, pos - n + j)))
            j = j + 1
        }
        j = 0
        while j < n {
            if bits(*vec_elem_ptr[f64](&v, j)) != bits(*vec_elem_ptr[f64](&cmp, j)) { bad = bad + 1 }
            j = j + 1
        }
        var cnt: Vec[u64] = vec_new[u64]()
        var b: usize = 0
        while b < 16 {
            vec_push[u64](&cnt, 7)
            b = b + 1
        }
        if bits(stats.sum_exact(p, n)) != bits(stats.sum_exact_vec(&v)) { bad = bad + 1 }
        if bits(stats.mean_exact(p, n)) != bits(stats.mean_exact_vec(&v)) { bad = bad + 1 }
        let hc: usize = stats.histogram(p, n, 16, lo, hi, vec_elem_ptr[u64](&cnt, 0))
        vec_push[u64](&res, hc as u64)
        vec_push[u64](&res, bad)
        b = 0
        while b < 16 {
            vec_push[u64](&res, vec_at[u64](&cnt, b))
            b = b + 1
        }
        out(&res, stats.sum_exact(p, n))
        out(&res, stats.mean_exact(p, n))
        vec_free[u64](&cnt)
        vec_free[f64](&cmp)
        vec_free[f64](&w)
        vec_free[f64](&v)
        s = s + 1
    }
    if !rt.write_file(rt.arg_ptr(start, 2), vec_ptr[u64](&res), vec_len[u64](&res) * 8) {
        return 6
    }
    return 0
}
