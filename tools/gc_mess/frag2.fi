// tools/gc_mess/frag2.fi — Phasen-Fragmentierungstest (Runde 38, Stufe 2).
//
// Anders als frag.fi (sechs Klassen gleichzeitig, konstant) laeuft hier ein
// PHASEN-Workload — der harte Fall fuer einen Klassen-Allokator:
//   Phase A: nur grosse Objekte (Klasse 2048), viele Stapel nacheinander.
//   Phase B: nur kleine Objekte (Klasse 48), gleiche Dynamik.
// Ohne Rueckgabe leerer Klassen-Chunks ans Betriebssystem bleibt der RSS
// nach Phase A fuer immer hoch, obwohl in Phase B fast alles tot ist.
// Mit Rueckgabe muss der RSS in Phase B deutlich fallen.
//
// Gemessen wird wieder der echte RSS (/proc/self/statm), die Koepfe liegen
// als rohe Adressen in einem Array (Designregel aus Stufe 1).

import mess

const RUNDEN_A: u64 = 300  // GCM_RUNDEN_A
const RUNDEN_B: u64 = 300  // GCM_RUNDEN_B
const BATCH: u32 = 200     // GCM_BATCH
const STAPEL: u64 = 24     // GCM_STAPEL — gleichzeitig lebende Stapel je Phase

gc class F48 {
    n: Gc[F48],
    d: [u64; 4],
}

gc class F96 {
    n: Gc[F96],
    d: [u64; 10],
}

gc class F192 {
    n: Gc[F192],
    d: [u64; 22],
}

gc class F384 {
    n: Gc[F384],
    d: [u64; 46],
}

gc class F768 {
    n: Gc[F768],
    d: [u64; 94],
}

gc class F2048 {
    n: Gc[F2048],
    d: [u64; 254],
}

fn b_gross(n: u32) -> AllocError!u64 {
    var k: Gc[F2048] = gc_null[F2048]()
    var i: u32 = 0
    while i < n {
        k = try gc F2048{ n: k, d: [0; 254] }
        i = i + 1
    }
    return k as u64
}

fn b_klein(n: u32) -> AllocError!u64 {
    var k: Gc[F48] = gc_null[F48]()
    var i: u32 = 0
    while i < n {
        k = try gc F48{ n: k, d: [0; 4] }
        i = i + 1
    }
    return k as u64
}

fn t_kopf() {
    var t: [u8; 20] = [
        35, 32, 102, 105, 114, 110, 45, 103, 99, 45, 112, 104, 97, 115, 101, 110, 32, 118, 49, 10,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 20)
}

fn t_spalten() {
    var t: [u8; 63] = [
        35, 32, 115, 112, 97, 108, 116, 101, 110, 58, 32, 114, 117, 110, 100, 101, 9, 112, 104, 97, 115, 101, 9, 114, 115, 115, 95, 107, 105, 98, 9, 104, 101, 97, 112, 95, 98, 121, 116, 101, 115, 9, 108, 101, 98, 101, 110, 100, 101, 9, 115, 97, 109, 109, 101, 108, 108, 97, 101, 117, 102, 101, 10,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 63)
}

fn t_rssa() {
    var t: [u8; 22] = [
        35, 32, 114, 115, 115, 95, 112, 104, 97, 115, 101, 95, 97, 95, 109, 97, 120, 95, 107, 105, 98, 61,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 22)
}

fn t_rssb() {
    var t: [u8; 22] = [
        35, 32, 114, 115, 115, 95, 112, 104, 97, 115, 101, 95, 98, 95, 109, 97, 120, 95, 107, 105, 98, 61,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 22)
}

fn t_rssend() {
    var t: [u8; 15] = [
        35, 32, 114, 115, 115, 95, 101, 110, 100, 101, 95, 107, 105, 98, 61,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 15)
}

fn t_fertig() {
    var t: [u8; 9] = [
        35, 32, 102, 101, 114, 116, 105, 103, 10,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 9)
}

fn t_fehler() {
    var t: [u8; 14] = [
        35, 32, 102, 101, 104, 108, 101, 114, 32, 99, 111, 100, 101, 61,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 14)
}

fn fehler(code: u64) -> i32 {
    t_fehler()
    mess.mess_u64(code)
    mess.mess_nl()
    return code as i32
}

fn zeile(runde: u64, phase: u64) {
    mess.mess_u64(runde)
    mess.mess_tab()
    mess.mess_u64(phase)
    mess.mess_tab()
    mess.mess_u64(mess.mess_rss_kib())
    mess.mess_tab()
    mess.mess_u64(gc_heap_bytes())
    mess.mess_tab()
    mess.mess_u64(gc_live_objects())
    mess.mess_tab()
    mess.mess_u64(gc_collections())
    mess.mess_nl()
}

fn main() -> i32 {
    if !gc_init() {
        return fehler(2)
    }
    t_kopf()
    t_spalten()
    var koepfe: [u64; 24] = [0; 24]
    var slot: usize = 0
    var rss_a: u64 = 0
    var rss_b: u64 = 0
    var runde: u64 = 0
    while runde < RUNDEN_A {
        let a: u64 = b_gross(BATCH) catch 0
        if a == 0 {
            return fehler(10)
        }
        koepfe[slot] = a
        slot = slot + 1
        if slot == STAPEL as usize {
            slot = 0
        }
        let rss: u64 = mess.mess_rss_kib()
        if rss > rss_a {
            rss_a = rss
        }
        zeile(runde, 1)
        runde = runde + 1
    }
    // Uebergang: die grossen Stapel sterben JETZT (Array wird ab hier
    // nur noch mit kleinen Koepfen ueberschrieben).
    runde = 0
    while runde < RUNDEN_B {
        let a: u64 = b_klein(BATCH) catch 0
        if a == 0 {
            return fehler(11)
        }
        koepfe[slot] = a
        slot = slot + 1
        if slot == STAPEL as usize {
            slot = 0
        }
        let rss: u64 = mess.mess_rss_kib()
        if rss > rss_b {
            rss_b = rss
        }
        zeile(runde, 2)
        runde = runde + 1
    }
    gc_collect()
    let rss_ende: u64 = mess.mess_rss_kib()
    var ref_summe: u64 = 0
    var j: usize = 0
    while j < 24 {
        ref_summe = ref_summe + koepfe[j] % 256
        j = j + 1
    }
    t_rssa()
    mess.mess_u64(rss_a)
    mess.mess_nl()
    t_rssb()
    mess.mess_u64(rss_b)
    mess.mess_nl()
    t_rssend()
    mess.mess_u64(rss_ende)
    mess.mess_nl()
    mess.mess_u64(ref_summe)
    mess.mess_nl()
    t_fertig()
    return 0
}
