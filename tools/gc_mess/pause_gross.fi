// tools/gc_mess/pause_gross.fi — Pausen bei GROSSER lebender Menge (Runde 40).
//
// WARUM: Der 30-Minuten-Dauerlauf mit pause.fi haelt fast nichts am Leben
// (Heap blieb bei 0,79 MiB). Der inkrementelle Zyklus schaltet erst ab
// INKR_AB = 8 MiB (lib/gc/gc.fi) — er wurde in jenem Lauf also NIE benutzt.
// Die dort gemessene Hoechstpause von 3,85 ms ist damit ein Wert des
// NICHT-inkrementellen Pfades und beweist ueber den inkrementellen nichts.
//
// Dieser Lauf haelt deshalb absichtlich eine grosse Menge lebendig: eine
// Wurzel mit KINDER Textknoten (Geschwisterkette). Sie haengt an einer
// Rahmenzelle von main() und ueberlebt jeden Sammellauf. Gleichzeitig laeuft
// derselbe Muellstrom wie in pause.fi (dom_zyklus_bauen). Damit ist der Heap
// dauerhaft ueber der Schwelle, jeder Sammellauf muss die volle lebende
// Menge markieren — genau der Fall, fuer den das inkrementelle Sammeln
// gebaut wurde.
//
// Ausgabe: dasselbe TSV-Format wie pause.fi (t_ms, zyklen, rss_kib, lebende,
// sammellaeufe, heap_bytes, pause_max_ns), danach Histogramm und Summen.
// BUDGET_MS/STICHPROBE/KINDER stellt run.sh per sed um.

import dom
import mess

const BUDGET_MS: i64 = 20000  // GCM_BUDGET_MS
const STICHPROBE: i64 = 1000  // GCM_STICHPROBE
const KINDER: u32 = 120000    // GCM_KINDER

fn t_kopf() {
    var t: [u8; 25] = [
        35, 32, 102, 105, 114, 110, 45, 103, 99, 45, 112, 97, 117, 115, 101, 45, 103, 114, 111, 115, 115, 32, 118, 49, 10,
    ]
    mess.mess_schreib((&t) as u64, 25)
}

fn t_spalten() {
    var t: [u8; 76] = [
        35, 32, 115, 112, 97, 108, 116, 101, 110, 58, 32, 116, 95, 109, 115, 9, 122, 121, 107, 108, 101, 110, 9, 114, 115, 115, 95, 107, 105, 98, 9, 108, 101, 98, 101, 110, 100, 101, 9, 115, 97, 109, 109, 101, 108, 108, 97, 101, 117, 102, 101, 9, 104, 101, 97, 112, 95, 98, 121, 116, 101, 115, 9, 112, 97, 117, 115, 101, 95, 109, 97, 120, 95, 110, 115, 10,
    ]
    mess.mess_schreib((&t) as u64, 76)
}

fn t_hist() {
    var t: [u8; 37] = [
        35, 32, 104, 105, 115, 116, 111, 103, 114, 97, 109, 109, 58, 32, 112, 97, 117, 115, 101, 95, 110, 115, 95, 103, 114, 101, 110, 122, 101, 9, 97, 110, 122, 97, 104, 108, 10,
    ]
    mess.mess_schreib((&t) as u64, 37)
}

