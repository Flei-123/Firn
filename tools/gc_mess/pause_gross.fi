    var t: [u8; 15] = [
        35, 32, 115, 97, 109, 109, 101, 108, 108, 97, 101, 117, 102, 101, 61,
    ]
    mess.mess_schreib((&t) as u64, 15)
}

fn t_zyklen() {
    var t: [u8; 9] = [
        35, 32, 122, 121, 107, 108, 101, 110, 61,
    ]
    mess.mess_schreib((&t) as u64, 9)
}

fn t_mehrfach() {
    var t: [u8; 22] = [
        35, 32, 117, 101, 98, 101, 114, 115, 101, 104, 101, 110, 95, 109, 101, 104, 114, 102, 97, 99, 104, 61,
    ]
    mess.mess_schreib((&t) as u64, 22)
}

fn t_rss() {
    var t: [u8; 10] = [
        35, 32, 114, 115, 115, 95, 107, 105, 98, 61,
    ]
    mess.mess_schreib((&t) as u64, 10)
}

