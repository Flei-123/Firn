    ]
    mess.mess_schreib((&t) as u64, 15)
}

// Runde 41: Histogramm der EINZELNEN Scheiben (nicht nur der laengsten je
// Zyklus). Fach 0 = unter 1 us, Fach k = [2^(k-1) us, 2^k us), Fach 15 = ab
// 16,384 ms. Wird erst NACH dem Aufbau genullt, misst also den Dauerbetrieb.
fn t_fach() {
    var t: [u8; 14] = [
        35, 32, 115, 99, 104, 101, 105, 98, 101, 95, 102, 97, 99, 104,
    ]
    mess.mess_schreib((&t) as u64, 14)
}

fn p_ld(a: u64) -> u64 {
    return *(a as *mut u64)
}

fn p_st(a: u64, v: u64) {
    *(a as *mut u64) = v
}

fn p_bucket(ns: u64) -> u64 {
    if ns < 100000 {
        return 0
    }
    if ns < 250000 {
        return 1
    }
    if ns < 500000 {
        return 2
    }
    if ns < 1000000 {
        return 3
    }
    if ns < 2000000 {
        return 4
    }
    if ns < 4000000 {
        return 5
    }
    if ns < 8000000 {
        return 6
    }
    if ns < 16000000 {
        return 7
    }
    return 8
}

fn main() -> i32 {
    if !gc_init() {
        return 2
    }
    return lauf() catch 9
}

fn lauf() -> AllocError!i32 {
    // ---- grosse lebende Menge aufbauen -------------------------------
    let wurzel = try dom.dom_element_neu(1)
    var k: u32 = 0
    while k < KINDER {
        let kind = try dom.dom_knoten_neu(1000 + k, dom.DOM_ART_TEXT)
        dom.dom_kind_anhaengen(wurzel, kind)
        k = k + 1
    }

    // Aufbaupausen zaehlen nicht zum Dauerbetrieb.
    gc_hist_reset()

    t_kopf()
    t_spalten()
    var hist: [u64; 9] = [0; 9]
    var grenzen: [u64; 9] = [100000, 250000, 500000, 1000000, 2000000, 4000000, 8000000, 16000000, 0]
    let hp: u64 = (&hist) as u64
    let gp: u64 = (&grenzen) as u64
    let t0: u64 = mess.mess_jetzt_ms()

    var laeufe: u64 = 0
    var mehrfach: u64 = 0
    var zyklen: u64 = 0
    var seit: i64 = 0
    var t: u64 = 0
    var laufen: bool = true
    while laufen {
        let n: u64 = dom.dom_zyklus_bauen() catch 0
        if n != dom.DOM_OBJEKTE_JE_SATZ {
            return 5
        }
        zyklen = zyklen + 1
        let l: u64 = gc_collections()
        if l > laeufe {
            if l > laeufe + 1 {
                mehrfach = mehrfach + l - laeufe - 1
            }
            let b: u64 = p_bucket(gc_pause_ns_last())
            p_st(hp + b * 8, p_ld(hp + b * 8) + 1)
            laeufe = l
        }
        seit = seit + 1
        if seit >= STICHPROBE {
            seit = 0
            t = mess.mess_jetzt_ms() - t0
            mess.mess_u64(t)
            mess.mess_tab()
            mess.mess_u64(zyklen)
            mess.mess_tab()
            mess.mess_u64(mess.mess_rss_kib())
            mess.mess_tab()
            mess.mess_u64(gc_live_objects())
            mess.mess_tab()
            mess.mess_u64(gc_collections())
            mess.mess_tab()
            mess.mess_u64(gc_heap_bytes())
            mess.mess_tab()
            mess.mess_u64(gc_pause_ns_max())
            mess.mess_nl()
            if t >= BUDGET_MS as u64 {
                laufen = false
            }
        }
    }
    // Die Wurzel MUSS hier noch benutzt werden, sonst darf der Sammler sie
    // waehrend der Schleife einsammeln — dann misst der Lauf nichts.
    if dom.dom_kinder_zaehlen(wurzel) != KINDER {
        return 6
    }

    // ---- Auswertung ---------------------------------------------------
    t_hist()
    var i: u64 = 0
    while i < 9 {
        mess.mess_u64(p_ld(gp + i * 8))
        mess.mess_tab()
        mess.mess_u64(p_ld(hp + i * 8))
        mess.mess_nl()
        i = i + 1
    }
    var typ: u64 = 0
    while typ < 5 {
        t_typ()
        mess.mess_u64(typ)
        mess.mess_zeichen(61)
        mess.mess_u64(gc_pause_max_typ(typ))
        mess.mess_nl()
        typ = typ + 1
    }
    var htyp: u64 = 0
    while htyp < 7 {
        var fach: u64 = 0
        while fach < 16 {
            let n: u64 = gc_hist(htyp, fach)
            if n != 0 {
                t_fach()
                mess.mess_u64(htyp)
                mess.mess_zeichen(95)
                mess.mess_u64(fach)
                mess.mess_zeichen(61)
                mess.mess_u64(n)
                mess.mess_nl()
            }
            fach = fach + 1
        }
        htyp = htyp + 1
    }
    t_pmax()
    mess.mess_u64(gc_pause_ns_max())
    mess.mess_nl()
    t_ptot()
    mess.mess_u64(gc_pause_ns_total())
    mess.mess_nl()
    t_laeufe()
    mess.mess_u64(gc_collections())
    mess.mess_nl()
    t_zyklen()
    mess.mess_u64(zyklen)
    mess.mess_nl()
    t_mehrfach()
    mess.mess_u64(mehrfach)
    mess.mess_nl()
    t_rss()
    mess.mess_u64(mess.mess_rss_kib())
    mess.mess_nl()
    t_heap()
    mess.mess_u64(gc_heap_bytes())
    mess.mess_nl()
    t_lebendk()
    mess.mess_u64(KINDER as u64)
    mess.mess_nl()
    t_ueberl()
    mess.mess_u64(gc_ueberlaeufe())
    mess.mess_nl()
    t_voll()
    mess.mess_u64(gc_volle_laeufe())
    mess.mess_nl()
    t_fertig()
    return 0
}
