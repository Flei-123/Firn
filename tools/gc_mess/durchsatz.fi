// tools/gc_mess/durchsatz.fi — DURCHSATZ bei fester Arbeit (Runde 44).
//
// Die Pausenlaeufe messen Zeit bei fester Laufzeit; fuer den Durchsatz ist
// das die falsche Richtung. Hier ist die ARBEIT fest (RUNDEN Muellzyklen bei
// KINDER lebenden Knoten) und die ZEIT das Ergebnis. Damit laesst sich die
// Vorgabe aus Runde 38 (hoechstens 10 % Durchsatzverlust) direkt pruefen.
//
// KINDER stellt das Regime ein:
//   klein (z. B. 2000)  -> Heap bleibt unter INKR_AB, genau das Regime, das
//                          die Schwelle schuetzen soll.
//   gross (z. B. 120000) -> Heap ueber INKR_AB, inkrementeller Zyklus.
//
// Ausgabe (eine Zeile je Kennzahl, maschinenlesbar):
//   D <code> <wert>
// Codes: 0 aufbau_ms, 1 arbeit_ms, 2 runden, 3 sammellaeufe, 4 volle_laeufe,
// 5 heap_bytes, 6 gesamt_bytes, 7 rss_kib, 8 pause_max_ns, 9 pause_total_ns,
// 10 lebende_objekte, 11 barrieren, 12 ns_je_runde.

import dom
import mess

const KINDER: u32 = 2000      // GCM_KINDER
const RUNDEN: u64 = 200000    // GCM_RUNDEN

fn d(code: u64, wert: u64) {
    mess.mess_zeichen(68)
    mess.mess_tab()
    mess.mess_u64(code)
    mess.mess_tab()
    mess.mess_u64(wert)
    mess.mess_nl()
}

fn main() -> i32 {
    if !gc_init() {
        return 2
    }
    return lauf() catch 9
}

fn lauf() -> AllocError!i32 {
    let t0: u64 = mess.mess_jetzt_ms()
    let wurzel = try dom.dom_element_neu(1)
    var k: u32 = 0
    while k < KINDER {
        let kind = try dom.dom_knoten_neu(1000 + k, dom.DOM_ART_TEXT)
        dom.dom_kind_anhaengen(wurzel, kind)
        k = k + 1
    }
    let t1: u64 = mess.mess_jetzt_ms()

    var r: u64 = 0
    while r < RUNDEN {
        let n: u64 = dom.dom_zyklus_bauen() catch 0
        if n != dom.DOM_OBJEKTE_JE_SATZ {
            return 5
        }
        r = r + 1
    }
    let t2: u64 = mess.mess_jetzt_ms()
    if dom.dom_kinder_zaehlen(wurzel) != KINDER {
        return 6
    }

    let arbeit: u64 = t2 - t1
    d(0, t1 - t0)
    d(1, arbeit)
    d(2, RUNDEN)
    d(3, gc_collections())
    d(4, gc_volle_laeufe())
    d(5, gc_heap_bytes())
    d(6, gc_total_bytes())
    d(7, mess.mess_rss_kib())
    d(8, gc_pause_ns_max())
    d(9, gc_pause_ns_total())
    d(10, gc_live_objects())
    d(11, gc_barriers())
    d(12, arbeit * 1000000 / RUNDEN)
    // Diagnose (Runde 44): 13 neue Chunks in Ruhe, 14 im Markieren,
    // 15 im Fegen, 16 Mark-Scheiben, 17 Sweep-Scheiben, 18 graue
    // Allokationen, 19 Allokationen gesamt.
    var i: u64 = 0
    while i < 7 {
        d(13 + i, gc_diag(i))
        i = i + 1
    }
    d(20, gc_stop_max())
    return 0
}
