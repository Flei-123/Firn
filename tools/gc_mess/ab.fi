// tools/gc_mess/ab.fi — A/B-Vergleich atomar gegen inkrementell IM SELBEN
// PROZESS (Runde 44).
//
// WARUM: Der Durchsatzunterschied, um den es geht, liegt im Bereich weniger
// Prozent. Zwei getrennt gebaute Programme unterscheiden sich schon durch
// Codelayout und Adressen um mehr als das, und die Maschine driftet ueber
// Minuten. Seit `gc_set_inkr_ab()` (Runde 44) laesst sich die Schwelle zur
// Laufzeit stellen: derselbe Prozess, derselbe Maschinencode, dieselbe
// lebende Menge — nur die Schwelle wechselt. Die Phasen laufen verschachtelt
// (A B A B A B), damit eine Drift beide Varianten gleich trifft.
//
// Ausgabe:
//   P <nr> <ab> <ms> <heap_bytes> <gc_ns> <stop_max_ns> <neue_chunks> <laeufe>
//   Q <code> <wert>   Schlusswerte (0 lebende, 1 rss_kib, 2 gesamt_bytes)

import dom
import mess

const KINDER: u32 = 2000       // GCM_KINDER
const RUNDEN: u64 = 100000     // GCM_RUNDEN
const PAARE: u64 = 3           // GCM_PAARE
const AB_A: u64 = 8388608      // GCM_AB_A
const AB_B: u64 = 0            // GCM_AB_B

fn q(code: u64, wert: u64) {
    mess.mess_zeichen(81)
    mess.mess_tab()
    mess.mess_u64(code)
    mess.mess_tab()
    mess.mess_u64(wert)
    mess.mess_nl()
}

fn main() -> i32 {
    if !gc_init() {
        return 2
    }
    return lauf() catch 9
}

fn lauf() -> AllocError!i32 {
    let wurzel = try dom.dom_element_neu(1)
    var k: u32 = 0
    while k < KINDER {
        let kind = try dom.dom_knoten_neu(1000 + k, dom.DOM_ART_TEXT)
        // Runde 53: die Kinderliste ist eine GcVec, das Anhaengen kann
        // also allozieren und ist damit fehlbar.
        let ok: bool = try dom.dom_kind_anhaengen(wurzel, kind)
        k = k + 1
    }

    var nr: u64 = 0
    while nr < PAARE * 2 {
        var ab: u64 = AB_A
        if nr % 2 == 1 {
            ab = AB_B
        }
        gc_set_inkr_ab(ab)
        gc_hist_reset()
        let g0: u64 = gc_pause_ns_total()
        let c0: u64 = gc_diag(0) + gc_diag(1) + gc_diag(2)
        let l0: u64 = gc_collections()
        let t0: u64 = mess.mess_jetzt_ms()
        var r: u64 = 0
        while r < RUNDEN {
            let n: u64 = dom.dom_zyklus_bauen() catch 0
            if n != dom.DOM_OBJEKTE_JE_SATZ {
                return 5
            }
            r = r + 1
        }
        let t1: u64 = mess.mess_jetzt_ms()
        mess.mess_zeichen(80)
        mess.mess_tab()
        mess.mess_u64(nr)
        mess.mess_tab()
        mess.mess_u64(ab)
        mess.mess_tab()
        mess.mess_u64(t1 - t0)
        mess.mess_tab()
        mess.mess_u64(gc_heap_bytes())
        mess.mess_tab()
        mess.mess_u64(gc_pause_ns_total() - g0)
        mess.mess_tab()
        mess.mess_u64(gc_stop_max())
        mess.mess_tab()
        mess.mess_u64(gc_diag(0) + gc_diag(1) + gc_diag(2) - c0)
        mess.mess_tab()
        mess.mess_u64(gc_collections() - l0)
        mess.mess_nl()
        nr = nr + 1
    }
    if dom.dom_kinder_zaehlen(wurzel) != KINDER {
        return 6
    }
    q(0, gc_live_objects())
    q(1, mess.mess_rss_kib())
    q(2, gc_total_bytes())
    return 0
}
