import parquet.pq
import parquet.pqsrc
import parquet.pqstr
import std.rt
import parquet.pqmeta

fn put_rec(o: *mut rt.Buf, c: *mut pqstr.StrCol, i: usize) {
    var n: u32 = 4294967295
    if !pqstr.strcol_is_null(c, i) {
        n = pqstr.strcol_len(c, i) as u32
    }
    pqstr.push_u32(o, n)
    if n != 4294967295 {
        rt.buf_push_bytes(o, pqstr.strcol_ptr(c, i), n as usize)
    }
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 4 {
        return 2
    }
    let path: str = str { p: rt.arg_ptr(start, 1) as *mut u8, n: rt.c_length(rt.arg_ptr(start, 1)) }
    let colname: str = str { p: rt.arg_ptr(start, 2) as *mut u8, n: rt.c_length(rt.arg_ptr(start, 2)) }
    var s: pqsrc.PqSrc = pqsrc.pq_src_new()
    if !pqsrc.pq_src_file(path, &s) {
        return 3
    }
    let q: *mut pqmeta.Pq = pq.pq_open(&s)
    if q as u64 == 0 {
        return 4
    }
    let col: i64 = pq.pq_col_find(q, colname)
    if col < 0 {
        return 5
    }
    var o: rt.Buf = rt.buf_new()
    let shape: u64 = pq.pq_col_shape(q, col as usize)
    var rg: usize = 0
    while rg < pq.pq_num_row_groups(q) {
        if shape == pq.PQ_SHAPE_FLAT_STRING {
            var c: pqstr.StrCol = pqstr.strcol_new()
            if !pq.pq_read_strings(q, rg, col as usize, &c) {
                return 6
            }
            var i: usize = 0
            while i < pqstr.strcol_count(&c) {
                put_rec(&o, &c, i)
                i = i + 1
            }
            pqstr.strcol_free(&c)
        } else if shape == pq.PQ_SHAPE_LIST_STRUCT {
            var cc: pq.ConvCol = pq.convcol_new()
            if !pq.pq_read_conv(q, rg, col as usize, &cc) {
                return 7
            }
            var r: usize = 0
            while r < cc.nrows {
                let a: usize = pqstr.ld_u64(&cc.row_offs, r) as usize
                let b: usize = pqstr.ld_u64(&cc.row_offs, r + 1) as usize
                var n: u32 = (b - a) as u32
                if rt.ld8(cc.row_null.ptr, r) != 0 {
                    n = 4294967294
                }
                pqstr.push_u32(&o, n)
                var k: usize = a
                while k < b {
                    put_rec(&o, &cc.a, k)
                    put_rec(&o, &cc.b, k)
                    k = k + 1
                }
                r = r + 1
            }
            pq.convcol_free(&cc)
        } else {
            return 8
        }
        rg = rg + 1
    }
    rt.write_file(rt.arg_ptr(start, 3), o.ptr, o.len)
    return 0
}
