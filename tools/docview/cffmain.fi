// SPDX-License-Identifier: MPL-2.0
import html.mem
import rt.rt
import font.cff
import font.cffcs
import font.gpath

fn dump_glyph(f: *mut cff.CffFont, gid: u32, g: *mut gpath.GPath, b: *mut rt.Buf) {
    gpath.gp_clear(g)
    let ok: bool = cffcs.cffcs_outline(f, gid, g)
    rt.buf_push(b, 71 as u8)
    rt.buf_push_dec_u64(b, gid as u64)
    if !ok {
        rt.buf_push(b, 32 as u8)
        rt.buf_push(b, 33 as u8)
    }
    gpath.gp_dump(g, b)
    rt.buf_push(b, 10 as u8)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 2
    }
    var fb: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &fb) {
        return 3
    }
    var f: cff.CffFont = cff.cff_new()
    if !cff.cff_init(&f, rt.buf_ptr(&fb), rt.buf_len(&fb)) {
        return 4
    }
    let pool: *mut u8 = mem.heap_alloc(1 << 20)
    var g: gpath.GPath = gpath.gp_new()
    gpath.gp_attach(&g, pool as u64, 1 << 20)
    var out: rt.Buf = rt.buf_new()
    var gid: u32 = 0
    while (gid as usize) < cff.cff_glyph_count(&f) {
        dump_glyph(&f, gid, &g, &out)
        gid = gid + 1
    }
    mem.write_all(1, rt.buf_data(&out), rt.buf_len(&out))
    return 0
}
