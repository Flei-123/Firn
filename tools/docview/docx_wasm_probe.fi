import std.rt
import docview.registry
import docview.office.dx_open

fn main(start: u64) -> i32 {
    let ops: registry.DocOps = dx_open.docx_ops()
    let n: usize = 4096
    let d: u64 = rt.heap_alloc(n)
    let h: u64 = ops.open(d, n)
    if h == 0 {
        return 1
    }
    var out: rt.Buf = rt.buf_new()
    var w: i32 = 0
    var hh: i32 = 0
    ops.text(h, 0, &out)
    ops.render(h, 0, 1.0, &out, &w, &hh)
    let pages: usize = ops.pages(h)
    ops.free(h)
    return pages as i32
}
