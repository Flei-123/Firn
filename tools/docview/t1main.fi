// SPDX-License-Identifier: MPL-2.0
import html.mem
import rt.rt
import font.type1
import font.t1cs
import font.gpath

fn dump_glyph(f: *mut type1.T1Font, gid: u32, g: *mut gpath.GPath, b: *mut rt.Buf) {
    gpath.gp_clear(g)
    let ok: bool = t1cs.t1cs_outline(f, gid, g)
    rt.buf_push(b, 71 as u8)
    rt.buf_push_dec_u64(b, gid as u64)
    rt.buf_push(b, 32 as u8)
    var nm: [u8; 64] = [0 as u8; 64]
    let nl: usize = type1.t1_name_copy(f, gid, &nm[0], 64)
    rt.buf_push_bytes(b, (&nm[0]) as u64, nl)
    if !ok {
        rt.buf_push(b, 32 as u8)
        rt.buf_push(b, 33 as u8)
    }
    gpath.gp_dump(g, b)
    rt.buf_push(b, 10 as u8)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 2
    }
    var fb: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &fb) {
        return 3
    }
    var f: type1.T1Font = type1.t1_new()
    if !type1.t1_init(&f, rt.buf_ptr(&fb), rt.buf_len(&fb)) {
        return 4
    }
    let pool: *mut u8 = mem.heap_alloc(1 << 20)
    var g: gpath.GPath = gpath.gp_new()
    gpath.gp_attach(&g, pool as u64, 1 << 20)
    var out: rt.Buf = rt.buf_new()
    var gid: u32 = 1
    while (gid as usize) < type1.t1_glyph_count(&f) {
        dump_glyph(&f, gid, &g, &out)
        gid = gid + 1
    }
    mem.write_all(1, rt.buf_data(&out), rt.buf_len(&out))
    return 0
}
