import std.rt
import std.vec
import docview.office.dx_open
import docview.registry

fn read_num(p: u64, dflt: f64) -> f64 {
    var v: f64 = 0.0
    var frac: f64 = 0.0
    var seen_dot: bool = false
    var i: usize = 0
    let n: usize = rt.c_length(p)
    if n == 0 {
        return dflt
    }
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == (46 as u8) {
            seen_dot = true
        } else if c >= (48 as u8) && c <= (57 as u8) {
            if seen_dot {
                frac = frac / 10.0
                v = v + ((c - (48 as u8)) as f64) * frac
            } else {
                v = v * 10.0 + ((c - (48 as u8)) as f64)
            }
        }
        if seen_dot && frac == 0.0 {
            frac = 1.0
        }
        i = i + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 2
    }
    var fb: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 2), &fb) {
        return 3
    }
    let ops: registry.DocOps = dx_open.docx_ops()
    let h: u64 = ops.open(rt.buf_ptr(&fb), rt.buf_len(&fb))
    if h == 0 {
        return 4
    }
    let cmd: u8 = rt.ld8(rt.arg_ptr(start, 1), 0)
    var out: rt.Buf = rt.buf_new()
    let np: usize = ops.pages(h)
    if cmd == (105 as u8) {
        rt.buf_push_dec_u64(&out, np as u64)
        rt.buf_push(&out, 10 as u8)
    } else if cmd == (116 as u8) {
        var i: usize = 0
        while i < np {
            ops.text(h, i, &out)
            rt.buf_push(&out, 10 as u8)
            i = i + 1
        }
    } else if cmd == (114 as u8) {
        var pg: usize = 0
        var sc: f64 = 1.0
        if rt.arg_count(start) > 3 {
            pg = read_num(rt.arg_ptr(start, 3), 0.0) as usize
        }
        if rt.arg_count(start) > 4 {
            sc = read_num(rt.arg_ptr(start, 4), 1.0)
        }
        var w: i32 = 0
        var hh: i32 = 0
        var px: rt.Buf = rt.buf_new()
        if !ops.render(h, pg, sc, &px, &w, &hh) {
            return 5
        }
        rt.buf_push_dec_i64(&out, w as i64)
        rt.buf_push(&out, 32 as u8)
        rt.buf_push_dec_i64(&out, hh as i64)
        rt.buf_push(&out, 10 as u8)
        rt.buf_push_bytes(&out, rt.buf_ptr(&px), rt.buf_len(&px))
    }
    rt.write_everything(1, rt.buf_ptr(&out), rt.buf_len(&out))
    ops.free(h)
    return 0
}
