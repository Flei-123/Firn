import html.mem
import rt.rt
import image.ccitt

fn read_int(p: u64) -> i64 {
    let n: usize = rt.c_length(p)
    var i: usize = 0
    var neg: bool = false
    if n > 0 && rt.ld8(p, 0) == 45 as u8 {
        neg = true
        i = 1
    }
    var v: i64 = 0
    while i < n && rt.ld8(p, i) >= 48 as u8 && rt.ld8(p, i) <= 57 as u8 {
        v = v * 10 + (((rt.ld8(p, i) as u32) - 48) as i64)
        i = i + 1
    }
    if neg {
        return 0 - v
    }
    return v
}

fn has_flag(p: u64, c: u8) -> bool {
    let n: usize = rt.c_length(p)
    var i: usize = 0
    while i < n {
        if rt.ld8(p, i) == c {
            return true
        }
        i = i + 1
    }
    return false
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 6 {
        return 2
    }
    var fb: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &fb) {
        return 3
    }
    let k: i64 = read_int(rt.arg_ptr(start, 2))
    let cols: i64 = read_int(rt.arg_ptr(start, 3))
    let rows: i64 = read_int(rt.arg_ptr(start, 4))
    let flags: u64 = rt.arg_ptr(start, 5)
    var out: rt.Buf = rt.buf_new()
    let got: usize = ccitt.ccitt_decode(rt.buf_ptr(&fb), rt.buf_len(&fb), k as i32, cols as usize,
        rows as usize, has_flag(flags, 97 as u8), has_flag(flags, 101 as u8), has_flag(flags, 98 as u8), &out)
    mem.write_all(1, rt.buf_data(&out), rt.buf_len(&out))
    if got == 0 {
        return 4
    }
    return 0
}
