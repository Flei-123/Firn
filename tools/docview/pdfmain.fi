import html.mem
import rt.rt
import docview.pdf.pobj
import docview.pdf.pdoc
import docview.pdf.ppage
import docview.pdf.pfont
import paint.canvas
import paint.png
import font.metrics

fn lit(out: *mut mem.Buf, p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        mem.buf_push(out, rt.ld8(p, i))
        i = i + 1
    }
}

fn num3(out: *mut mem.Buf, v: f64) {
    var x: f64 = v
    if x < 0.0 {
        mem.buf_push(out, 45 as u8)
        x = 0.0 - x
    }
    let whole: u64 = x as u64
    mem.buf_push_dec(out, whole)
    mem.buf_push(out, 46 as u8)
    var frac: f64 = (x - (whole as f64)) * 1000.0 + 0.5
    var f: u64 = frac as u64
    if f > 999 {
        f = 999
    }
    if f < 100 {
        mem.buf_push(out, 48 as u8)
    }
    if f < 10 {
        mem.buf_push(out, 48 as u8)
    }
    mem.buf_push_dec(out, f)
}

fn kv(out: *mut mem.Buf, tag: u64, tn: usize, v: u64) {
    lit(out, tag, tn)
    mem.buf_push(out, 32 as u8)
    mem.buf_push_dec(out, v)
    mem.buf_push(out, 10 as u8)
}

fn info(out: *mut mem.Buf, d: *mut pdoc.Doc) {
    var t1: [u8; 3] = "VER"
    lit(out, (&t1[0]) as u64, 3)
    mem.buf_push(out, 32 as u8)
    var minor: u32 = 0
    let major: u32 = pdoc.doc_version(d, &minor)
    mem.buf_push_dec(out, major as u64)
    mem.buf_push(out, 46 as u8)
    mem.buf_push_dec(out, minor as u64)
    mem.buf_push(out, 10 as u8)
    var t2: [u8; 5] = "PAGES"
    kv(out, (&t2[0]) as u64, 5, pdoc.doc_page_count(d) as u64)
    var t3: [u8; 9] = "ENCRYPTED"
    var e: u64 = 0
    if pdoc.doc_encrypted(d) {
        e = 1
    }
    kv(out, (&t3[0]) as u64, 9, e)
    var t4: [u8; 9] = "RECOVERED"
    var r: u64 = 0
    if pdoc.doc_recovered(d) {
        r = 1
    }
    kv(out, (&t4[0]) as u64, 9, r)
    var t5: [u8; 8] = "OBJSLOTS"
    kv(out, (&t5[0]) as u64, 8, pdoc.doc_objects(d) as u64)
    var t6: [u8; 3] = "ERR"
    kv(out, (&t6[0]) as u64, 3, pdoc.doc_err(d) as u64)
    var i: usize = 0
    let n: usize = pdoc.doc_page_count(d)
    while i < n && i < 5000 {
        var box_: [f64; 4] = [0.0; 4]
        pdoc.doc_page_box(d, i, true, (&box_[0]) as *mut f64)
        var t7: [u8; 4] = "PAGE"
        lit(out, (&t7[0]) as u64, 4)
        mem.buf_push(out, 32 as u8)
        mem.buf_push_dec(out, i as u64)
        mem.buf_push(out, 32 as u8)
        num3(out, box_[2] - box_[0])
        mem.buf_push(out, 32 as u8)
        num3(out, box_[3] - box_[1])
        mem.buf_push(out, 32 as u8)
        var rot: i64 = pdoc.doc_page_rotate(d, i) as i64
        if rot < 0 {
            rot = 0 - rot
        }
        mem.buf_push_dec(out, rot as u64)
        mem.buf_push(out, 10 as u8)
        i = i + 1
    }
}

fn read_dec(p: u64, n: usize) -> f64 {
    var v: f64 = 0.0
    var i: usize = 0
    var neg: bool = false
    if n > 0 && rt.ld8(p, 0) == 45 as u8 {
        neg = true
        i = 1
    }
    while i < n && rt.ld8(p, i) >= 48 as u8 && rt.ld8(p, i) <= 57 as u8 {
        v = v * 10.0 + ((rt.ld8(p, i) as u32) - 48) as f64
        i = i + 1
    }
    if i < n && rt.ld8(p, i) == 46 as u8 {
        i = i + 1
        var sc: f64 = 0.1
        while i < n && rt.ld8(p, i) >= 48 as u8 && rt.ld8(p, i) <= 57 as u8 {
            v = v + sc * (((rt.ld8(p, i) as u32) - 48) as f64)
            sc = sc * 0.1
            i = i + 1
        }
    }
    if neg {
        return 0.0 - v
    }
    return v
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 2
    }
    let cmd: u64 = rt.arg_ptr(start, 1)
    let path: u64 = rt.arg_ptr(start, 2)
    var fb: rt.Buf = rt.buf_new()
    if !rt.read_file(path, &fb) {
        return 3
    }
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    var d: pdoc.Doc = pdoc.doc_new()
    let opened: bool = pdoc.doc_open(&d, rt.buf_ptr(&fb), rt.buf_len(&fb))
    let c0: u8 = rt.ld8(cmd, 0)
    if c0 == 105 as u8 {
        info(&out, &d)
        mem.buf_flush(&out, 1)
        return 0
    }
    if !opened {
        var e: [u8; 4] = "ERR "
        lit(&out, (&e[0]) as u64, 4)
        mem.buf_push_dec(&out, pdoc.doc_err(&d) as u64)
        mem.buf_push(&out, 10 as u8)
        mem.buf_flush(&out, 1)
        return 4
    }
    var pg: usize = 0
    if rt.arg_count(start) > 3 {
        pg = read_dec(rt.arg_ptr(start, 3),
            rt.c_length(rt.arg_ptr(start, 3))) as usize
    }
    if c0 == 116 as u8 {
        var tb: mem.Buf = mem.buf_new()
        mem.buf_init(&tb)
        ppage.page_text(&d, pg, &tb)
        mem.buf_flush(&tb, 1)
        return 0
    }
    var zoom: f64 = 1.0
    if rt.arg_count(start) > 4 {
        zoom = read_dec(rt.arg_ptr(start, 4),
            rt.c_length(rt.arg_ptr(start, 4)))
    }
    if zoom <= 0.0 {
        zoom = 1.0
    }
    var fs: pfont.FontHold = pfont.fonthold_new()
    ppage.fonthold_load(&fs)
    var cv: canvas.Canvas = canvas.canvas_new()
    var stv: [usize; 5] = [0; 5]
    if !ppage.page_render(&d, pg, zoom, &cv, &fs, (&stv[0]) as *mut usize) {
        var e2: [u8; 11] = "RENDER-FAIL"
        lit(&out, (&e2[0]) as u64, 11)
        mem.buf_push(&out, 10 as u8)
        mem.buf_flush(&out, 1)
        return 5
    }
    var stat: mem.Buf = mem.buf_new()
    mem.buf_init(&stat)
    var sl: [u8; 5] = "STAT "
    lit(&stat, (&sl[0]) as u64, 5)
    var k: usize = 0
    var names: [u8; 32] = "ops|glyphs|paths|images|imgfail|"
    var s0: usize = 0
    var i0: usize = 0
    while i0 < 32 {
        if names[i0] == 124 as u8 {
            var q: usize = s0
            while q < i0 {
                mem.buf_push(&stat, names[q])
                q = q + 1
            }
            mem.buf_push(&stat, 61 as u8)
            mem.buf_push_dec(&stat, stv[k] as u64)
            mem.buf_push(&stat, 32 as u8)
            k = k + 1
            s0 = i0 + 1
        }
        i0 = i0 + 1
    }
    mem.buf_push(&stat, 10 as u8)
    mem.buf_flush(&stat, 2)
    var img: mem.Buf = mem.buf_new()
    mem.buf_init(&img)
    png.write_ppm(&cv, &img)
    if rt.arg_count(start) > 5 {
        rt.write_file(rt.arg_ptr(start, 5), mem.buf_ptr(&img) as u64,
            mem.buf_len(&img))
    } else {
        mem.buf_flush(&img, 1)
    }
    return 0
}
