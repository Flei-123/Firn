manifest 1
app logiclab
title "LogicLab program API (roadmap r38, docs/PROJECT-MODEL.md section 5)"
# api 1.0 -- these actions are the MCP tools (npm run api:mcp), the CLI
# (npm run api -- call <dir> <action> --arg k=v) and the OrientOS action
# bus entries: one manifest, same format as openplan/model/ACTIONS.
# LogicLab owns the layers logic/ and (electronics) the circuit file.
# SemVer: new action / optional argument = minor, removed / changed = major.

action logiclab.api_version read "The API version and the number of actions"
  returns api string "Version of this API (SemVer)"
  returns actions int "How many actions the manifest has"

action logiclab.logic_query read "Read the logic layer: its equations (defines and equations) as JSON rows"
  arg filter string optional "Part of a name, e.g. CALL (matches the start)"
  returns rows string "One JSON object per line: id, name, expr"

action logiclab.logic_check read "Check the io and logic layers: ids unique, expressions parse, every name declared"
  returns errors int "How many problems were found"
  returns report string "One line per problem"

action logiclab.logic_simulate read "Build the circuit from the equations and simulate it until it rests; set inputs, read every output"
  arg inputs string optional "Switch settings, e.g. S1=1; S2=0 (others stay 0)"
  returns states string "One JSON line: every input and every computed name"

action logiclab.logic_statemachine read "Read the state machine of the logic layer: states, initial state, transitions with guards"
  returns machine string "JSON: id, initial, states [id, name], transitions [id, from, to, guard]"

action logiclab.logic_run_tests read "Run the tests layer (tests/tests.json): every scenario, every invariant after every step, on the PLC scan semantics (timers, counters, state machine)"
  arg scenario string optional "Only this scenario id"
  returns passed int "Scenarios passed"
  returns failed int "Scenarios failed"
  returns report string "One line per scenario"

action logiclab.plc_run_tests read "Run the PLC program (plc/main.st, or the ST program plc/plc.json names) through the tests layer with the ST interpreter and compare it with the logic layer after every step"
  arg scenario string optional "Only this scenario id"
  arg file string optional "Program file under plc/ (default: the ST program plc/plc.json names, else main.st)"
  returns passed int "Scenarios passed on the program"
  returns failed int "Scenarios failed on the program"
  returns identical int "1 when the program and the logic layer agree on every signal, memory bit, state, timer and counter after every step, else 0"
  returns report string "One line per scenario"
  returns differences string "Where the program and the layer differ (at most 10 lines)"

action logiclab.logic_set_expr write "Change the expression of one define or equation (by id) in the logic layer"
  arg id string required "Id of the define or equation"
  arg expr string required "New expression, shared syntax: names & | ! ( ) 0 1"
  returns summary string "Old and new expression"
  dryrun
  undo logiclab.logic_set_expr

action logiclab.logic_add_equation write "Add an equation (target = expr) to the logic layer"
  arg id string required "Id of the new equation"
  arg target string required "The name that is computed (declared in the io layer or a define)"
  arg expr string required "Expression, shared syntax"
  arg index string optional "Position in the list of equations (they run in list order; default: last, undo puts a removed one back in its place)"
  arg extra string optional "JSON object with further fields of the equation (used by undo to restore requirements and notes of other tools)"
  returns summary string "What was added"
  dryrun
  undo logiclab.logic_remove_equation

action logiclab.logic_remove_equation write "Remove an equation (by id) from the logic layer"
  arg id string required "Id of the equation"
  returns summary string "What was removed"
  dryrun
  undo logiclab.logic_add_equation

action logiclab.logic_add_state write "Add a state to the state machine of the logic layer (the first state creates the machine and becomes the initial state)"
  arg id string required "Id of the new state"
  arg name string required "Name of the state (letters, digits, _): it is a BOOL name in guards and equations, one-hot"
  arg description string optional "What the state means"
  arg index string optional "Position in the list of states (default: at the end)"
  arg machine string optional "Id of the machine, only when this state creates it (default SM1)"
  arg extra string optional "JSON object with further fields of the state (used by undo to restore requirements and notes of other tools)"
  returns summary string "What was added"
  dryrun
  undo logiclab.logic_remove_state

action logiclab.logic_remove_state write "Remove a state (refused while a transition uses it or while it is the initial state of a bigger machine)"
  arg id string required "Id of the state"
  returns summary string "What was removed"
  dryrun
  undo logiclab.logic_add_state

action logiclab.logic_rename_state write "Rename a state; every guard, define, equation, timer and counter that uses the old name follows"
  arg id string required "Id of the state"
  arg name string required "New name"
  returns summary string "Old and new name"
  dryrun
  undo logiclab.logic_rename_state

action logiclab.logic_set_initial write "Make a state the initial state of the machine"
  arg id string required "Id of the state"
  returns summary string "Old and new initial state"
  dryrun
  undo logiclab.logic_set_initial

action logiclab.logic_add_transition write "Add a transition: it fires when the machine is in `from` (or any state: *) and the guard holds. The first matching transition in the list fires, so the position is the priority"
  arg id string required "Id of the new transition"
  arg from string required "Id of the source state, or * for any state"
  arg to string required "Id of the target state"
  arg guard string required "Guard expression, shared syntax: names & | ! ( ) 0 1"
  arg description string optional "What the transition does"
  arg index string optional "Position in the list = priority (default: last)"
  arg extra string optional "JSON object with further fields of the transition (used by undo to restore requirements and notes of other tools)"
  returns summary string "What was added"
  dryrun
  undo logiclab.logic_remove_transition

action logiclab.logic_set_transition write "Change a transition: source, target and/or guard (give only what changes)"
  arg id string required "Id of the transition"
  arg from string optional "New source state id, or *"
  arg to string optional "New target state id"
  arg guard string optional "New guard expression"
  returns summary string "Before and after"
  dryrun
  undo logiclab.logic_set_transition

action logiclab.logic_set_timer write "Change a timer (TON/TOF/TP) of the logic layer: its input expression, kind and/or preset (give only what changes)"
  arg id string required "Id of the timer"
  arg input string optional "New input expression"
  arg kind string optional "TON, TOF or TP (empty = the default TON)"
  arg preset_ms string optional "New preset in milliseconds"
  returns summary string "Before and after"
  dryrun
  undo logiclab.logic_set_timer

action logiclab.logic_set_counter write "Change an up counter (CTU) of the logic layer: its count input, reset expression and/or preset (give only what changes)"
  arg id string required "Id of the counter"
  arg up string optional "New count-up expression"
  arg reset string optional "New reset expression (empty = no reset)"
  arg preset string optional "New preset (whole number >= 1)"
  returns summary string "Before and after"
  dryrun
  undo logiclab.logic_set_counter

action logiclab.logic_move_transition write "Change the priority of a transition: move it to a position in the list (0 = highest)"
  arg id string required "Id of the transition"
  arg index string required "New position (0 = first)"
  returns summary string "Old and new priority"
  dryrun
  undo logiclab.logic_move_transition

action logiclab.logic_remove_transition write "Remove a transition (by id)"
  arg id string required "Id of the transition"
  returns summary string "What was removed"
  dryrun
  undo logiclab.logic_add_transition

action logiclab.list_parts read "List the component library: builtin parts and logic blocks, library parts and the project's own (library/parts/*.json): id, category, domain, pins, parameters, how to place it"
  arg query string optional "Search words (name, id, category, keywords), e.g. poti"
  arg domain string optional "Only analog, digital or mixed components"
  returns parts string "One JSON object per line: id, name, category, domain, source, place, pins, params"
  returns count int "How many components"

action logiclab.define_part write "Define a new component from data only (schema logiclab.component/1, docs/component-library.md): validated, then stored as library/parts/<id>.json of the project folder; place it with circuit_add_part"
  arg definition string required "The component definition as JSON text"
  returns summary string "What was defined"
  returns place string "The kind to give circuit_add_part"
  dryrun
  undo logiclab.remove_part_definition

action logiclab.remove_part_definition write "Remove a defined component (the undo of define_part)"
  arg id string required "Id of the component"
  returns summary string "What was removed"
  dryrun
  undo logiclab.define_part

action logiclab.circuit_info read "Read a circuit file (project json or bare schematic): parts, wires, nets, core (logic or analog)"
  arg file string required "Path to the circuit file"
  returns info string "JSON: parts [label, kind], nets, core"

action logiclab.circuit_op read "DC operating point of a circuit file (mixed signal: logic blocks behind A/D, D/A bridges)"
  arg file string required "Path to the circuit file"
  returns v string "JSON: node voltages"
  returns i string "JSON: branch currents"

action logiclab.circuit_transient read "Transient run of a circuit file; per net: final, min, max value"
  arg file string required "Path to the circuit file"
  arg tstop string optional "Stop time, e.g. 5m (default: from the file)"
  arg tstep string optional "Step, e.g. 10u (default: from the file)"
  returns nets string "JSON: per net final, min, max"

action logiclab.circuit_spice read "Export a circuit file as a SPICE netlist (ngspice/XSPICE)"
  arg file string required "Path to the circuit file"
  returns text string "The netlist"

action logiclab.circuit_set_param write "Set a parameter of a part (by label, e.g. R1) in a circuit file"
  arg file string required "Path to the circuit file"
  arg part string required "Label of the part, e.g. R1"
  arg param string required "Parameter name, e.g. value"
  arg value string required "New value, e.g. 4k7"
  returns summary string "Old and new value"
  dryrun
  undo logiclab.circuit_set_param

action logiclab.circuit_new write "Create an empty circuit file (bare schematic)"
  arg file string required "Path of the new file (must not exist)"
  returns summary string "What was created"
  dryrun
  undo logiclab.circuit_delete

action logiclab.circuit_delete write "Delete a circuit file (only an empty one; the undo of circuit_new)"
  arg file string required "Path of the circuit file"
  returns summary string "What was deleted"
  dryrun
  undo logiclab.circuit_new

action logiclab.circuit_add_part write "Place a part: kind R C L VDC VAC VPULSE IDC D NPN PNP NMOS PMOS OPAMP ..., BLOCK:<type> for a logic block (AND, OR, NOT, SWITCH, LED ...) or the id of a library / project component (see list_parts, e.g. potentiometer)"
  arg file string required "Path to the circuit file"
  arg kind string required "Part kind, e.g. R, VDC, BLOCK:AND, potentiometer, DEF:potentiometer"
  arg x int optional "Grid position x (default: next free column)"
  arg y int optional "Grid position y (default 20)"
  arg label string optional "Designator (default: next free, e.g. R3)"
  arg params string optional "JSON object of parameters, e.g. {\"value\":\"4k7\"}"
  returns summary string "The new part's label and terminals"
  dryrun
  undo logiclab.circuit_remove_part

action logiclab.circuit_remove_part write "Remove a part (by label) with the net labels on its terminals"
  arg file string required "Path to the circuit file"
  arg part string required "Label of the part"
  returns summary string "What was removed"
  dryrun
  undo logiclab.circuit_add_part

action logiclab.circuit_connect write "Connect two terminals (part.index, e.g. R1.0 and V1.1) by a shared net name; ground is net 0"
  arg file string required "Path to the circuit file"
  arg a string required "First terminal, e.g. R1.0"
  arg b string required "Second terminal, e.g. V1.1"
  arg net string optional "Net name (default: the name already on a terminal, else a new one; 0 = ground)"
  returns summary string "The net name"
  dryrun
  undo logiclab.circuit_disconnect

action logiclab.circuit_disconnect write "Take a terminal off its net (removes the net label on it)"
  arg file string required "Path to the circuit file"
  arg a string required "Terminal, e.g. R1.0"
  arg b string optional "A second terminal to take off as well"
  returns summary string "What was removed"
  dryrun
  undo logiclab.circuit_connect

action logiclab.undo write "Undo the newest command of this caller (replays the inverse named in the journal)"
  returns summary string "What was undone"
