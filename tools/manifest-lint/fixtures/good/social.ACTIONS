# pakete/social/ACTIONS -- the social layer on orient-bus (docs/SOCIAL.md).
# Installed as /apps/social.prog/ACTIONS; read by orient-bus.
manifest 1
app social
title "Friends, presence and activity"

action social.status read "The providers, how many contacts, who is online"
  returns providers int "How many providers are configured"
  returns provider.N string "name state contacts, e.g. fleitec ok 12"
  returns contacts int "Contacts in the merged book"
  returns online int "Friends online, away or busy"
  returns active int "Friends with an activity"
  returns presence string "My presence: online, away, dnd or invisible"
  returns activity string "My activity, empty when none"

action social.contacts.list read "The merged address book, one contact per line"
  arg filter string optional "all, friends, online, active, incoming or outgoing"
  arg offset int optional "Skip this many (paging)"
  returns total int "How many match the filter"
  returns next int "Offset of the next page, 0 when this was the last"
  returns contact.N string "provider:id|relation|presence|name|handle|status|activity|since_s"

action social.contacts.get read "One contact with every field"
  arg id string required "provider:id, e.g. fleitec:u_ANNA"
  returns name string "Display name"
  returns relation string "friend, incoming, outgoing, blocked or none"
  returns presence string "online, away, dnd, offline or unknown"
  returns activity string "What the person does, e.g. a game"

action social.contacts.search read "Find people at the providers"
  arg query string required "@handle, name or number"
  returns count int "How many were found"
  returns contact.N string "provider:id|relation|presence|name|handle|||"

action social.contacts.request write "Ask somebody to be friends"
  arg id string required "provider:id"
  returns relation string "The relation afterwards"
  dryrun
  undo social.contacts.withdraw

action social.contacts.accept write "Accept a friend request"
  arg id string required "provider:id"
  returns relation string "The relation afterwards"
  dryrun
  undo social.contacts.remove

action social.contacts.decline write "Decline a friend request"
  arg id string required "provider:id"
  dryrun

action social.contacts.withdraw write "Withdraw my own friend request"
  arg id string required "provider:id"
  dryrun

action social.contacts.remove write "End a friendship"
  arg id string required "provider:id"
  dryrun

action social.presence.set write "Set my presence and status line"
  arg state string required "online, away, dnd or invisible"
  arg text string optional "The status line"
  returns presence string "The presence afterwards"
  dryrun

action social.activity.set write "Tell friends what I do, e.g. which game"
  arg name string required "What it is, e.g. Counter-Strike 2"
  arg kind string optional "playing (default), listening, watching"
  returns shared bool "Whether it went out (privacy may keep it local)"
  dryrun

action social.activity.clear write "Stop showing an activity"
  dryrun

action social.refresh read "Ask every provider again now"
  returns contacts int "Contacts in the merged book"

action social.privacy.set critical "Share my activity with friends or not"
  arg share_activity bool required "true shares it, false keeps it on this device"
  dryrun

event social.presence "A friend's presence changed"
  field id string "provider:id"
  field presence string "online, away, dnd, offline or unknown"
event social.activity "A friend's activity started, changed or ended"
  field id string "provider:id"
  field activity string "The activity, empty when it ended"
event social.contact "A relation changed (request, friendship, gone)"
  field id string "provider:id"
  field relation string "friend, incoming, outgoing, blocked or none"
