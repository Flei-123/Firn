# pakete/notes/ACTIONS -- the action manifest of the example app `notes`.
# Installed as /apps/notes.prog/ACTIONS; read by orient-bus.
# Format: docs/ACTION-BUS.md, section 3.
manifest 1
app notes
title "Notes"

action notes.add write "Add a note at the end of the list"
  arg text string required "The text of the note, one line"
  returns count int "How many notes there are afterwards"
  returns index int "The number of the new note (1 = first)"
  dryrun
  undo notes.remove

action notes.remove write "Remove one note"
  arg index int required "The number of the note, 1 = first"
  returns count int "How many notes there are afterwards"
  dryrun

action notes.count read "How many notes there are"
  returns count int "The number of notes"

action notes.list read "All notes, one per line"
  returns count int "The number of notes"
  returns note.N string "The text of note N"

action notes.clear critical "Delete ALL notes"
  returns deleted int "How many notes were deleted"
  dryrun

event notes.changed "Sent after every change of the list"
  field count int "How many notes there are now"
