manifest 1
app openplan
title "OpenPlan project model (docs/PROJECT-MODEL.md)"
# api 1.0 -- the programme API (r50): these actions are the MCP tools
# (tools/model/opmodel.py mcp), the JSON-RPC methods over a local socket
# (opmodel.py serve) and the OrientOS action bus entries, one manifest.
# SemVer: a new action or optional argument is a minor step, a removed or
# changed one a major step (announced one minor version before).

action openplan.api_version read "The API version and the number of actions"
  returns api string "Version of this API (SemVer)"
  returns actions int "How many actions the manifest has"

action openplan.plan_query read "Read the plan: one of the reports devices, connections, terminals, strips, potentials, project, pages as JSON rows"
  arg query string required "devices, connections, terminals, strips, potentials, project or pages"
  arg filter string optional "<column>=<value> (a trailing * matches a prefix)"
  returns rows string "The rows, one JSON object per line"

action openplan.plan_check read "Check the plan: load and derive messages, wire colours after the project's standard, the cabinet checks, the model check"
  returns errors int "How many errors were found"
  returns report string "One line per finding"

action openplan.sim_run read "Simulate the relay control circuit: press/release push buttons, the states after every event"
  arg events string required "e.g. press -S1; release -S1; press -S0"
  returns states string "One JSON line per state"

action openplan.plc_program read "The PLC program read from the relay plan: st, xml (PLCopen), io (I/O list) or ladder"
  arg format string required "st, xml, io or ladder"
  returns text string "The program / list"

action openplan.plc_verify read "Plan against its PLC version and program, event by event (0 differences = the same behaviour)"
  returns differences int "States that differ"
  returns report string "The comparison"

action openplan.export read "Export: golden (the project as one document), svg:<page>, report_csv:<name> (also parts), pdf, pdfa (binary: written to .cache/export/ in the project, the result names the file), plc_st, plc_xml, spice, cabinet_bom, cabinet_svg, cabinet_labels"
  arg kind string required "What to export"
  returns text string "The exported file (text kinds)"
  returns file string "The written file (pdf, pdfa)"
  returns bytes int "Its size in octets (pdf, pdfa)"

action openplan.strip_edit write "Edit a terminal strip with the strip editor commands (sort, move, insert, spare, rename, accessory, jumper ...)"
  arg strip string required "The strip, e.g. -X1"
  arg commands string required "Strip editor commands separated by ;"
  returns summary string "What changed"
  dryrun
  undo openplan.schematic_restore

action openplan.plan_edit write "Edit the plan with the editor commands: insert <def> [<designation>] [at <page> <x> <y>], connect <fid>:<point> <fid>:<point>, move, rotate, mirror, set <fid> <key> <value>, rename"
  arg commands string required "Editor commands separated by ;"
  returns summary string "What changed (the id of the last inserted function)"
  dryrun
  undo openplan.schematic_restore

action openplan.device_rename write "Rename a device everywhere (all its functions, the cross-references follow)"
  arg old string required "The designation now, e.g. -K1"
  arg new string required "The new designation, e.g. -K5"
  returns summary string "What changed"
  dryrun
  undo openplan.schematic_restore

action openplan.standard_convert write "Change the project's standard (iec or ansi): letter codes, colours, sheets kept"
  arg to string required "iec or ansi"
  returns summary string "What changed"
  dryrun
  undo openplan.schematic_restore

action openplan.schematic_restore write "Put the schematic back to a saved state (the undo of a schematic command)"
  arg snapshot string required "The snapshot id from the journal"
  returns summary string "What changed"
  dryrun
  undo openplan.schematic_restore

action openplan.cabinet_apply write "Lay out the cabinet from the plan (op cabinet plan) into the cabinet layer"
  arg enclosure string optional "<W>x<H>x<D> in mm; empty = the smallest standard size that fits"
  returns summary string "Enclosure, rails and slots"
  dryrun
  undo openplan.cabinet_restore

action openplan.cabinet_restore write "Put the cabinet layer back to a saved state (the undo of cabinet_apply)"
  arg snapshot string required "The snapshot id from the journal"
  returns summary string "What changed"
  dryrun
  undo openplan.cabinet_restore

action openplan.model_check read "Check the project: every layer against its schema, every id unique, every reference resolved"
  returns errors int "How many problems were found"
  returns report string "One line per problem"

action openplan.io_add_signal write "Add a signal to the I/O list (layer io)"
  arg id string required "The signal's id, e.g. SIG-S15; never changes"
  arg name string required "The identifier in logic and PLC programs, e.g. CALL5"
  arg direction string required "in or out"
  arg device string required "Device designation in the schematic, e.g. -S15"
  arg address string optional "PLC address, e.g. %IX1.4"
  arg description string optional "What the signal is"
  returns id string "The id of the new signal"
  dryrun
  undo openplan.io_remove_signal

action openplan.io_remove_signal write "Remove a signal from the I/O list (refused while another layer refers to it)"
  arg id string required "The signal's id"
  returns id string "The id of the removed signal"
  dryrun
  undo openplan.io_add_signal

action openplan.io_link_terminal write "Link a signal to a terminal and, optionally, a cabinet slot"
  arg id string required "The signal's id"
  arg terminal string required "<strip>:<terminal>, e.g. X1:5; empty to unlink"
  arg slot string optional "Cabinet slot id; empty to unlink"
  returns id string "The id of the signal"
  dryrun
  undo openplan.io_link_terminal

action openplan.object_put write "Add or replace an object of a layer (logic defines/equations/hardwired/memory/timers/counters, plc cards/channels/programs, tests scenarios/invariants, cabinet rails/slots, io signals, requirements); checked against the layer's schema and references"
  arg layer string required "requirements, io, logic, plc, cabinet or tests"
  arg collection string required "e.g. equations, channels, scenarios, slots"
  arg object string required "The object as JSON; its id says which one it replaces"
  arg at int optional "Position of a new object (0-based); default the end"
  returns id string "The id of the object"
  dryrun
  undo openplan.object_remove

action openplan.object_remove write "Remove an object of a layer (refused while the project refers to it)"
  arg layer string required "requirements, io, logic, plc, cabinet or tests"
  arg collection string required "e.g. equations, channels, scenarios, slots"
  arg id string required "The object's id"
  returns id string "The id of the removed object"
  dryrun
  undo openplan.object_put

action openplan.requirement_release critical "Release a safety requirement after review by a qualified person"
  arg id string required "The requirement's id"
  arg released_by string required "Name of the qualified person who reviewed it"
  returns id string "The id of the requirement"
  dryrun

event openplan.model_changed "Sent after every command that changed the project"
  field layer string "The layer that changed"
  field action string "The command"
