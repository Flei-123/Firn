// tools/mail_send_cross/sendtool.fi -- sends one mail with mail.mail; driven by mail_send_cross.py.
//   sendtool <port> <from> <to> <subject> <bodyfile> [<attachfile> <ctype> <name>]...
// Exit 0 = accepted, 1 = refused/failed, 2 = usage.
import std.rt
import std.fs
import mail.mail

fn arg_str(start: u64, i: usize) -> str {
    let a: u64 = rt.arg_ptr(start, i)
    return str { p: a as *mut u8, n: rt.c_length(a) }
}

fn parse_dec(s: str) -> u64 {
    var v: u64 = 0
    var i: usize = 0
    while i < s.n {
        v = v * 10 + (rt.ld8(s.p as u64, i) - 48 as u8) as u64
        i = i + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    let argc: usize = rt.arg_count(start)
    if argc < 6 || (argc - 6) % 3 != 0 {
        return 2
    }
    var body: rt.Buf = rt.buf_new()
    fs.read_file(arg_str(start, 5), &body) catch 0
    var m: mail.Mail = mail.message(arg_str(start, 2), arg_str(start, 3), arg_str(start, 4), rt.buf_str(&body))
    var i: usize = 6
    while i + 2 < argc + 0 {
        var data: rt.Buf = rt.buf_new()
        fs.read_file(arg_str(start, i), &data) catch 0
        mail.attach(&m, arg_str(start, i + 2), arg_str(start, i + 1), rt.buf_str(&data))
        rt.buf_free(&data)
        i = i + 3
    }
    var rc: i32 = 1
    if mail.send("127.0.0.1", parse_dec(arg_str(start, 1)) as u16, &m) {
        rc = 0
    }
    return rc
}
