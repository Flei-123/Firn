// SPDX-License-Identifier: GPL-2.0-only
// tools/k3net/link.fi -- a wire that is allowed to be bad.
//
// The in-process half of the measurement: two stacks out of lib/net/ are
// joined by this, and it can do everything a real cable does badly --
// lose frames, hold them back so that they arrive in the wrong order,
// and flip an octet so that the checksum has something to catch.
//
// Everything in it is DETERMINISTIC. The pseudo random generator is the
// same one the rest of the project uses (Knuth's MMIX constants), the
// seed comes from outside, and a run with the same seed drops exactly
// the same frames. A loss test that is not reproducible is a test that
// nobody can debug.

import net.wire

export {
    Link, link_init, link_push, link_pump_out, link_ready,
    link_dropped, link_delivered, link_corrupted, link_queued, link_seen,
    link_set,
}

const CAP: usize = 128
const SLOT: usize = 1536

struct Link {
    rand: u64,
    loss: u32, // per mille
    reorder: u32, // per mille
    corrupt: u32, // per mille
    delay: u64, // base delay in microseconds
    jitter: u64, // the extra delay a reordered frame gets

    n: usize,
    len: [usize; 128],
    at: [u64; 128],
    used: [u32; 128],
    buf: [u8; 196608],

    dropped: u64,
    delivered: u64,
    corrupted: u64,
    seen: u64,
}

fn link_init(l: *mut Link, seed: u64, delay: u64) {
    (*l).rand = wire.next_random(seed)
    (*l).loss = 0
    (*l).reorder = 0
    (*l).corrupt = 0
    (*l).delay = delay
    (*l).jitter = delay * 4 + 1000
    (*l).n = 0
    var i: usize = 0
    while i < CAP {
        (*l).used[i] = 0
        i = i + 1
    }
    (*l).dropped = 0
    (*l).delivered = 0
    (*l).corrupted = 0
    (*l).seen = 0
}

fn link_set(l: *mut Link, loss: u32, reorder: u32, corrupt: u32) {
    (*l).loss = loss
    (*l).reorder = reorder
    (*l).corrupt = corrupt
}

fn link_dropped(l: *mut Link) -> u64 { return (*l).dropped }
fn link_delivered(l: *mut Link) -> u64 { return (*l).delivered }
fn link_corrupted(l: *mut Link) -> u64 { return (*l).corrupted }
fn link_seen(l: *mut Link) -> u64 { return (*l).seen }
fn link_queued(l: *mut Link) -> usize { return (*l).n }

fn roll(l: *mut Link, per_mille: u32) -> bool {
    (*l).rand = wire.next_random((*l).rand)
    if per_mille == 0 { return false }
    return (((*l).rand >> 33) % 1000) < per_mille as u64
}

fn slot(l: *mut Link, i: usize) -> *mut u8 {
    return &(*l).buf[i * SLOT]
}

fn link_push(l: *mut Link, f: *mut u8, n: usize, now: u64) {
    (*l).seen = (*l).seen +% 1
    if n > SLOT { (*l).dropped = (*l).dropped +% 1; return }
    if roll(l, (*l).loss) {
        (*l).dropped = (*l).dropped +% 1
        return
    }
    var k: usize = CAP
    var i: usize = 0
    while i < CAP {
        if (*l).used[i] == 0 { k = i; i = CAP } else { i = i + 1 }
    }
    if k == CAP {
        // The queue is full -- that IS a loss, and it is counted as one
        // instead of being hidden.
        (*l).dropped = (*l).dropped +% 1
        return
    }
    wire.copy(slot(l, k), f, n)
    if roll(l, (*l).corrupt) {
        // One octet in the middle of the frame, so the change always
        // lands in a header or a payload and never in the Ethernet
        // address (where the frame would just be ignored).
        // Anywhere from the IP header onwards, so that the IP checksum,
        // the TCP header and the payload all get their turn.
        var pos: usize = 14
        if n > 15 { pos = 14 + (((*l).rand >> 20) % (n as u64 - 14)) as usize }
        if pos < n {
            let old: u8 = wire.ld8(slot(l, k), pos)
            wire.st8(slot(l, k), pos, old ^ 0x40 as u8)
            (*l).corrupted = (*l).corrupted +% 1
        }
    }
    var when: u64 = now + (*l).delay
    if roll(l, (*l).reorder) { when = when + (*l).jitter }
    (*l).len[k] = n
    (*l).at[k] = when
    (*l).used[k] = 1
    (*l).n = (*l).n + 1
}

// The next frame that is due. -1 when nothing is ready. The oldest due
// one goes first, so that without reordering the order stays the order.
fn link_ready(l: *mut Link, now: u64) -> i32 {
    var best: i32 = 0 - 1
    var bestat: u64 = 0
    var i: usize = 0
    while i < CAP {
        if (*l).used[i] == 1 && now >= (*l).at[i] {
            if best < 0 || (*l).at[i] < bestat {
                best = i as i32
                bestat = (*l).at[i]
            }
        }
        i = i + 1
    }
    return best
}

fn link_pump_out(l: *mut Link, k: i32, out: *mut u8, cap: usize) -> usize {
    let i: usize = k as usize
    var n: usize = (*l).len[i]
    if n > cap { n = cap }
    wire.copy(out, slot(l, i), n)
    (*l).used[i] = 0
    (*l).n = (*l).n - 1
    (*l).delivered = (*l).delivered +% 1
    return n
}
