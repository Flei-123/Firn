// SPDX-License-Identifier: MPL-2.0
// tools/mc/raster/spanbench.fi -- deterministic triangle soup for mc_raster (hash must not change, count instructions).
// Prints: image hash, pixel count, triangle count. Usage: spanbench [rounds=40]
import std.rt
import std.io
import std.env
import mc.mc_camera
import mc.mc_texture
import mc.mc_raster

fn rnd(cell: u64) -> f64 {
    let seed: u64 = (*(cell as *u64) * 1103515245 as u64 + 12345 as u64) & 0x7FFFFFFF as u64
    *(cell as *mut u64) = seed
    return (((seed >> 7 as u64) & 0xFFFFFF as u64) as f64) / 16777216.0
}

fn vtx(p: u64, i: usize, x: f64, y: f64, z: f64, u: f64, v: f64, ao: f64) {
    *((p + ((i * 6 + 0) * 8) as u64) as *mut f64) = x
    *((p + ((i * 6 + 1) * 8) as u64) as *mut f64) = y
    *((p + ((i * 6 + 2) * 8) as u64) as *mut f64) = z
    *((p + ((i * 6 + 3) * 8) as u64) as *mut f64) = u
    *((p + ((i * 6 + 4) * 8) as u64) as *mut f64) = v
    *((p + ((i * 6 + 5) * 8) as u64) as *mut f64) = ao
}

fn main() -> i32 {
    var a: mc_texture.Atlas = mc_texture.atlas_default()
    var cam: mc_camera.Camera = mc_camera.camera_new(320, 180)
    var r: mc_raster.Raster = mc_raster.raster_new(320, 180)
    mc_camera.camera_set_lens(&cam, 70.0, 0.05, 512.0)
    mc_camera.camera_update(&cam)
    mc_raster.raster_set_camera(&r, &cam)
    mc_raster.raster_set_atlas(&r, &a)
    mc_raster.raster_set_fog(&r, true, 2.0, 12.0, 120 as u32, 160 as u32, 200 as u32)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    let t: u64 = rt.heap_alloc(6 * 8 * 8)
    let cell: u64 = rt.heap_alloc(8)
    *(cell as *mut u64) = 12345 as u64
    let rounds: i64 = 200
    var k: i64 = 0
    while k < rounds {
        // mode 0: random large/medium triangles, mode 1: thin slivers, mode 2: small, mode 3: translucent + no cull
        let mode: i64 = k % 4 as i64
        mc_raster.raster_set_cull(&r, mode != 3 as i64)
        var n: i64 = 0
        while n < 60 {
            let z: f64 = 1.0 + 4.0 * rnd(cell)
            var spread: f64 = 2.5
            if mode == 2 as i64 { spread = 0.15 }
            let cx: f64 = (rnd(cell) - 0.5) * 4.0
            let cy: f64 = (rnd(cell) - 0.5) * 2.5
            var i: usize = 0
            while i < 3 {
                var dx: f64 = (rnd(cell) - 0.5) * spread
                var dy: f64 = (rnd(cell) - 0.5) * spread
                if mode == 1 as i64 {
                    // sliver along a diagonal
                    let s: f64 = (rnd(cell) - 0.5) * 6.0
                    dx = s + (rnd(cell) - 0.5) * 0.04
                    dy = s * 0.6 + (rnd(cell) - 0.5) * 0.04
                }
                vtx(t, i, cx + dx, cy + dy, z + rnd(cell) * 0.5, rnd(cell), rnd(cell), 3.0 * rnd(cell))
                i = i + 1
            }
            mc_raster.raster_draw_tri(&r, t, t + 48 as u64, t + 96 as u64, (1 + (n % 5)) as u32, 256 as u32)
            n = n + 1
        }
        k = k + 1
    }
    let h: u64 = rt.heap_alloc(64)
    mc_raster.raster_hash_hex(&r, h)
    io.print_bytes(h, 64)
    io.new_line()
    var f: io.Fmt = io.fmt_new()
    f = io.fmt_number(f, r.st.pixels as i64)
    io.fmt_print(f)
    io.new_line()
    return 0
}
