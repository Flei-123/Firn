// tools/mc/raster/bench.fi -- mc_raster speed: 640x360, a 5 x 5 field of sections (floor + stairs, greedy + AO)
// seen from above the middle, plus a pure triangle-setup run (tiny triangles). Prints metric lines.
import std.rt
import std.io
import mc.mc_mesh
import mc.mc_camera
import mc.mc_texture
import mc.mc_raster

fn now_ns() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000000 as u64 + (ts[1] as u64)
}

fn main() -> i32 {
    var a: mc_texture.Atlas = mc_texture.atlas_default()
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    tb.opaque = rt.heap_alloc(32768)
    tb.tiles = rt.heap_alloc(32768 * 6 * 2)
    var i: usize = 0
    while i < 32768 {
        rt.st8(tb.opaque, i, 0 as u8)
        i = i + 1
    }
    i = 0
    while i < 32768 * 6 {
        rt.st16(tb.tiles, i, 0 as u16)
        i = i + 1
    }
    var f: usize = 0
    while f < 6 {
        rt.st16(tb.tiles, 6 + f, (1 + f) as u16)
        rt.st16(tb.tiles, 12 + f, (7 + f) as u16)
        f = f + 1
    }
    rt.st8(tb.opaque, 1, 1 as u8)
    rt.st8(tb.opaque, 2, 1 as u8)
    var m: mc_mesh.Mesher = mc_mesh.mesher_new()
    let pad: u64 = rt.heap_alloc(5832 * 2)
    i = 0
    while i < 5832 {
        rt.st16(pad, i, 0 as u16)
        i = i + 1
    }
    var x: i32 = 0
    while x < 16 {
        var z: i32 = 0
        while z < 16 {
            // rolling hills: height 1..4 from a cheap function
            var h: i32 = 2 + ((x * 7 + z * 13) % 5) / 2
            var y: i32 = 0
            while y <= h {
                var id: u16 = 1 as u16
                if y < h - 1 { id = 2 as u16 }
                rt.st16(pad, (((y + 1) * 18 + (z + 1)) * 18 + (x + 1)) as usize, id)
                y = y + 1
            }
            z = z + 1
        }
        x = x + 1
    }
    mc_mesh.mesh_padded(&m, pad, &tb, mc_mesh.F_AO | mc_mesh.F_GREEDY)
    let nv: usize = m.nverts as usize
    let ni: usize = m.nidx as usize
    var cam: mc_camera.Camera = mc_camera.camera_new(640, 360)
    mc_camera.camera_set_pos(&cam, 40.0, 14.0, 20.0)
    mc_camera.camera_set_angles(&cam, 0.0, 40.0)
    mc_camera.camera_update(&cam)
    var r: mc_raster.Raster = mc_raster.raster_new(640, 360)
    mc_raster.raster_set_atlas(&r, &a)
    let frames: i32 = 20
    let t0: u64 = now_ns()
    var fr: i32 = 0
    while fr < frames {
        mc_raster.backend_begin(&r, &cam, 0xFFE6BE96 as u32)
        var sx: i32 = 0
        while sx < 5 {
            var sz: i32 = 0
            while sz < 5 {
                mc_raster.raster_draw_mesh(&r, m.verts, nv, m.idx, ni, (sx * 16) as f64, 0.0, (sz * 16) as f64)
                sz = sz + 1
            }
            sx = sx + 1
        }
        fr = fr + 1
    }
    let t1: u64 = now_ns()
    let ns: u64 = t1 - t0
    let tris_per_frame: u64 = r.st.tris_in / (frames as u64)
    io.fmt_print(f"metric scene640x360 frames={frames} ms_per_frame={ns / (frames as u64) / 1000000 as u64} tris_in_per_frame={tris_per_frame} drawn_per_frame={r.st.tris_drawn / (frames as u64)} px_written_per_frame={r.st.pixels / (frames as u64)} tris_per_s={r.st.tris_in * 1000000000 as u64 / ns}\n")
    // tiny triangles: setup cost (1 pixel each)
    mc_raster.raster_stats_reset(&r)
    mc_raster.backend_begin(&r, &cam, 0xFF000000 as u32)
    let t: u64 = rt.heap_alloc(3 * 6 * 8)
    var k: i32 = 0
    let t2: u64 = now_ns()
    while k < 200000 {
        let px: f64 = ((k % 600) as f64) / 100.0 - 3.0
        let py: f64 = (((k / 600) % 300) as f64) / 100.0 - 1.5
        var j: usize = 0
        while j < 3 {
            *((t + ((j * 6) * 8) as u64) as *mut f64) = px + (if j == 1 { 0.01 } else { 0.0 })
            *((t + ((j * 6 + 1) * 8) as u64) as *mut f64) = py + (if j == 2 { 0.01 } else { 0.0 })
            *((t + ((j * 6 + 2) * 8) as u64) as *mut f64) = 5.0
            *((t + ((j * 6 + 3) * 8) as u64) as *mut f64) = 0.5
            *((t + ((j * 6 + 4) * 8) as u64) as *mut f64) = 0.5
            *((t + ((j * 6 + 5) * 8) as u64) as *mut f64) = 3.0
            j = j + 1
        }
        mc_raster.raster_draw_tri(&r, t, t + 48 as u64, t + 96 as u64, 1 as u32, 256 as u32)
        k = k + 1
    }
    let t3: u64 = now_ns()
    io.fmt_print(f"metric tiny_tris n=200000 drawn={r.st.tris_drawn} tris_per_s={200000 as u64 * 1000000000 as u64 / (t3 - t2)}\n")
    return 0
}
