// tools/mc/packet/xcheck.fi -- Firn side of the mc_packet cross-check.
//
// Reads the records written by gen.cjs (node-minecraft-protocol / protodef):
//   [u8 tag][u32 BE length][packet bytes]
// decodes every packet with mc_packet, COPIES each field through an mc_packet
// Writer while reading, prints one canonical text line per packet (same format
// as expect.txt) and finally checks that the Writer produced exactly the input
// bytes (line suffix `RT=ok`). Any reader error is printed as `ERR=<code>`.
//
// Usage: xcheck <packets.bin>
import mc.mc_packet
import std.bytes
import std.rt
import std.io
import std.math

fn put_f(out: *mut rt.Buf, f: io.Fmt) {
    var g: io.Fmt = f
    rt.buf_push_bytes(out, rt.buf_ptr(&g.b), rt.buf_len(&g.b))
    io.fmt_free(g)
}

fn put_hex_bytes(out: *mut rt.Buf, p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        rt.buf_push_hex_u64(out, rt.ld8(p, i) as u64, 2)
        i = i + 1
    }
}

fn put_lit(out: *mut rt.Buf, c: u8) {
    rt.buf_push(out, c)
}

// One string field: read -> write through -> print as hex.
fn field_string(r: *mut mc_packet.Reader, w: *mut mc_packet.Writer, out: *mut rt.Buf, max: usize) {
    var n: usize = 0
    let p: u64 = mc_packet.rd_string(r, max, &n)
    if !mc_packet.rd_ok(r) { return }
    mc_packet.wr_string(w, p, n, max)
    put_hex_bytes(out, p, n)
}

fn field_slot(r: *mut mc_packet.Reader, w: *mut mc_packet.Writer, out: *mut rt.Buf) {
    var s: mc_packet.Slot = mc_packet.Slot { present: false, item_id: 0, count: 0 as i8, nbt: 0, nbt_len: 0 }
    mc_packet.rd_slot(r, 763, &s)
    if !mc_packet.rd_ok(r) { return }
    mc_packet.wr_slot(w, 763, &s)
    if !s.present {
        put_lit(out, 45 as u8)
        return
    }
    put_f(out, f"{s.item_id}:{s.count}:")
    put_hex_bytes(out, s.nbt, s.nbt_len)
}

fn bits32(v: f32) -> u64 { return math.math_bits32(v) as u64 }
fn bits64(v: f64) -> u64 { return math.math_bits(v) }

// Decodes one packet of record `tag`. Returns after the first error.
fn do_packet(tag: u8, r: *mut mc_packet.Reader, w: *mut mc_packet.Writer, out: *mut rt.Buf) {
    let id: i32 = mc_packet.rd_varint(r)
    mc_packet.wr_varint(w, id)
    put_f(out, f"{tag} ")
    if tag == 1 as u8 {
        put_f(out, f"system_chat id={id} content=")
        field_string(r, w, out, 262144)
        let a: bool = mc_packet.rd_bool(r)
        mc_packet.wr_bool(w, a)
        if a { put_f(out, f" action=1") } else { put_f(out, f" action=0") }
    } else if tag == 2 as u8 {
        let x: f64 = mc_packet.rd_f64(r)
        let y: f64 = mc_packet.rd_f64(r)
        let z: f64 = mc_packet.rd_f64(r)
        let yaw: f32 = mc_packet.rd_f32(r)
        let pitch: f32 = mc_packet.rd_f32(r)
        let flags: i8 = mc_packet.rd_i8(r)
        let tp: i32 = mc_packet.rd_varint(r)
        mc_packet.wr_f64(w, x)
        mc_packet.wr_f64(w, y)
        mc_packet.wr_f64(w, z)
        mc_packet.wr_f32(w, yaw)
        mc_packet.wr_f32(w, pitch)
        mc_packet.wr_i8(w, flags)
        mc_packet.wr_varint(w, tp)
        put_f(out, f"position id={id} x=")
        rt.buf_push_hex_u64(out, bits64(x), 16)
        put_f(out, f" y=")
        rt.buf_push_hex_u64(out, bits64(y), 16)
        put_f(out, f" z=")
        rt.buf_push_hex_u64(out, bits64(z), 16)
        put_f(out, f" yaw=")
        rt.buf_push_hex_u64(out, bits32(yaw), 8)
        put_f(out, f" pitch=")
        rt.buf_push_hex_u64(out, bits32(pitch), 8)
        put_f(out, f" flags={flags} tp={tp}")
    } else if tag == 3 as u8 {
        var x: i32 = 0
        var y: i32 = 0
        var z: i32 = 0
        mc_packet.rd_position(r, &x, &y, &z)
        let t: i32 = mc_packet.rd_varint(r)
        mc_packet.wr_position(w, x, y, z)
        mc_packet.wr_varint(w, t)
        put_f(out, f"block_change id={id} pos={x},{y},{z} type={t}")
    } else if tag == 4 as u8 {
        let eid: i32 = mc_packet.rd_varint(r)
        var hi: u64 = 0
        var lo: u64 = 0
        mc_packet.rd_uuid(r, &hi, &lo)
        let x: f64 = mc_packet.rd_f64(r)
        let y: f64 = mc_packet.rd_f64(r)
        let z: f64 = mc_packet.rd_f64(r)
        let yaw: i8 = mc_packet.rd_i8(r)
        let pitch: i8 = mc_packet.rd_i8(r)
        mc_packet.wr_varint(w, eid)
        mc_packet.wr_uuid(w, hi, lo)
        mc_packet.wr_f64(w, x)
        mc_packet.wr_f64(w, y)
        mc_packet.wr_f64(w, z)
        mc_packet.wr_i8(w, yaw)
        mc_packet.wr_i8(w, pitch)
        put_f(out, f"named_entity_spawn id={id} eid={eid} uuid=")
        rt.buf_push_hex_u64(out, hi, 16)
        rt.buf_push_hex_u64(out, lo, 16)
        put_f(out, f" x=")
        rt.buf_push_hex_u64(out, bits64(x), 16)
        put_f(out, f" y=")
        rt.buf_push_hex_u64(out, bits64(y), 16)
        put_f(out, f" z=")
        rt.buf_push_hex_u64(out, bits64(z), 16)
        put_f(out, f" yaw={yaw} pitch={pitch}")
    } else if tag == 5 as u8 {
        let age: i64 = mc_packet.rd_i64(r)
        let t: i64 = mc_packet.rd_i64(r)
        mc_packet.wr_i64(w, age)
        mc_packet.wr_i64(w, t)
        put_f(out, f"update_time id={id} age={age} time={t}")
    } else if tag == 6 as u8 {
        put_f(out, f"custom_payload id={id} channel=")
        var n: usize = 0
        let p: u64 = mc_packet.rd_identifier(r, &n)
        if mc_packet.rd_ok(r) {
            mc_packet.wr_identifier(w, p, n)
            put_hex_bytes(out, p, n)
            put_f(out, f" data=")
            var dn: usize = 0
            let dp: u64 = mc_packet.rd_rest(r, &dn)
            mc_packet.wr_raw(w, dp, dn)
            put_hex_bytes(out, dp, dn)
        }
    } else if tag == 7 as u8 {
        put_f(out, f"settings id={id} locale=")
        field_string(r, w, out, 16)
        let vd: i8 = mc_packet.rd_i8(r)
        let cf: i32 = mc_packet.rd_varint(r)
        let cc: bool = mc_packet.rd_bool(r)
        let sp: u8 = mc_packet.rd_u8(r)
        let mh: i32 = mc_packet.rd_varint(r)
        let tf: bool = mc_packet.rd_bool(r)
        let sl: bool = mc_packet.rd_bool(r)
        mc_packet.wr_i8(w, vd)
        mc_packet.wr_varint(w, cf)
        mc_packet.wr_bool(w, cc)
        mc_packet.wr_u8(w, sp)
        mc_packet.wr_varint(w, mh)
        mc_packet.wr_bool(w, tf)
        mc_packet.wr_bool(w, sl)
        var ccv: i32 = 0
        var tfv: i32 = 0
        var slv: i32 = 0
        if cc { ccv = 1 }
        if tf { tfv = 1 }
        if sl { slv = 1 }
        put_f(out, f" vd={vd} cf={cf} cc={ccv} sp={sp} mh={mh} tf={tfv} sl={slv}")
    } else if tag == 8 as u8 {
        let win: u8 = mc_packet.rd_u8(r)
        let state: i32 = mc_packet.rd_varint(r)
        mc_packet.wr_u8(w, win)
        mc_packet.wr_varint(w, state)
        let n: usize = mc_packet.rd_array_count(r, 1, 4096)
        mc_packet.wr_array_count(w, n)
        put_f(out, f"window_items id={id} win={win} state={state} n={n} items=")
        var i: usize = 0
        while i < n && mc_packet.rd_ok(r) {
            if i > 0 { put_lit(out, 44 as u8) }
            field_slot(r, w, out)
            i = i + 1
        }
        put_f(out, f" carried=")
        field_slot(r, w, out)
    } else if tag == 9 as u8 {
        let tx: i32 = mc_packet.rd_varint(r)
        let st: i32 = mc_packet.rd_varint(r)
        let ln: i32 = mc_packet.rd_varint(r)
        mc_packet.wr_varint(w, tx)
        mc_packet.wr_varint(w, st)
        mc_packet.wr_varint(w, ln)
        let n: usize = mc_packet.rd_array_count(r, 2, 4096)
        mc_packet.wr_array_count(w, n)
        put_f(out, f"tab_complete id={id} tx={tx} start={st} len={ln} n={n} m=")
        var i: usize = 0
        while i < n && mc_packet.rd_ok(r) {
            if i > 0 { put_lit(out, 44 as u8) }
            field_string(r, w, out, 32767)
            put_lit(out, 47 as u8)
            let has: bool = mc_packet.rd_optional(r)
            mc_packet.wr_optional(w, has)
            if has && mc_packet.rd_ok(r) {
                field_string(r, w, out, 262144)
            } else {
                put_lit(out, 45 as u8)
            }
            i = i + 1
        }
    } else if tag == 10 as u8 {
        put_f(out, f"chat_message id={id} msg=")
        field_string(r, w, out, 256)
        let ts: i64 = mc_packet.rd_i64(r)
        let salt: i64 = mc_packet.rd_i64(r)
        mc_packet.wr_i64(w, ts)
        mc_packet.wr_i64(w, salt)
        put_f(out, f" ts={ts} salt={salt} sig=")
        let has: bool = mc_packet.rd_optional(r)
        mc_packet.wr_optional(w, has)
        if has {
            let p: u64 = mc_packet.rd_bytes(r, 256)
            mc_packet.wr_raw(w, p, 256)
            if mc_packet.rd_ok(r) { put_hex_bytes(out, p, 256) }
        } else {
            put_lit(out, 45 as u8)
        }
        let off: i32 = mc_packet.rd_varint(r)
        mc_packet.wr_varint(w, off)
        let ap: u64 = mc_packet.rd_bytes(r, 3)
        mc_packet.wr_raw(w, ap, 3)
        put_f(out, f" off={off} ack=")
        if mc_packet.rd_ok(r) { put_hex_bytes(out, ap, 3) }
    } else if tag == 11 as u8 {
        let v: u64 = mc_packet.rd_u64(r)
        mc_packet.wr_u64(w, v)
        // bitfield 22 / 22 / 20 signed, most significant first
        var x: i64 = (v >> 42) as i64
        var z: i64 = ((v >> 20) & 4194303 as u64) as i64
        var y: i64 = (v & 1048575 as u64) as i64
        if x >= 2097152 { x = x - 4194304 }
        if z >= 2097152 { z = z - 4194304 }
        if y >= 524288 { y = y - 1048576 }
        let n: usize = mc_packet.rd_array_count(r, 1, 65536)
        mc_packet.wr_array_count(w, n)
        put_f(out, f"multi_block_change id={id} cc={x},{y},{z} n={n} rec=")
        var i: usize = 0
        while i < n && mc_packet.rd_ok(r) {
            if i > 0 { put_lit(out, 44 as u8) }
            let rec: i32 = mc_packet.rd_varint(r)
            mc_packet.wr_varint(w, rec)
            put_f(out, f"{rec}")
            i = i + 1
        }
    } else if tag == 12 as u8 {
        let a: i32 = mc_packet.rd_varint(r)
        mc_packet.wr_varint(w, a)
        let n: usize = mc_packet.rd_array_count(r, 1, 4096)
        mc_packet.wr_array_count(w, n)
        put_f(out, f"chat_suggestions id={id} action={a} n={n} e=")
        var i: usize = 0
        while i < n && mc_packet.rd_ok(r) {
            if i > 0 { put_lit(out, 44 as u8) }
            field_string(r, w, out, 32767)
            i = i + 1
        }
    }
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 { return 2 }
    var f: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &f) { return 3 }
    let base: u64 = rt.buf_ptr(&f)
    let total: usize = rt.buf_len(&f)
    var out: rt.Buf = rt.buf_new()
    var w: mc_packet.Writer = mc_packet.writer_new()
    var pos: usize = 0
    var bad: i32 = 0
    while pos + 5 <= total {
        let tag: u8 = rt.ld8(base, pos)
        let len: usize = ((rt.ld8(base, pos + 1) as usize) << 24) | ((rt.ld8(base, pos + 2) as usize) << 16) | ((rt.ld8(base, pos + 3) as usize) << 8) | (rt.ld8(base, pos + 4) as usize)
        pos = pos + 5
        if pos + len > total {
            put_f(&out, f"TRUNCATED RECORD\n")
            bad = bad + 1
            break
        }
        var r: mc_packet.Reader = mc_packet.Reader { b: bytes.bytes_new(), err: 0 }
        mc_packet.reader_init(&r, base + pos as u64, len)
        mc_packet.writer_clear(&w)
        do_packet(tag, &r, &w, &out)
        if !mc_packet.rd_ok(&r) {
            put_f(&out, f" ERR={mc_packet.rd_err(&r)}")
            bad = bad + 1
        } else if mc_packet.rd_remaining(&r) != 0 {
            put_f(&out, f" TRAILING={mc_packet.rd_remaining(&r)}")
            bad = bad + 1
        } else if !mc_packet.wr_ok(&w) || mc_packet.wr_len(&w) != len || !rt.mem_eq(mc_packet.wr_ptr(&w), base + pos as u64, len) {
            put_f(&out, f" RT=FAIL")
            bad = bad + 1
        }
        put_f(&out, f"\n")
        pos = pos + len
    }
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    mc_packet.writer_free(&w)
    if bad != 0 { return 1 }
    return 0
}
