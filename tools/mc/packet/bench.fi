// tools/mc/packet/bench.fi -- speed of mc_packet (release-fast build).
// Prints `BENCH <name>: <packets/s> pkt/s, <MB/s> MB/s`.
import mc.mc_packet
import std.bytes
import std.rt
import std.io
import std.time

const ROUNDS: u64 = 300

fn report(name: u64, nlen: usize, pkts: u64, octets: u64, ns: u64) {
    var n: u64 = ns
    if n == 0 as u64 { n = 1 as u64 }
    let pps: u64 = pkts * 1000000000 / n
    let mbs: u64 = octets * 1000 / n // MB/s = octets / 1e6 / (ns / 1e9) = octets * 1000 / ns
    io.print_bytes(name, nlen)
    io.fmt_print_line(f": {pps} pkt/s, {mbs} MB/s")
}

// A "position" like packet: 3 f64, 2 f32, i8, varint (about 36 octets).
fn write_pos(w: *mut mc_packet.Writer, i: u64) {
    mc_packet.wr_varint(w, 60)
    mc_packet.wr_f64(w, 1.5)
    mc_packet.wr_f64(w, 64.0)
    mc_packet.wr_f64(w, -3.25)
    mc_packet.wr_f32(w, 90.0f)
    mc_packet.wr_f32(w, 0.5f)
    mc_packet.wr_i8(w, 3 as i8)
    mc_packet.wr_varint(w, (i & 1023 as u64) as i32)
}

fn read_pos(r: *mut mc_packet.Reader) -> f64 {
    mc_packet.rd_varint(r)
    let x: f64 = mc_packet.rd_f64(r)
    mc_packet.rd_f64(r)
    mc_packet.rd_f64(r)
    mc_packet.rd_f32(r)
    mc_packet.rd_f32(r)
    mc_packet.rd_i8(r)
    mc_packet.rd_varint(r)
    return x
}

fn main() -> i32 {
    var w: mc_packet.Writer = mc_packet.writer_new()
    defer mc_packet.writer_free(&w)
    var sink: f64 = 0.0

    // ---- position packets, 1000 per buffer
    var name1: [u8; 20] = "write position pkts\0"
    var name2: [u8; 20] = "read  position pkts\0"
    var t0: u64 = time.monotonic_ns()
    var total_o: u64 = 0
    var round: u64 = 0
    while round < ROUNDS {
        mc_packet.writer_clear(&w)
        var i: u64 = 0
        while i < 1000 as u64 {
            write_pos(&w, i)
            i = i + 1
        }
        total_o = total_o + mc_packet.wr_len(&w) as u64
        round = round + 1
    }
    var t1: u64 = time.monotonic_ns()
    report((&name1[0]) as u64, 19, ROUNDS * 1000 as u64, total_o, t1 - t0)
    var r: mc_packet.Reader = mc_packet.Reader { b: bytes.bytes_new(), err: 0 }
    round = 0
    t0 = time.monotonic_ns()
    while round < ROUNDS {
        mc_packet.reader_init(&r, mc_packet.wr_ptr(&w), mc_packet.wr_len(&w))
        var i: u64 = 0
        while i < 1000 as u64 {
            sink = sink + read_pos(&r)
            i = i + 1
        }
        round = round + 1
    }
    t1 = time.monotonic_ns()
    if !mc_packet.rd_ok(&r) { return 1 }
    report((&name2[0]) as u64, 19, ROUNDS * 1000 as u64, total_o, t1 - t0)

    // ---- strings (validation included): 40 char ASCII + a few multi byte
    var txt: [u8; 46] = "hello minecraft world, this is a chat line xx\0"
    txt[43] = 0xc3 as u8
    txt[44] = 0xa4 as u8
    let tl: usize = 45
    var name3: [u8; 20] = "write string 45 oct\0"
    var name4: [u8; 20] = "read  string 45 oct\0"
    mc_packet.writer_clear(&w)
    t0 = time.monotonic_ns()
    round = 0
    total_o = 0
    while round < ROUNDS {
        mc_packet.writer_clear(&w)
        var i: u64 = 0
        while i < 1000 as u64 {
            mc_packet.wr_string(&w, (&txt[0]) as u64, tl, 256)
            i = i + 1
        }
        total_o = total_o + mc_packet.wr_len(&w) as u64
        round = round + 1
    }
    t1 = time.monotonic_ns()
    if !mc_packet.wr_ok(&w) { return 2 }
    report((&name3[0]) as u64, 19, ROUNDS * 1000 as u64, total_o, t1 - t0)
    round = 0
    t0 = time.monotonic_ns()
    var cnt: u64 = 0
    while round < ROUNDS {
        mc_packet.reader_init(&r, mc_packet.wr_ptr(&w), mc_packet.wr_len(&w))
        var i: u64 = 0
        var n: usize = 0
        while i < 1000 as u64 {
            mc_packet.rd_string(&r, 256, &n)
            cnt = cnt + n as u64
            i = i + 1
        }
        round = round + 1
    }
    t1 = time.monotonic_ns()
    if !mc_packet.rd_ok(&r) { return 3 }
    report((&name4[0]) as u64, 19, ROUNDS * 1000 as u64, total_o, t1 - t0)
    if sink < 0.0 || cnt == 0 as u64 { return 4 }
    return 0
}
