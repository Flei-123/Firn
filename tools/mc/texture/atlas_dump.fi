import std.rt
import std.io
import mc.mc_version
import mc.mc_versions
import mc.mc_registry
import mc.mc_mesh
import mc.mc_texture
import mc.mc_texext
import mc.mc_assets
import mc.mc_vanilla

fn push_str(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.length())
}

fn push_num(b: *mut rt.Buf, v: i64) {
    rt.buf_push_dec_i64(b, v)
    rt.buf_push(b, 32 as u8)
}

fn push_name(b: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push_bytes(b, p, n)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 { return 2 }
    var jarbuf: rt.Buf = rt.buf_new()
    let vrc: i32 = mc_vanilla.vanilla_ensure(763, &jarbuf)
    if vrc != mc_vanilla.VANILLA_OK {
        io.fmt_print(f"vanilla failed {vrc}\n")
        return 5
    }
    let jar: str = rt.buf_str(&jarbuf)
    var v: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &v) { return 3 }
    var r: mc_registry.Registry = v.registry_of()
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_texture.tex_alloc_tables(&tb)
    var ex: mc_texext.TexExt = mc_texext.texext_new()
    mc_texext.tex_build_tables_ext(&r, &tb, &ex)
    var a: mc_texture.Atlas = mc_texext.texext_atlas_new(16, &ex)
    var stack: mc_assets.PackStack = mc_assets.stack_new()
    var pk: mc_assets.Pack = mc_assets.pack_empty()
    let orc: i32 = mc_assets.pack_open_file(&pk, jar)
    if orc != mc_assets.ASSET_OK {
        io.fmt_print(f"open failed {orc}\n")
        return 4
    }
    mc_assets.stack_push(&stack, &pk)
    var an: mc_assets.AnimSet = mc_assets.animset_new()
    let replaced: i32 = mc_assets.assets_apply_ext(&stack, &a, &ex, &an)
    rt.write_file(rt.arg_ptr(start, 1), a.px, (a.w as usize) * (a.h as usize) * 4)
    var m: rt.Buf = rt.buf_new()
    push_str(&m, "atlas ")
    push_num(&m, a.w as i64)
    push_num(&m, a.h as i64)
    push_num(&m, a.tile as i64)
    push_num(&m, a.cols as i64)
    push_num(&m, a.rows as i64)
    push_str(&m, "\n")
    var t: u32 = 1
    while t <= mc_texture.DEFAULT_TILES {
        let name: str = mc_assets.tile_file(t)
        if name.length() > 0 {
            push_str(&m, "tile ")
            push_num(&m, t as i64)
            push_str(&m, name)
            push_str(&m, "\n")
        }
        t = t + 1
    }
    var i: usize = 0
    while i < mc_texext.texext_count(&ex) {
        push_str(&m, "tile ")
        push_num(&m, mc_texext.texext_tile_id(i) as i64)
        var k: usize = 0
        var cp: u64 = 0
        var cl: usize = 0
        while mc_texext.texext_cand(&ex, i, k, &cp, &cl) {
            if k > 0 { push_str(&m, ",") }
            push_name(&m, cp, cl)
            k = k + 1
        }
        push_str(&m, "\n")
        i = i + 1
    }
    rt.write_file(rt.arg_ptr(start, 2), rt.buf_ptr(&m), rt.buf_len(&m))
    io.fmt_print(f"metric replaced={replaced} ext={mc_texext.texext_count(&ex)}\n")
    return 0
}
