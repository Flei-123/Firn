// tools/mc/texture/dump.fi -- writes the default atlas (RGBA8, 256x256) and the 1.20.1 tile table
// (u16 x 6 per state, little endian) for tools/mc/texture/check.py.   usage: dump <atlas.bin> <tiles.bin>
import std.rt
import std.io
import mc.mc_version
import mc.mc_versions
import mc.mc_registry
import mc.mc_mesh
import mc.mc_texture

fn now_ns() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000000 as u64 + (ts[1] as u64)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 { return 2 }
    let t0: u64 = now_ns()
    var a: mc_texture.Atlas = mc_texture.atlas_default()
    let t1: u64 = now_ns()
    var v: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &v) { return 3 }
    var r: mc_registry.Registry = v.registry_of()
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_texture.tex_alloc_tables(&tb)
    mc_texture.tex_build_tables(&r, &tb)
    let t2: u64 = now_ns()
    rt.write_file(rt.arg_ptr(start, 1), a.px, 256 * 256 * 4)
    // tiles then opaque, 24135 states
    var buf: rt.Buf = rt.buf_new()
    var s: usize = 0
    while s < 24135 * 6 {
        let x: u16 = rt.ld16(tb.tiles, s)
        rt.buf_push(&buf, (x & 255 as u16) as u8)
        rt.buf_push(&buf, (x >> 8 as u16) as u8)
        s = s + 1
    }
    s = 0
    while s < 24135 {
        rt.buf_push(&buf, rt.ld8(tb.opaque, s))
        s = s + 1
    }
    rt.write_file(rt.arg_ptr(start, 2), rt.buf_ptr(&buf), rt.buf_len(&buf))
    io.fmt_print(f"metric atlas_build_us={(t1 - t0) / 1000 as u64} tables_build_us={(t2 - t1) / 1000 as u64}\n")
    return 0
}
