// tools/mc/registry/dump.fi -- prints every registry of one generated version as text
// (blocks, ALL block states with their properties, items, entities, biomes). The same
// text is produced independently by ref.cjs from minecraft-data + prismarine-block.
//
//     dump <protocol>

import std.rt
import std.io
import mc.mc_registry
import mc.mc_version
import mc.mc_versions

fn put_f(out: *mut rt.Buf, f: io.Fmt) {
    var g: io.Fmt = f
    rt.buf_push_bytes(out, rt.buf_ptr(&g.b), rt.buf_len(&g.b))
    io.fmt_free(g)
}

fn put_name(out: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push_bytes(out, p, n)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 2
    }
    let pa: u64 = rt.arg_ptr(start, 1)
    var proto: i32 = 0
    var i: usize = 0
    while i < rt.c_length(pa) {
        proto = proto * 10 + (rt.ld8(pa, i) - 48 as u8) as i32
        i = i + 1
    }
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(proto, &ver) {
        return 3
    }
    var r: mc_registry.Registry = ver.registry_of()
    if !mc_registry.registry_ok(&r) {
        return 4
    }
    var out: rt.Buf = rt.buf_new()
    put_f(&out, f"version {proto}\n")
    var n: usize = 0
    var b: i32 = 0
    while b < mc_registry.reg_block_count(&r) {
        put_f(&out, f"B {b} ")
        put_name(&out, mc_registry.reg_block_name(&r, b, &n), n)
        put_f(&out, f" {mc_registry.reg_block_min_state(&r, b)} {mc_registry.reg_block_max_state(&r, b)} {mc_registry.reg_block_default_state(&r, b)}")
        put_f(&out, f" flags={mc_registry.reg_block_flags(&r, b)} hard={mc_registry.reg_block_hardness_milli(&r, b)} stack={mc_registry.reg_block_stack_size(&r, b)} props={mc_registry.reg_prop_count(&r, b)}\n")
        b = b + 1
    }
    var s: i32 = 0
    while s < mc_registry.reg_state_count(&r) {
        put_f(&out, f"S {s} ")
        if !mc_registry.reg_state_text(&r, s, &out) {
            put_f(&out, f"-")
        }
        put_f(&out, f"\n")
        s = s + 1
    }
    var it: i32 = 0
    while it < mc_registry.reg_item_count(&r) {
        let p: u64 = mc_registry.reg_item_name(&r, it, &n)
        if n > 0 {
            put_f(&out, f"I {it} ")
            put_name(&out, p, n)
            put_f(&out, f" {mc_registry.reg_item_stack(&r, it)}\n")
        }
        it = it + 1
    }
    var e: i32 = 0
    while e < mc_registry.reg_entity_count(&r) {
        let p: u64 = mc_registry.reg_entity_name(&r, e, &n)
        if n > 0 {
            put_f(&out, f"E {mc_registry.reg_entity_id(&r, e)} ")
            put_name(&out, p, n)
            put_f(&out, f" {mc_registry.reg_entity_width_milli(&r, e)} {mc_registry.reg_entity_height_milli(&r, e)} ")
            let kp: u64 = mc_registry.reg_entity_kind(&r, e, &n)
            put_name(&out, kp, n)
            put_f(&out, f"\n")
        }
        e = e + 1
    }
    var m: i32 = 0
    while m < mc_registry.reg_biome_count(&r) {
        let p: u64 = mc_registry.reg_biome_name(&r, m, &n)
        if n > 0 {
            put_f(&out, f"M {mc_registry.reg_biome_id(&r, m)} ")
            put_name(&out, p, n)
            put_f(&out, f" ")
            let cp: u64 = mc_registry.reg_biome_category(&r, m, &n)
            put_name(&out, cp, n)
            put_f(&out, f" {mc_registry.reg_biome_color(&r, m)}\n")
        }
        m = m + 1
    }
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    rt.buf_free(&out)
    return 0
}
