// tools/mc/audio/dump.fi -- random inputs AND the results of the pure spatial math of lib/mc/mc_audio.fi
// (mca_atten, mca_mc_gain, mca_pan, mca_pan_lr) as text; tools/mc/audio/check.py recomputes everything
// independently with numpy float32. Floats are printed as the 8 hex digits of their IEEE bits (exact).
//
//   usage: dump <seed> <cases>

import std.rt
import std.math
import std.io
import mc.mc_audio

struct Gen { x: u64 }

fn next(g: *mut Gen) -> u64 {
    (*g).x = (*g).x *% 6364136223846793005 as u64 +% 1442695040888963407 as u64
    var z: u64 = (*g).x
    z = (z ^ (z >> 29)) *% 0xBF58476D1CE4E5B9 as u64
    z = (z ^ (z >> 32))
    return z
}

fn rf(g: *mut Gen, lo: f32, hi: f32) -> f32 {
    let u: f32 = ((next(g) >> 40) as f32) / 16777216.0
    return lo + (hi - lo) * u
}

fn ri(g: *mut Gen, n: u64) -> u64 { return next(g) % n }

fn pf(o: *mut rt.Buf, x: f32) {
    rt.buf_push_hex_u64(o, math.math_bits32(x) as u64, 8)
    rt.buf_push(o, 32 as u8)
}

fn pb(o: *mut rt.Buf, v: bool) {
    if v { rt.buf_push(o, 49 as u8) } else { rt.buf_push(o, 48 as u8) }
    rt.buf_push(o, 32 as u8)
}

fn tag(o: *mut rt.Buf, c: u8) {
    rt.buf_push(o, c)
    rt.buf_push(o, 32 as u8)
}

fn nl(o: *mut rt.Buf) { rt.buf_push(o, 10 as u8) }

fn vlen(x: f32, y: f32, z: f32) -> f32 {
    return math.sqrt32(x * x + y * y + z * z)
}

// attenuation: random distance / min / max / rolloff, linear and inverse
fn atten_case(g: *mut Gen, o: *mut rt.Buf) {
    var mn: f32 = rf(g, 0.5, 4.0)
    var mx: f32 = rf(g, 4.0, 128.0)
    if ri(g, 8) == 0 { mx = mn }             // degenerate span
    if ri(g, 8) == 0 {
        mx = 16.0
        mn = 1.0
    } // the Minecraft model
    let d: f32 = rf(g, 0.0, 200.0)
    let lin: bool = ri(g, 2) == 0
    let ro: f32 = rf(g, 0.1, 4.0)
    tag(o, 65 as u8)
    pf(o, d)
    pf(o, mn)
    pf(o, mx)
    pb(o, lin)
    pf(o, ro)
    pf(o, mc_audio.mca_atten(d, mn, mx, lin, ro))
    nl(o)
}

// Minecraft gain: volume (also > 1) at a distance, range 16 * max(1, volume) or fixed
fn gain_case(g: *mut Gen, o: *mut rt.Buf) {
    let v: f32 = rf(g, 0.0, 2.0)
    let d: f32 = rf(g, 0.0, 80.0)
    var r: f32 = 16.0
    if ri(g, 3) == 0 { r = rf(g, 2.0, 64.0) }
    tag(o, 71 as u8)
    pf(o, v)
    pf(o, d)
    pf(o, r)
    pf(o, mc_audio.mca_mc_gain(v, d, r))
    nl(o)
}

// pan: listener axes random (not always normalized, sometimes degenerate), source anywhere
fn pan_case(g: *mut Gen, o: *mut rt.Buf) {
    var rx: f32 = rf(g, -100.0, 100.0)
    var ry: f32 = rf(g, -50.0, 50.0)
    var rz: f32 = rf(g, -100.0, 100.0)
    var fx: f32 = rf(g, -1.0, 1.0)
    var fy: f32 = rf(g, -1.0, 1.0)
    var fz: f32 = rf(g, -1.0, 1.0)
    var ux: f32 = rf(g, -1.0, 1.0)
    var uy: f32 = rf(g, 0.2, 1.0)
    var uz: f32 = rf(g, -1.0, 1.0)
    let k: u64 = ri(g, 10)
    if k == 0 {
        rx = 0.0
        ry = 0.0
        rz = 0.0
    } // on top of the listener
    if k == 1 {
        ux = 0.0
        uy = 0.0
        uz = 0.0
    } // no up vector
    if k == 2 {
        ux = fx
        uy = fy
        uz = fz
    } // up parallel to forward
    if k == 3 {
        fx = 0.0
        fy = 0.0
        fz = 1.0
        ux = 0.0
        uy = 1.0
        uz = 0.0
    }
    tag(o, 80 as u8)
    pf(o, rx)
    pf(o, ry)
    pf(o, rz)
    pf(o, fx)
    pf(o, fy)
    pf(o, fz)
    pf(o, ux)
    pf(o, uy)
    pf(o, uz)
    let pan: f32 = mc_audio.mca_pan(rx, ry, rz, fx, fy, fz, ux, uy, uz)
    var l: f32 = 0.0
    var r: f32 = 0.0
    mc_audio.mca_pan_lr(pan, &l, &r)
    pf(o, pan)
    pf(o, l)
    pf(o, r)
    nl(o)
}

fn arg_u64(start: u64, i: usize) -> u64 {
    let p: u64 = rt.arg_ptr(start, i)
    var v: u64 = 0
    var k: usize = 0
    while rt.ld8(p, k) != 0 as u8 {
        v = v * 10 as u64 + ((rt.ld8(p, k) - 48 as u8) as u64)
        k = k + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    var seed: u64 = 1
    var n: u64 = 200
    if rt.arg_count(start) > 1 { seed = arg_u64(start, 1) }
    if rt.arg_count(start) > 2 { n = arg_u64(start, 2) }
    var g: Gen = Gen { x: seed *% 0x9E3779B97F4A7C15 as u64 }
    var o: rt.Buf = rt.buf_new()
    var k: u64 = 0
    while k < n {
        atten_case(&g, &o)
        gain_case(&g, &o)
        pan_case(&g, &o)
        k = k + 1
    }
    io.print_bytes(rt.buf_ptr(&o), rt.buf_len(&o))
    rt.buf_free(&o)
    return 0
}
