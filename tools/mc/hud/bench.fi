// tools/mc/hud/bench.fi -- time of the whole overlay (crosshair + hotbar + 5 debug lines) at 640x360 and 1280x720.
import std.rt
import std.io
import mc.mc_raster
import mc.mc_hud

fn now_ns() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000000 as u64 + (ts[1] as u64)
}

fn bench(w: i32, h: i32) {
    var r: mc_raster.Raster = mc_raster.raster_new(w, h)
    var d: mc_hud.HudDebug = mc_hud.hud_debug_new()
    d.fps = 60
    d.x = 12.35
    d.y = 64.0
    d.z = -3.5
    d.has_block = true
    d.ny = 1
    let sc: i32 = mc_hud.hud_scale(w, h)
    mc_hud.hud_frame(&r, sc, 7 as u32, 3, &d)
    let t0: u64 = now_ns()
    var i: i32 = 0
    while i < 20 {
        mc_hud.hud_frame(&r, sc, 7 as u32, 3, &d)
        i = i + 1
    }
    io.fmt_print(f"metric hud_frame_{w}x{h} us_per_frame={(now_ns() - t0) / 20000 as u64}\n")
    mc_raster.raster_free(&r)
}

fn main() -> i32 {
    bench(640, 360)
    bench(1280, 720)
    return 0
}
