// tools/mc/shapes/dump.fi -- prints the collision boxes mc_shapes assigns to every block state of 1.20.1 (protocol 763), for check.py.
// Line per state with a shape: "S <state> <code> <nboxes> x0 y0 z0 x1 y1 z1 ..." in 1/16 units (all shape coordinates are multiples of 1/16);
// code 65535 = passable, code 1 = full cube. Usage: dump   (stdout)
import std.rt
import mc.mc_math
import mc.mc_registry
import mc.mc_version
import mc.mc_versions
import mc.mc_shapes

fn push_dec(b: *mut rt.Buf, v: u64) {
    rt.buf_push(b, 32 as u8)
    rt.buf_push_dec_u64(b, v)
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &v) { return 2 }
    var r: mc_registry.Registry = v.registry_of()
    var o: rt.Buf = rt.buf_new()
    var sb: mc_math.Aabb = mc_math.Aabb { x0: 0.0, y0: 0.0, z0: 0.0, x1: 1.0, y1: 1.0, z1: 1.0 }
    let n: i32 = mc_registry.reg_state_count(&r)
    var s: i32 = 0
    while s < n {
        let c: i32 = mc_shapes.shape_code_for_state(&r, s)
        if c != 0 {
            rt.buf_push(&o, 83 as u8)
            push_dec(&o, s as u64)
            push_dec(&o, c as u64)
            var nb: i32 = 0
            if c != mc_shapes.PASSABLE { nb = mc_math.shape_count(c) }
            push_dec(&o, nb as u64)
            var i: i32 = 0
            while i < nb {
                mc_math.shape_box(c, i, &sb)
                push_dec(&o, (sb.x0 * 16.0 + 0.5) as u64)
                push_dec(&o, (sb.y0 * 16.0 + 0.5) as u64)
                push_dec(&o, (sb.z0 * 16.0 + 0.5) as u64)
                push_dec(&o, (sb.x1 * 16.0 + 0.5) as u64)
                push_dec(&o, (sb.y1 * 16.0 + 0.5) as u64)
                push_dec(&o, (sb.z1 * 16.0 + 0.5) as u64)
                i = i + 1
            }
            rt.buf_push(&o, 10 as u8)
        }
        s = s + 1
    }
    rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
    rt.buf_free(&o)
    return 0
}
