// tools/mc/flat/dump.fi -- prints the flattening table of lib/mc/v340/mc_flat_v340.fi: the 4096 modern
// state ids of the legacy states `id << 4 | meta`, one per line (compared with ref_flat.cjs by run.sh).
import std.io
import mc.mc_flat
import mc.v340.mc_flat_v340

fn main() -> i32 {
    var f: mc_flat.Flat = mc_flat_v340.flat_make()
    if !mc_flat.flat_ok(&f) {
        return 2
    }
    var i: u32 = 0 as u32
    while (i as usize) < mc_flat.FLAT_STATES {
        let v: u16 = mc_flat.flat_get(&f, i)
        io.fmt_print(f"{v}\n")
        i = i + 1 as u32
    }
    mc_flat.flat_free(&f)
    return 0
}
