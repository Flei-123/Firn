import std.rt
import std.io
import mc.gen.wgdf_graph
import mc.gen.wgft_jdef
import mc.gen.wgft_jset

const CASES: i32 = 400

struct Rng {
    s: u64,
}

fn rn(g: *mut Rng) -> u64 {
    (*g).s = (*g).s +% 0x9e3779b97f4a7c15
    var z: u64 = (*g).s
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    return z ^ (z >> 31)
}

fn ri(g: *mut Rng, lo: i32, span: i32) -> i32 {
    return lo + ((rn(g) % (span as u64)) as i32)
}

fn main(start: u64) -> i32 {
    let set: *mut wgft_jdef.JSet = rt.heap_alloc(wgdf_graph.wg_size_of[wgft_jdef.JSet]()) as *mut wgft_jdef.JSet
    var xs: [i32; 3072] = [0; 3072]
    var ys: [i32; 3072] = [0; 3072]
    var zs: [i32; 3072] = [0; 3072]
    var c: i32 = 0
    while c < CASES {
        var g: Rng = Rng { s: 0x5eed0000 + (c as u64) }
        let shape: i32 = c % 6
        var count: i32 = 0
        if c % 7 < 5 { count = 8 + ri(&g, 0, 600) } else { count = 8 + ri(&g, 0, 2400) }
        let radius: i32 = 3 + ri(&g, 0, 6)
        let y0: i32 = ri(&g, -40, 80)
        wgft_jset.js_clear(set)
        var i: i32 = 0
        while i < count {
            var x: i32 = 0
            var y: i32 = 0
            var z: i32 = 0
            if shape == 0 {
                x = ri(&g, 0 - radius - 1, 2 * radius + 3)
                z = ri(&g, 0 - radius - 1, 2 * radius + 3)
                y = y0 + ri(&g, 0, 3)
            } else if shape == 1 {
                x = ri(&g, -6, 13)
                z = ri(&g, -6, 13)
                y = y0 + ri(&g, 0, 21)
            } else if shape == 2 {
                x = ri(&g, -30, 61)
                z = ri(&g, -30, 61)
                y = y0 + ri(&g, 0, 3)
            } else if shape == 3 {
                x = ri(&g, -300, 601)
                y = ri(&g, -300, 601)
                z = ri(&g, -300, 601)
            } else if shape == 4 {
                x = ri(&g, -2, 5)
                z = ri(&g, -2, 5)
                y = ri(&g, -64, 129)
            } else {
                x = 64 * ri(&g, -400, 800)
                if ri(&g, 0, 4) == 0 { x = x + ri(&g, 0, 64) }
            }
            wgft_jset.js_add(set, x, y, z)
            i = i + 1
        }
        let n: usize = wgft_jset.js_collect(set, &xs, &ys, &zs)
        io.fmt_print(f"C {c} {n}\n")
        var k: usize = 0
        while k < n {
            io.fmt_print(f"{xs[k]} {ys[k]} {zs[k]}\n")
            k = k + 1
        }
        c = c + 1
    }
    return 0
}
