import std.rt
import std.io
import std.str
import std.mem
import mc.gen.wgdf_graph
import mc.gen.wgdf_load
import mc.gen.wgdf_eval
import mc.gen.wgdf_fill

fn arg_of(start: u64, i: usize) -> str {
    let sp: str.Span = str.span_of_c(rt.arg_ptr(start, i) as *mut u8)
    return str { p: sp.p, n: sp.n }
}

fn parse_i64(s: str) -> i64 {
    var neg: bool = false
    var i: usize = 0
    var v: i64 = 0
    if s.n > 0 && *(s.p) == 45 {
        neg = true
        i = 1
    }
    while i < s.n {
        v = v * 10 + ((*(((s.p as u64) + (i as u64)) as *u8)) as i64 - 48)
        i = i + 1
    }
    if neg { return 0 - v }
    return v
}

fn main(start: u64) -> i32 {
    let root: str = arg_of(start, 1)
    let dim: str = arg_of(start, 2)
    let seed: i64 = parse_i64(arg_of(start, 3))
    let cx: i32 = parse_i64(arg_of(start, 4)) as i32
    let cz: i32 = parse_i64(arg_of(start, 5)) as i32
    var g: wgdf_graph.WgGraph = wgdf_graph.graph_new()
    if !wgdf_load.load_settings(&g, root, dim) {
        io.fmt_print(f"LOAD FAILED\n")
        return 1
    }
    let ns: *mut wgdf_eval.WgNoises = wgdf_eval.noises_alloc()
    wgdf_eval.noises_build(&g, ns, seed)
    let node: i32 = wgdf_graph.router_find(&g, "final_density")
    let cells: usize = (g.height as usize) * 256
    let out: *mut u8 = mem.alloc(cells) as *mut u8
    wgdf_fill.fill_chunk(&g, ns, node, cx, cz, rt.arg_count(start) < 7, out)
    var yi: i32 = g.height - 1
    while yi >= 0 {
        let row: str = str { p: ((out as u64) + (((yi * 256) as usize) as u64)) as *mut u8, n: 256 }
        let y: i32 = g.min_y + yi
        io.fmt_print(f"{seed} {cx} {cz} {y} {row}\n")
        yi = yi - 1
    }
    return 0
}
