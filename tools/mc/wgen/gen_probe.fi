import std.rt
import std.io
import std.str
import mc.mc_version
import mc.mc_versions
import mc.server.sv_world
import mc.server.sv_gen
import mc.mc_registry
import mc.gen.wgdf_gen

fn __thread_work(kind: u64, arg: u64) -> u64 {
    return wgdf_gen.gen_thread_work(kind, arg)
}

fn arg_of(start: u64, i: usize) -> str {
    let sp: str.Span = str.span_of_c(rt.arg_ptr(start, i) as *mut u8)
    return str { p: sp.p, n: sp.n }
}

fn parse_i64(s: str) -> i64 {
    var neg: bool = false
    var i: usize = 0
    var v: i64 = 0
    if s.n > 0 && *(s.p) == 45 {
        neg = true
        i = 1
    }
    while i < s.n {
        v = v * 10 + ((*(((s.p as u64) + (i as u64)) as *u8)) as i64 - 48)
        i = i + 1
    }
    if neg { return 0 - v }
    return v
}

fn main(start: u64) -> i32 {
    let root: str = arg_of(start, 1)
    let dim: str = arg_of(start, 2)
    let seed: i64 = parse_i64(arg_of(start, 3))
    let cx: i32 = parse_i64(arg_of(start, 4)) as i32
    let cz: i32 = parse_i64(arg_of(start, 5)) as i32
    let reps: i64 = parse_i64(arg_of(start, 6))
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &ver) { return 2 }
    var src: sv_world.WorldSource = sv_gen.gen_source_new(&ver, 0, root, dim, seed)
    if src.ctx == 0 as u64 {
        io.fmt_print(f"SOURCE FAILED\n")
        return 1
    }
    var col: sv_world.Column = sv_world.column_new(sv_world.world_sections(&src))
    var r: i64 = 0
    while r < reps {
        sv_world.world_fill(&src, cx + (r as i32), cz, &col)
        r = r + 1
    }
    sv_world.world_fill(&src, cx, cz, &col)
    var reg: mc_registry.Registry = ver.registry_of()
    var codes: [u8; 10] = [83, 65, 87, 76, 67, 99, 71, 73, 105, 84]
    var names: [str; 10] = ["stone", "air", "water", "lava", "copper_ore", "raw_copper_block", "granite", "deepslate_iron_ore", "raw_iron_block", "tuff"]
    var states: [u16; 10] = [0 as u16; 10]
    var k: usize = 0
    while k < 10 {
        let b: i32 = mc_registry.reg_block_by_name(&reg, names[k].p as u64, names[k].n)
        states[k] = mc_registry.reg_block_default_state(&reg, b) as u16
        k = k + 1
    }
    var yi: i32 = src.height - 1
    while yi >= 0 {
        var row: [u8; 256] = [63; 256]
        var i: usize = 0
        while i < 256 {
            let st: u16 = rt.ld16(col.blocks, (yi as usize) * 256 + i)
            var j: usize = 0
            while j < 10 {
                if states[j] == st { row[i] = codes[j] }
                j = j + 1
            }
            i = i + 1
        }
        let y: i32 = src.min_y + yi
        let rs: str = str { p: &row[0], n: 256 }
        io.fmt_print(f"{seed} {cx} {cz} {y} {rs}\n")
        yi = yi - 1
    }
    sv_world.world_free(&src)
    rt.finish(0 as i64)
    return 0
}
