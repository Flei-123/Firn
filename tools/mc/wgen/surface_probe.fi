import std.rt
import std.io
import std.str
import mc.gen.wgdf_gen

fn __thread_work(kind: u64, arg: u64) -> u64 {
    return wgdf_gen.gen_thread_work(kind, arg)
}

fn arg_of(start: u64, i: usize) -> str {
    let sp: str.Span = str.span_of_c(rt.arg_ptr(start, i) as *mut u8)
    return str { p: sp.p, n: sp.n }
}

fn parse_i64(s: str) -> i64 {
    var neg: bool = false
    var i: usize = 0
    var v: i64 = 0
    if s.n > 0 && *(s.p) == 45 {
        neg = true
        i = 1
    }
    while i < s.n {
        v = v * 10 + ((*(((s.p as u64) + (i as u64)) as *u8)) as i64 - 48)
        i = i + 1
    }
    if neg { return 0 - v }
    return v
}

fn name_of(gen: *mut wgdf_gen.WgGen, code: u8) -> str {
    if code == 83 { return wgdf_gen.gen_default_block(gen) }
    if code == 65 { return "air" }
    if code == 87 { return "water" }
    if code == 76 { return "lava" }
    if code == 67 { return "copper_ore" }
    if code == 99 { return "raw_copper_block" }
    if code == 71 { return "granite" }
    if code == 73 { return "deepslate_iron_ore" }
    if code == 105 { return "raw_iron_block" }
    if code == 84 { return "tuff" }
    let nm: str = wgdf_gen.gen_code_name(gen, code)
    if nm.n > 5 && rt.mem_eq(nm.p as u64, "vine[".p as u64, 5) { return "vine" }
    if nm.n > 6 && rt.mem_eq(nm.p as u64, "cocoa[".p as u64, 6) { return "cocoa" }
    return nm
}

fn main(start: u64) -> i32 {
    let root: str = arg_of(start, 1)
    let dim: str = arg_of(start, 2)
    let seed: i64 = parse_i64(arg_of(start, 3))
    let cx: i32 = parse_i64(arg_of(start, 4)) as i32
    let cz: i32 = parse_i64(arg_of(start, 5)) as i32
    let reps: i64 = parse_i64(arg_of(start, 6))
    let carvers: bool = parse_i64(arg_of(start, 7)) != 0
    let features: bool = parse_i64(arg_of(start, 8)) != 0
    let gen: *mut wgdf_gen.WgGen = wgdf_gen.gen_open(root, dim, seed, true, carvers, features)
    if gen == (0 as *mut wgdf_gen.WgGen) {
        io.fmt_print(f"OPEN FAILED\n")
        return 1
    }
    let height: i32 = wgdf_gen.gen_height(gen)
    let bytes: usize = (height as usize) * 256
    let out: u64 = rt.heap_alloc(bytes)
    let bio: u64 = rt.heap_alloc(((height / 16) as usize) * 64 + 8)
    var r: i64 = 0
    while r < reps {
        wgdf_gen.gen_chunk(gen, cx + 8 + (r as i32), cz, out as *mut u8, bio as *mut u8)
        r = r + 1
    }
    wgdf_gen.gen_chunk(gen, cx, cz, out as *mut u8, bio as *mut u8)
    var vine_rep: i32 = 0 - 1
    var cocoa_rep: i32 = 0 - 1
    var lx: i32 = 0
    while lx < 16 {
        var lz: i32 = 0
        while lz < 16 {
            io.fmt_print(f"{seed} {cx} {cz} R {lx} {lz}")
            var last: u8 = 0
            var run: i32 = 0
            var y: i32 = height - 1
            while y >= 0 {
                var code: u8 = rt.ld8(out, (y as usize) * 256 + (lz as usize) * 16 + (lx as usize))
                if code != 65 {
                    let cn: str = name_of(gen, code)
                    if cn == "bee_nest" { code = 65 }
                    if cn == "vine" {
                        if vine_rep < 0 { vine_rep = code as i32 }
                        code = vine_rep as u8
                    }
                    if cn == "cocoa" {
                        if cocoa_rep < 0 { cocoa_rep = code as i32 }
                        code = cocoa_rep as u8
                    }
                }
                if run > 0 && code == last {
                    run = run + 1
                } else {
                    if run > 0 {
                        let nm: str = name_of(gen, last)
                        io.fmt_print(f" {nm}*{run}")
                    }
                    last = code
                    run = 1
                }
                y = y - 1
            }
            let nm2: str = name_of(gen, last)
            io.fmt_print(f" {nm2}*{run}\n")
            lz = lz + 1
        }
        lx = lx + 1
    }
    wgdf_gen.gen_close(gen)
    rt.finish(0 as i64)
    return 0
}
