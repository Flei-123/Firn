import std.rt
import std.io
import std.math
import std.str
import mc.gen.wgdf_graph
import mc.gen.wgdf_load
import mc.gen.wgdf_eval

struct Gen {
    s: u64,
}

fn gn(g: *mut Gen) -> u64 {
    (*g).s = (*g).s +% 0x9e3779b97f4a7c15
    var z: u64 = (*g).s
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    return z ^ (z >> 31)
}

fn gi(g: *mut Gen, lo: i32, span: i32) -> i32 {
    return lo + ((gn(g) % (span as u64)) as i32)
}

fn emit(seed: i64, x: i32, y: i32, z: i32, field: str, v: f64) {
    let b: u64 = math.math_bits(v)
    io.fmt_print(f"{seed} {x} {y} {z} {field} {b:x}\n")
}

fn field(g: *wgdf_graph.WgGraph, ns: *wgdf_eval.WgNoises, seed: i64, x: i32, y: i32, z: i32, name: str) {
    let node: i32 = wgdf_graph.router_find(g, name)
    if node >= 0 {
        emit(seed, x, y, z, name, wgdf_eval.eval(g, ns, node, x, y, z))
    }
}

fn arg_of(start: u64, i: usize) -> str {
    let sp: str.Span = str.span_of_c(rt.arg_ptr(start, i) as *mut u8)
    return str { p: sp.p, n: sp.n }
}

fn main(start: u64) -> i32 {
    let root: str = arg_of(start, 1)
    let dim: str = arg_of(start, 2)
    var g: wgdf_graph.WgGraph = wgdf_graph.graph_new()
    if !wgdf_load.load_settings(&g, root, dim) {
        io.fmt_print(f"LOAD FAILED\n")
        return 1
    }
    let ns: *mut wgdf_eval.WgNoises = wgdf_eval.noises_alloc()
    var gen: Gen = Gen { s: 0x1234abcd }
    var si: i32 = 0
    while si < 4 {
        let seed: i64 = (gn(&gen)) as i64
        wgdf_eval.noises_build(&g, ns, seed)
        var k: i32 = 0
        while k < 24 {
            let x: i32 = gi(&gen, -3000, 6000)
            let y: i32 = gi(&gen, -64, 384)
            let z: i32 = gi(&gen, -3000, 6000)
            field(&g, ns, seed, x, y, z, "temperature")
            field(&g, ns, seed, x, y, z, "vegetation")
            field(&g, ns, seed, x, y, z, "continents")
            field(&g, ns, seed, x, y, z, "erosion")
            field(&g, ns, seed, x, y, z, "depth")
            field(&g, ns, seed, x, y, z, "ridges")
            field(&g, ns, seed, x, y, z, "final_density")
            k = k + 1
        }
        si = si + 1
    }
    return 0
}
