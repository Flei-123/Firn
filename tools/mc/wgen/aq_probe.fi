import std.rt
import std.io
import std.str
import mc.gen.wgdf_gen
import mc.gen.wgdf_aquifer
import mc.gen.wgdf_graph
import mc.gen.wgdf_eval

fn __thread_work(kind: u64, arg: u64) -> u64 {
    return wgdf_gen.gen_thread_work(kind, arg)
}

fn arg_of(start: u64, i: usize) -> str {
    let sp: str.Span = str.span_of_c(rt.arg_ptr(start, i) as *mut u8)
    return str { p: sp.p, n: sp.n }
}

fn parse_i64(s: str) -> i64 {
    var neg: bool = false
    var i: usize = 0
    var v: i64 = 0
    if s.n > 0 && *(s.p) == 45 {
        neg = true
        i = 1
    }
    while i < s.n {
        v = v * 10 + ((*(((s.p as u64) + (i as u64)) as *u8)) as i64 - 48)
        i = i + 1
    }
    if neg { return 0 - v }
    return v
}

fn main(start: u64) -> i32 {
    let root: str = arg_of(start, 1)
    let seed: i64 = parse_i64(arg_of(start, 2))
    let cx: i32 = parse_i64(arg_of(start, 3)) as i32
    let cz: i32 = parse_i64(arg_of(start, 4)) as i32
    let gen: *mut wgdf_gen.WgGen = wgdf_gen.gen_open(root, "overworld", seed, true, true, false)
    let ns: *wgdf_eval.WgNoises = (*gen).ns[0] as *wgdf_eval.WgNoises
    let aq: *mut wgdf_aquifer.Aquifer = wgdf_aquifer.aquifer_new((*gen).g, ns, cx * 16, cz * 16)
    let x0: i32 = parse_i64(arg_of(start, 5)) as i32
    let x1: i32 = parse_i64(arg_of(start, 6)) as i32
    let y0: i32 = parse_i64(arg_of(start, 7)) as i32
    let y1: i32 = parse_i64(arg_of(start, 8)) as i32
    let z0: i32 = parse_i64(arg_of(start, 9)) as i32
    let z1: i32 = parse_i64(arg_of(start, 10)) as i32
    var x: i32 = x0
    while x <= x1 {
        var y: i32 = y0
        while y <= y1 {
            var z: i32 = z0
            while z <= z1 {
                let st: u8 = wgdf_aquifer.aquifer_substance((*gen).g, ns, aq, x, y, z, 0.0)
                io.fmt_print(f"AQ {x} {y} {z} {st}\n")
                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }
    var pi: i32 = 0
    while pi < 3 {
        var px: i32 = -1581
        var py: i32 = -40
        var pz: i32 = -1599
        if pi == 1 { py = -55 }
        if pi == 2 {
            py = -10
            pz = -1595
        }
        let e: f64 = wgdf_eval.eval_direct((*gen).g, ns, (*aq).n_erosion, px, py, pz)
        let d: f64 = wgdf_eval.eval_direct((*gen).g, ns, (*aq).n_depth, px, py, pz)
        let f: f64 = wgdf_eval.eval_direct((*gen).g, ns, (*aq).n_flood, px, py, pz)
        let eq: f64 = wgdf_eval.eval_direct((*gen).g, ns, (*aq).n_erosion, (px >> 2) << 2, py, (pz >> 2) << 2)
        io.fmt_print(f"EQ {eq}\n")
        io.fmt_print(f"NZ {px} {py} {pz} erosion {e} depth {d} flood {f}\n")
        pi = pi + 1
    }
    var k: usize = 0
    while k < 512 {
        if (*aq).st_set[k] != 0 {
            io.fmt_print(f"ST {(*aq).loc_x[k]} {(*aq).loc_y[k]} {(*aq).loc_z[k]} {(*aq).st_level[k]} {(*aq).st_ty[k]}\n")
        }
        k = k + 1
    }
    rt.finish(0 as i64)
    return 0
}
