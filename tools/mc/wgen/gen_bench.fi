import std.rt
import std.io
import std.str
import std.time
import mc.gen.wgdf_gen

fn __thread_work(kind: u64, arg: u64) -> u64 {
    return wgdf_gen.gen_thread_work(kind, arg)
}

fn arg_of(start: u64, i: usize) -> str {
    let sp: str.Span = str.span_of_c(rt.arg_ptr(start, i) as *mut u8)
    return str { p: sp.p, n: sp.n }
}

fn parse_i64(s: str) -> i64 {
    var i: usize = 0
    var v: i64 = 0
    while i < s.n {
        v = v * 10 + ((*(((s.p as u64) + (i as u64)) as *u8)) as i64 - 48)
        i = i + 1
    }
    return v
}

fn abs_i32(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

fn max_i32(a: i32, b: i32) -> i32 {
    if a > b { return a }
    return b
}

fn main(start: u64) -> i32 {
    let root: str = arg_of(start, 1)
    let dim: str = arg_of(start, 2)
    let seed: i64 = parse_i64(arg_of(start, 3))
    let side: i32 = parse_i64(arg_of(start, 4)) as i32
    let order: i64 = parse_i64(arg_of(start, 5))
    let features: bool = parse_i64(arg_of(start, 6)) != 0
    let gen: *mut wgdf_gen.WgGen = wgdf_gen.gen_open(root, dim, seed, true, true, features)
    if gen == (0 as *mut wgdf_gen.WgGen) {
        io.fmt_print(f"OPEN FAILED\n")
        return 1
    }
    let height: i32 = wgdf_gen.gen_height(gen)
    let out: u64 = rt.heap_alloc((height as usize) * 256)
    let bio: u64 = rt.heap_alloc(((height / 16) as usize) * 64 + 8)
    let half: i32 = side / 2
    let t0: u64 = time.monotonic_ns()
    var ring: i32 = 0
    var count: i32 = 0
    if order == 1 {
        while ring <= half {
            var z: i32 = 0 - ring
            while z <= ring {
                var x: i32 = 0 - ring
                while x <= ring {
                    if max_i32(abs_i32(x), abs_i32(z)) == ring {
                        wgdf_gen.gen_chunk(gen, x, z, out as *mut u8, bio as *mut u8)
                        count = count + 1
                    }
                    x = x + 1
                }
                z = z + 1
            }
            ring = ring + 1
        }
    } else {
        var z2: i32 = 0 - half
        while z2 <= half {
            var x2: i32 = 0 - half
            while x2 <= half {
                wgdf_gen.gen_chunk(gen, x2, z2, out as *mut u8, bio as *mut u8)
                count = count + 1
                x2 = x2 + 1
            }
            z2 = z2 + 1
        }
    }
    let t1: u64 = time.monotonic_ns()
    let ms: u64 = (t1 - t0) / 1000000
    io.fmt_print(f"chunks {count} wall_ms {ms}\n")
    var h: u64 = 7
    var i: usize = 0
    while i < (height as usize) * 256 {
        h = (h * 131 + (rt.ld8(out, i) as u64)) % 1000000007
        i = i + 1
    }
    io.fmt_print(f"last_hash {h}\n")
    wgdf_gen.gen_close(gen)
    rt.finish(0 as i64)
    return 0
}
