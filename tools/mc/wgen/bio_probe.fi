import std.rt
import std.io
import std.str
import mc.gen.wgdf_graph
import mc.gen.wgdf_load
import mc.gen.wgdf_eval
import mc.gen.wgbio_source

fn arg_of(start: u64, i: usize) -> str {
    let sp: str.Span = str.span_of_c(rt.arg_ptr(start, i) as *mut u8)
    return str { p: sp.p, n: sp.n }
}

fn parse_i64(s: str) -> i64 {
    var neg: bool = false
    var i: usize = 0
    var v: i64 = 0
    if s.n > 0 && *(s.p) == 45 {
        neg = true
        i = 1
    }
    while i < s.n {
        v = v * 10 + ((*(((s.p as u64) + (i as u64)) as *u8)) as i64 - 48)
        i = i + 1
    }
    if neg { return 0 - v }
    return v
}

fn main(start: u64) -> i32 {
    let root: str = arg_of(start, 1)
    let dim: str = arg_of(start, 2)
    let seed: i64 = parse_i64(arg_of(start, 3))
    let cx: i32 = parse_i64(arg_of(start, 4)) as i32
    let cz: i32 = parse_i64(arg_of(start, 5)) as i32
    var g: wgdf_graph.WgGraph = wgdf_graph.graph_new()
    if !wgdf_load.load_settings(&g, root, dim) {
        io.fmt_print(f"LOAD FAILED\n")
        return 1
    }
    let ns: *mut wgdf_eval.WgNoises = wgdf_eval.noises_alloc()
    wgdf_eval.noises_build(&g, ns, seed)
    let bs: *mut wgbio_source.BioSource = wgbio_source.bio_open(&g, root, wgbio_source.bio_preset_of(dim))
    if bs == (0 as *mut wgbio_source.BioSource) {
        io.fmt_print(f"BIOME SOURCE FAILED\n")
        return 1
    }
    let cells: usize = ((g.height / 4) as usize) * 16
    let buf: u64 = rt.heap_alloc(cells + 64)
    wgbio_source.bio_fill_chunk(bs, &g, ns, cx, cz, buf as *mut u8)
    let qy0: i32 = wgdf_eval.floor_div(g.min_y, 4)
    var iy: i32 = 0
    while iy < g.height / 4 {
        let sec: usize = (iy / 4) as usize
        let y4: usize = (iy % 4) as usize
        let qy: i32 = qy0 + iy
        io.fmt_print(f"{seed} {cx} {cz} B {qy}")
        var c: usize = 0
        while c < 16 {
            let n: usize = rt.ld8(buf, sec * 64 + y4 * 16 + c) as usize
            let nm: str = wgbio_source.bio_name(bs, n)
            io.fmt_print(f" {nm}")
            c = c + 1
        }
        io.fmt_print(f"\n")
        iy = iy + 1
    }
    return 0
}
