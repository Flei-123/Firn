import std.rt
import std.io
import std.math
import mc.gen.mg_random
import mc.gen.mg_wgen
import mc.gen.mg_mth
import mc.gen.mg_noise
import noise.improved
import noise.perlin
import noise.simplex
import noise.psimplex
import noise.jnum
import noise.interp
import noise.xoroshiro

const SEED_COUNT: i32 = 800
const OLD: bool = false

struct Gen {
    s: u64,
}

fn gn(g: *mut Gen) -> u64 {
    (*g).s = (*g).s +% 0x9e3779b97f4a7c15
    var z: u64 = (*g).s
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    return z ^ (z >> 31)
}

fn gi(g: *mut Gen, b: i32) -> i32 {
    return (gn(g) % (b as u64)) as i32
}

#[allow_fp]
fn gu(g: *mut Gen) -> f64 {
    return ((gn(g) >> 11) as f64) * 1.1102230246251565e-16
}

#[allow_fp]
fn gd(g: *mut Gen, s: f64) -> f64 {
    let u: f64 = gu(g)
    return (u * 2.0 - 1.0) * s
}

fn scale_at(i: i32) -> f64 {
    if i == 0 {
        return 1e-3
    }
    if i == 1 {
        return 0.5
    }
    if i == 2 {
        return 8.0
    }
    if i == 3 {
        return 256.0
    }
    if i == 4 {
        return 1e4
    }
    if i == 5 {
        return 1e6
    }
    if i == 6 {
        return 3.3e7
    }
    if OLD {
        return 1e9
    }
    return 1e12
}

fn spi(i: i32) -> i32 {
    if i == 0 {
        return 0
    }
    if i == 1 {
        return 0 - 1
    }
    if i == 2 {
        return 1
    }
    if i == 3 {
        return 16
    }
    if i == 4 {
        return 0 - 16
    }
    if i == 5 {
        return 29999984
    }
    if i == 6 {
        return 0 - 29999984
    }
    if i == 7 {
        return 0 - 2147483647 - 1
    }
    if i == 8 {
        return 2147483647
    }
    if i == 9 {
        return 1 << 24
    }
    return 0 - (1 << 24)
}

#[allow_fp]
fn gx(g: *mut Gen) -> f64 {
    let k: i32 = gi(g, 10)
    if k == 9 {
        let v: f64 = gd(g, 100.0)
        return (v as i64) as f64
    }
    let si: i32 = gi(g, 8)
    return gd(g, scale_at(si))
}

fn gcoord(g: *mut Gen) -> i32 {
    let k: i32 = gi(g, 8)
    if k == 0 {
        let j: i32 = gi(g, 11)
        return spi(j)
    }
    if k < 4 {
        return ((gn(g) >> 41) as i32) - (1 << 22)
    }
    if k < 7 {
        return ((gn(g) >> 35) as i32) - (1 << 28)
    }
    return gn(g) as% i32
}

fn put_cp(buf: *mut [u8; 64], n: usize, cp: i32) -> usize {
    var m: usize = n
    if cp < 0x80 {
        (*buf)[m] = cp as u8
        return m + 1
    }
    if cp < 0x800 {
        (*buf)[m] = (0xc0 | (cp >> 6)) as u8
        (*buf)[m + 1] = (0x80 | (cp & 0x3f)) as u8
        return m + 2
    }
    if cp < 0x10000 {
        (*buf)[m] = (0xe0 | (cp >> 12)) as u8
        (*buf)[m + 1] = (0x80 | ((cp >> 6) & 0x3f)) as u8
        (*buf)[m + 2] = (0x80 | (cp & 0x3f)) as u8
        return m + 3
    }
    (*buf)[m] = (0xf0 | (cp >> 18)) as u8
    (*buf)[m + 1] = (0x80 | ((cp >> 12) & 0x3f)) as u8
    (*buf)[m + 2] = (0x80 | ((cp >> 6) & 0x3f)) as u8
    (*buf)[m + 3] = (0x80 | (cp & 0x3f)) as u8
    return m + 4
}

fn gname(g: *mut Gen, buf: *mut [u8; 64]) -> usize {
    let n: i32 = 1 + gi(g, 12)
    var len: usize = 0
    var i: i32 = 0
    while i < n {
        let k: i32 = gi(g, 4)
        var cp: i32 = 0
        if k == 0 {
            cp = 0x20 + gi(g, 95)
        } else {
            if k == 1 {
                cp = 0x80 + gi(g, 0x780)
            } else {
                if k == 2 {
                    cp = 0x800 + gi(g, 0xf800)
                    if cp >= 0xd800 && cp <= 0xdfff {
                        cp = cp + 0x800
                    }
                } else {
                    cp = 0x10000 + gi(g, 0x100000)
                }
            }
        }
        len = put_cp(buf, len, cp)
        i = i + 1
    }
    return len
}

fn hx(v: f64) -> u64 {
    return math.math_bits(v)
}

fn pd(v: f64) {
    io.fmt_print(f" {hx(v):x}")
}

fn pl(v: i64) {
    io.fmt_print(f" {v}")
}

fn pi(v: i32) {
    io.fmt_print(f" {v}")
}

fn pz(v: bool) {
    if v {
        io.fmt_print(f" 1")
    } else {
        io.fmt_print(f" 0")
    }
}

fn nl() {
    io.fmt_print(f"\n")
}

fn mk(kind: i32, s: i64) -> mg_random.Rng {
    if kind == 0 {
        return mg_random.rng_legacy(s)
    }
    if kind == 1 {
        return mg_random.rng_xoro(s)
    }
    if kind == 2 {
        return mg_random.rng_wrap(mg_random.rng_legacy(s))
    }
    return mg_random.rng_wrap(mg_random.rng_xoro(s))
}

fn wg_count(r: *mg_random.Rng) -> i32 {
    if (*r).wrapped {
        return (*r).count
    }
    return 0 - 1
}

fn bound_at(i: i32) -> i32 {
    if i == 0 {
        return 1
    }
    if i == 1 {
        return 2
    }
    if i == 2 {
        return 3
    }
    if i == 3 {
        return 5
    }
    if i == 4 {
        return 7
    }
    if i == 5 {
        return 10
    }
    if i == 6 {
        return 16
    }
    if i == 7 {
        return 24
    }
    if i == 8 {
        return 100
    }
    if i == 9 {
        return 1000
    }
    if i == 10 {
        return (1 << 20) + 3
    }
    if i == 11 {
        return 1 << 30
    }
    if i == 12 {
        return (1 << 30) + 17
    }
    return 2147483647
}

fn stream(kind: i32, s: i64) {
    var r: mg_random.Rng = mk(kind, s)
    io.fmt_print(f"rs {kind}")
    pl(mg_random.rng_next_long(&r))
    pi(mg_random.rng_next_int(&r))
    var k: i32 = 0
    while k < 14 {
        pi(mg_random.rng_next_int_bound(&r, bound_at(k)))
        k = k + 1
    }
    pz(mg_random.rng_next_bool(&r))
    pd(mg_random.rng_next_float(&r) as f64)
    pd(mg_random.rng_next_double(&r))
    pd(mg_random.rng_next_gaussian(&r))
    pd(mg_random.rng_next_gaussian(&r))
    pd(mg_random.rng_next_gaussian(&r))
    mg_random.rng_consume(&r, 37)
    pl(mg_random.rng_next_long(&r))
    var f: mg_random.Rng = mg_random.rng_fork(&r)
    pl(mg_random.rng_next_long(&f))
    pl(mg_random.rng_next_long(&r))
    mg_random.rng_set_seed(&r, s ^ (0x2545f4914f6cdd1d as i64))
    pl(mg_random.rng_next_long(&r))
    pd(mg_random.rng_next_gaussian(&r))
    pi(wg_count(&r))
    nl()
}

fn hash_line(f: *mg_random.PosFactory, g: *mut Gen) {
    var buf: [u8; 64] = [0; 64]
    let n: usize = gname(g, &buf)
    var q: mg_random.Rng = mg_random.pos_from_hash_of(f, (&buf[0]) as u64, n)
    pl(mg_random.rng_next_long(&q))
    pd(mg_random.rng_next_double(&q))
}

fn fixed_hash(f: *mg_random.PosFactory, name: *[u8; 32], n: usize) {
    var q: mg_random.Rng = mg_random.pos_from_hash_of(f, (&(*name)[0]) as u64, n)
    pl(mg_random.rng_next_long(&q))
}

fn positional(kind: i32, s: i64, g: *mut Gen) {
    var r: mg_random.Rng = mk(kind, s)
    var f: mg_random.PosFactory = mg_random.rng_fork_positional(&r)
    io.fmt_print(f"ps {kind}")
    var k: i32 = 0
    while k < 3 {
        let x: i32 = gcoord(g)
        let y: i32 = gcoord(g)
        let z: i32 = gcoord(g)
        var q: mg_random.Rng = mg_random.pos_at(&f, x, y, z)
        pl(mg_random.rng_next_long(&q))
        pi(mg_random.rng_next_int_bound(&q, 100))
        pd(mg_random.rng_next_double(&q))
        k = k + 1
    }
    let sd: i64 = gn(g) as i64
    if !OLD {
        var q2: mg_random.Rng = mg_random.pos_from_seed(&f, sd)
        pl(mg_random.rng_next_long(&q2))
    }
    k = 0
    while k < 3 {
        hash_line(&f, g)
        k = k + 1
    }
    var a: [u8; 32] = [0; 32]
    let s1: str = "minecraft:overworld"
    var i: usize = 0
    while i < 19 {
        a[i] = s1[i]
        i = i + 1
    }
    fixed_hash(&f, &a, 19)
    var b: [u8; 32] = [0; 32]
    let s2: str = "octave_-3"
    i = 0
    while i < 9 {
        b[i] = s2[i]
        i = i + 1
    }
    fixed_hash(&f, &b, 9)
    fixed_hash(&f, &b, 0)
    nl()
}

fn worldgen(kind: i32, s: i64, g: *mut Gen) {
    var w: mg_random.Rng = mk(kind, s)
    io.fmt_print(f"wg {kind}")
    let s2: i64 = gn(g) as i64
    let x: i32 = gcoord(g)
    let z: i32 = gcoord(g)
    let idx: i32 = gi(g, 100)
    let step: i32 = gi(g, 12)
    let salt: i32 = gi(g, 100000)
    pi(mg_random.rng_next_int(&w))
    pl(mg_random.rng_next_long(&w))
    pd(mg_random.rng_next_double(&w))
    pd(mg_random.rng_next_gaussian(&w))
    pz(mg_random.rng_next_bool(&w))
    pi(mg_random.rng_next_int_bound(&w, 1000))
    pi(wg_count(&w))
    pl(mg_wgen.set_decoration_seed(&w, s2, x, z))
    pl(mg_random.rng_next_long(&w))
    pi(wg_count(&w))
    mg_wgen.set_feature_seed(&w, s2, idx, step)
    pl(mg_random.rng_next_long(&w))
    pi(wg_count(&w))
    mg_wgen.set_large_feature_seed(&w, s2, x, z)
    pl(mg_random.rng_next_long(&w))
    pi(wg_count(&w))
    mg_wgen.set_large_feature_with_salt(&w, s2, x, z, salt)
    pl(mg_random.rng_next_long(&w))
    pi(wg_count(&w))
    let sl: i64 = gn(g) as i64
    var q: mg_random.Rng = mg_wgen.seed_slime_chunk(x, z, s2, sl)
    pi(mg_random.rng_next_int_bound(&q, 10))
    pl(mg_random.rng_next_long(&q))
    nl()
}

fn improved_section(kind: i32, s: i64, g: *mut Gen) {
    var r: mg_random.Rng = mk(kind, s)
    let h: improved.Improved = mg_noise.improved_from_rng(&r)
    var k: i32 = 0
    while k < 6 {
        io.fmt_print(f"im {kind} {k}")
        pd(h.xo)
        pd(h.yo)
        pd(h.zo)
        let x: f64 = gx(g)
        let y: f64 = gx(g)
        let z: f64 = gx(g)
        let ys: f64 = gd(g, 2.0)
        let ym: f64 = gd(g, 1.0)
        var dv: [f64; 3] = [0.0; 3]
        pd(improved.improved_noise(&h, x, y, z))
        pd(improved.improved_noise_smear(&h, x, y, z, ys, ym))
        pd(improved.improved_noise_deriv(&h, x, y, z, &dv))
        pd(dv[0])
        pd(dv[1])
        pd(dv[2])
        nl()
        k = k + 1
    }
}

#[allow_fp]
fn gen_amps(g: *mut Gen, amps: *mut [f64; 32], cnt: i32) {
    var k: i32 = 0
    while k < cnt {
        let a: i32 = gi(g, 5)
        if a == 0 {
            (*amps)[k as usize] = 0.0
        } else {
            let b: i32 = gi(g, 4)
            if b == 0 {
                (*amps)[k as usize] = 1.0
            } else {
                (*amps)[k as usize] = gd(g, 3.0)
            }
        }
        k = k + 1
    }
    let nz: i32 = gi(g, cnt)
    if (*amps)[nz as usize] == 0.0 {
        let u: f64 = gu(g)
        (*amps)[nz as usize] = 1.0 + u
    }
}

fn perlin_section(v: i32, s: i64, g: *mut Gen) {
    var kind: i32 = 0
    if v == 0 || v == 3 {
        kind = 1
    }
    let first: i32 = 0 - gi(g, 13)
    var lim: i32 = 6
    if 1 - first < lim {
        lim = 1 - first
    }
    let cnt: i32 = 1 + gi(g, lim)
    var amps: [f64; 32] = [0.0; 32]
    gen_amps(g, &amps, cnt)
    var r: mg_random.Rng = mk(kind, s)
    let p: perlin.Perlin = mg_noise.perlin_create(&r, first, &amps, cnt, v < 2)
    var k: i32 = 0
    while k < 4 {
        io.fmt_print(f"pn {v} {k} {first} {cnt}")
        let x: f64 = gx(g)
        let y: f64 = gx(g)
        let z: f64 = gx(g)
        let ys: f64 = gd(g, 2.0)
        let ym: f64 = gd(g, 1.0)
        pd(perlin.perlin_max_broken(&p, ys))
        pd(perlin.perlin_value(&p, x, y, z))
        pd(perlin.perlin_value_smear(&p, x, y, z, ys, ym))
        pd(perlin.perlin_wrap(x))
        var o: i32 = 0
        while o < 3 {
            if o < cnt && perlin.perlin_octave_has(&p, o) {
                pd(improved.improved_noise(perlin.perlin_octave(&p, o), x, y, z))
            } else {
                io.fmt_print(f" -")
            }
            o = o + 1
        }
        nl()
        k = k + 1
    }
}

fn normal_section(v: i32, s: i64, g: *mut Gen) {
    var kind: i32 = 0
    if v == 0 || v == 3 {
        kind = 1
    }
    let first: i32 = 0 - gi(g, 13)
    var lim: i32 = 6
    if 1 - first < lim {
        lim = 1 - first
    }
    let cnt: i32 = 1 + gi(g, lim)
    var amps: [f64; 32] = [0.0; 32]
    gen_amps(g, &amps, cnt)
    var r: mg_random.Rng = mk(kind, s)
    let n: perlin.Normal = mg_noise.normal_create(&r, first, &amps, cnt, v < 2)
    io.fmt_print(f"nn {v} {first} {cnt}")
    pd(n.max_value)
    var k: i32 = 0
    while k < 4 {
        let x: f64 = gx(g)
        let y: f64 = gx(g)
        let z: f64 = gx(g)
        pd(perlin.normal_value(&n, x, y, z))
        k = k + 1
    }
    nl()
}

#[allow_fp]
fn blended_section(kind: i32, s: i64, g: *mut Gen) {
    let u1: f64 = gu(g)
    let u2: f64 = gu(g)
    let u3: f64 = gu(g)
    let u4: f64 = gu(g)
    let u5: f64 = gu(g)
    let xz_s: f64 = 0.1 + u1 * 3.0
    let y_s: f64 = 0.1 + u2 * 3.0
    let xz_f: f64 = 20.0 + u3 * 200.0
    let y_f: f64 = 20.0 + u4 * 200.0
    let sm: f64 = 1.0 + u5 * 15.0
    var r: mg_random.Rng = mk(kind, s)
    let n: perlin.Blended = mg_noise.blended_create(&r, xz_s, y_s, xz_f, y_f, sm)
    io.fmt_print(f"bl {kind}")
    pd(xz_s)
    pd(sm)
    var k: i32 = 0
    while k < 4 {
        let bx: i32 = gcoord(g)
        let by: i32 = gi(g, 400) - 64
        let bz: i32 = gcoord(g)
        pd(perlin.blended_value(&n, bx, by, bz))
        k = k + 1
    }
    nl()
}

fn simplex_section(kind: i32, s: i64, g: *mut Gen) {
    var r: mg_random.Rng = mk(kind, s)
    let h: simplex.Simplex = mg_noise.simplex_from_rng(&r)
    var k: i32 = 0
    while k < 6 {
        io.fmt_print(f"sx {kind} {k}")
        pd(h.xo)
        pd(h.yo)
        pd(h.zo)
        let x: f64 = gx(g)
        let y: f64 = gx(g)
        let z: f64 = gx(g)
        pd(simplex.simplex_value2(&h, x, y))
        pd(simplex.simplex_value3(&h, x, y, z))
        nl()
        k = k + 1
    }
}

fn psimplex_section(kind: i32, s: i64, g: *mut Gen) {
    let mask: i32 = 1 + gi(g, 63)
    var set: mg_noise.OctaveSet = mg_noise.OctaveSet { v: [0; 32], n: 0 }
    var k: i32 = 0
    while k < 6 {
        if (mask & (1 << k)) != 0 {
            set.v[set.n as usize] = k - 3
            set.n = set.n + 1
        }
        k = k + 1
    }
    var r: mg_random.Rng = mk(kind, s)
    let p: psimplex.PerlinSimplex = mg_noise.psimplex_create(&r, &set)
    io.fmt_print(f"pm {kind} {mask}")
    k = 0
    while k < 4 {
        let x: f64 = gx(g)
        let y: f64 = gx(g)
        let off: bool = gi(g, 2) == 0
        pd(psimplex.psimplex_value(&p, x, y, off))
        k = k + 1
    }
    nl()
}

fn mth_section(g: *mut Gen) {
    io.fmt_print(f"mt")
    let t: f64 = gd(g, 2.0)
    let a: f64 = gd(g, 100.0)
    let c: f64 = gd(g, 100.0)
    pd(interp.lerp(t, a, c))
    let t2: f64 = gd(g, 2.0)
    let v0: f64 = gd(g, 10.0)
    let v1: f64 = gd(g, 10.0)
    let v2: f64 = gd(g, 10.0)
    let v3: f64 = gd(g, 10.0)
    pd(interp.lerp2(t, t2, v0, v1, v2, v3))
    let t3: f64 = gd(g, 2.0)
    let w0: f64 = gd(g, 10.0)
    let w1: f64 = gd(g, 10.0)
    let w2: f64 = gd(g, 10.0)
    let w3: f64 = gd(g, 10.0)
    pd(interp.lerp3(t, t2, t3, v0, v1, v2, v3, w0, w1, w2, w3))
    let sv: f64 = gd(g, 2.0)
    pd(interp.smoothstep(sv))
    pd(interp.smoothstep_derivative(sv))
    pd(interp.inverse_lerp(t, a, c))
    pd(interp.clamped_lerp(a, c, t))
    pd(interp.clamped_map(t, a, c, v0, v1))
    let fx: f64 = gx(g)
    pi(jnum.floor_i32(fx))
    pl(jnum.floor_i64(fx))
    let gx0: i32 = gcoord(g)
    let gy0: i32 = gcoord(g)
    let gz0: i32 = gcoord(g)
    pl(mg_mth.get_seed(gx0, gy0, gz0))
    pl(xoroshiro.mix_stafford13(gn(g)) as i64)
    nl()
}

fn special_d(i: i32) -> f64 {
    if i == 0 {
        return 0.0
    }
    if i == 1 {
        return 0.0 * (0.0 - 1.0)
    }
    if i == 2 {
        return 0.5
    }
    if i == 3 {
        return 0.0 - 0.5
    }
    if i == 4 {
        return 2147483647.5
    }
    if i == 5 {
        return 0.0 - 2147483648.5
    }
    if i == 6 {
        return 2147483648.0
    }
    if i == 7 {
        return 0.0 - 2147483649.0
    }
    if i == 8 {
        return 3e9
    }
    if i == 9 {
        return 0.0 - 3e9
    }
    if i == 10 {
        return 9.3e18
    }
    if i == 11 {
        return 0.0 - 9.3e18
    }
    if i == 12 {
        return 1e30
    }
    if i == 13 {
        return 0.0 - 1e30
    }
    if i == 14 {
        return 4503599627370496.5
    }
    if i == 15 {
        return 0.0 - 1.0
    }
    return 1.0
}

fn mth_special() {
    var k: i32 = 0
    while k < 17 {
        let v: f64 = special_d(k)
        let skip: bool = OLD && (k == 5 || k == 7 || k == 9 || k == 11 || k == 13)
        if !skip {
            io.fmt_print(f"ms {k}")
            pi(jnum.floor_i32(v))
            pl(jnum.floor_i64(v))
            pd(perlin.perlin_wrap(v))
            pd(interp.smoothstep(v))
            pd(interp.clamped_map(v, 0.0 - 1.0, 1.0, 0.0, 10.0))
            nl()
        }
        k = k + 1
    }
}

fn spl(i: i32) -> i64 {
    if i == 0 {
        return 0
    }
    if i == 1 {
        return 0 - 1
    }
    if i == 2 {
        return 1
    }
    if i == 3 {
        return (0x8000000000000000 as u64) as i64
    }
    if i == 4 {
        return 9223372036854775807
    }
    if i == 5 {
        return 0x5deece66d
    }
    if i == 6 {
        return 0xffffffff
    }
    if i == 7 {
        return 1 << 48
    }
    if i == 8 {
        return (1 << 48) - 1
    }
    if i == 9 {
        return 0 - (1 << 31)
    }
    if i == 10 {
        return 42
    }
    return 12345678901234
}

fn main() -> i32 {
    mth_special()
    var master: Gen = Gen { s: 0xc0ffee }
    var g: Gen = Gen { s: 0 }
    var n: i32 = 0
    while n < 12 + SEED_COUNT {
        var s: i64 = 0
        if n < 12 {
            s = spl(n)
        } else {
            s = gn(&master) as i64
        }
        g.s = (s as u64) ^ 0x5851f42d4c957f2d
        var k: i32 = 0
        while k < 4 {
            stream(k, s)
            k = k + 1
        }
        k = 0
        while k < 4 {
            positional(k, s, &g)
            k = k + 1
        }
        worldgen(2, s, &g)
        worldgen(3, s, &g)
        improved_section(0, s, &g)
        improved_section(1, s, &g)
        k = 0
        while k < 4 {
            perlin_section(k, s, &g)
            k = k + 1
        }
        k = 0
        while k < 4 {
            normal_section(k, s, &g)
            k = k + 1
        }
        blended_section(0, s, &g)
        blended_section(1, s, &g)
        simplex_section(0, s, &g)
        simplex_section(1, s, &g)
        psimplex_section(2, s, &g)
        psimplex_section(3, s, &g)
        k = 0
        while k < 3 {
            mth_section(&g)
            k = k + 1
        }
        n = n + 1
    }
    return 0
}
