// tools/mc/net/prog.fi -- the Firn side of the mc_net cross-check.
//
//     prog status <port> <attempts> <max_waits>    the server list ping against 127.0.0.1:<port>
//
// Prints `rc=<code>` and, on success, the fields the answer carried.
import std.rt
import std.io
import std.net
import mc.mc_net
import mc.mc_version
import mc.mc_versions

fn parse(p: u64) -> u64 {
    var v: u64 = 0
    var i: usize = 0
    while i < rt.c_length(p) {
        v = v * 10 as u64 + (rt.ld8(p, i) - 48 as u8) as u64
        i = i + 1
    }
    return v
}

fn now_ms() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000 as u64 + (ts[1] as u64) / 1000000 as u64
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 5 {
        return 2
    }
    let port: u16 = parse(rt.arg_ptr(start, 2)) as u16
    let attempts: i32 = parse(rt.arg_ptr(start, 3)) as i32
    let waits: i32 = parse(rt.arg_ptr(start, 4)) as i32
    var ver: mc_version.Version = mc_version.version_empty()
    mc_versions.version_by_protocol(763, &ver)
    var st: mc_net.Status = mc_net.status_new()
    var host: [u8; 10] = "localhost\0"
    let t0: u64 = now_ms()
    let rc: i32 = mc_net.net_status(net.ADDR_LOCAL, port, (&host[0]) as u64, &ver, attempts, waits, &st)
    let dt: u64 = now_ms() - t0
    io.fmt_print(f"rc={rc} elapsed_ms={dt}\n")
    if rc == 0 {
        io.fmt_print(f"protocol={st.protocol} online={st.online} max={st.max} latency_ok={st.latency_ms < 2000 as u64}\n")
        io.fmt_print(f"name=")
        io.print_bytes((&st.name[0]) as u64, st.name_len)
        io.fmt_print(f"\nmotd=")
        io.print_bytes(rt.buf_ptr(&st.motd), rt.buf_len(&st.motd))
        io.fmt_print(f"\n")
    }
    mc_net.status_free(&st)
    return 0
}
