// tools/mc/mesh/prog.fi -- the Firn side of the mc_mesh cross-check.
//
//     prog mesh <padded.bin> <flags>            mesh the padded 18^3 input, print the quads / triangles
//     prog bench <padded.bin> <flags> <rounds>  sections per second
//
// <padded.bin> = 5832 u16 little endian (layout in lib/mc/mc_mesh.fi). The block tables are defined by
// a rule that verify.py repeats independently (id 0 air, 1-4 opaque, 5-6 glass-like, 7 plant, 8 invisible,
// 9 opaque without a top face; everything else invisible).
import std.rt
import std.io
import mc.mc_mesh

fn build_tables(t: *mut mc_mesh.MeshTables) {
    let opaque: u64 = rt.heap_alloc(32768)
    let tiles: u64 = rt.heap_alloc(32768 * 6 * 2)
    var i: usize = 0
    while i < 32768 {
        rt.st8(opaque, i, 0 as u8)
        var f: usize = 0
        while f < 6 {
            rt.st16(tiles, i * 6 + f, 0 as u16)
            f = f + 1
        }
        i = i + 1
    }
    var id: usize = 1
    while id <= 9 {
        var f: usize = 0
        while f < 6 {
            var tile: usize = 0
            if id >= 1 && id <= 4 {
                tile = id * 10 + f + 1
            } else if id == 5 || id == 6 {
                tile = 100 + (id - 5) * 10 + f + 1
            } else if id == 7 {
                tile = 200 + f + 1
            } else if id == 9 && f != 3 {
                tile = 300 + f + 1
            }
            rt.st16(tiles, id * 6 + f, tile as u16)
            f = f + 1
        }
        if id == 1 || id == 2 || id == 3 || id == 4 || id == 9 {
            rt.st8(opaque, id, 1 as u8)
        }
        id = id + 1
    }
    (*t).opaque = opaque
    (*t).tiles = tiles
}

fn parse(p: u64) -> u64 {
    var v: u64 = 0
    var i: usize = 0
    while i < rt.c_length(p) {
        v = v * 10 as u64 + (rt.ld8(p, i) - 48 as u8) as u64
        i = i + 1
    }
    return v
}

fn now_ns() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000000 as u64 + (ts[1] as u64)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 4 {
        return 2
    }
    let mode: u8 = rt.ld8(rt.arg_ptr(start, 1), 0)
    var input: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 2), &input) || input.len != 5832 * 2 {
        return 3
    }
    let flags: u32 = parse(rt.arg_ptr(start, 3)) as u32
    var t: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    build_tables(&t)
    var m: mc_mesh.Mesher = mc_mesh.mesher_new()
    if mode == 98 as u8 {
        let rounds: u64 = parse(rt.arg_ptr(start, 4))
        let t0: u64 = now_ns()
        var k: u64 = 0
        var quads: u64 = 0
        while k < rounds {
            mc_mesh.mesh_padded(&m, input.ptr, &t, flags)
            quads = quads + m.nquads as u64
            k = k + 1 as u64
        }
        let dt: u64 = now_ns() - t0
        io.fmt_print(f"metric sections_per_s={rounds * 1000000000 as u64 / dt} quads_per_section={quads / rounds} bytes_per_section={mc_mesh.mesh_used_bytes(&m)}\n")
        return 0
    }
    mc_mesh.mesh_padded(&m, input.ptr, &t, flags)
    io.fmt_print(f"S nquads={m.nquads} nverts={m.nverts} nidx={m.nidx} nfaces={m.nfaces}\n")
    var q: u32 = 0 as u32
    while q < m.nquads {
        let w0: u32 = rt.ld32(m.verts, (q * 4 as u32) as usize * 2)
        let w1: u32 = rt.ld32(m.verts, (q * 4 as u32) as usize * 2 + 1)
        let w1b: u32 = rt.ld32(m.verts, ((q * 4 as u32) + 1 as u32) as usize * 2 + 1)
        let w1d: u32 = rt.ld32(m.verts, ((q * 4 as u32) + 3 as u32) as usize * 2 + 1)
        let f: u32 = mc_mesh.vtx_face(w0)
        let axis: u32 = f / 2 as u32
        var pos: [u32; 3] = [mc_mesh.vtx_x(w0), mc_mesh.vtx_y(w0), mc_mesh.vtx_z(w0)]
        let ua: u32 = (axis + 1 as u32) % 3 as u32
        let va: u32 = (axis + 2 as u32) % 3 as u32
        let a1: u32 = mc_mesh.vtx_ao(rt.ld32(m.verts, ((q * 4 as u32) + 1 as u32) as usize * 2))
        let a2: u32 = mc_mesh.vtx_ao(rt.ld32(m.verts, ((q * 4 as u32) + 2 as u32) as usize * 2))
        let a3: u32 = mc_mesh.vtx_ao(rt.ld32(m.verts, ((q * 4 as u32) + 3 as u32) as usize * 2))
        io.fmt_print(f"Q {f} {pos[axis as usize]} {pos[ua as usize]} {pos[va as usize]} {mc_mesh.vtx_u(w1b)} {mc_mesh.vtx_v(w1d)} {mc_mesh.vtx_tile(w1)} {mc_mesh.vtx_ao(w0)} {a1} {a2} {a3}\n")
        q = q + 1 as u32
    }
    var i: u32 = 0 as u32
    while i < m.nidx {
        io.fmt_print(f"I {rt.ld32(m.idx, i as usize)} {rt.ld32(m.idx, (i + 1 as u32) as usize)} {rt.ld32(m.idx, (i + 2 as u32) as usize)}\n")
        i = i + 3 as u32
    }
    return 0
}
