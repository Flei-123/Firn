// tools/mc/perf/stream_bench.fi -- render thread cost of the mesh scheduling in mc_stream (snapshot + submit), and the scaling of
// the mesh workers. Terrain fixture (lib/mc/mc_terrain.fi), CPU raster back end, a (2*RAD+1)^2 column world streamed in from empty.
// Usage: SB_WORKERS=4 SB_RUNS=5 SB_RAD=3 stream_bench     (SB_WORKERS=0 meshes inline)
// RESULT lines (per run and the median over the runs): submit_us_per_section (render thread, sum of st.submit_us / sections submitted),
// snap_wait_us_per_section (end-of-frame barrier), wall_ms (first frame -> everything meshed), mesh_cpu_ms (sum of the worker times).
import std.rt
import std.io
import std.time
import mc.mc_chunk
import mc.mc_world
import mc.mc_mesh
import mc.mc_camera
import mc.mc_texture
import mc.mc_raster
import mc.mc_backend
import mc.mc_cull
import mc.mc_terrain
import mc.mc_render_world
import mc.mc_stream
import mc.mc_perf
import mc.mc_perf_run
import jobs.jobs

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND {
        return jobs.worker_main(arg)
    }
    return 0
}

const NSEC: i32 = 6
static mut g_rad: i32 = 3

fn check(c: bool, code: i32) {
    if !c {
        io.fmt_eprint_line(f"stream_bench check failed {code as u64}")
        rt.finish(code as i64)
    }
}

fn floor_div16(v: i32) -> i32 {
    var q: i32 = v / 16
    if v % 16 != 0 && v < 0 { q = q - 1 }
    return q
}

fn fl(v: f64) -> i32 {
    var x: i32 = v as i32
    if (x as f64) > v { x = x - 1 }
    return x
}

#[allow_escape]
fn load_column(w: *mut mc_world.World, s: *mut mc_stream.Stream, cx: i32, cz: i32, ids: u64) {
    mc_terrain.terrain_column(cx, cz, NSEC, ids)
    check(mc_world.world_put(w, mc_render_world.wr_make_chunk(cx, cz, NSEC as usize, ids)), 50)
    check(mc_stream.stream_chunk_loaded(s, w, cx, cz), 51)
}

#[allow_escape]
fn load_all(w: *mut mc_world.World, s: *mut mc_stream.Stream, ids: u64) {
    var cz: i32 = 0 - g_rad
    while cz <= g_rad {
        var cx: i32 = 0 - g_rad
        while cx <= g_rad {
            load_column(w, s, cx, cz, ids)
            cx = cx + 1
        }
        cz = cz + 1
    }
}

static mut g_seed: u64 = 777

fn rnd_f(lo: f64, hi: f64) -> f64 {
    g_seed = g_seed *% 6364136223846793005 as u64 +% 1442695040888963407 as u64
    return lo + (hi - lo) * (((g_seed >> 33 as u64) % 100000 as u64) as f64 / 100000.0)
}

fn pose(cam: *mut mc_camera.Camera, i: i32) {
    var px: f64 = rnd_f(0.0 - 30.0, 30.0)
    var pz: f64 = rnd_f(0.0 - 30.0, 30.0)
    var py: f64 = (mc_terrain.terrain_height(fl(px), fl(pz), NSEC) + 3) as f64
    if i % 2 == 1 { py = rnd_f(6.0, 30.0) }
    var guard: i32 = 0
    while mc_terrain.terrain_block(fl(px), fl(py), fl(pz), NSEC) != 0 as u16 && guard < 80 {
        py = py + 1.0
        guard = guard + 1
    }
    mc_camera.camera_set_pos(cam, px, py, pz)
    mc_camera.camera_set_angles(cam, rnd_f(0.0 - 180.0, 180.0), rnd_f(0.0 - 25.0, 25.0))
    mc_camera.camera_update(cam)
}

fn fresh_raster(a: *mut mc_texture.Atlas) -> mc_raster.Raster {
    var r: mc_raster.Raster = mc_raster.raster_new(96, 54)
    mc_raster.backend_upload_atlas(&r, a)
    return r
}

#[allow_escape]
fn one_frame(s: *mut mc_stream.Stream, w: *mut mc_world.World, b: *mut mc_backend.Backend, cam: *mut mc_camera.Camera) {
    (*b).begin((*b).obj, cam as u64, 0xFF3C2814 as u32)
    mc_stream.stream_frame(s, w, b, cam)
    (*b).end((*b).obj)
}

#[allow_escape]
fn main() -> i32 {
    let workers: i32 = mc_perf_run.perf_env_int("SB_WORKERS", 4)
    let runs: i32 = mc_perf_run.perf_env_int("SB_RUNS", 5)
    g_rad = mc_perf_run.perf_env_int("SB_RAD", 3)
    let win: i32 = g_rad * 2 + 2
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_terrain.terrain_tables(&tb)
    var a: mc_texture.Atlas = mc_texture.atlas_default()
    var cam: mc_camera.Camera = mc_camera.camera_new(96, 54)
    mc_camera.camera_set_lens(&cam, 70.0, 0.05, 160.0)
    let ids: u64 = rt.heap_alloc(NSEC as usize * 4096 * 2)
    let rs: u64 = rt.heap_alloc(64 * 8)
    let ws: u64 = rt.heap_alloc(64 * 8)
    let ms: u64 = rt.heap_alloc(64 * 8)
    let cs: u64 = rt.heap_alloc(64 * 8)
    var run: i32 = 0
    while run < runs {
        var pool: jobs.Jobs = jobs.Jobs { blk: 0 }
        if mc_perf_run.perf_env_int("SB_LF", 0) != 0 { pool = jobs.create_lf(workers as u64) } else { pool = jobs.create(workers as u64) }
        var r: mc_raster.Raster = fresh_raster(&a)
        var b: mc_backend.Backend = mc_backend.backend_cpu(&r)
        var w: mc_world.World = mc_world.world_new()
        var pp: u64 = 0
        if workers > 0 { pp = (&pool) as *mut jobs.Jobs as u64 }
        var s: mc_stream.Stream = mc_stream.stream_new(0, NSEC, win, &tb, pp)
        s.nbr_wait = 3 as u32
        s.max_inflight = mc_perf_run.perf_env_int("SB_INFLIGHT", s.max_inflight as i32) as usize
        s.max_submit = mc_perf_run.perf_env_int("SB_SUBMIT", s.max_submit as i32) as usize
        load_all(&w, &s, ids)
        pose(&cam, 0)
        let sky: i32 = mc_perf_run.perf_env_int("SB_SKY", 0)
        if sky != 0 {
            // look straight up (+89) or down (-89): almost nothing is drawn, so the wall time is the pipeline (snapshot + mesh + upload)
            mc_camera.camera_set_angles(&cam, 0.0, (sky * 89) as f64)
            mc_camera.camera_update(&cam)
        }
        var frames: i32 = 0
        var sumsubmit: u64 = 0
        var sumwait: u64 = 0
        var summesh: u64 = 0
        var submitted: u64 = 0
        var sumdraw: u64 = 0
        var sumcull: u64 = 0
        let t0: u64 = time.monotonic_ns()
        while frames < 100000 {
            one_frame(&s, &w, &b, &cam)
            sumsubmit = sumsubmit + s.st.submit_us
            sumwait = sumwait + s.st.snap_wait_us
            summesh = summesh + s.st.mesh_ns
            submitted = submitted + s.st.submitted as u64
            sumdraw = sumdraw + s.st.draw_us
            sumcull = sumcull + s.st.cull_us
            frames = frames + 1
            if mc_stream.stream_pending(&s) == 0 && s.inflight == 0 { break }
        }
        let wall: u64 = time.monotonic_ns() - t0
        check(frames < 100000, 2)
        check(submitted > 0 as u64, 3)
        rt.st64(rs, run as usize, sumsubmit * 1000 as u64 / submitted)
        rt.st64(ws, run as usize, sumwait * 1000 as u64 / submitted)
        rt.st64(ms, run as usize, wall / 1000 as u64)
        rt.st64(cs, run as usize, summesh / 1000 as u64)
        if run == 0 {
            mc_perf.perf_emit("frames", (frames as u64) * 1000 as u64, "frames (run 0)")
            mc_perf.perf_emit("draw_ms_total", sumdraw, "ms (run 0)")
            mc_perf.perf_emit("cull_ms_total", sumcull, "ms (run 0)")
        }
        mc_stream.stream_free(&s, &b)
        mc_world.world_free(&w)
        jobs.destroy(&pool)
        run = run + 1
    }
    let n: usize = runs as usize
    mc_perf.perf_sort(rs, n)
    mc_perf.perf_sort(ws, n)
    mc_perf.perf_sort(ms, n)
    mc_perf.perf_sort(cs, n)
    mc_perf.perf_emit("submit_us_per_section", mc_perf.perf_percentile(rs, n, 5000 as u64), "us median")
    mc_perf.perf_emit("submit_us_per_section_min", mc_perf.perf_percentile(rs, n, 0 as u64), "us min")
    mc_perf.perf_emit("snap_wait_us_per_section", mc_perf.perf_percentile(ws, n, 5000 as u64), "us median")
    mc_perf.perf_emit("wall_ms", mc_perf.perf_percentile(ms, n, 5000 as u64), "ms median")
    mc_perf.perf_emit("wall_ms_min", mc_perf.perf_percentile(ms, n, 0 as u64), "ms min")
    mc_perf.perf_emit("mesh_cpu_ms", mc_perf.perf_percentile(cs, n, 5000 as u64), "ms median")
    return 0
}
