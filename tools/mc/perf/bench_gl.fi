// tools/mc/perf/bench.fi -- benchmark entry, CPU rasterizer back end (mc_raster). See lib/mc/mc_perf_run.fi, docs/MC-PERF.md.
//   bench <world.mcw> <radius-chunks> [frames] [warm]      bench --stats <file>
import std.rt
import std.io
import mc.mc_raster
import mc.mc_backend
import mc.mc_perf
import mc.mc_perf_run
import gpu.gl_mc
import gpu.gl33

fn c_is(p: u64, lit: str) -> bool {
    if rt.c_length(p) != lit.n {
        return false
    }
    var k: usize = 0
    while k < lit.n {
        if rt.ld8(p, k) != lit.chars(k) {
            return false
        }
        k = k + 1
    }
    return true
}

fn main(start: u64) -> i32 {
    let t0: u64 = mc_perf_run.perf_now_ns()
    if rt.arg_count(start) >= 3 && c_is(rt.arg_ptr(start, 1), "--stats") {
        return mc_perf_run.perf_stats_selftest(rt.arg_ptr(start, 2))
    }
    if rt.arg_count(start) < 3 {
        io.eprint_line("usage: bench <world.mcw> <radius-chunks> [frames=100] [warm=10]   |   bench --stats <file>")
        return 2
    }
    let w: i32 = mc_perf_run.perf_env_int("BENCH_W", 640)
    let h: i32 = mc_perf_run.perf_env_int("BENCH_H", 360)
    var gb: gl_mc.GlBackend = gl_mc.glbe_open(w, h)
    // experiment knobs (docs/MC-PERF.md section 7): BENCH_GL_MODE 0..3 (gl_mc.MODE_*), BENCH_GL_CULL=0 switches GL back-face culling off
    let gmode: i32 = mc_perf_run.perf_env_int("BENCH_GL_MODE", 0 - 1)
    if gmode >= 0 {
        gl_mc.glbe_set_mode(&gb, gmode)
    }
    if mc_perf_run.perf_env_int("BENCH_GL_CULL", 1) == 0 {
        gl_mc.glbe_set_cull(&gb, false)
    }
    if mc_perf_run.perf_env_int("BENCH_GL_FACECULL", 1) == 1 {
        gl_mc.glbe_set_facecull(&gb, true)
    }
    if mc_perf_run.perf_env_int("BENCH_GL_RDISCARD", 0) == 1 {
        // diagnosis only: GL_RASTERIZER_DISCARD = vertex shading + primitive setup, no rasterisation (the image stays empty)
        gl33.gl_enable(gl_mc.glbe_gl(&gb), 35977 as u32)
    }
    var b: mc_backend.Backend = gl_mc.glbe_backend(&gb)
    // real strings from the context (llvmpipe on Linux stays correct, Iris Xe etc. on Windows)
    mc_perf.perf_emit_ctext("backend", gl33.gl_string(gl_mc.glbe_gl(&gb), gl33.GL_RENDERER))
    mc_perf.perf_emit_ctext("renderer", gl33.gl_string(gl_mc.glbe_gl(&gb), gl33.GL_RENDERER))
    mc_perf.perf_emit_ctext("vendor", gl33.gl_string(gl_mc.glbe_gl(&gb), gl33.GL_VENDOR))
    mc_perf.perf_emit_ctext("gl_version", gl33.gl_string(gl_mc.glbe_gl(&gb), gl33.GL_VERSION))
    return mc_perf_run.perf_run(start, &b, w, h, t0)
}
