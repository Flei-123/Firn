// tools/mc/perf/mesh_bench.fi -- mesher micro benchmark on the deterministic fixture sections (lib/mc/mc_mesh_fixture.fi).
// Usage: mesh_bench [reps]   Prints RESULT lines: p50 / mean us per section for each mode, and the output hash of each mode.
import std.rt
import mc.mc_mesh
import mc.mc_mesh_fixture
import mc.mc_cull
import mc.mc_perf
import mc.mc_perf_run

const NSEC: usize = 64

fn main() -> i32 {
    var reps: usize = 5
    var t: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_mesh_fixture.fixture_tables(&t)
    var m: mc_mesh.Mesher = mc_mesh.mesher_new()
    let pad: u64 = rt.heap_alloc(5832 * 2)
    let lpad: u64 = rt.heap_alloc(5832)
    let tm: u64 = rt.heap_alloc(NSEC * 8 * 8)
    let nm: usize = 6
    var modes: [u32; 6] = [mc_mesh.F_AO, mc_mesh.F_AO | mc_mesh.F_GREEDY, 0 as u32, mc_mesh.F_AO | mc_mesh.F_LIGHT,
        mc_mesh.F_AO | mc_mesh.F_GREEDY | mc_mesh.F_LIGHT | mc_mesh.F_CULL_SAME, mc_mesh.F_AO | mc_mesh.F_TRANS]
    var names: [str; 6] = ["naive_ao", "greedy_ao", "naive_noao", "naive_ao_light", "greedy_ao_light", "trans_ao"]
    var mi: usize = 0
    while mi < nm {
        // terrain kinds only (kind 0 / 5 / 4) for the timing, like real play; the hash covers all kinds in the test
        var hash: u64 = 1469598103 as u64
        var tot: u64 = 0 as u64
        var best: u64 = 0 as u64
        var rep: usize = 0
        while rep < reps {
            let r0: u64 = mc_perf_run.perf_now_ns()
            var i: usize = 0
            while i < NSEC {
                var kind: usize = 0
                if i % 8 == 5 { kind = 4 } else if i % 8 == 6 { kind = 2 } else if i % 8 == 7 { kind = 1 }
                mc_mesh_fixture.fixture_pad(kind, (i / 8) as u64 + 1 as u64, pad, lpad)
                let a: u64 = mc_perf_run.perf_now_ns()
                mc_mesh.mesh_padded_lit(&m, pad, lpad, &t, modes[mi])
                let b: u64 = mc_perf_run.perf_now_ns()
                rt.st64(tm, rep * NSEC + i, b - a)
                if rep == 0 { hash = mc_mesh_fixture.mesh_hash(hash, &m) }
                i = i + 1
            }
            rep = rep + 1
        }
        // per-section time over reps: take the minimum over reps per section, then the median over sections
        var i2: usize = 0
        let mn: u64 = rt.heap_alloc(NSEC * 8)
        while i2 < NSEC {
            var lo: u64 = rt.ld64(tm, i2)
            var r2: usize = 1
            while r2 < reps {
                let v: u64 = rt.ld64(tm, r2 * NSEC + i2)
                if v < lo { lo = v }
                r2 = r2 + 1
            }
            rt.st64(mn, i2, lo)
            i2 = i2 + 1
        }
        mc_perf.perf_sort(mn, NSEC)
        mc_perf.perf_emit(names[mi], mc_perf.perf_percentile(mn, NSEC, 5000 as u64), "us/section p50")
        mc_perf.perf_emit(names[mi], mc_perf.perf_mean(mn, NSEC), "us/section mean")
        mc_perf.perf_emit_u(names[mi], hash, "hash")
        rt.heap_free(mn, NSEC * 8)
        mi = mi + 1
    }
    // cull_conn (r186) on the same sections: min over reps per section, median over sections
    {
        let scr: u64 = rt.heap_alloc(12288)
        var chash: u64 = 1469598103 as u64
        var rep: usize = 0
        while rep < reps {
            var i: usize = 0
            while i < NSEC {
                var kind: usize = 0
                if i % 8 == 5 { kind = 4 } else if i % 8 == 6 { kind = 2 } else if i % 8 == 7 { kind = 1 }
                mc_mesh_fixture.fixture_pad(kind, (i / 8) as u64 + 1 as u64, pad, lpad)
                let a: u64 = mc_perf_run.perf_now_ns()
                let cv: u32 = mc_cull.cull_conn(pad, t.opaque, scr)
                let b: u64 = mc_perf_run.perf_now_ns()
                rt.st64(tm, rep * NSEC + i, b - a)
                if rep == 0 { chash = (chash ^ (cv as u64)) *% 1099511628211 as u64 }
                i = i + 1
            }
            rep = rep + 1
        }
        let mn: u64 = rt.heap_alloc(NSEC * 8)
        var i2: usize = 0
        while i2 < NSEC {
            var lo: u64 = rt.ld64(tm, i2)
            var r2: usize = 1
            while r2 < reps {
                let v: u64 = rt.ld64(tm, r2 * NSEC + i2)
                if v < lo { lo = v }
                r2 = r2 + 1
            }
            rt.st64(mn, i2, lo)
            i2 = i2 + 1
        }
        mc_perf.perf_sort(mn, NSEC)
        mc_perf.perf_emit("cull_conn", mc_perf.perf_percentile(mn, NSEC, 5000 as u64), "us/section p50")
        mc_perf.perf_emit("cull_conn", mc_perf.perf_mean(mn, NSEC), "us/section mean")
        mc_perf.perf_emit_u("cull_conn", chash, "hash")
    }
    return 0
}
