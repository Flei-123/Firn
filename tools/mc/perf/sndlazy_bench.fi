import std.rt
import std.io
import std.fs
import std.env
import std.time
import audio.engine
import audio.bank
import mc.mc_audio
import mc.mc_assets
import mc.mc_packs
import mc.mc_packsnd
import mc.mc_lazysnd
import mc.mc_vanilla
import mc.mc_vanilla_snd
import jobs.jobs

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    return 0
}

fn parse_uint(s: str) -> u64 {
    var v: u64 = 0 as u64
    var i: usize = 0
    while i < s.length() {
        v = v * 10 as u64 + (rt.ld8(s.p as u64, i) - 48 as u8) as u64
        i = i + 1
    }
    return v
}

fn ms_since(t0: u64) -> u64 {
    return (time.monotonic_ns() - t0) / 1000000 as u64
}

#[allow_escape]
fn main(start: u64) -> i32 {
    let args: [str; 6] = [env.get("SB_SYNTH"), env.get("SB_ASSETS"), env.get("SB_INDEX"), env.get("SB_MODE"), env.get("SB_EAGER_MS"), env.get("SB_CACHE")]
    let eager_ms: u64 = parse_uint(args[4])
    let workers: u64 = parse_uint(env.get("SB_THREADS"))
    let sync_bytes: u64 = parse_uint(env.get("SB_SYNC_BYTES"))
    var pool: jobs.Jobs = jobs.Jobs { blk: 0 }
    if workers > 0 as u64 { pool = jobs.create(workers) }
    let lazy: bool = args[3].length() == 4
    var kept: i32 = 0
    let t_cache: u64 = time.monotonic_ns()
    let rc: i32 = mc_vanilla_snd.vsnd_build_cache(args[1], args[2], args[5], 15, &kept)
    io.fmt_print(f"cache rc={rc} kept={kept} ms={ms_since(t_cache)}\n")
    var stack: mc_assets.PackStack = mc_assets.stack_new()
    var pk: mc_assets.Pack = mc_assets.pack_empty()
    mc_assets.pack_open_file(&pk, args[5])
    mc_assets.stack_push(&stack, &pk)
    var e: engine.Engine = engine.engine_new(48000 as u32, 64 as u32)
    var b: bank.Bank = bank.bank_new()
    var m: mc_audio.McAudio = mc_audio.mca_new(&e)
    if lazy { mc_audio.mca_set_lazy_sounds(&m, true, eager_ms, 0) }
    if lazy && pool.blk != 0 { mc_audio.mca_set_lazy_pool(&m, ((&pool) as *mut jobs.Jobs) as u64, sync_bytes as usize) }
    if args[0].length() > 0 {
        let t_syn: u64 = time.monotonic_ns()
        let r: i32 = mc_audio.mca_bank_load_file(&m, &b, args[0])
        io.fmt_print(f"synth bank rc={r} ms={ms_since(t_syn)} samples={engine.engine_sample_count(&e)} events={engine.engine_event_count(&e)}\n")
    }
    let t0: u64 = time.monotonic_ns()
    let n: i32 = mc_packsnd.packsnd_apply(&m, &b, &e, &stack, mc_packs.SOUNDS_BOTH)
    let ms: u64 = ms_since(t0)
    let lz: *mut mc_lazysnd.Lazy = mc_audio.mca_lazy(&m)
    io.fmt_print(f"apply lazy={lazy} ms={ms} events_made={n} samples={engine.engine_sample_count(&e)} events_total={engine.engine_event_count(&e)} pending={mc_lazysnd.lazy_pending(lz)}\n")
    let names: [str; 8] = ["block.stone.step", "block.grass.break", "ui.button.click", "entity.zombie.ambient", "entity.cow.hurt", "ambient.cave", "block.note_block.harp", "entity.generic.explode"]
    var k: usize = 0
    while k < 8 {
        var worst: u64 = 0 as u64
        var total: u64 = 0 as u64
        var worst_poll: u64 = 0 as u64
        var r: i32 = 0
        while r < 16 {
            let t1: u64 = time.monotonic_ns()
            mc_audio.mca_play_ui(&m, names[k], 1.0, 1.0)
            let us: u64 = (time.monotonic_ns() - t1) / 1000 as u64
            total = total + us
            if us > worst { worst = us }
            var spins: i32 = 0
            while mc_lazysnd.lazy_inflight(lz) > 0 && spins < 4000 {
                let t2: u64 = time.monotonic_ns()
                mc_lazysnd.lazy_poll(lz)
                let pus: u64 = (time.monotonic_ns() - t2) / 1000 as u64
                if pus > worst_poll { worst_poll = pus }
                time.sleep_ms(1 as u64)
                spins = spins + 1
            }
            r = r + 1
        }
        io.fmt_print(f"play {names[k]} 16x total_us={total} worst_us={worst} worst_poll_us={worst_poll}\n")
        k = k + 1
    }
    if env.get("SB_EVICT").length() > 0 {
        let t3: u64 = time.monotonic_ns()
        let ev: usize = mc_lazysnd.lazy_evict(lz, 200)
        io.fmt_print(f"evict 200 -> {ev} in us={(time.monotonic_ns() - t3) / 1000 as u64}\n")
    }
    io.fmt_print(f"after plays: samples={engine.engine_sample_count(&e)} pending={mc_lazysnd.lazy_pending(lz)} decoded={(*lz).decoded} failed={(*lz).failed} full={(*lz).full} async_jobs={(*lz).async_jobs} async_done={(*lz).async_done} evicted={(*lz).evicted}\n")
    mc_audio.mca_set_lazy_pool(&m, 0 as u64, 0)
    if pool.blk != 0 { jobs.destroy(&pool) }
    return 0
}
