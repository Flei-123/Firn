import std.rt
import std.io
import std.time
import mc.mc_chunk
import mc.mc_world
import mc.mc_mesh
import mc.mc_camera
import mc.mc_texture
import mc.mc_raster
import mc.mc_backend
import mc.mc_cull
import mc.mc_terrain
import mc.mc_render_world
import mc.mc_stream
import mc.mc_perf
import mc.mc_perf_run
import mc.mc_prof
import jobs.jobs

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND {
        return jobs.worker_main(arg)
    }
    return 0
}

const NSEC: i32 = 6
static mut g_rad: i32 = 3

fn check(c: bool, code: i32) {
    if !c {
        io.fmt_eprint_line(f"stream_bench check failed {code as u64}")
        rt.finish(code as i64)
    }
}

fn floor_div16(v: i32) -> i32 {
    var q: i32 = v / 16
    if v % 16 != 0 && v < 0 { q = q - 1 }
    return q
}

fn fl(v: f64) -> i32 {
    var x: i32 = v as i32
    if (x as f64) > v { x = x - 1 }
    return x
}

#[allow_escape]
fn load_column(w: *mut mc_world.World, s: *mut mc_stream.Stream, cx: i32, cz: i32, ids: u64) {
    mc_terrain.terrain_column(cx, cz, NSEC, ids)
    check(mc_world.world_put(w, mc_render_world.wr_make_chunk(cx, cz, NSEC as usize, ids)), 50)
    check(mc_stream.stream_chunk_loaded(s, w, cx, cz), 51)
}

#[allow_escape]
fn load_all(w: *mut mc_world.World, s: *mut mc_stream.Stream, ids: u64) {
    var cz: i32 = 0 - g_rad
    while cz <= g_rad {
        var cx: i32 = 0 - g_rad
        while cx <= g_rad {
            load_column(w, s, cx, cz, ids)
            cx = cx + 1
        }
        cz = cz + 1
    }
}

static mut g_seed: u64 = 777

fn rnd_f(lo: f64, hi: f64) -> f64 {
    g_seed = g_seed *% 6364136223846793005 as u64 +% 1442695040888963407 as u64
    return lo + (hi - lo) * (((g_seed >> 33 as u64) % 100000 as u64) as f64 / 100000.0)
}

fn pose(cam: *mut mc_camera.Camera, i: i32) {
    var px: f64 = rnd_f(0.0 - 30.0, 30.0)
    var pz: f64 = rnd_f(0.0 - 30.0, 30.0)
    var py: f64 = (mc_terrain.terrain_height(fl(px), fl(pz), NSEC) + 3) as f64
    if i % 2 == 1 { py = rnd_f(6.0, 30.0) }
    var guard: i32 = 0
    while mc_terrain.terrain_block(fl(px), fl(py), fl(pz), NSEC) != 0 as u16 && guard < 80 {
        py = py + 1.0
        guard = guard + 1
    }
    mc_camera.camera_set_pos(cam, px, py, pz)
    mc_camera.camera_set_angles(cam, rnd_f(0.0 - 180.0, 180.0), rnd_f(0.0 - 25.0, 25.0))
    mc_camera.camera_update(cam)
}

fn fresh_raster(a: *mut mc_texture.Atlas) -> mc_raster.Raster {
    var r: mc_raster.Raster = mc_raster.raster_new(96, 54)
    mc_raster.backend_upload_atlas(&r, a)
    return r
}

#[allow_escape]
fn one_frame(s: *mut mc_stream.Stream, w: *mut mc_world.World, b: *mut mc_backend.Backend, cam: *mut mc_camera.Camera) {
    (*b).begin((*b).obj, cam as u64, 0xFF3C2814 as u32)
    mc_stream.stream_frame(s, w, b, cam)
    (*b).end((*b).obj)
}

fn stub_draw(o: u64, h: usize, ox: f64, oy: f64, oz: f64) -> u64 { return 100 as u64 }

#[allow_escape]
fn main() -> i32 {
    let workers: i32 = mc_perf_run.perf_env_int("DB_WORKERS", 3)
    let reps: i32 = mc_perf_run.perf_env_int("DB_REPS", 7)
    let nframes: i32 = mc_perf_run.perf_env_int("DB_FRAMES", 400)
    g_rad = mc_perf_run.perf_env_int("DB_RAD", 8)
    var win: i32 = g_rad * 2 + 2
    let view_env: i32 = mc_perf_run.perf_env_int("DB_VIEW", 0)
    if view_env > 0 { win = view_env }
    let lod_env: i32 = mc_perf_run.perf_env_int("DB_LOD", 0)
    let dirty_per_frame: i32 = mc_perf_run.perf_env_int("DB_DIRTY", 0)
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_terrain.terrain_tables(&tb)
    var a: mc_texture.Atlas = mc_texture.atlas_default()
    var cam: mc_camera.Camera = mc_camera.camera_new(640, 360)
    mc_camera.camera_set_lens(&cam, 70.0, 0.05, 400.0)
    let ids: u64 = rt.heap_alloc(NSEC as usize * 4096 * 2)
    var pool: jobs.Jobs = jobs.create(workers as u64)
    var r: mc_raster.Raster = fresh_raster(&a)
    var b: mc_backend.Backend = mc_backend.backend_cpu(&r)
    var w: mc_world.World = mc_world.world_new()
    var s: mc_stream.Stream = mc_stream.stream_new(0, NSEC, win, &tb, (&pool) as *mut jobs.Jobs as u64)
    s.nbr_wait = 3 as u32
    if lod_env > win { s.lod_dist = lod_env }
    s.cull.graph_mode = mc_perf_run.perf_env_int("DB_GRAPH", 1) != 0
    load_all(&w, &s, ids)
    mc_camera.camera_set_pos(&cam, 0.0, (mc_terrain.terrain_height(0, 0, NSEC) + 3) as f64, 0.0)
    mc_camera.camera_set_angles(&cam, 0.0, 0.0)
    mc_camera.camera_update(&cam)
    var guard: i32 = 0
    while guard < 4000 {
        one_frame(&s, &w, &b, &cam)
        guard = guard + 1
        if mc_stream.stream_pending(&s) == 0 && s.inflight == 0 && guard > 8 { break }
    }
    var prof: mc_prof.Prof = mc_prof.prof_new(mc_perf_run.perf_env_int("DB_PROF", 0) != 0)
    mc_prof.prof_attach(&prof)
    var vis: u64 = 0
    var drawn: u64 = 0
    var bc: u64 = 1000000000 as u64
    var bd: u64 = 1000000000 as u64
    var bt: u64 = 1000000000 as u64
    b.draw = stub_draw
    var rep: i32 = 0
    while rep < reps {
        var sc: u64 = 0
        var sd: u64 = 0
        var f: i32 = 0
        let t0: u64 = time.monotonic_ns()
        while f < nframes {
            mc_camera.camera_set_angles(&cam, (f % 360) as f64 * 1.0 + 0.37 * (rep as f64), -5.0)
            mc_camera.camera_update(&cam)
            var dj: i32 = 0
            while dj < dirty_per_frame {
                mc_stream.stream_mark_section(&s, floor_div16(fl(rnd_f(0.0 - 40.0, 40.0))), (rep + f + dj) % NSEC, floor_div16(fl(rnd_f(0.0 - 40.0, 40.0))))
                dj = dj + 1
            }
            (b.begin)(b.obj, (&cam) as *mut mc_camera.Camera as u64, 0xFF3C2814 as u32)
            mc_stream.stream_frame(&s, &w, &b, &cam)
            (b.end)(b.obj)
            sc = sc + s.st.cull_us
            sd = sd + s.st.draw_us
            vis = s.st.visible as u64
            drawn = s.st.drawn as u64
            mc_prof.prof_next(&prof)
            f = f + 1
        }
        let tt: u64 = (time.monotonic_ns() - t0) / 1000 as u64
        let mc: u64 = sc * 1000 as u64 / (nframes as u64)
        let md: u64 = sd * 1000 as u64 / (nframes as u64)
        let mt: u64 = tt * 1000 as u64 / (nframes as u64)
        if mc < bc { bc = mc }
        if md < bd { bd = md }
        if mt < bt { bt = mt }
        rep = rep + 1
    }
    mc_perf.perf_emit("graph_n", (s.cull.gn as u64) * 1000 as u64, "sections")
    mc_perf.perf_emit("visible", vis * 1000 as u64, "sections")
    mc_perf.perf_emit("drawn", drawn * 1000 as u64, "sections")
    mc_perf.perf_emit("cull_us_min", bc, "us per frame")
    mc_perf.perf_emit("draw_us_min", bd, "us per frame")
    mc_perf.perf_emit("submit_us_last", s.st.submit_us * 1000 as u64, "us per frame")
    mc_perf.perf_emit("pending_last", (mc_stream.stream_pending(&s) as u64) * 1000 as u64, "sections")
    mc_perf.perf_emit("frame_us_min", bt, "us per frame")
    mc_prof.prof_report(&prof)
    mc_stream.stream_free(&s, &b)
    mc_world.world_free(&w)
    jobs.destroy(&pool)
    return 0
}
