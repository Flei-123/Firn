// tools/mc/perf/bench_vk.fi -- benchmark entry, Vulkan back end (mc.vk_mc); twin of bench_gl.fi. See lib/mc/mc_perf_run.fi, docs/MC-PERF.md.
//   bench_vk <world.mcw> <radius-chunks> [frames] [warm]      bench --stats <file>
import std.rt
import std.io
import mc.mc_raster
import mc.mc_backend
import mc.mc_perf
import mc.mc_perf_run
import mc.vk_mc

fn c_is(p: u64, lit: str) -> bool {
    if rt.c_length(p) != lit.n {
        return false
    }
    var k: usize = 0
    while k < lit.n {
        if rt.ld8(p, k) != lit.chars(k) {
            return false
        }
        k = k + 1
    }
    return true
}

fn main(start: u64) -> i32 {
    let t0: u64 = mc_perf_run.perf_now_ns()
    if rt.arg_count(start) >= 3 && c_is(rt.arg_ptr(start, 1), "--stats") {
        return mc_perf_run.perf_stats_selftest(rt.arg_ptr(start, 2))
    }
    if rt.arg_count(start) < 3 {
        io.eprint_line("usage: bench_vk <world.mcw> <radius-chunks> [frames=100] [warm=10]   |   bench --stats <file>")
        return 2
    }
    let w: i32 = mc_perf_run.perf_env_int("BENCH_W", 640)
    let h: i32 = mc_perf_run.perf_env_int("BENCH_H", 360)
    // Vulkan back end (lib/mc/vk_mc.fi): vulkan-1.dll on Windows, libvulkan.so on Linux (lavapipe = CPU, no real GPU);
    // FIRN_VK_LIB replaces the loader name. The back end opens IN PLACE (no copies after open).
    var vb: vk_mc.VkBackend = vk_mc.vkbe_blank()
    if !vk_mc.vkbe_open_into(&vb, w, h, "") {
        io.eprint_line("bench_vk: cannot open Vulkan (no loader / no device / init failed)")
        mc_perf.perf_emit_text("backend", "vk-unavailable")
        return 3
    }
    if mc_perf_run.perf_env_int("BENCH_VK_READBACK", 1) == 0 {
        vk_mc.vkbe_set_readback(&vb, false)
    }
    var b: mc_backend.Backend = vk_mc.vkbe_backend(&vb)
    mc_perf.perf_emit_ctext("backend", vk_mc.vkbe_device_name(&vb))
    mc_perf.perf_emit_ctext("renderer", vk_mc.vkbe_device_name(&vb))
    if vk_mc.vkbe_is_cpu(&vb) {
        mc_perf.perf_emit_text("vk_device_type", "cpu (software Vulkan, NO real GPU)")
    } else {
        mc_perf.perf_emit_text("vk_device_type", "gpu")
    }
    return mc_perf_run.perf_run(start, &b, w, h, t0)
}
