import std.rt
import std.io
import mc.mc_perf_run

const P: usize = 18
const N: usize = 16
const NSEC: usize = 64
const GSIZE: usize = 5832

fn rng_next(s: *mut u32) -> u32 {
    let v: u64 = ((*s) as u64 * 1664525 as u64 + 1013904223 as u64) & 4294967295 as u64
    *s = v as u32
    return (v >> 8 as u64) as u32
}

fn fill(g: u64, sec: usize) {
    var s: u32 = (12345 + sec * 7919) as u32
    let h: u64 = rt.heap_alloc(P * P * 8)
    var i: usize = 0
    while i < P * P {
        rt.st64(h, i, (4 as u32 + rng_next(&s) % 9 as u32) as u64)
        i = i + 1
    }
    var pass: usize = 0
    while pass < 3 {
        var z: usize = 1
        while z < P - 1 {
            var x: usize = 1
            while x < P - 1 {
                let sum: u64 = rt.ld64(h, z * P + x) * 2 as u64 + rt.ld64(h, z * P + x - 1) + rt.ld64(h, z * P + x + 1) + rt.ld64(h, (z - 1) * P + x) + rt.ld64(h, (z + 1) * P + x)
                rt.st64(h, z * P + x, sum / 6 as u64)
                x = x + 1
            }
            z = z + 1
        }
        pass = pass + 1
    }
    var y: usize = 0
    while y < P {
        var z2: usize = 0
        while z2 < P {
            var x2: usize = 0
            while x2 < P {
                let r: u32 = rng_next(&s)
                var b: u8 = 0 as u8
                if (y as u64) <= rt.ld64(h, z2 * P + x2) { b = (1 as u32 + r % 3 as u32) as u8 }
                if b != 0 as u8 && (r & 16711680 as u32) < 524288 as u32 { b = 0 as u8 }
                rt.st8(g, sec * GSIZE + (y * P + z2) * P + x2, b)
                x2 = x2 + 1
            }
            z2 = z2 + 1
        }
        y = y + 1
    }
    rt.heap_free(h, P * P * 8)
}

fn ao_level(s1: u32, s2: u32, c: u32) -> u32 {
    if s1 != 0 as u32 && s2 != 0 as u32 { return 0 as u32 }
    return 3 as u32 - (s1 + s2 + c)
}

fn solid(g: u64, base: usize, q: *mut [usize; 3]) -> u32 {
    if rt.ld8(g, base + ((*q)[1] * P + (*q)[2]) * P + (*q)[0]) != 0 as u8 { return 1 as u32 }
    return 0 as u32
}

fn mesh(g: u64, base: usize, mask: u64) -> u64 {
    var hash: u64 = 2166136261 as u64
    var quads: u64 = 0 as u64
    var d: usize = 0
    while d < 6 {
        let ax: usize = d >> 1 as usize
        let u_ax: usize = (ax + 1) % 3
        let v_ax: usize = (ax + 2) % 3
        let neg: bool = (d & 1) == 1
        var slice: usize = 0
        while slice < N {
            var any: bool = false
            var v: usize = 0
            while v < N {
                var u: usize = 0
                while u < N {
                    var c: [usize; 3] = [0; 3]
                    c[ax] = slice + 1
                    c[u_ax] = u + 1
                    c[v_ax] = v + 1
                    let b: u8 = rt.ld8(g, base + (c[1] * P + c[2]) * P + c[0])
                    var m: u32 = 0 as u32
                    if b != 0 as u8 {
                        var n: [usize; 3] = [c[0], c[1], c[2]]
                        if neg { n[ax] = n[ax] - 1 } else { n[ax] = n[ax] + 1 }
                        if solid(g, base, &n) == 0 as u32 {
                            var sd: [u32; 8] = [0 as u32; 8]
                            var k: usize = 0
                            var dv: usize = 0
                            while dv < 3 {
                                var du: usize = 0
                                while du < 3 {
                                    if !(du == 1 && dv == 1) {
                                        var q: [usize; 3] = [n[0], n[1], n[2]]
                                        q[u_ax] = q[u_ax] + du - 1
                                        q[v_ax] = q[v_ax] + dv - 1
                                        sd[k] = solid(g, base, &q)
                                        k = k + 1
                                    }
                                    du = du + 1
                                }
                                dv = dv + 1
                            }
                            let a0: u32 = ao_level(sd[3], sd[1], sd[0])
                            let a1: u32 = ao_level(sd[4], sd[1], sd[2])
                            let a2: u32 = ao_level(sd[3], sd[6], sd[5])
                            let a3: u32 = ao_level(sd[4], sd[6], sd[7])
                            m = 1 as u32 | (b as u32 << 1 as u32) | (a0 << 3 as u32) | (a1 << 5 as u32) | (a2 << 7 as u32) | (a3 << 9 as u32)
                            any = true
                        }
                    }
                    rt.st16(mask, v * N + u, m as u16)
                    u = u + 1
                }
                v = v + 1
            }
            if any {
                var v2: usize = 0
                while v2 < N {
                    var u2: usize = 0
                    while u2 < N {
                        let m2: u16 = rt.ld16(mask, v2 * N + u2)
                        if m2 == 0 as u16 {
                            u2 = u2 + 1
                        } else {
                            var w: usize = 1
                            while u2 + w < N && rt.ld16(mask, v2 * N + u2 + w) == m2 { w = w + 1 }
                            var h: usize = 1
                            var ok: bool = true
                            while v2 + h < N && ok {
                                var k2: usize = 0
                                while k2 < w {
                                    if rt.ld16(mask, (v2 + h) * N + u2 + k2) != m2 {
                                        ok = false
                                        k2 = w
                                    } else {
                                        k2 = k2 + 1
                                    }
                                }
                                if ok { h = h + 1 }
                            }
                            var dv2: usize = 0
                            while dv2 < h {
                                var du2: usize = 0
                                while du2 < w {
                                    rt.st16(mask, (v2 + dv2) * N + u2 + du2, 0 as u16)
                                    du2 = du2 + 1
                                }
                                dv2 = dv2 + 1
                            }
                            quads = quads + 1 as u64
                            let key: u64 = ((m2 as u64) << 16 as u64) | ((u2 as u64) << 12 as u64) | ((v2 as u64) << 8 as u64) | ((w as u64) << 4 as u64) | (h as u64)
                            hash = ((hash ^ key) * 16777619 as u64) & 4294967295 as u64
                            hash = ((hash ^ ((d * 16 + slice) as u64)) * 16777619 as u64) & 4294967295 as u64
                            u2 = u2 + w
                        }
                    }
                    v2 = v2 + 1
                }
            }
            slice = slice + 1
        }
        d = d + 1
    }
    return hash ^ quads
}

fn main() -> i32 {
    var reps: usize = 200
    let g: u64 = rt.heap_alloc(NSEC * GSIZE)
    let mask: u64 = rt.heap_alloc(N * N * 2)
    var s: usize = 0
    while s < NSEC {
        fill(g, s)
        s = s + 1
    }
    var total: u64 = 0 as u64
    s = 0
    while s < NSEC {
        total = total ^ mesh(g, s * GSIZE, mask)
        s = s + 1
    }
    var best: u64 = 18446744073709551615 as u64
    var r: usize = 0
    while r < reps {
        let t0: u64 = mc_perf_run.perf_now_ns()
        var hh: u64 = 0 as u64
        var s2: usize = 0
        while s2 < NSEC {
            hh = hh ^ mesh(g, s2 * GSIZE, mask)
            s2 = s2 + 1
        }
        let dt: u64 = mc_perf_run.perf_now_ns() - t0
        if hh != total { return 1 }
        if dt < best { best = dt }
        r = r + 1
    }
    io.fmt_print(f"RESULT lang=firn hash={total} best_ns_per_section={best / NSEC as u64}\n")
    return 0
}
