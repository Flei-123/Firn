import std.rt
import std.io
import std.dynlib
import mc.mc_perf_run

fn main() -> i32 {
    let h: u64 = dynlib.open("libc.so.6")
    let f: u64 = dynlib.sym(h, "labs")
    var args: [u64; 16] = [0; 16]
    let reps: usize = 20000000
    var best: u64 = 18446744073709551615 as u64
    var sum: u64 = 0 as u64
    var r: usize = 0
    while r < 5 {
        let t0: u64 = mc_perf_run.perf_now_ns()
        var i: usize = 0
        while i < reps {
            args[0] = i as u64
            sum = sum + dynlib.callx(f, "i", (&args[0]) as u64, false)
            i = i + 1
        }
        let dt: u64 = mc_perf_run.perf_now_ns() - t0
        if dt < best { best = dt }
        r = r + 1
    }
    io.fmt_print(f"RESULT lang=firn callx_ns_x100={best * 100 as u64 / reps as u64} sum={sum}\n")
    return 0
}
