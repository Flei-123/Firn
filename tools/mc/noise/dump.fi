// tools/mc/noise/dump.fi -- prints reproducible values of every mc_noise function; the same lines
// are produced by ref.py (floats / integers) and Ref.java (java.util.Random) independently.
import std.rt
import std.io
import std.math
import mc.mc_noise

fn hexf(out: *mut rt.Buf, v: f64) {
    var x: f64 = v
    if v == 0.0 {
        x = 0.0 // -0.0 and 0.0 are the same number for this comparison
    }
    rt.buf_push_hex_u64(out, math.math_bits(x), 16)
}

fn line(out: *mut rt.Buf, f: io.Fmt) {
    var g: io.Fmt = f
    rt.buf_push_bytes(out, rt.buf_ptr(&g.b), rt.buf_len(&g.b))
    io.fmt_free(g)
}

fn now_ns() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000000 as u64 + (ts[1] as u64)
}

// `dump bench`: million samples per second of each function (printed as metric lines)
fn bench() {
    var pr: mc_noise.Perlin = mc_noise.perlin_reference()
    let n: i32 = 2000000
    var acc: f64 = 0.0
    var t0: u64 = now_ns()
    var i: i32 = 0
    while i < n {
        acc = acc + mc_noise.perlin3(&pr, i as f64 * 0.013, i as f64 * 0.007, 0.5)
        i = i + 1
    }
    var dt: u64 = now_ns() - t0
    io.fmt_print(f"metric perlin3_samples_per_s={(n as u64) * 1000000000 as u64 / dt}\n")
    t0 = now_ns()
    i = 0
    while i < n {
        acc = acc + mc_noise.simplex2(&pr, i as f64 * 0.013, i as f64 * 0.007)
        i = i + 1
    }
    dt = now_ns() - t0
    io.fmt_print(f"metric simplex2_samples_per_s={(n as u64) * 1000000000 as u64 / dt}\n")
    t0 = now_ns()
    i = 0
    while i < n {
        acc = acc + mc_noise.simplex3(&pr, i as f64 * 0.013, i as f64 * 0.007, 0.5)
        i = i + 1
    }
    dt = now_ns() - t0
    io.fmt_print(f"metric simplex3_samples_per_s={(n as u64) * 1000000000 as u64 / dt}\n")
    var j: mc_noise.JavaRandom = mc_noise.jrandom_new(1)
    var sink: i64 = 0
    t0 = now_ns()
    i = 0
    while i < n * 4 {
        sink = sink + mc_noise.jrandom_next_int(&j) as i64
        i = i + 1
    }
    dt = now_ns() - t0
    io.fmt_print(f"metric java_lcg_ints_per_s={((n * 4) as u64) * 1000000000 as u64 / dt}\n")
    var xo: mc_noise.Xoshiro = mc_noise.xoshiro_new(1)
    var xs: u64 = 0
    t0 = now_ns()
    i = 0
    while i < n * 4 {
        xs = xs ^ mc_noise.xoshiro_next(&xo)
        i = i + 1
    }
    dt = now_ns() - t0
    io.fmt_print(f"metric xoshiro_u64_per_s={((n * 4) as u64) * 1000000000 as u64 / dt}\n")
    if acc == 12345.678 && sink == 1 && xs == 1 as u64 {
        io.fmt_print(f"unreachable\n")
    }
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) > 1 {
        bench()
        return 0
    }
    var out: rt.Buf = rt.buf_new()
    // ---- splitmix64 / xoshiro256**
    var sm: mc_noise.SplitMix64 = mc_noise.splitmix_new(0 as u64)
    var i: i32 = 0
    while i < 5 {
        line(&out, f"sm0 ")
        rt.buf_push_hex_u64(&out, mc_noise.splitmix_next(&sm), 16)
        line(&out, f"\n")
        i = i + 1
    }
    var sm2: mc_noise.SplitMix64 = mc_noise.splitmix_new(1234567 as u64)
    i = 0
    while i < 5 {
        line(&out, f"sm1 ")
        rt.buf_push_hex_u64(&out, mc_noise.splitmix_next(&sm2), 16)
        line(&out, f"\n")
        i = i + 1
    }
    var xo: mc_noise.Xoshiro = mc_noise.xoshiro_new(42 as u64)
    i = 0
    while i < 8 {
        line(&out, f"xo ")
        rt.buf_push_hex_u64(&out, mc_noise.xoshiro_next(&xo), 16)
        line(&out, f"\n")
        i = i + 1
    }
    // ---- the Java generator
    var seeds: [i64; 5] = [0, 42, 0 - 1, 123456789012345, 9223372036854775807]
    var s: usize = 0
    while s < 5 {
        var j: mc_noise.JavaRandom = mc_noise.jrandom_new(seeds[s as usize])
        line(&out, f"jr {seeds[s as usize]}")
        i = 0
        while i < 6 {
            line(&out, f" {mc_noise.jrandom_next_int(&j)}")
            i = i + 1
        }
        let bounds: [i32; 8] = [1, 2, 10, 100, 256, 1000, 1073741824, 2147483647]
        i = 0
        while i < 8 {
            line(&out, f" b{bounds[i as usize]}:{mc_noise.jrandom_next_int_bound(&j, bounds[i as usize])}")
            i = i + 1
        }
        line(&out, f" L{mc_noise.jrandom_next_long(&j)}")
        line(&out, f" D")
        rt.buf_push_hex_u64(&out, math.math_bits(mc_noise.jrandom_next_double(&j)), 16)
        line(&out, f" B{mc_noise.jrandom_next_bool(&j)}\n")
        s = s + 1
    }
    // ---- improved noise, reference table
    var pr: mc_noise.Perlin = mc_noise.perlin_reference()
    line(&out, f"pr 3.14 42 7 ")
    hexf(&out, mc_noise.perlin3(&pr, 3.14, 42.0, 7.0))
    line(&out, f"\n")
    var k: i32 = 0
    while k < 12 {
        let x: f64 = k as f64 * 0.37 - 2.0
        let y: f64 = k as f64 * 0.53 + 0.11
        let z: f64 = 0.0 - k as f64 * 0.29
        line(&out, f"p3 {k} ")
        hexf(&out, mc_noise.perlin3(&pr, x, y, z))
        line(&out, f" ")
        hexf(&out, mc_noise.perlin2(&pr, x, y))
        line(&out, f" ")
        hexf(&out, mc_noise.simplex2(&pr, x, y))
        line(&out, f" ")
        hexf(&out, mc_noise.simplex3(&pr, x, y, z))
        line(&out, f"\n")
        k = k + 1
    }
    // ---- seeded permutation + octaves
    var ps: mc_noise.Perlin = mc_noise.perlin_seeded(12345)
    k = 0
    while k < 6 {
        let x: f64 = k as f64 * 1.7 + 0.3
        line(&out, f"ps {k} ")
        hexf(&out, mc_noise.perlin3(&ps, x, x * 0.5, 0.25))
        line(&out, f" ")
        hexf(&out, mc_noise.perlin_octaves3(&ps, x, x * 0.5, 0.25, 4, 2.0, 0.5))
        line(&out, f" ")
        hexf(&out, mc_noise.simplex_octaves2(&ps, x, x * 0.7, 5, 2.0, 0.5))
        line(&out, f"\n")
        k = k + 1
    }
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    rt.buf_free(&out)
    return 0
}
