// tools/mc/input/bench.fi -- cost of input_pick and player_tick in a loaded world (printed as us per call).
import std.rt
import std.io
import mc.mc_world
import mc.mc_render_world
import mc.mc_input

fn now_ns() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000000 as u64 + (ts[1] as u64)
}

fn main() -> i32 {
    var w: mc_world.World = mc_world.world_new()
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    i = 0
    while i < 4 * 256 {
        rt.st16(ids, i, 1 as u16)
        i = i + 1
    }
    var cx: i32 = 0 - 8
    while cx < 8 {
        var cz: i32 = 0 - 8
        while cz < 8 {
            mc_world.world_put(&w, mc_render_world.wr_make_chunk(cx, cz, 2, ids))
            cz = cz + 1
        }
        cx = cx + 1
    }
    var tb: mc_input.InputTables = mc_input.InputTables { pick: rt.heap_alloc(2), solid: rt.heap_alloc(2), n: 2 }
    rt.st8(tb.pick, 0, 0 as u8)
    rt.st8(tb.pick, 1, 1 as u8)
    rt.st8(tb.solid, 0, 0 as u8)
    rt.st8(tb.solid, 1, 1 as u8)
    var pk: mc_input.Pick = mc_input.Pick { x: 0, y: 0, z: 0, nx: 0, ny: 0, nz: 0, dist: 0.0, id: 0 }
    let t0: u64 = now_ns()
    var hits: i32 = 0
    var k: i32 = 0
    while k < 20000 {
        let a: f64 = (k % 100) as f64 * 0.01
        if mc_input.input_pick(&w, 0 - 64, &tb, 3.5, 0.0 - 58.0, 3.5, a - 0.5, 0.0 - 0.6, 0.3 + a, 6.0, &pk) { hits = hits + 1 }
        k = k + 1
    }
    let t1: u64 = now_ns()
    var p: mc_input.Player = mc_input.player_new(8.5, 0.0 - 60.0, 8.5)
    var ev: mc_input.InputEvents = mc_input.input_events_new()
    ev.keys = mc_input.K_FORWARD | mc_input.K_SPRINT
    k = 0
    while k < 20000 {
        ev.dx = 1.0
        mc_input.player_tick(&p, &ev, &w, &tb, 0 - 64)
        k = k + 1
    }
    let t2: u64 = now_ns()
    io.fmt_print(f"metric input_pick ns_per_call={(t1 - t0) / 20000 as u64} hits={hits}\n")
    io.fmt_print(f"metric player_tick ns_per_call={(t2 - t1) / 20000 as u64} (256 chunks loaded)\n")
    return 0
}
