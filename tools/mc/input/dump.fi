// tools/mc/input/dump.fi -- runs mc_input on scripted scenarios and writes scenes.txt (+ world blobs, framebuffers) for the
// independent python reference (ref.py): mouse look, movement physics (walk / sprint / sneak / jump / fall / fly / noclip,
// unloaded chunks), 600 random pick rays through a random world, selection box lines.
//   usage: dump <outdir>      (the directory exists)
import std.rt
import std.core
import mc.mc_math
import mc.mc_camera
import mc.mc_raster
import mc.mc_world
import mc.mc_render_world
import mc.mc_input

struct Ctx {
    out: rt.Buf,
    dir: u64,
    dirn: usize,
    seed: u64,
}

fn push_str(b: *mut rt.Buf, s: u64, n: usize) {
    var i: usize = 0
    while i < n {
        rt.buf_push(b, rt.ld8(s, i))
        i = i + 1
    }
}

fn push_lit(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn push_hex(b: *mut rt.Buf, v: u64) {
    rt.buf_push(b, 32 as u8)
    rt.buf_push_hex_u64(b, v, 1)
}

fn push_dec(b: *mut rt.Buf, v: u64) {
    rt.buf_push(b, 32 as u8)
    rt.buf_push_dec_u64(b, v)
}

fn push_f(b: *mut rt.Buf, x: f64) {
    push_hex(b, core.f64_bits(x))
}

fn push_i(b: *mut rt.Buf, v: i32) {
    push_dec(b, (v as i64 + 1000000 as i64) as u64)
}

fn lcg(c: *mut Ctx) -> u32 {
    (*c).seed = ((*c).seed * 1103515245 as u64 + 12345 as u64) & 0x7FFFFFFF as u64
    return ((*c).seed >> 8 as u64) as u32
}

fn rnd(c: *mut Ctx) -> f64 {
    return (lcg(c) as f64) / 8388608.0
}

fn path(c: *mut Ctx, name: str, ext: str) -> rt.Buf {
    var p: rt.Buf = rt.buf_new()
    push_str(&p, (*c).dir, (*c).dirn)
    rt.buf_push(&p, 47 as u8)
    rt.buf_push_bytes(&p, name.p as u64, name.n)
    rt.buf_push_bytes(&p, ext.p as u64, ext.n)
    rt.buf_push(&p, 0 as u8)
    return p
}

// blob: u16 [32 * 32 * 32], index (ly * 32 + z) * 32 + x, ly = y + 64
fn world_from_blob(blob: u64, w: *mut mc_world.World) {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var cx: i32 = 0
    while cx < 2 {
        var cz: i32 = 0
        while cz < 2 {
            var s: i32 = 0
            while s < 2 {
                var y: i32 = 0
                while y < 16 {
                    var z: i32 = 0
                    while z < 16 {
                        var x: i32 = 0
                        while x < 16 {
                            let v: u16 = rt.ld16(blob, (((s * 16 + y) * 32 + (cz * 16 + z)) * 32 + (cx * 16 + x)) as usize)
                            rt.st16(ids, (s * 4096 + (y * 16 + z) * 16 + x) as usize, v)
                            x = x + 1
                        }
                        z = z + 1
                    }
                    y = y + 1
                }
                s = s + 1
            }
            mc_world.world_put(w, mc_render_world.wr_make_chunk(cx, cz, 2, ids))
            cz = cz + 1
        }
        cx = cx + 1
    }
    rt.heap_free(ids, 2 * 4096 * 2)
}

fn write_blob(c: *mut Ctx, name: str, blob: u64) {
    var p: rt.Buf = path(c, name, ".bin")
    rt.write_file(rt.buf_ptr(&p), blob, 32 * 32 * 32 * 2)
    rt.buf_free(&p)
}

fn set_tables(t: *mut mc_input.InputTables) {
    (*t).n = 4
    (*t).pick = rt.heap_alloc(4)
    (*t).solid = rt.heap_alloc(8)
    var i: usize = 0
    while i < 4 {
        rt.st8((*t).pick, i, 0 as u8)
        rt.st16((*t).solid, i, 0 as u16)
        i = i + 1
    }
    rt.st8((*t).pick, 1, 1 as u8)
    rt.st8((*t).pick, 2, 1 as u8)
    rt.st16((*t).solid, 1, 1 as u16)
}

fn blob_set(blob: u64, x: i32, ly: i32, z: i32, v: u16) {
    rt.st16(blob, ((ly * 32 + z) * 32 + x) as usize, v)
}

// ---- look
fn look_scene(c: *mut Ctx, sens: f64) {
    let b: *mut rt.Buf = &(*c).out
    var p: mc_input.Player = mc_input.player_new(0.0, 0.0, 0.0)
    p.sens = sens
    push_lit(b, "look")
    push_f(b, sens)
    rt.buf_push(b, 10 as u8)
    var i: i32 = 0
    while i < 12 {
        let dx: f64 = (rnd(c) - 0.5) * 900.0
        let dy: f64 = (rnd(c) - 0.5) * 300.0
        mc_input.player_look(&p, dx, dy)
        push_lit(b, "l")
        push_f(b, dx)
        push_f(b, dy)
        push_f(b, p.yaw)
        push_f(b, p.pitch)
        rt.buf_push(b, 10 as u8)
        i = i + 1
    }
    mc_input.player_free(&p)
}

// ---- physics: n ticks, input per tick from a small script
fn phys(c: *mut Ctx, name: str, w: *mut mc_world.World, tb: *mut mc_input.InputTables, sx: f64, sy: f64, sz: f64, yaw: f64, n: i32, mode: i32) {
    let b: *mut rt.Buf = &(*c).out
    var p: mc_input.Player = mc_input.player_new(sx, sy, sz)
    p.yaw = yaw
    push_lit(b, "phys ")
    rt.buf_push_bytes(b, name.p as u64, name.n)
    push_f(b, sx)
    push_f(b, sy)
    push_f(b, sz)
    push_f(b, yaw)
    push_dec(b, n as u64)
    rt.buf_push(b, 10 as u8)
    var t: i32 = 0
    while t < n {
        var ev: mc_input.InputEvents = mc_input.input_events_new()
        if mode == 1 { ev.keys = mc_input.K_FORWARD } // walk into the wall
        if mode == 2 { // sprint jump
            ev.keys = mc_input.K_FORWARD | mc_input.K_SPRINT
            if t == 0 { ev.keys = ev.keys | mc_input.K_JUMP }
        }
        if mode == 3 { ev.keys = 0 as u32 } // fall
        if mode == 4 { // fly + noclip, turn, sprint, up / sideways, then back
            if t == 0 {
                ev.toggle_fly = true
                ev.toggle_noclip = true
                ev.dx = 100.0
                ev.dy = 40.0
            }
            if t < 20 { ev.keys = mc_input.K_FORWARD | mc_input.K_SPRINT | mc_input.K_JUMP | mc_input.K_RIGHT }
            else { ev.keys = mc_input.K_LEFT | mc_input.K_SNEAK | mc_input.K_BACK }
        }
        if mode == 5 { ev.keys = mc_input.K_FORWARD } // towards an unloaded chunk
        if mode == 6 { // sneak diagonal + hotbar
            ev.keys = mc_input.K_FORWARD | mc_input.K_RIGHT | mc_input.K_SNEAK
            if t == 0 { ev.slot_delta = -1 }
            if t == 5 { ev.slot_delta = 11 }
        }
        if mode == 7 { // flying with collisions: into the wall, then down
            if t == 0 { ev.toggle_fly = true }
            if t < 25 { ev.keys = mc_input.K_FORWARD | mc_input.K_SPRINT } else { ev.keys = mc_input.K_SNEAK }
        }
        var fl: u64 = 0
        if ev.toggle_fly { fl = 1 }
        var nc: u64 = 0
        if ev.toggle_noclip { nc = 1 }
        mc_input.player_tick(&p, &ev, w, tb, 0 - 64)
        push_lit(b, "t")
        push_f(b, ev.dx)
        push_f(b, ev.dy)
        push_dec(b, ev.keys as u64)
        push_dec(b, fl)
        push_dec(b, nc)
        push_i(b, ev.slot_delta)
        push_f(b, p.x)
        push_f(b, p.y)
        push_f(b, p.z)
        push_f(b, p.yaw)
        push_f(b, p.pitch)
        var g: u64 = 0
        if p.on_ground { g = 1 }
        push_dec(b, g)
        push_i(b, p.slot)
        rt.buf_push(b, 10 as u8)
        t = t + 1
    }
    mc_input.player_free(&p)
}

// ---- box lines
fn box_scene(c: *mut Ctx, name: str, px: f64, py: f64, pz: f64, yaw: f64, pitch: f64, bx: i32, by: i32, bz: i32, occlude: bool) {
    let b: *mut rt.Buf = &(*c).out
    var cam: mc_camera.Camera = mc_camera.camera_new(160, 120)
    mc_camera.camera_set_pos(&cam, px, py, pz)
    mc_camera.camera_set_angles(&cam, yaw, pitch)
    mc_camera.camera_set_lens(&cam, 70.0, 0.05, 512.0)
    mc_camera.camera_update(&cam)
    var r: mc_raster.Raster = mc_raster.raster_new(160, 120)
    mc_raster.raster_set_camera(&r, &cam)
    mc_raster.raster_clear(&r, 0xFF303030 as u32)
    if occlude {
        // left half of the screen has geometry at depth 4 (1/z = 0.25)
        var y: i32 = 0
        while y < 120 {
            var x: i32 = 0
            while x < 80 {
                *((r.depth + (((y * 160 + x) as u64) * (8 as u64))) as *mut f64) = 0.25
                x = x + 1
            }
            y = y + 1
        }
    }
    mc_input.input_draw_box(&r, bx, by, bz, 0xFF000000 as u32)
    mc_input.input_draw_box(&r, bx + 2, by, bz + 1, 0xFFFFFFFF as u32)
    push_lit(b, "box ")
    rt.buf_push_bytes(b, name.p as u64, name.n)
    push_dec(b, 160 as u64)
    push_dec(b, 120 as u64)
    var oc: u64 = 0
    if occlude { oc = 1 }
    push_dec(b, oc)
    push_i(b, bx)
    push_i(b, by)
    push_i(b, bz)
    rt.buf_push(b, 10 as u8)
    push_lit(b, "cam")
    push_f(b, cam.x)
    push_f(b, cam.y)
    push_f(b, cam.z)
    push_f(b, cam.rx)
    push_f(b, cam.ry)
    push_f(b, cam.rz)
    push_f(b, cam.ux)
    push_f(b, cam.uy)
    push_f(b, cam.uz)
    push_f(b, cam.fx)
    push_f(b, cam.fy)
    push_f(b, cam.fz)
    push_f(b, cam.near)
    push_f(b, cam.tan_x)
    push_f(b, cam.tan_y)
    rt.buf_push(b, 10 as u8)
    let hx: u64 = rt.heap_alloc(64)
    mc_raster.raster_hash_hex(&r, hx)
    push_lit(b, "hash ")
    push_str(b, hx, 64)
    rt.buf_push(b, 10 as u8)
    rt.heap_free(hx, 64)
    var p1: rt.Buf = path(c, name, ".rgba")
    rt.write_file(rt.buf_ptr(&p1), r.color, 160 * 120 * 4)
    rt.buf_free(&p1)
    var p2: rt.Buf = path(c, name, ".png")
    mc_raster.raster_write_png(&r, rt.buf_ptr(&p2))
    rt.buf_free(&p2)
    mc_raster.raster_free(&r)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 { return 2 }
    var c: Ctx = Ctx { out: rt.buf_new(), dir: rt.arg_ptr(start, 1), dirn: 0, seed: 12345 as u64 }
    while rt.ld8(c.dir, c.dirn) != 0 as u8 { c.dirn = c.dirn + 1 }
    var tb: mc_input.InputTables = mc_input.InputTables { pick: 0, solid: 0, n: 0 }
    set_tables(&tb)
    look_scene(&c, 0.5)
    look_scene(&c, 0.0)
    look_scene(&c, 1.0)
    // ---- world A (physics): floor y = -64..-61 (top at -60), a wall at z = 12 (x 8..19, y -60..-58)
    let blob: u64 = rt.heap_alloc(32 * 32 * 32 * 2)
    var i: usize = 0
    while i < 32 * 32 * 32 {
        rt.st16(blob, i, 0 as u16)
        i = i + 1
    }
    var x: i32 = 0
    while x < 32 {
        var z: i32 = 0
        while z < 32 {
            var ly: i32 = 0
            while ly < 4 {
                blob_set(blob, x, ly, z, 1 as u16)
                ly = ly + 1
            }
            z = z + 1
        }
        x = x + 1
    }
    x = 8
    while x < 20 {
        var ly: i32 = 4
        while ly < 7 {
            blob_set(blob, x, ly, 12, 1 as u16)
            ly = ly + 1
        }
        x = x + 1
    }
    write_blob(&c, "worldA", blob)
    var wa: mc_world.World = mc_world.world_new()
    world_from_blob(blob, &wa)
    let nb: *mut rt.Buf = &c.out
    push_lit(nb, "tables 4\n")
    phys(&c, "walk_wall", &wa, &tb, 14.5, -60.0, 8.5, 0.0, 60, 1)
    phys(&c, "sprint_jump", &wa, &tb, 14.5, -60.0, 1.5, 0.0, 30, 2)
    phys(&c, "fall", &wa, &tb, 5.5, -45.0, 5.5, 0.0, 40, 3)
    phys(&c, "fly_noclip", &wa, &tb, 16.0, -50.0, 16.0, 0.0, 30, 4)
    phys(&c, "unloaded", &wa, &tb, 3.5, -60.0, 16.5, 90.0, 40, 5)
    phys(&c, "sneak_diag", &wa, &tb, 14.5, -60.0, 3.5, 45.0, 25, 6)
    phys(&c, "fly_collide", &wa, &tb, 14.5, -58.5, 6.5, 0.0, 45, 7)
    mc_world.world_free(&wa)
    // ---- world B (random blocks): 80 % air, 10 % solid, 5 % plant (pick, not solid), 5 % other (neither)
    i = 0
    while i < 32 * 32 * 32 {
        let r: u32 = lcg(&c) % 100 as u32
        var v: u16 = 0 as u16
        if r >= 80 as u32 { v = 1 as u16 }
        if r >= 90 as u32 { v = 2 as u16 }
        if r >= 95 as u32 { v = 3 as u16 }
        rt.st16(blob, i, v)
        i = i + 1
    }
    write_blob(&c, "worldB", blob)
    var wb: mc_world.World = mc_world.world_new()
    world_from_blob(blob, &wb)
    push_lit(nb, "picks\n")
    var k: i32 = 0
    while k < 600 {
        let ox: f64 = rnd(&c) * 34.0 - 1.0
        let oy: f64 = rnd(&c) * 34.0 - 65.0
        let oz: f64 = rnd(&c) * 34.0 - 1.0
        var dx: f64 = rnd(&c) * 2.0 - 1.0
        var dy: f64 = rnd(&c) * 2.0 - 1.0
        var dz: f64 = rnd(&c) * 2.0 - 1.0
        if k % 7 == 0 { dx = 0.0 } // axis parallel rays
        if k % 11 == 0 { dz = 0.0 }
        if k % 13 == 0 { dy = 0.0 }
        if dx == 0.0 && dy == 0.0 && dz == 0.0 { dy = 1.0 }
        var reach: f64 = 5.0
        if k % 2 == 1 { reach = 6.0 }
        var pk: mc_input.Pick = mc_input.Pick { x: 0, y: 0, z: 0, nx: 0, ny: 0, nz: 0, dist: 0.0, id: 0 }
        let hit: bool = mc_input.input_pick(&wb, 0 - 64, &tb, ox, oy, oz, dx, dy, dz, reach, &pk)
        push_lit(nb, "ray")
        push_f(nb, ox)
        push_f(nb, oy)
        push_f(nb, oz)
        push_f(nb, dx)
        push_f(nb, dy)
        push_f(nb, dz)
        push_f(nb, reach)
        var h: u64 = 0
        if hit { h = 1 }
        push_dec(nb, h)
        if hit {
            push_i(nb, pk.x)
            push_i(nb, pk.y)
            push_i(nb, pk.z)
            push_i(nb, pk.nx)
            push_i(nb, pk.ny)
            push_i(nb, pk.nz)
            push_f(nb, pk.dist)
            push_i(nb, pk.id)
        }
        rt.buf_push(nb, 10 as u8)
        k = k + 1
    }
    mc_world.world_free(&wb)
    // ---- selection box lines
    box_scene(&c, "box_front", 5.5, 3.0, 0.0, 0.0, 10.0, 4, 1, 6, false)
    box_scene(&c, "box_inside", 4.4, 1.5, 6.3, 20.0, 0.0, 4, 1, 6, false)
    box_scene(&c, "box_occluded", 5.5, 3.0, 0.0, 0.0, 10.0, 4, 1, 6, true)
    box_scene(&c, "box_far_side", 0.0, 2.0, 0.0, 0.0 - 60.0, 8.0, 10, 0, 2, false)
    var p1: rt.Buf = path(&c, "scenes", ".txt")
    rt.write_file(rt.buf_ptr(&p1), rt.buf_ptr(&c.out), rt.buf_len(&c.out))
    return 0
}
