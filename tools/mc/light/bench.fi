// tools/mc/light/bench.fi -- mc_light speed: full recompute and single-cell edits on a 64^3 volume
// (heightfield terrain, a few torches, caves). Prints metric lines.
import std.rt
import std.io
import mc.mc_light

static mut RNG: u64 = 88172645463325252

fn rnd() -> u32 {
    var x: u64 = RNG
    x = x ^ (x << 13 as u64)
    x = x ^ (x >> 7 as u64)
    x = x ^ (x << 17 as u64)
    RNG = x
    return ((x >> 20 as u64) & 0x7FFFFFFF as u64) as u32
}

fn now_ns() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000000 as u64 + (ts[1] as u64)
}

fn main() -> i32 {
    let n: i32 = 64
    var v: mc_light.LightVol = mc_light.light_new(n, n, n)
    var x: i32 = 0
    while x < n {
        var z: i32 = 0
        while z < n {
            let h: i32 = 20 + ((rnd() % 12) as i32)
            var y: i32 = 0
            while y < n {
                var op: u8 = 0 as u8
                var em: u8 = 0 as u8
                if y < h { op = 15 as u8 }
                if y < h - 2 && rnd() % 10 == 0 { op = 0 as u8 }
                if y == h && rnd() % 200 == 0 { em = 14 as u8 }
                mc_light.light_set_raw(&v, x, y, z, op, em)
                y = y + 1
            }
            z = z + 1
        }
        x = x + 1
    }
    let t0: u64 = now_ns()
    mc_light.light_full(&v)
    let t1: u64 = now_ns()
    io.fmt_print(f"metric full_64cube cells=262144 ms={(t1 - t0) / 1000000 as u64}\n")
    // single edits near the surface: break / place a block
    let edits: u32 = 2000 as u32
    let t2: u64 = now_ns()
    var i: u32 = 0 as u32
    while i < edits {
        let px: i32 = (rnd() % 64) as i32
        let pz: i32 = (rnd() % 64) as i32
        let py: i32 = 14 + ((rnd() % 22) as i32)
        var op: u8 = 0 as u8
        if i % 2 as u32 == 0 as u32 { op = 15 as u8 }
        mc_light.light_set_block(&v, px, py, pz, op, 0 as u8)
        i = i + 1 as u32
    }
    let t3: u64 = now_ns()
    io.fmt_print(f"metric edit_surface edits=2000 us_per_edit={(t3 - t2) / 1000 as u64 / 2000 as u64} cells_written_per_edit={mc_light.light_counters(&v) / 2000 as u64}\n")
    // torches: place + remove
    let t4: u64 = now_ns()
    i = 0 as u32
    while i < 500 as u32 {
        let px: i32 = (rnd() % 64) as i32
        let pz: i32 = (rnd() % 64) as i32
        let py: i32 = 36 + ((rnd() % 20) as i32)
        mc_light.light_set_block(&v, px, py, pz, 0 as u8, 14 as u8)
        mc_light.light_set_block(&v, px, py, pz, 0 as u8, 0 as u8)
        i = i + 1 as u32
    }
    let t5: u64 = now_ns()
    io.fmt_print(f"metric torch_place_remove pairs=500 us_per_pair={(t5 - t4) / 1000 as u64 / 500 as u64}\n")
    mc_light.light_free(&v)
    return 0
}
