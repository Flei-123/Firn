// tools/mc/sky/dump.fi -- renders the mc_sky test scenes and writes scenes.txt (camera basis as f64 bit
// patterns, ticks, rain, the Firn sky state, the image hash) and <scene>.rgba for the python reference (ref.py).
//   usage: dump <outdir>      (the directory exists)
import std.rt
import std.core
import mc.mc_camera
import mc.mc_raster
import mc.mc_sky

struct Ctx {
    out: rt.Buf,
    dir: u64,
    dirn: usize,
    r: mc_raster.Raster,
    cam: mc_camera.Camera,
    sky: mc_sky.Sky,
}

fn push_str(b: *mut rt.Buf, s: u64, n: usize) {
    var i: usize = 0
    while i < n {
        rt.buf_push(b, rt.ld8(s, i))
        i = i + 1
    }
}

fn push_lit(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn push_hex(b: *mut rt.Buf, v: u64) {
    rt.buf_push(b, 32 as u8)
    rt.buf_push_hex_u64(b, v, 1)
}

fn push_dec(b: *mut rt.Buf, v: u64) {
    rt.buf_push(b, 32 as u8)
    rt.buf_push_dec_u64(b, v)
}

fn push_f(b: *mut rt.Buf, x: f64) {
    push_hex(b, core.f64_bits(x))
}

fn push_i(b: *mut rt.Buf, v: i32) {
    push_dec(b, (v as i64 + 1000000 as i64) as u64)
}

fn scene(c: *mut Ctx, name: str, ticks: i64, rain: i32, yaw: f64, pitch: f64, tint: bool) {
    mc_camera.camera_set_pos(&(*c).cam, 0.0, 0.0, 0.0)
    mc_camera.camera_set_angles(&(*c).cam, yaw, pitch)
    mc_camera.camera_set_lens(&(*c).cam, 70.0, 0.05, 512.0)
    mc_camera.camera_update(&(*c).cam)
    mc_raster.raster_set_camera(&(*c).r, &(*c).cam)
    mc_raster.raster_clear(&(*c).r, 0xFF000000 as u32)
    mc_sky.sky_set_time(&(*c).sky, ticks, rain)
    mc_sky.sky_draw(&(*c).sky, &(*c).r)
    let w: i32 = (*c).r.w
    let h: i32 = (*c).r.h
    if tint {
        // fake geometry: every third pixel (x + y) has a depth entry
        var y: i32 = 0
        while y < h {
            var x: i32 = 0
            while x < w {
                if (x + y) % 3 == 0 {
                    *(((*c).r.depth + (((y as usize) * (w as usize) + (x as usize)) as u64) * (8 as u64)) as *mut f64) = 0.5
                }
                x = x + 1
            }
            y = y + 1
        }
        mc_sky.sky_tint_frame(&(*c).sky, &(*c).r)
    }
    let b: *mut rt.Buf = &(*c).out
    push_lit(b, "scene ")
    rt.buf_push_bytes(b, name.p as u64, name.n)
    push_dec(b, w as u64)
    push_dec(b, h as u64)
    push_i(b, ticks as i32)
    push_i(b, rain)
    var tt: u64 = 0
    if tint { tt = 1 }
    push_dec(b, tt)
    rt.buf_push(b, 10 as u8)
    push_lit(b, "cam")
    push_f(b, (*c).cam.rx)
    push_f(b, (*c).cam.ry)
    push_f(b, (*c).cam.rz)
    push_f(b, (*c).cam.ux)
    push_f(b, (*c).cam.uy)
    push_f(b, (*c).cam.uz)
    push_f(b, (*c).cam.fx)
    push_f(b, (*c).cam.fy)
    push_f(b, (*c).cam.fz)
    push_f(b, (*c).cam.tan_x)
    push_f(b, (*c).cam.tan_y)
    rt.buf_push(b, 10 as u8)
    let s: *mut mc_sky.Sky = &(*c).sky
    push_lit(b, "sky")
    push_i(b, (*s).time as i32)
    push_i(b, (*s).rain)
    push_i(b, (*s).daylight)
    push_i(b, (*s).glow)
    var dd: u64 = 0
    if (*s).discs { dd = 1 }
    push_dec(b, dd)
    push_f(b, (*s).sunx)
    push_f(b, (*s).suny)
    push_f(b, (*s).sunz)
    push_i(b, (*s).zr)
    push_i(b, (*s).zg)
    push_i(b, (*s).zb)
    push_i(b, (*s).hr)
    push_i(b, (*s).hg)
    push_i(b, (*s).hb)
    push_i(b, (*s).fr)
    push_i(b, (*s).fg)
    push_i(b, (*s).fb)
    push_i(b, (*s).tr)
    push_i(b, (*s).tg)
    push_i(b, (*s).tb)
    rt.buf_push(b, 10 as u8)
    let hx: u64 = rt.heap_alloc(64)
    mc_raster.raster_hash_hex(&(*c).r, hx)
    push_lit(b, "hash ")
    push_str(b, hx, 64)
    rt.buf_push(b, 10 as u8)
    rt.heap_free(hx, 64)
    var path: rt.Buf = rt.buf_new()
    push_str(&path, (*c).dir, (*c).dirn)
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    push_lit(&path, ".rgba")
    rt.buf_push(&path, 0 as u8)
    rt.write_file(rt.buf_ptr(&path), (*c).r.color, (w as usize) * (h as usize) * 4)
    rt.buf_free(&path)
    var p2: rt.Buf = rt.buf_new()
    push_str(&p2, (*c).dir, (*c).dirn)
    rt.buf_push(&p2, 47 as u8)
    rt.buf_push_bytes(&p2, name.p as u64, name.n)
    push_lit(&p2, ".png")
    rt.buf_push(&p2, 0 as u8)
    mc_raster.raster_write_png(&(*c).r, rt.buf_ptr(&p2))
    rt.buf_free(&p2)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 { return 2 }
    var c: Ctx = Ctx {
        out: rt.buf_new(), dir: rt.arg_ptr(start, 1), dirn: 0,
        r: mc_raster.raster_new(160, 90), cam: mc_camera.camera_new(160, 90), sky: mc_sky.sky_new(),
    }
    while rt.ld8(c.dir, c.dirn) != 0 as u8 { c.dirn = c.dirn + 1 }
    scene(&c, "noon_up", 6000 as i64, 0, 0.0, -64.0, false)
    scene(&c, "sunrise_east", 0 as i64, 0, -90.0, 0.0, false)
    scene(&c, "sunset_west", 12000 as i64, 0, 90.0, 0.0, false)
    scene(&c, "sunset_glow", 11500 as i64, 0, 60.0, 5.0, false)
    scene(&c, "midnight_moon", 18000 as i64, 0, 0.0, -60.0, false)
    scene(&c, "rain_light", 6000 as i64, 100, 0.0, -64.0, false)
    scene(&c, "rain_heavy", 6000 as i64, 200, 0.0, -30.0, false)
    scene(&c, "look_down", 6000 as i64, 0, 45.0, 60.0, false)
    scene(&c, "wrap_neg", 0 as i64 - 3000 as i64, 0, 120.0, 10.0, false)
    scene(&c, "wrap_big", 72000 as i64 + 9500 as i64, 0, 200.0, -20.0, false)
    scene(&c, "dusk_tint", 12900 as i64, 30, 90.0, 0.0, true)
    scene(&c, "day_tint", 9000 as i64, 0, 0.0, -10.0, true)
    var p1: rt.Buf = rt.buf_new()
    push_str(&p1, c.dir, c.dirn)
    push_lit(&p1, "/scenes.txt")
    rt.buf_push(&p1, 0 as u8)
    rt.write_file(rt.buf_ptr(&p1), rt.buf_ptr(&c.out), rt.buf_len(&c.out))
    return 0
}
