// tools/mc/sky/bench.fi -- time of the sky background pass at 640x360 (printed as ms per frame).
import std.rt
import std.io
import mc.mc_camera
import mc.mc_raster
import mc.mc_sky

fn now_ns() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000000 as u64 + (ts[1] as u64)
}

fn bench(name: str, ticks: i64, yaw: f64, pitch: f64) {
    var cam: mc_camera.Camera = mc_camera.camera_new(640, 360)
    var r: mc_raster.Raster = mc_raster.raster_new(640, 360)
    var s: mc_sky.Sky = mc_sky.sky_new()
    mc_camera.camera_set_angles(&cam, yaw, pitch)
    mc_camera.camera_update(&cam)
    mc_raster.raster_set_camera(&r, &cam)
    mc_sky.sky_set_time(&s, ticks, 0)
    mc_sky.sky_draw(&s, &r)
    let t0: u64 = now_ns()
    var i: i32 = 0
    while i < 10 {
        mc_sky.sky_draw(&s, &r)
        i = i + 1
    }
    io.fmt_print(f"metric sky_draw_640x360_{name} us_per_frame={(now_ns() - t0) / 10000 as u64}\n")
}

// sunset with glow (worst case: the sun direction is evaluated for half the pixels), noon and midnight (no glow)
fn main() -> i32 {
    bench("sunset", 11800 as i64, 20.0, -10.0)
    bench("noon", 6000 as i64, 20.0, 10.0)
    bench("night", 18000 as i64, 20.0, 10.0)
    return 0
}
