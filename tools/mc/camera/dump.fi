// tools/mc/camera/dump.fi -- writes random cameras + probes AND the results of lib/mc/mc_camera.fi
// as text; tools/mc/camera/check.py recomputes everything independently (numpy).
// Floats are printed as the 16 hex digits of their IEEE bits (exact).
//
//   usage: dump <seed> <cases>

import std.rt
import std.math
import std.io
import mc.mc_math
import mc.mc_camera

struct Gen { x: u64 }

fn next(g: *mut Gen) -> u64 {
    (*g).x = (*g).x *% 6364136223846793005 as u64 +% 1442695040888963407 as u64
    var z: u64 = (*g).x
    z = (z ^ (z >> 29)) *% 0xBF58476D1CE4E5B9 as u64
    z = (z ^ (z >> 32))
    return z
}

fn rf(g: *mut Gen, lo: f64, hi: f64) -> f64 {
    let u: f64 = ((next(g) >> 11) as f64) / 9007199254740992.0
    return lo + (hi - lo) * u
}

fn ri(g: *mut Gen, n: u64) -> u64 { return next(g) % n }

fn pf(o: *mut rt.Buf, x: f64) {
    rt.buf_push_hex_u64(o, math.math_bits(x), 16)
    rt.buf_push(o, 32 as u8)
}

fn pi(o: *mut rt.Buf, v: i64) {
    rt.buf_push_dec_i64(o, v)
    rt.buf_push(o, 32 as u8)
}

fn tag(o: *mut rt.Buf, c: u8) {
    rt.buf_push(o, c)
    rt.buf_push(o, 32 as u8)
}

fn nl(o: *mut rt.Buf) { rt.buf_push(o, 10 as u8) }

fn pm(o: *mut rt.Buf, m: *mut mc_math.Mat4) {
    var i: usize = 0
    while i < 16 {
        pf(o, (*m).m[i])
        i = i + 1
    }
}

fn camera_case(g: *mut Gen, o: *mut rt.Buf) {
    let w: i32 = (16 + ri(g, 1900)) as i32
    let h: i32 = (16 + ri(g, 1100)) as i32
    var c: mc_camera.Camera = mc_camera.camera_new(w, h)
    c.zero_to_one = ri(g, 4) == 0
    let px: f64 = rf(g, -3.0e6, 3.0e6)
    let py: f64 = rf(g, -64.0, 320.0)
    let pz: f64 = rf(g, -3.0e6, 3.0e6)
    mc_camera.camera_set_pos(&c, px, py, pz)
    // yaw / pitch are fed unreduced / unclamped on purpose (wrap + clamp are part of the contract)
    mc_camera.camera_set_angles(&c, rf(g, -900.0, 900.0), rf(g, -100.0, 100.0))
    let near: f64 = rf(g, 0.02, 0.5)
    mc_camera.camera_set_lens(&c, rf(g, 20.0, 130.0), near, rf(g, 64.0, 1024.0))
    mc_camera.camera_update(&c)
    tag(o, 67 as u8) // 'C'
    pf(o, c.x)
    pf(o, c.y)
    pf(o, c.z)
    pf(o, c.yaw)
    pf(o, c.pitch)
    pf(o, c.fov)
    pf(o, c.near)
    pf(o, c.far)
    pi(o, c.width as i64)
    pi(o, c.height as i64)
    if c.zero_to_one { pi(o, 1) } else { pi(o, 0) }
    pf(o, c.fx)
    pf(o, c.fy)
    pf(o, c.fz)
    pf(o, c.rx)
    pf(o, c.ry)
    pf(o, c.rz)
    pf(o, c.ux)
    pf(o, c.uy)
    pf(o, c.uz)
    pm(o, &c.view)
    pm(o, &c.proj)
    pm(o, &c.inv_vp)
    var k: usize = 0
    while k < 24 {
        pf(o, c.frustum.p[k])
        k = k + 1
    }
    nl(o)
    // pick rays
    var j: u64 = 0
    while j < 4 {
        let qx: f64 = rf(g, 0.0, w as f64)
        let qy: f64 = rf(g, 0.0, h as f64)
        var org: mc_math.Vec3 = mc_math.v3(0.0, 0.0, 0.0)
        var dir: mc_math.Vec3 = mc_math.v3(0.0, 0.0, 0.0)
        mc_camera.camera_pick_ray(&c, qx, qy, &org, &dir)
        tag(o, 82 as u8) // 'R'
        pf(o, qx)
        pf(o, qy)
        pf(o, org.x)
        pf(o, org.y)
        pf(o, org.z)
        pf(o, dir.x)
        pf(o, dir.y)
        pf(o, dir.z)
        nl(o)
        j = j + 1
    }
    // projections (world points around the camera, some behind it)
    j = 0
    while j < 8 {
        let wx: f64 = c.x + rf(g, -80.0, 80.0)
        let wy: f64 = c.y + rf(g, -80.0, 80.0)
        let wz: f64 = c.z + rf(g, -80.0, 80.0)
        var out: mc_math.Vec3 = mc_math.v3(0.0, 0.0, 0.0)
        let ok: bool = mc_camera.camera_project(&c, wx, wy, wz, &out)
        tag(o, 80 as u8) // 'P'
        pf(o, wx)
        pf(o, wy)
        pf(o, wz)
        if ok { pi(o, 1) } else { pi(o, 0) }
        pf(o, out.x)
        pf(o, out.y)
        pf(o, out.z)
        nl(o)
        j = j + 1
    }
    // boxes
    j = 0
    while j < 24 {
        let bx: f64 = c.x + rf(g, -60.0, 60.0)
        let by: f64 = c.y + rf(g, -60.0, 60.0)
        let bz: f64 = c.z + rf(g, -60.0, 60.0)
        let sx: f64 = rf(g, 0.1, 16.0)
        let sy: f64 = rf(g, 0.1, 16.0)
        let sz: f64 = rf(g, 0.1, 16.0)
        let res: i32 = mc_camera.camera_box_visible(&c, bx, by, bz, bx + sx, by + sy, bz + sz)
        tag(o, 66 as u8) // 'B'
        pf(o, bx)
        pf(o, by)
        pf(o, bz)
        pf(o, bx + sx)
        pf(o, by + sy)
        pf(o, bz + sz)
        pi(o, res as i64)
        nl(o)
        j = j + 1
    }
    // 16^3 sections around the camera
    j = 0
    while j < 24 {
        let ccx: i32 = mc_math.floor_i(c.x / 16.0) + (ri(g, 13) as i32) - 6
        let ccz: i32 = mc_math.floor_i(c.z / 16.0) + (ri(g, 13) as i32) - 6
        let sy: i32 = (ri(g, 24)) as i32
        let res: i32 = mc_camera.camera_section_visible(&c, ccx, sy, ccz, -64)
        tag(o, 83 as u8) // 'S'
        pi(o, ccx as i64)
        pi(o, sy as i64)
        pi(o, ccz as i64)
        pi(o, -64)
        pi(o, res as i64)
        nl(o)
        j = j + 1
    }
}

fn arg_u64(start: u64, i: usize) -> u64 {
    let p: u64 = rt.arg_ptr(start, i)
    var v: u64 = 0
    var k: usize = 0
    while rt.ld8(p, k) != 0 as u8 {
        v = v * 10 as u64 + ((rt.ld8(p, k) - 48 as u8) as u64)
        k = k + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    var seed: u64 = 1
    var n: u64 = 20
    if rt.arg_count(start) > 1 { seed = arg_u64(start, 1) }
    if rt.arg_count(start) > 2 { n = arg_u64(start, 2) }
    var g: Gen = Gen { x: seed *% 0x9E3779B97F4A7C15 as u64 }
    var o: rt.Buf = rt.buf_new()
    var k: u64 = 0
    while k < n {
        camera_case(&g, &o)
        k = k + 1
    }
    io.print_bytes(rt.buf_ptr(&o), rt.buf_len(&o))
    rt.buf_free(&o)
    return 0
}
