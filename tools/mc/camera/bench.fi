// tools/mc/camera/bench.fi -- speed of the camera hot paths (prints `metric ...` lines).
import std.rt
import std.io
import mc.mc_math
import mc.mc_camera

fn now_ns() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000000 as u64 + (ts[1] as u64)
}

fn main(start: u64) -> i32 {
    var c: mc_camera.Camera = mc_camera.camera_new(1280, 720)
    mc_camera.camera_set_pos(&c, 100.5, 80.0, -40.5)
    mc_camera.camera_set_angles(&c, 33.0, 12.0)
    // update: basis + 4 matrices + inverse + frustum
    let t0: u64 = now_ns()
    var k: i32 = 0
    while k < 20000 {
        mc_camera.camera_set_angles(&c, 33.0 + (k % 360) as f64 * 0.5, 12.0)
        mc_camera.camera_update(&c)
        k = k + 1
    }
    let t1: u64 = now_ns()
    // frustum test of all sections in a 16-chunk radius, 24 sections high
    var vis: i64 = 0
    var n: i64 = 0
    var r: i32 = 0
    while r < 200 {
        var cx: i32 = 6 - 16
        while cx <= 6 + 16 {
            var cz: i32 = -3 - 16
            while cz <= -3 + 16 {
                var sy: i32 = 0
                while sy < 24 {
                    if mc_camera.camera_section_visible(&c, cx, sy, cz, -64) != 0 { vis = vis + 1 }
                    n = n + 1
                    sy = sy + 1
                }
                cz = cz + 1
            }
            cx = cx + 1
        }
        r = r + 1
    }
    let t2: u64 = now_ns()
    var p: mc_math.Vec3 = mc_math.v3(0.0, 0.0, 0.0)
    var o: mc_math.Vec3 = mc_math.v3(0.0, 0.0, 0.0)
    var acc: i64 = 0
    k = 0
    while k < 1000000 {
        mc_camera.camera_project(&c, 100.0 + (k % 50) as f64, 80.0, 20.0, &p)
        mc_camera.camera_pick_ray(&c, (k % 1280) as f64, 360.0, &o, &p)
        acc = acc + 1
        k = k + 1
    }
    let t3: u64 = now_ns()
    io.fmt_print(f"metric camera_update_per_s={20000 * 1000000000 as u64 / (t1 - t0)}\n")
    io.fmt_print(f"metric section_tests_per_s={(n as u64) * 1000000000 as u64 / (t2 - t1)} visible_share_pct={vis * 100 / n}\n")
    io.fmt_print(f"metric project_plus_ray_per_s={1000000 * 1000000000 as u64 / (t3 - t2)}\n")
    return 0
}
