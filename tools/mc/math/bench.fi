// tools/mc/math/bench.fi -- throughput of the hot paths of mc_math (single thread).
// usage: bench   (prints "name: value unit" lines; build with the default stage)

import std.rt
import std.math
import std.io
import std.time
import mc.mc_math

fn lcg(x: u64) -> u64 {
    return x *% 6364136223846793005 as u64 +% 1442695040888963407 as u64
}

fn unit(x: u64) -> f64 {
    return ((x >> 11) as f64) / 9007199254740992.0
}

fn main(start: u64) -> i32 {
    // 32^3 world, 20 % solid
    let nx: i32 = 32
    let ids: u64 = rt.heap_alloc(32768 * 2)
    let solid: u64 = rt.heap_alloc(8)
    rt.st16(solid, 1, 1 as u16)
    var x: u64 = 12345
    var i: usize = 0
    while i < 32768 {
        x = lcg(x)
        if (x >> 33) % 5 == 0 { rt.st16(ids, i, 1 as u16) }
        i = i + 1
    }
    var g: mc_math.BlockGrid = mc_math.grid_view(0, 0, 0, nx, nx, nx, ids, solid, 2 as u32, false)
    var hit: mc_math.RayHit = mc_math.RayHit { x: 0, y: 0, z: 0, nx: 0, ny: 0, nz: 0, dist: 0.0, id: 0 }
    // ---- raycasts, reach 6 blocks, starting inside the box
    var n: u64 = 0
    var hits: u64 = 0
    var t0: u64 = time.monotonic_ns()
    while n < 1000000 {
        x = lcg(x)
        let ox: f64 = 8.0 + unit(x) * 16.0
        x = lcg(x)
        let oy: f64 = 8.0 + unit(x) * 16.0
        x = lcg(x)
        let oz: f64 = 8.0 + unit(x) * 16.0
        x = lcg(x)
        let dx: f64 = unit(x) - 0.5
        x = lcg(x)
        let dy: f64 = unit(x) - 0.5
        x = lcg(x)
        let dz: f64 = unit(x) - 0.5
        if mc_math.grid_raycast(&g, ox, oy, oz, dx, dy, dz, 6.0, &hit) { hits = hits + 1 }
        n = n + 1
    }
    var dt: u64 = time.monotonic_ns() - t0
    io.fmt_print(f"raycast reach 6: {n * 1000000000 / dt} rays/s ({hits} hits of {n})\n")
    // ---- sweeps of a player box
    var pl: mc_math.Aabb = mc_math.aabb_new(10.0, 10.0, 10.0, 10.6, 11.8, 10.6)
    var mr: mc_math.MoveResult = mc_math.MoveResult { dx: 0.0, dy: 0.0, dz: 0.0, hit_x: false, hit_y: false, hit_z: false }
    n = 0
    t0 = time.monotonic_ns()
    while n < 300000 {
        x = lcg(x)
        let mx: f64 = unit(x) - 0.5
        x = lcg(x)
        let mz: f64 = unit(x) - 0.5
        mc_math.grid_move(&g, &pl, mx, -0.3, mz, &mr)
        n = n + 1
    }
    dt = time.monotonic_ns() - t0
    io.fmt_print(f"sweep player box: {n * 1000000000 / dt} moves/s\n")
    // ---- frustum
    var proj: mc_math.Mat4 = mc_math.Mat4 { m: [0.0; 16] }
    var view: mc_math.Mat4 = mc_math.Mat4 { m: [0.0; 16] }
    var vp: mc_math.Mat4 = mc_math.Mat4 { m: [0.0; 16] }
    mc_math.mat4_perspective(&proj, 1.2, 1.7, 0.1, 500.0, false)
    mc_math.mat4_look_at(&view, 0.0, 70.0, 0.0, 10.0, 60.0, 10.0, 0.0, 1.0, 0.0)
    mc_math.mat4_mul(&vp, &proj, &view)
    var fr: mc_math.Frustum = mc_math.Frustum { p: [0.0; 24] }
    mc_math.frustum_from_matrix(&fr, &vp, false)
    n = 0
    var vis: u64 = 0
    t0 = time.monotonic_ns()
    while n < 5000000 {
        x = lcg(x)
        let cx: i32 = ((x >> 40) % 64) as i32 - 32
        let cz: i32 = ((x >> 20) % 64) as i32 - 32
        let sy: i32 = ((x >> 8) % 24) as i32
        if mc_math.frustum_test_section(&fr, cx, sy, cz, -64) != 0 { vis = vis + 1 }
        n = n + 1
    }
    dt = time.monotonic_ns() - t0
    io.fmt_print(f"frustum section test: {n * 1000000000 / dt} tests/s ({vis} visible of {n})\n")
    // ---- matrix multiply + invert
    n = 0
    var inv: mc_math.Mat4 = mc_math.Mat4 { m: [0.0; 16] }
    t0 = time.monotonic_ns()
    while n < 300000 {
        mc_math.mat4_mul(&vp, &proj, &view)
        mc_math.mat4_invert(&inv, &vp)
        n = n + 1
    }
    dt = time.monotonic_ns() - t0
    io.fmt_print(f"mat4 mul + invert: {n * 1000000000 / dt} pairs/s\n")
    return 0
}
