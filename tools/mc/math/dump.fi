// tools/mc/math/dump.fi -- writes random test cases AND the results of lib/mc/mc_math.fi
// as text; tools/mc/math/check.py recomputes/validates every line independently
// (numpy matrices, brute force over all cells, sampling).
//
// All floats are printed as the 16 hex digits of their IEEE bits (exact).
//
//   usage: dump <seed> <cases-per-kind>

import std.rt
import std.math
import std.io
import mc.mc_math

struct Gen { x: u64 }

fn next(g: *mut Gen) -> u64 {
    (*g).x = (*g).x *% 6364136223846793005 as u64 +% 1442695040888963407 as u64
    var z: u64 = (*g).x
    z = (z ^ (z >> 29)) *% 0xBF58476D1CE4E5B9 as u64
    z = (z ^ (z >> 32))
    return z
}

fn rf(g: *mut Gen, lo: f64, hi: f64) -> f64 {
    let u: f64 = ((next(g) >> 11) as f64) / 9007199254740992.0
    return lo + (hi - lo) * u
}

fn ri(g: *mut Gen, n: u64) -> u64 { return next(g) % n }

fn pf(o: *mut rt.Buf, x: f64) {
    rt.buf_push_hex_u64(o, math.math_bits(x), 16)
    rt.buf_push(o, 32 as u8)
}

fn pi(o: *mut rt.Buf, v: i64) {
    rt.buf_push_dec_i64(o, v)
    rt.buf_push(o, 32 as u8)
}

fn tag(o: *mut rt.Buf, c: u8) {
    rt.buf_push(o, c)
    rt.buf_push(o, 32 as u8)
}

fn nl(o: *mut rt.Buf) { rt.buf_push(o, 10 as u8) }

fn pm(o: *mut rt.Buf, m: *mut mc_math.Mat4) {
    var i: usize = 0
    while i < 16 {
        pf(o, (*m).m[i])
        i = i + 1
    }
}

// ------------------------------------------------------------ matrices
fn matrix_cases(g: *mut Gen, o: *mut rt.Buf, n: u64) {
    var k: u64 = 0
    while k < n {
        var a: mc_math.Mat4 = mc_math.Mat4 { m: [0.0; 16] }
        var b: mc_math.Mat4 = mc_math.Mat4 { m: [0.0; 16] }
        var i: usize = 0
        while i < 16 {
            a.m[i] = rf(g, -2.0, 2.0)
            b.m[i] = rf(g, -2.0, 2.0)
            i = i + 1
        }
        var kind: u64 = k % 4
        if kind == 1 {
            // singular: column 3 = 2 * column 1
            i = 0
            while i < 4 {
                a.m[12 + i] = 2.0 * a.m[4 + i]
                i = i + 1
            }
        }
        var prod: mc_math.Mat4 = mc_math.Mat4 { m: [0.0; 16] }
        mc_math.mat4_mul(&prod, &a, &b)
        tag(o, 77 as u8) // 'M'
        pm(o, &a)
        pm(o, &b)
        pm(o, &prod)
        nl(o)
        var inv: mc_math.Mat4 = mc_math.Mat4 { m: [0.0; 16] }
        let ok: bool = mc_math.mat4_invert(&inv, &a)
        tag(o, 73 as u8) // 'I'
        pm(o, &a)
        if ok { pi(o, 1) } else { pi(o, 0) }
        pm(o, &inv)
        nl(o)
        var tr: mc_math.Mat4 = mc_math.Mat4 { m: [0.0; 16] }
        mc_math.mat4_transpose(&tr, &a)
        tag(o, 84 as u8) // 'T'
        pm(o, &a)
        pm(o, &tr)
        nl(o)
        k = k + 1
    }
}

// ------------------------------------------------------------ frustum
fn frustum_cases(g: *mut Gen, o: *mut rt.Buf, n: u64) {
    var k: u64 = 0
    while k < n {
        let zo: bool = k % 2 == 1
        let fovy: f64 = rf(g, 0.3, 2.4)
        let aspect: f64 = rf(g, 0.5, 2.5)
        let near: f64 = rf(g, 0.05, 2.0)
        let far: f64 = rf(g, 20.0, 300.0)
        let ex: f64 = rf(g, -50.0, 50.0)
        let ey: f64 = rf(g, -50.0, 50.0)
        let ez: f64 = rf(g, -50.0, 50.0)
        let cx: f64 = ex + rf(g, -10.0, 10.0)
        let cy: f64 = ey + rf(g, -10.0, 10.0)
        let cz: f64 = ez + rf(g, -10.0, 10.0)
        let ux: f64 = rf(g, -0.2, 0.2)
        let uz: f64 = rf(g, -0.2, 0.2)
        var proj: mc_math.Mat4 = mc_math.Mat4 { m: [0.0; 16] }
        var view: mc_math.Mat4 = mc_math.Mat4 { m: [0.0; 16] }
        var vp: mc_math.Mat4 = mc_math.Mat4 { m: [0.0; 16] }
        mc_math.mat4_perspective(&proj, fovy, aspect, near, far, zo)
        mc_math.mat4_look_at(&view, ex, ey, ez, cx, cy, cz, ux, 1.0, uz)
        mc_math.mat4_mul(&vp, &proj, &view)
        var fr: mc_math.Frustum = mc_math.Frustum { p: [0.0; 24] }
        mc_math.frustum_from_matrix(&fr, &vp, zo)
        tag(o, 80 as u8) // 'P'
        if zo { pi(o, 1) } else { pi(o, 0) }
        pf(o, fovy)
        pf(o, aspect)
        pf(o, near)
        pf(o, far)
        pf(o, ex)
        pf(o, ey)
        pf(o, ez)
        pf(o, cx)
        pf(o, cy)
        pf(o, cz)
        pf(o, ux)
        pf(o, 1.0)
        pf(o, uz)
        pm(o, &proj)
        pm(o, &view)
        pm(o, &vp)
        var q: usize = 0
        while q < 24 {
            pf(o, fr.p[q])
            q = q + 1
        }
        nl(o)
        // boxes around the camera, mixed sizes (small ones near the view volume)
        var j: u64 = 0
        while j < 60 {
            let bx: f64 = ex + rf(g, -120.0, 120.0)
            let by: f64 = ey + rf(g, -120.0, 120.0)
            let bz: f64 = ez + rf(g, -120.0, 120.0)
            var sx: f64 = rf(g, 0.01, 20.0)
            var sy: f64 = rf(g, 0.01, 20.0)
            var sz: f64 = rf(g, 0.01, 20.0)
            if j % 3 == 0 {
                sx = 16.0
                sy = 16.0
                sz = 16.0
            }
            let r: i32 = mc_math.frustum_test_box(&fr, bx, by, bz, bx + sx, by + sy, bz + sz)
            tag(o, 66 as u8) // 'B'
            pf(o, bx)
            pf(o, by)
            pf(o, bz)
            pf(o, bx + sx)
            pf(o, by + sy)
            pf(o, bz + sz)
            pi(o, r as i64)
            nl(o)
            j = j + 1
        }
        j = 0
        while j < 60 {
            let sx: f64 = ex + rf(g, -120.0, 120.0)
            let sy: f64 = ey + rf(g, -120.0, 120.0)
            let sz: f64 = ez + rf(g, -120.0, 120.0)
            let rad: f64 = rf(g, 0.1, 25.0)
            let r: i32 = mc_math.frustum_test_sphere(&fr, sx, sy, sz, rad)
            tag(o, 83 as u8) // 'S'
            pf(o, sx)
            pf(o, sy)
            pf(o, sz)
            pf(o, rad)
            pi(o, r as i64)
            nl(o)
            j = j + 1
        }
        k = k + 1
    }
}

// ------------------------------------------------------------ worlds
// A random world: ids 0..3, solid table [0, 1, 0, 1] or random; density varies.
struct World {
    ox: i32, oy: i32, oz: i32, nx: i32, ny: i32, nz: i32,
    ids: u64, solid: u64,
}

fn world_make(g: *mut Gen, o: *mut rt.Buf, w: *mut World, kind: u64) {
    (*w).ox = (ri(g, 41) as i32) - 20
    (*w).oy = (ri(g, 41) as i32) - 20
    (*w).oz = (ri(g, 41) as i32) - 20
    (*w).nx = 4 + (ri(g, 13) as i32)
    (*w).ny = 4 + (ri(g, 13) as i32)
    (*w).nz = 4 + (ri(g, 13) as i32)
    let n: usize = ((*w).nx * (*w).ny * (*w).nz) as usize
    (*w).ids = rt.heap_alloc(n * 2)
    (*w).solid = rt.heap_alloc(8)
    // table: id 1 and 3 solid, id 2 passable-but-nonzero, id 0 air; sometimes id 2 solid
    rt.st16((*w).solid, 1, 1 as u16)
    rt.st16((*w).solid, 3, 1 as u16)
    if ri(g, 4) == 0 { rt.st16((*w).solid, 2, 1 as u16) }
    let dens: u64 = 4 + ri(g, 50) // percent of non-air
    tag(o, 87 as u8) // 'W'
    pi(o, (*w).ox as i64)
    pi(o, (*w).oy as i64)
    pi(o, (*w).oz as i64)
    pi(o, (*w).nx as i64)
    pi(o, (*w).ny as i64)
    pi(o, (*w).nz as i64)
    pi(o, rt.ld16((*w).solid, 1) as i64)
    pi(o, rt.ld16((*w).solid, 2) as i64)
    pi(o, rt.ld16((*w).solid, 3) as i64)
    nl(o)
    var i: usize = 0
    while i < n {
        var v: u16 = 0 as u16
        if kind == 0 {
            if ri(g, 100) < dens { v = (1 + ri(g, 3)) as u16 }
        } else {
            // flat floor plus a few pillars
            let y: i32 = ((i / (((*w).nz * (*w).nx) as usize)) as i32)
            if y == 0 { v = 1 as u16 }
            if ri(g, 100) < 3 { v = (1 + ri(g, 3)) as u16 }
        }
        rt.st16((*w).ids, i, v)
        rt.buf_push(o, (48 + v) as u8)
        i = i + 1
    }
    nl(o)
}

fn world_free(w: *mut World) {
    let n: usize = ((*w).nx * (*w).ny * (*w).nz) as usize
    rt.heap_free((*w).ids, n * 2)
    rt.heap_free((*w).solid, 8)
}

fn ray_cases(g: *mut Gen, o: *mut rt.Buf, n: u64) {
    var k: u64 = 0
    while k < n {
        var w: World = World { ox: 0, oy: 0, oz: 0, nx: 0, ny: 0, nz: 0, ids: 0, solid: 0 }
        world_make(g, o, &w, k % 2)
        var bg: mc_math.BlockGrid = mc_math.grid_view(w.ox, w.oy, w.oz, w.nx, w.ny, w.nz, w.ids, w.solid,
            4 as u32, false)
        var j: u64 = 0
        while j < 150 {
            var px: f64 = (w.ox as f64) + rf(g, -3.0, (w.nx as f64) + 3.0)
            var py: f64 = (w.oy as f64) + rf(g, -3.0, (w.ny as f64) + 3.0)
            var pz: f64 = (w.oz as f64) + rf(g, -3.0, (w.nz as f64) + 3.0)
            var dx: f64 = rf(g, -1.0, 1.0)
            var dy: f64 = rf(g, -1.0, 1.0)
            var dz: f64 = rf(g, -1.0, 1.0)
            if j % 5 == 1 {
                // edge / corner heavy: half-integer origin, small integer direction
                px = floor_half(px)
                py = floor_half(py)
                pz = floor_half(pz)
                dx = ((ri(g, 5) as i64) - 2) as f64
                dy = ((ri(g, 5) as i64) - 2) as f64
                dz = ((ri(g, 5) as i64) - 2) as f64
            }
            if j % 7 == 2 { dy = 0.0 }
            let maxd: f64 = rf(g, 0.5, 40.0)
            var hit: mc_math.RayHit = mc_math.RayHit { x: 0, y: 0, z: 0, nx: 0, ny: 0, nz: 0, dist: 0.0, id: 0 }
            let ok: bool = mc_math.grid_raycast(&bg, px, py, pz, dx, dy, dz, maxd, &hit)
            tag(o, 82 as u8) // 'R'
            pf(o, px)
            pf(o, py)
            pf(o, pz)
            pf(o, dx)
            pf(o, dy)
            pf(o, dz)
            pf(o, maxd)
            if ok {
                pi(o, 1)
                pi(o, hit.x as i64)
                pi(o, hit.y as i64)
                pi(o, hit.z as i64)
                pi(o, hit.nx as i64)
                pi(o, hit.ny as i64)
                pi(o, hit.nz as i64)
                pf(o, hit.dist)
                pi(o, hit.id as i64)
            } else {
                pi(o, 0)
            }
            nl(o)
            j = j + 1
        }
        // sweeps
        j = 0
        while j < 150 {
            let sx: f64 = rf(g, 0.2, 1.9)
            let sy: f64 = rf(g, 0.2, 2.2)
            let sz: f64 = rf(g, 0.2, 1.9)
            var x0: f64 = (w.ox as f64) + rf(g, -1.0, (w.nx as f64) + 1.0)
            var y0: f64 = (w.oy as f64) + rf(g, -1.0, (w.ny as f64) + 1.0)
            var z0: f64 = (w.oz as f64) + rf(g, -1.0, (w.nz as f64) + 1.0)
            if j % 4 == 1 {
                // standing exactly on integer heights (touching faces)
                x0 = floor_half(x0)
                y0 = math.floor(y0)
                z0 = floor_half(z0)
            }
            var mx: f64 = rf(g, -4.0, 4.0)
            var my: f64 = rf(g, -4.0, 4.0)
            var mz: f64 = rf(g, -4.0, 4.0)
            if j % 5 == 2 { mx = 0.0 }
            if j % 6 == 3 { my = 0.0 }
            var bb: mc_math.Aabb = mc_math.aabb_new(x0, y0, z0, x0 + sx, y0 + sy, z0 + sz)
            var mr: mc_math.MoveResult = mc_math.MoveResult { dx: 0.0, dy: 0.0, dz: 0.0, hit_x: false, hit_y: false, hit_z: false }
            mc_math.grid_move(&bg, &bb, mx, my, mz, &mr)
            tag(o, 86 as u8) // 'V'
            pf(o, bb.x0)
            pf(o, bb.y0)
            pf(o, bb.z0)
            pf(o, bb.x1)
            pf(o, bb.y1)
            pf(o, bb.z1)
            pf(o, mx)
            pf(o, my)
            pf(o, mz)
            pf(o, mr.dx)
            pf(o, mr.dy)
            pf(o, mr.dz)
            if mr.hit_x { pi(o, 1) } else { pi(o, 0) }
            if mr.hit_y { pi(o, 1) } else { pi(o, 0) }
            if mr.hit_z { pi(o, 1) } else { pi(o, 0) }
            nl(o)
            j = j + 1
        }
        world_free(&w)
        tag(o, 69 as u8) // 'E' end of world
        nl(o)
        k = k + 1
    }
}

fn floor_half(x: f64) -> f64 {
    return math.floor(x * 2.0) / 2.0
}

fn arg_u64(start: u64, i: usize) -> u64 {
    let p: u64 = rt.arg_ptr(start, i)
    var v: u64 = 0
    var k: usize = 0
    while rt.ld8(p, k) != 0 as u8 {
        v = v * 10 as u64 + ((rt.ld8(p, k) - 48 as u8) as u64)
        k = k + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    var seed: u64 = 1
    var n: u64 = 20
    if rt.arg_count(start) > 1 { seed = arg_u64(start, 1) }
    if rt.arg_count(start) > 2 { n = arg_u64(start, 2) }
    var g: Gen = Gen { x: seed *% 0x9E3779B97F4A7C15 as u64 }
    var o: rt.Buf = rt.buf_new()
    matrix_cases(&g, &o, n * 5)
    frustum_cases(&g, &o, n)
    ray_cases(&g, &o, n)
    io.print_bytes(rt.buf_ptr(&o), rt.buf_len(&o))
    rt.buf_free(&o)
    return 0
}
