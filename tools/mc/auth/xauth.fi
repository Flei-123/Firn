// tools/mc/auth/xauth.fi -- command line driver of mc_auth for the cross-checks
// (tools/mc/auth/run.sh) against python hashlib and local mock session servers.
//
//   xauth uuid <name>                        offline UUID, dashed
//   xauth hash <serverId> <secretfile> <derfile>   Minecraft server hash
//   xauth join <base-url> <token> <uuid> <hash> [<trust-pem-file> [<timeout-ms>]]
//        prints "code=<n> name=<text> status=<http> net=<n> err=<e> msg=<m>"
import std.rt
import std.io
import mc.mc_auth

fn carg(start: u64, i: usize) -> u64 {
    return rt.arg_ptr(start, i)
}

fn cstr(p: u64) -> str {
    return str { p: p as *u8, n: rt.c_length(p) }
}

fn streq(a: u64, want: str) -> bool {
    return cstr(a) == want
}

fn parse_u64(a: u64) -> u64 {
    var v: u64 = 0
    var i: usize = 0
    let n: usize = rt.c_length(a)
    while i < n {
        v = v *% 10 +% ((rt.ld8(a, i) - 48 as u8) as u64)
        i = i + 1
    }
    return v
}

fn cmd_uuid(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 2
    }
    var u: [u8; 16] = [0; 16]
    let nm: u64 = carg(start, 2)
    if !mc_auth.offline_uuid(nm, rt.c_length(nm), (&u[0]) as u64) {
        return 1
    }
    var out: rt.Buf = rt.buf_new()
    mc_auth.uuid_to_text((&u[0]) as u64, true, &out)
    rt.buf_push(&out, 10 as u8)
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    return 0
}

fn cmd_hash(start: u64) -> i32 {
    if rt.arg_count(start) < 5 {
        return 2
    }
    var secret: rt.Buf = rt.buf_new()
    var der: rt.Buf = rt.buf_new()
    if !rt.read_file(carg(start, 3), &secret) || !rt.read_file(carg(start, 4), &der) {
        return 3
    }
    let sid: u64 = carg(start, 2)
    var out: rt.Buf = rt.buf_new()
    mc_auth.server_hash(sid, rt.c_length(sid), rt.buf_ptr(&secret), rt.buf_len(&secret),
        rt.buf_ptr(&der), rt.buf_len(&der), &out)
    rt.buf_push(&out, 10 as u8)
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    return 0
}

fn cmd_join(start: u64) -> i32 {
    if rt.arg_count(start) < 6 {
        return 2
    }
    var c: mc_auth.SessionClient = mc_auth.session_new()
    if !mc_auth.session_init(&c) {
        return 3
    }
    mc_auth.session_set_base(&c, cstr(carg(start, 2)))
    if rt.arg_count(start) > 6 {
        var pem: rt.Buf = rt.buf_new()
        if !rt.read_file(carg(start, 6), &pem) {
            return 3
        }
        let got: usize = mc_auth.session_add_trust_pem(&c, str { p: rt.buf_data(&pem), n: pem.len })
        if got == 0 {
            return 4
        }
        mc_auth.session_set_system_trust(&c, false)
    }
    if rt.arg_count(start) > 7 {
        mc_auth.session_set_timeout(&c, parse_u64(carg(start, 7)))
    }
    let rc: i64 = mc_auth.session_join(&c, cstr(carg(start, 3)), cstr(carg(start, 4)), cstr(carg(start, 5)))
    io.fmt_print(f"code={rc} status={mc_auth.session_status(&c)} net={mc_auth.session_net_error(&c)}\n")
    var out: rt.Buf = rt.buf_new()
    let nm: str = mc_auth.join_error_text(rc)
    var i: usize = 0
    while i < nm.length() {
        rt.buf_push(&out, nm.chars(i))
        i = i + 1
    }
    rt.buf_push(&out, 10 as u8)
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    rt.buf_clear(&out)
    let e: str = mc_auth.session_error(&c)
    let m: str = mc_auth.session_error_message(&c)
    i = 0
    while i < e.length() {
        rt.buf_push(&out, e.chars(i))
        i = i + 1
    }
    rt.buf_push(&out, 124 as u8)
    i = 0
    while i < m.length() {
        rt.buf_push(&out, m.chars(i))
        i = i + 1
    }
    rt.buf_push(&out, 10 as u8)
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    mc_auth.session_free(&c)
    return 0
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 2
    }
    let c: u64 = carg(start, 1)
    if streq(c, "uuid") {
        return cmd_uuid(start)
    }
    if streq(c, "hash") {
        return cmd_hash(start)
    }
    if streq(c, "join") {
        return cmd_join(start)
    }
    return 2
}
