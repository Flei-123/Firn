// tools/mc/auth/msa_login.fi -- real device-code login (owner-approved account test).
// stdin: line 1 = client id, line 2 = output account file (chmod 600, outside the repo).
// Prints "CODE <user_code> <uri>" first, waits for the browser confirmation, then runs the
// whole chain and writes mc_token/uuid/name to the file. Tokens are never printed.
import std.rt
import std.str
import std.fs
import auth.oauth
import auth.msa

fn out_str(s: str) { rt.write_everything(1, s.p as u64, s.length()) }

fn read_line(b: *mut rt.Buf) -> bool {
    rt.buf_clear(b)
    var ch: [u8; 1] = [0; 1]
    while true {
        let r: i64 = syscall(0, 0, (&ch[0]) as i64, 1, 0, 0, 0)
        if r <= 0 { return (*b).len > 0 }
        if ch[0] == 10 as u8 { return true }
        if ch[0] != 13 as u8 { rt.buf_push(b, ch[0]) }
    }
    return false
}

fn main() -> i32 {
    var b: rt.Buf = rt.buf_new()
    var b2: rt.Buf = rt.buf_new()
    read_line(&b)
    read_line(&b2)
    let cid: str = str { p: rt.ptr_of(b.ptr), n: b.len }
    let path: str = str { p: rt.ptr_of(b2.ptr), n: b2.len }
    var m: msa.Msa = msa.msa_new(cid)
    msa.msa_init(&m)
    var ep: msa.MsaEndpoints = msa.msa_endpoints_default()
    ep.device_url = "https://login.live.com/oauth20_connect.srf"
    ep.token_url = "https://login.live.com/oauth20_token.srf"
    ep.auth_url = "https://login.live.com/oauth20_authorize.srf"
    msa.msa_set_endpoints(&m, ep)
    msa.msa_set_scope(&m, "service::user.auth.xboxlive.com::MBI_SSL")
    msa.msa_set_rps_prefix("t=")
    oauth.oauth_set_extra_device(msa.msa_oauth(&m), "response_type=device_code")
    var da: oauth.DeviceAuth = oauth.deviceauth_new()
    var s: msa.MsaSession = msa.msa_session_new()
    let r: i64 = msa.msa_device_start(&m, &da)
    if r != oauth.OA_OK {
        out_str("FAIL device_start " + msa.msa_error_text(r) + "\n")
        return 1
    }
    out_str("CODE " + da.user_code + " " + da.verification_uri + "\n")
    let rc: i64 = msa.msa_device_wait(&m, &da, &s)
    if rc != oauth.OA_OK {
        out_str("FAIL step=" + msa.msa_step(&m) + " " + msa.msa_error_text(rc) + "\n")
        if msa.msa_xerr(&m) != 0 { out_str("XERR " + msa.msa_xerr_text(msa.msa_xerr(&m)) + "\n") }
        return 2
    }
    var ow: str = "0"
    var hp: str = "0"
    if s.owns { ow = "1" }
    if s.has_profile { hp = "1" }
    out_str("OK owns=" + ow + " profile=" + hp + " name=" + s.name + "\n")
    let content: str = "mc_token=" + s.mc_token + "\nuuid=" + s.uuid + "\nname=" + s.name + "\n"
    let w = fs.write_file_mode(path, content.p as u64, content.length(), 384 as u32, false) catch 0
    out_str("WROTE\n")
    return 0
}
