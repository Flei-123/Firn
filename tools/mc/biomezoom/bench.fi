// tools/mc/biomezoom/bench.fi -- mesher cost of the biome tint (r258): ms_mesh_split_bio without biomes / blend only / blend + Voronoi zoom.
// Per section CPU time (CLOCK_PROCESS_CPUTIME_ID, single thread, min over 5 reps), p50 over 32 sections at different world origins; `hash` = FNV of the
// output quads (must stay equal across code versions). Run: tools/mc/biomezoom/bench.sh
import std.rt
import std.core
import std.math
import std.io
import zip.zip
import pack.packicons
import mc.mc_assets
import mc.mc_texture
import mc.mc_texext
import mc.mc_mesh
import mc.mc_model
import mc.mc_model_mesh
import mc.mc_registry
import mc.mc_version
import mc.mc_versions
import mc.mc_chunk
import mc.mc_biome_zoom

const META: str = "{\"pack\":{\"pack_format\": 15, \"description\":\"t\"}}"

// 16 x 16 solid colour PNG
fn png_solid(r: u8, g: u8, b: u8, a: u8, out: *mut rt.Buf) -> bool {
    let px: u64 = rt.heap_alloc(16 * 16 * 4)
    var i: usize = 0
    while i < 256 {
        rt.st8(px, i * 4, r)
        rt.st8(px, i * 4 + 1, g)
        rt.st8(px, i * 4 + 2, b)
        rt.st8(px, i * 4 + 3, a)
        i = i + 1
    }
    let ok: bool = packicons.png_encode(px, 16, 16, out)
    rt.heap_free(px, 16 * 16 * 4)
    return ok
}

fn add_text(w: *mut zip.ZipWriter, name: str, s: str) -> bool {
    var ok: bool = zip.zip_add(w, name, s.p as u64, s.length(), true) catch | e | (false)
    return ok
}

fn add_png(w: *mut zip.ZipWriter, name: str, r: u8, g: u8, b: u8, a: u8) -> bool {
    var p: rt.Buf = rt.buf_new()
    if !png_solid(r, g, b, a, &p) { return false }
    var ok: bool = zip.zip_add(w, name, rt.buf_ptr(&p), rt.buf_len(&p), true) catch | e | (false)
    rt.buf_free(&p)
    return ok
}

// blockstate of a block without properties: one model for every state
fn add_state(w: *mut zip.ZipWriter, block: str, model: str) -> bool {
    return add_text(w, "assets/minecraft/blockstates/" + block + ".json", "{\"variants\":{\"\":{\"model\":\"" + model + "\"}}}")
}

// a model with ONE up face covering the whole top of the cell (flat on the cell face: AO applies), texture `tex`, optional tintindex 0
fn add_up_model(w: *mut zip.ZipWriter, name: str, tex: str, tinted: bool) -> bool {
    var tn: str = ""
    if tinted { tn = ",\"tintindex\":0" }
    return add_text(w, "assets/minecraft/models/block/" + name + ".json",
        "{\"textures\":{\"t\":\"block/" + tex + "\"},\"elements\":[{\"from\":[0,0,0],\"to\":[16,16,16],\"faces\":{\"up\":{\"uv\":[0,0,16,16],\"texture\":\"#t\"" + tn + "}}}]}")
}

fn open_pack(b: *mut rt.Buf, w: *mut zip.ZipWriter, st: *mut mc_assets.PackStack) -> bool {
    var n: usize = zip.zip_finish(w) catch | e | (0)
    zip.zip_writer_free(w)
    if n == 0 { return false }
    var pk: mc_assets.Pack = mc_assets.pack_empty()
    if mc_assets.pack_open_mem(&pk, rt.buf_ptr(b), rt.buf_len(b)) != mc_assets.ASSET_OK { return false }
    rt.buf_free(b)
    return mc_assets.stack_push(st, &pk) == mc_assets.ASSET_OK
}

fn sid(reg: *mut mc_registry.Registry, name: str) -> i32 {
    let blk: i32 = mc_registry.reg_block_by_name(reg, name.p as u64, name.length())
    if blk < 0 { return 0 - 1 }
    return mc_registry.reg_block_min_state(reg, blk)
}

// cell (x, y, z) of section 0 (a 16 x 16 x 16 u16 array per section, 2 sections)
fn put(ids: u64, x: i32, y: i32, z: i32, state: i32) {
    rt.st16(ids, ((y * 16 + z) * 16 + x) as usize, state as u16)
}

fn new_ids() -> u64 {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    return ids
}

fn chan(c: u32, k: i32) -> i32 {
    return ((c >> ((k * 8) as u32)) & (255 as u32)) as i32
}

fn iabs(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

// everything a scene needs, rebuilt per scene
struct Scene {
    tb: mc_mesh.MeshTables,
    ex: mc_texext.TexExt,
    atlas: mc_texture.Atlas,
    an: mc_assets.AnimSet,
}

fn scene_init(sc: *mut Scene, reg: *mut mc_registry.Registry, st: *mut mc_assets.PackStack) -> bool {
    (*sc).tb = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_texture.tex_alloc_tables(&(*sc).tb)
    (*sc).ex = mc_texext.texext_new()
    mc_texext.tex_build_tables_ext(reg, &(*sc).tb, &(*sc).ex)
    (*sc).atlas = mc_texext.texext_atlas_new(16, &(*sc).ex)
    (*sc).an = mc_assets.animset_new()
    return mc_assets.assets_apply_ext(st, &(*sc).atlas, &(*sc).ex, &(*sc).an) >= 1
}

fn biome_id(reg: *mut mc_registry.Registry, name: str) -> i32 {
    var i: i32 = 0
    while i < mc_registry.reg_biome_count(reg) {
        var nl: usize = 0
        let np: u64 = mc_registry.reg_biome_name(reg, i, &nl)
        var off: usize = 0
        if nl > 10 && rt.mem_eq(np, "minecraft:".p as u64, 10) { off = 10 }
        if nl - off == name.length() && rt.mem_eq(np + (off as u64), name.p as u64, nl - off) { return mc_registry.reg_biome_id(reg, i) }
        i = i + 1
    }
    return 0 - 1
}

const NSEC: usize = 32

// CPU time of the process (CLOCK_PROCESS_CPUTIME_ID): less sensitive to server load than wall time
fn cpu_ns() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 2, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000000 as u64 + (ts[1] as u64)
}
const NPOS: usize = 5832

// FNV-1a over the bytes of a buffer (bit equality of the mesher output between code versions)
fn hash_buf(h: u64, b: *mut rt.Buf) -> u64 {
    var x: u64 = h
    let p: u64 = rt.buf_ptr(b)
    let n: usize = rt.buf_len(b)
    var i: usize = 0
    while i < n {
        x = (x ^ (rt.ld8(p, i) as u64)) *% (1099511628211 as u64)
        i = i + 1
    }
    return x
}

// scenario 0 = one grass layer (256 tinted blocks), 1 = layer + leaves in a checker of columns (~768), 2 = every block tinted (4096)
fn fill_pad(pad: u64, scen: usize, s_grass: i32, s_leaf: i32) {
    var i: usize = 0
    while i < NPOS {
        rt.st16(pad, i, 0 as u16)
        i = i + 1
    }
    var y: i32 = 0
    while y < 16 {
        var z: i32 = 0
        while z < 16 {
            var x: i32 = 0
            while x < 16 {
                let pi: usize = (((y + 1) * 18 + (z + 1)) * 18 + (x + 1)) as usize
                if scen == 0 && y == 8 { rt.st16(pad, pi, s_grass as u16) }
                if scen == 1 {
                    if y == 8 { rt.st16(pad, pi, s_grass as u16) }
                    if y > 8 && y < 11 && (x + z) % 2 == 0 { rt.st16(pad, pi, s_leaf as u16) }
                }
                if scen == 2 { rt.st16(pad, pi, s_grass as u16) }
                x = x + 1
            }
            z = z + 1
        }
        y = y + 1
    }
}

fn median(a: u64, n: usize) -> u64 {
    var i: usize = 1
    while i < n {
        var v: u64 = rt.ld64(a, i)
        var j: usize = i
        while j > 0 && rt.ld64(a, j - 1) > v {
            rt.st64(a, j, rt.ld64(a, j - 1))
            j = j - 1
        }
        rt.st64(a, j, v)
        i = i + 1
    }
    return rt.ld64(a, n / 2)
}

fn main() -> i32 {
    var reps: usize = 5
    var v: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &v) { return 1 }
    var reg: mc_registry.Registry = v.registry_of()
    if !mc_registry.registry_ok(&reg) { return 2 }
    var stk: mc_assets.PackStack = mc_assets.stack_new()
    {
        var b: rt.Buf = rt.buf_new()
        var w: zip.ZipWriter = zip.zip_writer_new(&b)
        if !add_text(&w, "pack.mcmeta", META) { return 3 }
        if !add_png(&w, "assets/minecraft/textures/block/oak_planks.png", 240 as u8, 240 as u8, 240 as u8, 255 as u8) { return 3 }
        if !add_up_model(&w, "ms_t", "oak_planks", true) { return 3 }
        if !add_state(&w, "stone", "block/ms_t") { return 3 }
        if !add_state(&w, "oak_leaves", "block/ms_t") { return 3 }
        if !open_pack(&b, &w, &stk) { return 3 }
    }
    var ex0: mc_texext.TexExt = mc_texext.texext_new()
    var sc: Scene = Scene { tb: mc_mesh.MeshTables { opaque: 0, tiles: 0 }, ex: mc_texext.texext_new(), atlas: mc_texext.texext_atlas_new(16, &ex0), an: mc_assets.animset_new() }
    if !scene_init(&sc, &reg, &stk) { return 4 }
    var ms: mc_model_mesh.ModelSet = mc_model_mesh.ms_new(&reg, &stk, &sc.ex)
    let s_grass: i32 = sid(&reg, "stone")
    let s_leaf: i32 = sid(&reg, "oak_leaves")
    if s_grass < 0 || s_leaf < 0 { return 5 }
    let b_plains: i32 = biome_id(&reg, "plains")
    let b_jungle: i32 = biome_id(&reg, "jungle")
    let b_desert: i32 = biome_id(&reg, "desert")
    let b_forest: i32 = biome_id(&reg, "forest")
    let b_swamp: i32 = biome_id(&reg, "swamp")
    if b_plains < 0 || b_jungle < 0 || b_desert < 0 || b_forest < 0 || b_swamp < 0 { return 6 }
    mc_model_mesh.ms_load_biomes(&ms)
    mc_model_mesh.ms_set_blend(&ms, 2)
    let hs: i64 = 293737985876514017
    let pad: u64 = rt.heap_alloc(NPOS * 2 + mc_model_mesh.BIO_BYTES)
    let bio: u64 = pad + (mc_model_mesh.BIO_OFF as u64)
    let tm: u64 = rt.heap_alloc(NSEC * 8 * 8)
    let mn: u64 = rt.heap_alloc(NSEC * 8)
    var out: rt.Buf = rt.buf_new()
    var outt: rt.Buf = rt.buf_new()
    var snames: [str; 5] = ["layer256", "layer+leaves", "full4096", "layer256_swamp", "layer256_border"]
    var mnames: [str; 3] = ["nobiome", "blend_nozoom", "blend_zoom"]
    var sci: usize = 0
    while sci < 5 {
        var scen: usize = sci
        if sci >= 3 { scen = 0 }
        fill_pad(pad, scen, s_grass, s_leaf)
        // biome grid: 4 biomes in a pattern of cells (borders everywhere = worst case for the zoom picks); the swamp scenario = uniform swamp
        var gy: i32 = 0 - 1
        while gy < 5 {
            var gz: i32 = 0 - 1
            while gz < 5 {
                var gx: i32 = 0 - 1
                while gx < 5 {
                    var id: i32 = b_plains
                    let k: i32 = iabs(gx * 7 + gy * 13 + gz * 3) % 4
                    if k == 1 { id = b_desert }
                    if k == 2 { id = b_jungle }
                    if k == 3 { id = b_forest }
                    if sci == 3 { id = b_swamp }
                    if sci == 4 {
                        id = b_plains
                        if gx >= 2 { id = b_desert }
                    }
                    rt.st16(bio, (((gy + 1) * 6 + gz + 1) * 6 + gx + 1) as usize, id as u16)
                    gx = gx + 1
                }
                gz = gz + 1
            }
            gy = gy + 1
        }
        mc_model_mesh.ms_reset(&ms)
        mc_model_mesh.ms_prepare(&ms, pad, &sc.tb)
        var mi: usize = 0
        while mi < 3 {
            mc_model_mesh.ms_clear_seed(&ms)
            if mi == 2 { mc_model_mesh.ms_set_seed(&ms, hs) }
            var gb: u64 = bio
            if mi == 0 { gb = 0 }
            var hash: u64 = 1469598103 as u64
            var rep: usize = 0
            var nq: usize = 0
            while rep < reps {
                var i: usize = 0
                while i < NSEC {
                    let wx: i32 = ((i as i32) * 37 - 600) * 16
                    let wz: i32 = ((i as i32) * 53 - 800) * 16
                    let a: u64 = cpu_ns()
                    nq = mc_model_mesh.ms_mesh_split_bio(&ms, pad, 0, &sc.tb, wx, 64, wz, &out, &outt, gb)
                    let b: u64 = cpu_ns()
                    rt.st64(tm, rep * NSEC + i, b - a)
                    if rep == 0 { hash = hash_buf(hash, &out) }
                    i = i + 1
                }
                rep = rep + 1
            }
            var i2: usize = 0
            while i2 < NSEC {
                var lo: u64 = rt.ld64(tm, i2)
                var r2: usize = 1
                while r2 < reps {
                    let x: u64 = rt.ld64(tm, r2 * NSEC + i2)
                    if x < lo { lo = x }
                    r2 = r2 + 1
                }
                rt.st64(mn, i2, lo)
                i2 = i2 + 1
            }
            let p50: u64 = median(mn, NSEC)
            io.fmt_print(f"BENCH scen={snames[sci]} mode={mnames[mi]} quads={nq} p50_us={p50 / (1000 as u64)}.{(p50 % (1000 as u64)) / (100 as u64)} hash={hash}\n")
            mi = mi + 1
        }
        sci = sci + 1
    }
    mc_model_mesh.ms_clear_seed(&ms)
    mc_model_mesh.ms_free(&ms)
    return 0
}
