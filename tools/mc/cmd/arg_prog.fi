// SPDX-License-Identifier: MPL-2.0
// tools/mc/cmd/arg_prog.fi -- differential driver: replays an argument-type corpus and prints exactly what ArgOracle.java prints.
import std.rt
import std.io
import brigadier.mem as m
import brigadier.text as tx
import brigadier.exc as ex
import brigadier.reader as rd
import brigadier.argtype as at
import mc.cmd.cmd_tree as ct
import mc.cmd.cmd_args as ca

struct Known {
    spec: str,
    custom: i32,
}

fn find_tab(s: str) -> usize {
    var i: usize = 0
    while i < s.n {
        if rt.ld8(s.p as u64, i) == 9 as u8 {
            return i
        }
        i = i + 1
    }
    return s.n
}

fn sub(s: str, a: usize, b: usize) -> str {
    return str { p: (s.p as u64 + a as u64) as *mut u8, n: b - a }
}

fn unescape(a: *mut m.Arena, s: str) -> str {
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < s.n {
        let c: u8 = rt.ld8(s.p as u64, i)
        if c == 92 as u8 && i + 1 < s.n {
            let d: u8 = rt.ld8(s.p as u64, i + 1)
            if d == 110 as u8 {
                rt.buf_push(&b, 10 as u8)
            } else if d == 116 as u8 {
                rt.buf_push(&b, 9 as u8)
            } else {
                rt.buf_push(&b, d)
            }
            i = i + 2
        } else {
            rt.buf_push(&b, c)
            i = i + 1
        }
    }
    let r: str = ct.buf_copy_pub(a, &b)
    rt.buf_free(&b)
    return r
}

fn push_escaped(out: *mut rt.Buf, s: str) {
    var i: usize = 0
    while i < s.n {
        let c: u8 = rt.ld8(s.p as u64, i)
        if c == 92 as u8 {
            ct.push_str(out, "\\\\")
        } else if c == 10 as u8 {
            ct.push_str(out, "\\n")
        } else if c == 9 as u8 {
            ct.push_str(out, "\\t")
        } else if c == 13 as u8 {
            ct.push_str(out, "\\r")
        } else {
            rt.buf_push(out, c)
        }
        i = i + 1
    }
}

fn kind_of_spec(name: str) -> str {
    return name
}

fn make_spec(t: *mut ct.CmdTree, spec: str) -> i32 {
    var colon: usize = spec.n
    var i: usize = 0
    while i < spec.n {
        if rt.ld8(spec.p as u64, i) == 58 as u8 {
            colon = i
            break
        }
        i = i + 1
    }
    var parser: rt.Buf = rt.buf_new()
    ct.push_str(&parser, "minecraft:")
    ct.push_str(&parser, sub(spec, 0, colon))
    var props: str = "-"
    if colon < spec.n {
        var pb: rt.Buf = rt.buf_new()
        ct.push_str(&pb, "min=")
        ct.push_str(&pb, sub(spec, colon + 1, spec.n))
        props = ct.buf_copy_pub((*t).a, &pb)
        rt.buf_free(&pb)
    }
    m.arr_push[ct.Spec]((*t).a, &(*t).specs, ct.Spec { parser: ct.buf_copy_pub((*t).a, &parser), props: props, kind: 0, p0: 0 })
    rt.buf_free(&parser)
    return m.arr_len[ct.Spec](&(*t).specs) as i32
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        io.eprint_line("usage: arg_prog <corpus.txt>")
        return 2
    }
    var buf: rt.Buf = rt.buf_new()
    if !io.read_file(rt.arg_ptr(start, 1), &buf) {
        io.eprint_line("cannot read corpus")
        return 2
    }
    var a: m.Arena = m.arena_new()
    var t: ct.CmdTree = ct.tree_new(&a)
    var known: m.Arr[Known] = m.arr_new[Known]()
    var work: m.Arena = m.arena_new()
    var out: rt.Buf = rt.buf_new()
    var lr: io.LineReader = io.lines_of_buf(&buf)
    var lp: u64 = 0
    var ln: usize = 0
    while io.lines_next(&lr, &lp, &ln) {
        if ln == 0 {
            continue
        }
        let line: str = str { p: lp as *mut u8, n: ln }
        let tab: usize = find_tab(line)
        let spec: str = sub(line, 0, tab)
        var custom: i32 = 0
        var i: usize = 0
        while i < m.arr_len[Known](&known) {
            if ct.str_eq((*m.arr_at[Known](&known, i)).spec, spec) {
                custom = (*m.arr_at[Known](&known, i)).custom
            }
            i = i + 1
        }
        if custom == 0 {
            custom = make_spec(&t, spec)
            m.arr_push[Known](&a, &known, Known { spec: spec, custom: custom })
            ca.args_bind(&t)
        }
        m.arena_reset(&work)
        let input: str = unescape(&work, sub(line, tab + 1, line.n))
        let u16: tx.U16 = tx.u16_from_str(&work, input)
        var r: rd.Reader = rd.reader_new(&work, u16)
        var v: at.Value = at.Value { kind: 0, i: 0, f: 0.0, s: tx.u16_empty() }
        var e: ex.Exc = ex.exc_none()
        rt.buf_clear(&out)
        ct.push_str(&out, spec)
        rt.buf_push(&out, 9 as u8)
        push_escaped(&out, input)
        rt.buf_push(&out, 9 as u8)
        let sp: *mut ct.Spec = ct.tree_spec(&t, custom)
        if ca.args_hook((&t) as *mut ct.CmdTree as u64, custom, (&r) as *mut rd.Reader as u64, (&v) as *mut at.Value as u64, (&e) as *mut ex.Exc as u64) {
            ct.push_str(&out, "OK ")
            var d: rt.Buf = rt.buf_new()
            ca.args_describe(&work, (*sp).kind, &v, &d)
            push_escaped(&out, rt.buf_str(&d))
            rt.buf_free(&d)
            ct.push_str(&out, " @")
            rt.buf_push_dec_i64(&out, r.cursor as i64)
        } else {
            ct.push_str(&out, "ERR ")
            push_escaped(&out, tx.u16_to_str(&work, ex.exc_message(&work, &e)))
            ct.push_str(&out, " @")
            rt.buf_push_dec_i64(&out, e.cursor)
        }
        io.print_line_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    }
    return 0
}
