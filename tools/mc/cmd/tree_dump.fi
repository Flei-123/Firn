// tools/mc/cmd/tree_dump.fi -- loads a commands.json report into the brigadier tree and prints the canonical dump.
import std.rt
import std.io
import brigadier.bmem as m
import mc.cmd.cmd_tree as ct

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        io.eprint_line("usage: tree_dump <commands.json>")
        return 2
    }
    var src: rt.Buf = rt.buf_new()
    if !io.read_file(rt.arg_ptr(start, 1), &src) {
        io.eprint_line("cannot read input")
        return 2
    }
    var a: m.BumpArena = m.arena_new()
    var t: ct.CmdTree = ct.tree_new(&a)
    if !ct.tree_load(&t, rt.buf_ptr(&src), rt.buf_len(&src)) {
        io.eprint_line("invalid json")
        return 1
    }
    var out: rt.Buf = rt.buf_new()
    ct.tree_dump(&t, &out)
    io.print_line_bytes(rt.buf_ptr(&out), rt.buf_len(&out) - 1)
    return 0
}
