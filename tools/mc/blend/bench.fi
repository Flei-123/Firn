// tools/mc/blend/bench.fi -- mc_blend speed: a 640x360 frame mixed with a colour (fog / veil), SIMD against scalar.
import std.rt
import std.io
import mc.mc_blend

fn now_ns() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000000 as u64 + (ts[1] as u64)
}

fn main() -> i32 {
    let n: usize = 640 * 360
    let a: u64 = rt.heap_alloc(n * 4)
    let b: u64 = rt.heap_alloc(n * 4)
    var i: usize = 0
    var seed: u64 = 7 as u64
    while i < n {
        seed = (seed * 1664525 as u64 + 1013904223 as u64) & 0xFFFFFFFF as u64
        rt.st32(a, i, (seed as u32) | 0xFF000000 as u32)
        rt.st32(b, i, (seed as u32) | 0xFF000000 as u32)
        i = i + 1
    }
    let reps: i32 = 200
    var r: i32 = 0
    let t0: u64 = now_ns()
    while r < reps {
        mc_blend.mix_span_scalar(a, n, 0x00C8BE96 as u32, 40 as u32)
        r = r + 1
    }
    let t1: u64 = now_ns()
    r = 0
    while r < reps {
        mc_blend.mix_span(b, n, 0x00C8BE96 as u32, 40 as u32)
        r = r + 1
    }
    let t2: u64 = now_ns()
    // the exact /255 HUD formula
    r = 0
    let t3: u64 = now_ns()
    while r < reps {
        mc_blend.blend_span_scalar(a, n, 0x00C8BE96 as u32, 100 as u32)
        r = r + 1
    }
    let t4: u64 = now_ns()
    r = 0
    while r < reps {
        mc_blend.blend_span(b, n, 0x00C8BE96 as u32, 100 as u32)
        r = r + 1
    }
    let t5: u64 = now_ns()
    var same: i32 = 1
    i = 0
    while i < n {
        if rt.ld32(a, i) != rt.ld32(b, i) { same = 0 }
        i = i + 1
    }
    io.fmt_print(f"metric blend_640x360 scalar_us_per_frame={(t1 - t0) / (reps as u64) / 1000 as u64} simd_us_per_frame={(t2 - t1) / (reps as u64) / 1000 as u64} identical={same}\n")
    io.fmt_print(f"metric blend255_640x360 scalar_us_per_frame={(t4 - t3) / (reps as u64) / 1000 as u64} simd_us_per_frame={(t5 - t4) / (reps as u64) / 1000 as u64} identical={same}\n")
    return 0
}
