import std.rt
import std.fs
import mc.mc_raster
import mc.mc_gui_pack
import mc.mc_gui_ui
import mc.mc_panorama
import mc.mc_menu_title

fn main() -> i32 {
    var pk: mc_gui_pack.GuiPack = mc_gui_pack.gpack_new()
    if !mc_gui_pack.gpack_open(&pk, 763) { return 2 }
    var pan: mc_panorama.Panorama = mc_panorama.pan_new()
    let pok: bool = mc_panorama.pan_load(&pan, &pk)
    var r: mc_raster.Raster = mc_raster.raster_new(854, 480)
    var t: mc_menu_title.TitleState = mc_menu_title.title_new()
    t.fixed_phase = true
    mc_menu_title.title_pick_splash(&t, &pk, 7 as u64)
    var u: mc_gui_ui.Ui = mc_gui_ui.ui_new()
    mc_gui_ui.ui_begin(&u, &r, &pk, 2, 0 - 100, 0 - 100, false, 0 as u64)
    mc_menu_title.title_frame(&u, &t, &pan, 0.0)
    var out: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&out, "P6\n854 480\n255\n".p as u64, 15)
    var i: usize = 0
    while i < 854 * 480 {
        let c: u32 = rt.ld32(r.color, i)
        rt.buf_push(&out, (c & 255 as u32) as u8)
        rt.buf_push(&out, ((c >> 8 as u32) & 255 as u32) as u8)
        rt.buf_push(&out, ((c >> 16 as u32) & 255 as u32) as u8)
        i = i + 1
    }
    fs.write_file("title.ppm", rt.buf_ptr(&out), rt.buf_len(&out)) catch 0
    if !pok { return 3 }
    return 0
}
