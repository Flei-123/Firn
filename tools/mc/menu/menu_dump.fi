import std.rt
import std.fs
import std.env
import mc.mc_hud
import mc.mc_raster
import mc.mc_gui_pack
import mc.mc_gui_ui
import mc.mc_panorama
import mc.mc_menu_title

fn env_int(name: str, def: i32) -> i32 {
    if !env.has(name) { return def }
    let v: str = env.get(name)
    if v.length() == 0 { return def }
    var n: i32 = 0
    var i: usize = 0
    while i < v.length() {
        let c: u8 = v.chars(i)
        if c < 48 as u8 || c > 57 as u8 { return def }
        n = n * 10 + (c as i32 - 48)
        i = i + 1
    }
    return n
}

fn main() -> i32 {
    let w: i32 = env_int("MENU_DUMP_W", 854)
    let h: i32 = env_int("MENU_DUMP_H", 480)
    var pk: mc_gui_pack.GuiPack = mc_gui_pack.gpack_new()
    if !mc_gui_pack.gpack_open(&pk, 763) { return 2 }
    var pan: mc_panorama.Panorama = mc_panorama.pan_new()
    let pok: bool = mc_panorama.pan_load(&pan, &pk)
    var r: mc_raster.Raster = mc_raster.raster_new(w, h)
    var t: mc_menu_title.TitleState = mc_menu_title.title_new()
    t.fixed_phase = true
    mc_menu_title.title_pick_splash(&t, &pk, 7 as u64)
    var u: mc_gui_ui.Ui = mc_gui_ui.ui_new()
    mc_gui_ui.ui_begin(&u, &r, &pk, mc_hud.hud_scale(w, h), 0 - 100, 0 - 100, false, 0 as u64)
    mc_menu_title.title_frame(&u, &t, &pan, 0.0)
    var out: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&out, "P6\n".p as u64, 3)
    rt.buf_push_dec_i64(&out, w as i64)
    rt.buf_push(&out, 32 as u8)
    rt.buf_push_dec_i64(&out, h as i64)
    rt.buf_push_bytes(&out, "\n255\n".p as u64, 5)
    var i: usize = 0
    while i < (w * h) as usize {
        let c: u32 = rt.ld32(r.color, i)
        rt.buf_push(&out, (c & 255 as u32) as u8)
        rt.buf_push(&out, ((c >> 8 as u32) & 255 as u32) as u8)
        rt.buf_push(&out, ((c >> 16 as u32) & 255 as u32) as u8)
        i = i + 1
    }
    var out_path: str = "title.ppm"
    if env.has("MENU_DUMP_OUT") { out_path = env.get("MENU_DUMP_OUT") }
    fs.write_file(out_path, rt.buf_ptr(&out), rt.buf_len(&out)) catch 0
    if !pok { return 3 }
    return 0
}
