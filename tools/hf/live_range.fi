import std.rt
import std.io
import hf.remote

fn main() -> i32 {
    var src: remote.HfSrc = remote.HfSrc { read_at: remote.hf_remote_read, ud: 0, size: 0 }
    if !remote.hf_remote_open("https://huggingface.co/datasets/HuggingFaceFW/fineweb-edu/resolve/main/sample/10BT/000_00000.parquet", "", &src) { return 1 as i32 }
    if src.size != 2152819114 { return 2 as i32 }
    let buf: u64 = rt.heap_alloc(1048576)
    let f: fn(u64, u64, u64, usize) -> bool = src.read_at
    if !f(src.ud, 123456789, buf, 1048576) { return 3 as i32 }
    let ok2: bool = f(src.ud, 2152819114 - 8, buf + 2000000 - 2000000, 8)
    if !ok2 { return 4 as i32 }
    io.print_line_bytes(buf, 8)
    var h: u64 = 1469598103934665603
    var i: usize = 0
    if !f(src.ud, 123456789, buf, 1048576) { return 5 as i32 }
    while i < 1048576 {
        h = (h ^ rt.ld8(buf, i) as u64) *% 1099511628211
        i = i + 1
    }
    io.print_line("ok")
    var o: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&o, h)
    rt.buf_push(&o, 32 as u8)
    rt.buf_push_dec_u64(&o, remote.hf_remote_bytes(&src))
    rt.buf_push(&o, 32 as u8)
    rt.buf_push_dec_u64(&o, remote.hf_remote_requests(&src))
    io.print_line_bytes(o.ptr, o.len)
    remote.hf_remote_close(&src)
    return 0 as i32
}
