import std.rt
import std.io
import hf.hub

fn show(l: *mut hub.HfList, maxn: usize) {
    var i: usize = 0
    var o: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&o, hub.hf_list_count(l) as u64)
    rt.buf_push(&o, 10 as u8)
    while i < hub.hf_list_count(l) && i < maxn {
        let a: str = hub.hf_list_a(l, i)
        let b: str = hub.hf_list_b(l, i)
        rt.buf_push_bytes(&o, a.p as u64, a.n)
        rt.buf_push(&o, 9 as u8)
        rt.buf_push_bytes(&o, b.p as u64, b.n)
        rt.buf_push(&o, 9 as u8)
        rt.buf_push_dec_u64(&o, hub.hf_list_size(l, i))
        rt.buf_push(&o, 10 as u8)
        i = i + 1
    }
    io.print_bytes(o.ptr, o.len)
}

fn main() -> i32 {
    var l1: hub.HfList = hub.hf_list_new()
    if !hub.hf_list_configs("epfml/FineWeb2-HQ", "", &l1) { return 1 as i32 }
    show(&l1, 4)
    var l2: hub.HfList = hub.hf_list_new()
    if !hub.hf_list_files("epfml/FineWeb2-HQ", "deu_Latn", "train", "", &l2) { return 2 as i32 }
    show(&l2, 3)
    var l3: hub.HfList = hub.hf_list_new()
    if !hub.hf_list_files("HuggingFaceFW/fineweb-edu", "default", "train", "", &l3) { return 3 as i32 }
    show(&l3, 2)
    var l4: hub.HfList = hub.hf_list_new()
    if !hub.hf_list_files("open-thoughts/OpenThoughts3-1.2M", "default", "train", "", &l4) { return 4 as i32 }
    show(&l4, 2)
    var l5: hub.HfList = hub.hf_list_new()
    if !hub.hf_list_configs("open-thoughts/OpenThoughts3-1.2M", "", &l5) { return 5 as i32 }
    show(&l5, 3)
    var l6: hub.HfList = hub.hf_list_new()
    if !hub.hf_list_files("HuggingFaceFW/fineweb-edu", "sample-10BT", "train", "", &l6) { return 8 as i32 }
    if hub.hf_list_count(&l6) > 100 || hub.hf_list_count(&l6) == 0 { return 9 as i32 }
    show(&l6, 2)
    var sz: u64 = 0
    if !hub.hf_probe(hub.hf_list_a(&l2, 0), "", &sz) { return 6 as i32 }
    if sz != hub.hf_list_size(&l2, 0) { return 7 as i32 }
    return 0 as i32
}
