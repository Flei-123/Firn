import jobs.jobs
import scene3d.vec3
import scene3d.quat
import scene3d.camera
import scene3d.geom
import scene3d.material
import scene3d.light
import scene3d.scene
import scene3d.surface
import scene3d.render
import scene3d.anim
import scene3d.video
import scene3d.video_opts

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    return 0
}

struct MiniDemo {
    sc: scene.Scene,
    rd: render.Renderer,
    keys: anim.CamKeys,
    tl: anim.Timeline,
    cam: camera.Camera,
}

fn build(o: *mut video_opts.VideoOpts) -> MiniDemo {
    var dm: MiniDemo = MiniDemo {
        sc: scene.scene_new(),
        rd: render.renderer_new((*o).width, (*o).height, (*o).ss, (*o).threads),
        keys: anim.camkeys_new(),
        tl: anim.timeline_new(),
        cam: camera.cam_new((*o).width, (*o).height),
    }
    let d: *mut MiniDemo = &dm
    let floor_mesh: i32 = scene.scene_add_mesh(&(*d).sc, geom.geom_plane(20.0, 20.0, 1, 1))
    let box_mesh: i32 = scene.scene_add_mesh(&(*d).sc, geom.geom_box(2.0, 2.0, 2.0))
    let ball_mesh: i32 = scene.scene_add_mesh(&(*d).sc, geom.geom_sphere(1.0, 24, 16))
    let grey: i32 = scene.scene_add_material(&(*d).sc, material.mat_standard(vec3.rgb_hex(0x8a8f98), 0.0, 0.8))
    let red: i32 = scene.scene_add_material(&(*d).sc, material.mat_standard(vec3.rgb_hex(0xd04040), 0.0, 0.5))
    let glass: i32 = scene.scene_add_material(&(*d).sc, material.mat_glass(vec3.rgb_hex(0x60a0ff), 0.4))
    scene.scene_add_mesh_node(&(*d).sc, -1, floor_mesh, grey)
    let cube: i32 = scene.scene_add_mesh_node(&(*d).sc, -1, box_mesh, red)
    let ball: i32 = scene.scene_add_mesh_node(&(*d).sc, -1, ball_mesh, glass)
    scene.node_set_pos(scene.scene_node(&(*d).sc, cube), vec3.v3(-2.0, 1.0, 0.0))
    scene.node_set_pos(scene.scene_node(&(*d).sc, ball), vec3.v3(2.0, 1.0, 0.0))
    scene.scene_add_light(&(*d).sc, light.light_dir(vec3.v3_norm(vec3.v3(0.5, 1.0, 0.7)), vec3.v3(1.0, 0.97, 0.9), 2.5))
    anim.timeline_fly_in(&(*d).tl, cube, vec3.v3(-2.0, 1.0, 0.0), 0.1, 0.6, vec3.v3(0.0, 6.0, 0.0), true, anim.EASE_OUT_CUBIC)
    anim.timeline_fade(&(*d).tl, ball, 0.3, 0.6, 0.0, 1.0, anim.EASE_IN_OUT)
    anim.camkeys_add(&(*d).keys, 0.0, vec3.v3(0.0, 4.0, 10.0), vec3.v3(0.0, 1.0, 0.0), 40.0)
    anim.camkeys_add(&(*d).keys, 1.0, vec3.v3(6.0, 3.0, 7.0), vec3.v3(0.0, 1.0, 0.0), 35.0)
    return dm
}

fn paint(ctx: u64, frame: u64, t: f64, sf: *mut surface.Surface) {
    let d: *mut MiniDemo = ctx as *mut MiniDemo
    anim.timeline_apply(&(*d).tl, &(*d).sc, t)
    anim.camkeys_at(&(*d).keys, t, &(*d).cam)
    render.render(&(*d).rd, &(*d).sc, &(*d).cam, sf)
}

fn main(start: u64) -> i32 {
    var o: video_opts.VideoOpts = video_opts.video_opts_default()
    let rc: i32 = video_opts.video_parse_args(&o, "mini", "scene3d mini demo", start)
    if rc >= 0 { return rc }
    var d: MiniDemo = build(&o)
    var code: i32 = 0
    if o.has_still {
        code = video.video_still(&o, paint, (&d) as u64)
    } else {
        code = video.video_run(&o, paint, (&d) as u64)
    }
    render.renderer_free(&d.rd)
    anim.camkeys_free(&d.keys)
    anim.timeline_free(&d.tl)
    scene.scene_free(&d.sc)
    return code
}
