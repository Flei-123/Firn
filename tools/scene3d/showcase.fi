import jobs.jobs
import scene3d.vec3
import scene3d.camera
import scene3d.geom
import scene3d.material
import scene3d.light
import scene3d.scene
import scene3d.surface
import scene3d.render
import scene3d.tonemap
import scene3d.video
import scene3d.video_opts

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    return 0
}

struct Showcase {
    sc: scene.Scene,
    rd: render.Renderer,
    cam: camera.Camera,
}

fn rgba(r: i32, g: i32, b: i32) -> u32 {
    return (255 as u32) << 24 as u32 | (b as u32) << 16 as u32 | (g as u32) << 8 as u32 | (r as u32)
}

fn fill_rect(s: *mut surface.Surface, x0: i32, y0: i32, x1: i32, y1: i32, c: u32) {
    var y: i32 = y0
    while y < y1 {
        var x: i32 = x0
        while x < x1 {
            surface.surface_set(s, x, y, c)
            x = x + 1
        }
        y = y + 1
    }
}

fn make_glyph_texture(s: *mut scene.Scene) -> i32 {
    let id: i32 = scene.scene_add_texture(s, 64, 64)
    let t: *mut surface.Surface = scene.scene_texture(s, id)
    fill_rect(t, 0, 0, 64, 64, rgba(40, 70, 140))
    fill_rect(t, 16, 12, 24, 52, rgba(245, 245, 245))
    fill_rect(t, 16, 12, 48, 20, rgba(245, 245, 245))
    fill_rect(t, 16, 28, 40, 36, rgba(245, 245, 245))
    fill_rect(t, 0, 0, 8, 8, rgba(230, 40, 40))
    fill_rect(t, 56, 56, 64, 64, rgba(40, 200, 60))
    return id
}

fn make_checker_texture(s: *mut scene.Scene) -> i32 {
    let id: i32 = scene.scene_add_texture(s, 64, 64)
    let t: *mut surface.Surface = scene.scene_texture(s, id)
    fill_rect(t, 0, 0, 32, 32, rgba(205, 205, 200))
    fill_rect(t, 32, 32, 64, 64, rgba(205, 205, 200))
    fill_rect(t, 32, 0, 64, 32, rgba(70, 72, 80))
    fill_rect(t, 0, 32, 32, 64, rgba(70, 72, 80))
    return id
}

fn add_obj(sc: *mut scene.Scene, mesh_id: i32, mat_id: i32, x: f64, y: f64, z: f64) -> i32 {
    let n: i32 = scene.scene_add_mesh_node(sc, 0 - 1, mesh_id, mat_id)
    scene.node_set_pos(scene.scene_node(sc, n), vec3.v3(x, y, z))
    return n
}

fn metal_rough(i: i32) -> f64 {
    if i == 1 || i == 3 { return 0.45 }
    if i == 5 { return 0.8 }
    return 0.1
}

fn build_scene(sc: *mut scene.Scene) {
    let ball: i32 = scene.scene_add_mesh(sc, geom.geom_sphere(0.9, 48, 32))
    let box1: i32 = scene.scene_add_mesh(sc, geom.geom_box(1.6, 1.6, 1.6))
    let gbox: i32 = scene.scene_add_mesh(sc, geom.geom_box(1.7, 1.7, 1.7))
    let plane: i32 = scene.scene_add_mesh(sc, geom.geom_plane(120.0, 120.0, 1, 1))
    let pillar: i32 = scene.scene_add_mesh(sc, geom.geom_cylinder(0.5, 0.5, 6.0, 20, false))
    let gold: vec3.V3 = vec3.v3(1.0, 0.72, 0.30)
    let chrome: vec3.V3 = vec3.v3(0.62, 0.63, 0.64)
    let copper: vec3.V3 = vec3.v3(0.95, 0.60, 0.46)
    var i: i32 = 0
    while i < 6 {
        var col: vec3.V3 = gold
        if i >= 2 { col = chrome }
        if i >= 4 { col = copper }
        let m: i32 = scene.scene_add_material(sc, material.mat_standard(col, 1.0, metal_rough(i)))
        add_obj(sc, ball, m, 0.0 - 6.25 + 2.5 * (i as f64), 0.9, 0.0 - 1.0)
        i = i + 1
    }
    let red: i32 = scene.scene_add_material(sc, material.mat_standard(vec3.v3(0.75, 0.08, 0.06), 0.0, 0.3))
    let white: i32 = scene.scene_add_material(sc, material.mat_standard(vec3.v3(0.8, 0.8, 0.78), 0.0, 0.7))
    let glass: i32 = scene.scene_add_material(sc, material.mat_glass(vec3.v3(0.85, 0.95, 1.0), 0.12))
    let gtex: i32 = make_glyph_texture(sc)
    let ctex: i32 = make_checker_texture(sc)
    let texm: i32 = scene.scene_add_material(sc, material.mat_textured(gtex))
    let ground: i32 = scene.scene_add_material(sc, material.mat_tiled(material.mat_textured(ctex), 30.0))
    add_obj(sc, plane, ground, 0.0, 0.0, 0.0)
    add_obj(sc, ball, red, 0.0 - 6.0, 0.9, 3.0)
    add_obj(sc, ball, white, 0.0 - 3.6, 0.9, 3.0)
    add_obj(sc, ball, glass, 0.0 - 1.2, 0.9, 3.0)
    let gb: i32 = add_obj(sc, gbox, glass, 1.4, 0.85, 3.0)
    scene.node_set_euler(scene.scene_node(sc, gb), 0.0, 0.5, 0.0)
    let tb: i32 = add_obj(sc, box1, texm, 4.2, 0.8, 3.0)
    scene.node_set_euler(scene.scene_node(sc, tb), 0.0, 0.0 - 0.35, 0.0)
    let pm: i32 = scene.scene_add_material(sc, material.mat_standard(vec3.v3(0.7, 0.68, 0.64), 0.0, 0.8))
    var k: i32 = 0
    while k < 9 {
        let z: f64 = 0.0 - 6.0 - 6.0 * (k as f64)
        add_obj(sc, pillar, pm, 0.0 - 9.0, 3.0, z)
        add_obj(sc, pillar, pm, 9.0, 3.0, z)
        k = k + 1
    }
    scene.scene_add_light(sc, light.light_dir(vec3.v3_norm(vec3.v3(0.5, 1.0, 0.6)), vec3.v3(1.0, 0.95, 0.88), 2.0))
    scene.scene_add_light(sc, light.light_dir(vec3.v3_norm(vec3.v3(0.0 - 0.7, 0.3, 0.5)), vec3.v3(0.5, 0.6, 0.9), 0.5))
    (*sc).hemi_sky = vec3.v3(0.45, 0.55, 0.78)
    (*sc).hemi_ground = vec3.v3(0.20, 0.17, 0.14)
    (*sc).bg_top = vec3.v3(0.10, 0.22, 0.50)
    (*sc).bg_bottom = vec3.v3(0.62, 0.72, 0.85)
}

fn paint(ctx: u64, frame: u64, t: f64, sf: *mut surface.Surface) {
    let d: *mut Showcase = ctx as *mut Showcase
    let variant: i32 = (t + 0.5) as i32
    (*d).sc.fog.on = variant >= 2
    if variant % 2 == 1 {
        scene.scene_set_tonemap(&(*d).sc, tonemap.TONEMAP_ACES)
    } else {
        scene.scene_set_tonemap(&(*d).sc, tonemap.TONEMAP_NONE)
    }
    (*d).sc.fog.color = vec3.v3(0.62, 0.72, 0.85)
    (*d).sc.fog.near = 10.0
    (*d).sc.fog.far = 70.0
    (*d).cam.pos = vec3.v3(0.0, 3.4, 13.0)
    (*d).cam.target = vec3.v3(0.0, 1.0, 0.0)
    (*d).cam.fov = 38.0
    render.render(&(*d).rd, &(*d).sc, &(*d).cam, sf)
}

fn main(start: u64) -> i32 {
    var o: video_opts.VideoOpts = video_opts.video_opts_default()
    let rc: i32 = video_opts.video_parse_args(&o, "showcase", "scene3d material showcase (--still 0..3 selects variant)", start)
    if rc >= 0 { return rc }
    var d: Showcase = Showcase {
        sc: scene.scene_new(),
        rd: render.renderer_new(o.width, o.height, o.ss, o.threads),
        cam: camera.cam_new(o.width, o.height),
    }
    build_scene(&d.sc)
    var code: i32 = 0
    if o.has_still {
        code = video.video_still(&o, paint, (&d) as u64)
    } else {
        code = video.video_run(&o, paint, (&d) as u64)
    }
    render.renderer_free(&d.rd)
    scene.scene_free(&d.sc)
    return code
}
