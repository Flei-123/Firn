import std.io
import std.time
import jobs.jobs
import scene3d.vec3
import scene3d.camera
import scene3d.geom
import scene3d.material
import scene3d.light
import scene3d.scene
import scene3d.surface
import scene3d.render
import scene3d.render_setup
import scene3d.video_opts

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    return 0
}

fn put_spheres(sc: *mut scene.Scene, count: i32) {
    let ball: i32 = scene.scene_add_mesh(sc, geom.geom_sphere(1.0, 64, 48))
    let solid: i32 = scene.scene_add_material(sc, material.mat_standard(vec3.rgb_hex(0xd04040), 0.0, 0.5))
    let glass: i32 = scene.scene_add_material(sc, material.mat_glass(vec3.rgb_hex(0x60a0ff), 0.4))
    var i: i32 = 0
    while i < count {
        var mat: i32 = solid
        if i % 3 == 0 { mat = glass }
        let n: i32 = scene.scene_add_mesh_node(sc, 0 - 1, ball, mat)
        let gx: f64 = ((i % 10) as f64) * 2.2 - 10.0
        let gy: f64 = ((i / 10) as f64) * 2.2 - 3.0
        scene.node_set_pos(scene.scene_node(sc, n), vec3.v3(gx, gy, ((i % 7) as f64) * 0.6))
        i = i + 1
    }
}

fn report(label: str, v: i64) {
    var f: io.Fmt = io.fmt_new()
    f = io.fmt_text(f, label.p as u64, label.n)
    f = io.fmt_number(f, v)
    io.fmt_print_line(f)
}

#[allow_escape]
fn main(start: u64) -> i32 {
    var o: video_opts.VideoOpts = video_opts.video_opts_default()
    let rc: i32 = video_opts.video_parse_args(&o, "bench", "scene3d render bench", start)
    if rc >= 0 { return rc }
    var sc: scene.Scene = scene.scene_new()
    put_spheres(&sc, 30)
    scene.scene_add_light(&sc, light.light_dir(vec3.v3_norm(vec3.v3(0.5, 1.0, 0.7)), vec3.v3(1.0, 0.97, 0.9), 2.5))
    var cam: camera.Camera = camera.cam_new(o.width, o.height)
    cam.pos = vec3.v3(0.0, 4.0, 26.0)
    var rd: render.Renderer = render.renderer_new(o.width, o.height, o.ss, o.threads)
    var sf: surface.Surface = surface.surface_new(o.width, o.height)
    var frames: i32 = (o.duration * (o.fps as f64)) as i32
    if frames < 1 { frames = 1 }
    render.render(&rd, &sc, &cam, &sf)
    var best_frame: u64 = 0 - 1
    var best_setup: u64 = 0 - 1
    var i: i32 = 0
    while i < frames {
        let t0: u64 = time.monotonic_ns()
        render.render(&rd, &sc, &cam, &sf)
        let dt: u64 = time.monotonic_ns() - t0
        if dt < best_frame { best_frame = dt }
        i = i + 1
    }
    scene.scene_update(&sc)
    i = 0
    while i < frames {
        let t0: u64 = time.monotonic_ns()
        render_setup.setup_frame(&rd, &sc, &cam)
        let dt: u64 = time.monotonic_ns() - t0
        if dt < best_setup { best_setup = dt }
        i = i + 1
    }
    report("tris ", rd.tris.len as i64)
    report("best_frame_us ", (best_frame / (1000 as u64)) as i64)
    report("best_setup_us ", (best_setup / (1000 as u64)) as i64)
    render.renderer_free(&rd)
    surface.surface_free(&sf)
    scene.scene_free(&sc)
    return 0
}
