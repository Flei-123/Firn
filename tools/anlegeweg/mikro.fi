// tools/anlegeweg/mikro.fi -- WHAT THE 161 NANOSECONDS OF AN ALLOCATION
// ARE MADE OF (round ANLEGEWEG).
//
// Round TEMPO2 measured that allocating one object in the heap costs
// 161 ns -- the same value with AND without the collector running. This
// file takes the number apart. It measures the elementary operations ONE
// BY ONE in a tight loop, millions of times each, in the SAME build:
//
//    0  idle (the loop alone)                  -- the base to subtract
//    1  call an empty function                 -- the plain call
//    2  __gc_ld64  (call + load)               -- the read helper
//    3  read a word DIRECTLY (no call)         -- the load alone
//    4  __gc_st64  (call + store)
//    5  write a word DIRECTLY
//    6  __gc_class_for(24)                     -- the size class
//    7  __gc_classes_bytes(0)
//    8  __gc_diag_inc                          -- one diagnostic counter
//    9  null three words through __gc_st64     -- the payload
//   10  null the same three words directly
//   11  __gc_now_ns()                          -- the clock
//   12  ALLOCATE ONE OBJECT (24 octets)        <<<< the number
//   13  ALLOCATE ONE OBJECT (56 octets, class 2)
//   14  allocate an environment of four objects
//   16  __gc_alloc_raw directly (without the error union)
//   15  allocate with 8192 objects kept alive
//
// The numbers are RAW, exactly as in tools/tempo2/mikro_main.fi of round
// TEMPO2: the idle loop is NOT subtracted, so the values are comparable
// with that report. Item 0 says what the loop itself costs.
//
// Run it through tools/anlegeweg/mikro.sh. The build time variable
// FIRN_AW_ENTFESSELT=1 sets the collection limit so high that nothing is
// ever collected during the measurement (the counter-check from TEMPO2).
import dom.meas

// Set by mikro.sh: measure without any collector work.
const UNFETTERED: bool = __env_has("FIRN_AW_ENTFESSELT")
// Rounds per item.
const ROUNDS: u64 = 5000000

gc class Cell {
    a: u64,
    b: u64,
    c: u64,
}

gc class Cell7 {
    a: u64,
    b: u64,
    c: u64,
    d: u64,
    e: u64,
    f: u64,
    g: u64,
}

fn __gc_finalize(kind: u64, p: *mut u8) {
}

#[no_gc]
fn nanos() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000000 + (ts[1] as u64)
}

fn empty(x: u64) -> u64 {
    return x + 1
}

// A name, padded out, then the nanoseconds with three decimals -- at 5 ns
// per piece a whole number would not be enough.
fn show(name: *mut u8, n: u64, ns: u64, rounds: u64) {
    meas.meas_write(name as u64, n as i64)
    var i: u64 = n
    while i < 34 {
        meas.meas_char(32 as u8)
        i = i + 1
    }
    let ps: u64 = ns * 1000 / rounds
    meas.meas_u64(ps / 1000)
    meas.meas_char(46 as u8)
    let r: u64 = ps % 1000
    if r < 100 {
        meas.meas_char(48 as u8)
    }
    if r < 10 {
        meas.meas_char(48 as u8)
    }
    meas.meas_u64(r)
    var e: [u8; 3] = " ns"
    meas.meas_write((&e) as u64, 3)
    meas.meas_nl()
}

fn main() -> i32 {
    if !gc_init() {
        return 9
    }
    gc_set_max_bytes(6442450944)
    if UNFETTERED {
        gc_set_limit(1152921504606846976)
    }
    return measure()
}

#[allow_escape]
fn measure() -> i32 {
    let st: u64 = __gc_state() as u64
    // A scratch word inside the state block that means nothing: S_TIME is
    // the buffer of the clock and is overwritten by every __gc_now_ns()
    // anyway.
    let scratch: u64 = st + 152
    var acc: u64 = 0
    var i: u64 = 0

    // 0. the idle loop
    var t0: u64 = nanos()
    i = 0
    while i < ROUNDS {
        acc = acc ^ i
        i = i + 1
    }
    var t1: u64 = nanos()
    let idle: u64 = t1 - t0
    var m0: [u8; 13] = "0 idle (loop)"
    show(&m0[0], 13, idle, ROUNDS)

    // 1. an empty function
    t0 = nanos()
    i = 0
    while i < ROUNDS {
        acc = acc ^ empty(i)
        i = i + 1
    }
    t1 = nanos()
    var m1: [u8; 21] = "1 call empty function"
    show(&m1[0], 21, t1 - t0, ROUNDS)

    // 2. __gc_ld64
    t0 = nanos()
    i = 0
    while i < ROUNDS {
        acc = acc ^ __gc_ld64(scratch)
        i = i + 1
    }
    t1 = nanos()
    var m2: [u8; 18] = "2 __gc_ld64 (call)"
    show(&m2[0], 18, t1 - t0, ROUNDS)

    // 3. read directly
    t0 = nanos()
    i = 0
    while i < ROUNDS {
        acc = acc ^ *(scratch as *mut u64)
        i = i + 1
    }
    t1 = nanos()
    var m3: [u8; 20] = "3 read word directly"
    show(&m3[0], 20, t1 - t0, ROUNDS)

    // 4. __gc_st64
    t0 = nanos()
    i = 0
    while i < ROUNDS {
        __gc_st64(scratch, i)
        i = i + 1
    }
    t1 = nanos()
    var m4: [u8; 18] = "4 __gc_st64 (call)"
    show(&m4[0], 18, t1 - t0, ROUNDS)

    // 5. write directly
    t0 = nanos()
    i = 0
    while i < ROUNDS {
        *(scratch as *mut u64) = i
        i = i + 1
    }
    t1 = nanos()
    var m5: [u8; 21] = "5 write word directly"
    show(&m5[0], 21, t1 - t0, ROUNDS)

    // 6. __gc_class_for(24)
    t0 = nanos()
    i = 0
    while i < ROUNDS {
        acc = acc ^ __gc_class_for(24)
        i = i + 1
    }
    t1 = nanos()
    var m6: [u8; 20] = "6 __gc_class_for(24)"
    show(&m6[0], 20, t1 - t0, ROUNDS)

    // 6b. __gc_class_for(200) -- six rounds through the old loop
    t0 = nanos()
    i = 0
    while i < ROUNDS {
        acc = acc ^ __gc_class_for(200)
        i = i + 1
    }
    t1 = nanos()
    var m6b: [u8; 22] = "6b __gc_class_for(200)"
    show(&m6b[0], 22, t1 - t0, ROUNDS)

    // 7. __gc_classes_bytes(0)
    t0 = nanos()
    i = 0
    while i < ROUNDS {
        acc = acc ^ __gc_classes_bytes(0)
        i = i + 1
    }
    t1 = nanos()
    var m7: [u8; 23] = "7 __gc_classes_bytes(0)"
    show(&m7[0], 23, t1 - t0, ROUNDS)

    // 8. __gc_diag_inc -- one diagnostic counter
    t0 = nanos()
    i = 0
    while i < ROUNDS {
        __gc_diag_inc(1528)
        i = i + 1
    }
    t1 = nanos()
    var m8: [u8; 15] = "8 __gc_diag_inc"
    show(&m8[0], 15, t1 - t0, ROUNDS)

    // 9. null three words through __gc_st64 (the payload of 24 octets)
    t0 = nanos()
    i = 0
    while i < ROUNDS {
        var k: u64 = 0
        while k < 24 {
            __gc_st64(scratch + k, 0)
            k = k + 8
        }
        i = i + 1
    }
    t1 = nanos()
    var m9: [u8; 25] = "9 null 24 octets (helper)"
    show(&m9[0], 25, t1 - t0, ROUNDS)

    // 10. the same three words directly
    t0 = nanos()
    i = 0
    while i < ROUNDS {
        var k: u64 = 0
        while k < 24 {
            *((scratch + k) as *mut u64) = 0
            k = k + 8
        }
        i = i + 1
    }
    t1 = nanos()
    var m10: [u8; 26] = "10 null 24 octets (direct)"
    show(&m10[0], 26, t1 - t0, ROUNDS)

    // 11. the clock. Only a tenth of the rounds -- a system call is dear.
    let clock_rounds: u64 = ROUNDS / 10
    t0 = nanos()
    i = 0
    while i < clock_rounds {
        acc = acc ^ __gc_now_ns()
        i = i + 1
    }
    t1 = nanos()
    var m11: [u8; 16] = "11 __gc_now_ns()"
    show(&m11[0], 16, t1 - t0, clock_rounds)

    // 12. ALLOCATE ONE OBJECT, 24 octets (class 0)
    t0 = nanos()
    i = 0
    while i < ROUNDS {
        let z = gc Cell { a: i, b: 0, c: 0 } catch gc_null[Cell]()
        if z != gc_null[Cell]() {
            acc = acc ^ z.a
        }
        i = i + 1
    }
    t1 = nanos()
    var m12: [u8; 21] = "12 ALLOCATE 24 octets"
    show(&m12[0], 21, t1 - t0, ROUNDS)

    // 13. ALLOCATE ONE OBJECT, 56 octets (class 2)
    t0 = nanos()
    i = 0
    while i < ROUNDS {
        let z = gc Cell7 { a: i, b: 0, c: 0, d: 0, e: 0, f: 0, g: 0 } catch gc_null[Cell7]()
        if z != gc_null[Cell7]() {
            acc = acc ^ z.a
        }
        i = i + 1
    }
    t1 = nanos()
    var m13: [u8; 21] = "13 ALLOCATE 56 octets"
    show(&m13[0], 21, t1 - t0, ROUNDS)

    // 14. four objects in a row -- the pattern of val.env_new
    t0 = nanos()
    i = 0
    while i < ROUNDS {
        let a = gc Cell { a: i, b: 0, c: 0 } catch gc_null[Cell]()
        let b = gc Cell { a: i, b: 0, c: 0 } catch gc_null[Cell]()
        let c = gc Cell { a: i, b: 0, c: 0 } catch gc_null[Cell]()
        let d = gc Cell { a: i, b: 0, c: 0 } catch gc_null[Cell]()
        if a != gc_null[Cell]() && b != gc_null[Cell]() && c != gc_null[Cell]() && d != gc_null[Cell]() {
            acc = acc ^ a.a ^ b.a ^ c.a ^ d.a
        }
        i = i + 1
    }
    t1 = nanos()
    var m14: [u8; 25] = "14 four objects (one env)"
    show(&m14[0], 25, t1 - t0, ROUNDS)

    // 16. THE SAME PATH WITHOUT THE SHELL: the runtime call straight away,
    // without the error union, without `catch`, without the null check.
    // The gap to item 12 is what LOWERING an allocation costs -- not the
    // collector.
    t0 = nanos()
    i = 0
    while i < ROUNDS {
        acc = acc ^ (__gc_alloc_raw(1, 24) as u64)
        i = i + 1
    }
    t1 = nanos()
    var m16: [u8; 24] = "16 __gc_alloc_raw(1, 24)"
    show(&m16[0], 24, t1 - t0, ROUNDS)

    // 15. WITH A LIVE SET: a ring of 8192 objects stays alive, every
    // allocation displaces the oldest. That is the case a real program
    // has -- the collector has to mark 8192 objects on every run instead
    // of sweeping an empty heap.
    var ring: [Gc[Cell]; 8192] = [gc_null[Cell](); 8192]
    t0 = nanos()
    i = 0
    while i < ROUNDS {
        let z = gc Cell { a: i, b: 0, c: 0 } catch gc_null[Cell]()
        ring[(i & 8191) as usize] = z
        i = i + 1
    }
    t1 = nanos()
    var m15: [u8; 27] = "15 ALLOCATE with 8192 alive"
    show(&m15[0], 27, t1 - t0, ROUNDS)
    if ring[0] != gc_null[Cell]() {
        acc = acc ^ ring[0].a
    }

    // The collector's figures at the end: runs, heap, total.
    var mz: [u8; 10] = "Z runs    "
    meas.meas_write((&mz) as u64, 10)
    meas.meas_u64(gc_collections())
    var mh: [u8; 7] = "  heap "
    meas.meas_write((&mh) as u64, 7)
    meas.meas_u64(gc_heap_bytes())
    var mt: [u8; 8] = "  total "
    meas.meas_write((&mt) as u64, 8)
    meas.meas_u64(gc_total_bytes())
    var ma: [u8; 8] = "  alloc "
    meas.meas_write((&ma) as u64, 8)
    meas.meas_u64(gc_diag(6))
    var mc: [u8; 9] = "  chunks "
    meas.meas_write((&mc) as u64, 9)
    meas.meas_u64(gc_diag(0) + gc_diag(1) + gc_diag(2))
    meas.meas_nl()
    // So that nothing is optimised away.
    if acc == 123456789 {
        return 1
    }
    return 0
}
