// tools/pycoll_cross/pycoll_tool.fi -- command line face of std.pycoll for the
// cross-check against Python (tools/pycoll_cross/run.sh).
//
//   pycoll_tool FILE   rows per line, TAB separated: REGION AMOUNT N
//   -> for each of f+ f- i+ i- s+ s- : the row ids (input line numbers) after
//      the stable sort, then the groups, the counts and sorted(counts.items()).
import std.pycoll
import std.dict
import std.fs
import std.io
import std.rt
import std.str
import std.vec
import std.num

struct Row { region: str, amount: f64, n: i64, id: i64 }

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn field(line: str, k: usize) -> str {
    var start: usize = 0
    var idx: usize = 0
    var i: usize = 0
    while i <= line.length() {
        if i == line.length() || *(((line.p as u64) + i as u64) as *mut u8) == (9 as u8) {
            if idx == k {
                return str { p: ((line.p as u64) + start as u64) as *mut u8, n: i - start }
            }
            idx = idx + 1
            start = i + 1
        }
        i = i + 1
    }
    return str { p: line.p, n: 0 }
}

fn region_of(r: *Row) -> str { return (*r).region }
fn amount_of(r: *Row) -> f64 { return (*r).amount }
fn n_of(r: *Row) -> i64 { return (*r).n }

fn dump(tag: str, v: *mut Vec[Row]) {
    var b: rt.Buf = rt.buf_new()
    for i in 0..vec_len[Row](v) {
        io.fmt_content(f" {(*vec_elem_ptr[Row](v, i)).id}", &b)
    }
    let body: str = str { p: rt.buf_data(&b), n: rt.buf_len(&b) }
    io.fmt_print_line(f"{tag}{body}")
    rt.buf_free(&b)
}

#[allow_escape]
fn main(start: u64) -> i32 {
    if !gc_init() { return 1 }
    var b: rt.Buf = rt.buf_new()
    fs.read_file(arg(start, 1), &b) catch 0
    var rows: Vec[Row] = vec_new[Row]()
    var pos: usize = 0
    let total: usize = rt.buf_len(&b)
    while pos < total {
        var e: usize = pos
        while e < total && rt.buf_at(&b, e) != (10 as u8) { e = e + 1 }
        let line: str = __str_copy(str { p: ((rt.buf_ptr(&b)) + pos as u64) as *mut u8, n: e - pos })
        pos = e + 1
        let am: str = field(line, 1)
        let nn: str = field(line, 2)
        vec_push[Row](&rows, Row { region: field(line, 0),
                amount: num.f64_or(num.parse_f64(str.span(am.p, am.length())), 0.0),
                n: num.parse_i64(str.span(nn.p, nn.length())).value, id: vec_len[Row](&rows) as i64 })
    }
    var w: Vec[Row] = vec_new[Row]()
    for pass in 0..6 {
        vec_clear[Row](&w)
        for i in 0..vec_len[Row](&rows) { vec_push[Row](&w, *vec_elem_ptr[Row](&rows, i)) }
        if pass == 0 { sort_key_f64[Row](&w, amount_of, false); dump("f+", &w) }
        if pass == 1 { sort_key_f64[Row](&w, amount_of, true); dump("f-", &w) }
        if pass == 2 { sort_key_i64[Row](&w, n_of, false); dump("i+", &w) }
        if pass == 3 { sort_key_i64[Row](&w, n_of, true); dump("i-", &w) }
        if pass == 4 { sort_key_str[Row](&w, region_of, false); dump("s+", &w) }
        if pass == 5 { sort_key_str[Row](&w, region_of, true); dump("s-", &w) }
    }
    var groups: Dict[Vec[Row]] = dict_new[Vec[Row]]()
    group_by[Row](&rows, region_of, &groups)
    var i: usize = dict_first[Vec[Row]](&groups)
    while i != dict_end[Vec[Row]](&groups) {
        dump(io.fmt_string(f"g {dict_key[Vec[Row]](&groups, i)}\t"), dict_val_ptr_at[Vec[Row]](&groups, i))
        i = dict_next[Vec[Row]](&groups, i + 1)
    }
    groups_free[Row](&groups)
    var cnt: Dict[i64] = dict_new[i64]()
    count_by[Row](&rows, region_of, &cnt)
    var items: Vec[DictItem[i64]] = vec_new[DictItem[i64]]()
    dict_items_sorted[i64](&cnt, &items)
    for k in 0..vec_len[DictItem[i64]](&items) {
        let it = *vec_elem_ptr[DictItem[i64]](&items, k)
        io.fmt_print_line(f"c {it.key}\t{it.val}")
    }
    var vals: Vec[i64] = vec_new[i64]()
    dict_values[i64](&cnt, &vals)
    var s: i64 = 0
    for k in 0..vec_len[i64](&vals) { s = s + *vec_elem_ptr[i64](&vals, k) }
    io.fmt_print_line(f"values {vec_len[i64](&vals)} {s}")
    dict_free[i64](&cnt)
    return 0
}
