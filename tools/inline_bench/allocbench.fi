// expect_exit: 0
// tools/inline_bench/allocbench.fi -- ROUND INLINE: the allocation path on
// its own, so that instructions PER ALLOCATION can be counted.
//
// 480,000 allocations of ONE 24 byte class and nothing else -- the same
// microbench round SAMMLER used (there: 140,018,126 Ir before, 112,717,058
// after, 153 instructions per allocation for alloc_raw + get_block +
// class_for).
//
// Deterministic, no clock in the load.

import dom.meas

gc class Small {
    a: u64,
    b: u64,
}

const ALLOCS: u64 = 480000

fn lcg(s: u64) -> u64 {
    return s *% 6364136223846793005 +% 1442695040888963407
}

fn run() -> AllocError!u64 {
    var i: u64 = 0
    var s: u64 = 1
    var acc: u64 = 0
    while i < ALLOCS {
        let o: Gc[Small] = try gc Small { a: s & 255, b: (s >> 8) & 255 }
        acc = acc + o.a
        s = lcg(s)
        i = i + 1
    }
    return acc
}

fn main() -> i32 {
    let acc: u64 = run() catch 0
    meas.meas_u64(acc)
    meas.meas_nl()
    return 0
}
