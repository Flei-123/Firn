// tools/textlibs_cross/fuzzytool.fi -- command line face of text.fuzzy for the
// cross-check against a Python reference (fuzzy_cross.py). stdin, one line each:
//
//   M MODE<TAB>PATTERN<TAB>TEXT           -> "SCORE P0,P1,..." (character positions) or "NO"
//   R MODE<TAB>PATTERN<TAB>ITEM<TAB>ITEM... -> the ranked item indices, space separated ("" = none)
// MODE: 0 smart, 1 ignore, 2 respect.
import std.rt
import std.vec
import text.fuzzy

fn field(line: str, k: usize) -> str {
    var start: usize = 0
    var idx: usize = 0
    var i: usize = 0
    while i <= line.n {
        if i == line.n || rt.ld8(line.p as u64, i) == 9 as u8 {
            if idx == k {
                return str { p: (line.p as u64 + start as u64) as *u8, n: i - start }
            }
            idx = idx + 1
            start = i + 1
        }
        i = i + 1
    }
    return str { p: line.p, n: 0 }
}

fn fields(line: str) -> usize {
    var c: usize = 1
    var i: usize = 0
    while i < line.n {
        if rt.ld8(line.p as u64, i) == 9 as u8 {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn handle(line: str, out: *mut rt.Buf) {
    let c: u8 = rt.ld8(line.p as u64, 0)
    let mode: u32 = (rt.ld8(line.p as u64, 2) - 48 as u8) as u32
    // after "X M" comes a TAB
    let rest: str = str { p: (line.p as u64 + 3) as *u8, n: line.n - 3 }
    let pattern: str = field(rest, 1 - 1)
    if c == 77 as u8 {
        let text: str = field(rest, 1)
        var m: fuzzy.Match = fuzzy.match_new()
        if fuzzy.match_text(pattern, text, mode, &m) {
            rt.buf_push_dec_i64(out, m.score)
            rt.buf_push(out, 32 as u8)
            var k: usize = 0
            while k < fuzzy.match_count(&m) {
                if k > 0 {
                    rt.buf_push(out, 44 as u8)
                }
                rt.buf_push_dec_u64(out, fuzzy.match_pos(&m, k) as u64)
                k = k + 1
            }
        } else {
            rt.buf_push_bytes(out, "NO".p as u64, 2)
        }
        fuzzy.match_free(&m)
    } else if c == 82 as u8 {
        var items: Vec[str] = vec_new[str]()
        var k: usize = 1
        let nf: usize = fields(rest)
        while k < nf {
            vec_push[str](&items, field(rest, k))
            k = k + 1
        }
        var order: Vec[usize] = vec_new[usize]()
        fuzzy.rank(pattern, &items, mode, &order)
        k = 0
        while k < vec_len[usize](&order) {
            if k > 0 {
                rt.buf_push(out, 32 as u8)
            }
            rt.buf_push_dec_u64(out, vec_at[usize](&order, k) as u64)
            k = k + 1
        }
        vec_free[usize](&order)
        vec_free[str](&items)
    }
    rt.buf_push(out, 10 as u8)
}

fn main(start: u64) -> i32 {
    var input: rt.Buf = rt.buf_new()
    rt.read_stdin(&input)
    var out: rt.Buf = rt.buf_new()
    var s: usize = 0
    let n: usize = rt.buf_len(&input)
    var i: usize = 0
    while i <= n {
        if i == n || rt.ld8(rt.buf_ptr(&input), i) == 10 as u8 {
            if i > s + 3 {
                handle(str { p: (rt.buf_ptr(&input) + s as u64) as *u8, n: i - s }, &out)
            }
            s = i + 1
        }
        i = i + 1
    }
    rt.write_everything(1, rt.buf_ptr(&out), rt.buf_len(&out))
    return 0
}
