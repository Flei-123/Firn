import std.rt
import std.io
import pg.pg

fn main() -> i32 {
    var inb: rt.Buf = rt.buf_new()
    if !io.read_stdin(&inb) { return 2 }
    var port: u16 = 0
    var i: usize = 0
    while i < inb.len {
        let d: u8 = rt.ld8(inb.ptr, i)
        if d >= 48 as u8 && d <= 57 as u8 { port = port * 10 + ((d - 48 as u8) as u16) }
        i = i + 1
    }
    var c: pg.Pg = pg.pg_new()
    if !pg.pg_connect(&c, 2130706433 as u32, port, "firn", "secretpw", "postgres", pg.TLS_OFF, "x", 0, 0, 0) { return 1 }
    var r: pg.PgResult = pg.result_new()
    let ok: bool = pg.pg_query(&c, "SET password_encryption='md5'; CREATE ROLE md5user LOGIN PASSWORD 'md5pw'; SET password_encryption='scram-sha-256'; CREATE ROLE clearuser LOGIN PASSWORD 'clearpw'", &r)
    pg.pg_close(&c)
    pg.pg_free(&c)
    if ok { return 0 }
    return 1
}
