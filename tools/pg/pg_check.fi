import std.rt
import std.io
import std.time
import pg.pg
import pg.pgrows

static mut fails: u32 = 0

fn check(ok: bool, code: u32) {
    if !ok {
        fails = fails + 1
        var b: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&b, "FAIL ".p as u64, 5)
        rt.buf_push_dec_u64(&b, code as u64)
        rt.buf_push(&b, 10 as u8)
        io.print_bytes(b.ptr, b.len)
        rt.buf_free(&b)
    }
}

fn value_is(r: *mut pgrows.PgResult, row: usize, col: usize, s: str) -> bool {
    var p: u64 = 0
    var n: usize = 0
    if !pgrows.result_value(r, row, col, &p, &n) { return false }
    return n == s.n && rt.mem_eq(p, s.p as u64, n)
}

fn is_null(r: *mut pgrows.PgResult, row: usize, col: usize) -> bool {
    var p: u64 = 0
    var n: usize = 0
    return !pgrows.result_value(r, row, col, &p, &n)
}

fn field(buf: *mut rt.Buf, idx: usize, out: *mut rt.Buf) {
    var line: usize = 0
    var i: usize = 0
    rt.buf_clear(out)
    while i < (*buf).len {
        let b: u8 = rt.ld8((*buf).ptr, i)
        if b == 10 as u8 {
            line = line + 1
        } else if line == idx {
            rt.buf_push(out, b)
        }
        i = i + 1
    }
}

fn to_u16(b: *mut rt.Buf) -> u16 {
    var v: u16 = 0
    var i: usize = 0
    while i < (*b).len {
        v = v * 10 + ((rt.ld8((*b).ptr, i) - 48 as u8) as u16)
        i = i + 1
    }
    return v
}

fn run_session(c: *mut pg.Pg) {
    var r: pgrows.PgResult = pgrows.result_new()
    check(pg.pg_query(c, "SELECT 1+1 AS two, 'héllo' AS word, NULL::text AS nothing", &r), 10)
    check(pgrows.result_nrows(&r) == 1 && pgrows.result_ncols(&r) == 3, 11)
    check(value_is(&r, 0, 0, "2") && value_is(&r, 0, 1, "héllo") && is_null(&r, 0, 2), 12)
    let nm: str = pgrows.result_col_name(&r, 1)
    check(nm.n == 4 && rt.mem_eq(nm.p as u64, "word".p as u64, 4), 13)
    check(pgrows.result_col_oid(&r, 0) == 23 as u32, 14)
    check(pg.pg_query(c, "CREATE TEMP TABLE t (id int, name text, note text)", &r), 15)
    var q: pgrows.PgParams = pgrows.params_new()
    pgrows.params_text(&q, "7".p as u64, 1)
    pgrows.params_text(&q, "Zoë 'quoted'".p as u64, 13)
    pgrows.params_null(&q)
    check(pg.pg_query_params(c, "INSERT INTO t VALUES ($1, $2, $3)", &q, &r), 16)
    check(rt.mem_eq(pgrows.result_tag(&r).p as u64, "INSERT 0 1".p as u64, 10), 17)
    check(pg.pg_query(c, "SELECT id, name, note FROM t", &r), 18)
    check(value_is(&r, 0, 0, "7") && value_is(&r, 0, 1, "Zoë 'quoted'") && is_null(&r, 0, 2), 19)
    check(!pg.pg_query(c, "SELEC nonsense", &r), 20)
    check(rt.mem_eq(pg.pg_error_code(c), "42601".p as u64, 5), 21)
    check(pg.pg_is_open(c) && pg.pg_query(c, "SELECT 5", &r) && value_is(&r, 0, 0, "5"), 22)
    check(pg.pg_prepare(c, "ins", "INSERT INTO t VALUES ($1, $2, $3)"), 23)
    var k: u32 = 0
    while k < 100 {
        pgrows.params_clear(&q)
        var num: rt.Buf = rt.buf_new()
        rt.buf_push_dec_u64(&num, (100 + k) as u64)
        pgrows.params_text(&q, num.ptr, num.len)
        pgrows.params_text(&q, num.ptr, num.len)
        pgrows.params_text(&q, "".p as u64, 0)
        check(pg.pg_exec_prepared(c, "ins", &q, &r), 24)
        rt.buf_free(&num)
        k = k + 1
    }
    check(pg.pg_query(c, "SELECT count(*), sum(id) FROM t", &r), 25)
    check(value_is(&r, 0, 0, "101") && value_is(&r, 0, 1, "14957"), 26)
    check(pg.pg_deallocate(c, "ins"), 27)
    check(!pg.pg_exec_prepared(c, "ins", &q, &r), 28)
    check(rt.mem_eq(pg.pg_error_code(c), "26000".p as u64, 5), 29)
    check(pg.pg_query(c, "BEGIN", &r) && pg.pg_txn_status(c) == 84 as u8, 30)
    check(pg.pg_query(c, "ROLLBACK", &r) && pg.pg_txn_status(c) == 73 as u8, 31)
    check(pg.pg_query(c, "SELECT i, md5(i::text) FROM generate_series(1, 100000) i", &r), 32)
    check(pgrows.result_nrows(&r) == 100000, 33)
    check(value_is(&r, 99999, 0, "100000") && value_is(&r, 0, 1, "c4ca4238a0b923820dcc509a6f75849b"), 34)
    pgrows.params_clear(&q)
    var big: rt.Buf = rt.buf_new()
    var b: usize = 0
    while b < 1000000 {
        rt.buf_push(&big, (97 + b % 26) as u8)
        b = b + 1
    }
    pgrows.params_text(&q, big.ptr, big.len)
    check(pg.pg_query_params(c, "SELECT $1::text, length($1::text)", &q, &r), 35)
    var vp: u64 = 0
    var vn: usize = 0
    check(pgrows.result_value(&r, 0, 0, &vp, &vn) && vn == 1000000 && rt.mem_eq(vp, big.ptr, vn), 36)
    check(value_is(&r, 0, 1, "1000000"), 37)
    check(pg.pg_query(c, "SELECT 1; SELECT 2, 3", &r) && pgrows.result_ncols(&r) == 2 && value_is(&r, 0, 1, "3"), 38)
    check(pg.pg_query(c, "", &r) && pgrows.result_nrows(&r) == 0, 39)
    rt.buf_free(&big)
    pgrows.params_free(&q)
    pgrows.result_free(&r)
}

fn main() -> i32 {
    var inb: rt.Buf = rt.buf_new()
    if !io.read_stdin(&inb) { return 2 }
    var f0: rt.Buf = rt.buf_new()
    var f1: rt.Buf = rt.buf_new()
    var f2: rt.Buf = rt.buf_new()
    var f3: rt.Buf = rt.buf_new()
    var f4: rt.Buf = rt.buf_new()
    field(&inb, 0, &f0)
    field(&inb, 1, &f1)
    field(&inb, 2, &f2)
    field(&inb, 3, &f3)
    field(&inb, 4, &f4)
    let port: u16 = to_u16(&f0)
    let user: str = rt.buf_str(&f1)
    let pw: str = rt.buf_str(&f2)
    let db: str = rt.buf_str(&f3)
    var roots: rt.Buf = rt.buf_new()
    var mode: u32 = pg.TLS_OFF
    if f4.len > 0 {
        rt.buf_push(&f4, 0 as u8)
        check(io.read_file(f4.ptr, &roots), 1)
        mode = pg.TLS_REQUIRE
    }
    let now: u64 = (time.now_unix_ms() / 1000) as u64
    var bad: pg.Pg = pg.pg_new()
    check(!pg.pg_connect(&bad, 2130706433 as u32, port, user, "wrong-password", db, mode, "localhost", roots.ptr, roots.len, now), 2)
    check(rt.mem_eq(pg.pg_error_code(&bad), "28P01".p as u64, 5), 3)
    pg.pg_free(&bad)
    var c: pg.Pg = pg.pg_new()
    if pg.pg_connect(&c, 2130706433 as u32, port, user, pw, db, mode, "localhost", roots.ptr, roots.len, now) {
        run_session(&c)
        pg.pg_close(&c)
    } else {
        check(false, 4)
        io.print_line(pg.pg_error(&c))
    }
    pg.pg_free(&c)
    if fails == 0 { io.print_line("pg ok") }
    return fails as i32
}
