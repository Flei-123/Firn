import std.rt
import std.io
import pg.pg
import pg.pgrows

fn main() -> i32 {
    var inb: rt.Buf = rt.buf_new()
    if !io.read_stdin(&inb) { return 2 }
    var port: u16 = 0
    var i: usize = 0
    while i < inb.len {
        let d: u8 = rt.ld8(inb.ptr, i)
        if d >= 48 as u8 && d <= 57 as u8 { port = port * 10 + ((d - 48 as u8) as u16) }
        i = i + 1
    }
    var c: pg.Pg = pg.pg_new()
    if !pg.pg_connect(&c, 2130706433 as u32, port, "u", "p", "d", pg.TLS_OFF, "x", 0, 0, 0) { return 3 }
    var r: pgrows.PgResult = pgrows.result_new()
    var q: pgrows.PgParams = pgrows.params_new()
    pgrows.params_text(&q, "1".p as u64, 1)
    let a: bool = pg.pg_query(&c, "SELECT 1", &r)
    let b: bool = pg.pg_query_params(&c, "SELECT $1", &q, &r)
    var p: u64 = 0
    var n: usize = 0
    var row: usize = 0
    while row < pgrows.result_nrows(&r) {
        var col: usize = 0
        while col < pgrows.result_ncols(&r) {
            let v: bool = pgrows.result_value(&r, row, col, &p, &n)
            col = col + 1
        }
        row = row + 1
    }
    pgrows.params_free(&q)
    pgrows.result_free(&r)
    pg.pg_free(&c)
    return 0
}
