#[no_gc]
fn step(z: State) -> i32 {
    match z {
        State::S0 => { return 1 as i32 }
        State::S1 => { return 2 as i32 }
        _ => { return 0 as i32 }
    }
}
fn build[T: Int](x: T) -> AllocError!Gc[Node] {
    let n: Gc[Node] = try gc Node { next: gc_null[Node](), value: x }
    let e: Gc[Elem] = k.as?[Elem]
    for i in 0..10 {
        n.value = n.value + i
    }
    return n
}
