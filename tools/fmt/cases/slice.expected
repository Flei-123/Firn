import std.str
fn slices(s: str, v: i64) -> i64 {
    let a: str = s[1:3]
    let b: str = s[1:3]
    let c: str = s[2:]
    let d: str = s[:3]
    let e: str = s[:]
    let f: str = s[v - 2:]
    let g: str = s[v + 1:v + 3]
    let h: str = s[(v + 1):f(v, 2)]
    let t: [u8; 4] = ".fi\0"
    return t[1]
}
fn gen[T: Num](x: T) -> T {
    return x
}
