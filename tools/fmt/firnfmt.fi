// SPDX-License-Identifier: GPL-2.0-only
// tools/fmt/firnfmt.fi -- the command line of the Firn formatter.
//
//     firnfmt                    standard input  -> standard output
//     firnfmt file.fi            the file        -> standard output
//     firnfmt -w file.fi ...     rewrite the files in place
//     firnfmt -c file.fi ...     check only: name every file that is not
//                                in canonical shape, exit code 1
//
// Return values: 0 = fine * 1 = `-c` found a difference * 2 = input/output
// * 3 = at least one source text does not scan (unknown character, text
// literal or block comment not closed, brackets unbalanced). 3 wins over 1;
// the run does not stop at such a file, it names it on standard error and
// carries on.
import rt.rt
import fmt

// Formats `source` into `out`. false = the text does not scan.
fn shape(source: *mut rt.Buf, out: *mut rt.Buf) -> bool {
    var f: fmt.Form = fmt.form_new(rt.buf_ptr(source), rt.buf_len(source))
    defer fmt.form_free(&f)
    fmt.form_scan(&f)
    if fmt.form_broken(&f) {
        return false
    }
    fmt.form_render(&f, out)
    return true
}

fn say(text: u64, n: usize) {
    rt.write_everything(2, text, n)
}

fn complain(prefix: u64, prefix_n: usize, path: u64) {
    var b: rt.Buf = rt.buf_new()
    defer rt.buf_free(&b)
    rt.buf_push_bytes(&b, prefix, prefix_n)
    rt.buf_push_bytes(&b, path, rt.c_length(path))
    rt.buf_push(&b, 10 as u8)
    rt.write_everything(2, rt.buf_ptr(&b), rt.buf_len(&b))
}

fn same(a: *mut rt.Buf, b: *mut rt.Buf) -> bool {
    if rt.buf_len(a) != rt.buf_len(b) {
        return false
    }
    return rt.mem_eq(rt.buf_ptr(a), rt.buf_ptr(b), rt.buf_len(a))
}

fn main(start: u64) -> i32 {
    var r_read: [u8; 21] = "firnfmt: cannot read "
    var r_write: [u8; 22] = "firnfmt: cannot write "
    var r_scan: [u8; 40] = "firnfmt: not a well formed source text: "
    var r_diff: [u8; 18] = " is not formatted\n"

    var mode_write: bool = false
    var mode_check: bool = false
    var first: usize = 1
    let argc: usize = rt.arg_count(start)
    while first < argc {
        let a: u64 = rt.arg_ptr(start, first)
        if rt.c_length(a) != 2 || rt.ld8(a, 0) != 45 as u8 {
            break
        }
        let c: u8 = rt.ld8(a, 1)
        if c == 119 as u8 {
            mode_write = true
        } else if c == 99 as u8 {
            mode_check = true
        } else {
            var use_txt: [u8; 93] = "usage: firnfmt [-w|-c] file...\n       firnfmt            (standard input -> standard output)\n"
            say((&use_txt[0]) as u64, 93)
            return 2
        }
        first = first + 1
    }

    // --- no file: standard input -> standard output
    if first >= argc {
        var source: rt.Buf = rt.buf_new()
        defer rt.buf_free(&source)
        if !rt.read_stdin(&source) {
            return 2
        }
        var out: rt.Buf = rt.buf_new()
        defer rt.buf_free(&out)
        if !shape(&source, &out) {
            var sn: [u8; 7] = "<stdin>"
            var b: rt.Buf = rt.buf_new()
            defer rt.buf_free(&b)
            rt.buf_push_bytes(&b, (&r_scan[0]) as u64, 40)
            rt.buf_push_bytes(&b, (&sn[0]) as u64, 7)
            rt.buf_push(&b, 10 as u8)
            rt.write_everything(2, rt.buf_ptr(&b), rt.buf_len(&b))
            return 3
        }
        if !rt.write_everything(1, rt.buf_ptr(&out), rt.buf_len(&out)) {
            return 2
        }
        return 0
    }

    // --- one file after the other
    //
    // A file that does not scan does NOT end the run: with `-w` over the
    // whole tree the remaining hundreds of files would otherwise stay
    // unformatted because of one deliberately broken negative test. It is
    // named on standard error and shows up in the return value.
    var rc: i32 = 0
    var i: usize = first
    while i < argc {
        let path: u64 = rt.arg_ptr(start, i)
        var source: rt.Buf = rt.buf_new()
        if !rt.read_file(path, &source) {
            complain((&r_read[0]) as u64, 21, path)
            rt.buf_free(&source)
            return 2
        }
        var out: rt.Buf = rt.buf_new()
        if !shape(&source, &out) {
            complain((&r_scan[0]) as u64, 40, path)
            rt.buf_free(&out)
            rt.buf_free(&source)
            rc = 3
            i = i + 1
            continue
        }
        if mode_check {
            if !same(&source, &out) {
                var b: rt.Buf = rt.buf_new()
                rt.buf_push_bytes(&b, path, rt.c_length(path))
                rt.buf_push_bytes(&b, (&r_diff[0]) as u64, 18)
                rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
                rt.buf_free(&b)
                if rc == 0 {
                    rc = 1
                }
            }
        } else if mode_write {
            if !same(&source, &out) {
                if !rt.write_file(path, rt.buf_ptr(&out), rt.buf_len(&out)) {
                    complain((&r_write[0]) as u64, 22, path)
                    rt.buf_free(&out)
                    rt.buf_free(&source)
                    return 2
                }
            }
        } else {
            if !rt.write_everything(1, rt.buf_ptr(&out), rt.buf_len(&out)) {
                rt.buf_free(&out)
                rt.buf_free(&source)
                return 2
            }
        }
        rt.buf_free(&out)
        rt.buf_free(&source)
        i = i + 1
    }
    return rc
}
