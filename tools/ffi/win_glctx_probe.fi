// SPDX-License-Identifier: MPL-2.0
// tools/ffi/win_glctx_probe.fi -- gpu.glctx on Windows (lib/gpu/glctx.windows.fi) under Wine + Xvfb:
// headless context, a visible window context with swap, GL function lookup, a clear + read back.
// Exit 0 = ok, otherwise the step number. Real Windows: UNTESTED.
import gpu.glctx
import gpu.wgl
import std.io
import std.rt

static mut PX: [u8; 4] = [0 as u8; 4]

fn clear_red(c: *mut glctx.GlCtx) -> bool {
    let cc: u64 = glctx.ctx_proc(c, "glClearColor")
    let cl: u64 = glctx.ctx_proc(c, "glClear")
    let rp: u64 = glctx.ctx_proc(c, "glReadPixels")
    if cc == 0 || cl == 0 || rp == 0 {
        return false
    }
    wgl.call4(cc, wgl.bits32(1.0), 0, 0, wgl.bits32(1.0))
    wgl.call1(cl, 0x4000)
    wgl.call7(rp, 0, 0, 1, 1, 0x1908, 0x1401, (&PX[0]) as u64)
    return PX[0] == 255 as u8 && PX[1] == 0 as u8 && PX[2] == 0 as u8
}

fn main() -> i32 {
    var a: glctx.GlCtx = glctx.ctx_open(64, 64)
    if !a.ok {
        io.print_line("HEADLESS FAILED")
        return 1 as i32
    }
    if glctx.ctx_proc(&a, "glCreateShader") == 0 || glctx.ctx_proc(&a, "glNoSuchThing") != 0 {
        return 2 as i32
    }
    if !clear_red(&a) {
        return 3 as i32
    }
    glctx.ctx_close(&a)
    var b: glctx.GlCtx = glctx.ctx_open_x11(160, 120)
    if !b.ok {
        io.print_line("WINDOW FAILED")
        return 4 as i32
    }
    glctx.ctx_x11_pump(&b)
    if !clear_red(&b) {
        return 5 as i32
    }
    if !glctx.ctx_swap(&b) {
        return 6 as i32
    }
    var r: glctx.GlCtx = glctx.ctx_borrow()
    if !r.ok {
        return 7 as i32
    }
    glctx.ctx_close(&r)
    glctx.ctx_close(&b)
    var n: glctx.GlCtx = glctx.ctx_borrow()
    if n.ok {
        return 8 as i32
    }
    io.print_line("GLCTX OK")
    return 0 as i32
}
