// Round FFI probe: open an OpenGL ES 2 context through dlopen'd libEGL +
// libGLESv2, clear to red, read a pixel back. Exit 0 = pixel is (255,0,0,255).
// Exit 2x = a step failed (21 libEGL missing ... ). Run by tools/ffi/run.sh.
import std.dynlib

fn call(f: u64, sig: str, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64) -> u64 {
    var a: [u64; 8] = [0; 8]
    a[0] = a0
    a[1] = a1
    a[2] = a2
    a[3] = a3
    a[4] = a4
    a[5] = a5
    a[6] = a6
    return dynlib.callx(f, sig, (&a[0]) as u64, false)
}

fn main() -> i32 {
    let egl: u64 = dynlib.open("libEGL.so.1")
    if egl == 0 { return 21 }
    let gl: u64 = dynlib.open("libGLESv2.so.2")
    if gl == 0 { return 22 }
    let get_display: u64 = dynlib.sym(egl, "eglGetDisplay")
    let init: u64 = dynlib.sym(egl, "eglInitialize")
    let bind: u64 = dynlib.sym(egl, "eglBindAPI")
    let choose: u64 = dynlib.sym(egl, "eglChooseConfig")
    let pbuf: u64 = dynlib.sym(egl, "eglCreatePbufferSurface")
    let mkctx: u64 = dynlib.sym(egl, "eglCreateContext")
    let current: u64 = dynlib.sym(egl, "eglMakeCurrent")
    if get_display == 0 || init == 0 || choose == 0 || pbuf == 0 || mkctx == 0 || current == 0 { return 23 }
    let dpy: u64 = call(get_display, "i", 0, 0, 0, 0, 0, 0, 0)
    if dpy == 0 { return 24 }
    var ver: [u32; 2] = [0; 2]
    if call(init, "iii", dpy, (&ver[0]) as u64, (&ver[1]) as u64, 0, 0, 0, 0) == 0 { return 25 }
    call(bind, "i", 0x30A0, 0, 0, 0, 0, 0, 0)
    var cattr: [i32; 7] = [0x3033, 1, 0x3040, 4, 0x3038, 0, 0]
    var cfg: [u64; 1] = [0; 1]
    var ncfg: [i32; 1] = [0; 1]
    if call(choose, "iiiii", dpy, (&cattr[0]) as u64, (&cfg[0]) as u64, 1, (&ncfg[0]) as u64, 0, 0) == 0 { return 26 }
    if ncfg[0] < 1 { return 27 }
    var sattr: [i32; 6] = [0x3057, 16, 0x3056, 16, 0x3038, 0]
    let surf: u64 = call(pbuf, "iii", dpy, cfg[0], (&sattr[0]) as u64, 0, 0, 0, 0)
    if surf == 0 { return 28 }
    var xattr: [i32; 3] = [0x3098, 2, 0x3038]
    let ctx: u64 = call(mkctx, "iiii", dpy, cfg[0], 0, (&xattr[0]) as u64, 0, 0, 0)
    if ctx == 0 { return 29 }
    if call(current, "iiii", dpy, surf, surf, ctx, 0, 0, 0) == 0 { return 30 }
    // glClearColor(1, 0, 0, 1) -- four floats travel in xmm0..xmm3
    var f: [u64; 4] = [0; 4]
    f[0] = __bits(1.0 as f32) as u64
    f[1] = 0
    f[2] = 0
    f[3] = __bits(1.0 as f32) as u64
    dynlib.callx(dynlib.sym(gl, "glClearColor"), "ffff", (&f[0]) as u64, false)
    call(dynlib.sym(gl, "glClear"), "i", 0x4000, 0, 0, 0, 0, 0, 0)
    // glReadPixels(0, 0, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, buf): 7 integer args
    var px: [u8; 4] = [9; 4]
    call(dynlib.sym(gl, "glReadPixels"), "iiiiiii", 0, 0, 1, 1, 0x1908, 0x1401, (&px[0]) as u64)
    if px[0] != 255 as u8 || px[1] != 0 as u8 || px[2] != 0 as u8 || px[3] != 255 as u8 { return 31 }
    return 0
}
