// Round FFI probe (Windows, run under Wine by tools/ffi/run.sh): std.dynlib
// with LoadLibraryA / GetProcAddress and the generic Win64 call gate.
// Exit 0 = everything held; other codes name the failing step.
import std.dynlib

fn main() -> i32 {
    // 1. kernel32: an integer call with no argument, compared with the direct import
    let k: u64 = dynlib.open("kernel32.dll")
    if k == 0 { return 1 }
    if dynlib.open("doesnotexist-xyz.dll") != 0 { return 2 }
    let gp: u64 = dynlib.sym(k, "GetCurrentProcessId")
    if gp == 0 { return 3 }
    if dynlib.sym(k, "NoSuchFunctionXyz") != 0 { return 4 }
    let pid: u64 = dynlib.ci0(gp)
    if pid == 0 { return 5 }
    // 2. pointer argument: lstrlenA("hello!") == 6
    let sl: u64 = dynlib.sym(k, "lstrlenA")
    var s: [u8; 7] = "hello!\0"
    if dynlib.ci1(sl, (&s[0]) as u64) != 6 { return 6 }
    // 3. five arguments (the fifth goes on the stack): MulDiv is 3, use
    //    WideCharToMultiByte (8 args, four of them on the stack) on "AB"
    let w: u64 = dynlib.sym(k, "WideCharToMultiByte")
    var wide: [u16; 3] = [65, 66, 0]
    var out: [u8; 8] = [0; 8]
    var a: [u64; 8] = [0; 8]
    a[0] = 65001 // CP_UTF8
    a[1] = 0
    a[2] = (&wide[0]) as u64
    a[3] = 2
    a[4] = (&out[0]) as u64
    a[5] = 8
    a[6] = 0
    a[7] = 0
    let n: u64 = dynlib.callx(w, "iiiiiiii", (&a[0]) as u64, false)
    if n != 2 { return 7 }
    if out[0] != 65 as u8 || out[1] != 66 as u8 { return 8 }
    // 4. floats: msvcrt floor(3.75) = 3.0 and ldexp(1.5, 4) = 24.0
    let m: u64 = dynlib.open("msvcrt.dll")
    if m == 0 { return 9 }
    var f: [u64; 4] = [0; 4]
    f[0] = __bits(3.75) as u64
    let r: u64 = dynlib.callx(dynlib.sym(m, "floor"), "d", (&f[0]) as u64, true)
    if __f64_from_bits(r) != 3.0 { return 10 }
    f[0] = __bits(1.5) as u64
    f[1] = 4
    let r2: u64 = dynlib.callx(dynlib.sym(m, "ldexp"), "di", (&f[0]) as u64, true)
    if __f64_from_bits(r2) != 24.0 { return 11 }
    // 5. a DLL no import list knew: user32 GetSystemMetrics(SM_CXSCREEN) > 0
    let u: u64 = dynlib.open("user32.dll")
    if u == 0 { return 12 }
    let gsm: u64 = dynlib.sym(u, "GetSystemMetrics")
    if gsm == 0 { return 13 }
    if dynlib.ci1(gsm, 0) == 0 { return 14 }
    if !dynlib.close(m) { return 15 }
    return 0
}
