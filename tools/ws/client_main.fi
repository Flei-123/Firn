// SPDX-License-Identifier: MPL-2.0
// tools/ws/client_main.fi -- lib/ws/ws.fi's CLIENT for tools/ws/check.py.
//
//   client_main <port> <path> [roots.pem]     (with roots: wss:// to "localhost")
//
// Sends "hello", a 200000-octet text, a binary 0..255, a ping; prints what
// comes back, one line per message ("T <len> <first 16 octets>" /
// "B <len> <sum>"), then closes with 1000 and prints the peer's close code.
import std.rt
import std.io
import std.net
import std.time
import ws.ws

fn show(op: u32, m: *mut rt.Buf) {
    var sum: u64 = 0
    var i: usize = 0
    while i < (*m).len {
        sum = sum + rt.ld8((*m).ptr, i) as u64
        i = i + 1
    }
    var k: usize = (*m).len
    if k > 16 { k = 16 }
    if op == ws.OP_TEXT {
        let head: str = str { p: (*m).ptr as *mut u8, n: k }
        io.fmt_print_line(f"T {(*m).len as u64} {head}")
    } else {
        io.fmt_print_line(f"B {(*m).len as u64} {sum}")
    }
}

fn main(start: u64) -> i32 {
    var port: u64 = 0
    let pp: u64 = rt.arg_ptr(start, 1)
    var i: usize = 0
    while i < rt.c_length(pp) {
        port = port * 10 + (rt.ld8(pp, i) - 48 as u8) as u64
        i = i + 1
    }
    let path: u64 = rt.arg_ptr(start, 2)
    var c: ws.Client = ws.client_new()
    let ps: str = str { p: path as *mut u8, n: rt.c_length(path) }
    var ok: bool = false
    if rt.arg_count(start) > 3 {
        var roots: rt.Buf = rt.buf_new()
        if !io.read_file(rt.arg_ptr(start, 3), &roots) { return 3 }
        let now: u64 = (time.now_unix_ms() / 1000) as u64
        ok = ws.connect_tls(&c, net.ADDR_LOCAL, port as u16, "localhost", ps, roots.ptr, roots.len, now) catch false
    } else {
        ok = ws.connect(&c, net.ADDR_LOCAL, port as u16, "localhost", ps) catch false
    }
    if !ok {
        io.print_line("connect failed")
        return 1
    }
    var m: rt.Buf = rt.buf_new()
    ws.send_text(&c, "hello")
    var op: u32 = ws.recv(&c, &m) catch 99
    show(op, &m)
    var big: rt.Buf = rt.buf_new()
    i = 0
    while i < 200000 {
        rt.buf_push(&big, (97 + i % 26) as u8)
        i = i + 1
    }
    ws.send_text(&c, str { p: big.ptr as *mut u8, n: big.len })
    op = ws.recv(&c, &m) catch 99
    show(op, &m)
    var bin: [u8; 256] = [0; 256]
    i = 0
    while i < 256 {
        bin[i] = i as u8
        i = i + 1
    }
    ws.send_binary(&c, (&bin[0]) as u64, 256)
    op = ws.recv(&c, &m) catch 99
    show(op, &m)
    ws.send_ping(&c, (&bin[0]) as u64, 4)
    ws.send_text(&c, "after ping")
    op = ws.recv(&c, &m) catch 99
    show(op, &m)
    ws.close(&c, 1000)
    io.fmt_print_line(f"closed {ws.close_code(&c) as u64}")
    return 0
}
