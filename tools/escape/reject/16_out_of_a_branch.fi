// expect_error: 9:5 the address of the local 'x' escapes through the return value
// Marked in ONE branch: what an `if` marks counts afterwards.
fn bad(c: bool) -> *mut i64 {
    var x: i64 = 5
    var p: *mut i64 = 0 as *mut i64
    if c {
        p = &x
    }
    return p
}

fn main() -> i32 {
    let q: *mut i64 = bad(false)
    return (q as u64 & 1) as i32
}
