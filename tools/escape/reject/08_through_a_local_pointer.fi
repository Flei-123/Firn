// expect_error: 6:5 the address of the local 'x' escapes through the return value
// Through a local variable: the mark travels with the assignment.
fn bad() -> *mut i64 {
    var x: i64 = 5
    var p: *mut i64 = &x
    return p
}

fn main() -> i32 {
    let q: *mut i64 = bad()
    return (*q) as i32
}
