// expect_error: 5:5 the address of the local 'x' escapes through the pointer 'out'
// Written through an out parameter: the caller's storage outlives this frame.
fn bad(out: *mut u64) {
    var x: i64 = 5
    *out = (&x) as u64
}

fn main() -> i32 {
    var slot: u64 = 0
    bad(&slot)
    return 0
}
