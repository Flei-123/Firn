// expect_error: 6:12 the address of the local 'x' escapes into a new thread
// Round 49: the argument of the thread primitive goes to a stack of its own
// that keeps running when this frame is gone.
fn bad(stack: u64, tid: *mut u8) -> i64 {
    var x: i64 = 5
    return __thread_start((&x) as u64, stack, tid)
}

fn main() -> i32 {
    var t: u64 = 0
    return bad(0, (&t) as *mut u8) as i32
}
