// expect_error: 10:5 the address of the local 'x' escapes through the pointer 'out'
// `give` writes its second argument into what its first points at. Handing
// it this frame's local and the CALLER's out parameter lets the address out.
fn give(dst: *mut u64, src: *mut i64) {
    *dst = src as u64
}

fn bad(out: *mut u64) {
    var x: i64 = 5
    give(out, &x)
}

fn main() -> i32 {
    var slot: u64 = 0
    bad(&slot)
    return 0
}
