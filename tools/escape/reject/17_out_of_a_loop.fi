// expect_error: 14:5 the address of the local 'x' escapes through the return value
// Marked at the END of a loop body and used at its BEGINNING -- that is why
// the body is walked twice.
fn bad() -> *mut i64 {
    var x: i64 = 5
    var p: *mut i64 = 0 as *mut i64
    var out: *mut i64 = 0 as *mut i64
    var i: i64 = 0
    while i < 2 {
        out = p
        p = &x
        i = i + 1
    }
    return out
}

fn main() -> i32 {
    let q: *mut i64 = bad()
    return (q as u64 & 1) as i32
}
