// expect_error: 5:11 the address of the local 'x' escapes through the pointer 'out'
// A deferred statement runs in the same frame and follows the same rules.
fn bad(out: *mut u64) {
    var x: i64 = 5
    defer put(out, (&x) as u64)
}

fn put(dst: *mut u64, v: u64) {
    *dst = v
}

fn main() -> i32 {
    var slot: u64 = 0
    bad(&slot)
    return 0
}
