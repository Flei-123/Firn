// expect_error: 7:5 the address of the local 'x' escapes through a pointer that does not point into this frame
// Written through a pointer that belongs to nobody known here.
const SLOT: u64 = 8192

fn bad() {
    var x: i64 = 5
    *(SLOT as *mut u64) = (&x) as u64
}

fn main() -> i32 {
    bad()
    return 0
}
