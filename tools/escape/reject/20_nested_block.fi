// expect_error: 9:5 the address of the local 'x' escapes through the return value
// Out of a nested block: the local dies with the frame all the same.
fn bad() -> *mut i64 {
    var p: *mut i64 = 0 as *mut i64
    {
        var x: i64 = 5
        p = &x
    }
    return p
}

fn main() -> i32 {
    let q: *mut i64 = bad()
    return (q as u64 & 1) as i32
}
