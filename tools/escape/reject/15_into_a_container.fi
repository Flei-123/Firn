// expect_error: 14:5 the address of the local 'x' escapes into 'push', which keeps its argument 2
// Into a store that lies in the heap: `push` writes through a computed
// pointer, so the pointer is KEPT.
struct Store { base: u64, n: usize }

fn push(s: *mut Store, p: *mut i64) {
    *(((*s).base + (*s).n as u64 * 8) as *mut u64) = p as u64
    (*s).n = (*s).n + 1
}

fn main() -> i32 {
    var s: Store = Store { base: 8192, n: 0 }
    var x: i64 = 5
    push(&s, &x)
    return 0
}
