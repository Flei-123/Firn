// expect_error: 11:5 the address of the local 'x' escapes through the return value
// `hand` gives its argument back unchanged. That is NOT a capture -- but the
// result carries the frame of the argument with it, and returning it is the
// error.
fn hand(p: *mut i64) -> *mut i64 {
    return p
}

fn bad() -> *mut i64 {
    var x: i64 = 5
    return hand(&x)
}

fn main() -> i32 {
    let q: *mut i64 = bad()
    return (*q) as i32
}
