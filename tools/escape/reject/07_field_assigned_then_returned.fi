// expect_error: 10:5 the address of the local 'x' escapes through the return value
// The same, but the field is filled afterwards -- the mark has to survive
// the assignment.
struct Box { p: *mut i64 }

fn bad() -> Box {
    var x: i64 = 5
    var b: Box = Box { p: 0 as *mut i64 }
    b.p = &x
    return b
}

fn main() -> i32 {
    let b: Box = bad()
    return (*b.p) as i32
}
