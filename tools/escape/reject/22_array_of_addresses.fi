// expect_error: 7:5 the address of the local 'x' escapes through the return value
// An array literal of addresses carries the frame with it.
fn bad() -> u64 {
    var x: i64 = 5
    var y: i64 = 6
    var a: [u64; 2] = [(&x) as u64, (&y) as u64]
    return a[0]
}

fn main() -> i32 {
    return (bad() & 1) as i32
}
