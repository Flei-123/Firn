// expect_error: 15:5 the address of the local 'x' escapes into 'outer', which keeps its argument 1
// The same over TWO levels: the fact has to travel along the call graph.
const SLOT: u64 = 8192

fn keep(p: *mut i64) {
    *(SLOT as *mut u64) = p as u64
}

fn outer(q: *mut i64) {
    keep(q)
}

fn main() -> i32 {
    var x: i64 = 5
    outer(&x)
    return 0
}
