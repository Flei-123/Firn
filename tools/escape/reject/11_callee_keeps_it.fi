// expect_error: 12:5 the address of the local 'x' escapes into 'keep', which keeps its argument 1
// The callee stores the pointer somewhere that outlives it. The error
// belongs at the CALL, not inside `keep` -- `keep` is allowed to do that.
const SLOT: u64 = 8192

fn keep(p: *mut i64) {
    *(SLOT as *mut u64) = p as u64
}

fn main() -> i32 {
    var x: i64 = 5
    keep(&x)
    return 0
}
