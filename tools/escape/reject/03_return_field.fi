// expect_error: 7:5 the address of the local 'p' escapes through the return value
// The address of a FIELD of a local struct is the address of the local.
struct Point { x: i64, y: i64 }

fn bad() -> *mut i64 {
    var p: Point = Point { x: 1, y: 2 }
    return &p.y
}

fn main() -> i32 {
    let q: *mut i64 = bad()
    return (*q) as i32
}
