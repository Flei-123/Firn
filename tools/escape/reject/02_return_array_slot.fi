// expect_error: 6:5 the address of the local 's' escapes through the return value
// `ascii_rejected` of docs/ROUND66.md, word for word: a text in a local
// array whose first octet is handed out.
fn ascii_rejected() -> *mut u8 {
    var s: [u8; 8] = "rejected"
    return &s[0]
}

fn main() -> i32 {
    let p: *mut u8 = ascii_rejected()
    return (*p) as i32
}
