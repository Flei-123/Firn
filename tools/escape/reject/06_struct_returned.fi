// expect_error: 8:5 the address of the local 'x' escapes through the return value
// The address goes into a struct, and the struct is returned.
struct Box { p: *mut i64 }

fn bad() -> Box {
    var x: i64 = 5
    var b: Box = Box { p: &x }
    return b
}

fn main() -> i32 {
    let b: Box = bad()
    return (*b.p) as i32
}
