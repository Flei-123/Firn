// expect_ok
// `&(*s).x` is `s` plus an offset -- somebody else's frame, not this one.
// Every accessor of lib/firnc1 is built this way.
struct Pair { a: i64, b: i64 }

fn second(s: *mut Pair) -> *mut i64 {
    return &(*s).b
}

fn main() -> i32 {
    var p: Pair = Pair { a: 1, b: 2 }
    return (*second(&p)) as i32
}
