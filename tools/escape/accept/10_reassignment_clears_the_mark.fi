// expect_ok
// `p` points into this frame first and somewhere else afterwards. A mark
// that never went away would make this a false alarm.
fn bad(q: *mut i64) -> *mut i64 {
    var x: i64 = 5
    var p: *mut i64 = &x
    *p = 6
    p = q
    return p
}

fn main() -> i32 {
    var y: i64 = 3
    return (*bad(&y)) as i32
}
