// expect_ok
// The DIFFERENCE of two addresses is a distance and no address --
// lib/std/rc.fi measures the stride of a type exactly like this.
struct Pair { a: i64, b: i64 }

fn stride() -> usize {
    var p: Pair = Pair { a: 0, b: 0 }
    return (&p.b) as usize - (&p.a) as usize
}

fn main() -> i32 {
    return stride() as i32
}
