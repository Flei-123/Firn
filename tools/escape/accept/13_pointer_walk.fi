// expect_ok
// Pointer arithmetic over a local array, entirely inside the frame.
fn main() -> i32 {
    var a: [u8; 4] = [1 as u8, 2 as u8, 3 as u8, 4 as u8]
    var p: u64 = (&a[0]) as u64
    var s: u64 = 0
    var i: usize = 0
    while i < 4 {
        s = s + (*(p as *mut u8)) as u64
        p = p + 1
        i = i + 1
    }
    return (s - 10) as i32
}
