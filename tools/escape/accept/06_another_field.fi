// expect_ok
// ONE field holds an address of this frame, a DIFFERENT one is read out.
// Rooted at the local alone this would be a false alarm -- and
// lib/firnc1/parser.fi and lib/js/regexp.fi both do exactly this.
struct M { p: *mut i64, flag: bool }

fn probe(out: *mut bool) {
    var x: i64 = 5
    var m: M = M { p: &x, flag: true }
    *out = m.flag
}

fn main() -> i32 {
    var f: bool = false
    probe(&f)
    if f {
        return 0
    }
    return 1
}
