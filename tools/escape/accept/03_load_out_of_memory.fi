// expect_ok
// What lies in the heap is DATA, not the address of the pointer that led
// there. `(*v).base` must not count as a pointer into the caller's frame.
struct View { base: u64, n: usize }

fn first(v: *mut View) -> *mut u8 {
    return (*v).base as *mut u8
}

fn main() -> i32 {
    var a: [u8; 4] = [7 as u8; 4]
    var v: View = View { base: (&a[0]) as u64, n: 4 }
    return (*first(&v)) as i32
}
