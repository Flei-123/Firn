// expect_ok
// The ordinary case: a local address handed to somebody who READS it. This
// has to stay buildable, or the language would be unusable.
fn total(p: *mut i64, n: usize) -> i64 {
    var s: i64 = 0
    var i: usize = 0
    while i < n {
        s = s + *(((p as usize) + i * 8) as *mut i64)
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    var a: [i64; 3] = [1, 2, 3]
    return total(&a[0], 3) as i32
}
