// expect_ok
// Pointer arithmetic with the explicit wrapping / saturating operators keeps the source just like `+`: a store helper that indexes with
// `+%` (rt.st64 since r590) stores through its parameter `p`, it does not keep its argument 3. The address of a local handed to it is fine.
fn put(p: u64, i: usize, v: u64) {
    *((p +% i as u64 *% 8) as *mut u64) = v
}

fn put_sat(p: u64, i: usize, v: u64) {
    *((p +| i as u64 *| 8) as *mut u64) = v
}

fn main() -> i32 {
    var cls: [u16; 4] = [1, 2, 3, 0]
    var wc: [u8; 32] = [0; 32]
    let p: u64 = (&wc[0]) as u64
    put(p, 1, (&cls[0]) as u64)
    put_sat(p, 2, (&cls[0]) as u64)
    return 0
}
