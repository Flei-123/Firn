// expect_ok
// A struct that holds the address of a local comes back from a call. Reading
// a u32 / bool / f64 field out of it is data, not an address: f"{fl.w}" must
// compile (vs_python/12_pdf_create).
import std.io
import std.rt

struct Flow {
    out: *mut rt.Buf,
    w: u32,
    ok: bool,
    y: f64,
}

fn make(o: *mut rt.Buf) -> Flow {
    return Flow { out: o, w: 5, ok: true, y: 1.5 }
}

fn main() -> i32 {
    var out: rt.Buf = rt.buf_new()
    var fl: Flow = make(&out)
    io.fmt_print_line(f"w {fl.w} ok {fl.ok} y {fl.y}")
    rt.buf_free(&out)
    return 0
}
