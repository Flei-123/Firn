// expect_ok
// The thread primitive with an argument that is NOT an address of this
// frame -- the counter-check to rejected case 14.
fn spawn(block: u64, stack: u64, tid: *mut u8) -> i64 {
    return __thread_start(block, stack, tid)
}

fn main() -> i32 {
    var t: u64 = 0
    return spawn(0, 0, (&t) as *mut u8) as i32
}
