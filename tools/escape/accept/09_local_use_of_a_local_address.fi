// expect_ok
// Kept in the frame from beginning to end: written into a local array,
// read back out of it, used, and never handed anywhere.
fn main() -> i32 {
    var x: i64 = 41
    var slots: [u64; 2] = [0 as u64; 2]
    slots[0] = (&x) as u64
    let p: *mut i64 = slots[0] as *mut i64
    *p = *p + 1
    return x as i32
}
