// expect_exit: 0
// tools/phi/loops.fi -- ROUND 92: what phi nodes are for, in a program.
//
// `sum_to` is the case the round was opened for: a counter written on every
// pass. Before round 92 `mem2reg` could not touch it (FIR had no phi nodes,
// so a cell written more than once had to stay in memory) and the register
// allocator had to rescue it afterwards -- which the aarch64 backend, having
// no register allocation, could not do at all.
//
// `rotate` is the other half: three variables moving round in a circle. On
// the back edge that is the parallel copy { a <- b, b <- c, c <- a }, and
// all three happen AT THE SAME MOMENT. Written out naively in any order it
// gives all three the same value. `phi.rs` has to break the cycle over a
// temporary; if it does not, the numbers below come out wrong.

fn sum_to(n: u64) -> u64 {
    var s: u64 = 0
    var i: u64 = 0
    while i < n {
        s = s + i
        i = i + 1
    }
    return s
}

fn rotate(n: u64) -> u64 {
    var a: u64 = 1
    var b: u64 = 2
    var c: u64 = 3
    var i: u64 = 0
    while i < n {
        let t: u64 = a
        a = b
        b = c
        c = t
        i = i + 1
    }
    return a * 100 + b * 10 + c
}

// Two values swapping places -- the two-cycle, the smallest case of all.
fn swap_n(n: u64) -> u64 {
    var x: u64 = 7
    var y: u64 = 9
    var i: u64 = 0
    while i < n {
        let t: u64 = x
        x = y
        y = t
        i = i + 1
    }
    return x * 10 + y
}

fn main() -> i32 {
    if sum_to(0) != 0 { return 1 }
    if sum_to(10) != 45 { return 2 }
    if sum_to(1000) != 499500 { return 3 }
    if rotate(0) != 123 { return 4 }
    if rotate(1) != 231 { return 5 }
    if rotate(2) != 312 { return 6 }
    if rotate(3) != 123 { return 7 }
    if rotate(100) != 231 { return 8 }
    if swap_n(0) != 79 { return 9 }
    if swap_n(1) != 97 { return 10 }
    if swap_n(2) != 79 { return 11 }
    if swap_n(1001) != 97 { return 12 }
    return 0
}
