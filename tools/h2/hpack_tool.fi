// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.io
import net.hpack

fn be32(p: u64, at: usize) -> usize {
    return ((rt.ld8(p, at) as usize) << 24) | ((rt.ld8(p, at + 1) as usize) << 16)
    | ((rt.ld8(p, at + 2) as usize) << 8) | (rt.ld8(p, at + 3) as usize)
}

fn put32(b: *mut rt.Buf, v: usize) {
    rt.buf_push(b, ((v >> 24) & 255) as u8)
    rt.buf_push(b, ((v >> 16) & 255) as u8)
    rt.buf_push(b, ((v >> 8) & 255) as u8)
    rt.buf_push(b, (v & 255) as u8)
}

fn run_decode(inp: *mut rt.Buf) -> i32 {
    var h: hpack.Hpack = hpack.hp_new()
    var out: rt.Buf = rt.buf_new()
    var pos: usize = 1
    while pos + 4 <= (*inp).len {
        let n: usize = be32((*inp).ptr, pos)
        pos = pos + 4
        if pos + n > (*inp).len { return 3 }
        var hdrs: rt.Buf = rt.buf_new()
        let r: i32 = hpack.hp_decode(&h, (*inp).ptr + pos as u64, n, &hdrs)
        if r != hpack.HP_OK {
            rt.buf_push_bytes(&out, "ERR\n".p as u64, 4)
        } else {
            var q: usize = 0
            var np: u64 = 0
            var nn: usize = 0
            var vp: u64 = 0
            var vn: usize = 0
            while hpack.hdr_next(hdrs.ptr, hdrs.len, &q, &np, &nn, &vp, &vn) {
                rt.buf_push_bytes(&out, np, nn)
                rt.buf_push(&out, 9 as u8)
                rt.buf_push_bytes(&out, vp, vn)
                rt.buf_push(&out, 10 as u8)
            }
            rt.buf_push(&out, 10 as u8)
        }
        rt.buf_free(&hdrs)
        pos = pos + n
    }
    io.print_bytes(out.ptr, out.len)
    return 0
}

fn run_encode(inp: *mut rt.Buf) -> i32 {
    var h: hpack.Hpack = hpack.hp_new()
    var out: rt.Buf = rt.buf_new()
    var blk: rt.Buf = rt.buf_new()
    hpack.hp_encode_begin(&h, &blk)
    var pos: usize = 1
    let base: u64 = (*inp).ptr
    while pos < (*inp).len {
        var e: usize = pos
        while e < (*inp).len && rt.ld8(base, e) != 10 as u8 { e = e + 1 }
        if e == pos {
            put32(&out, blk.len)
            rt.buf_push_bytes(&out, blk.ptr, blk.len)
            rt.buf_clear(&blk)
            hpack.hp_encode_begin(&h, &blk)
            pos = e + 1
        } else {
            var secret: bool = false
            var s: usize = pos
            if rt.ld8(base, s) == 33 as u8 {
                secret = true
                s = s + 1
            }
            var t: usize = s + 1
            while t < e && rt.ld8(base, t) != 9 as u8 { t = t + 1 }
            hpack.hp_encode(&h, &blk, base + s as u64, t - s, base + (t + 1) as u64, e - t - 1, secret)
            pos = e + 1
        }
    }
    io.print_bytes(out.ptr, out.len)
    return 0
}

fn main() -> i32 {
    var inp: rt.Buf = rt.buf_new()
    if !io.read_stdin(&inp) || inp.len == 0 { return 1 }
    if rt.ld8(inp.ptr, 0) == 68 as u8 { return run_decode(&inp) }
    return run_encode(&inp)
}
