import std.rt
import std.io
import net.h2

fn main() -> i32 {
    var port: u16 = 0
    var pbuf: rt.Buf = rt.buf_new()
    if !io.read_stdin(&pbuf) { return 2 }
    var i: usize = 0
    while i < pbuf.len {
        let d: u8 = rt.ld8(pbuf.ptr, i)
        if d >= 48 as u8 && d <= 57 as u8 { port = port * 10 + ((d - 48 as u8) as u16) }
        i = i + 1
    }
    var c: h2.H2 = h2.h2_new()
    if !h2.h2_connect_plain(&c, 2130706433 as u32, port) { return 3 }
    let a: i32 = h2.h2_request(&c, "GET", "http", "localhost", "/", "", 0, 0)
    if a > 0 {
        let ok: bool = h2.h2_wait(&c, a as u32)
        h2.h2_release(&c, a as u32)
    }
    h2.h2_free(&c)
    return 0
}
