// tools/checkidx/loop_var.fi -- the counter-check to loop_const.fi: the
// bound comes from outside and could be anything, so the check STAYS.
// Without this file the elimination pass would pass its own test by
// deleting every check there is.
fn feed(x: usize) -> usize {
    return x
}

fn main() -> i32 {
    var a: [i32; 64] = [0; 64]
    let n: usize = feed(64)
    var s: i32 = 0
    var i: usize = 0
    while i < n {
        s = s + a[i]
        i = i + 1
    }
    return s
}
