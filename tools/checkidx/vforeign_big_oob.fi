// tools/checkidx/vforeign_big_oob.fi -- r763: the element of `v` is a whole
// Vec (24 bytes): the store `v[0] = x` may overwrite the header of `w` when
// `w` lives inside `v`'s buffer, so the guard on `w` does not survive it.
// The check of `w[i]` after the store must stay (the store shrinks `w`).
import std.rt
import std.vec

fn shrink(v: *mut Vec[Vec[i32]], w: *mut Vec[i32], e: Vec[i32]) -> i32 {
    var s: i32 = 0
    var i: usize = 0
    while i < vec_len[i32](w) {
        (*v)[0] = e
        s = s + (*w)[i]
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[Vec[i32]] = vec_new[Vec[i32]]()
    var a: Vec[i32] = vec_new[i32]()
    vec_push[i32](&a, 1)
    vec_push[i32](&a, 2)
    vec_push[Vec[i32]](&v, a)
    var e: Vec[i32] = vec_new[i32]()
    return shrink(&v, &v[0], e)
}
