// tools/checkidx/div_zero.fi -- division by zero. The README said until
// round 89 that nobody catches it; round 72 had already built the check
// and the honest list was wrong. Re-measured here so it cannot go stale
// again.
fn feed(x: i32) -> i32 {
    return x
}

fn main() -> i32 {
    let a: i32 = feed(10)
    let b: i32 = feed(0)
    return a / b
}
