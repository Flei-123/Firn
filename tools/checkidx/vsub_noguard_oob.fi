// tools/checkidx/vsub_noguard_oob.fi -- r762: `v[i - 2]` with `i` starting at
// 0 reaches index -2 on a one element Vec (the negative path wraps -1 to the
// last element only; the guard `i < n` does not say `i >= 2`). The check must
// stay; the abort is the result.
import std.rt
import std.vec

fn run(v: *mut Vec[i32]) -> i32 {
    var s: i32 = 0
    var i: i32 = 0
    let n: i32 = vec_len[i32](v) as i32
    while i < n {
        s = s + (*v)[i - 2]
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    return run(&v)
}
