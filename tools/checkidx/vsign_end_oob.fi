// tools/checkidx/vsign_end_oob.fi -- r760: `i <= n` runs one past the end.
// The guard is not strict, so the check must stay; the abort is the result.
import std.rt
import std.vec

fn sum_past(v: *mut Vec[i32]) -> i32 {
    var s: i32 = 0
    var i: i32 = 0
    let n: i32 = vec_len[i32](v) as i32
    while i <= n {
        s = s + (*v)[i]
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    return sum_past(&v)
}
