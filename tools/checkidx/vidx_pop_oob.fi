// tools/checkidx/vidx_pop_oob.fi -- r755: the loop shrinks the Vec between
// the guard and the index. The length word is written inside the loop, so
// the two reads are not the same value and the check must stay; the abort
// is the result.
import std.rt
import std.vec

fn drain(v: *mut Vec[i32]) -> i32 {
    var s: i32 = 0
    var i: usize = 0
    while i < vec_len[i32](v) {
        vec_pop[i32](v)
        s = s + v[i]
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    return drain(&v)
}
