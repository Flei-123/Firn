// tools/checkidx/idx_nested.fi -- the INNER array is the one that is
// overrun; the outer index is fine. The message has to name the inner
// type, not the outer one.
fn feed(x: i32) -> i32 {
    return x
}

fn main() -> i32 {
    var m: [[i32; 3]; 2] = [[1, 2, 3], [4, 5, 6]]
    let j: i32 = feed(5)
    return m[1][j as usize]
}
