// tools/checkidx/idx_write.fi -- writing past the end. The dangerous
// direction: a read gives a wrong answer, a write destroys something else.
fn feed(x: i32) -> i32 {
    return x
}

fn main() -> i32 {
    var a: [i32; 4] = [1, 2, 3, 4]
    let i: i32 = feed(11)
    a[i as usize] = 7
    return a[0]
}
