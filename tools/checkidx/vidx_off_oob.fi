// tools/checkidx/vidx_off_oob.fi -- r755: `v[i + 1]` under `i < len` reaches
// `len` on the last round. The proof for CheckedIdxV must NOT remove this
// check; the abort is the result.
import std.rt
import std.vec

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    vec_push[i32](&v, 2)
    var s: i32 = 0
    var i: usize = 0
    while i < vec_len[i32](&v) {
        s = s + v[i + 1]
        i = i + 1
    }
    return s
}
