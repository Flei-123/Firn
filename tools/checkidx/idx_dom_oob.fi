// tools/checkidx/idx_dom_oob.fi -- the first access checks `i` against 32,
// the second against 16. A dominating check only covers an array that is
// at least as long, so the second check must stay and abort.
fn feed(x: usize) -> usize {
    return x
}

fn main() -> i32 {
    var a: [i32; 32] = [0; 32]
    var b: [i32; 16] = [0; 16]
    let i: usize = feed(20)
    a[i] = 1
    b[i] = 2
    return a[0] + b[0]
}
