// tools/checkidx/idx_read.fi -- reading past the end of an array
// (round 89, SPEC 13 item L9). The index comes through a function so
// that no pass can fold it away; the abort is the result.
fn feed(x: i32) -> i32 {
    return x
}

fn main() -> i32 {
    var a: [i32; 4] = [1, 2, 3, 4]
    let i: i32 = feed(9)
    return a[i as usize]
}
