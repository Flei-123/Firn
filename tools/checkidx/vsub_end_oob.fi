// tools/checkidx/vsub_end_oob.fi -- r762: `v[i - 1]` under `i <= n + 1` reaches
// index n, one past the end. The guard is not strict enough, so the check
// must stay; the abort is the result.
import std.rt
import std.vec

fn run(v: *mut Vec[i32]) -> i32 {
    var s: i32 = 0
    var i: i32 = 1
    let n: i32 = vec_len[i32](v) as i32
    while i <= n + 1 {
        s = s + (*v)[i - 1]
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    return run(&v)
}
