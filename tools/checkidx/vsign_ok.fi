// tools/checkidx/vsign_ok.fi -- r760: a SIGNED loop counter below the length
// (`i < n`, `n = len as i32`) indexes a Vec without a check in release-safe:
// the counter starts at a constant >= 0 and only grows, the guard is the
// length. rangecheck.rs: `signed_index_base`, `sless`.
import std.rt
import std.vec

fn sum_i32(v: *mut Vec[i32]) -> i32 {
    var s: i32 = 0
    var i: i32 = 0
    let n: i32 = vec_len[i32](v) as i32
    while i < n {
        s = s + (*v)[i]
        i = i + 1
    }
    return s
}

fn sum_i64(v: *mut Vec[i32]) -> i32 {
    var s: i32 = 0
    var i: i64 = 0
    while i < vec_len[i32](v) as i64 {
        s = s + (*v)[i]
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    vec_push[i32](&v, 2)
    vec_push[i32](&v, 3)
    if sum_i32(&v) != 6 { return 2 }
    if sum_i64(&v) != 6 { return 3 }
    return 0
}
