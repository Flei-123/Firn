// tools/checkidx/phi_oob.fi -- the clamp is one too high for the array:
// `m` reaches 16, the array has 16 elements. The range proof over phis
// (rangecheck.rs) must NOT remove this check; the abort is the result.
fn feed(x: usize) -> usize {
    return x
}

fn main() -> i32 {
    var a: [i32; 16] = [0; 16]
    var m: usize = feed(40)
    if m > 16 {
        m = 16
    }
    a[m] = 7
    return a[0]
}
