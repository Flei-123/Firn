// tools/checkidx/mask_ok.fi -- every index here is provably inside, so no
// check may be left: `x & 15` and `x % 16` on 16 elements.
fn feed(x: usize) -> usize {
    return x
}

fn main() -> i32 {
    var a: [i32; 16] = [0; 16]
    let x: usize = feed(37)
    a[x & 15] = 3
    a[x % 16] = a[x % 16] + 4
    return a[5]
}
