// tools/checkidx/vsign_neg_oob.fi -- r760: the counter starts BELOW zero.
// `v[-1]` is the last element (Python), `v[-2]` on one element is out of
// range: the proof needs `0 <= i`, which does not hold, so the check must
// stay; the abort is the result.
import std.rt
import std.vec

fn sum_from(v: *mut Vec[i32], start: i32) -> i32 {
    var s: i32 = 0
    var i: i32 = start
    let n: i32 = vec_len[i32](v) as i32
    while i < n {
        s = s + (*v)[i]
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    return sum_from(&v, -2)
}
