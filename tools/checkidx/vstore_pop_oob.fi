// tools/checkidx/vstore_pop_oob.fi -- r759: the loop stores an element and
// then SHRINKS the Vec. The pop writes the length word, so the check of the
// next store must stay; the abort is the result.
import std.rt
import std.vec

fn shrink(v: *mut Vec[i32]) {
    for i in 0..vec_len[i32](v) {
        (*v)[i] = 1
        vec_pop[i32](v)
    }
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    vec_push[i32](&v, 2)
    shrink(&v)
    return 0
}
