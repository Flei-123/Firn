// tools/checkidx/phi_ok.fi -- every index here is provably inside, so no
// check may be left: a clamped value (a phi of `m` under `m <= 16` and the
// constant 16) and a guard on an offset (`j + 1 < 17` bounds `j` by 15).
fn feed(x: usize) -> usize {
    return x
}

fn main() -> i32 {
    var a: [i32; 17] = [0; 17]
    var b: [i32; 16] = [0; 16]
    var m: usize = feed(40)
    if m > 16 {
        m = 16
    }
    a[m] = 5
    let j: usize = feed(3)
    var s: i32 = 0
    if j + 1 < 17 {
        s = b[j]
    }
    return a[16] + s
}
