// tools/checkidx/vlen_push_oob.fi -- r761: the loop writes the Vec between the
// length call and the index (a pop), so the length read at the guard is not
// the length at the index: the check must stay in dev-fast too; the abort is
// the result.
import std.rt
import std.vec

fn drain(v: *mut Vec[i32]) -> i32 {
    var s: i32 = 0
    var i: usize = 0
    let n: usize = vec_len[i32](v)
    while i < n {
        vec_pop[i32](v)
        s = s + (*v)[i]
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    return drain(&v)
}
