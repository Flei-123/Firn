// tools/checkidx/neg/const_index.fi -- a constant index outside a known
// length is an ERROR, at every build level. That is not an optimisation of
// the run time check: `release-fast` has no run time check at all and
// still refuses this.
fn main() -> i32 {
    var a: [i32; 4] = [1, 2, 3, 4]
    return a[9]
}
