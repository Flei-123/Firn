// tools/checkidx/neg/handler_sig.fi -- the signature of a
// `#[panic_handler]` is fixed. A wrong one is refused HERE, where it can
// be read, and not at the call site, which is hand written assembly with
// no type checker of its own.
#[panic_handler]
fn wrong(x: i32) {
    return
}

fn main() -> i32 {
    return 0
}
