// tools/checkidx/vstore_ok.fi -- r759: a loop that stores Vec ELEMENTS
// (`v[i] = x`) does not change the length word, so the index checks of the
// loop (the stores' own and the reads') are all provable in release-safe.
// rangecheck.rs: `elem_store_of`.
import std.rt
import std.vec

fn fill(v: *mut Vec[i32], x: i32) {
    for i in 0..vec_len[i32](v) {
        (*v)[i] = x
    }
}

fn double_all(v: *mut Vec[i32]) {
    var i: usize = 0
    while i < vec_len[i32](v) {
        (*v)[i] = (*v)[i] * 2
        i = i + 1
    }
}

fn sum(v: *mut Vec[i32]) -> i32 {
    var s: i32 = 0
    for i in 0..vec_len[i32](v) {
        s = s + v[i]
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    vec_push[i32](&v, 2)
    vec_push[i32](&v, 3)
    double_all(&v)
    if sum(&v) != 12 { return 2 }
    fill(&v, 5)
    if sum(&v) != 15 { return 3 }
    return 0
}
