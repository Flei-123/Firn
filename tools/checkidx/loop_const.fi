// tools/checkidx/loop_const.fi -- the loop the SPEC promises does not pay
// for the check: the bound is a number, the array is that long, and the
// optimiser can see it. Every element is touched, so the program also
// proves the removal did not break the arithmetic.
fn main() -> i32 {
    var a: [i32; 64] = [0; 64]
    var i: usize = 0
    while i < 64 {
        a[i] = (i as i32) * 2
        i = i + 1
    }
    var s: i32 = 0
    var k: usize = 0
    while k < 64 {
        s = s + a[k]
        k = k + 1
    }
    return s % 100
}
