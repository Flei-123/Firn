// tools/checkidx/div_min.fi -- i32::MIN / -1, the one division that
// overflows instead of dividing by zero. Without the check the processor
// raises SIGFPE with no sentence of ours at all.
fn feed(x: i32) -> i32 {
    return x
}

fn main() -> i32 {
    let a: i32 = feed(-2147483648)
    let b: i32 = feed(-1)
    return a / b
}
