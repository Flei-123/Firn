// tools/checkidx/vforeign_ok.fi -- r763: an element store into Vec `v` does
// not touch the header of ANOTHER Vec `w` (the element is smaller than a
// header), so the guard `i < len(w)` taken before the store still holds for
// `w[i]` after it. Every check of the loops is provable in release-safe.
// rangecheck.rs: `elem_store_of`, foreign header.
import std.rt
import std.vec

fn copy_into(v: *mut Vec[i32], w: *mut Vec[i32]) {
    var i: usize = 0
    while i < vec_len[i32](v) && i < vec_len[i32](w) {
        (*v)[i] = 7
        (*v)[i] = (*v)[i] + (*w)[i]
        i = i + 1
    }
}

fn sum(v: *mut Vec[i32]) -> i32 {
    var s: i32 = 0
    for i in 0..vec_len[i32](v) {
        s = s + v[i]
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    var w: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    vec_push[i32](&v, 2)
    vec_push[i32](&v, 3)
    vec_push[i32](&w, 10)
    vec_push[i32](&w, 20)
    copy_into(&v, &w)
    if sum(&v) != 47 { return 2 }
    return 0
}
