// tools/checkidx/vstore_other_oob.fi -- r759: the loop is guarded by the
// length of `v` but stores into `w`, which is shorter. The store is not an
// element store of `v`'s header and the guard says nothing about `w`: the
// check must stay; the abort is the result.
import std.rt
import std.vec

fn spread(v: *mut Vec[i32], w: *mut Vec[i32]) {
    for i in 0..vec_len[i32](v) {
        (*w)[i] = 1
    }
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    var w: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    vec_push[i32](&v, 2)
    vec_push[i32](&w, 1)
    spread(&v, &w)
    return 0
}
