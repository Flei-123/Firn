// tools/checkidx/dom_ok.fi -- `a[i]` is checked against 16; the same index
// into the longer `b` is then covered by that check. Exactly one check
// is left: the first.
fn feed(x: usize) -> usize {
    return x
}

fn main() -> i32 {
    var a: [i32; 16] = [0; 16]
    var b: [i32; 32] = [0; 32]
    let i: usize = feed(9)
    a[i] = 1
    b[i] = 2
    return a[9] + b[9]
}
