// SPDX-License-Identifier: GPL-2.0-only
// tools/checkidx/handler.fi -- the program ends its OWN panic (round 89,
// SPEC 13). The signature is fixed, because the trampoline calls it with
// five values in five registers and cannot negotiate:
//
//   fn(msg: *u8, len: u64, a: i64, b: i64, code: u64)
//
// `msg` already carries file, line and column -- that is how round 72
// built the text, and `tools/checked/run.sh` proves both compilers write
// it the same way. What the handler gets on top is what a sentence cannot
// carry: the two numbers and the panic KIND (7 = index out of bounds).
#[panic_handler]
fn my_panic(msg: *u8, len: u64, a: i64, b: i64, code: u64) {
    syscall(1, 2, msg as u64, len)
    var tail: [u8; 26] = " <- caught by the program\n"
    syscall(1, 2, (&tail[0]) as u64, 26)
    syscall(60, 42)
}

fn feed(x: i32) -> i32 {
    return x
}

fn main() -> i32 {
    var a: [i32; 4] = [1, 2, 3, 4]
    let i: i32 = feed(9)
    return a[i as usize]
}
