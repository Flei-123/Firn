// tools/checkidx/vidx_ok.fi -- r755: every Vec index here is provably below
// the length that the loop guard compares against (the loop reads the
// length word, nothing in the loop writes memory), so release-safe leaves
// no checked_idxv at all. rangecheck.rs: CheckedIdxV.
import std.rt
import std.vec

fn sum_for(v: *mut Vec[i32]) -> i32 {
    var s: i32 = 0
    for i in 0..vec_len[i32](v) {
        s = s + v[i]
    }
    return s
}

fn sum_while(v: *mut Vec[i32]) -> i32 {
    var s: i32 = 0
    var i: usize = 0
    while i < vec_len[i32](v) {
        s = s + v[i]
        i = i + 1
    }
    return s
}

fn sum_pairs(v: *mut Vec[i32]) -> i32 {
    var s: i32 = 0
    var i: usize = 0
    while i + 1 < vec_len[i32](v) {
        s = s + v[i] + v[i + 1]
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    vec_push[i32](&v, 2)
    vec_push[i32](&v, 3)
    if sum_for(&v) != 6 { return 2 }
    if sum_while(&v) != 6 { return 3 }
    if sum_pairs(&v) != 8 { return 4 }
    return 0
}
