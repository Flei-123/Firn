// tools/checkidx/vlen_ok.fi -- r761: in dev-fast `vec_len` stays a CALL. The
// call of a pure length getter is read as a load of the word it returns, so
// the guard `i < vec_len(v)` still proves the index (the loop only reads and
// stores elements). rangecheck.rs: `len_getter_offset`, `getter_call`.
import std.rt
import std.vec

fn sum_usize(v: *mut Vec[i32]) -> i32 {
    var s: i32 = 0
    var i: usize = 0
    while i < vec_len[i32](v) {
        s = s + (*v)[i]
        i = i + 1
    }
    return s
}

fn bump(v: *mut Vec[i32]) {
    var i: usize = 0
    let n: usize = vec_len[i32](v)
    while i < n {
        (*v)[i] = (*v)[i] + 1
        i = i + 1
    }
}

fn sum_for(v: *mut Vec[i32]) -> i32 {
    var s: i32 = 0
    for i in 0..vec_len[i32](v) {
        s = s + (*v)[i]
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    vec_push[i32](&v, 2)
    vec_push[i32](&v, 3)
    if sum_usize(&v) != 6 { return 2 }
    bump(&v)
    if sum_for(&v) != 9 { return 3 }
    return 0
}
