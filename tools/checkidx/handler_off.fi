// tools/checkidx/handler_off.fi -- the counter-check to handler.fi: the
// same program WITHOUT the attribute falls back to the compiler's own
// ending (exit code 101 and the default sentence).
fn feed(x: i32) -> i32 {
    return x
}

fn main() -> i32 {
    var a: [i32; 4] = [1, 2, 3, 4]
    let i: i32 = feed(9)
    return a[i as usize]
}
