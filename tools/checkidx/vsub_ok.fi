// tools/checkidx/vsub_ok.fi -- r762: `v[i - 1]` under `1 <= i < n` needs no
// check: `i - 1` is not negative and lies below `i`, which lies below the
// length. Signed counter, unsigned counter, a guard `0 < i < len` and an
// element store `v[i] = v[i - 1]`. rangecheck.rs: `sub_const_of`.
import std.rt
import std.vec

fn diff_i32(v: *mut Vec[i32]) -> i32 {
    var s: i32 = 0
    var i: i32 = 1
    let n: i32 = vec_len[i32](v) as i32
    while i < n {
        s = s + (*v)[i] - (*v)[i - 1]
        i = i + 1
    }
    return s
}

fn diff_usize(v: *mut Vec[i32]) -> i32 {
    var s: i32 = 0
    var i: usize = 1
    while i < vec_len[i32](v) {
        s = s + (*v)[i] - (*v)[i - 1]
        i = i + 1
    }
    return s
}

fn guarded(v: *mut Vec[i32], i: i32) -> i32 {
    if i > 0 && i < vec_len[i32](v) as i32 {
        return (*v)[i - 1]
    }
    return -1
}

fn smear(v: *mut Vec[i32]) {
    var i: i32 = 1
    let n: i32 = vec_len[i32](v) as i32
    while i < n {
        (*v)[i] = (*v)[i - 1]
        i = i + 1
    }
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    vec_push[i32](&v, 4)
    vec_push[i32](&v, 9)
    if diff_i32(&v) != 8 { return 2 }
    if diff_usize(&v) != 8 { return 3 }
    if guarded(&v, 2) != 4 { return 4 }
    if guarded(&v, 0) != -1 { return 5 }
    if guarded(&v, 3) != -1 { return 6 }
    smear(&v)
    if diff_i32(&v) != 0 { return 7 }
    return 0
}
