// tools/checkidx/idx_mask_oob.fi -- the mask is one bit too wide for the
// array: `x & 31` reaches 31, the array has 16 elements. The range proof
// (rangecheck.rs) must NOT remove this check; the abort is the result.
fn feed(x: usize) -> usize {
    return x
}

fn main() -> i32 {
    var a: [i32; 16] = [0; 16]
    let x: usize = feed(20)
    a[x & 31] = 7
    return a[0]
}
