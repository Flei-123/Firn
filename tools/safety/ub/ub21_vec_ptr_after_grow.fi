import std.rt
import std.vec
fn main() -> i32 {
    if !gc_init() { return 9 }
    var v: Vec[i64] = vec_new[i64]()
    vec_push[i64](&v, 7)
    let p: *mut i64 = &v[0]
    var i: i64 = 0
    while i < 100000 {
        vec_push[i64](&v, i)
        i = i + 1
    }
    let r: i64 = *p
    if r == 7 { return 0 }
    return 1
}
