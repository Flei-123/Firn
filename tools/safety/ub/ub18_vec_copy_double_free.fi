import std.rt
import std.vec
fn main() -> i32 {
    if !gc_init() { return 9 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 5)
    var w: Vec[i32] = v
    vec_free[i32](&v)
    vec_free[i32](&w)
    var a: Vec[i32] = vec_new[i32]()
    vec_push[i32](&a, 1)
    var b: Vec[i32] = vec_new[i32]()
    vec_push[i32](&b, 2)
    vec_push[i32](&a, 3)
    return (a[0] + b[0]) as i32
}
