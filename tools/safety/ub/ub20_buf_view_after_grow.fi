import std.rt
fn main() -> i32 {
    if !gc_init() { return 1 }
    var b: rt.Buf = rt.buf_new()
    rt.buf_push(&b, 65 as u8)
    let s: str = rt.buf_str(&b)
    var i: u64 = 0
    while i < 100000 {
        rt.buf_push(&b, 66 as u8)
        i = i + 1
    }
    let c: u8 = *(s.p)
    if c == 65 { return 0 }
    return 1
}
