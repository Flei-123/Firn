import std.rt

fn recurse(n: u64) -> u64 {
    var pad: [u64; 64] = [0; 64]
    pad[(n % 64) as usize] = n
    return recurse(n + 1) + pad[0]
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    return recurse(arg)
}

fn main() -> i32 {
    let h: u64 = thread_start(1, 0)
    thread_wait(h)
    return 0
}
