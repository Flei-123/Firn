gc class Target { v: u64 }
import std.rt
struct H { raw: u64 }

fn create(out: *mut GcWeak[Target], h: *mut H) -> i32 {
    let t = gc Target { v: 5 } catch gc_null[Target]()
    if t == gc_null[Target]() { return 1 }
    *out = weak(t)
    *((*h).raw as *mut u64) = t as u64
    return 0
}

fn deep(out: *mut GcWeak[Target], h: *mut H, t: u64) -> i32 {
    var fill: [u64; 128] = [0; 128]
    let fp: u64 = (&fill) as u64
    var i: u64 = 0
    while i < 128 {
        *((fp + i * 8) as *mut u64) = i
        i = i + 1
    }
    if t > 0 {
        return deep(out, h, t - 1)
    }
    return create(out, h)
}

fn main() -> i32 {
    if !gc_init() { return 9 }
    var w: GcWeak[Target] = weak_null[Target]()
    var h: H = H { raw: rt.heap_alloc(64) }
    if deep(&w, &h, 2) != 0 { return 5 }
    gc_collect()
    if strong(w) == gc_null[Target]() { return 3 }
    return 0
}
