// expect_exit: 0
import std.rt

gc class Cell {
    value: u64,
}

struct Node {
    next: *mut Node,
    other: *mut Node,
    n: u64,
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    return arg
}

fn main() -> i32 {
    if !gc_init() { return 9 }
    let nd: *mut Node = rt.heap_alloc(24) as *mut Node
    (*nd).n = 1
    (*nd).next = nd
    (*nd).other = nd
    let t: u64 = thread_start(1, nd as *mut u8 as u64)
    if thread_wait(t) == 0 { return 1 }
    return 0
}
