// expect_error: 20:34 'Gc[Cell]' cannot be sent to another thread
import std.rt

gc class Cell {
    value: u64,
}

fn make() -> AllocError!Gc[Cell] {
    let c: Gc[Cell] = try gc Cell { value: 1 }
    return c
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    return arg
}

fn main() -> i32 {
    if !gc_init() { return 9 }
    let c: Gc[Cell] = make() catch gc_null[Cell]()
    let h: u64 = thread_start(1, c as *mut u8 as u64)
    thread_wait(h)
    return 0
}
