// expect_error: 27:34 '*mut Holder' cannot be sent to another thread
import std.rt

gc class Cell {
    value: u64,
}

struct Holder {
    cell: Gc[Cell],
    n: u64,
}

fn make() -> AllocError!Gc[Cell] {
    let c: Gc[Cell] = try gc Cell { value: 1 }
    return c
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    return arg
}

fn main() -> i32 {
    if !gc_init() { return 9 }
    let c: Gc[Cell] = make() catch gc_null[Cell]()
    let h: *mut Holder = rt.heap_alloc(16) as *mut Holder
    (*h).n = 2
    let t: u64 = thread_start(1, h as *mut u8 as u64)
    thread_wait(t)
    return 0
}
