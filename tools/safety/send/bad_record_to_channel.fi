// expect_error: 23:25 '*mut Message' cannot be sent to another thread
import std.rt
import chan.chan

gc class Cell {
    value: u64,
}

struct Message {
    cell: Gc[Cell],
}

fn make() -> AllocError!Gc[Cell] {
    let c: Gc[Cell] = try gc Cell { value: 1 }
    return c
}

fn main() -> i32 {
    if !gc_init() { return 9 }
    var c: chan.Chan = chan.chan_new(4, 1)
    let cell: Gc[Cell] = make() catch gc_null[Cell]()
    var m: Message = Message { cell: cell }
    chan.chan_send(&c, (&m) as *mut u64)
    return 0
}
