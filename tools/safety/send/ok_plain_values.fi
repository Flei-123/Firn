// expect_exit: 0
import std.rt

gc class Cell {
    value: u64,
}

struct Plain {
    a: u64,
    b: [u32; 2],
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    return arg
}

fn main() -> i32 {
    if !gc_init() { return 9 }
    var p: Plain = Plain { a: 4, b: [1, 2] }
    let h1: u64 = thread_start(1, p.a)
    let h2: u64 = thread_start(1, p.b[1] as u64)
    let w1: u64 = thread_wait(h1)
    let w2: u64 = thread_wait(h2)
    if w1 != 4 { return 1 }
    if w2 != 2 { return 2 }
    return 0
}
