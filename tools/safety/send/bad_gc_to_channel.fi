// expect_error: 18:25 'Gc[Cell]' cannot be sent to another thread
import std.rt
import chan.chan

gc class Cell {
    value: u64,
}

fn make() -> AllocError!Gc[Cell] {
    let c: Gc[Cell] = try gc Cell { value: 1 }
    return c
}

fn main() -> i32 {
    if !gc_init() { return 9 }
    var c: chan.Chan = chan.chan_new(4, 1)
    let cell: Gc[Cell] = make() catch gc_null[Cell]()
    chan.chan_send1(&c, cell as *mut u8 as u64)
    return 0
}
