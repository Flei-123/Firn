// expect_error: 7:23 a raw pointer into the target of the reference parameter 'c' cannot be created
struct Cell {
    v: i64,
}

fn grab(c: inout Cell) -> i64 {
    let q: *mut i64 = &c.v
    *q = 4
    return *q
}

fn main() -> i32 {
    var c: Cell = Cell { v: 1 }
    return grab(inout c) as i32
}
