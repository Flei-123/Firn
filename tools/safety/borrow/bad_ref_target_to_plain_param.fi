// expect_error: 11:10 a raw pointer into the target of the reference parameter 'c' cannot be created
struct Cell {
    v: i64,
}

fn keep(p: *mut i64) {
    *p = 5
}

fn grab(c: inout Cell) {
    keep(&c.v)
}

fn main() -> i32 {
    var c: Cell = Cell { v: 1 }
    grab(inout c)
    return c.v as i32
}
