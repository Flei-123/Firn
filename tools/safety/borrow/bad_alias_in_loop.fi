// expect_error: 11:26 the raw pointer 'p' is used after 'a' was passed as 'inout'
fn bump(x: inout i64) {
    *x = *x + 1
}

fn main() -> i32 {
    var a: i64 = 0
    let p: *mut i64 = &a
    var i: i64 = 0
    while i < 3 {
        let seen: i64 = *p
        bump(inout a)
        i = i + seen
    }
    return a as i32
}
