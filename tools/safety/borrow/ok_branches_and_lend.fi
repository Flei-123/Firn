// expect_exit: 6
struct Cell {
    v: i64,
}

fn add(x: inout i64, d: i64) {
    *x = *x + d
}

fn grab(c: inout Cell) {
    add(inout c.v, 2)
    add(inout c.v, 0)
}

fn main() -> i32 {
    var a: i64 = 1
    let p: *mut i64 = &a
    var c: Cell = Cell { v: 1 }
    if a > 5 {
        add(inout a, 1)
    } else {
        *p = *p + 2
    }
    grab(inout c)
    return (a + c.v) as i32
}
