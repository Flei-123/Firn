struct P { x: i32 }

impl P {
    unsafe fn peek(*self) -> i32 {
        let q: *mut P = self
        return (*q).x
    }
}

unsafe fn raw(p: *mut i32) -> i32 {
    return *p
}

fn main() -> i32 {
    var v: i32 = 5
    var pp: P = P { x: 3 }
    let a: i32 = raw(&v)
    let b: i32 = pp.peek()
    unsafe {
        let c: i32 = raw(&v)
        let d: i32 = pp.peek()
    }
    return a + b
}
