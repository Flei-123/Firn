// expect_error: 14:28 'v' is moved inside a loop
import std.rt
import std.vec

fn eat(v: Vec[i64]) -> usize {
    return vec_len[i64](&v)
}

fn main() -> i32 {
    if !gc_init() { return 9 }
    var v: Vec[i64] = vec_new[i64]()
    var i: i32 = 0
    while i < 2 {
        let n: usize = eat(v)
        i += 1
    }
    return 0
}
