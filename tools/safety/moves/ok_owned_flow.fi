// expect_exit: 0
import std.rt
import std.vec

struct Bag {
    items: Vec[i64],
}

fn make() -> Vec[i64] {
    var v: Vec[i64] = vec_new[i64]()
    vec_push[i64](&v, 7)
    return v
}

fn total(v: *mut Vec[i64]) -> i64 {
    return v[0]
}

fn consume(v: Vec[i64]) -> usize {
    var w: Vec[i64] = v
    let n: usize = vec_len[i64](&w)
    vec_free[i64](&w)
    return n
}

fn main() -> i32 {
    if !gc_init() { return 9 }
    var v: Vec[i64] = make()
    if total(&v) != 7 { return 1 }
    var b: Bag = Bag { items: v }
    if vec_len[i64](&b.items) != 1 { return 2 }
    v = make()
    let n: usize = consume(v)
    if n != 1 { return 3 }
    vec_free[i64](&b.items)
    return 0
}
