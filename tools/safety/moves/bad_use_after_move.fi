// expect_error: 14:34 use of moved value 'v'
import std.rt
import std.vec

fn eat(v: Vec[i64]) -> usize {
    return vec_len[i64](&v)
}

fn main() -> i32 {
    if !gc_init() { return 9 }
    var v: Vec[i64] = vec_new[i64]()
    vec_push[i64](&v, 1)
    let a: usize = eat(v)
    let b: usize = vec_len[i64](&v)
    return (a + b) as i32
}
