// SPDX-License-Identifier: MPL-2.0
// tools/uiextras/humancli_main.fi -- a line front end for lib/i18n/human.fi, for
// tools/uiextras/check_human.py (which holds it against ICU).
//
// stdin, one command per line, fields separated by blanks:
//   rel   <lang> <delta_ms>
//   bytes <lang> <n> <binary 0|1>
//   dt    <lang> <dstyle> <tstyle> <unix_ms> <offset_min>
//   pct   <lang> <ratio * 1e6> <frac digits>
//   list  <lang> <or 0|1> <item|item|item>
//   zone  <lang> <tzif path> <unix_ms> <dstyle> <tstyle>
// stdout: the formatted text, one line per command.
import std.rt
import std.time
import std.io
import i18n.human

struct Cur {
    p: u64,
    n: usize,
    pos: usize,
}

fn word(c: *mut Cur) -> str {
    while (*c).pos < (*c).n && rt.ld8((*c).p, (*c).pos) == 32 as u8 {
        (*c).pos = (*c).pos + 1
    }
    let a: usize = (*c).pos
    while (*c).pos < (*c).n && rt.ld8((*c).p, (*c).pos) != 32 as u8 && rt.ld8((*c).p, (*c).pos) != 10 as u8 {
        (*c).pos = (*c).pos + 1
    }
    return str { p: rt.ptr_of((*c).p + a as u64), n: (*c).pos - a }
}

fn num(s: str) -> i64 {
    var neg: bool = false
    var i: usize = 0
    if s.n > 0 && rt.ld8(s.p as u64, 0) == 45 as u8 {
        neg = true
        i = 1
    }
    var v: i64 = 0
    while i < s.n {
        v = v * 10 + ((rt.ld8(s.p as u64, i) - 48 as u8) as i64)
        i++
    }
    if neg {
        return 0 - v
    }
    return v
}

fn numu(s: str) -> u64 {
    var v: u64 = 0
    var i: usize = 0
    while i < s.n {
        v = v * 10 + ((rt.ld8(s.p as u64, i) - 48 as u8) as u64)
        i++
    }
    return v
}

fn main() -> i32 {
    var inp: rt.Buf = rt.buf_new()
    rt.read_stdin(&inp)
    var c: Cur = Cur { p: rt.buf_ptr(&inp), n: rt.buf_len(&inp), pos: 0 }
    while c.pos < c.n {
        let cmd: str = word(&c)
        if cmd.n == 0 {
            c.pos = c.pos + 1
            continue
        }
        let lang: str = word(&c)
        var out: str = ""
        if cmd == "rel" {
            out = human.format_relative(lang, num(word(&c)))
        } else if cmd == "bytes" {
            let n: u64 = numu(word(&c))
            let bin: i64 = num(word(&c))
            out = human.format_bytes(lang, n, bin != 0)
        } else if cmd == "dt" {
            let ds: u32 = num(word(&c)) as u32
            let ts: u32 = num(word(&c)) as u32
            let ms: i64 = num(word(&c))
            let off: i64 = num(word(&c))
            var t: time.DateTime = time.civil_from_unix(ms + off * 60000)
            t.offset_min = off as i32
            out = human.format_datetime(lang, t, ds, ts)
        } else if cmd == "pct" {
            let r: i64 = num(word(&c))
            let fr: i64 = num(word(&c))
            out = human.format_percent(lang, (r as f64) / 1000000.0, fr as u32)
        } else if cmd == "list" {
            let or_list: i64 = num(word(&c))
            let items: str = word(&c)
            out = human.format_list(lang, items, 124 as u8, or_list != 0)
        } else if cmd == "zone" {
            let path: str = word(&c)
            let ms: i64 = num(word(&c))
            let ds: u32 = num(word(&c)) as u32
            let ts: u32 = num(word(&c)) as u32
            var z: time.Tz = time.tz_new()
            let ok: bool = time.tz_load(path, &z) catch false
            out = human.format_in_zone(lang, &z, ms, ds, ts)
            time.tz_free(&z)
        }
        io.print_line(out)
        while c.pos < c.n && rt.ld8(c.p, c.pos) != 10 as u8 {
            c.pos = c.pos + 1
        }
        c.pos = c.pos + 1
    }
    rt.buf_free(&inp)
    return 0
}
