// SPDX-License-Identifier: MPL-2.0
// tools/qr/qrcli_main.fi -- a batch front end for lib/qr, for tools/qr/run.sh.
//
// stdin: one case per line:  mode ecc minv maxv mask boost hexdata
//   mode 0 auto / 1 numeric / 2 alnum / 4 byte, ecc 0..3 (L M Q H), mask -1..7,
//   boost 0/1, hexdata = the octets in hex ("-" for none).
// stdout: per case one line:  OK version ecc mask mode size 0101...(size*size)
//   or  ERR TooLong | ERR BadArg | ERR OutOfMemory
import qr.qr
import std.rt
import std.io

fn hexval(c: u8) -> i64 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return (c - 48 as u8) as i64
    }
    if c >= 97 as u8 && c <= 102 as u8 {
        return (c - 97 as u8) as i64 + 10
    }
    return 0 - 1
}

// reads a (possibly negative) decimal at `*pos`, skipping blanks first
fn read_int(p: u64, n: usize, pos: *mut usize) -> i64 {
    while *pos < n && rt.ld8(p, *pos) == 32 as u8 {
        *pos = *pos + 1
    }
    var neg: bool = false
    if *pos < n && rt.ld8(p, *pos) == 45 as u8 {
        neg = true
        *pos = *pos + 1
    }
    var v: i64 = 0
    while *pos < n && rt.ld8(p, *pos) >= 48 as u8 && rt.ld8(p, *pos) <= 57 as u8 {
        v = v * 10 + ((rt.ld8(p, *pos) - 48 as u8) as i64)
        *pos = *pos + 1
    }
    if neg {
        return 0 - v
    }
    return v
}

static mut code: u32 = 0

fn why(e: QrError) -> bool {
    if e == QrError::TooLong { code = 1 as u32 }
    if e == QrError::BadArg { code = 2 as u32 }
    if e == QrError::OutOfMemory { code = 3 as u32 }
    return false
}

fn main() -> i32 {
    var inp: rt.Buf = rt.buf_new()
    rt.read_stdin(&inp)
    let p: u64 = rt.buf_ptr(&inp)
    let n: usize = rt.buf_len(&inp)
    var out: rt.Buf = rt.buf_new()
    var pos: usize = 0
    var q: qr.QrCode = qr.qr_new()
    while pos < n {
        let mode: i64 = read_int(p, n, &pos)
        let ecc: i64 = read_int(p, n, &pos)
        let minv: i64 = read_int(p, n, &pos)
        let maxv: i64 = read_int(p, n, &pos)
        let mask: i64 = read_int(p, n, &pos)
        let boost: i64 = read_int(p, n, &pos)
        while pos < n && rt.ld8(p, pos) == 32 as u8 {
            pos++
        }
        var data: rt.Buf = rt.buf_new()
        if pos < n && rt.ld8(p, pos) == 45 as u8 {
            pos++
        } else {
            while pos + 1 < n && hexval(rt.ld8(p, pos)) >= 0 {
                rt.buf_push(&data, ((hexval(rt.ld8(p, pos)) << 4) | hexval(rt.ld8(p, pos + 1))) as u8)
                pos = pos + 2
            }
        }
        while pos < n && rt.ld8(p, pos) != 10 as u8 {
            pos++
        }
        pos++
        code = 0 as u32
        let ok: bool = qr.qr_encode(rt.buf_ptr(&data), rt.buf_len(&data), mode as u32,
            ecc as u32, minv as u32, maxv as u32, mask as i32, boost != 0, &q) catch | e | (why(e))
        let failed: bool = code != 0 as u32
        if failed {
            if code == 1 as u32 {
                io.print_line("ERR TooLong")
            }
            if code == 2 as u32 {
                io.print_line("ERR BadArg")
            }
            if code == 3 as u32 {
                io.print_line("ERR OutOfMemory")
            }
        }
        if !failed {
            rt.buf_clear(&out)
            rt.buf_push(&out, 79 as u8)
            rt.buf_push(&out, 75 as u8)
            rt.buf_push(&out, 32 as u8)
            rt.buf_push_dec_u64(&out, qr.qr_version(&q) as u64)
            rt.buf_push(&out, 32 as u8)
            rt.buf_push_dec_u64(&out, qr.qr_ecc(&q) as u64)
            rt.buf_push(&out, 32 as u8)
            rt.buf_push_dec_u64(&out, qr.qr_mask(&q) as u64)
            rt.buf_push(&out, 32 as u8)
            rt.buf_push_dec_u64(&out, qr.qr_mode(&q) as u64)
            rt.buf_push(&out, 32 as u8)
            rt.buf_push_dec_u64(&out, qr.qr_size(&q) as u64)
            rt.buf_push(&out, 32 as u8)
            var y: i64 = 0
            while y < qr.qr_size(&q) as i64 {
                var x: i64 = 0
                while x < qr.qr_size(&q) as i64 {
                    if qr.qr_dark(&q, x, y) {
                        rt.buf_push(&out, 49 as u8)
                    } else {
                        rt.buf_push(&out, 48 as u8)
                    }
                    x = x + 1
                }
                y = y + 1
            }
            rt.buf_push(&out, 10 as u8)
            rt.write_everything(1, rt.buf_ptr(&out), rt.buf_len(&out))
        }
        rt.buf_free(&data)
    }
    qr.qr_free(&q)
    rt.buf_free(&out)
    rt.buf_free(&inp)
    return 0
}
