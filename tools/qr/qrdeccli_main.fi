// SPDX-License-Identifier: MPL-2.0
// tools/qr/qrdeccli_main.fi -- reads QR codes out of PNG files with lib/qr/qrdec,
// for tools/qr/check_decode.py.
//
//     qrdeccli a.png b.png ...
//
// per file one line:  <file> OK <version> <ecc> <mask> <corrected> <eci> <hex of the payload>
//                or:  <file> FAIL <reason>
import qr.qr
import qr.qrdec
import paint.png
import std.rt

static mut code: u32 = 0

fn why(e: QrDecError) -> bool {
    if e == QrDecError::NotFound { code = 1 as u32 }
    if e == QrDecError::Format { code = 2 as u32 }
    if e == QrDecError::Uncorrectable { code = 3 as u32 }
    if e == QrDecError::BadData { code = 4 as u32 }
    if e == QrDecError::OutOfMemory { code = 5 as u32 }
    return false
}

fn out_str(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn hexdigit(v: u8) -> u8 {
    if v < 10 as u8 {
        return 48 as u8 + v
    }
    return 97 as u8 + v - 10 as u8
}

fn main(start: u64) -> i32 {
    var out: rt.Buf = rt.buf_new()
    var i: usize = 1
    while i < rt.arg_count(start) {
        let path: u64 = rt.arg_ptr(start, i)
        rt.buf_push_bytes(&out, path, rt.c_length(path))
        rt.buf_push(&out, 32 as u8)
        var data: rt.Buf = rt.buf_new()
        if !rt.read_file(path, &data) {
            out_str(&out, "FAIL unreadable\n")
            i++
            continue
        }
        var im: png.Image = png.image_new()
        if !png.decode_png(rt.buf_ptr(&data), rt.buf_len(&data), &im) {
            out_str(&out, "FAIL notpng\n")
            rt.buf_free(&data)
            i++
            continue
        }
        var res: qrdec.QrResult = qrdec.qrdec_result_new()
        code = 0 as u32
        let ok: bool = qrdec.qrdec_rgba(im.px as u64, png.image_width(&im), png.image_height(&im), &res) catch | e | (why(e))
        if code != 0 as u32 {
            if code == 1 as u32 { out_str(&out, "FAIL notfound\n") }
            if code == 2 as u32 { out_str(&out, "FAIL format\n") }
            if code == 3 as u32 { out_str(&out, "FAIL uncorrectable\n") }
            if code == 4 as u32 { out_str(&out, "FAIL baddata\n") }
            if code == 5 as u32 { out_str(&out, "FAIL memory\n") }
        } else {
            out_str(&out, "OK ")
            rt.buf_push_dec_u64(&out, res.version as u64)
            rt.buf_push(&out, 32 as u8)
            rt.buf_push_dec_u64(&out, res.ecc as u64)
            rt.buf_push(&out, 32 as u8)
            rt.buf_push_dec_u64(&out, res.mask as u64)
            rt.buf_push(&out, 32 as u8)
            rt.buf_push_dec_u64(&out, res.corrected as u64)
            rt.buf_push(&out, 32 as u8)
            rt.buf_push_dec_i64(&out, res.eci as i64)
            rt.buf_push(&out, 32 as u8)
            var k: usize = 0
            while k < rt.buf_len(&res.payload) {
                let b: u8 = rt.buf_at(&res.payload, k)
                rt.buf_push(&out, hexdigit(b >> 4 as u8))
                rt.buf_push(&out, hexdigit(b & 15 as u8))
                k++
            }
            if rt.buf_len(&res.payload) == 0 {
                rt.buf_push(&out, 45 as u8)
            }
            rt.buf_push(&out, 10 as u8)
        }
        qrdec.qrdec_result_free(&res)
        png.image_free(&im)
        rt.buf_free(&data)
        i++
    }
    rt.write_everything(1, rt.buf_ptr(&out), rt.buf_len(&out))
    rt.buf_free(&out)
    return 0
}
