// SPDX-License-Identifier: MPL-2.0
// tools/input/win_check.fi -- the SendInput backend of lib/input, RUN on
// the Windows target (tools/input/win.sh: Wine on a virtual X display).
//
// The cursor position is read back with GetCursorPos before and after
// every motion; buttons, wheel and keys are checked by SendInput's own
// count of injected records. Prints one line per check, "ALL-OK" at the end.
import std.io
import input.input
import std.time

extern fn GetCursorPos(p: u64) -> i32;

fn pos(x: *mut i32, y: *mut i32) -> bool {
    var b: [i32; 2] = [0, 0]
    if GetCursorPos((&b[0]) as u64) == 0 {
        return false
    }
    *x = b[0]
    *y = b[1]
    return true
}

fn check(ok: bool, what: str, bad: *mut i32) {
    if ok {
        io.print("OK   ")
    } else {
        io.print("FAIL ")
        *bad = *bad + 1
    }
    io.print_line(what)
}

fn main() -> i32 {
    var bad: i32 = 0
    check(input.backend_name() == "SendInput", "backend is SendInput", &bad)
    check(input.ready(), "ready", &bad)
    var x0: i32 = 0
    var y0: i32 = 0
    var x1: i32 = 0
    var y1: i32 = 0
    // Wine keeps its own idea of the pointer until the first injected
    // motion (on Windows it is the real one); a warm-up move syncs both.
    input.mouse_move(1, 1)
    time.sleep_ms(100)
    check(pos(&x0, &y0), "GetCursorPos", &bad)
    check(input.mouse_move(40, 30), "move +40,+30 injected", &bad)
    time.sleep_ms(100)
    pos(&x1, &y1)
    io.fmt_print_line(f"cursor {x0},{y0} -> {x1},{y1}")
    check(x1 > x0 && y1 > y0, "cursor went right and down", &bad)
    check(input.mouse_move(0 - 25, 0 - 20), "move -25,-20 injected", &bad)
    var x2: i32 = 0
    var y2: i32 = 0
    time.sleep_ms(100)
    pos(&x2, &y2)
    check(x2 < x1 && y2 < y1, "cursor went left and up", &bad)
    check(input.click(), "left click injected", &bad)
    check(input.right_click(), "right click injected", &bad)
    check(input.scroll(0 - 2), "wheel injected", &bad)
    check(input.key_tap(input.KEY_A), "key A injected", &bad)
    check(input.key_tap(input.KEY_LEFT), "extended key Left injected", &bad)
    check(input.volume_up(), "volume up injected", &bad)
    check(input.play_pause(), "play/pause injected", &bad)
    check(!input.key_tap(999 as u32), "counter-check: unmapped key refused", &bad)
    check(input.error_text() == "", "no error text after success", &bad)
    if bad == 0 {
        io.print_line("ALL-OK")
        return 0
    }
    return 1
}
