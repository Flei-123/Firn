// SPDX-License-Identifier: MPL-2.0
// tools/input/record_backend.fi -- an input backend that WRITES DOWN what
// it is asked to do instead of doing it: one line per call on stdout
// ("rel dx dy wheel hwheel", "btn code 0|1", "key code 0|1").
//
// Used by tools/phone_remote/check.cjs: the example is built in a shadow
// directory with this file as input/backend.fi (the same seam a Windows
// build uses), so the whole chain page -> WebSocket -> server -> lib/input
// is checked without touching the input of a real desktop. The uinput
// backend itself is proven against a real kernel by tools/input/run.sh.
import std.io

export { be_open, be_close, be_error, be_rel, be_button, be_key, be_name }

fn be_name() -> str { return "record" }
fn be_open() -> bool { return true }
fn be_close() {}
fn be_error() -> str { return "" }

fn be_rel(dx: i32, dy: i32, wheel: i32, hwheel: i32) -> bool {
    io.fmt_print_line(f"rel {dx} {dy} {wheel} {hwheel}")
    return true
}

fn be_button(code: u32, down: bool) -> bool {
    var d: u32 = 0
    if down { d = 1 }
    io.fmt_print_line(f"btn {code as u64} {d as u64}")
    return true
}

fn be_key(code: u32, down: bool) -> bool {
    var d: u32 = 0
    if down { d = 1 }
    io.fmt_print_line(f"key {code as u64} {d as u64}")
    return true
}
