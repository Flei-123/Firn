// tools/input/fui_ime_main.fi -- a fUi window with two text fields for the Xvfb + xdotool test (tools/input/apphost_run.sh).
// Every edit prints "EDIT <node> <text>|pre=<n> commit=<n> end=<n> del=<n>" to stdout; the test driver kills the process itself.
import std.rt
import fui.app
import plat.fuitext
import plat.fuiime
import input.textcore

static mut FIRST: usize = 0
static mut SECOND: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn num(v: u64) -> str {
    var b: [u8; 24] = [0 as u8; 24]
    var n: usize = 0
    var x: u64 = v
    if x == 0 {
        say("0")
        return ""
    }
    var tmp: [u8; 24] = [0 as u8; 24]
    var t: usize = 0
    while x > 0 {
        tmp[t] = (48 + (x % 10)) as u8
        t = t + 1
        x = x / 10
    }
    while t > 0 {
        t = t - 1
        b[n] = tmp[t]
        n = n + 1
    }
    rt.write_everything(1, (&b[0]) as u64, n)
    return ""
}

fn edited(a: *mut app.App, node: usize) {
    let s: str = app.text(a, node)
    say("EDIT ")
    let u: str = num(node as u64)
    say(" ")
    rt.write_everything(1, s.p as u64, s.n)
    say("|pre=")
    let u1: str = num(fuitext.ft_stats(0 as u32))
    say(" commit=")
    let u2: str = num(fuitext.ft_stats(1 as u32))
    say(" end=")
    let u3: str = num(fuitext.ft_stats(2 as u32))
    say(" del=")
    let u4: str = num(fuitext.ft_stats(3 as u32))
    say(" ime=")
    if fuitext.ft_on() { say("on\n") } else { say("off\n") }
}

static mut STEP: u32 = 0

// F5 (key code 100) stands in for an input method that composes (the XIM of @im=none sends no pre-edit text): step 1 = pre-edit
// "ka" (UTF-8), step 2 = longer pre-edit, step 3 = commit "KANJI"; then it starts over. Everything goes through the same
// textcore events -> fuitext sink -> fUi field path a real IME's callbacks take.
fn on_key(a: *mut app.App, key: u32, mods: u32) -> bool {
    if key != 100 as u32 {
        return false
    }
    let t: *mut textcore.Text = fuitext.ft_text()
    if t as u64 == 0 {
        return true
    }
    STEP = STEP + 1 as u32
    if STEP == 1 as u32 {
        textcore.text_preedit_set_utf8(t, "ka".p as u64, 2, 2)
    } else if STEP == 2 as u32 {
        textcore.text_preedit_set_utf8(t, "kana".p as u64, 4, 4)
    } else {
        textcore.text_commit_utf8(t, "KANJI".p as u64, 5)
        STEP = 0 as u32
    }
    fuitext.ft_pump()
    return true
}

fn main() -> i32 {
    let a: *mut app.App = app.window("ime test", 420, 200)
    FIRST = app.entry(a, "first")
    SECOND = app.entry(a, "second")
    fuiime.enable()
    app.on_edit(a, edited)
    app.on_key(a, on_key)
    return app.run(a)
}
