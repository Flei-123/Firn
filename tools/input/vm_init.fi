// SPDX-License-Identifier: MPL-2.0
// tools/input/vm_init.fi -- /init of a tiny Linux VM that proves
// lib/input against the REAL kernel: uinput creates the device, evdev
// hands the events back, and they are compared one by one.
//
// Built and run by tools/input/run.sh (QEMU, the Debian kernel of the
// machine, uinput.ko and evdev.ko decompressed into the initramfs). Needs
// no libc and no userland: this program is PID 1.
//
//   1. counter-check: before uinput.ko is loaded, input.ready() must FAIL
//      and name the missing device
//   2. counter-check: a child that dropped root must be REFUSED
//   3. load evdev.ko + uinput.ko (finit_module), create the device
//   4. open its /dev/input/eventN (found by EVIOCGNAME), drive every call
//      of lib/input, read the events back, compare
// Prints "INPUT OK <n> / <n>" or the first difference, then powers off.
import std.rt
import std.io
import input.input
import input.uinput

const VM_MOUNT: i64 = 165
const VM_FINIT_MODULE: i64 = 313
const VM_OPEN: i64 = 2
const VM_READ: i64 = 0
const VM_IOCTL: i64 = 16
const VM_NANOSLEEP: i64 = 35
const VM_REBOOT: i64 = 169
const VM_FORK: i64 = 57
const VM_WAIT4: i64 = 61
const VM_SETUID: i64 = 105
const VM_SETGID: i64 = 106
const VM_EXIT: i64 = 60

fn sleep_ms(ms: i64) {
    var ts: [i64; 2] = [0; 2]
    ts[0] = ms / 1000
    ts[1] = (ms % 1000) * 1000000
    syscall(VM_NANOSLEEP, (&ts[0]) as i64, 0, 0, 0, 0, 0)
}

fn poweroff(code: i32) -> i32 {
    sleep_ms(200)
    syscall(VM_REBOOT, 4276215469, 672274793, 1126301404, 0, 0, 0) // POWER_OFF
    return code
}

fn cpath(b: *mut rt.Buf, s: str) -> i64 {
    rt.buf_clear(b)
    rt.buf_push_bytes(b, s.p as u64, s.n)
    rt.buf_push(b, 0 as u8)
    return (*b).ptr as i64
}

fn load(path: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    let fd: i64 = syscall(VM_OPEN, cpath(&b, path), 524288, 0, 0, 0, 0)
    if fd < 0 { return false }
    var empty: [u8; 1] = [0]
    let r: i64 = syscall(VM_FINIT_MODULE, fd, (&empty[0]) as i64, 0, 0, 0, 0)
    return r >= 0 || r == -17 // EEXIST: built in / already there
}

static mut OKS: u64 = 0
static mut ALL: u64 = 0

fn check(name: str, cond: bool) {
    ALL = ALL + 1
    if cond {
        OKS = OKS + 1
    } else {
        io.fmt_print_line(f"  FAIL {name}")
    }
}

// Finds our device among /dev/input/event0..31 by its name.
fn find_event() -> i64 {
    var b: rt.Buf = rt.buf_new()
    var i: u64 = 0
    while i < 32 {
        rt.buf_clear(&b)
        let pre: str = "/dev/input/event"
        rt.buf_push_bytes(&b, pre.p as u64, pre.n)
        rt.buf_push_dec_u64(&b, i)
        rt.buf_push(&b, 0 as u8)
        let fd: i64 = syscall(VM_OPEN, b.ptr as i64, 2048 | 524288, 0, 0, 0, 0) // O_RDONLY|O_NONBLOCK
        if fd >= 0 {
            var name: [u8; 64] = [0; 64]
            let n: i64 = syscall(VM_IOCTL, fd, 2151695622, (&name[0]) as i64, 0, 0, 0) // EVIOCGNAME(64)
            let want: str = uinput.DEVICE_NAME
            if n > 0 && rt.mem_eq((&name[0]) as u64, want.p as u64, want.n) && name[want.n] == 0 as u8 {
                return fd
            }
            syscall(3, fd, 0, 0, 0, 0, 0)
        }
        i = i + 1
    }
    return -1
}

// expected events: type, code, value -- SYN_REPORTs counted apart
fn want(e: *mut rt.Buf, t: i64, c: i64, v: i64) {
    var x: [i64; 3] = [0; 3]
    x[0] = t
    x[1] = c
    x[2] = v
    rt.buf_push_bytes(e, (&x[0]) as u64, 24)
}

fn tap(e: *mut rt.Buf, code: i64) {
    want(e, 1, code, 1)
    want(e, 1, code, 0)
}

fn main() -> i32 {
    io.print_line("vm_init: Firn is PID 1")
    var b: rt.Buf = rt.buf_new()
    var dev: rt.Buf = rt.buf_new()
    syscall(VM_MOUNT, cpath(&b, "devtmpfs"), cpath(&dev, "/dev"), cpath(&b, "devtmpfs"), 0, 0, 0)
    // 1. no uinput module yet: refused, and it says why
    check("without uinput.ko: ready() is false", !input.ready())
    check("... and error_text names the missing device",
        input.error_text() == "/dev/uinput does not exist (modprobe uinput)")
    check("load evdev.ko", load("/evdev.ko"))
    check("load uinput.ko", load("/uinput.ko"))
    sleep_ms(100)
    // 2. a child without root is refused
    let pid: i64 = syscall(VM_FORK, 0, 0, 0, 0, 0, 0)
    if pid == 0 {
        syscall(VM_SETGID, 65534, 0, 0, 0, 0, 0)
        syscall(VM_SETUID, 65534, 0, 0, 0, 0, 0)
        if input.ready() { syscall(VM_EXIT, 1, 0, 0, 0, 0, 0) }
        if input.error_text() != "no permission for /dev/uinput (add the user to group 'input' or run as root)" {
            syscall(VM_EXIT, 2, 0, 0, 0, 0, 0)
        }
        syscall(VM_EXIT, 0, 0, 0, 0, 0, 0)
    }
    var status: [i32; 1] = [99]
    syscall(VM_WAIT4, pid, (&status[0]) as i64, 0, 0, 0, 0)
    check("a non-root child is refused with the permission text", status[0] == 0)
    // 3. the device
    check("ready() as root", input.ready())
    check("backend is uinput", input.backend_name() == "uinput")
    sleep_ms(300)
    let efd: i64 = find_event()
    check("its /dev/input/eventN is there, named 'Firn virtual input'", efd >= 0)
    if efd < 0 { return poweroff(1) }
    // 4. every call, and what evdev hands back
    var e: rt.Buf = rt.buf_new()
    var reports: u64 = 0
    input.mouse_move(5, -3)
    want(&e, 2, 0, 5)
    want(&e, 2, 1, -3)
    reports = reports + 1
    input.click()
    tap(&e, 272)
    reports = reports + 2
    input.right_click()
    tap(&e, 273)
    reports = reports + 2
    input.scroll(1)
    want(&e, 2, 8, 1)
    reports = reports + 1
    input.scroll_h(-2)
    want(&e, 2, 6, -2)
    reports = reports + 1
    input.key_tap(input.KEY_A)
    tap(&e, 30)
    reports = reports + 2
    input.volume_up()
    tap(&e, 115)
    input.volume_down()
    tap(&e, 114)
    input.mute()
    tap(&e, 113)
    input.play_pause()
    tap(&e, 164)
    input.next_track()
    tap(&e, 163)
    input.prev_track()
    tap(&e, 165)
    reports = reports + 12
    input.key_combo(input.KEY_LEFTCTRL, input.KEY_C)
    want(&e, 1, 29, 1)
    tap(&e, 46)
    want(&e, 1, 29, 0)
    reports = reports + 4
    input.type_text("Hi!")
    want(&e, 1, 42, 1)
    tap(&e, 35)
    want(&e, 1, 42, 0)
    tap(&e, 23)
    want(&e, 1, 42, 1)
    tap(&e, 2)
    want(&e, 1, 42, 0)
    reports = reports + 10
    sleep_ms(200)
    // read back
    var got: rt.Buf = rt.buf_new()
    var syn: u64 = 0
    var raw: [u8; 2400] = [0; 2400]
    var more: bool = true
    while more {
        let n: i64 = syscall(VM_READ, efd, (&raw[0]) as i64, 2400, 0, 0, 0)
        if n <= 0 {
            more = false
        } else {
            var k: usize = 0
            while k + 24 <= n as usize {
                let t: i64 = ((raw[k + 16] as i64) | ((raw[k + 17] as i64) << 8))
                let c: i64 = ((raw[k + 18] as i64) | ((raw[k + 19] as i64) << 8))
                let u: u32 = (raw[k + 20] as u32) | ((raw[k + 21] as u32) << 8)
                | ((raw[k + 22] as u32) << 16) | ((raw[k + 23] as u32) << 24)
                var v: i64 = u as i64
                if v >= 2147483648 { v = v - 4294967296 }
                if t == 0 {
                    syn = syn + 1
                } else {
                    want(&got, t, c, v)
                }
                k = k + 24
            }
        }
    }
    let ne: u64 = (e.len / 24) as u64
    let ng: u64 = (got.len / 24) as u64
    check("event count", ne == ng)
    check("SYN_REPORT count (one per call of the backend)", syn == reports)
    var same: u64 = 0
    var i: usize = 0
    while i < e.len && i < got.len {
        if rt.mem_eq(e.ptr + i as u64, got.ptr + i as u64, 24) {
            same = same + 1
        } else if same + 1 == (i / 24) as u64 + 1 {
            io.fmt_print_line(f"  first difference at event {(i / 24) as u64}")
        }
        i = i + 24
    }
    check("every event: type, code and value as sent", same == ne && ne == ng)
    io.fmt_print_line(f"   events compared: {same} / {ne}, reports {syn} / {reports}")
    input.close()
    sleep_ms(100)
    check("close() removes the device", find_event() < 0)
    if OKS == ALL {
        io.fmt_print_line(f"INPUT OK {OKS} / {ALL}")
    } else {
        io.fmt_print_line(f"INPUT FAILED {OKS} / {ALL}")
    }
    return poweroff(0)
}
