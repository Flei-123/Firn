// SPDX-License-Identifier: MPL-2.0
// tools/input/grab_main.fi -- the relative mouse grab on a real X server (driven by tools/input/run.sh with xdotool).
//   grab_main raw|warp    captures the pointer, prints READY, sums the deltas, ends on the key 'q'
// Output: "GRAB <ok> raw=<0|1>", "READY", "KEY <down|up> sc=<scancode> sym=<keysym>", "SUM <dx> <dy>".
import std.rt
import std.io
import std.str
import window.window

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn now_ms() -> i64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0] * 1000 + ts[1] / 1000000
}

fn main(start: u64) -> i32 {
    var mode: str = "raw"
    if rt.arg_count(start) > 1 {
        mode = arg(start, 1)
    }
    var w: window.Window = window.window_new()
    if !window.open_window(&w, 0) {
        io.print_line("NODISPLAY")
        return 1
    }
    window.raw_input(&w, true)
    if !window.make(&w, 400, 300) {
        io.print_line("MAKE-FAILED")
        return 3
    }
    window.show_window(&w)
    window.present(&w)
    var t0: i64 = now_ms()
    while now_ms() - t0 < 400 {
        window.wait_event(&w, 50)
        while window.next_event(&w) != window.EV_NONE {
        }
    }
    window.cursor_raw(&w, mode == "raw")
    let ok: bool = window.cursor_mode(&w, window.CURSOR_CAPTURED)
    var israw: i64 = 0
    if window.cursor_is_raw(&w) {
        israw = 1
    }
    var okn: i64 = 0
    if ok {
        okn = 1
    }
    io.fmt_print(f"GRAB {okn} raw={israw}\n")
    io.print_line("READY")
    var sx: i64 = 0
    var sy: i64 = 0
    var motion_events: i64 = 0
    var done: bool = false
    t0 = now_ms()
    var d: [i64; 2] = [0; 2]
    while !done && now_ms() - t0 < 20000 {
        window.wait_event(&w, 50)
        var k: u32 = window.next_event(&w)
        while k != window.EV_NONE {
            if k == window.EV_RAWKEY || k == window.EV_RAWKEY_UP {
                let down: i64 = if k == window.EV_RAWKEY { 1 } else { 0 }
                let sc: i64 = window.ev_a(&w) as i64
                let sym: i64 = window.ev_x(&w) as i64
                io.fmt_print(f"KEY {down} sc={sc} sym={sym}\n")
                if down == 1 && sym == 113 {
                    done = true
                }
            }
            if k == window.EV_MOTION {
                motion_events = motion_events + 1
            }
            if k == window.EV_CLOSED {
                done = true
            }
            if k == window.EV_FOCUS {
                let g: i64 = window.ev_a(&w) as i64
                io.fmt_print(f"FOCUS {g}\n")
            }
            k = window.next_event(&w)
        }
        window.cursor_delta(&w, (&d[0]) as u64)
        sx = sx + d[0]
        sy = sy + d[1]
    }
    window.cursor_mode(&w, window.CURSOR_NORMAL)
    io.fmt_print(f"SUM {sx} {sy} motion_events={motion_events}\n")
    window.close_window(&w)
    return 0
}
