// tools/input/xim_probe.fi -- input.textsys against a real X server and Xlib's built-in input method (@im=none).
// Replays XKeyEvents into a second Xlib connection (keycode 38 = a on the stock server keymap) and returns 0 only if every
// expectation held. Dead keys / the Compose key are only REPLAYED and printed (keycodes 150-152): this Xvfb refuses keymap
// changes (xmodmap / setxkbmap / xkbcomp had no effect), so no key of the server keymap is a dead key -> not asserted. Argument-free; reads nothing.
import std.rt
import std.io
import input.textcore
import input.textsys

static mut FAILS: i32 = 0

fn say(s: str, v: u64) {
    io.print(s)
    io.print(" ")
    io.fmt_print_line(f"{v as i64}")
}

fn drain_first(t: *mut textcore.Text) -> u32 {
    var ev: textcore.TextEvent = textcore.TextEvent { kind: 0 as u32, n: 0, cp: [0 as u32; 32] }
    var r: u32 = 0 as u32
    var any: u32 = 0 as u32
    while textcore.text_event_next(t, &ev) != textcore.TE_NONE {
        if ev.kind == textcore.TE_COMMIT && ev.n >= 1 && r == 0 as u32 {
            r = ev.cp[0]
        }
        any = any + 1 as u32
    }
    return r
}

fn press(s: *mut textsys.TextSys, t: *mut textcore.Text, kc: u32, st: u32) -> bool {
    let f: bool = textsys.sys_key(s, t, true, kc, st, 1000 as u32)
    textsys.sys_key(s, t, false, kc, st, 1001 as u32)
    return f
}

fn expect(c: bool, what: str) {
    if !c {
        io.print("FAIL: ")
        io.print_line(what)
        FAILS = FAILS + 1
    }
}

fn main() -> i32 {
    var t: textcore.Text = textcore.text_new()
    var s: textsys.TextSys = textsys.sys_new()
    if !textsys.sys_open(&s, &t) {
        say("sys_open failed at step", textsys.sys_step(&s) as u64)
        return 2
    }
    say("style", textsys.sys_style(&s))
    say("callbacks", textsys.sys_callbacks(&s) as u64)
    // plain key: keycode 38 = a
    let f1: bool = press(&s, &t, 38 as u32, 0 as u32)
    expect(!f1, "plain a not filtered")
    expect(drain_first(&t) == 97 as u32, "plain a commits 'a'")
    // shifted: A
    press(&s, &t, 38 as u32, 1 as u32)
    expect(drain_first(&t) == 65 as u32, "shift a commits 'A'")
    // dead_acute (150) then a
    let f2: bool = press(&s, &t, 150 as u32, 0 as u32)
    say("dead_acute filtered", f2 as u64)
    say("  last keysym", textsys.sys_last_keysym(&s) as u64)
    say("  last status", textsys.sys_last_status(&s) as u64)
    press(&s, &t, 38 as u32, 0 as u32)
    let r2: u32 = drain_first(&t)
    say("dead_acute a ->", r2 as u64)
    // dead_grave (151) then e
    press(&s, &t, 151 as u32, 0 as u32)
    press(&s, &t, 26 as u32, 0 as u32)
    let r3: u32 = drain_first(&t)
    say("dead_grave e ->", r3 as u64)
    // Multi_key (152) ' e
    press(&s, &t, 152 as u32, 0 as u32)
    press(&s, &t, 48 as u32, 0 as u32)
    press(&s, &t, 26 as u32, 0 as u32)
    let r4: u32 = drain_first(&t)
    say("Multi_key ' e ->", r4 as u64)
    say("engine fallbacks", textsys.sys_fallbacks(&s))
    // spot: no crash
    textcore.text_set_spot(&t, 5 as i32, 6 as i32, 1 as i32, 12 as i32)
    textsys.sys_spot(&s, &t)
    textsys.sys_pump(&s, &t)
    textsys.sys_close(&s)
    return FAILS
}
