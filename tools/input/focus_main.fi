import std.rt
import std.io
import std.str
import window.window

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn now_ms() -> i64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0] * 1000 + ts[1] / 1000000
}

fn flag(b: bool) -> i64 {
    if b { return 1 }
    return 0
}

fn main(start: u64) -> i32 {
    var mode: str = "raw"
    var capture: bool = true
    if rt.arg_count(start) > 1 { mode = arg(start, 1) }
    if rt.arg_count(start) > 2 && arg(start, 2) == "plain" { capture = false }
    var w: window.Window = window.window_new()
    if !window.open_window(&w, 0) {
        io.print_line("NODISPLAY")
        return 1
    }
    window.raw_input(&w, true)
    if !window.make(&w, 400, 300) {
        io.print_line("MAKE-FAILED")
        return 3
    }
    var name: str = "mffocus_a"
    if !capture { name = "mffocus_b" }
    window.title(&w, name.p as u64, name.n)
    window.show_window(&w)
    window.present(&w)
    var t0: i64 = now_ms()
    while now_ms() - t0 < 400 {
        window.wait_event(&w, 50)
        while window.next_event(&w) != window.EV_NONE {
        }
    }
    var armed: bool = false
    if capture {
        window.cursor_raw(&w, mode == "raw")
        armed = window.cursor_mode(&w, window.CURSOR_CAPTURED)
        io.fmt_print(f"GRAB {flag(armed)}\n")
    }
    io.print_line("READY")
    var d: [i64; 2] = [0; 2]
    var done: bool = false
    t0 = now_ms()
    while !done && now_ms() - t0 < 30000 {
        window.wait_event(&w, 50)
        if capture && !armed && window.cursor_mode(&w, window.CURSOR_CAPTURED) {
            armed = true
            io.print_line("GRAB 1 late")
        }
        var k: u32 = window.next_event(&w)
        while k != window.EV_NONE {
            if k == window.EV_RAWKEY && window.ev_x(&w) == 113 as u32 { done = true }
            if k == window.EV_CLOSED { done = true }
            if k == window.EV_FOCUS && capture {
                let g: i64 = window.ev_a(&w) as i64
                let still: bool = window.cursor_delta(&w, (&d[0]) as u64)
                io.fmt_print(f"FOCUS {g} captured_after={flag(still)}\n")
                let again: bool = window.cursor_mode(&w, window.CURSOR_CAPTURED)
                io.fmt_print(f"REGRAB focus={g} ok={flag(again)}\n")
                if again && g == 0 as i64 { window.cursor_mode(&w, window.CURSOR_NORMAL) }
            }
            k = window.next_event(&w)
        }
        window.cursor_delta(&w, (&d[0]) as u64)
    }
    window.cursor_mode(&w, window.CURSOR_NORMAL)
    io.print_line("DONE")
    window.close_window(&w)
    return 0
}
