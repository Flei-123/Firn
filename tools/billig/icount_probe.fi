// tools/billig/icount_probe.fi -- die Probe fuer die EXAKTE Befehlszahl.
//
// WOZU EINE EIGENE. Die elf Baenke in `bench/firn/` sind fuer die Wanduhr
// gemacht und laufen hunderte Millionen Befehle. `qemu-aarch64 -singlestep
// -d cpu` schreibt je ausgefuehrtem Befehl rund tausend Oktette
// Registerzustand; gezaehlt werden dabei etwa 66 000 Befehle je Sekunde.
// `fib` allein waere so ueber eine Stunde -- zweimal.
//
// Diese Probe macht dasselbe in klein: EINE Schleife, ein Aufruf, ein
// Feldzugriff, ein Strukturfeld, eine Division, eine Verzweigung -- also
// genau die Formen, an denen der Registerzuteiler etwas aendert -- und
// bleibt bei ein paar Millionen Befehlen. Die Zahl darunter ist damit
// EXAKT und nicht geschaetzt.
//
// Bauen und zaehlen:
//   firnc --target=aarch64-linux -o probe tools/billig/icount_probe.fi
//   bash tools/billig/arm_icount.sh 600 probe

struct Punkt {
    x: i64,
    y: i64,
}

fn misch(a: i64, b: i64) -> i64 {
    if a % 7 == 0 {
        return a + b * 3
    }
    return a - b
}

fn main() -> i32 {
    var feld: [i64; 64] = [0; 64]
    var i: i64 = 0
    while i < 64 {
        feld[i as usize] = i * 3 + 1
        i = i + 1
    }
    var p: Punkt = Punkt { x: 1, y: 2 }
    var s: i64 = 0
    var k: i64 = 0
    while k < 20000 {
        let idx: i64 = k % 64
        s = s + feld[idx as usize]
        s = misch(s, k)
        p.x = p.x + (s % 5)
        p.y = p.y - (s % 3)
        if s > 1000000 {
            s = s % 1000000
        }
        k = k + 1
    }
    return ((s + p.x + p.y) % 100) as i32
}
