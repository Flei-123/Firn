// tools/billig/icount_probe.fi -- the probe for the EXACT instruction count.
//
// WHY A SEPARATE ONE. The eleven benches in `bench/firn/` are made for the
// wall clock and run hundreds of millions of instructions.
// `qemu-aarch64 -singlestep -d cpu` writes about a thousand octets of register
// state per executed instruction; about 66 000 instructions per second get
// counted. `fib` alone would take over an hour that way -- twice.
//
// This probe does the same thing small: ONE loop, one call, one array access,
// one struct field, one division, one branch -- exactly the shapes at which
// the register allocator changes something -- and stays at a few million
// instructions. The number below is therefore EXACT and not estimated.
//
// Build and count:
//   firnc --target=aarch64-linux -o probe tools/billig/icount_probe.fi
//   bash tools/billig/arm_icount.sh 600 probe

struct Point {
    x: i64,
    y: i64,
}

fn mix(a: i64, b: i64) -> i64 {
    if a % 7 == 0 {
        return a + b * 3
    }
    return a - b
}

fn main() -> i32 {
    var cells: [i64; 64] = [0; 64]
    var i: i64 = 0
    while i < 64 {
        cells[i as usize] = i * 3 + 1
        i = i + 1
    }
    var p: Point = Point { x: 1, y: 2 }
    var s: i64 = 0
    var k: i64 = 0
    while k < 20000 {
        let idx: i64 = k % 64
        s = s + cells[idx as usize]
        s = mix(s, k)
        p.x = p.x + (s % 5)
        p.y = p.y - (s % 3)
        if s > 1000000 {
            s = s % 1000000
        }
        k = k + 1
    }
    return ((s + p.x + p.y) % 100) as i32
}
