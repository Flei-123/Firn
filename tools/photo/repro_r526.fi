import std.io
import std.rt

struct Img {
    w: i32,
    h: i32,
    ch: i32,
    px: u64,
}

#[inline]
fn img_get(im: *mut Img, c: i32, x: i32, y: i32) -> f32 {
    return *(((*im).px + (((c * (*im).h + y) * (*im).w + x) as u64) * (4 as u64)) as *mut f32)
}

fn ssim(a: *mut Img, b: *mut Img, range: f32) -> f32 {
    let w: i32 = (*a).w
    let h: i32 = (*a).h
    let c1: f64 = (0.01 * (range as f64)) * (0.01 * (range as f64))
    let c2: f64 = (0.03 * (range as f64)) * (0.03 * (range as f64))
    var total: f64 = 0.0
    var cnt: f64 = 0.0
    var c: i32 = 0
    while c < (*a).ch {
        var y: i32 = 3
        while y < h - 3 {
            var x: i32 = 3
            while x < w - 3 {
                var sa: f64 = 0.0
                var sb: f64 = 0.0
                var saa: f64 = 0.0
                var sbb: f64 = 0.0
                var sab: f64 = 0.0
                var dy: i32 = -3
                while dy <= 3 {
                    var dx: i32 = -3
                    while dx <= 3 {
                        let va: f64 = img_get(a, c, x + dx, y + dy) as f64
                        let vb: f64 = img_get(b, c, x + dx, y + dy) as f64
                        sa = sa + va
                        sb = sb + vb
                        saa = saa + va * va
                        sbb = sbb + vb * vb
                        sab = sab + va * vb
                        dx = dx + 1
                    }
                    dy = dy + 1
                }
                let np: f64 = 49.0
                let ma: f64 = sa / np
                let mb: f64 = sb / np
                let cf: f64 = np / (np - 1.0)
                let va2: f64 = cf * (saa / np - ma * ma)
                let vb2: f64 = cf * (sbb / np - mb * mb)
                let vab: f64 = cf * (sab / np - ma * mb)
                total = total + ((2.0 * ma * mb + c1) * (2.0 * vab + c2)) / ((ma * ma + mb * mb + c1) * (va2 + vb2 + c2))
                cnt = cnt + 1.0
                x = x + 1
            }
            y = y + 1
        }
        c = c + 1
    }
    return (total / cnt) as f32
}

fn main() -> i32 {
    let n: usize = 16 * 16 * 3 * 4
    let pa: u64 = rt.heap_alloc(n)
    let pb: u64 = rt.heap_alloc(n)
    var i: i32 = 0
    while i < 768 {
        *((pa + (i as u64) * (4 as u64)) as *mut f32) = ((i * 7 % 13) as f32) * 0.1f
        *((pb + (i as u64) * (4 as u64)) as *mut f32) = ((i * 5 % 11) as f32) * 0.1f
        i = i + 1
    }
    var a: Img = Img { w: 16, h: 16, ch: 3, px: pa }
    var b: Img = Img { w: 16, h: 16, ch: 3, px: pb }
    io.fmt_print_line(io.fmt_f32(io.fmt_new(), ssim(&a, &b, 1.0f)))
    return 0
}
