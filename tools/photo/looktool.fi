// tools/photo/looktool.fi -- apply photo.look (+ optional sharpen) to a raw RGBA8 file; for calibration against real photos.
// Usage: looktool IN.rgba OUT.rgba W H STRENGTH_x100 SHARPEN_x100
import std.io
import std.rt
import std.fs
import photo.image
import photo.look
import photo.sharpen
import photo.par

fn parse_dec(p: u64, fallback: u64) -> u64 {
    let n: usize = rt.c_length(p)
    if n == 0 { return fallback }
    var v: u64 = 0
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 { return fallback }
        v = v * 10 + (c - 48 as u8) as u64
        i = i + 1
    }
    return v
}

fn cstr(p: u64) -> str {
    var s: str = ""
    s.p = p as *mut u8
    s.n = rt.c_length(p)
    return s
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 7 { io.print("usage: looktool IN.rgba OUT.rgba W H STRENGTH_x100 SHARPEN_x100"); io.new_line(); return 2 }
    let inp: str = cstr(rt.arg_ptr(start, 1))
    let outp: str = cstr(rt.arg_ptr(start, 2))
    let w: i32 = parse_dec(rt.arg_ptr(start, 3), 0) as i32
    let h: i32 = parse_dec(rt.arg_ptr(start, 4), 0) as i32
    let st: f32 = (parse_dec(rt.arg_ptr(start, 5), 100) as f32) / 100.0f
    let sh: f32 = (parse_dec(rt.arg_ptr(start, 6), 0) as f32) / 100.0f
    par.init(7)
    var b: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(inp, &b) catch 0
    if n < ((w * h * 4) as usize) { io.print("short input"); io.new_line(); return 1 }
    var im: image.Image = image.img_from_rgba8(rt.buf_ptr(&b), w, h)
    var o: look.LookOpts = look.look_scaled(st)
    look.look_apply(&im, &o)
    if sh > 0.0f { sharpen.sharpen(&im, sh, 1.2f, 0.004f) }
    image.img_to_rgba8(&im, rt.buf_ptr(&b))
    let r: usize = fs.write_file(outp, rt.buf_ptr(&b), (w * h * 4) as usize) catch 0
    return 0
}
