// tools/photo/bench.fi -- FirnCam pipeline timing per stage on a synthetic burst.
// Usage: bench W H FRAMES THREADS     (THREADS = workers + caller; 1 = sequential)
// Prints `name value` lines: stage times in ms, `total_ms`, and `out_hash` (FNV-1a of the output float bits) so two
// runs (before / after a change, 1 vs N threads) can be compared bit for bit.
import std.io
import std.rt
import std.time
import jobs.jobs
import photo.image
import photo.meta
import photo.noise
import photo.merge
import photo.synth
import photo.pipeline
import photo.par
import photo.denoise
import photo.tonemap
import photo.sharpen
import photo.color

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND {
        return jobs.worker_main(arg)
    }
    return 0
}

fn parse_dec(p: u64, fallback: u64) -> u64 {
    let n: usize = rt.c_length(p)
    if n == 0 { return fallback }
    var v: u64 = 0
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 { return fallback }
        v = v * 10 + (c - 48 as u8) as u64
        i = i + 1
    }
    return v
}

fn pf(name: str, v: f32) {
    io.print(name)
    io.print(" ")
    io.fmt_print_line(io.fmt_f32(io.fmt_new(), v))
}

fn pu(name: str, v: u64) {
    io.print(name)
    io.print(" ")
    io.fmt_print_line(io.fmt_u64(io.fmt_new(), v))
}

fn ms_since(t0: u64) -> u64 {
    return (time.monotonic_ns() - t0) / 1000000
}

fn hash_image(im: *mut image.Image) -> u64 {
    var h: u64 = 14695981039346656037
    let n: i32 = (*im).w * (*im).h * (*im).ch
    var i: i32 = 0
    while i < n {
        let b: u32 = __bits(*(((*im).px + (i as u64) * (4 as u64)) as *mut f32))
        h = (h ^ (b as u64)) * 1099511628211
        i = i + 1
    }
    return h
}

fn main(start: u64) -> i32 {
    var w: i32 = 1152
    var h: i32 = 864
    var nf: i32 = 8
    var th: u64 = 1
    if rt.arg_count(start) > 1 { w = parse_dec(rt.arg_ptr(start, 1), 1152) as i32 }
    if rt.arg_count(start) > 2 { h = parse_dec(rt.arg_ptr(start, 2), 864) as i32 }
    if rt.arg_count(start) > 3 { nf = parse_dec(rt.arg_ptr(start, 3), 8) as i32 }
    if rt.arg_count(start) > 4 { th = parse_dec(rt.arg_ptr(start, 4), 1) }
    if th > 1 { par.init(th - 1) }

    let ts: f32 = 2.0e-3f
    let to: f32 = 2.0e-5f
    var scene: image.Image = image.scene_make(w, h)
    var rng: image.Rng = image.rng_new(11 as u64)
    var m: meta.SensorMeta = meta.meta_default()
    meta.meta_set_noise(&m, 0, ts, to)
    meta.meta_set_noise(&m, 1, ts, to)
    meta.meta_set_noise(&m, 2, ts, to)
    meta.meta_set_noise(&m, 3, ts, to)
    var o: pipeline.PipeOpts = pipeline.opts_default()
    var b: merge.Burst = merge.burst_new()
    synth.synth_burst(&scene, nf, 1.0f, ts, to, 3.0f, &rng, &b)
    image.img_free(&scene)
    pu("width", w as u64)
    pu("height", h as u64)
    pu("frames", nf as u64)
    pu("threads", par.threads())

    let t_all: u64 = time.monotonic_ns()
    var t0: u64 = time.monotonic_ns()
    let r: i32 = pipeline.pick_reference(&b)
    pu("ms_pick_reference", ms_since(t0))
    var nm: noise.NoiseModel = noise.from_meta(&m)
    var lin: image.Image = image.img_new(1, 1, 3)
    var vp: image.Image = image.img_new(1, 1, 1)
    var ws: image.Image = image.img_new(1, 1, 1)
    image.img_free(&lin)
    image.img_free(&vp)
    image.img_free(&ws)
    t0 = time.monotonic_ns()
    merge.merge_burst(&b, r, &nm, &lin, &vp, &ws)
    pu("ms_merge", ms_since(t0))
    image.img_free(&ws)
    merge.burst_free(&b)

    t0 = time.monotonic_ns()
    color.gray_world(&lin, o.wb)
    pu("ms_color", ms_since(t0))
    var den: image.Image = image.img_new(1, 1, 3)
    image.img_free(&den)
    t0 = time.monotonic_ns()
    denoise.denoise(&lin, &vp, o.denoise, o.keep, &den)
    pu("ms_denoise", ms_since(t0))
    image.img_free(&lin)
    image.img_free(&vp)
    var to2: tonemap.ToneOpts = tonemap.tone_default()
    t0 = time.monotonic_ns()
    tonemap.tonemap(&den, &to2)
    pu("ms_tonemap", ms_since(t0))
    t0 = time.monotonic_ns()
    image.img_to_srgb(&den)
    pu("ms_srgb", ms_since(t0))
    t0 = time.monotonic_ns()
    sharpen.sharpen(&den, o.sharpen, 1.2f, 0.004f)
    pu("ms_sharpen", ms_since(t0))
    pu("total_ms", ms_since(t_all))
    pu("out_hash", hash_image(&den))
    image.img_free(&den)
    par.shutdown()
    return 0
}
