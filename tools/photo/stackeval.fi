// SPDX-License-Identifier: MPL-2.0
// tools/photo/stackeval.fi -- FirnCam focus stack measurement on the synthetic TV scene (photo.stackrig, photo.synthtv).
// Run through tools/photo/stackeval.sh (writes PPMs next to the metrics). Prints `variant.metric value` lines.
//
// Chain: RGGB mosaics -> camjob.raw_half + neutralise_clipped (exactly what the app does per frame) ->
// focus.focus_stack -> pipeline.process_single_linear (colour, denoise, tone map, sRGB, sharpen). The IDEAL is
// the same chain applied to the sharp, noise free render of the reference geometry (same exposure, same TV
// flicker phase and video state), so every difference is caused by the stack, not by the display chain.
// Metrics (display space, 0..1; zones are derived from the ideal):
//   halo     mean overshoot outside the 5x5 envelope of the ideal luma in the dark zone around the bright TV parts
//   glow     mean signed luma difference in that zone (positive = a light veil around bright parts)
//   fringe   mean chroma error ((R-Y), (B-Y)) in the edge zone
//   p1       1 % luma percentile of the whole image (black point) and wall = mean luma of the dark wall
//   psnr_*   PSNR per region (tv screen, dark wall, near layer, whole image)
//   tvsat    mean chroma of the TV screen relative to the ideal (pastel < 1)
import std.io
import photo.image
import photo.merge
import photo.par
import photo.focus
import photo.stackrig

fn main() -> i32 {
    par.init(4)
    let sw: i32 = 640
    let sh: i32 = 480
    var rg: stackrig.Rig = stackrig.rig_new(sw, sh, 6, 5 as u64)
    var i: i32 = 0
    // best single frame: every frame against the sharp render of ITS OWN geometry
    var best_all: f32 = 0.0f
    var best_tv: f32 = 0.0f
    var best_wall: f32 = 0.0f
    var best_near: f32 = 0.0f
    while i < rg.n {
        var tr: image.Image = stackrig.truth_half(&rg, i)
        var idl: image.Image = stackrig.chain(&tr, &rg.m)
        var fr: image.Image = stackrig.half_of(&rg, rg.mos[i as usize])
        var fo: image.Image = stackrig.chain(&fr, &rg.m)
        var mk: stackrig.Masks = stackrig.masks_of(&tr, &idl)
        let r: stackrig.Res = stackrig.evaluate("single", &fo, &idl, &mk, false)
        if r.psnr_all > best_all { best_all = r.psnr_all }
        if r.psnr_tv > best_tv { best_tv = r.psnr_tv }
        if r.psnr_wall > best_wall { best_wall = r.psnr_wall }
        if r.psnr_near > best_near { best_near = r.psnr_near }
        stackrig.pf("single", "psnr_all_i", r.psnr_all)
        stackrig.masks_free(&mk)
        image.img_free(&tr)
        image.img_free(&idl)
        image.img_free(&fr)
        image.img_free(&fo)
        i = i + 1
    }
    stackrig.pf("best_single", "psnr_all", best_all)
    stackrig.pf("best_single", "psnr_tv", best_tv)
    stackrig.pf("best_single", "psnr_wall", best_wall)
    stackrig.pf("best_single", "psnr_near", best_near)
    // legacy stack (first FirnCam version) and the robust stack: each against the ideal of ITS reference frame
    var v: i32 = 0
    while v < 2 {
        var o: focus.FocusOpts = focus.focus_legacy()
        var tag: str = "legacy"
        if v == 1 {
            o = focus.focus_default()
            o.noise_s = rg.cfg.ns
            o.noise_o = rg.cfg.no
            tag = "robust"
        }
        var bb: merge.Burst = stackrig.burst_of(&rg)
        let r: i32 = focus.pick_ref(&bb, &o)
        merge.burst_free(&bb)
        var tr: image.Image = stackrig.truth_half(&rg, r)
        var idl: image.Image = stackrig.chain(&tr, &rg.m)
        var mk: stackrig.Masks = stackrig.masks_of(&tr, &idl)
        var out: image.Image = stackrig.run_stack(&rg, &o)
        stackrig.pf(tag, "ref", r as f32)
        stackrig.evaluate(tag, &out, &idl, &mk, true)
        stackrig.pf(tag, "out_w", out.w as f32)
        stackrig.pf(tag, "out_h", out.h as f32)
        if v == 0 { image.img_write_ppm(&out, "legacy.ppm") } else { image.img_write_ppm(&out, "robust.ppm") }
        image.img_write_ppm(&idl, "ideal.ppm")
        stackrig.masks_free(&mk)
        image.img_free(&tr)
        image.img_free(&idl)
        image.img_free(&out)
        v = v + 1
    }
    var f0: image.Image = stackrig.half_of(&rg, rg.mos[1])
    var fo0: image.Image = stackrig.chain(&f0, &rg.m)
    image.img_write_ppm(&fo0, "single1.ppm")
    par.shutdown()
    return 0
}
