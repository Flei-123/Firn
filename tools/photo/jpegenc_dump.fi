// tools/photo/jpegenc_dump.fi -- writes a PPM of a synthetic scene plus JPEGs at quality 90/95 (4:2:0 and 4:4:4)
// into the directory given as first argument; tools/photo/jpegenc_pil.py decodes them with Pillow.
import std.io
import std.rt
import std.fs
import photo.image
import photo.jpegenc

fn dump(dir: str, name: str, q: i32, sub: bool, im: *mut image.Image) {
    var o: jpegenc.EncOpts = jpegenc.enc_default()
    o.quality = q
    o.subsample = sub
    let cap: usize = jpegenc.jpeg_max_size((*im).w, (*im).h)
    let buf: u64 = rt.heap_alloc(cap)
    let n: usize = jpegenc.jpeg_encode_image(im, &o, buf, cap)
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir.p as u64, dir.n)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    var ps: str = ""
    ps.p = rt.buf_ptr(&path) as *mut u8
    ps.n = rt.buf_len(&path)
    let r: usize = fs.write_file(ps, buf, n) catch 0
    rt.heap_free(buf, cap)
    rt.buf_free(&path)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 { return 1 }
    var a: str = ""
    a.p = rt.arg_ptr(start, 1) as *mut u8
    a.n = rt.c_length(rt.arg_ptr(start, 1))
    var im: image.Image = image.scene_make(640, 480)
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, a.p as u64, a.n)
    rt.buf_push_bytes(&path, "ref.ppm".p as u64, 7)
    var ps: str = ""
    ps.p = rt.buf_ptr(&path) as *mut u8
    ps.n = rt.buf_len(&path)
    image.img_write_ppm(&im, ps)
    dump(a, "q90_420.jpg", 90, true, &im)
    dump(a, "q95_420.jpg", 95, true, &im)
    dump(a, "q90_444.jpg", 90, false, &im)
    dump(a, "q95_444.jpg", 95, false, &im)
    return 0
}
