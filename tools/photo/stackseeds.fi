// SPDX-License-Identifier: MPL-2.0
// tools/photo/stackseeds.fi -- FirnCam focus stack over SEVERAL seeds / scene variants: stack vs best single frame.
// Run through tools/photo/stackseeds.sh. Per scene one line, then mean / minimum of (stack - best single) in dB.
import std.io
import photo.image
import photo.par
import photo.focus
import photo.stackrig
import photo.synthtv

fn one_scene(tag: str, rg: *mut stackrig.Rig, sum: *mut [f32; 4], mn: *mut [f32; 4]) {
    var o: focus.FocusOpts = focus.focus_default()
    o.noise_s = (*rg).cfg.ns
    o.noise_o = (*rg).cfg.no
    var ba: f32 = 0.0f
    var bt: f32 = 0.0f
    var bw: f32 = 0.0f
    var bn: f32 = 0.0f
    var i: i32 = 0
    while i < (*rg).n {
        let r: stackrig.Res = stackrig.single_res(rg, i)
        if r.psnr_all > ba { ba = r.psnr_all }
        if r.psnr_tv > bt { bt = r.psnr_tv }
        if r.psnr_wall > bw { bw = r.psnr_wall }
        if r.psnr_near > bn { bn = r.psnr_near }
        i = i + 1
    }
    var rf: i32 = 0
    let s: stackrig.Res = stackrig.stack_res(rg, &o, "x", false, &rf)
    let one: stackrig.Res = stackrig.single_res(rg, rf)
    stackrig.pf(tag, "ref", rf as f32)
    stackrig.pf(tag, "all", s.psnr_all)
    stackrig.pf(tag, "best_all", ba)
    stackrig.pf(tag, "tv", s.psnr_tv)
    stackrig.pf(tag, "best_tv", bt)
    stackrig.pf(tag, "wall", s.psnr_wall)
    stackrig.pf(tag, "best_wall", bw)
    stackrig.pf(tag, "near", s.psnr_near)
    stackrig.pf(tag, "best_near", bn)
    stackrig.pf(tag, "halo", s.halo)
    stackrig.pf(tag, "fringe", s.fringe)
    stackrig.pf(tag, "ref_fringe", one.fringe)
    stackrig.pf(tag, "tvsat", s.tvsat)
    stackrig.pf(tag, "ref_tvsat", one.tvsat)
    stackrig.pf(tag, "p1", s.p1)
    stackrig.pf(tag, "ref_p1", one.p1)
    let d: [f32; 4] = [s.psnr_all - ba, s.psnr_tv - bt, s.psnr_wall - bw, s.psnr_near - bn]
    var k: usize = 0
    while k < 4 {
        (*sum)[k] = (*sum)[k] + d[k]
        if d[k] < (*mn)[k] { (*mn)[k] = d[k] }
        k = k + 1
    }
    stackrig.pf(tag, "d_all", d[0])
    stackrig.pf(tag, "d_tv", d[1])
    stackrig.pf(tag, "tvabs", s.psnr_tv)
    stackrig.pf(tag, "fb", focus.fallback_frac())
}

fn variant_cfg(v: i32) -> synthtv.TvCfg {
    var cfg: synthtv.TvCfg = synthtv.tv_cfg_default(640, 480)
    if v == 1 {
        // heavy hand shake + rotation + focus breathing + strong auto exposure / display flicker
        cfg.shake = cfg.shake * 4.0f
        cfg.rot = cfg.rot * 4.0f
        cfg.breathing = cfg.breathing * 3.0f
        cfg.ae_var = 0.5f
        cfg.flicker = 0.6f
    }
    if v == 2 {
        // noisy dim scene (high ISO)
        cfg.ns = cfg.ns * 6.0f
        cfg.no = cfg.no * 6.0f
    }
    return cfg
}

fn main() -> i32 {
    par.init(4)
    var v: i32 = 0
    while v < 4 {
        var sum: [f32; 4] = [0.0f; 4]
        var mn: [f32; 4] = [100.0f; 4]
        var cnt: f32 = 0.0f
        // rng_new maps neighbouring seeds (2k, 2k+1) to the same stream: step 2 gives distinct scenes
        var seed: i32 = 5
        var last: i32 = 19
        var nf: i32 = 6
        if v == 3 { nf = 3 }
        if v > 0 { last = 11 }
        while seed <= last {
            var rg: stackrig.Rig = stackrig.rig_from_cfg(variant_cfg(v), nf, seed as u64)
            one_scene("seed", &rg, &sum, &mn)
            stackrig.rig_free(&rg)
            cnt = cnt + 1.0f
            seed = seed + 2
        }
        var name: str = "norm"
        if v == 1 { name = "hard" }
        if v == 2 { name = "noisy" }
        if v == 3 { name = "few" }
        stackrig.pf(name, "mean_d_all", sum[0] / cnt)
        stackrig.pf(name, "mean_d_tv", sum[1] / cnt)
        stackrig.pf(name, "mean_d_wall", sum[2] / cnt)
        stackrig.pf(name, "mean_d_near", sum[3] / cnt)
        stackrig.pf(name, "min_d_all", mn[0])
        stackrig.pf(name, "min_d_tv", mn[1])
        stackrig.pf(name, "min_d_wall", mn[2])
        stackrig.pf(name, "min_d_near", mn[3])
        v = v + 1
    }
    par.shutdown()
    return 0
}
