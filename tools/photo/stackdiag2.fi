// tools/photo/stackdiag2.fi -- noise free scene: how much of the error is blur? (developer tool)
import std.io
import photo.image
import photo.par
import photo.focus
import photo.synthtv
import photo.stackrig

fn main() -> i32 {
    par.init(4)
    var cfg: synthtv.TvCfg = synthtv.tv_cfg_default(640, 480)
    var v: i32 = 0
    while v < 2 {
        var ts: str = "noisy_single"
        var tk: str = "noisy_stack"
        if v == 1 {
            ts = "clean_single"
            tk = "clean_stack"
        }
        if v == 1 {
            cfg.ns = 0.0f
            cfg.no = 0.0f
        }
        var rg: stackrig.Rig = stackrig.rig_from_cfg(cfg, 6, 5 as u64)
        var i: i32 = 0
        while i < 6 {
            let r: stackrig.Res = stackrig.single_res(&rg, i)
            stackrig.pf(ts, "tv", r.psnr_tv)
            stackrig.pf(ts, "all", r.psnr_all)
            i = i + 1
        }
        var o: focus.FocusOpts = focus.focus_default()
        o.noise_s = cfg.ns
        o.noise_o = cfg.no
        var rf: i32 = 0
        let s: stackrig.Res = stackrig.stack_res(&rg, &o, "x", false, &rf)
        stackrig.pf(tk, "tv", s.psnr_tv)
        stackrig.pf(tk, "all", s.psnr_all)
        stackrig.rig_free(&rg)
        v = v + 1
    }
    par.shutdown()
    return 0
}
