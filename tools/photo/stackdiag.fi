// tools/photo/stackdiag.fi -- FirnCam stack option sweep on two seeds (developer tool): prints PSNR per region per variant.
import std.io
import photo.image
import photo.par
import photo.focus
import photo.stackrig

fn run_v(tag: str, rg: *mut stackrig.Rig, o: *mut focus.FocusOpts) {
    var rf: i32 = 0
    let s: stackrig.Res = stackrig.stack_res(rg, o, tag, false, &rf)
    stackrig.pf(tag, "all", s.psnr_all)
    stackrig.pf(tag, "tv", s.psnr_tv)
    stackrig.pf(tag, "wall", s.psnr_wall)
    stackrig.pf(tag, "near", s.psnr_near)
    stackrig.pf(tag, "halo", s.halo)
    stackrig.pf(tag, "fringe", s.fringe)
    stackrig.pf(tag, "tvsat", s.tvsat)
}

fn main() -> i32 {
    par.init(4)
    var seed: i32 = 5
    while seed <= 9 {
        var rg: stackrig.Rig = stackrig.rig_new(640, 480, 6, seed as u64)
        stackrig.pf("seed", "n", seed as f32)
        var o: focus.FocusOpts = focus.focus_default()
        o.noise_s = rg.cfg.ns
        o.noise_o = rg.cfg.no
        run_v("base", &rg, &o)
        o.warp_cubic = 0
        run_v("bilinear", &rg, &o)
        stackrig.rig_free(&rg)
        seed = seed + 4
    }
    par.shutdown()
    return 0
}
