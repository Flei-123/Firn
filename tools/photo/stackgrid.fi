// SPDX-License-Identifier: MPL-2.0
// tools/photo/stackgrid.fi -- where does the TV error sit? MSE (x1e4, display space) on a 12 x 6 grid over the TV rectangle,
// for the stack and for the reference frame alone (developer tool).
import std.io
import photo.image
import photo.par
import photo.focus
import photo.merge
import photo.stackrig

fn cell_mse(a: *mut image.Image, b: *mut image.Image, x0: i32, y0: i32, x1: i32, y1: i32) -> f32 {
    var s: f32 = 0.0f
    var n: f32 = 0.0f
    var y: i32 = y0
    while y < y1 {
        var x: i32 = x0
        while x < x1 {
            var c: i32 = 0
            while c < 3 {
                let d: f32 = image.img_get(a, c, x, y) - image.img_get(b, c, x, y)
                s = s + d * d
                n = n + 1.0f
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return s / n
}

fn print_grid(tag: str, a: *mut image.Image, b: *mut image.Image) {
    let w: i32 = (*a).w
    let h: i32 = (*a).h
    let x0: i32 = (w * 16) / 100
    let x1: i32 = (w * 84) / 100
    let y0: i32 = (h * 34) / 100
    let y1: i32 = (h * 70) / 100
    var gy: i32 = 0
    while gy < 6 {
        var line: io.Fmt = io.fmt_new()
        var gx: i32 = 0
        while gx < 12 {
            let cx0: i32 = x0 + ((x1 - x0) * gx) / 12
            let cx1: i32 = x0 + ((x1 - x0) * (gx + 1)) / 12
            let cy0: i32 = y0 + ((y1 - y0) * gy) / 6
            let cy1: i32 = y0 + ((y1 - y0) * (gy + 1)) / 6
            let m: f32 = cell_mse(a, b, cx0, cy0, cx1, cy1) * 10000.0f
            line = io.fmt_f32(line, m)
            line = io.fmt_str(line, " ")
            gx = gx + 1
        }
        io.print(tag)
        io.print(" ")
        io.fmt_print_line(line)
        gy = gy + 1
    }
}

fn main() -> i32 {
    par.init(4)
    var rg: stackrig.Rig = stackrig.rig_new(640, 480, 6, 5 as u64)
    var o: focus.FocusOpts = focus.focus_default()
    o.noise_s = rg.cfg.ns
    o.noise_o = rg.cfg.no
    var bb: merge.Burst = stackrig.burst_of(&rg)
    let r: i32 = focus.pick_ref(&bb, &o)
    merge.burst_free(&bb)
    var tr: image.Image = stackrig.truth_half(&rg, r)
    var idl: image.Image = stackrig.chain(&tr, &rg.m)
    var out: image.Image = stackrig.run_stack(&rg, &o)
    var fr: image.Image = stackrig.half_of(&rg, rg.mos[r as usize])
    var fo: image.Image = stackrig.chain(&fr, &rg.m)
    print_grid("stack", &out, &idl)
    print_grid("ref  ", &fo, &idl)
    image.img_write_ppm(&out, "stack.ppm")
    image.img_write_ppm(&fo, "ref.ppm")
    image.img_write_ppm(&idl, "ideal.ppm")
    par.shutdown()
    return 0
}
