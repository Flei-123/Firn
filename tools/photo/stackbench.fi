// SPDX-License-Identifier: MPL-2.0
// tools/photo/stackbench.fi -- FirnCam focus_stack timing on a synthetic burst (focus.focus_stack only).
// Usage: stackbench W H FRAMES THREADS     (THREADS = workers + caller; 1 = sequential)
// Prints `name value` lines: `ms_stack`, `out_hash` (FNV-1a of the output float bits: equal for any thread count), fallback share.
import std.io
import std.rt
import std.time
import jobs.jobs
import photo.image
import photo.meta
import photo.noise
import photo.merge
import photo.synth
import photo.focus
import photo.par

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND {
        return jobs.worker_main(arg)
    }
    return 0
}

fn parse_dec(p: u64, fallback: u64) -> u64 {
    let n: usize = rt.c_length(p)
    if n == 0 { return fallback }
    var v: u64 = 0
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 { return fallback }
        v = v * 10 + (c - 48 as u8) as u64
        i = i + 1
    }
    return v
}

fn pf(name: str, v: f32) {
    io.print(name)
    io.print(" ")
    io.fmt_print_line(io.fmt_f32(io.fmt_new(), v))
}

fn pu(name: str, v: u64) {
    io.print(name)
    io.print(" ")
    io.fmt_print_line(io.fmt_u64(io.fmt_new(), v))
}

fn ms_since(t0: u64) -> u64 {
    return (time.monotonic_ns() - t0) / 1000000
}

fn hash_image(im: *mut image.Image) -> u64 {
    var h: u64 = 14695981039346656037
    let n: i32 = (*im).w * (*im).h * (*im).ch
    var i: i32 = 0
    while i < n {
        let b: u32 = __bits(*(((*im).px + (i as u64) * (4 as u64)) as *mut f32))
        h = (h ^ (b as u64)) * 1099511628211
        i = i + 1
    }
    return h
}

fn main(start: u64) -> i32 {
    var w: i32 = 2048
    var h: i32 = 1536
    var nf: i32 = 8
    var th: u64 = 8
    if rt.arg_count(start) > 1 { w = parse_dec(rt.arg_ptr(start, 1), 2048) as i32 }
    if rt.arg_count(start) > 2 { h = parse_dec(rt.arg_ptr(start, 2), 1536) as i32 }
    if rt.arg_count(start) > 3 { nf = parse_dec(rt.arg_ptr(start, 3), 8) as i32 }
    if rt.arg_count(start) > 4 { th = parse_dec(rt.arg_ptr(start, 4), 8) }
    if th > 1 { par.init(th - 1) }
    var scene: image.Image = image.scene_make(w, h)
    var rng: image.Rng = image.rng_new(11 as u64)
    var b: merge.Burst = merge.burst_new()
    synth.synth_burst(&scene, nf, 1.0f, 2.0e-3f, 2.0e-5f, 3.0f, &rng, &b)
    image.img_free(&scene)
    pu("width", w as u64)
    pu("height", h as u64)
    pu("frames", nf as u64)
    pu("threads", par.threads())
    var o: focus.FocusOpts = focus.focus_default()
    o.noise_s = 2.0e-3f
    o.noise_o = 2.0e-5f
    var st: image.Image = image.img_new(1, 1, 3)
    var dp: image.Image = image.img_new(1, 1, 1)
    image.img_free(&st)
    image.img_free(&dp)
    let t0: u64 = time.monotonic_ns()
    focus.focus_stack(&b, &o, &st, &dp)
    pu("ms_stack", ms_since(t0))
    pu("out_hash", hash_image(&st))
    pf("fallback_frac", focus.fallback_frac())
    image.img_free(&st)
    image.img_free(&dp)
    merge.burst_free(&b)
    par.shutdown()
    return 0
}
