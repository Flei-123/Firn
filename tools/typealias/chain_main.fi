// expect_exit: 0
// tools/typealias/chain_main.fi -- three modules, each alias built on the one below,
// the topmost module imported FIRST (the order of the queue is the wrong one for it).
import chain_c1
import chain_c2
import chain_c3

fn main() -> i32 {
    let t: chain_c1.T1 = chain_c2.make(3)
    let u: chain_c3.Rec = t
    if chain_c1.total(u) != 7 {
        return 1
    }
    return 0
}
