// expect_exit: 0
// tools/typealias/core_alias.fi -- type aliases in the CORE language (no generics),
// so that `bin/astdump.fi` can read it: the syntax tree after the alias is
// replaced has to be the same in both compilers (tools/typealias/run.sh).
fn widen(x: Idx) -> Wide {
    return x as Wide
}

struct Point { x: i32, y: i32 }

type Idx = u32
type Wide = u64
type Bytes = *mut Octet
type Octet = u8
type Row = [Idx; 4]
type Grid = [Row; 2]
type Cb = fn(Idx) -> Idx
type P = Point
type Chain3 = Chain2
type Chain2 = Chain1
type Chain1 = i16

impl P {
    fn sum(self) -> i32 {
        return self.x + self.y
    }
}

fn twice(x: Idx) -> Idx {
    return x * 2
}

fn apply(f: Cb, x: u32) -> u32 {
    return f(x)
}

fn main() -> i32 {
    let a: Idx = 7
    let b: u32 = a
    var oct: [Octet; 3] = [1, 2, 3]
    let q: Bytes = &oct[0]
    var g: Grid = [[1, 2, 3, 4], [5, 6, 7, 8]]
    let p: P = P { x: 3, y: 4 }
    let k: Chain3 = -5
    if b != 7 || widen(a) != 7 || g[1][2] != 7 || *(q + 2) != 3 {
        return 1
    }
    if apply(twice, 21) != 42 || p.sum() != 7 || k != -5 {
        return 2
    }
    return 0
}
