// SPDX-License-Identifier: MPL-2.0
// tools/appkit/installdex_main.fi -- THE ONE CLASS APPKIT NEEDS ON ANDROID,
// WRITTEN BY FIRN.
//
// A program that updates itself hands the downloaded APK to Android's
// PackageInstaller (lib/@android/appkit/platform.fi). The system answers
// with a broadcast, and a broadcast is delivered to a receiver CLASS that
// the manifest names: it has to be in the APK's classes.dex. No javac, no
// d8, no Kotlin -- this program writes the dex file with lib/android/dex.fi.
// The class is what the Java would be:
//
//     package org.firn;
//     public class FirnInstall extends android.content.BroadcastReceiver {
//         static { System.loadLibrary("<lib>"); }
//         public FirnInstall() { super(); }
//         public native void onReceive(android.content.Context c,
//                                      android.content.Intent i);
//     }
//
// The native method is resolved by name in lib<lib>.so:
// Java_org_firn_FirnInstall_onReceive (lib/@android/appkit/platform.fi). The
// static initialiser loads the library itself: Android may start the process
// for the broadcast without the activity, and then nobody else would.
//
//   firnc -o installdex tools/appkit/installdex_main.fi
//   installdex <out/classes.dex> [lib name, default firnapp]
//
// A program that also uses push.fi / pick.fi (tools/android/servicedex_main.fi,
// one classes.dex holding org.firn.FirnService and org.firn.FirnPick) needs
// all three classes in ONE dex file: not done here -- see docs/APPKIT.md.
import std.rt
import android.dex

const CAP: usize = 16384

fn typ(d: u64, s: str) -> u32 {
    return dex.dex_typ(d, s.p as u64, s.n)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        let u: str = "usage: installdex <classes.dex> [libname]\n"
        rt.write_everything(2, u.p as u64, u.n)
        return 2
    }
    let out: u64 = rt.arg_ptr(start, 1)
    var lib: str = "firnapp"
    if rt.arg_count(start) >= 3 {
        let lp: u64 = rt.arg_ptr(start, 2)
        lib = str { p: lp as *mut u8, n: rt.c_length(lp) }
    }

    let d: u64 = dex.dex_neu()
    if d == 0 {
        return 3
    }
    let t_self: u32 = typ(d, "Lorg/firn/FirnInstall;")
    let t_recv: u32 = typ(d, "Landroid/content/BroadcastReceiver;")
    let t_ctx: u32 = typ(d, "Landroid/content/Context;")
    let t_int: u32 = typ(d, "Landroid/content/Intent;")
    let t_sys: u32 = typ(d, "Ljava/lang/System;")
    let t_str: u32 = typ(d, "Ljava/lang/String;")
    let t_v: u32 = typ(d, "V")

    var ar: [u32; 2] = [0; 2]
    let par: u64 = (&ar[0]) as u64
    let p_v: u32 = dex.dex_proto(d, t_v, par, 0)
    ar[0] = t_ctx
    ar[1] = t_int
    let p_recv: u32 = dex.dex_proto(d, t_v, par, 2)
    ar[0] = t_str
    let p_load: u32 = dex.dex_proto(d, t_v, par, 1)

    let n_init: str = "<init>"
    let n_clinit: str = "<clinit>"
    let n_recv: str = "onReceive"
    let n_load: str = "loadLibrary"
    let m_super: u32 = dex.dex_method(d, t_recv, p_v, n_init.p as u64, n_init.n)
    let m_init: u32 = dex.dex_method(d, t_self, p_v, n_init.p as u64, n_init.n)
    let m_clinit: u32 = dex.dex_method(d, t_self, p_v, n_clinit.p as u64, n_clinit.n)
    let m_recv: u32 = dex.dex_method(d, t_self, p_recv, n_recv.p as u64, n_recv.n)
    let m_load: u32 = dex.dex_method(d, t_sys, p_load, n_load.p as u64, n_load.n)
    let s_lib: u32 = dex.dex_str(d, lib.p as u64, lib.n)

    // <clinit>: const-string v0, "<lib>"; invoke-static {v0}, loadLibrary
    let c_cl: i32 = dex.dex_code(d, 1 as u32, 0 as u32, 1 as u32)
    dex.dex_op21c(d, c_cl, dex.OP_CONST_STRING, 0 as u32, s_lib)
    dex.dex_op35c(d, c_cl, dex.OP_INVOKE_STATIC, 1 as u32, m_load,
        0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_cl, dex.OP_RETURN_VOID)
    // <init>: invoke-direct {v0}, BroadcastReceiver.<init>
    let c_in: i32 = dex.dex_code(d, 1 as u32, 1 as u32, 1 as u32)
    dex.dex_op35c(d, c_in, dex.OP_INVOKE_DIRECT, 1 as u32, m_super,
        0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_in, dex.OP_RETURN_VOID)

    let k: u32 = dex.dex_class(d, t_self, dex.ACC_PUBLIC, t_recv)
    dex.dex_member(d, k, dex.G_DIREKT, m_clinit,
        dex.ACC_STATIC | dex.ACC_CONSTRUCTOR, c_cl)
    dex.dex_member(d, k, dex.G_DIREKT, m_init,
        dex.ACC_PUBLIC | dex.ACC_CONSTRUCTOR, c_in)
    dex.dex_member(d, k, dex.G_VIRTUELL, m_recv,
        dex.ACC_PUBLIC | dex.ACC_NATIVE, 0 - 1)

    if dex.dex_error(d) != 0 as u32 {
        let f: str = "installdex: writer failed\n"
        rt.write_everything(2, f.p as u64, f.n)
        return 4
    }
    let buf: u64 = rt.heap_alloc(CAP)
    let n: usize = dex.dex_build(d, buf, CAP)
    if n == 0 {
        return 5
    }
    if !rt.write_file(out, buf, n) {
        return 6
    }
    return 0
}
