import std.rt
import std.str
import std.io
import services.svc
import services.svcfile
import services.svcclip
import services.svcdialog

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn number(s: str) -> i32 {
    var v: i32 = 0
    var i: usize = 0
    while i < s.length() && s.chars(i) >= 48 as u8 && s.chars(i) <= 57 as u8 {
        v = v * 10 + (s.chars(i) - 48 as u8) as i32
        i = i + 1
    }
    return v
}

fn dec(v: u64) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, v)
    return rt.buf_str(&b)
}

fn print_replies() {
    var r: svc.Reply = svc.reply_new()
    while svc.poll(&r) {
        if r.op == svc.OP_FILE_ITEM {
            io.println_str("ITEM " + dec(r.index as u64) + " " + rt.buf_str(&r.name) + " " + rt.buf_str(&r.data))
        }
        if r.op == svc.OP_FILE_END {
            io.println_str("END " + svc.status_name(r.status) + " " + dec(r.index as u64))
        }
        if r.op == svc.OP_CLIP_TEXT {
            io.println_str("CLIP " + svc.status_name(r.status) + " " + rt.buf_str(&r.data))
        }
    }
    svc.reply_free(&r)
}

fn mode_open(multiple: bool) -> i32 {
    var id: u32 = 0 as u32
    let s: i32 = svcfile.open(".txt,.md", multiple, &id)
    io.println_str("STATUS " + svc.status_name(s))
    print_replies()
    return 0
}

fn mode_save(name: str) -> i32 {
    let body: str = "saved by services"
    let s: i32 = svcfile.save(name, "text/plain", body.p as u64, body.length())
    io.println_str("STATUS " + svc.status_name(s))
    return 0
}

fn answer_name(a: i32) -> str {
    if a == svcdialog.ANS_OK {
        return "ok"
    }
    if a == svcdialog.ANS_CANCEL {
        return "cancel"
    }
    if a == svcdialog.ANS_YES {
        return "yes"
    }
    if a == svcdialog.ANS_NO {
        return "no"
    }
    return "?"
}

fn mode_message(kind: i32, buttons: i32) -> i32 {
    var a: i32 = 0
    let s: i32 = svcdialog.message(kind, "svc-message", "Services message", buttons, &a)
    io.println_str("STATUS " + svc.status_name(s))
    io.println_str("ANSWER " + answer_name(a))
    return 0
}

fn mode_confirm() -> i32 {
    var yes: bool = false
    let s: i32 = svcdialog.confirm("svc-confirm", "Services confirm", &yes)
    io.println_str("STATUS " + svc.status_name(s))
    if yes {
        io.println_str("ANSWER yes")
    } else {
        io.println_str("ANSWER no")
    }
    return 0
}

fn mode_clip(text: str) -> i32 {
    var id: u32 = 0 as u32
    io.println_str("COPY " + svc.status_name(svcclip.copy_text(text)))
    io.println_str("PASTE " + svc.status_name(svcclip.paste_text(&id)))
    print_replies()
    return 0
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        io.println_str("usage: win_live <caps|open|open_multi|save|message|confirm|clip> [args]")
        return 2
    }
    let mode: str = arg(start, 1)
    if mode == "caps" {
        io.println_str("CAPS " + dec(svc.caps() as u64))
        return 0
    }
    if mode == "open" {
        return mode_open(false)
    }
    if mode == "open_multi" {
        return mode_open(true)
    }
    if mode == "save" && rt.arg_count(start) > 2 {
        return mode_save(arg(start, 2))
    }
    if mode == "message" && rt.arg_count(start) > 3 {
        return mode_message(number(arg(start, 2)), number(arg(start, 3)))
    }
    if mode == "confirm" {
        return mode_confirm()
    }
    if mode == "clip" && rt.arg_count(start) > 2 {
        return mode_clip(arg(start, 2))
    }
    io.println_str("bad mode")
    return 2
}
