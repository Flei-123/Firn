// A number in a sentence. The interpolation picks the formatting function by
// the TYPE of the expression -- nothing has to be said about it.
import std.io

fn main() -> i32 {
    let n: i64 = 42
    let x: f64 = 1.5
    let yes: bool = n > 40
    io.fmt_print_line(f"n={n} double={n * 2} x={x} over40={yes}")
    io.print_line("done")
    return 0
}
