// SPDX-License-Identifier: GPL-2.0-only
// Not a demonstration but a LOAD: 40,000 joins of 50 octets each really
// allocate about two megabytes on the collector's heap, so a collection run
// has to happen -- without a single line about it in the source text. The
// last line proves it: `gc_collections()` counts the runs, and it has to be
// larger than zero.
import std.io

fn main() -> i32 {
    let tail = "0123456789012345678901234567890123456789"
    var total: i64 = 0
    var i: i64 = 0
    while i < 40000 {
        let t = "abcdefghij" + tail
        total = total + t.length() as i64
        i = i + 1
    }
    io.fmt_print_line(f"rounds={i} octets={total}")
    if gc_collections() > 0 as u64 { io.print_line("the collector ran") }
    return 0
}
