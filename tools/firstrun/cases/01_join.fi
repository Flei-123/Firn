// The program of round 88: what a stranger writes FIRST. Joining two pieces
// of text, the length, a question about the beginning -- and not one line
// about a collector.
import std.io

fn main() -> i32 {
    let a = "test"
    let b = a + " and more"
    io.fmt_print_line(f"b={b} len={a.length()}")
    if a.starts_with("te") { io.print_line("starts with te") }
    return 0
}
