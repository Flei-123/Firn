// Reading a file by its NAME (round 88: `io.read_file_text`). The path is
// text, the result owns its octets.
import std.io

fn main() -> i32 {
    var t: io.Text = io.read_file_text("tools/firstrun/cases/hello.txt")
    defer t.free()
    if !t.is_ok() {
        io.print_line("the file could not be read")
        return 1
    }
    io.print_line(t.span().trim())
    io.fmt_print_line(f"octets={t.length()}")
    return 0
}
