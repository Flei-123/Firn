// COUNTER-CHECK: the explicit setup keeps working and must not set up a
// second time. Every existing test writes it this way.
import std.io

fn main() -> i32 {
    if !gc_init() { return 90 }
    gc_set_max_bytes(64 * 1024 * 1024)
    let a = "still"
    let b = a + " working"
    io.print_line(b)
    io.fmt_print_line(f"max={gc_max_bytes()}")
    return 0
}
