// SPDX-License-Identifier: GPL-2.0-only
// ROUND 88, the addendum: `string` is the SECOND SPELLING of `str`.
//
// The alias family of round 70/71 is the one of C# -- `int`, `long`, `byte`,
// `double`, `float` -- and there the text type is called `string`. It was
// the only name missing, so the most obvious line of all,
// `let x: string = "test"`, answered "unknown type 'string'".
//
// This case does not merely prove that both spellings COMPILE. It proves
// that they are ONE type: each is handed to the other's function, assigned
// to the other's variable, compared and joined. If `string` were a type of
// its own, not one of these lines would pass the type check.
import std.io
import std.str

fn takes_str(s: str) -> usize { return s.length() }
fn takes_string(s: string) -> usize { return s.length() }

fn main() -> i32 {
    let x: string = "test"
    let y: str = "test"
    // each into the other's function
    io.fmt_print_line(f"{takes_str(x)} {takes_string(y)}")
    // each into the other's variable
    let a: str = x
    let b: string = y
    io.fmt_print_line(f"{a == b} {a == x} {y == b}")
    // joining across the two spellings needs no cast
    let c: string = x + " and " + b
    io.print_line(c)
    // and the library of 8.1 works on both without a conversion function
    let head = "te"
    io.fmt_print_line(f"{x.starts_with(head)} {b.part(0, 2)} {c.length()}")
    return 0
}
