// Comparing and joining. `==` on text compares the OCTETS, not the address.
import std.io

fn main() -> i32 {
    let a = "hello"
    let b = "hel" + "lo"
    if a == b { io.print_line("equal") }
    if a != "world" { io.print_line("different") }
    io.print_line(a + " " + b)
    return 0
}
