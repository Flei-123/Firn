// Taking pieces out. Every one of these methods lives in `impl Span`
// (lib/str/core_impl.fi) -- since round 88 a `str` really reaches all of
// them.
import std.io

fn main() -> i32 {
    let s = "  Firn is a language  "
    let t = s.trim()
    io.print_line(t)
    io.print_line(t.part(0, 4))
    io.print_line(t.ab(8))
    io.print_line(t.to(4))
    let w = "language"
    io.fmt_print_line(f"find={t.find(w)} length={t.length()} contains={t.contains(w)}")
    return 0
}
