// tools/glob_cross/check.fi -- std.glob against Python's fnmatch and glob modules.
//
//     check <cases file>
//
// The cases file comes from tools/glob_cross/gen.py (the format is described
// there): Python decided what `glob.glob(recursive=True, root_dir=..)`,
// `fnmatch.fnmatchcase` and `glob.escape` answer, and the directory trees the
// `G` cases run on already exist. This program asks lib/std/glob.fi and
// compares byte for byte (names are hex encoded on both sides).
//
// Exit 0 = no difference.
import std.rt
import std.str
import std.fs
import std.glob
import std.vec

static mut diffs: i64 = 0
static mut shown: i64 = 0
static mut cases: i64 = 0
static mut cases_glob: i64 = 0
static mut cases_fn: i64 = 0
static mut cases_esc: i64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_buf(b: *mut rt.Buf) {
    rt.write_everything(1, rt.buf_ptr(b), rt.buf_len(b))
}

fn push(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn hexdigit(v: u8) -> u8 {
    if v < 10 as u8 {
        return 48 as u8 + v
    }
    return 87 as u8 + v
}

fn push_hex(b: *mut rt.Buf, p: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        let c: u8 = *(p + i)
        rt.buf_push(b, hexdigit(c >> 4))
        rt.buf_push(b, hexdigit(c & 15 as u8))
        i = i + 1
    }
}

fn unhex(c: u8) -> u8 {
    if c >= 97 as u8 {
        return c - 87 as u8
    }
    return c - 48 as u8
}

// token "x" + hex -> the bytes in `b`
fn push_unhex(b: *mut rt.Buf, t: str) {
    var i: usize = 1
    while i + 1 < t.n {
        rt.buf_push(b, (unhex(*(t.p + i)) << 4) | unhex(*(t.p + i + 1)))
        i = i + 2
    }
}

fn tokenize(line: str, toks: *mut Vec[u64]) {
    vec_clear[u64](toks)
    var i: usize = 0
    while i < line.n {
        while i < line.n && *(line.p + i) == 32 as u8 {
            i = i + 1
        }
        let start: usize = i
        while i < line.n && *(line.p + i) != 32 as u8 {
            i = i + 1
        }
        if i > start {
            vec_push[u64](toks, ((start as u64) << 32) | (i - start) as u64)
        }
    }
}

fn tok(line: str, toks: *mut Vec[u64], k: usize) -> str {
    if k >= vec_len[u64](toks) {
        return ""
    }
    let v: u64 = vec_at[u64](toks, k)
    return str { p: line.p + (v >> 32) as usize, n: (v & 4294967295) as usize }
}

fn same(a: *mut rt.Buf, b: *mut rt.Buf) -> bool {
    return rt.buf_len(a) == rt.buf_len(b) && rt.mem_eq(rt.buf_ptr(a), rt.buf_ptr(b), rt.buf_len(a))
}

fn differ(what: str, line_no: i64, expected: *mut rt.Buf, got: *mut rt.Buf, input: str) {
    diffs = diffs + 1
    if shown < 12 {
        shown = shown + 1
        var n: rt.Buf = rt.buf_new()
        push(&n, "  DIFF  ")
        push(&n, what)
        push(&n, " case ")
        rt.buf_push_dec_i64(&n, line_no)
        push(&n, "\n    input    ")
        push(&n, input)
        push(&n, "\n    expected ")
        say_buf(&n)
        rt.buf_free(&n)
        say_buf(expected)
        say("\n    got      ")
        say_buf(got)
        say("\n")
    }
}

fn glob_case(line: str, line_no: i64, toks: *mut Vec[u64]) {
    var root: rt.Buf = rt.buf_new()
    push_unhex(&root, tok(line, toks, 1))
    var flags: u32 = 0
    let ft: str = tok(line, toks, 2)
    var i: usize = 0
    while i < ft.n {
        flags = flags * 10 + (*(ft.p + i) - 48 as u8) as u32
        i = i + 1
    }
    var pat: rt.Buf = rt.buf_new()
    push_unhex(&pat, tok(line, toks, 3))
    var expected: rt.Buf = rt.buf_new()
    var k: usize = 4
    while k < vec_len[u64](toks) {
        if k > 4 {
            rt.buf_push(&expected, 32 as u8)
        }
        push(&expected, tok(line, toks, k))
        k = k + 1
    }
    var out: rt.Buf = rt.buf_new()
    let n: usize = glob.expand_in(str { p: rt.buf_data(&root), n: rt.buf_len(&root) }, str { p: rt.buf_data(&pat), n: rt.buf_len(&pat) }, flags, &out)
    var got: rt.Buf = rt.buf_new()
    if n == 0 {
        push(&got, "none")
    }
    var at: usize = 0
    var idx: usize = 0
    while idx < n {
        let nm: str = glob.nth(&out, idx)
        if idx > 0 {
            rt.buf_push(&got, 32 as u8)
        }
        rt.buf_push(&got, 120 as u8)
        push_hex(&got, nm.p, nm.n)
        idx = idx + 1
    }
    if glob.count_names(&out) != n {
        differ("count_names", line_no, &expected, &got, tok(line, toks, 3))
    }
    if !same(&got, &expected) {
        var shown_pat: rt.Buf = rt.buf_new()
        push(&shown_pat, str { p: rt.buf_data(&pat), n: rt.buf_len(&pat) })
        push(&shown_pat, "   (flags ")
        rt.buf_push_dec_i64(&shown_pat, flags as i64)
        push(&shown_pat, ", root ")
        push(&shown_pat, str { p: rt.buf_data(&root), n: rt.buf_len(&root) })
        push(&shown_pat, ")")
        differ("glob", line_no, &expected, &got, str { p: rt.buf_data(&shown_pat), n: rt.buf_len(&shown_pat) })
        rt.buf_free(&shown_pat)
    }
    rt.buf_free(&got)
    rt.buf_free(&out)
    rt.buf_free(&expected)
    rt.buf_free(&pat)
    rt.buf_free(&root)
}

fn fn_case(line: str, line_no: i64, toks: *mut Vec[u64]) {
    var pat: rt.Buf = rt.buf_new()
    push_unhex(&pat, tok(line, toks, 1))
    var name: rt.Buf = rt.buf_new()
    push_unhex(&name, tok(line, toks, 2))
    let want: bool = *tok(line, toks, 3).p == 49 as u8
    let got: bool = glob.matches(str { p: rt.buf_data(&pat), n: rt.buf_len(&pat) }, str { p: rt.buf_data(&name), n: rt.buf_len(&name) })
    if got != want {
        var e: rt.Buf = rt.buf_new()
        var g: rt.Buf = rt.buf_new()
        push(&e, "fnmatch=")
        if want {
            push(&e, "true")
        } else {
            push(&e, "false")
        }
        push(&g, "matches=")
        if got {
            push(&g, "true")
        } else {
            push(&g, "false")
        }
        var inp: rt.Buf = rt.buf_new()
        push(&inp, "pattern ")
        push(&inp, tok(line, toks, 1))
        push(&inp, " (")
        push(&inp, str { p: rt.buf_data(&pat), n: rt.buf_len(&pat) })
        push(&inp, ") name ")
        push(&inp, tok(line, toks, 2))
        differ("fnmatch", line_no, &e, &g, str { p: rt.buf_data(&inp), n: rt.buf_len(&inp) })
        rt.buf_free(&inp)
        rt.buf_free(&e)
        rt.buf_free(&g)
    }
    rt.buf_free(&pat)
    rt.buf_free(&name)
}

fn esc_case(line: str, line_no: i64, toks: *mut Vec[u64]) {
    var text: rt.Buf = rt.buf_new()
    push_unhex(&text, tok(line, toks, 1))
    var want: rt.Buf = rt.buf_new()
    push_unhex(&want, tok(line, toks, 2))
    var got: rt.Buf = rt.buf_new()
    glob.escape(str { p: rt.buf_data(&text), n: rt.buf_len(&text) }, &got)
    if !same(&got, &want) {
        differ("escape", line_no, &want, &got, tok(line, toks, 1))
    }
    // an escaped name matches itself, whatever it holds
    if !glob.matches(str { p: rt.buf_data(&got), n: rt.buf_len(&got) }, str { p: rt.buf_data(&text), n: rt.buf_len(&text) }) {
        differ("escape then match", line_no, &want, &got, tok(line, toks, 1))
    }
    rt.buf_free(&got)
    rt.buf_free(&want)
    rt.buf_free(&text)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        say("usage: check <cases file>\n")
        return 2
    }
    let a1: u64 = rt.arg_ptr(start, 1)
    let cases_path: str = str { p: a1 as *mut u8, n: rt.c_length(a1) }
    var data: rt.Buf = rt.buf_new()
    fs.read_file(cases_path, &data) catch 0
    if rt.buf_len(&data) == 0 {
        say("no cases\n")
        return 2
    }
    var toks: Vec[u64] = vec_new[u64]()
    var at: usize = 0
    let total: usize = rt.buf_len(&data)
    let base: *mut u8 = rt.buf_data(&data)
    while at < total {
        var e: usize = at
        while e < total && *(base + e) != 10 as u8 {
            e = e + 1
        }
        let line: str = str { p: base + at, n: e - at }
        at = e + 1
        if line.n == 0 {
            continue
        }
        cases = cases + 1
        tokenize(line, &toks)
        let kind: u8 = *tok(line, &toks, 0).p
        if kind == 71 as u8 {
            cases_glob = cases_glob + 1
            glob_case(line, cases, &toks)
        } else if kind == 70 as u8 {
            cases_fn = cases_fn + 1
            fn_case(line, cases, &toks)
        } else if kind == 69 as u8 {
            cases_esc = cases_esc + 1
            esc_case(line, cases, &toks)
        }
    }
    vec_free[u64](&toks)
    rt.buf_free(&data)
    var o: rt.Buf = rt.buf_new()
    push(&o, "glob cross-check: ")
    rt.buf_push_dec_i64(&o, cases)
    push(&o, " cases (")
    rt.buf_push_dec_i64(&o, cases_glob)
    push(&o, " glob, ")
    rt.buf_push_dec_i64(&o, cases_fn)
    push(&o, " fnmatch, ")
    rt.buf_push_dec_i64(&o, cases_esc)
    push(&o, " escape), ")
    rt.buf_push_dec_i64(&o, diffs)
    push(&o, " differences\n")
    say_buf(&o)
    rt.buf_free(&o)
    if diffs != 0 {
        return 1
    }
    return 0
}
