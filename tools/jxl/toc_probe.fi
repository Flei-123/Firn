import jxl.jxl_bits
import jxl.jxl_container
import jxl.jxl_frame
import jxl.jxl_header
import jxl.jxl_icc
import jxl.jxl_vardct
import std.fs
import std.io
import std.rt

fn print_num(n: usize) {
    let p: u64 = rt.heap_alloc(32)
    var digits: usize = 0
    var m: usize = n
    var buf: [u8; 24] = [0 as u8; 24]
    if m == 0 {
        buf[0] = 48 as u8
        digits = 1
    }
    while m > 0 {
        buf[digits] = (48 + (m % 10)) as u8
        digits = digits + 1
        m = m / 10
    }
    var i: usize = 0
    while i < digits {
        rt.st8(p, i, buf[digits - 1 - i])
        i = i + 1
    }
    rt.st8(p, digits, 10 as u8)
    io.print_bytes(p, digits + 1)
}

fn main() -> i32 {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file("p.jxl", &data) catch 0
    var v: jxl_vardct.JxlVardct = jxl_vardct.vd_new()
    let r: i32 = jxl_vardct.vd_open(rt.buf_ptr(&data), n, &v)
    if r != 0 {
        return 1
    }
    let f: *mut jxl_frame.JxlFrame = &v.doc.frame
    print_num((*f).toc_count)
    print_num((*f).num_lf_groups as usize)
    var k: usize = 0
    while k < (*f).toc_count {
        print_num(jxl_frame.jf_section_offset(f, k))
        print_num(jxl_frame.jf_section_size(f, k))
        k = k + 1
    }
    var end: usize = 0
    if (*f).toc_count == 1 {
        if jxl_vardct.vd_decode_lf_group(&v, 0, &end) != 0 {
            return 2
        }
        print_num(v.lf_end_bit as usize)
    }
    var cs: rt.Buf = rt.buf_new()
    if jxl_container.jc_extract(rt.buf_ptr(&data), n, &cs) != 0 {
        return 3
    }
    var b: jxl_bits.JxlBits = jxl_bits.jb_new(rt.buf_ptr(&cs), rt.buf_len(&cs))
    jxl_bits.jb_skip_bits(&b, 16)
    var meta: jxl_header.JxlMeta = jxl_header.jm_new()
    if jxl_header.jm_read(&b, &meta) != 0 || jxl_header.jm_read_custom_transform(&b, &meta) != 0 {
        return 4
    }
    if meta.color.want_icc && jxl_icc.icc_discard(&b) != 0 {
        return 5
    }
    if !jxl_bits.jb_zero_pad(&b) {
        return 6
    }
    print_num(jxl_bits.jb_byte_pos(&b))
    var fr: jxl_frame.JxlFrame = jxl_frame.jf_new()
    if jxl_frame.jf_read(&b, &meta, &fr) != 0 {
        return 7
    }
    print_num(jxl_bits.jb_bit_pos(&b) as usize)
    return 0
}
