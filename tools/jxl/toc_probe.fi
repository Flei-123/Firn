import jxl.jxl_frame
import jxl.jxl_vardct
import std.fs
import std.io
import std.rt

fn print_num(n: usize) {
    let p: u64 = rt.heap_alloc(32)
    var digits: usize = 0
    var m: usize = n
    var buf: [u8; 24] = [0 as u8; 24]
    if m == 0 {
        buf[0] = 48 as u8
        digits = 1
    }
    while m > 0 {
        buf[digits] = (48 + (m % 10)) as u8
        digits = digits + 1
        m = m / 10
    }
    var i: usize = 0
    while i < digits {
        rt.st8(p, i, buf[digits - 1 - i])
        i = i + 1
    }
    rt.st8(p, digits, 10 as u8)
    io.print_bytes(p, digits + 1)
}

fn main() -> i32 {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file("p.jxl", &data) catch 0
    var v: jxl_vardct.JxlVardct = jxl_vardct.vd_new()
    let r: i32 = jxl_vardct.vd_open(rt.buf_ptr(&data), n, &v)
    if r != 0 {
        return 1
    }
    let f: *mut jxl_frame.JxlFrame = &v.doc.frame
    print_num((*f).toc_count)
    print_num((*f).num_lf_groups as usize)
    var k: usize = 0
    while k < (*f).toc_count {
        print_num(jxl_frame.jf_section_offset(f, k))
        print_num(jxl_frame.jf_section_size(f, k))
        k = k + 1
    }
    var end: usize = 0
    if (*f).toc_count == 1 {
        if jxl_vardct.vd_decode_lf_group(&v, 0, &end) != 0 {
            return 2
        }
        print_num(v.lf_end_bit as usize)
    }
    return 0
}
