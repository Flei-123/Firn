import std.rt
import jxl.jxl

fn main(start: u64) -> i32 {
    var data: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &data) {
        return 2
    }
    var reps: usize = 1
    if rt.arg_count(start) > 2 {
        reps = rt.c_length(rt.arg_ptr(start, 2))
    }
    var i: usize = 0
    while i < reps {
        var pic: jxl.JxlPicture = jxl.jxl_picture_new()
        let ok: bool = jxl.jxl_decode(rt.buf_ptr(&data), rt.buf_len(&data), &pic) catch false
        if !ok {
            return 3
        }
        if i == 0 && rt.arg_count(start) > 3 {
            if !rt.write_file(rt.arg_ptr(start, 3), pic.data, pic.size) {
                return 4
            }
        }
        jxl.jxl_picture_free(&pic)
        i = i + 1
    }
    return 0
}
