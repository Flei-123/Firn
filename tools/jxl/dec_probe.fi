import jxl.jxl
import std.fs
import std.rt

fn main() -> i32 {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file("in.jxl", &data) catch 0
    if n == 0 {
        return 2
    }
    var pic: jxl.JxlPicture = jxl.jxl_picture_new()
    let ok: bool = jxl.jxl_decode(rt.buf_ptr(&data), n, &pic) catch false
    if !ok {
        return 3
    }
    let w: usize = fs.write_file("out.raw", pic.data, pic.size) catch 0
    if w != pic.size {
        return 4
    }
    return 0
}
