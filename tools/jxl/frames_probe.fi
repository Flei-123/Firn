import jxl.jxl_bits
import jxl.jxl_container
import jxl.jxl_frame
import jxl.jxl_header
import jxl.jxl_icc
import std.fs
import std.io
import std.rt

fn print_num(n: usize) {
    let p: u64 = rt.heap_alloc(32)
    var digits: usize = 0
    var m: usize = n
    var buf: [u8; 24] = [0 as u8; 24]
    if m == 0 {
        buf[0] = 48 as u8
        digits = 1
    }
    while m > 0 {
        buf[digits] = (48 + (m % 10)) as u8
        digits = digits + 1
        m = m / 10
    }
    var i: usize = 0
    while i < digits {
        rt.st8(p, i, buf[digits - 1 - i])
        i = i + 1
    }
    rt.st8(p, digits, 10 as u8)
    io.print_bytes(p, digits + 1)
}

fn main() -> i32 {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file("p.jxl", &data) catch 0
    var cs: rt.Buf = rt.buf_new()
    if jxl_container.jc_extract(rt.buf_ptr(&data), n, &cs) != 0 {
        return 3
    }
    var b: jxl_bits.JxlBits = jxl_bits.jb_new(rt.buf_ptr(&cs), rt.buf_len(&cs))
    jxl_bits.jb_skip_bits(&b, 16)
    var meta: jxl_header.JxlMeta = jxl_header.jm_new()
    if jxl_header.jm_read(&b, &meta) != 0 || jxl_header.jm_read_custom_transform(&b, &meta) != 0 {
        return 4
    }
    if meta.color.want_icc && jxl_icc.icc_discard(&b) != 0 {
        return 5
    }
    if !jxl_bits.jb_zero_pad(&b) {
        return 6
    }
    var start: usize = jxl_bits.jb_byte_pos(&b)
    var done: bool = false
    while !done {
        var fb: jxl_bits.JxlBits = jxl_bits.jb_new(rt.buf_ptr(&cs) + (start as u64), rt.buf_len(&cs) - start)
        var f: jxl_frame.JxlFrame = jxl_frame.jf_new()
        if jxl_frame.jf_read(&fb, &meta, &f) != 0 {
            return 7
        }
        let header_bits: usize = jxl_bits.jb_bit_pos(&fb) as usize
        if jxl_frame.jf_read_toc(&fb, &f) != 0 {
            return 8
        }
        var total: usize = 0
        var k: usize = 0
        while k < f.toc_count {
            total = total + jxl_frame.jf_section_size(&f, k)
            k = k + 1
        }
        print_num(start)
        print_num(header_bits)
        print_num(f.body_start)
        print_num(total)
        print_num(f.frame_type as usize)
        print_num(f.encoding as usize)
        print_num(f.flags as usize)
        print_num(f.dc_level as usize)
        print_num(f.width as usize)
        print_num(f.height as usize)
        print_num(f.toc_count)
        print_num(0)
        done = f.is_last
        start = start + f.body_start + total
        jxl_frame.jf_free(&f)
        if start >= rt.buf_len(&cs) {
            done = true
        }
    }
    return 0
}
