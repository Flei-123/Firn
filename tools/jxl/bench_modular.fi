import std.rt
import jxl.jxl_img
import jxl.jxl_modular

fn main(start: u64) -> i32 {
    var data: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &data) {
        return 2
    }
    var reps: usize = 1
    if rt.arg_count(start) > 2 {
        reps = rt.c_length(rt.arg_ptr(start, 2))
    }
    var sum: u64 = 0
    var i: usize = 0
    while i < reps {
        var im: jxl_img.JxlImage = jxl_img.img_new()
        let r: i32 = jxl_modular.modular_decode(rt.buf_ptr(&data), rt.buf_len(&data), &im)
        if r != 0 {
            return 3
        }
        sum = sum + (jxl_img.img_get(&im, 0, 1, 1) as u64)
        jxl_img.img_free(&im)
        i = i + 1
    }
    return 0
}
