import rt.rt
import av1.avif
import std.io

fn dec(v: i64) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, v as u64)
    let s: str = __str_copy(rt.buf_str(&b))
    rt.buf_free(&b)
    return s
}

fn main() -> i32 {
    var inb: rt.Buf = rt.buf_new()
    rt.read_stdin(&inb)
    let src: u64 = rt.buf_ptr(&inb)
    let n: usize = rt.buf_len(&inb)
    let info: u64 = avif.avif_obu_open(src, n)
    if info == 0 {
        return 1
    }
    io.print_line("seq reduced=" + dec(avif.avif_cell(info, avif.AI_REDUCED)) + " ohbits=" + dec(avif.avif_cell(info, avif.AI_OH_BITS)) + " still=" + dec(avif.avif_cell(info, avif.AI_STILL)))
    var at: usize = 0
    while at < n {
        let nx: i64 = avif.avif_obu_next(src, n, info, at)
        if nx < 0 {
            break
        }
        let fb: usize = avif.FH_BASE
        if avif.avif_cell(info, fb + avif.FH_NEW_FRAME) != 0 {
            io.print_line("frame type=" + dec(avif.avif_cell(info, fb + avif.FH_TYPE)) + " ok=" + dec(avif.avif_cell(info, fb + avif.FH_OK)) + " obu_off=" + dec(avif.avif_cell(info, fb + avif.FH_OBU_OFF)) + " obu_len=" + dec(avif.avif_cell(info, fb + avif.FH_OBU_LEN)) + " refresh_pos=" + dec(avif.avif_cell(info, fb + avif.FH_REFRESH_POS)) + " tile_pos=" + dec(avif.avif_cell(info, fb + avif.FH_TILE_POS)) + " hdr_bits=" + dec(avif.avif_cell(info, fb + avif.FH_HDR_BITS)) + " ftype=" + dec(avif.avif_cell(info, fb + avif.FH_FRAME_TYPE)) + " show=" + dec(avif.avif_cell(info, fb + avif.FH_SHOW)))
        }
        at = nx as usize
    }
    return 0
}
