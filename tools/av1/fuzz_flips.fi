// expect_exit: 42
import av1.still
import std.fs
import std.rt
import std.deflate

static mut seed: u64 = 987654321

fn rnd() -> u32 {
    seed = (seed * 1103515245 + 12345) & 2147483647
    return ((seed >> 8) & 16777215) as u32
}

fn load(name: str, data: *mut rt.Buf) -> usize {
    let n: usize = fs.read_file(name, data) catch 0
    return n
}

fn crc_of(name: str, want_crc: u32, want_size: usize) -> bool {
    var data: rt.Buf = rt.buf_new()
    let n: usize = load(name, &data)
    if n == 0 {
        return false
    }
    var f: still.Frame = still.frame_new()
    let rc: i32 = still.still_decode(rt.buf_ptr(&data), n, &f)
    if rc != still.STILL_OK {
        return false
    }
    var all: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&all, f.y, f.y_bytes)
    rt.buf_push_bytes(&all, f.u, f.u_bytes)
    rt.buf_push_bytes(&all, f.v, f.v_bytes)
    let c: u32 = deflate.crc32(rt.buf_ptr(&all), rt.buf_len(&all))
    let sz: usize = rt.buf_len(&all)
    rt.buf_free(&all)
    still.frame_free(&f)
    rt.buf_free(&data)
    return c == want_crc && sz == want_size
}

fn refuses(name: str, want_rc: i32) -> bool {
    var data: rt.Buf = rt.buf_new()
    let n: usize = load(name, &data)
    if n == 0 {
        return false
    }
    var f: still.Frame = still.frame_new()
    let rc: i32 = still.still_decode(rt.buf_ptr(&data), n, &f)
    rt.buf_free(&data)
    if rc == still.STILL_OK {
        still.frame_free(&f)
        return false
    }
    return rc == want_rc
}

fn survives_cuts(name: str, step: usize) -> bool {
    var data: rt.Buf = rt.buf_new()
    let n: usize = load(name, &data)
    if n == 0 {
        return false
    }
    var c: usize = 0
    while c < n {
        var f: still.Frame = still.frame_new()
        let rc: i32 = still.still_decode_limited(rt.buf_ptr(&data), c, 1000000, &f)
        if rc == still.STILL_OK {
            still.frame_free(&f)
        }
        c = c + step
    }
    rt.buf_free(&data)
    return true
}

fn save_current(work: *mut rt.Buf) {
    let w: usize = fs.write_file("av1_fuzz_current.bin", rt.buf_ptr(work), rt.buf_len(work)) catch 0
    if w == 0 {
        return
    }
}

fn survives_flips(name: str, copies: u32) -> bool {
    var data: rt.Buf = rt.buf_new()
    let n: usize = load(name, &data)
    if n == 0 {
        return false
    }
    var work: rt.Buf = rt.buf_new()
    var k: u32 = 0
    while k < copies {
        rt.buf_clear(&work)
        rt.buf_push_bytes(&work, rt.buf_ptr(&data), n)
        let hits: u32 = 1 + rnd() % 3
        var j: u32 = 0
        while j < hits {
            let at: usize = (rnd() as usize) % n
            rt.st8(rt.buf_ptr(&work), at, (rnd() % 256) as u8)
            j = j + 1
        }
        save_current(&work)
        var f: still.Frame = still.frame_new()
        let rc: i32 = still.still_decode_limited(rt.buf_ptr(&work), n, 1000000, &f)
        if rc == still.STILL_OK {
            still.frame_free(&f)
        }
        k = k + 1
    }
    rt.buf_free(&work)
    rt.buf_free(&data)
    return true
}

fn main() -> i32 {
    if !survives_flips("tests/data/av1/lf_n160_q140_444.avif", 400 as u32) { return 1 }
    if !survives_flips("tests/data/av1/lr_a.avif", 400 as u32) { return 2 }
    if !survives_flips("tests/data/av1/lr_e.avif", 400 as u32) { return 3 }
    if !survives_flips("tests/data/av1/cdef_a.avif", 400 as u32) { return 4 }
    if !survives_flips("tests/data/av1/cdef_p9_big.avif", 400 as u32) { return 5 }
    if !survives_flips("tests/data/av1/n64_444_nofilter.avif", 400 as u32) { return 6 }
    if !survives_flips("tests/data/av1/s300_444q100.avif", 400 as u32) { return 7 }
    if !survives_flips("tests/data/av1/lf_s256_q160_444.avif", 400 as u32) { return 8 }
    if !survives_flips("tests/data/av1/t256_444lr.avif", 400 as u32) { return 9 }
    if !survives_flips("tests/data/av1/lf_cdef_on_444.avif", 400 as u32) { return 10 }
    if !survives_flips("tests/data/av1/t300_tiles.avif", 400 as u32) { return 11 }
    if !survives_flips("tests/data/av1/s64_420.avif", 400 as u32) { return 12 }
    if !survives_flips("tests/data/av1/c64_420.avif", 400 as u32) { return 13 }
    if !survives_flips("tests/data/av1/c37_420_lossless.avif", 400 as u32) { return 14 }
    if !survives_flips("tests/data/av1/c200_420_lr.avif", 400 as u32) { return 15 }
    if !survives_flips("tests/data/av1/c64_400.avif", 400 as u32) { return 16 }
    if !survives_flips("tests/data/av1/c129_420_qm_dq.avif", 400 as u32) { return 17 }
    if !survives_flips("tests/data/av1/s200_420.avif", 400 as u32) { return 18 }
    if !survives_flips("tests/data/av1/s37_420.avif", 400 as u32) { return 19 }
    return 42
}
