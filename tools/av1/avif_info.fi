import rt.rt
import av1.avif
import std.io

fn dec(v: i64) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, v as u64)
    let s: str = __str_copy(rt.buf_str(&b))
    rt.buf_free(&b)
    return s
}

fn field(info: u64, name: str, idx: usize) {
    io.print_line(name + "=" + dec(avif.avif_cell(info, idx)))
}

fn main() -> i32 {
    var inb: rt.Buf = rt.buf_new()
    rt.read_stdin(&inb)
    let info: u64 = avif.avif_parse(rt.buf_ptr(&inb), rt.buf_len(&inb))
    if info == 0 {
        return 1
    }
    let fb: usize = avif.FH_BASE
    field(info, "w", avif.AI_WIDTH)
    field(info, "h", avif.AI_HEIGHT)
    field(info, "bitdepth", avif.AI_BITDEPTH)
    field(info, "subx", avif.AI_SUBX)
    field(info, "suby", avif.AI_SUBY)
    field(info, "sb128", avif.AI_SB128)
    field(info, "tcols", fb + avif.FH_TCOLS)
    field(info, "trows", fb + avif.FH_TROWS)
    field(info, "base_q", fb + avif.FH_BASE_Q)
    field(info, "dq_ydc", fb + avif.FH_DQ_YDC)
    field(info, "dq_udc", fb + avif.FH_DQ_UDC)
    field(info, "dq_uac", fb + avif.FH_DQ_UAC)
    field(info, "dq_vdc", fb + avif.FH_DQ_VDC)
    field(info, "dq_vac", fb + avif.FH_DQ_VAC)
    field(info, "qm", fb + avif.FH_QM)
    field(info, "qm_y", fb + avif.FH_QM_Y)
    field(info, "qm_u", fb + avif.FH_QM_U)
    field(info, "qm_v", fb + avif.FH_QM_V)
    field(info, "dq_pres", fb + avif.FH_DQ_PRES)
    field(info, "dq_res", fb + avif.FH_DQ_RES)
    field(info, "dlf_pres", fb + avif.FH_DLF_PRES)
    field(info, "seg", fb + avif.FH_SEG_EN)
    field(info, "sct", fb + avif.FH_SCT)
    field(info, "intrabc", fb + avif.FH_INTRABC)
    field(info, "lr0", fb + avif.FH_LR_TYPE)
    field(info, "cdef", avif.AI_CDEF)
    field(info, "tx_mode", fb + avif.FH_TX_MODE)
    field(info, "lossless", fb + avif.FH_LOSSLESS)
    field(info, "lf0", fb + avif.FH_LF0)
    avif.avif_info_free(info)
    return 0
}
