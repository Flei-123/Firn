import rt.rt
import av1.still

fn main() -> i32 {
    var inb: rt.Buf = rt.buf_new()
    rt.read_stdin(&inb)
    var f: still.Frame = still.frame_new()
    let rc: i32 = still.still_decode(rt.buf_ptr(&inb), rt.buf_len(&inb), &f)
    if rc != still.STILL_OK {
        return rc
    }
    rt.write_everything(1, f.y, f.y_bytes)
    rt.write_everything(1, f.u, f.u_bytes)
    rt.write_everything(1, f.v, f.v_bytes)
    still.frame_free(&f)
    return 0
}
