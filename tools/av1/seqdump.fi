import rt.rt
import av1.still
import av1.seqdec

fn main() -> i32 {
    var inb: rt.Buf = rt.buf_new()
    rt.read_stdin(&inb)
    let h: u64 = seqdec.seq_open(rt.buf_ptr(&inb), rt.buf_len(&inb))
    if h == 0 {
        return 1
    }
    var shown: i32 = 0
    while true {
        var f: still.Frame = still.frame_new()
        let rc: i32 = seqdec.seq_next(h, &f)
        if rc == seqdec.SEQ_END {
            break
        }
        if rc == seqdec.SEQ_FRAME {
            rt.write_everything(1, f.y, f.y_bytes)
            rt.write_everything(1, f.u, f.u_bytes)
            rt.write_everything(1, f.v, f.v_bytes)
            still.frame_free(&f)
            shown = shown + 1
        } else if rc != seqdec.SEQ_HIDDEN {
            seqdec.seq_free(h)
            return 10 + rc
        }
    }
    seqdec.seq_free(h)
    if shown == 0 {
        return 2
    }
    return 0
}
