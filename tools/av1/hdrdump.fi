import rt.rt
import av1.avif
import av1.av1fhx
import std.io

fn dec(v: i64) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, v as u64)
    let s: str = __str_copy(rt.buf_str(&b))
    rt.buf_free(&b)
    return s
}

fn cell(info: u64, i: usize) -> i64 {
    return avif.avif_cell(info, avif.FH_BASE + i)
}

fn main() -> i32 {
    var inb: rt.Buf = rt.buf_new()
    rt.read_stdin(&inb)
    let src: u64 = rt.buf_ptr(&inb)
    let n: usize = rt.buf_len(&inb)
    let info: u64 = avif.avif_obu_open(src, n)
    if info == 0 {
        return 1
    }
    var at: usize = 0
    while at < n {
        let nx: i64 = avif.avif_obu_next(src, n, info, at)
        if nx < 0 {
            return 3
        }
        at = nx as usize
        if cell(info, avif.FH_NEW_FRAME) == 0 {
            continue
        }
        var line: str = "ok=" + dec(cell(info, avif.FH_OK)) + " type=" + dec(cell(info, avif.FH_FRAME_TYPE)) + " show=" + dec(cell(info, avif.FH_SHOW)) + " se=" + dec(cell(info, avif.FH_SHOW_EXISTING))
        line = line + " prim=" + dec(cell(info, av1fhx.FH_PRIMARY_REF)) + " refresh=" + dec(cell(info, avif.FH_REFRESH)) + " hint=" + dec(cell(info, avif.FH_ORDER_HINT)) + " refs="
        var i: usize = 0
        while i < 7 {
            line = line + dec(cell(info, av1fhx.FH_REF_IDX + i))
            i = i + 1
        }
        line = line + " hp=" + dec(cell(info, av1fhx.FH_ALLOW_HP)) + " interp=" + dec(cell(info, av1fhx.FH_INTERP)) + " msw=" + dec(cell(info, av1fhx.FH_MOTION_SWITCH)) + " urm=" + dec(cell(info, av1fhx.FH_USE_REF_MVS))
        line = line + " rsel=" + dec(cell(info, av1fhx.FH_REF_SELECT)) + " skip=" + dec(cell(info, av1fhx.FH_SKIP_PRESENT)) + " warp=" + dec(cell(info, av1fhx.FH_WARPED)) + " hdrbits=" + dec(cell(info, avif.FH_HDR_BITS))
        io.print_line(line)
        avif.avif_ref_update(info, cell(info, avif.FH_REFRESH))
    }
    avif.avif_info_free(info)
    return 0
}
