import rt.rt
import av1.av1mem
import av1.av1cdef

fn rd32(p: u64, i: i64) -> i64 {
    return (*((p + ((i * 4) as u64)) as *mut i32)) as i64
}

fn main() -> i32 {
    var inb: rt.Buf = rt.buf_new()
    rt.read_stdin(&inb)
    let p: u64 = rt.buf_ptr(&inb) as u64
    let mc: i64 = rd32(p, 0)
    let mr: i64 = rd32(p, 1)
    let sx: i64 = rd32(p, 2)
    let sy: i64 = rd32(p, 3)
    let np: i64 = rd32(p, 4)
    let damp: i64 = rd32(p, 5)
    let acols: i64 = (mc + 15) & (0 - 16)
    let arows: i64 = (mr + 15) & (0 - 16)
    let stride: i64 = acols * 4
    let psz: i64 = stride * arows * 4
    let par: u64 = p + 32
    let p0: u64 = par + 32
    let p1: u64 = p0 + (psz as u64)
    let p2: u64 = p1 + (psz as u64)
    let skp: u64 = p2 + (psz as u64)
    let cidx: u64 = skp + ((mc * mr) as u64)
    let sc: u64 = av1mem.heap_alloc(av1cdef.CDEF_SCRATCH_BYTES as usize) as u64
    av1cdef.cdef_frame(p0, p1, p2, stride, skp, cidx, acols >> 4, mc, mr, sx, sy, np, damp, par, sc)
    rt.write_everything(1, p0, (psz * 3) as usize)
    return 0
}
