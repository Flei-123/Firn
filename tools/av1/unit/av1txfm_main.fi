import rt.rt
import av1.av1mem
import av1.av1txfm

fn main() -> i32 {
    var inb: rt.Buf = rt.buf_new()
    rt.read_stdin(&inb)
    let p: u64 = rt.buf_ptr(&inb) as u64
    let txs: i64 = (*(p as *mut i32)) as i64
    let ttp: i64 = (*((p + 4) as *mut i32)) as i64
    let w: i64 = 1 << av1txfm.tx_log2w(txs)
    let h: i64 = 1 << av1txfm.tx_log2h(txs)
    let res: u64 = av1mem.heap_alloc((w * h * 4) as usize) as u64
    let work: u64 = av1mem.heap_alloc(av1txfm.txfm_work_size() as usize) as u64
    var cs: i64 = w
    if cs > 32 {
        cs = 32
    }
    av1txfm.inv_txfm_2d(p + 8, cs, res, work, txs, ttp, 8)
    rt.write_everything(1, res, (w * h * 4) as usize)
    return 0
}
