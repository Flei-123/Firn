import rt.rt
import av1.av1mem
import av1.av1lr

fn rd32(p: u64, i: i64) -> i64 {
    return (*((p + ((i * 4) as u64)) as *mut i32)) as i64
}

fn main() -> i32 {
    var inb: rt.Buf = rt.buf_new()
    rt.read_stdin(&inb)
    let p: u64 = rt.buf_ptr(&inb) as u64
    let np: i64 = rd32(p, 0)
    let c: u64 = av1lr.lr_new(np, rd32(p, 1), rd32(p, 2), rd32(p, 3), rd32(p, 4), rd32(p, 5), rd32(p, 6), rd32(p, 7), rd32(p, 8), rd32(p, 9))
    let stride: i64 = rd32(p, 10)
    let rows: i64 = rd32(p, 11)
    var q: u64 = p + 48
    var pl: i64 = 0
    while pl < np {
        let n: i64 = av1lr.lr_unit_count(c, pl) * 16
        if n > 0 {
            av1mem.mem_copy(av1lr.lr_unit_ptr(c, pl) as *mut u8, q as *mut u8, n as usize)
            q = q + (n as u64)
        }
        pl = pl + 1
    }
    let psz: i64 = stride * rows
    let p0: u64 = q
    let p1: u64 = p0 + (psz as u64)
    let p2: u64 = p1 + (psz as u64)
    let c0: u64 = p2 + (psz as u64)
    let c1: u64 = c0 + (psz as u64)
    let c2: u64 = c1 + (psz as u64)
    av1lr.lr_frame(c, p0, p1, p2, c0, c1, c2, stride)
    rt.write_everything(1, p0, (psz * 3) as usize)
    return 0
}
