import rt.rt
import av1.av1mem
import av1.av1sym
import av1.avif_cdf

fn rdle(p: u64, i: usize, w: usize) -> i64 {
    var v: i64 = 0
    var k: usize = 0
    while k < w {
        v = v | (((*((p + (i + k) as u64) as *mut u8)) as i64) << (8 * k))
        k = k + 1
    }
    return v
}

fn main() -> i32 {
    var inb: rt.Buf = rt.buf_new()
    rt.read_stdin(&inb)
    let n: usize = rt.buf_len(&inb)
    let p: u64 = rt.buf_ptr(&inb) as u64
    if n < 8 {
        return 1
    }
    let nops: i64 = rdle(p, 0, 4)
    let dlen: i64 = rdle(p, 4, 4)
    let ops: usize = 8 + dlen as usize
    if ops + (nops as usize) * 4 > n {
        return 1
    }
    let work: *mut u8 = av1mem.heap_alloc(avif_cdf.CDF_MODE_LEN * 2)
    av1sym.cdf_copy(work as u64, avif_cdf.cdf_mode_addr(), avif_cdf.CDF_MODE_LEN as i64)
    var s: av1sym.Sym = av1sym.Sym { p: 0, n: 0, pos: 0, val: 0, rng: 0, maxbits: 0, upd: 1 }
    av1sym.sym_init(&s, p + 8, dlen, 1)
    var out: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < (nops as usize) {
        let kind: i64 = rdle(p, ops + i * 4, 1)
        let k: i64 = rdle(p, ops + i * 4 + 1, 1)
        let off: i64 = rdle(p, ops + i * 4 + 2, 2)
        var r: i64 = 0
        if kind == 0 {
            r = av1sym.sym_read(&s, (work as u64) + (off * 2) as u64, k)
        } else {
            if kind == 1 {
                r = av1sym.sym_bool(&s)
            } else {
                if kind == 4 {
                    r = s.val & 255
                } else if kind == 5 {
                    r = (s.val >> 8) & 255
                } else if kind == 6 {
                    r = s.rng & 255
                } else if kind == 7 {
                    r = (s.rng >> 8) & 255
                } else if kind == 3 {
                    r = av1sym.cdf_ld(work as u64, off + k) & 255
                } else {
                    r = av1sym.sym_literal(&s, k)
                }
            }
        }
        if r > 255 {
            r = 255
        }
        rt.buf_push(&out, r as u8)
        i = i + 1
    }
    rt.write_everything(1, rt.buf_ptr(&out) as u64, rt.buf_len(&out))
    return 0
}
