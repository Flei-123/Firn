import rt.rt
import av1.av1mem
import av1.av1txfm
import av1.av1recon
import av1.av1lt

fn main() -> i32 {
    var inb: rt.Buf = rt.buf_new()
    rt.read_stdin(&inb)
    let p: u64 = rt.buf_ptr(&inb) as u64
    let txs: i64 = (*(p as *mut i32)) as i64
    let ttp: i64 = (*((p + 4) as *mut i32)) as i64
    let dcq: i64 = (*((p + 8) as *mut i32)) as i64
    let acq: i64 = (*((p + 12) as *mut i32)) as i64
    let w: i64 = 1 << av1txfm.tx_log2w(txs)
    let h: i64 = 1 << av1txfm.tx_log2h(txs)
    var tw: i64 = w
    if tw > 32 {
        tw = 32
    }
    var th: i64 = h
    if th > 32 {
        th = 32
    }
    let plane: u64 = p + 16 + ((tw * th * 4) as u64)
    let work: u64 = av1mem.heap_alloc(av1recon.recon_work_size() as usize) as u64
    av1recon.recon_block(work, p + 16, plane, w, 0, 0, w, h, txs, ttp, dcq, acq, 8, 0)
    if av1lt.dc_q(0, 0) != 4 || av1lt.ac_q(0, 255) != 1828 {
        return 2
    }
    rt.write_everything(1, plane, (w * h) as usize)
    return 0
}
