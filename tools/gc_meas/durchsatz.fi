// tools/gc_meas/durchsatz.fi — DURCHSATZ bei fester Arbeit (Runde 44).
//
// Die Pausenlaeufe messen Zeit bei fester Laufzeit; fuer den Durchsatz ist
// das die falsche Richtung. Hier ist die ARBEIT fest (RUNDEN Muellzyklen bei
// KINDER lebenden Knoten) und die ZEIT das Ergebnis. Damit laesst sich die
// Vorgabe aus Runde 38 (hoechstens 10 % Durchsatzverlust) direkt pruefen.
//
// KINDER stellt das Regime ein:
//   klein (z. B. 2000)  -> Heap bleibt unter INKR_AB, genau das Regime, das
//                          die Schwelle schuetzen soll.
//   gross (z. B. 120000) -> Heap ueber INKR_AB, inkrementeller Zyklus.
//
// Ausgabe (eine Zeile je Kennzahl, maschinenlesbar):
//   D <code> <wert>
// Codes: 0 aufbau_ms, 1 arbeit_ms, 2 runden, 3 sammellaeufe, 4 volle_laeufe,
// 5 heap_bytes, 6 gesamt_bytes, 7 rss_kib, 8 pause_max_ns, 9 pause_total_ns,
// 10 lebende_objekte, 11 barrieren, 12 ns_je_runde.

import dom
import meas

const CHILDREN: u32 = 2000      // GCM_KINDER
const ROUNDS: u64 = 200000    // GCM_RUNDEN

fn d(code: u64, value: u64) {
    meas.meas_char(68)
    meas.meas_tab()
    meas.meas_u64(code)
    meas.meas_tab()
    meas.meas_u64(value)
    meas.meas_nl()
}

fn main() -> i32 {
    if !gc_init() {
        return 2
    }
    return run() catch 9
}

fn run() -> AllocError!i32 {
    let t0: u64 = meas.meas_now_ms()
    let root = try dom.dom_elem_new(1)
    var k: u32 = 0
    while k < CHILDREN {
        let kind = try dom.dom_node_new(1000 + k, dom.DOM_KIND_TEXT)
        // Runde 53: die Kinderliste ist eine GcVec, das Anhaengen kann
        // also allozieren und ist damit fehlbar.
        let ok: bool = try dom.dom_append_child(root, kind)
        k = k + 1
    }
    let t1: u64 = meas.meas_now_ms()

    var r: u64 = 0
    while r < ROUNDS {
        let n: u64 = dom.dom_cycle_build() catch 0
        if n != dom.DOM_OBJECTS_PER_SET {
            return 5
        }
        r = r + 1
    }
    let t2: u64 = meas.meas_now_ms()
    if dom.dom_children_count(root) != CHILDREN {
        return 6
    }

    let work: u64 = t2 - t1
    d(0, t1 - t0)
    d(1, work)
    d(2, ROUNDS)
    d(3, gc_collections())
    d(4, gc_full_runs())
    d(5, gc_heap_bytes())
    d(6, gc_total_bytes())
    d(7, meas.meas_rss_kib())
    d(8, gc_pause_ns_max())
    d(9, gc_pause_ns_total())
    d(10, gc_live_objects())
    d(11, gc_barriers())
    d(12, work * 1000000 / ROUNDS)
    // Diagnose (Runde 44): 13 neue Chunks in Ruhe, 14 im Markieren,
    // 15 im Fegen, 16 Mark-Scheiben, 17 Sweep-Scheiben, 18 graue
    // Allokationen, 19 Allokationen gesamt.
    var i: u64 = 0
    while i < 7 {
        d(13 + i, gc_diag(i))
        i = i + 1
    }
    d(20, gc_stop_max())
    return 0
}
