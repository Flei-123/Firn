// SPDX-License-Identifier: GPL-2.0-only
// tools/gc_meas/pause.fi -- pause histogram of the GC (round 38, stage 1).
//
// Workload like the DOM soak run (lib/dom/soak_gc.fi): continuously build real
// cycles and let them fall. After EVERY cycle the
// collection counter is checked; at a new run its pause
// (gc_pause_ns_last) is sorted into one of nine classes. That gives a
// real histogram of ALL pauses, not only of the maximum.
//
// Output: TSV samples like the soak, after that the histogram and the
// sums. run.sh changes the constants BUDGET_MS/SAMPLE over with sed.

import dom
import meas

const BUDGET_MS: i64 = 20000 // GCM_BUDGET_MS
const SAMPLE: i64 = 1000 // GCM_SAMPLE

fn t_header() {
    var t: [u8; 19] = [
        35, 32, 102, 105, 114, 110, 45, 103, 99, 45, 112, 97, 117, 115, 101, 32, 118, 49, 10,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 19)
}

fn t_cols() {
    var t: [u8; 76] = [
        35, 32, 115, 112, 97, 108, 116, 101, 110, 58, 32, 116, 95, 109, 115, 9, 122, 121, 107, 108, 101, 110, 9, 114, 115, 115, 95, 107, 105, 98, 9, 108, 101, 98, 101, 110, 100, 101, 9, 115, 97, 109, 109, 101, 108, 108, 97, 101, 117, 102, 101, 9, 104, 101, 97, 112, 95, 98, 121, 116, 101, 115, 9, 112, 97, 117, 115, 101, 95, 109, 97, 120, 95, 110, 115, 10,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 76)
}

fn t_hist() {
    var t: [u8; 37] = [
        35, 32, 104, 105, 115, 116, 111, 103, 114, 97, 109, 109, 58, 32, 112, 97, 117, 115, 101, 95, 110, 115, 95, 103, 114, 101, 110, 122, 101, 9, 97, 110, 122, 97, 104, 108, 10,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 37)
}

fn t_pause_max() {
    var t: [u8; 15] = [
        35, 32, 112, 97, 117, 115, 101, 95, 109, 97, 120, 95, 110, 115, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 15)
}

fn t_pause_total() {
    var t: [u8; 17] = [
        35, 32, 112, 97, 117, 115, 101, 95, 116, 111, 116, 97, 108, 95, 110, 115, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 17)
}

fn t_runs() {
    var t: [u8; 15] = [
        35, 32, 115, 97, 109, 109, 101, 108, 108, 97, 101, 117, 102, 101, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 15)
}

fn t_cycles() {
    var t: [u8; 9] = [
        35, 32, 122, 121, 107, 108, 101, 110, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 9)
}

fn t_multi() {
    var t: [u8; 22] = [
        35, 32, 117, 101, 98, 101, 114, 115, 101, 104, 101, 110, 95, 109, 101, 104, 114, 102, 97, 99, 104, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 22)
}

fn t_rss() {
    var t: [u8; 10] = [
        35, 32, 114, 115, 115, 95, 107, 105, 98, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 10)
}

fn t_heap() {
    var t: [u8; 13] = [
        35, 32, 104, 101, 97, 112, 95, 98, 121, 116, 101, 115, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 13)
}

fn t_done() {
    var t: [u8; 9] = [
        35, 32, 102, 101, 114, 116, 105, 103, 10,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 9)
}

fn t_error() {
    var t: [u8; 14] = [
        35, 32, 102, 101, 104, 108, 101, 114, 32, 99, 111, 100, 101, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 14)
}

fn p_ld(a: u64) -> u64 {
    return *(a as *mut u64)
}

fn p_st(a: u64, v: u64) {
    *(a as *mut u64) = v
}

fn p_bucket(ns: u64) -> u64 {
    if ns < 100000 {
        return 0
    }
    if ns < 250000 {
        return 1
    }
    if ns < 500000 {
        return 2
    }
    if ns < 1000000 {
        return 3
    }
    if ns < 2000000 {
        return 4
    }
    if ns < 4000000 {
        return 5
    }
    if ns < 8000000 {
        return 6
    }
    if ns < 16000000 {
        return 7
    }
    return 8
}

fn err(code: u64) -> i32 {
    t_error()
    meas.meas_u64(code)
    meas.meas_nl()
    return code as i32
}

fn main() -> i32 {
    if !gc_init() {
        return err(2)
    }
    t_header()
    t_cols()
    var hist: [u64; 9] = [0; 9]
    var limits: [u64; 9] = [100000, 250000, 500000, 1000000, 2000000, 4000000, 8000000, 16000000, 0]
    let hp: u64 = (&hist) as u64
    let gp: u64 = (&limits) as u64
    let rss0: u64 = meas.meas_rss_kib()
    if rss0 == 0 {
        return err(3)
    }
    let t0: u64 = meas.meas_now_ms()

    var runs: u64 = 0
    var multi: u64 = 0
    var cycles: u64 = 0
    var since: i64 = 0
    var t: u64 = 0
    var run: bool = true
    while run {
        let n: u64 = dom.dom_cycle_build() catch 0
        if n != dom.DOM_OBJECTS_PER_SET {
            return err(4)
        }
        cycles = cycles + 1
        let l: u64 = gc_collections()
        if l > runs {
            if l > runs + 1 {
                multi = multi + l - runs - 1
            }
            let b: u64 = p_bucket(gc_pause_ns_last())
            p_st(hp + b * 8, p_ld(hp + b * 8) + 1)
            runs = l
        }
        since = since + 1
        if since >= SAMPLE {
            since = 0
            dom.dom_cycle_discard()
            t = meas.meas_now_ms() - t0
            meas.meas_u64(t)
            meas.meas_tab()
            meas.meas_u64(cycles)
            meas.meas_tab()
            meas.meas_u64(meas.meas_rss_kib())
            meas.meas_tab()
            meas.meas_u64(gc_live_objects())
            meas.meas_tab()
            meas.meas_u64(gc_collections())
            meas.meas_tab()
            meas.meas_u64(gc_heap_bytes())
            meas.meas_tab()
            meas.meas_u64(gc_pause_ns_max())
            meas.meas_nl()
            if t >= BUDGET_MS as u64 {
                run = false
            }
        }
    }
    t_hist()
    var i: u64 = 0
    while i < 9 {
        meas.meas_u64(p_ld(gp + i * 8))
        meas.meas_tab()
        meas.meas_u64(p_ld(hp + i * 8))
        meas.meas_nl()
        i = i + 1
    }
    t_pause_max()
    meas.meas_u64(gc_pause_ns_max())
    meas.meas_nl()
    // Diagnostics (round 38): the longest pause per slice type 0..4.
    var ty: u64 = 0
    while ty < 5 {
        meas.meas_u64(ty)
        meas.meas_tab()
        meas.meas_u64(gc_pause_max_ty(ty))
        meas.meas_nl()
        ty = ty + 1
    }
    t_pause_total()
    meas.meas_u64(gc_pause_ns_total())
    meas.meas_nl()
    t_runs()
    meas.meas_u64(gc_collections())
    meas.meas_nl()
    t_cycles()
    meas.meas_u64(cycles)
    meas.meas_nl()
    t_multi()
    meas.meas_u64(multi)
    meas.meas_nl()
    t_rss()
    meas.meas_u64(meas.meas_rss_kib())
    meas.meas_nl()
    t_heap()
    meas.meas_u64(gc_heap_bytes())
    meas.meas_nl()
    var ov: [u8; 1] = [35]
    meas.meas_write((&ov) as u64, 1)
    var sp: [u8; 1] = [32]
    meas.meas_write((&sp) as u64, 1)
    meas.meas_u64(gc_overflows())
    meas.meas_nl()
    t_done()
    return 0
}
