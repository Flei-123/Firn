// SPDX-License-Identifier: GPL-2.0-only
// tools/gc_meas/pause_big.fi -- pauses with a LARGE live set (round 40).
//
// WHY: the 30-minute soak run with pause.fi keeps almost nothing alive
// (the heap stayed at 0.79 MiB). The incremental cycle only switches on from
// INKR_AB = 8 MiB (lib/gc/gc.fi) -- so it was NEVER used in that run.
// The maximum pause of 3.85 ms measured there is therefore a value of the
// NON-incremental path and proves nothing about the incremental one.
//
// This run therefore deliberately keeps a large set alive: a
// root with CHILDREN text nodes (a sibling chain). It hangs on a
// frame cell of main() and survives every collection. At the same time
// the same stream of rubbish as in pause.fi runs (dom_cycle_build). That keeps the heap
// permanently above the threshold, every collection has to mark the full live
// set -- exactly the case incremental collecting was
// built for.
//
// Output: the same TSV format as pause.fi (t_ms, cycles, rss_kib, live,
// collections, heap_bytes, pause_max_ns), after that the histogram and the sums.
// run.sh changes BUDGET_MS/SAMPLE/CHILDREN over with sed.

import dom
import meas

const BUDGET_MS: i64 = 20000 // GCM_BUDGET_MS
const SAMPLE: i64 = 1000 // GCM_SAMPLE
const CHILDREN: u32 = 120000 // GCM_CHILDREN

fn t_header() {
    var t: [u8; 25] = [
        35, 32, 102, 105, 114, 110, 45, 103, 99, 45, 112, 97, 117, 115, 101, 45, 103, 114, 111, 115, 115, 32, 118, 49, 10,
    ]
    meas.meas_write((&t) as u64, 25)
}

fn t_cols() {
    var t: [u8; 76] = [
        35, 32, 115, 112, 97, 108, 116, 101, 110, 58, 32, 116, 95, 109, 115, 9, 122, 121, 107, 108, 101, 110, 9, 114, 115, 115, 95, 107, 105, 98, 9, 108, 101, 98, 101, 110, 100, 101, 9, 115, 97, 109, 109, 101, 108, 108, 97, 101, 117, 102, 101, 9, 104, 101, 97, 112, 95, 98, 121, 116, 101, 115, 9, 112, 97, 117, 115, 101, 95, 109, 97, 120, 95, 110, 115, 10,
    ]
    meas.meas_write((&t) as u64, 76)
}

fn t_hist() {
    var t: [u8; 37] = [
        35, 32, 104, 105, 115, 116, 111, 103, 114, 97, 109, 109, 58, 32, 112, 97, 117, 115, 101, 95, 110, 115, 95, 103, 114, 101, 110, 122, 101, 9, 97, 110, 122, 97, 104, 108, 10,
    ]
    meas.meas_write((&t) as u64, 37)
}

fn t_pmax() {
    var t: [u8; 15] = [
        35, 32, 112, 97, 117, 115, 101, 95, 109, 97, 120, 95, 110, 115, 61,
    ]
    meas.meas_write((&t) as u64, 15)
}

fn t_ptot() {
    var t: [u8; 17] = [
        35, 32, 112, 97, 117, 115, 101, 95, 116, 111, 116, 97, 108, 95, 110, 115, 61,
    ]
    meas.meas_write((&t) as u64, 17)
}

fn t_runs() {
    var t: [u8; 15] = [
        35, 32, 115, 97, 109, 109, 101, 108, 108, 97, 101, 117, 102, 101, 61,
    ]
    meas.meas_write((&t) as u64, 15)
}

fn t_cycles() {
    var t: [u8; 9] = [
        35, 32, 122, 121, 107, 108, 101, 110, 61,
    ]
    meas.meas_write((&t) as u64, 9)
}

fn t_multi() {
    var t: [u8; 22] = [
        35, 32, 117, 101, 98, 101, 114, 115, 101, 104, 101, 110, 95, 109, 101, 104, 114, 102, 97, 99, 104, 61,
    ]
    meas.meas_write((&t) as u64, 22)
}

fn t_rss() {
    var t: [u8; 10] = [
        35, 32, 114, 115, 115, 95, 107, 105, 98, 61,
    ]
    meas.meas_write((&t) as u64, 10)
}

fn t_heap() {
    var t: [u8; 13] = [
        35, 32, 104, 101, 97, 112, 95, 98, 121, 116, 101, 115, 61,
    ]
    meas.meas_write((&t) as u64, 13)
}

fn t_livek() {
    var t: [u8; 17] = [
        35, 32, 108, 101, 98, 101, 110, 100, 101, 95, 107, 110, 111, 116, 101, 110, 61,
    ]
    meas.meas_write((&t) as u64, 17)
}

fn t_ty() {
    var t: [u8; 15] = [
        35, 32, 112, 97, 117, 115, 101, 95, 109, 97, 120, 95, 116, 121, 112,
    ]
    meas.meas_write((&t) as u64, 15)
}

fn t_done() {
    var t: [u8; 9] = [
        35, 32, 102, 101, 114, 116, 105, 103, 10,
    ]
    meas.meas_write((&t) as u64, 9)
}

fn t_ueberl() {
    var t: [u8; 14] = [
        35, 32, 117, 101, 98, 101, 114, 108, 97, 101, 117, 102, 101, 61,
    ]
    meas.meas_write((&t) as u64, 14)
}

fn t_full() {
    var t: [u8; 15] = [
        35, 32, 118, 111, 108, 108, 101, 95, 108, 97, 101, 117, 102, 101, 61,
    ]
    meas.meas_write((&t) as u64, 15)
}

// Round 41: histogram of the SINGLE slices (not only of the longest per
// cycle). Bucket 0 = below 1 us, bucket k = [2^(k-1) us, 2^k us), bucket 15 = from
// 16.384 ms on. It is only cleared AFTER the build-up, so it measures the steady state.
fn t_bucket() {
    var t: [u8; 14] = [
        35, 32, 115, 99, 104, 101, 105, 98, 101, 95, 102, 97, 99, 104,
    ]
    meas.meas_write((&t) as u64, 14)
}

fn p_ld(a: u64) -> u64 {
    return *(a as *mut u64)
}

fn p_st(a: u64, v: u64) {
    *(a as *mut u64) = v
}

fn p_bucket(ns: u64) -> u64 {
    if ns < 100000 {
        return 0
    }
    if ns < 250000 {
        return 1
    }
    if ns < 500000 {
        return 2
    }
    if ns < 1000000 {
        return 3
    }
    if ns < 2000000 {
        return 4
    }
    if ns < 4000000 {
        return 5
    }
    if ns < 8000000 {
        return 6
    }
    if ns < 16000000 {
        return 7
    }
    return 8
}

fn main() -> i32 {
    if !gc_init() {
        return 2
    }
    return run() catch 9
}

fn run() -> AllocError!i32 {
    // ---- build up a large live set -----------------------------------
    let root = try dom.dom_elem_new(1)
    var k: u32 = 0
    while k < CHILDREN {
        let kind = try dom.dom_node_new(1000 + k, dom.DOM_KIND_TEXT)
        // Round 53: the list of children is a GcVec, so appending can
        // allocate and is therefore fallible.
        let ok: bool = try dom.dom_append_child(root, kind)
        k = k + 1
    }

    // The pauses of the build-up do not count towards the steady state.
    gc_hist_reset()

    t_header()
    t_cols()
    var hist: [u64; 9] = [0; 9]
    var limits: [u64; 9] = [100000, 250000, 500000, 1000000, 2000000, 4000000, 8000000, 16000000, 0]
    let hp: u64 = (&hist) as u64
    let gp: u64 = (&limits) as u64
    let t0: u64 = meas.meas_now_ms()

    var runs: u64 = 0
    var multi: u64 = 0
    var cycles: u64 = 0
    var since: i64 = 0
    var t: u64 = 0
    var running: bool = true
    while running {
        let n: u64 = dom.dom_cycle_build() catch 0
        if n != dom.DOM_OBJECTS_PER_SET {
            return 5
        }
        cycles = cycles + 1
        let l: u64 = gc_collections()
        if l > runs {
            if l > runs + 1 {
                multi = multi + l - runs - 1
            }
            let b: u64 = p_bucket(gc_pause_ns_last())
            p_st(hp + b * 8, p_ld(hp + b * 8) + 1)
            runs = l
        }
        since = since + 1
        if since >= SAMPLE {
            since = 0
            t = meas.meas_now_ms() - t0
            meas.meas_u64(t)
            meas.meas_tab()
            meas.meas_u64(cycles)
            meas.meas_tab()
            meas.meas_u64(meas.meas_rss_kib())
            meas.meas_tab()
            meas.meas_u64(gc_live_objects())
            meas.meas_tab()
            meas.meas_u64(gc_collections())
            meas.meas_tab()
            meas.meas_u64(gc_heap_bytes())
            meas.meas_tab()
            meas.meas_u64(gc_pause_ns_max())
            meas.meas_nl()
            if t >= BUDGET_MS as u64 {
                running = false
            }
        }
    }
    // The root MUST still be used here, otherwise the collector may collect it
    // during the loop -- then the run measures nothing.
    if dom.dom_children_count(root) != CHILDREN {
        return 6
    }

    // ---- evaluation ---------------------------------------------------
    t_hist()
    var i: u64 = 0
    while i < 9 {
        meas.meas_u64(p_ld(gp + i * 8))
        meas.meas_tab()
        meas.meas_u64(p_ld(hp + i * 8))
        meas.meas_nl()
        i = i + 1
    }
    var ty: u64 = 0
    while ty < 5 {
        t_ty()
        meas.meas_u64(ty)
        meas.meas_char(61)
        meas.meas_u64(gc_pause_max_ty(ty))
        meas.meas_nl()
        ty = ty + 1
    }
    var htyp: u64 = 0
    while htyp < 7 {
        var bucket: u64 = 0
        while bucket < 16 {
            let n: u64 = gc_hist(htyp, bucket)
            if n != 0 {
                t_bucket()
                meas.meas_u64(htyp)
                meas.meas_char(95)
                meas.meas_u64(bucket)
                meas.meas_char(61)
                meas.meas_u64(n)
                meas.meas_nl()
            }
            bucket = bucket + 1
        }
        htyp = htyp + 1
    }
    t_pmax()
    meas.meas_u64(gc_pause_ns_max())
    meas.meas_nl()
    t_ptot()
    meas.meas_u64(gc_pause_ns_total())
    meas.meas_nl()
    t_runs()
    meas.meas_u64(gc_collections())
    meas.meas_nl()
    t_cycles()
    meas.meas_u64(cycles)
    meas.meas_nl()
    t_multi()
    meas.meas_u64(multi)
    meas.meas_nl()
    t_rss()
    meas.meas_u64(meas.meas_rss_kib())
    meas.meas_nl()
    t_heap()
    meas.meas_u64(gc_heap_bytes())
    meas.meas_nl()
    t_livek()
    meas.meas_u64(CHILDREN as u64)
    meas.meas_nl()
    t_ueberl()
    meas.meas_u64(gc_overflows())
    meas.meas_nl()
    t_full()
    meas.meas_u64(gc_full_runs())
    meas.meas_nl()
    t_done()
    return 0
}
