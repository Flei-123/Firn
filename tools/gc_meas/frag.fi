// SPDX-License-Identifier: GPL-2.0-only
// tools/gc_meas/frag.fi -- fragmentation test of the GC (round 38, stage 1).
//
// Changing object sizes under continuous load: six classes with payloads
// from 40 to 2040 bytes. Per round ONE stack of fresh objects of exactly
// ONE class is built; the stack of the same class from the last round
// of that class is let go of while doing so. What stays alive is thus a constant
// six stacks of mixed size.
//
// DESIGN RULE (from measurements min1..min4): the heads lie as RAW
// addresses (u64) in an array in main -- a real overwrite, not an
// eliminable assignment. The change of stack happens in helper functions
// that only give back the address: that way no old head sticks in a
// result temp cell of the main frame that is never written again
// (a conservative scan would otherwise hold the whole old chain).
//
// Fragmentation shows up as an RSS that keeps rising with the rounds
// although the number of live objects is constant. What is measured is the real
// RSS from /proc/self/statm (meas.fi), not the self-report of the heap.

import meas

const ROUNDS: u64 = 600 // GCM_ROUNDS
const BATCH: u32 = 200 // GCM_BATCH

gc class F48 {
    n: Gc[F48],
    d: [u64; 4],
}

gc class F96 {
    n: Gc[F96],
    d: [u64; 10],
}

gc class F192 {
    n: Gc[F192],
    d: [u64; 22],
}

gc class F384 {
    n: Gc[F384],
    d: [u64; 46],
}

gc class F768 {
    n: Gc[F768],
    d: [u64; 94],
}

gc class F2048 {
    n: Gc[F2048],
    d: [u64; 254],
}

fn b_F48(n: u32) -> AllocError!u64 {
    var k: Gc[F48] = gc_null[F48]()
    var i: u32 = 0
    while i < n {
        k = try gc F48 { n: k, d: [0; 4] }
        i = i + 1
    }
    return k as u64
}

fn b_F96(n: u32) -> AllocError!u64 {
    var k: Gc[F96] = gc_null[F96]()
    var i: u32 = 0
    while i < n {
        k = try gc F96 { n: k, d: [0; 10] }
        i = i + 1
    }
    return k as u64
}

fn b_F192(n: u32) -> AllocError!u64 {
    var k: Gc[F192] = gc_null[F192]()
    var i: u32 = 0
    while i < n {
        k = try gc F192 { n: k, d: [0; 22] }
        i = i + 1
    }
    return k as u64
}

fn b_F384(n: u32) -> AllocError!u64 {
    var k: Gc[F384] = gc_null[F384]()
    var i: u32 = 0
    while i < n {
        k = try gc F384 { n: k, d: [0; 46] }
        i = i + 1
    }
    return k as u64
}

fn b_F768(n: u32) -> AllocError!u64 {
    var k: Gc[F768] = gc_null[F768]()
    var i: u32 = 0
    while i < n {
        k = try gc F768 { n: k, d: [0; 94] }
        i = i + 1
    }
    return k as u64
}

fn b_F2048(n: u32) -> AllocError!u64 {
    var k: Gc[F2048] = gc_null[F2048]()
    var i: u32 = 0
    while i < n {
        k = try gc F2048 { n: k, d: [0; 254] }
        i = i + 1
    }
    return k as u64
}

fn t_header() {
    var t: [u8; 22] = [
        35, 32, 102, 105, 114, 110, 45, 103, 99, 45, 102, 114, 97, 103, 109, 101, 110, 116, 32, 118, 49, 10,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 22)
}

fn t_cols() {
    var t: [u8; 57] = [
        35, 32, 115, 112, 97, 108, 116, 101, 110, 58, 32, 114, 117, 110, 100, 101, 9, 114, 115, 115, 95, 107, 105, 98, 9, 104, 101, 97, 112, 95, 98, 121, 116, 101, 115, 9, 108, 101, 98, 101, 110, 100, 101, 9, 115, 97, 109, 109, 101, 108, 108, 97, 101, 117, 102, 101, 10,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 57)
}

fn t_rss0() {
    var t: [u8; 16] = [
        35, 32, 114, 115, 115, 95, 115, 116, 97, 114, 116, 95, 107, 105, 98, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 16)
}

fn t_rssmax() {
    var t: [u8; 14] = [
        35, 32, 114, 115, 115, 95, 109, 97, 120, 95, 107, 105, 98, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 14)
}

fn t_rssend() {
    var t: [u8; 15] = [
        35, 32, 114, 115, 115, 95, 101, 110, 100, 101, 95, 107, 105, 98, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 15)
}

fn t_heap() {
    var t: [u8; 13] = [
        35, 32, 104, 101, 97, 112, 95, 98, 121, 116, 101, 115, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 13)
}

fn t_live() {
    var t: [u8; 10] = [
        35, 32, 108, 101, 98, 101, 110, 100, 101, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 10)
}

fn t_ref() {
    var t: [u8; 11] = [
        35, 32, 114, 101, 102, 115, 117, 109, 109, 101, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 11)
}

fn t_done() {
    var t: [u8; 9] = [
        35, 32, 102, 101, 114, 116, 105, 103, 10,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 9)
}

fn t_error() {
    var t: [u8; 14] = [
        35, 32, 102, 101, 104, 108, 101, 114, 32, 99, 111, 100, 101, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 14)
}

fn err(code: u64) -> i32 {
    t_error()
    meas.meas_u64(code)
    meas.meas_nl()
    return code as i32
}

fn main() -> i32 {
    if !gc_init() {
        return err(2)
    }
    t_header()
    t_cols()
    let rss0: u64 = meas.meas_rss_kib()
    if rss0 == 0 {
        return err(3)
    }
    // The six live stack heads: raw addresses, really overwritten.
    var headers: [u64; 6] = [0; 6]
    var rss_max: u64 = rss0
    var round: u64 = 0
    while round < ROUNDS {
        let w: u64 = round % 6
        if w == 0 {
            let a: u64 = b_F48(BATCH) catch 0
            if a == 0 {
                return err(10)
            }
            headers[0] = a
        }
        if w == 1 {
            let a: u64 = b_F96(BATCH) catch 0
            if a == 0 {
                return err(11)
            }
            headers[1] = a
        }
        if w == 2 {
            let a: u64 = b_F192(BATCH) catch 0
            if a == 0 {
                return err(12)
            }
            headers[2] = a
        }
        if w == 3 {
            let a: u64 = b_F384(BATCH) catch 0
            if a == 0 {
                return err(13)
            }
            headers[3] = a
        }
        if w == 4 {
            let a: u64 = b_F768(BATCH) catch 0
            if a == 0 {
                return err(14)
            }
            headers[4] = a
        }
        if w == 5 {
            let a: u64 = b_F2048(BATCH) catch 0
            if a == 0 {
                return err(15)
            }
            headers[5] = a
        }
        let rss: u64 = meas.meas_rss_kib()
        if rss > rss_max {
            rss_max = rss
        }
        meas.meas_u64(round)
        meas.meas_tab()
        meas.meas_u64(rss)
        meas.meas_tab()
        meas.meas_u64(gc_heap_bytes())
        meas.meas_tab()
        meas.meas_u64(gc_live_objects())
        meas.meas_tab()
        meas.meas_u64(gc_collections())
        meas.meas_nl()
        round = round + 1
    }
    // A reference sum so that the array counts as read up to here.
    var ref_sum: u64 = 0
    var j: usize = 0
    while j < 6 {
        if headers[j] == 0 {
            return err(20)
        }
        ref_sum = ref_sum + headers[j] % 256
        j = j + 1
    }
    gc_collect()
    t_rss0()
    meas.meas_u64(rss0)
    meas.meas_nl()
    t_rssmax()
    meas.meas_u64(rss_max)
    meas.meas_nl()
    t_rssend()
    meas.meas_u64(meas.meas_rss_kib())
    meas.meas_nl()
    t_heap()
    meas.meas_u64(gc_heap_bytes())
    meas.meas_nl()
    t_live()
    meas.meas_u64(gc_live_objects())
    meas.meas_nl()
    t_ref()
    meas.meas_u64(ref_sum)
    meas.meas_nl()
    t_done()
    return 0
}
