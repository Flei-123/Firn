// tools/gc_meas/build.fi — Pausen ueber den GANZEN Lauf, AUFBAU EINGESCHLOSSEN
// (Runde 44).
//
// WARUM ein neues Messprogramm: pause_big.fi ruft gc_hist_reset() NACH dem
// Aufbau der lebenden Menge — das Histogramm zeigt dort also nur den
// Dauerbetrieb. Genau die Pausen des Aufbaus (volle Stop-the-World-Laeufe
// unterhalb von INKR_AB) sind aber der Gegenstand dieser Runde. Dieser Lauf
// nullt NICHTS: Phase 0 ist die Bilanz nach dem Aufbau, Phase 1 die Bilanz
// ueber den GANZEN Lauf (Aufbau + Dauerbetrieb). Der Dauerbetrieb allein ist
// die Differenz.
//
// Ausgabe bewusst ohne Textmarken (maschinenlesbar, ein Zeichen je Zeilenart):
//   A  <lauf> <pause_ns> <heap_bytes> <volle_laeufe> <kind_index>
//        ein Sammellauf WAEHREND des Aufbaus (bei welcher Heapgroesse?)
//   S  <t_ms> <zyklen> <rss_kib> <lebende> <laeufe> <heap_bytes> <pause_max_ns>
//        Stichprobe im Dauerbetrieb
//   H  <phase> <typ> <fach> <anzahl>     Scheiben-Histogramm (kumulativ)
//   M  <phase> <typ> <ns>                laengste Scheibe je Typ (kumulativ)
//   C  <phase> <fach> <anzahl>           ganze Unterbrechung in RECHENZEIT
//   K  <phase> <code> <wert>             Kennzahlen, siehe unten
//
// Kennzahl-Codes: 0 ms, 1 zyklen, 2 sammellaeufe, 3 volle_laeufe, 4 heap_bytes,
// 5 rss_kib, 6 lebbytes, 7 ueberlaeufe, 8 pause_max_ns, 9 pause_total_ns,
// 10 barrieren, 11 gesamt_bytes, 12 lebende_objekte, 13 stop_max_ns
// (laengste GANZE Unterbrechung, Histogramm-Typ 7), 14..20 Diagnose
// gc_diag(0..6): neue Chunks in Ruhe/Mark/Sweep, Mark-Scheiben,
// Sweep-Scheiben, graue Allokationen, Allokationen gesamt, 21 laengste ganze
// Unterbrechung in reiner Rechenzeit.
//
// Phasen: 0 = nach dem Aufbau, 1 = Ende (ganzer Lauf).

import dom
import meas

const BUDGET_MS: i64 = 20000  // GCM_BUDGET_MS
const KINDER: u32 = 120000    // GCM_KINDER
const STICHPROBE: i64 = 1000  // GCM_STICHPROBE
// Umschaltschwelle atomar/inkrementell (Runde 44, gc_set_inkr_ab).
// 0 = immer inkrementell, 8388608 = altes Verhalten.
const AB_SCHWELLE: u64 = 8388608  // GCM_SCHWELLE
// Zweite Uhr: reine Rechenzeit des Fadens (Runde 44). Nur damit laesst sich
// eine Pause, die der Sammler verursacht hat, von einer unterscheiden, in
// der die Maschine den Prozess verdraengt hat.
const CPU_UHR: u64 = 1            // GCM_CPUUHR

fn kenn(phase: u64, code: u64, value: u64) {
    meas.meas_char(75)
    meas.meas_tab()
    meas.meas_u64(phase)
    meas.meas_tab()
    meas.meas_u64(code)
    meas.meas_tab()
    meas.meas_u64(value)
    meas.meas_nl()
}

fn hist_out(phase: u64) {
    var ty: u64 = 0
    while ty < 8 {
        var bucket: u64 = 0
        while bucket < 16 {
            let n: u64 = gc_hist(ty, bucket)
            if n != 0 {
                meas.meas_char(72)
                meas.meas_tab()
                meas.meas_u64(phase)
                meas.meas_tab()
                meas.meas_u64(ty)
                meas.meas_tab()
                meas.meas_u64(bucket)
                meas.meas_tab()
                meas.meas_u64(n)
                meas.meas_nl()
            }
            bucket = bucket + 1
        }
        ty = ty + 1
    }
    var fc: u64 = 0
    while fc < 16 {
        let nc: u64 = gc_chist(fc)
        if nc != 0 {
            meas.meas_char(67)
            meas.meas_tab()
            meas.meas_u64(phase)
            meas.meas_tab()
            meas.meas_u64(fc)
            meas.meas_tab()
            meas.meas_u64(nc)
            meas.meas_nl()
        }
        fc = fc + 1
    }
    var t2: u64 = 0
    while t2 < 5 {
        meas.meas_char(77)
        meas.meas_tab()
        meas.meas_u64(phase)
        meas.meas_tab()
        meas.meas_u64(t2)
        meas.meas_tab()
        meas.meas_u64(gc_pause_max_ty(t2))
        meas.meas_nl()
        t2 = t2 + 1
    }
}

fn metrics(phase: u64, ms: u64, cycles: u64) {
    kenn(phase, 0, ms)
    kenn(phase, 1, cycles)
    kenn(phase, 2, gc_collections())
    kenn(phase, 3, gc_full_runs())
    kenn(phase, 4, gc_heap_bytes())
    kenn(phase, 5, meas.meas_rss_kib())
    kenn(phase, 6, gc_live_bytes())
    kenn(phase, 7, gc_overflows())
    kenn(phase, 8, gc_pause_ns_max())
    kenn(phase, 9, gc_pause_ns_total())
    kenn(phase, 10, gc_barriers())
    kenn(phase, 11, gc_total_bytes())
    kenn(phase, 12, gc_live_objects())
    kenn(phase, 13, gc_stop_max())
    kenn(phase, 21, gc_cpu_stop_max())
    var i: u64 = 0
    while i < 7 {
        kenn(phase, 14 + i, gc_diag(i))
        i = i + 1
    }
}

fn main() -> i32 {
    if !gc_init() {
        return 2
    }
    return run() catch 9
}

fn run() -> AllocError!i32 {
    gc_set_incr_ab(AB_SCHWELLE)
    gc_set_cpu_clock(CPU_UHR)
    let t0: u64 = meas.meas_now_ms()
    // ---- grosse lebende Menge aufbauen (jeder Sammellauf wird gemeldet) ----
    let root = try dom.dom_elem_new(1)
    var k: u32 = 0
    var runs: u64 = 0
    while k < KINDER {
        let kind = try dom.dom_node_new(1000 + k, dom.DOM_ART_TEXT)
        // Runde 53: die Kinderliste ist eine GcVec, das Anhaengen kann
        // also allozieren und ist damit fehlbar.
        let ok: bool = try dom.dom_append_child(root, kind)
        let l: u64 = gc_collections()
        if l != runs {
            runs = l
            meas.meas_char(65)
            meas.meas_tab()
            meas.meas_u64(l)
            meas.meas_tab()
            meas.meas_u64(gc_pause_ns_last())
            meas.meas_tab()
            meas.meas_u64(gc_heap_bytes())
            meas.meas_tab()
            meas.meas_u64(gc_full_runs())
            meas.meas_tab()
            meas.meas_u64(k as u64)
            meas.meas_nl()
        }
        k = k + 1
    }
    let t1: u64 = meas.meas_now_ms()
    metrics(0, t1 - t0, 0)
    hist_out(0)

    // ---- Dauerbetrieb: derselbe Muellstrom wie pause.fi --------------------
    var cycles: u64 = 0
    var since: i64 = 0
    var t: u64 = 0
    var running: bool = true
    while running {
        let n: u64 = dom.dom_cycle_build() catch 0
        if n != dom.DOM_OBJEKTE_JE_SATZ {
            return 5
        }
        cycles = cycles + 1
        since = since + 1
        if since >= STICHPROBE {
            since = 0
            t = meas.meas_now_ms() - t1
            meas.meas_char(83)
            meas.meas_tab()
            meas.meas_u64(t)
            meas.meas_tab()
            meas.meas_u64(cycles)
            meas.meas_tab()
            meas.meas_u64(meas.meas_rss_kib())
            meas.meas_tab()
            meas.meas_u64(gc_live_objects())
            meas.meas_tab()
            meas.meas_u64(gc_collections())
            meas.meas_tab()
            meas.meas_u64(gc_heap_bytes())
            meas.meas_tab()
            meas.meas_u64(gc_pause_ns_max())
            meas.meas_nl()
            if t >= BUDGET_MS as u64 {
                running = false
            }
        }
    }
    // Die Wurzel MUSS hier noch benutzt werden, sonst darf der Sammler sie
    // waehrend der Schleife einsammeln — dann misst der Lauf nichts.
    if dom.dom_children_count(root) != KINDER {
        return 6
    }
    let t2: u64 = meas.meas_now_ms()
    metrics(1, t2 - t1, cycles)
    hist_out(1)
    return 0
}
