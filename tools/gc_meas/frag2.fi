// SPDX-License-Identifier: GPL-2.0-only
// tools/gc_meas/frag2.fi -- phase fragmentation test (round 38, stage 2).
//
// Unlike frag.fi (six classes at the same time, constant) a PHASE workload
// runs here -- the hard case for a class allocator:
//   phase A: only large objects (class 2048), many stacks one after another.
//   phase B: only small objects (class 48), the same dynamics.
// Without giving empty class chunks back to the operating system the RSS
// stays high forever after phase A although almost everything is dead in phase B.
// With giving them back the RSS has to fall clearly in phase B.
//
// Again the real RSS is measured (/proc/self/statm), the heads lie
// as raw addresses in an array (the design rule from stage 1).

import meas

const ROUNDS_A: u64 = 300 // GCM_ROUNDS_A
const ROUNDS_B: u64 = 300 // GCM_ROUNDS_B
const BATCH: u32 = 200 // GCM_BATCH
const STACK: u64 = 24 // GCM_STAPEL — gleichzeitig lebende Stapel je Phase

gc class F48 {
    n: Gc[F48],
    d: [u64; 4],
}

gc class F96 {
    n: Gc[F96],
    d: [u64; 10],
}

gc class F192 {
    n: Gc[F192],
    d: [u64; 22],
}

gc class F384 {
    n: Gc[F384],
    d: [u64; 46],
}

gc class F768 {
    n: Gc[F768],
    d: [u64; 94],
}

gc class F2048 {
    n: Gc[F2048],
    d: [u64; 254],
}

fn b_big(n: u32) -> AllocError!u64 {
    var k: Gc[F2048] = gc_null[F2048]()
    var i: u32 = 0
    while i < n {
        k = try gc F2048 { n: k, d: [0; 254] }
        i = i + 1
    }
    return k as u64
}

fn b_small(n: u32) -> AllocError!u64 {
    var k: Gc[F48] = gc_null[F48]()
    var i: u32 = 0
    while i < n {
        k = try gc F48 { n: k, d: [0; 4] }
        i = i + 1
    }
    return k as u64
}

fn t_header() {
    var t: [u8; 20] = [
        35, 32, 102, 105, 114, 110, 45, 103, 99, 45, 112, 104, 97, 115, 101, 110, 32, 118, 49, 10,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 20)
}

fn t_cols() {
    var t: [u8; 63] = [
        35, 32, 115, 112, 97, 108, 116, 101, 110, 58, 32, 114, 117, 110, 100, 101, 9, 112, 104, 97, 115, 101, 9, 114, 115, 115, 95, 107, 105, 98, 9, 104, 101, 97, 112, 95, 98, 121, 116, 101, 115, 9, 108, 101, 98, 101, 110, 100, 101, 9, 115, 97, 109, 109, 101, 108, 108, 97, 101, 117, 102, 101, 10,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 63)
}

fn t_rssa() {
    var t: [u8; 22] = [
        35, 32, 114, 115, 115, 95, 112, 104, 97, 115, 101, 95, 97, 95, 109, 97, 120, 95, 107, 105, 98, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 22)
}

fn t_rssb() {
    var t: [u8; 22] = [
        35, 32, 114, 115, 115, 95, 112, 104, 97, 115, 101, 95, 98, 95, 109, 97, 120, 95, 107, 105, 98, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 22)
}

fn t_rssend() {
    var t: [u8; 15] = [
        35, 32, 114, 115, 115, 95, 101, 110, 100, 101, 95, 107, 105, 98, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 15)
}

fn t_done() {
    var t: [u8; 9] = [
        35, 32, 102, 101, 114, 116, 105, 103, 10,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 9)
}

fn t_error() {
    var t: [u8; 14] = [
        35, 32, 102, 101, 104, 108, 101, 114, 32, 99, 111, 100, 101, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 14)
}

fn err(code: u64) -> i32 {
    t_error()
    meas.meas_u64(code)
    meas.meas_nl()
    return code as i32
}

fn line(round: u64, phase: u64) {
    meas.meas_u64(round)
    meas.meas_tab()
    meas.meas_u64(phase)
    meas.meas_tab()
    meas.meas_u64(meas.meas_rss_kib())
    meas.meas_tab()
    meas.meas_u64(gc_heap_bytes())
    meas.meas_tab()
    meas.meas_u64(gc_live_objects())
    meas.meas_tab()
    meas.meas_u64(gc_collections())
    meas.meas_nl()
}

fn main() -> i32 {
    if !gc_init() {
        return err(2)
    }
    t_header()
    t_cols()
    var headers: [u64; 24] = [0; 24]
    var slot: usize = 0
    var rss_a: u64 = 0
    var rss_b: u64 = 0
    var round: u64 = 0
    while round < ROUNDS_A {
        let a: u64 = b_big(BATCH) catch 0
        if a == 0 {
            return err(10)
        }
        headers[slot] = a
        slot = slot + 1
        if slot == STACK as usize {
            slot = 0
        }
        let rss: u64 = meas.meas_rss_kib()
        if rss > rss_a {
            rss_a = rss
        }
        line(round, 1)
        round = round + 1
    }
    // Transition: the large stacks die NOW (from here on the array is
    // only overwritten with small heads).
    round = 0
    while round < ROUNDS_B {
        let a: u64 = b_small(BATCH) catch 0
        if a == 0 {
            return err(11)
        }
        headers[slot] = a
        slot = slot + 1
        if slot == STACK as usize {
            slot = 0
        }
        let rss: u64 = meas.meas_rss_kib()
        if rss > rss_b {
            rss_b = rss
        }
        line(round, 2)
        round = round + 1
    }
    gc_collect()
    let rss_end: u64 = meas.meas_rss_kib()
    var ref_sum: u64 = 0
    var j: usize = 0
    while j < 24 {
        ref_sum = ref_sum + headers[j] % 256
        j = j + 1
    }
    t_rssa()
    meas.meas_u64(rss_a)
    meas.meas_nl()
    t_rssb()
    meas.meas_u64(rss_b)
    meas.meas_nl()
    t_rssend()
    meas.meas_u64(rss_end)
    meas.meas_nl()
    meas.meas_u64(ref_sum)
    meas.meas_nl()
    t_done()
    return 0
}
