// SPDX-License-Identifier: GPL-2.0-only
// tools/gc_meas/ab.fi -- A/B comparison of atomic against incremental IN THE SAME
// PROCESS (round 44).
//
// WHY: the difference in throughput at issue lies in the range of a few
// per cent. Two separately built programs already differ by more than that through
// code layout and addresses, and the machine drifts over
// minutes. Since `gc_set_incr_ab()` (round 44) the threshold can be set at
// run time: the same process, the same machine code, the same
// live set -- only the threshold changes. The phases run interleaved
// (A B A B A B) so that a drift hits both variants equally.
//
// Output:
//   P <nr> <ab> <ms> <heap_bytes> <gc_ns> <stop_max_ns> <new_chunks> <runs>
//   Q <code> <value>   final values (0 live, 1 rss_kib, 2 total_bytes)

import dom
import meas

const CHILDREN: u32 = 2000 // GCM_CHILDREN
const ROUNDS: u64 = 100000 // GCM_ROUNDS
const PAIRS: u64 = 3 // GCM_PAARE
const AB_A: u64 = 8388608 // GCM_AB_A
const AB_B: u64 = 0 // GCM_AB_B

fn q(code: u64, value: u64) {
    meas.meas_char(81)
    meas.meas_tab()
    meas.meas_u64(code)
    meas.meas_tab()
    meas.meas_u64(value)
    meas.meas_nl()
}

fn main() -> i32 {
    if !gc_init() {
        return 2
    }
    return run() catch 9
}

fn run() -> AllocError!i32 {
    let root = try dom.dom_elem_new(1)
    var k: u32 = 0
    while k < CHILDREN {
        let kind = try dom.dom_node_new(1000 + k, dom.DOM_KIND_TEXT)
        // Round 53: the list of children is a GcVec, so appending can
        // allocate and is therefore fallible.
        let ok: bool = try dom.dom_append_child(root, kind)
        k = k + 1
    }

    var nr: u64 = 0
    while nr < PAIRS * 2 {
        var ab: u64 = AB_A
        if nr % 2 == 1 {
            ab = AB_B
        }
        gc_set_incr_ab(ab)
        gc_hist_reset()
        let g0: u64 = gc_pause_ns_total()
        let c0: u64 = gc_diag(0) + gc_diag(1) + gc_diag(2)
        let l0: u64 = gc_collections()
        let t0: u64 = meas.meas_now_ms()
        var r: u64 = 0
        while r < ROUNDS {
            let n: u64 = dom.dom_cycle_build() catch 0
            if n != dom.DOM_OBJECTS_PER_SET {
                return 5
            }
            r = r + 1
        }
        let t1: u64 = meas.meas_now_ms()
        meas.meas_char(80)
        meas.meas_tab()
        meas.meas_u64(nr)
        meas.meas_tab()
        meas.meas_u64(ab)
        meas.meas_tab()
        meas.meas_u64(t1 - t0)
        meas.meas_tab()
        meas.meas_u64(gc_heap_bytes())
        meas.meas_tab()
        meas.meas_u64(gc_pause_ns_total() - g0)
        meas.meas_tab()
        meas.meas_u64(gc_stop_max())
        meas.meas_tab()
        meas.meas_u64(gc_diag(0) + gc_diag(1) + gc_diag(2) - c0)
        meas.meas_tab()
        meas.meas_u64(gc_collections() - l0)
        meas.meas_nl()
        nr = nr + 1
    }
    if dom.dom_children_count(root) != CHILDREN {
        return 6
    }
    q(0, gc_live_objects())
    q(1, meas.meas_rss_kib())
    q(2, gc_total_bytes())
    return 0
}
