// tools/gc_meas/ab.fi — A/B-Vergleich atomar gegen inkrementell IM SELBEN
// PROZESS (Runde 44).
//
// WARUM: Der Durchsatzunterschied, um den es geht, liegt im Bereich weniger
// Prozent. Zwei getrennt gebaute Programme unterscheiden sich schon durch
// Codelayout und Adressen um mehr als das, und die Maschine driftet ueber
// Minuten. Seit `gc_set_inkr_ab()` (Runde 44) laesst sich die Schwelle zur
// Laufzeit stellen: derselbe Prozess, derselbe Maschinencode, dieselbe
// lebende Menge — nur die Schwelle wechselt. Die Phasen laufen verschachtelt
// (A B A B A B), damit eine Drift beide Varianten gleich trifft.
//
// Ausgabe:
//   P <nr> <ab> <ms> <heap_bytes> <gc_ns> <stop_max_ns> <neue_chunks> <laeufe>
//   Q <code> <wert>   Schlusswerte (0 lebende, 1 rss_kib, 2 gesamt_bytes)

import dom
import meas

const CHILDREN: u32 = 2000       // GCM_CHILDREN
const ROUNDS: u64 = 100000     // GCM_ROUNDS
const PAIRS: u64 = 3           // GCM_PAARE
const AB_A: u64 = 8388608      // GCM_AB_A
const AB_B: u64 = 0            // GCM_AB_B

fn q(code: u64, value: u64) {
    meas.meas_char(81)
    meas.meas_tab()
    meas.meas_u64(code)
    meas.meas_tab()
    meas.meas_u64(value)
    meas.meas_nl()
}

fn main() -> i32 {
    if !gc_init() {
        return 2
    }
    return run() catch 9
}

fn run() -> AllocError!i32 {
    let root = try dom.dom_elem_new(1)
    var k: u32 = 0
    while k < CHILDREN {
        let kind = try dom.dom_node_new(1000 + k, dom.DOM_KIND_TEXT)
        // Runde 53: die Kinderliste ist eine GcVec, das Anhaengen kann
        // also allozieren und ist damit fehlbar.
        let ok: bool = try dom.dom_append_child(root, kind)
        k = k + 1
    }

    var nr: u64 = 0
    while nr < PAIRS * 2 {
        var ab: u64 = AB_A
        if nr % 2 == 1 {
            ab = AB_B
        }
        gc_set_incr_ab(ab)
        gc_hist_reset()
        let g0: u64 = gc_pause_ns_total()
        let c0: u64 = gc_diag(0) + gc_diag(1) + gc_diag(2)
        let l0: u64 = gc_collections()
        let t0: u64 = meas.meas_now_ms()
        var r: u64 = 0
        while r < ROUNDS {
            let n: u64 = dom.dom_cycle_build() catch 0
            if n != dom.DOM_OBJECTS_PER_SET {
                return 5
            }
            r = r + 1
        }
        let t1: u64 = meas.meas_now_ms()
        meas.meas_char(80)
        meas.meas_tab()
        meas.meas_u64(nr)
        meas.meas_tab()
        meas.meas_u64(ab)
        meas.meas_tab()
        meas.meas_u64(t1 - t0)
        meas.meas_tab()
        meas.meas_u64(gc_heap_bytes())
        meas.meas_tab()
        meas.meas_u64(gc_pause_ns_total() - g0)
        meas.meas_tab()
        meas.meas_u64(gc_stop_max())
        meas.meas_tab()
        meas.meas_u64(gc_diag(0) + gc_diag(1) + gc_diag(2) - c0)
        meas.meas_tab()
        meas.meas_u64(gc_collections() - l0)
        meas.meas_nl()
        nr = nr + 1
    }
    if dom.dom_children_count(root) != CHILDREN {
        return 6
    }
    q(0, gc_live_objects())
    q(1, meas.meas_rss_kib())
    q(2, gc_total_bytes())
    return 0
}
