// SPDX-License-Identifier: GPL-2.0-only
// tools/gc_meas/throughput.fi -- THROUGHPUT at fixed work (round 44).
//
// The pause runs measure time at a fixed run time; for throughput
// that is the wrong direction. Here the WORK is fixed (ROUNDS rubbish cycles at
// CHILDREN live nodes) and the TIME is the result. That way the
// requirement from round 38 (at most 10 % loss of throughput) can be checked directly.
//
// CHILDREN sets the regime:
//   small (e.g. 2000)   -> the heap stays below INKR_AB, exactly the regime the
//                          threshold is meant to protect.
//   large (e.g. 120000) -> the heap is above INKR_AB, incremental cycle.
//
// Output (one line per key figure, machine readable):
//   D <code> <value>
// Codes: 0 build_ms, 1 work_ms, 2 rounds, 3 collections, 4 full_runs,
// 5 heap_bytes, 6 total_bytes, 7 rss_kib, 8 pause_max_ns, 9 pause_total_ns,
// 10 live_objects, 11 barriers, 12 ns_per_round.

import dom
import meas

const CHILDREN: u32 = 2000 // GCM_CHILDREN
const ROUNDS: u64 = 200000 // GCM_ROUNDS

fn d(code: u64, value: u64) {
    meas.meas_char(68)
    meas.meas_tab()
    meas.meas_u64(code)
    meas.meas_tab()
    meas.meas_u64(value)
    meas.meas_nl()
}

fn main() -> i32 {
    if !gc_init() {
        return 2
    }
    return run() catch 9
}

fn run() -> AllocError!i32 {
    let t0: u64 = meas.meas_now_ms()
    let root = try dom.dom_elem_new(1)
    var k: u32 = 0
    while k < CHILDREN {
        let kind = try dom.dom_node_new(1000 + k, dom.DOM_KIND_TEXT)
        // Round 53: the list of children is a GcVec, so appending can
        // allocate and is therefore fallible.
        let ok: bool = try dom.dom_append_child(root, kind)
        k = k + 1
    }
    let t1: u64 = meas.meas_now_ms()

    var r: u64 = 0
    while r < ROUNDS {
        let n: u64 = dom.dom_cycle_build() catch 0
        if n != dom.DOM_OBJECTS_PER_SET {
            return 5
        }
        r = r + 1
    }
    let t2: u64 = meas.meas_now_ms()
    if dom.dom_children_count(root) != CHILDREN {
        return 6
    }

    let work: u64 = t2 - t1
    d(0, t1 - t0)
    d(1, work)
    d(2, ROUNDS)
    d(3, gc_collections())
    d(4, gc_full_runs())
    d(5, gc_heap_bytes())
    d(6, gc_total_bytes())
    d(7, meas.meas_rss_kib())
    d(8, gc_pause_ns_max())
    d(9, gc_pause_ns_total())
    d(10, gc_live_objects())
    d(11, gc_barriers())
    d(12, work * 1000000 / ROUNDS)
    // Diagnostics (round 44): 13 new chunks while idle, 14 while marking,
    // 15 while sweeping, 16 mark slices, 17 sweep slices, 18 grey
    // allocations, 19 allocations in total.
    var i: u64 = 0
    while i < 7 {
        d(13 + i, gc_diag(i))
        i = i + 1
    }
    d(20, gc_stop_max())
    return 0
}
