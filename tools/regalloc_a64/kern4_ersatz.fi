// expect_exit: 0
// ROUND REGALLOC-A64 -- the KERN-4 fibre test's QUESTION, in a form this
// branch can compile.
//
// tools/kern/fasertest.fi of the Certus tree cannot be built here: it needs
// `#[arch(x86_64)]` / `#[arch(aarch64)]` to pick between two machine code
// blobs, and that attribute lives on branch `arm-freestanding`, which the
// base of this round (`phi`) does not contain -- checked with
// `git merge-base --is-ancestor arm-freestanding phi`, and the same file
// fails to compile with the UNMODIFIED base compiler for the same reason.
// That is a branch gap, not something this round did.
//
// What KERN-4 really asks is: after a deep chain of calls, does every frame
// find its own locals again, and do both machines say the same numbers? That
// is exactly the question a register allocator can get wrong -- a value that
// lived in a callee-saved register across a call, a parameter overwritten
// while the next argument list was being built, a saved register parked on
// top of the outgoing arguments. All three of those were REAL bugs of this
// round (tests/024, tests/1400, tests/331).
//
// So this program does the same thing without the machine code: a deep
// recursion carrying many live values across each call, mixed integer
// widths, and a checked arithmetic site in the middle of the hot path.

fn schreib(p: u64, n: u64) {
    let w: i64 = syscall(1, 1, p as i64, n as i64, 0, 0, 0)
}

fn zahl(v: u64) {
    var b: [u8; 24] = [0; 24]
    var i: u64 = 24
    var x: u64 = v
    if x == 0 {
        i = i - 1
        b[i as usize] = 48 as u8
    }
    while x > 0 {
        i = i - 1
        b[i as usize] = (48 + (x % 10)) as u8
        x = x / 10
    }
    schreib((&b[i as usize]) as u64, 24 - i)
}

fn nl() {
    var b: [u8; 1] = [10; 1]
    schreib((&b[0]) as u64, 1)
}

// Eight live values across a call: more than the callee-saved supply of the
// x86 side (five) and inside that of the A64 side (ten), so both machines
// have to spill differently and still agree.
fn tief(n: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> i64 {
    if n <= 0 {
        return a + b + c + d + e + f + g
    }
    // every one of these has to survive the recursive call
    let a2: i64 = a + 1
    let b2: i64 = b + 2
    let c2: i64 = c + 3
    let d2: i64 = d + 5
    let e2: i64 = e + 7
    let f2: i64 = f + 11
    let g2: i64 = g + 13
    let unten: i64 = tief(n - 1, a2, b2, c2, d2, e2, f2, g2)
    // ... and be read again AFTERWARDS, in the same frame
    return unten + a2 - b2 + c2 - d2 + e2 - f2 + g2
}

// Mixed widths through a call: the canonical form of a register has to hold
// for signed narrow types too, which is what `canonicalise` is for.
fn schmal(x: i32, y: i16, z: i8) -> i64 {
    let a: i32 = x - 1000000
    let b: i16 = y - 30000
    let c: i8 = z - 100
    return (a as i64) + (b as i64) + (c as i64)
}

fn main() -> i32 {
    let t: i64 = tief(12, 1, 2, 3, 4, 5, 6, 7)
    zahl(t as u64)
    nl()
    if t != 1048 {
        return 1 as i32
    }
    let s: i64 = schmal(999999, 29999, 99)
    zahl((0 - s) as u64)
    nl()
    if s != -3 {
        return 2 as i32
    }
    // a checked site in a loop, with the counter in a register
    var i: i64 = 0
    var acc: i64 = 0
    while i < 1000 {
        acc = acc + i * 3
        i = i + 1
    }
    zahl(acc as u64)
    nl()
    if acc != 1498500 {
        return 3 as i32
    }
    return 0 as i32
}
