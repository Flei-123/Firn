// TEMPO-3: der zweite heisse Kern -- Glyphen/Text-artige Schleife mit
// vielen kleinen Rechnungen und Feldzugriffen. Ziel: x86 gegen arm64.
#[no_gc]
fn summe_feld(p: u64, n: usize) -> u64 {
    var s: u64 = 0
    var i: usize = 0
    while i < n {
        let v: u32 = *((p + (i * 4) as u64) as *mut u32)
        let r: u32 = (v >> 16) & 255 as u32
        let g: u32 = (v >> 8) & 255 as u32
        let b: u32 = v & 255 as u32
        s = s + ((r * 77 + g * 151 + b * 28) >> 8) as u64
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    var f: [u32; 1024] = [0; 1024]
    var i: usize = 0
    while i < 1024 {
        f[i] = (i * 2654435761) as u32
        i = i + 1
    }
    var t: u64 = 0
    var k: usize = 0
    while k < 500 {
        t = t + summe_feld((&f[0]) as u64, 1024)
        k = k + 1
    }
    return (t & 127) as i32
}
