// TEMPO-3: der heisse Kern isoliert -- genau die Schleife aus
// blit.chrome_ueber, ohne Leinwand und ohne Fenster.
// Ziel: BEFEHLE zaehlen, x86_64 gegen aarch64.

#[no_gc]
fn div255(x: u32) -> u32 {
    return (x + 1 as u32 + (x >> 8)) >> 8
}

// wortgleich die innere Mischung aus lib/android/blit.fi
#[no_gc]
fn misch_zeile(z0: u64, q0: u64, n: i64) {
    var q: u64 = q0
    var z: u64 = z0
    var x: i64 = 0
    while x < n {
        let a: u32 = (*((q + 3) as *mut u8)) as u32
        if a == 255 as u32 {
            *(z as *mut u32) = *(q as *mut u32)
        } else if a != 0 as u32 {
            let inv: u32 = 255 as u32 - a
            let r0: u32 = (*(z as *mut u8)) as u32
            let g0: u32 = (*((z + 1) as *mut u8)) as u32
            let b0: u32 = (*((z + 2) as *mut u8)) as u32
            let r1: u32 = (*(q as *mut u8)) as u32
            let g1: u32 = (*((q + 1) as *mut u8)) as u32
            let b1: u32 = (*((q + 2) as *mut u8)) as u32
            *(z as *mut u8) = (r1 + div255(r0 * inv)) as u8
            *((z + 1) as *mut u8) = (g1 + div255(g0 * inv)) as u8
            *((z + 2) as *mut u8) = (b1 + div255(b0 * inv)) as u8
            *((z + 3) as *mut u8) = 255 as u8
        }
        q = q + 4
        z = z + 4
        x = x + 1
    }
}

fn main() -> i32 {
    // 1220 Spalten x 300 Zeilen, wie die Leiste auf Justins Geraet.
    let bw: i64 = 1220
    let bh: i64 = 8
    var ziel: [u32; 1220] = [0; 1220]
    var quelle: [u32; 1220] = [0; 1220]
    var i: usize = 0
    while i < 1220 {
        ziel[i] = 4278190080 as u32
        // Halbdeckend: zwingt den teuren Zweig, wie echter Text mit
        // Kantenglaettung.
        quelle[i] = 2155905152 as u32
        i = i + 1
    }
    var y: i64 = 0
    while y < bh {
        misch_zeile((&ziel[0]) as u64, (&quelle[0]) as u64, bw)
        y = y + 1
    }
    // Ergebnis ausgeben, damit nichts wegoptimiert wird.
    return (ziel[7] & 127 as u32) as i32
}
