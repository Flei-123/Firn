// tools/thread/stress.fi — DAUERLAUF MIT MEHREREN FAEDEN UND LAUFENDEM SAMMLER.
//
// Der Nachweis, den Runde 49 schuldig ist: mehrere Faeden allozieren
// gleichzeitig aus demselben GC-Heap, der Sammler laeuft dabei, und das ueber
// Minuten — ohne Absturz, ohne Speicherdrift, mit deterministischem Ergebnis.
//
// Jeder Faden baut in einer Endlosschleife eine Kette aus KETTE Gliedern mit
// vorhersagbaren Werten, RECHNET SIE NACH und verwirft sie wieder. Ein einziges
// faelschlich eingesammeltes Glied setzt das Fehlerwort — und das ist der
// eigentliche Punkt: der Sammler laeuft waehrenddessen, gefuehrt von einem
// BELIEBIGEN der Faeden, und muss trotzdem jeden anderen Stapel sehen.
//
// Zusaetzlich laeuft in jeder Runde ein Mutex-Abschnitt und ein rein atomarer
// Zaehler. Am Ende muessen beide exakt der Rundenzahl entsprechen; ein dritter
// Zaehler OHNE Sperre muss dagegen VERLOREN haben — sonst liefen die Faeden
// nicht wirklich gleichzeitig und der ganze Lauf belegt nichts.
//
// Ausgabe (eine Zeile je Stichprobe, TAB-getrennt):
//   S <t_ms> <rss_kib> <runden> <laeufe> <stw> <heap_bytes> <lebende> <stw_max_ns>
//   Q <code> <wert>   Schlusswerte
// Codes: 0 Fehlerwort · 1 Runden gesamt · 2 Mutexzaehler · 3 Atomzaehler ·
//        4 Zaehler ohne Sperre · 5 RSS am Ende · 6 Sammellaeufe · 7 STW-Laeufe
//        8 laengste Wartezeit bis die Welt stand (ns)
//        9 laengste Zeit mit stehender Welt (ns)
import meas

gc class Node {
    next: Gc[Node],
    value: u64,
}

// Von tools/thread/stress.sh umgestellt.
const BUDGET_MS: i64 = 20000  // STRESS_BUDGET_MS
const THREADS: u64 = 4         // STRESS_THREADS
const LOCAL: u64 = 0          // STRESS_LOCAL
const CHAIN: u64 = 200
const STICH_MS: u64 = 2000

const ST_SYS_MMAP: i64 = 9

const Z_STOPP: u64 = 0
const Z_MUTEX: u64 = 8
const Z_WITH: u64 = 16
const Z_ATOM: u64 = 24
const Z_WITHOUT: u64 = 32
const Z_ROUNDS: u64 = 40
const Z_ERROR: u64 = 48

fn page() -> u64 {
    let r: i64 = syscall(ST_SYS_MMAP, 0, 4096, 3, 34, -1, 0)
    if r < 0 {
        return 0
    }
    return r as u64
}

fn ld(a: u64, o: u64) -> u64 {
    return *((a + o) as *mut u64)
}

fn st(a: u64, o: u64, v: u64) {
    *((a + o) as *mut u64) = v
}

// Schlafen als BLOCKIERT — sonst wartet jedes Anhalten der Welt auf diesen
// Faden, bis er von selbst aufwacht (siehe thread_blockierend_an in gc.fi).
fn sleep_ms(ms: u64) {
    thread_sleep(ms)
}

fn chain_build(mark: u64) -> AllocError!Gc[Node] {
    var header: Gc[Node] = gc_null[Node]()
    var i: u64 = 0
    while i < CHAIN {
        let n: Gc[Node] = try gc Node{ next: header, value: mark + i }
        header = n
        i = i + 1
    }
    return header
}

fn chain_check(header: Gc[Node], mark: u64) -> bool {
    var p: Gc[Node] = header
    var i: u64 = CHAIN
    while i > 0 {
        i = i - 1
        if p == gc_null[Node]() {
            return false
        }
        if p.value != mark + i {
            return false
        }
        p = p.next
    }
    return true
}

fn round(arg: u64, mark: u64) -> AllocError!bool {
    let header: Gc[Node] = try chain_build(mark)
    if !chain_check(header, mark) {
        return false
    }
    thread_lock((arg + Z_MUTEX) as *mut u64)
    st(arg, Z_WITH, ld(arg, Z_WITH) + 1)
    thread_unlock((arg + Z_MUTEX) as *mut u64)
    __atomic_add((arg + Z_ATOM) as *mut u64, 1)
    // Gegenprobe: dieselbe Erhoehung OHNE Sperre und OHNE atomare
    // Instruktion, mit absichtlich weitem Fenster zwischen Lesen und
    // Schreiben. Sie MUSS verlieren — sonst liefen die Faeden nicht wirklich
    // gleichzeitig und der ganze Dauerlauf belegt nichts.
    let v: u64 = ld(arg, Z_WITHOUT)
    var d: u64 = 0
    while d < 64 {
        d = d + 1
    }
    st(arg, Z_WITHOUT, v + 1)
    __atomic_add((arg + Z_ROUNDS) as *mut u64, 1)
    return true
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    var rounds: u64 = 0
    while ld(arg, Z_STOPP) == 0 {
        let mark: u64 = kind * 1000000 + (rounds % 977) * 1000
        let ok: bool = round(arg, mark) catch false
        if !ok {
            __atomic_add((arg + Z_ERROR) as *mut u64, 1)
            return rounds
        }
        rounds = rounds + 1
        // Von Zeit zu Zeit einen vollen Lauf erzwingen — sonst sieht dieser
        // Dauerlauf fast nur inkrementelle Scheiben.
        if rounds % 512 == 0 {
            gc_collect()
        }
    }
    return rounds
}

fn q(code: u64, value: u64) {
    meas.meas_char(81)
    meas.meas_tab()
    meas.meas_u64(code)
    meas.meas_tab()
    meas.meas_u64(value)
    meas.meas_nl()
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    if !thread_init() {
        return 91
    }
    if LOCAL != 0 {
        gc_set_local(1)
    }
    let z: u64 = page()
    if z == 0 {
        return 92
    }
    var h: [u64; 16] = [0; 16]
    var i: u64 = 0
    while i < THREADS {
        h[i as usize] = thread_start(i + 1, z)
        if h[i as usize] == 0 {
            return 93
        }
        i = i + 1
    }

    let t0: u64 = meas.meas_now_ms()
    var t: u64 = 0
    while t < BUDGET_MS as u64 {
        sleep_ms(STICH_MS)
        thread_safepoint()
        t = meas.meas_now_ms() - t0
        meas.meas_char(83)
        meas.meas_tab()
        meas.meas_u64(t)
        meas.meas_tab()
        meas.meas_u64(meas.meas_rss_kib())
        meas.meas_tab()
        meas.meas_u64(ld(z, Z_ROUNDS))
        meas.meas_tab()
        meas.meas_u64(gc_collections())
        meas.meas_tab()
        meas.meas_u64(gc_stw_runs())
        meas.meas_tab()
        meas.meas_u64(gc_heap_bytes())
        meas.meas_tab()
        meas.meas_u64(gc_live_objects())
        meas.meas_tab()
        meas.meas_u64(gc_stw_wait_max())
        meas.meas_nl()
    }
    st(z, Z_STOPP, 1)

    var sum: u64 = 0
    i = 0
    while i < THREADS {
        sum = sum + thread_wait(h[i as usize])
        i = i + 1
    }
    q(0, ld(z, Z_ERROR))
    q(1, sum)
    q(2, ld(z, Z_WITH))
    q(3, ld(z, Z_ATOM))
    q(4, ld(z, Z_WITHOUT))
    q(5, meas.meas_rss_kib())
    q(6, gc_collections())
    q(7, gc_stw_runs())
    q(8, gc_stw_wait_max())
    q(9, gc_stw_work_max())
    if ld(z, Z_ERROR) != 0 {
        return 1
    }
    if sum != ld(z, Z_ROUNDS) {
        return 2
    }
    if ld(z, Z_WITH) != sum {
        return 3
    }
    if ld(z, Z_ATOM) != sum {
        return 4
    }
    if thread_count() != 1 {
        return 5
    }
    return 0
}
