// tools/pystr_cross/pystr_tool.fi -- command line face of std.pystr and regex.pyre
// for the cross-check against Python str / re (tools/pystr_cross/run.sh).
//
//   pystr_tool FILE   one op per line, TAB separated, every string argument as hex;
//                     lists as "N:hex,hex,..". One result line per op:
//                     string -> hex, list -> "N:hex,..", bool -> T/F, int -> decimal.
import std.io
import std.rt
import std.pystr
import std.str
import std.vec
import std.fs
import std.num
import regex.regex
import regex.pyre

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn field(line: str, k: usize) -> str {
    var start: usize = 0
    var idx: usize = 0
    var i: usize = 0
    while i <= line.n {
        if i == line.n || *(line.p + i) == 9 as u8 {
            if idx == k { return str { p: line.p + start, n: i - start } }
            idx = idx + 1
            start = i + 1
        }
        i = i + 1
    }
    return str { p: line.p, n: 0 }
}

fn hexval(c: u8) -> u8 {
    if c >= 97 as u8 { return c - 87 as u8 }
    return c - 48 as u8
}

fn unhex(h: str) -> str {
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i + 1 < h.n {
        rt.buf_push(&b, hexval(*(h.p + i)) * 16 as u8 + hexval(*(h.p + i + 1)))
        i = i + 2
    }
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

fn put_hex(b: *mut rt.Buf, s: str) {
    var i: usize = 0
    while i < s.n {
        rt.buf_push_hex_u64(b, (*(s.p + i)) as u64, 2)
        i = i + 1
    }
}

fn num_of(s: str) -> i64 {
    return num.parse_i64(str.span(s.p, s.length())).value
}

fn sarg(line: str, k: usize) -> str {
    return unhex(field(line, k))
}

fn list_in(line: str, k: usize, out: *mut Vec[str]) {
    vec_clear[str](out)
    let f: str = field(line, k)
    var i: usize = 0
    var cnt: usize = 0
    while i < f.n && *(f.p + i) != 58 as u8 {
        cnt = cnt * 10 + ((*(f.p + i)) - 48 as u8) as usize
        i = i + 1
    }
    i = i + 1
    if cnt == 0 { return }
    var start: usize = i
    while i <= f.n {
        if i >= f.n || *(f.p + i) == 44 as u8 {
            vec_push[str](out, unhex(str { p: f.p + start, n: i - start }))
            start = i + 1
        }
        i = i + 1
    }
}

fn emit(b: *mut rt.Buf) {
    rt.buf_push(b, 10 as u8)
    io.print_bytes(rt.buf_ptr(b), rt.buf_len(b))
    rt.buf_clear(b)
}

fn emit_str(s: str) {
    var b: rt.Buf = rt.buf_new()
    put_hex(&b, s)
    emit(&b)
    rt.buf_free(&b)
}

fn emit_list(v: *mut Vec[str]) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, vec_len[str](v) as u64)
    rt.buf_push(&b, 58 as u8)
    var i: usize = 0
    while i < vec_len[str](v) {
        if i > 0 { rt.buf_push(&b, 44 as u8) }
        put_hex(&b, *vec_elem_ptr[str](v, i))
        i = i + 1
    }
    emit(&b)
    rt.buf_free(&b)
}

fn emit_bool(x: bool) {
    if x { io.print_line("T") } else { io.print_line("F") }
}

fn emit_int(x: i64) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, x)
    emit(&b)
    rt.buf_free(&b)
}

fn compile(p: str) -> regex.Regex {
    return regex.regex_compile(p, 0 as u32) catch | e | (never())
}

fn never() -> regex.Regex {
    syscall(60, 99, 0, 0, 0, 0, 0)
    return never()
}

fn run_line(line: str) {
    let op: str = field(line, 0)
    var v: Vec[str] = vec_new[str]()
    if op == "lower" { emit_str(pystr.lower(sarg(line, 1))) }
    else if op == "upper" { emit_str(pystr.upper(sarg(line, 1))) }
    else if op == "capitalize" { emit_str(pystr.capitalize(sarg(line, 1))) }
    else if op == "title" { emit_str(pystr.title(sarg(line, 1))) }
    else if op == "swapcase" { emit_str(pystr.swapcase(sarg(line, 1))) }
    else if op == "strip" { emit_str(pystr.strip(sarg(line, 1))) }
    else if op == "lstrip" { emit_str(pystr.lstrip(sarg(line, 1))) }
    else if op == "rstrip" { emit_str(pystr.rstrip(sarg(line, 1))) }
    else if op == "strip_chars" { emit_str(pystr.strip_chars(sarg(line, 1), sarg(line, 2))) }
    else if op == "lstrip_chars" { emit_str(pystr.lstrip_chars(sarg(line, 1), sarg(line, 2))) }
    else if op == "rstrip_chars" { emit_str(pystr.rstrip_chars(sarg(line, 1), sarg(line, 2))) }
    else if op == "split" {
        pystr.split(sarg(line, 1), sarg(line, 2), &v)
        emit_list(&v)
    } else if op == "split_n" {
        pystr.split_n(sarg(line, 1), sarg(line, 2), num_of(field(line, 3)), &v)
        emit_list(&v)
    } else if op == "split_ws" {
        pystr.split_ws(sarg(line, 1), &v)
        emit_list(&v)
    } else if op == "splitlines" {
        pystr.splitlines(sarg(line, 1), &v)
        emit_list(&v)
    } else if op == "join" {
        list_in(line, 1, &v)
        emit_str(pystr.join(&v, sarg(line, 2)))
    } else if op == "sorted_set" {
        list_in(line, 1, &v)
        pystr.sorted_set(&v)
        emit_list(&v)
    } else if op == "replace" { emit_str(pystr.replace(sarg(line, 1), sarg(line, 2), sarg(line, 3))) }
    else if op == "replace_n" { emit_str(pystr.replace_n(sarg(line, 1), sarg(line, 2), sarg(line, 3), num_of(field(line, 4)))) }
    else if op == "repeat" { emit_str(pystr.repeat(sarg(line, 1), num_of(field(line, 2)) as usize)) }
    else if op == "startswith" { emit_bool(pystr.startswith(sarg(line, 1), sarg(line, 2))) }
    else if op == "endswith" { emit_bool(pystr.endswith(sarg(line, 1), sarg(line, 2))) }
    else if op == "contains" { emit_bool(pystr.contains(sarg(line, 1), sarg(line, 2))) }
    else if op == "count" { emit_int(pystr.count(sarg(line, 1), sarg(line, 2)) as i64) }
    else if op == "find" { emit_int(pystr.find(sarg(line, 1), sarg(line, 2))) }
    else if op == "rfind" { emit_int(pystr.rfind(sarg(line, 1), sarg(line, 2))) }
    else if op == "ljust" { emit_str(pystr.ljust(sarg(line, 1), num_of(field(line, 2)) as usize, (num_of(field(line, 3))) as u8)) }
    else if op == "rjust" { emit_str(pystr.rjust(sarg(line, 1), num_of(field(line, 2)) as usize, (num_of(field(line, 3))) as u8)) }
    else if op == "center" { emit_str(pystr.center(sarg(line, 1), num_of(field(line, 2)) as usize, (num_of(field(line, 3))) as u8)) }
    else if op == "zfill" { emit_str(pystr.zfill(sarg(line, 1), num_of(field(line, 2)) as usize)) }
    else if op == "isdigit" { emit_bool(pystr.isdigit(sarg(line, 1))) }
    else if op == "isalpha" { emit_bool(pystr.isalpha(sarg(line, 1))) }
    else if op == "isalnum" { emit_bool(pystr.isalnum(sarg(line, 1))) }
    else if op == "isspace" { emit_bool(pystr.isspace(sarg(line, 1))) }
    else if op == "isupper" { emit_bool(pystr.isupper(sarg(line, 1))) }
    else if op == "islower" { emit_bool(pystr.islower(sarg(line, 1))) }
    else if op == "isascii" { emit_bool(pystr.isascii(sarg(line, 1))) }
    else if op == "charlen" { emit_int(pystr.char_len(sarg(line, 1)) as i64) }
    else if op == "findall" {
        var r: regex.Regex = compile(sarg(line, 1))
        pyre.findall(&r, sarg(line, 2), &v)
        emit_list(&v)
        regex.regex_free(&r)
    } else if op == "sub" {
        var r: regex.Regex = compile(sarg(line, 1))
        emit_str(pyre.sub(&r, sarg(line, 2), sarg(line, 3)))
        regex.regex_free(&r)
    } else if op == "subn" {
        var r: regex.Regex = compile(sarg(line, 1))
        var n: usize = 0
        let t: str = pyre.subn(&r, sarg(line, 2), sarg(line, 3), &n)
        emit_int(n as i64)
        emit_str(t)
        regex.regex_free(&r)
    } else if op == "resplit" {
        var r: regex.Regex = compile(sarg(line, 1))
        pyre.split(&r, sarg(line, 2), &v)
        emit_list(&v)
        regex.regex_free(&r)
    } else if op == "escape" { emit_str(pyre.escape(sarg(line, 1))) }
    else if op == "span" {
        // search: "start,end" in octets, or -1
        var r: regex.Regex = compile(sarg(line, 1))
        var m: regex.Match = regex.match_new()
        let t: str = sarg(line, 2)
        if pyre.search(&r, t, &m) {
            var b: rt.Buf = rt.buf_new()
            rt.buf_push_dec_i64(&b, m.start as i64)
            rt.buf_push(&b, 44 as u8)
            rt.buf_push_dec_i64(&b, m.end as i64)
            emit(&b)
            rt.buf_free(&b)
        } else {
            io.print_line("-1")
        }
        regex.regex_free(&r)
    } else {
        io.print_line("?unknown")
    }
    vec_free[str](&v)
}

fn main(start: u64) -> i32 {
    if !gc_init() { return 1 }
    var b: rt.Buf = rt.buf_new()
    fs.read_file(arg(start, 1), &b) catch 0
    var pos: usize = 0
    let n: usize = rt.buf_len(&b)
    while pos < n {
        var e: usize = pos
        while e < n && rt.buf_at(&b, e) != (10 as u8) { e = e + 1 }
        run_line(str { p: ((rt.buf_ptr(&b)) + pos as u64) as *mut u8, n: e - pos })
        pos = e + 1
    }
    rt.buf_free(&b)
    return 0
}
