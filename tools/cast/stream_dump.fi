// SPDX-License-Identifier: MPL-2.0
import std.rt
import cast.h264enc
import cast.yuv
import cast.mpegts

const W: usize = 100
const H: usize = 62
const FRAMES: usize = 12

fn paint(pix: u64, frame: usize) {
    var y: usize = 0
    while y < H {
        var x: usize = 0
        while x < W {
            let o: usize = (y * W + x) * 4
            var r: u8 = ((x * 255) / W) as u8
            var g: u8 = ((y * 255) / H) as u8
            var b: u8 = 40 as u8
            let bx: usize = 6 + frame * 5
            if x >= bx && x < bx + 20 && y >= 10 && y < 30 {
                r = 250 as u8
                g = (frame * 20) as u8
                b = 10 as u8
            }
            rt.st8(pix, o, b)
            rt.st8(pix, o + 1, g)
            rt.st8(pix, o + 2, r)
            rt.st8(pix, o + 3, 255 as u8)
            x = x + 1
        }
        y = y + 1
    }
}

fn append_cropped(out: *mut rt.Buf, base: u64, stride: usize, w: usize, h: usize) {
    var y: usize = 0
    while y < h {
        rt.buf_push_bytes(out, base + (y * stride) as u64, w)
        y = y + 1
    }
}

#[allow_escape]
fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 4 { return 64 }
    var pix: rt.Buf = rt.buf_new()
    rt.buf_reserve(&pix, W * H * 4)
    rt.buf_set_len(&pix, W * H * 4)
    var e: h264enc.Enc = h264enc.enc_new(W, H, 30 as u32)
    h264enc.enc_set_idr_interval(&e, 8 as u32)
    var au: rt.Buf = rt.buf_new()
    var stream: rt.Buf = rt.buf_new()
    var raw: rt.Buf = rt.buf_new()
    var ts: rt.Buf = rt.buf_new()
    var mux: mpegts.TsMux = mpegts.tsmux_new()
    var f: usize = 0
    while f < FRAMES {
        paint(pix.ptr, f)
        h264enc.enc_encode(&e, pix.ptr, W * 4, yuv.PF_BGRA, &au)
        rt.buf_push_bytes(&stream, au.ptr, au.len)
        mpegts.tsmux_psi(&mux, &ts)
        mpegts.tsmux_video(&mux, au.ptr, au.len, (90000 + f * 3000) as u64, f == 0 || f == 8, &ts)
        append_cropped(&raw, e.prev.y.ptr, e.prev.w, W, H)
        append_cropped(&raw, e.prev.u.ptr, e.prev.cw, W / 2, H / 2)
        append_cropped(&raw, e.prev.v.ptr, e.prev.cw, W / 2, H / 2)
        f = f + 1
    }
    if !rt.write_file(rt.arg_ptr(start, 1), stream.ptr, stream.len) { return 1 }
    if !rt.write_file(rt.arg_ptr(start, 2), raw.ptr, raw.len) { return 2 }
    if !rt.write_file(rt.arg_ptr(start, 3), ts.ptr, ts.len) { return 3 }
    return 0
}
