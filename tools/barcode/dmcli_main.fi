// SPDX-License-Identifier: MPL-2.0
// tools/barcode/dmcli_main.fi -- Data Matrix command line for tools/barcode/run.sh.
//
//     dmcli enc <ascii|base256|rect|any> <hex>      prints "<rows> <cols>" then the rows as 0/1 text
//     dmcli dec <rows> <cols> <text of 0/1>         prints OK <hex of payload> <corrected> | FAIL
import barcode.bcutil
import barcode.dmtx
import std.rt

fn str_is(p: u64, s: str) -> bool {
    return rt.c_length(p) == s.n && rt.mem_eq(p, s.p as u64, s.n)
}

fn hexval(c: u8) -> u8 {
    if c >= 97 as u8 {
        return c - 87 as u8
    }
    return c - 48 as u8
}

fn main(start: u64) -> i32 {
    var out: rt.Buf = rt.buf_new()
    var code: i32 = 2
    if rt.arg_count(start) >= 4 {
        let cmd: u64 = rt.arg_ptr(start, 1)
        if str_is(cmd, "enc") {
            let kind: u64 = rt.arg_ptr(start, 2)
            let hx: u64 = rt.arg_ptr(start, 3)
            let hn: usize = rt.c_length(hx) / 2
            var data: rt.Buf = rt.buf_new()
            var i: usize = 0
            while i < hn {
                rt.buf_push(&data, (hexval(rt.ld8(hx, i * 2)) << 4 as u8) | hexval(rt.ld8(hx, i * 2 + 1)))
                i++
            }
            var mode: u32 = 0 as u32
            var shape: u32 = 0 as u32
            if str_is(kind, "base256") {
                mode = 1 as u32
            }
            if str_is(kind, "rect") {
                shape = 2 as u32
            }
            if str_is(kind, "any") {
                shape = 1 as u32
            }
            var m: rt.Buf = rt.buf_new()
            var rows: i64 = 0
            var cols: i64 = 0
            let ok: bool = dmtx.dmtx_encode(rt.buf_ptr(&data), hn, mode, shape, &m, &rows, &cols) catch false
            if ok {
                rt.buf_push_dec_i64(&out, rows)
                rt.buf_push(&out, 32 as u8)
                rt.buf_push_dec_i64(&out, cols)
                rt.buf_push(&out, 10 as u8)
                var r: i64 = 0
                while r < rows {
                    var c: i64 = 0
                    while c < cols {
                        if rt.buf_at(&m, (r * cols + c) as usize) != 0 as u8 {
                            rt.buf_push(&out, 49 as u8)
                        } else {
                            rt.buf_push(&out, 48 as u8)
                        }
                        c = c + 1
                    }
                    rt.buf_push(&out, 10 as u8)
                    r = r + 1
                }
                code = 0
            } else {
                rt.buf_push_bytes(&out, "FAIL\n".p as u64, 5)
                code = 1
            }
            rt.buf_free(&m)
            rt.buf_free(&data)
        }
        if str_is(cmd, "dec") && rt.arg_count(start) >= 5 {
            var rows: i64 = 0
            var cols: i64 = 0
            let a: u64 = rt.arg_ptr(start, 2)
            let b: u64 = rt.arg_ptr(start, 3)
            var i: usize = 0
            while i < rt.c_length(a) {
                rows = rows * 10 + (rt.ld8(a, i) as i64) - 48
                i++
            }
            i = 0
            while i < rt.c_length(b) {
                cols = cols * 10 + (rt.ld8(b, i) as i64) - 48
                i++
            }
            let t: u64 = rt.arg_ptr(start, 4)
            var mods: rt.Buf = rt.buf_new()
            i = 0
            while i < rt.c_length(t) {
                if rt.ld8(t, i) == 49 as u8 {
                    rt.buf_push(&mods, 1 as u8)
                } else {
                    rt.buf_push(&mods, 0 as u8)
                }
                i++
            }
            var res: rt.Buf = rt.buf_new()
            var fixed: i64 = 0
            if rt.buf_len(&mods) as i64 == rows * cols && dmtx.dmtx_decode_any(rt.buf_ptr(&mods), rows, cols, &res, &fixed) {
                rt.buf_push_bytes(&out, "OK ".p as u64, 3)
                var k: usize = 0
                while k < rt.buf_len(&res) {
                    let v: u8 = rt.buf_at(&res, k)
                    let hi: u8 = v >> 4 as u8
                    let lo: u8 = v & 15 as u8
                    if hi < 10 as u8 {
                        rt.buf_push(&out, 48 as u8 + hi)
                    } else {
                        rt.buf_push(&out, 87 as u8 + hi)
                    }
                    if lo < 10 as u8 {
                        rt.buf_push(&out, 48 as u8 + lo)
                    } else {
                        rt.buf_push(&out, 87 as u8 + lo)
                    }
                    k++
                }
                if rt.buf_len(&res) == 0 {
                    rt.buf_push(&out, 45 as u8)
                }
                rt.buf_push(&out, 32 as u8)
                rt.buf_push_dec_i64(&out, fixed)
                rt.buf_push(&out, 10 as u8)
                code = 0
            } else {
                rt.buf_push_bytes(&out, "FAIL\n".p as u64, 5)
                code = 1
            }
            rt.buf_free(&res)
            rt.buf_free(&mods)
        }
    }
    rt.write_everything(1, rt.buf_ptr(&out), rt.buf_len(&out))
    rt.buf_free(&out)
    return code
}
