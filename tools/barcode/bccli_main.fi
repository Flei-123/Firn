// SPDX-License-Identifier: MPL-2.0
// tools/barcode/bccli_main.fi -- command line of lib/barcode for tools/barcode/run.sh.
//
//     bccli enc <ean13|ean8|upca|code128|code39|code39c|itf> <text>   prints the module string (0/1)
//     bccli dec a.png b.png ...                           per file: <file> OK <kind> <hex of text> | <file> FAIL
import barcode.bcutil
import barcode.ean
import barcode.code128
import barcode.code39
import barcode.itf
import barcode.scan
import barcode.gray
import paint.png
import std.rt

fn out_str(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn hex_out(out: *mut rt.Buf, b: *mut rt.Buf) {
    var k: usize = 0
    while k < rt.buf_len(b) {
        let v: u8 = rt.buf_at(b, k)
        let hi: u8 = v >> 4 as u8
        let lo: u8 = v & 15 as u8
        if hi < 10 as u8 {
            rt.buf_push(out, 48 as u8 + hi)
        } else {
            rt.buf_push(out, 87 as u8 + hi)
        }
        if lo < 10 as u8 {
            rt.buf_push(out, 48 as u8 + lo)
        } else {
            rt.buf_push(out, 87 as u8 + lo)
        }
        k++
    }
    if rt.buf_len(b) == 0 {
        rt.buf_push(out, 45 as u8)
    }
}

fn str_is(p: u64, s: str) -> bool {
    return rt.c_length(p) == s.n && rt.mem_eq(p, s.p as u64, s.n)
}

fn enc(start: u64, out: *mut rt.Buf) -> i32 {
    if rt.arg_count(start) < 4 {
        return 2
    }
    let kind: u64 = rt.arg_ptr(start, 2)
    let tp: u64 = rt.arg_ptr(start, 3)
    let tn: usize = rt.c_length(tp)
    var m: rt.Buf = rt.buf_new()
    var ok: bool = false
    if str_is(kind, "ean13") {
        ok = ean.ean_encode(str { p: tp as *u8, n: tn }, bcutil.BC_EAN13, &m) catch false
    }
    if str_is(kind, "ean8") {
        ok = ean.ean_encode(str { p: tp as *u8, n: tn }, bcutil.BC_EAN8, &m) catch false
    }
    if str_is(kind, "upca") {
        ok = ean.ean_encode(str { p: tp as *u8, n: tn }, bcutil.BC_UPCA, &m) catch false
    }
    if str_is(kind, "code128") {
        ok = code128.code128_encode(tp, tn, 0 as u32, &m) catch false
    }
    if str_is(kind, "code39") {
        ok = code39.code39_encode(tp, tn, false, &m) catch false
    }
    if str_is(kind, "code39c") {
        ok = code39.code39_encode(tp, tn, true, &m) catch false
    }
    if str_is(kind, "itf") {
        ok = itf.itf_encode(str { p: tp as *u8, n: tn }, &m) catch false
    }
    if !ok {
        out_str(out, "FAIL\n")
        rt.buf_free(&m)
        return 1
    }
    bcutil.mods_to_text(&m, out)
    rt.buf_push(out, 10 as u8)
    rt.buf_free(&m)
    return 0
}

fn dec(start: u64, out: *mut rt.Buf) {
    var i: usize = 2
    while i < rt.arg_count(start) {
        let path: u64 = rt.arg_ptr(start, i)
        rt.buf_push_bytes(out, path, rt.c_length(path))
        rt.buf_push(out, 32 as u8)
        var data: rt.Buf = rt.buf_new()
        if !rt.read_file(path, &data) {
            out_str(out, "FAIL unreadable\n")
            i++
            continue
        }
        var im: png.Image = png.image_new()
        if !png.decode_png(rt.buf_ptr(&data), rt.buf_len(&data), &im) {
            out_str(out, "FAIL notpng\n")
            rt.buf_free(&data)
            i++
            continue
        }
        let w: usize = png.image_width(&im)
        let h: usize = png.image_height(&im)
        let g: u64 = gray.gray_from_rgba(im.px as u64, w, h)
        var res: bcutil.BcResult = bcutil.bc_result_new()
        if scan.bcscan_gray(g, w, h, &res) {
            out_str(out, "OK ")
            out_str(out, bcutil.bc_kind_name(res.kind))
            rt.buf_push(out, 32 as u8)
            hex_out(out, &res.text)
            rt.buf_push(out, 10 as u8)
        } else {
            out_str(out, "FAIL notfound\n")
        }
        bcutil.bc_result_free(&res)
        gray.gray_free(g, w, h)
        png.image_free(&im)
        rt.buf_free(&data)
        i++
    }
}

fn main(start: u64) -> i32 {
    var out: rt.Buf = rt.buf_new()
    var code: i32 = 2
    if rt.arg_count(start) >= 2 {
        let cmd: u64 = rt.arg_ptr(start, 1)
        if str_is(cmd, "enc") {
            code = enc(start, &out)
        }
        if str_is(cmd, "dec") {
            dec(start, &out)
            code = 0
        }
    }
    rt.write_everything(1, rt.buf_ptr(&out), rt.buf_len(&out))
    rt.buf_free(&out)
    return code
}
