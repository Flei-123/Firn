import strpool_mod

#[no_inline]
fn sink_main(s: str) -> i64 { return s.n as i64 }

#[no_inline]
fn first() -> i64 { return sink_main("shared literal across functions and modules") }

#[no_inline]
fn second() -> i64 {
    return sink_main("shared literal across functions and modules") + sink_main("unique tail literal")
}

fn main() -> i32 {
    let total: i64 = first() + second() + strpool_mod.third()
    if total > 0 {
        return 0
    }
    return 1
}
