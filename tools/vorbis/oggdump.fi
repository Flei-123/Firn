import std.rt
import std.io
import ton.ogg

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        io.print_line("usage: oggdump <file.ogg>")
        return 2
    }
    var source: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &source) {
        return 3
    }
    var rd: ogg.OggReader = ogg.ogg_new(rt.buf_ptr(&source), rt.buf_len(&source))
    var n: i64 = 0
    var bytes: i64 = 0
    var last_g: i64 = -1
    while ogg.ogg_next(&rd) == 1 {
        n = n + 1
        bytes = bytes + (ogg.ogg_pkt_len(&rd) as i64)
        if rd.granule >= 0 {
            last_g = rd.granule
        }
    }
    var z: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&z, n)
    rt.buf_push(&z, 32 as u8)
    rt.buf_push_dec_i64(&z, bytes)
    rt.buf_push(&z, 32 as u8)
    rt.buf_push_dec_i64(&z, last_g)
    rt.buf_push(&z, 32 as u8)
    rt.buf_push_dec_i64(&z, rd.pages as i64)
    rt.buf_push(&z, 32 as u8)
    rt.buf_push_dec_i64(&z, rd.lost as i64)
    rt.buf_push(&z, 10 as u8)
    io.print_bytes(rt.buf_ptr(&z), rt.buf_len(&z))
    return 0
}
