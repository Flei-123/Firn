// tools/vorbis/vorbis_main.fi -- driver: vorbis_main <in.ogg> <out.raw> [f32|i16]
// Prints "<rate> <channels> <frames> <bad_packets>".
import std.rt
import std.io
import ton.vorbis_file

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        io.print_line("usage: vorbis_main <in.ogg> <out.raw> [f32|i16]")
        return 2
    }
    var as_i16: bool = false
    if rt.arg_count(start) >= 4 {
        let m: u64 = rt.arg_ptr(start, 3)
        if *((m + 0) as *mut u8) == 105 {
            as_i16 = true
        }
    }
    var source: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &source) {
        io.print_line("input not readable")
        return 3
    }
    var pcm: rt.Buf = rt.buf_new()
    var info: vorbis_file.VfInfo = vorbis_file.vf_info()
    var st: i32 = 0
    if as_i16 {
        st = vorbis_file.vf_decode_i16(rt.buf_ptr(&source), rt.buf_len(&source), &pcm, &info)
    } else {
        st = vorbis_file.vf_decode_f32(rt.buf_ptr(&source), rt.buf_len(&source), &pcm, &info)
    }
    if st != 0 {
        var e: rt.Buf = rt.buf_new()
        rt.buf_push_dec_i64(&e, st as i64)
        rt.buf_push(&e, 10 as u8)
        io.print_bytes(rt.buf_ptr(&e), rt.buf_len(&e))
        return 5
    }
    if !rt.write_file(rt.arg_ptr(start, 2), rt.buf_ptr(&pcm), rt.buf_len(&pcm)) {
        return 4
    }
    var z: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&z, info.rate as i64)
    rt.buf_push(&z, 32 as u8)
    rt.buf_push_dec_i64(&z, info.channels as i64)
    rt.buf_push(&z, 32 as u8)
    rt.buf_push_dec_i64(&z, info.frames)
    rt.buf_push(&z, 32 as u8)
    rt.buf_push_dec_i64(&z, info.bad_packets as i64)
    rt.buf_push(&z, 10 as u8)
    io.print_bytes(rt.buf_ptr(&z), rt.buf_len(&z))
    return 0
}
