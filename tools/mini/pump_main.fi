// SPDX-License-Identifier: MPL-2.0
// tools/mini/pump_main.fi -- fui.looppump: a window (app.run) and an async.loop timer
// in ONE thread. Prints "TICK n" for three timer rounds that arrive with NO window
// event, then quits the window; exit 0. Run it under Xvfb (tools/mini/run.sh).
import std.rt
import async.loop
import fui.app
import fui.looppump

static mut ticks: i64 = 0
static mut label_id: usize = 0
static mut timer_h: u64 = 0

fn on_tick(l: *mut loop.Loop, ud: u64) {
    ticks = ticks + 1
    let a: *mut app.App = ud as *mut app.App
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, "TICK ".p as u64, 5)
    rt.buf_push_dec_i64(&b, ticks)
    rt.buf_push(&b, 10 as u8)
    rt.write_everything(1, b.ptr, b.len)
    app.set_text(a, label_id, str { p: b.ptr as *mut u8, n: b.len - 1 })
    rt.buf_free(&b)
    if ticks == 3 {
        loop.timer_cancel(l, timer_h)
        app.quit(a)
    }
}

#[allow_escape]
fn main() -> i32 {
    var l: loop.Loop = loop.loop_new()
    if !loop.loop_init(&l) {
        return 2
    }
    let a: *mut app.App = app.window("pump", 240, 120)
    label_id = app.label(a, "waiting", 16)
    looppump.attach(a, &l)
    timer_h = loop.timer_every(&l, 100, on_tick, a as u64)
    let rc: i32 = app.run(a)
    if ticks != 3 {
        return 3
    }
    return rc
}
