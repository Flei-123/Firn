// SPDX-License-Identifier: GPL-2.0-only
// tools/stdlib81/deflate_cli.fi -- the compressor and the decompressor of
// `lib/std/deflate.fi` as a program, so that `python3 -c "import zlib"`,
// `gzip` and `gunzip` can be put on the other end of every pipe
// (round 81).
//
//     deflate_cli <mode> <level> <in> <out>
//
// mode: rawc rawd zlibc zlibd gzipc gzipd
//
// The exit code is the whole diagnosis: 0 fine, 4 the input could not be
// read, 5 the operation failed, 6 the output could not be written. What
// went wrong exactly is decided on the OTHER side -- the point of this
// program is that somebody else judges its output.
import std.deflate
import std.rt
import std.io

fn eq_c(p: u64, lit: u64) -> bool {
    let a: usize = rt.c_length(p)
    let b: usize = rt.c_length(lit)
    if a != b {
        return false
    }
    return rt.mem_eq(p, lit, a)
}

fn dec_u64(p: u64) -> usize {
    var v: usize = 0
    var i: usize = 0
    let n: usize = rt.c_length(p)
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c >= 48 as u8 && c <= 57 as u8 {
            v = v * 10 + (c - 48 as u8) as usize
        }
        i = i + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 5 {
        var usage: [u8; 39] = "deflate_cli <mode> <level> <in> <out>\n\0"
        io.eprint_bytes((&usage[0]) as u64, 37)
        return 2
    }
    let mode: u64 = rt.arg_ptr(start, 1)
    let level: usize = dec_u64(rt.arg_ptr(start, 2))
    var src: rt.Buf = rt.buf_new()
    defer rt.buf_free(&src)
    if !rt.read_file(rt.arg_ptr(start, 3), &src) {
        return 4
    }
    var out: rt.Buf = rt.buf_new()
    defer rt.buf_free(&out)

    var m_rawc: [u8; 5] = "rawc\0"
    var m_rawd: [u8; 5] = "rawd\0"
    var m_zc: [u8; 6] = "zlibc\0"
    var m_zd: [u8; 6] = "zlibd\0"
    var m_gc: [u8; 6] = "gzipc\0"
    var m_gd: [u8; 6] = "gzipd\0"

    let p: u64 = rt.buf_ptr(&src)
    let n: usize = rt.buf_len(&src)
    let bad: usize = 18446744073709551615 as usize
    var r: usize = bad

    if eq_c(mode, (&m_rawc[0]) as u64) {
        r = deflate.deflate(p, n, level, &out) catch bad
    } else if eq_c(mode, (&m_rawd[0]) as u64) {
        r = deflate.inflate(p, n, &out) catch bad
    } else if eq_c(mode, (&m_zc[0]) as u64) {
        r = deflate.zlib_compress(p, n, level, &out) catch bad
    } else if eq_c(mode, (&m_zd[0]) as u64) {
        r = deflate.zlib_decompress(p, n, &out) catch bad
    } else if eq_c(mode, (&m_gc[0]) as u64) {
        r = deflate.gzip_compress(p, n, level, &out) catch bad
    } else if eq_c(mode, (&m_gd[0]) as u64) {
        r = deflate.gzip_decompress(p, n, &out) catch bad
    } else {
        return 3
    }
    if r == bad {
        return 5
    }
    if !rt.write_file(rt.arg_ptr(start, 4), rt.buf_ptr(&out), rt.buf_len(&out)) {
        return 6
    }
    return 0
}
