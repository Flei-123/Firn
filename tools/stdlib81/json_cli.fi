// SPDX-License-Identifier: GPL-2.0-only
// tools/stdlib81/json_cli.fi -- `lib/std/json.fi` as a program (round 81).
//
//     json_cli check   <in>            exit 0 = accepted, 1 = refused
//     json_cli format  <in> <out>      like `python3 -m json.tool`
//     json_cli compact <in> <out>      no blanks outside strings
//     json_cli build   <out>           a document written WITHOUT a tree
//
// `check` prints the refusal to stderr as `line:column: text`, which is
// what makes the error messages testable instead of a claim.
import std.json
import std.rt
import std.io

fn eq_c(p: u64, lit: u64) -> bool {
    let a: usize = rt.c_length(p)
    let b: usize = rt.c_length(lit)
    if a != b {
        return false
    }
    return rt.mem_eq(p, lit, a)
}

fn report(d: *mut json.Json) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, json.json_err_line(d) as u64)
    rt.buf_push(&b, 58 as u8)
    rt.buf_push_dec_u64(&b, json.json_err_col(d) as u64)
    rt.buf_push(&b, 58 as u8)
    rt.buf_push(&b, 32 as u8)
    json.json_err_text(d, &b)
    rt.buf_push(&b, 10 as u8)
    io.eprint_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

fn build(path: u64) -> i32 {
    var out: rt.Buf = rt.buf_new()
    defer rt.buf_free(&out)
    var w: json.JsonWriter = json.jw_new(&out, true)
    var k_name: [u8; 5] = "name\0"
    var k_ver: [u8; 8] = "version\0"
    var k_tags: [u8; 5] = "tags\0"
    var k_ok: [u8; 3] = "ok\0"
    var k_pi: [u8; 3] = "pi\0"
    var k_none: [u8; 5] = "none\0"
    var v_firn: [u8; 5] = "firn\0"
    var v_a: [u8; 7] = "a\"b\\c\n\0"
    var v_uni: [u8; 12] = "gr\u{fc}\u{df}e \u{20ac}\0"
    json.jw_begin_object(&w)
    json.jw_key_c(&w, (&k_name[0]) as u64)
    json.jw_string_c(&w, (&v_firn[0]) as u64)
    json.jw_key_c(&w, (&k_ver[0]) as u64)
    json.jw_int(&w, 81)
    json.jw_key_c(&w, (&k_pi[0]) as u64)
    json.jw_number(&w, 3.14159)
    json.jw_key_c(&w, (&k_ok[0]) as u64)
    json.jw_bool(&w, true)
    json.jw_key_c(&w, (&k_none[0]) as u64)
    json.jw_null(&w)
    json.jw_key_c(&w, (&k_tags[0]) as u64)
    json.jw_begin_array(&w)
    json.jw_string_c(&w, (&v_a[0]) as u64)
    json.jw_string_c(&w, (&v_uni[0]) as u64)
    json.jw_begin_object(&w)
    json.jw_key_c(&w, (&k_ver[0]) as u64)
    json.jw_int(&w, 0 - 7)
    json.jw_end(&w)
    json.jw_begin_array(&w)
    json.jw_end(&w)
    json.jw_end(&w)
    json.jw_end(&w)
    json.jw_free(&w)
    if !json.jw_ok(&w) {
        return 7
    }
    if !rt.write_file(path, rt.buf_ptr(&out), rt.buf_len(&out)) {
        return 6
    }
    return 0
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 2
    }
    let mode: u64 = rt.arg_ptr(start, 1)
    var m_check: [u8; 6] = "check\0"
    var m_format: [u8; 7] = "format\0"
    var m_compact: [u8; 8] = "compact\0"
    var m_build: [u8; 6] = "build\0"

    if eq_c(mode, (&m_build[0]) as u64) {
        return build(rt.arg_ptr(start, 2))
    }

    var src: rt.Buf = rt.buf_new()
    defer rt.buf_free(&src)
    if !rt.read_file(rt.arg_ptr(start, 2), &src) {
        return 4
    }
    var d: json.Json = json.json_new()
    defer json.json_free(&d)
    let ok: bool = json.json_parse(&d, rt.buf_ptr(&src), rt.buf_len(&src)) catch false
    if !ok {
        report(&d)
        return 1
    }
    if eq_c(mode, (&m_check[0]) as u64) {
        return 0
    }
    if rt.arg_count(start) < 4 {
        return 2
    }
    var out: rt.Buf = rt.buf_new()
    defer rt.buf_free(&out)
    if eq_c(mode, (&m_format[0]) as u64) {
        json.json_write_pretty(&d, json.json_root(&d), &out, 4, true)
        rt.buf_push(&out, 10 as u8)
    } else if eq_c(mode, (&m_compact[0]) as u64) {
        json.json_write(&d, json.json_root(&d), &out, true)
    } else {
        return 3
    }
    if !rt.write_file(rt.arg_ptr(start, 3), rt.buf_ptr(&out), rt.buf_len(&out)) {
        return 6
    }
    return 0
}
