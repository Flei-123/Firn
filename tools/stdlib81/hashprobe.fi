// SPDX-License-Identifier: GPL-2.0-only
// tools/stdlib81/hashprobe.fi -- the hash values of `lib/std/hash.fi` as
// text, so that another implementation can be held against them (round 81).
//
// One line per input, `<name> <fnv1a64> <xx64> <xx64 seed 12345>`, all in
// hex. `tools/stdlib81/hashvectors.py` compares them against the published
// vectors of both functions and, if the module is installed, against
// `python-xxhash` -- the reference implementation by the author of the
// algorithm.
//
// The inputs are chosen to hit every path of `xx64` at once: nothing (the
// seed and the avalanche alone), 1 to 7 octets (the single octet tail), 8
// (the 8 octet tail), 12 (8 + 4), 31 (below the stripe threshold), 32
// (exactly one stripe), 33 (one stripe plus one octet) and 200 (several
// stripes plus a tail).
import std.hash
import std.rt
import std.io

fn line(o: *mut rt.Buf, name: u64, p: u64, n: usize) {
    rt.buf_push_bytes(o, name, rt.c_length(name))
    rt.buf_push(o, 32 as u8)
    rt.buf_push_hex_u64(o, hash.fnv1a64(p, n), 16)
    rt.buf_push(o, 32 as u8)
    rt.buf_push_hex_u64(o, hash.xx64(p, n), 16)
    rt.buf_push(o, 32 as u8)
    rt.buf_push_hex_u64(o, hash.xx64_seed(p, n, 12345), 16)
    rt.buf_push(o, 10 as u8)
}

fn main() -> i32 {
    var o: rt.Buf = rt.buf_new()
    defer rt.buf_free(&o)

    var empty: [u8; 1] = "\0"
    var a: [u8; 2] = "a\0"
    var foobar: [u8; 7] = "foobar\0"
    var n_empty: [u8; 6] = "empty\0"
    var n_a: [u8; 2] = "a\0"
    var n_foobar: [u8; 7] = "foobar\0"
    line(&o, (&n_empty[0]) as u64, (&empty[0]) as u64, 0)
    line(&o, (&n_a[0]) as u64, (&a[0]) as u64, 1)
    line(&o, (&n_foobar[0]) as u64, (&foobar[0]) as u64, 6)

    // The counting sequence 0x41, 0x42, ... -- the same octets the Python
    // side builds, so the comparison needs no file.
    var buf: [u8; 256] = [0; 256]
    var i: usize = 0
    while i < 256 {
        // ROUND 83: the counting sequence runs past 255 and is MEANT to
        // start over -- `& 255` says so; `as u8` would (correctly) abort.
        buf[i] = ((i + 65) & 255) as u8
        i = i + 1
    }
    var lens: [usize; 8] = [7, 8, 12, 31, 32, 33, 64, 200]
    var namebuf: [u8; 7] = "len000\0"
    i = 0
    while i < 8 {
        let n: usize = lens[i]
        namebuf[3] = (48 + (n / 100)) as u8
        namebuf[4] = (48 + ((n / 10) % 10)) as u8
        namebuf[5] = (48 + (n % 10)) as u8
        line(&o, (&namebuf[0]) as u64, (&buf[0]) as u64, n)
        i = i + 1
    }
    io.print_bytes(rt.buf_ptr(&o), rt.buf_len(&o))
    return 0
}
