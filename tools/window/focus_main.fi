import std.rt
import window.window

fn now_ms() -> i64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0] * 1000 + ts[1] / 1000000
}

static mut failed: i32 = 0

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn check(ok: bool, what: str) {
    if ok {
        say("ok   ")
    } else {
        say("FAIL ")
        failed = failed + 1
    }
    say(what)
    say("\n")
}

fn say_num(n: u64) {
    var digits: [u8; 24] = [0 as u8; 24]
    var i: usize = 24
    var v: u64 = n
    if v == 0 as u64 {
        i = i - 1
        digits[i] = 48 as u8
    }
    while v > 0 as u64 {
        i = i - 1
        digits[i] = (48 as u64 + v % 10 as u64) as u8
        v = v / 10 as u64
    }
    syscall(1, 1, (&digits[i]) as i64, (24 - i) as i64, 0, 0, 0)
}

fn count(w: *mut window.Window, ins: *mut i32, outs: *mut i32, ms: i64) {
    window.wait_event(w, ms)
    var k: u32 = window.next_event(w)
    while k != window.EV_NONE {
        if k == window.EV_FOCUS {
            if window.ev_a(w) == 1 as u32 {
                *ins = *ins + 1
            } else {
                *outs = *outs + 1
            }
        }
        k = window.next_event(w)
    }
}

fn main() -> i32 {
    var a: window.Window = window.window_new()
    var b: window.Window = window.window_new()
    if !window.open_window(&a, 0) || !window.open_window(&b, 0) {
        say("SKIP: no X server\n")
        return 0 as i32
    }
    check(window.focus_events(&a, true), "focus_events accepted")
    check(window.make(&a, 200, 100), "make a")
    check(window.make(&b, 200, 100), "make b")
    window.show_window(&a)
    window.show_window(&b)
    window.fill(&a, 16777215 as u32, 0, 0, 200, 100)
    window.fill(&b, 16777215 as u32, 0, 0, 200, 100)
    window.present(&a)
    window.present(&b)
    say("H ")
    say_num(window.native_handle(&a))
    say(" ")
    say_num(window.native_handle(&b))
    say("\n")
    var a_in: i32 = 0
    var a_out: i32 = 0
    var b_in: i32 = 0
    var b_out: i32 = 0
    let t0: i64 = now_ms()
    while now_ms() - t0 < 5000 {
        count(&a, &a_in, &a_out, 50)
        count(&b, &b_in, &b_out, 50)
    }
    check(a_in >= 2, "switch on: focus in delivered")
    check(a_out >= 1, "switch on: focus out delivered")
    check(b_in == 0 && b_out == 0, "switch off: no focus events")
    window.close_window(&a)
    window.close_window(&b)
    if failed == 0 {
        say("FOCUS PASSED\n")
    }
    return failed as i32
}
