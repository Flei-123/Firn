import std.rt
import std.time
import window.window

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn offer(w: *mut window.Window, mime: str, path_ptr: u64) -> bool {
    var data: rt.Buf = rt.buf_new()
    if !rt.read_file(path_ptr, &data) {
        return false
    }
    return window.clip_set_mime(w, mime, rt.buf_ptr(&data), rt.buf_len(&data))
}

fn fetch_to(w: *mut window.Window, mime: str, path_ptr: u64) {
    var out: rt.Buf = rt.buf_new()
    rt.buf_clear(&out)
    if window.clip_get_mime(w, mime, &out) {
        rt.write_file(path_ptr, rt.buf_ptr(&out), rt.buf_len(&out))
    }
    rt.buf_free(&out)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 6 {
        return 2
    }
    var w: window.Window = window.window_new()
    if !window.open_window(&w, 0) {
        say("NODISPLAY\n")
        return 1
    }
    if !window.make(&w, 200, 100) {
        return 3
    }
    window.wait_event(&w, 0)
    let mode: str = arg(start, 1)
    if mode == "serve" {
        window.clip_clear(&w)
        let ok: bool = offer(&w, "text/plain;charset=utf-8", rt.arg_ptr(start, 2))
            && offer(&w, "text/html", rt.arg_ptr(start, 3))
            && offer(&w, "image/png", rt.arg_ptr(start, 4))
        if !ok {
            say("SETFAIL\n")
            return 4
        }
        say("READY\n")
        let t0: u64 = time.monotonic_ns()
        while time.monotonic_ns() - t0 < 25000000000 as u64 {
            window.wait_event(&w, 50)
            var k: u32 = 0
            while k < 1000 as u32 && window.next_event(&w) != window.EV_NONE {
                k = k + 1 as u32
            }
        }
        return 0
    }
    var ty: rt.Buf = rt.buf_new()
    window.clip_types(&w, &ty)
    rt.write_file(rt.arg_ptr(start, 2), rt.buf_ptr(&ty), rt.buf_len(&ty))
    fetch_to(&w, "text/plain;charset=utf-8", rt.arg_ptr(start, 3))
    fetch_to(&w, "text/html", rt.arg_ptr(start, 4))
    fetch_to(&w, "image/png", rt.arg_ptr(start, 5))
    say("DONE\n")
    return 0
}
