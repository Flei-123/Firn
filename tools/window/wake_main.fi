import std.rt
import window.window

fn now_ms() -> i64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0] * 1000 + ts[1] / 1000000
}

static mut failed: i32 = 0

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn check(ok: bool, what: str) {
    if ok {
        say("ok   ")
    } else {
        say("FAIL ")
        failed = failed + 1
    }
    say(what)
    say("\n")
}

fn main() -> i32 {
    var w: window.Window = window.window_new()
    if !window.open_window(&w, 0) {
        say("SKIP: no X server\n")
        return 0 as i32
    }
    check(window.make(&w, 200, 100), "make")
    var n: i32 = 0
    while window.wait_event(&w, 300) && n < 500 {
        window.next_event(&w)
        n = n + 1
    }

    let t0: i64 = now_ms()
    let r0: bool = window.wait_event(&w, 150)
    let d0: i64 = now_ms() - t0
    check(!r0 && d0 >= 140, "no wake fd: waits the full time")

    let efd: i64 = syscall(284, 0, 2048, 0, 0, 0, 0)
    check(efd >= 0, "eventfd")
    window.set_wake_fd(&w, efd as i32)
    var one: [u64; 1] = [1 as u64; 1]
    syscall(1, efd, (&one[0]) as i64, 8, 0, 0, 0)
    let t1: i64 = now_ms()
    let r1: bool = window.wait_event(&w, 5000)
    let d1: i64 = now_ms() - t1
    check(r1 && d1 < 500, "wake fd written: wait ends at once")

    let t2: i64 = now_ms()
    let r2: bool = window.wait_event(&w, 150)
    let d2: i64 = now_ms() - t2
    check(!r2 && d2 >= 140, "counter drained: next wait is a real wait")

    window.set_wake_fd(&w, 0 - 1)
    syscall(1, efd, (&one[0]) as i64, 8, 0, 0, 0)
    let t3: i64 = now_ms()
    let r3: bool = window.wait_event(&w, 150)
    let d3: i64 = now_ms() - t3
    check(!r3 && d3 >= 140, "wake fd removed: write is ignored")

    syscall(3, efd, 0, 0, 0, 0, 0)
    window.close_window(&w)
    if failed == 0 {
        say("WAKE PASSED\n")
    }
    return failed as i32
}
