// tools/window/extras_wine_probe.fi -- the Win32 half of lib/window/extras.fi, run under Wine by extras_wine.sh
// (or on a real Windows machine). Prints "ok" or the failed checks to standard error; exit code = failures.
import std.rt
import window.window
import window.extras

static mut failures: i32 = 0

fn say(s: str) {
    syscall(1, 2, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn ck(cond: bool, name: str) {
    if !cond {
        failures = failures + 1
        say("  FAIL  ")
        say(name)
        say("\n")
    }
}

fn pump(f: *mut window.Window, ms: i64) {
    window.wait_event(f, ms)
    var n: i32 = 0
    while window.next_event(f) != window.EV_NONE && n < 500 {
        n = n + 1
    }
}

fn wait_height(f: *mut window.Window, h: usize) -> bool {
    var i: i32 = 0
    while i < 100 {
        pump(f, 20)
        if window.height(f) == h {
            return true
        }
        i = i + 1
    }
    return false
}

fn main() -> i32 {
    var f: window.Window = window.window_new()
    ck(window.open_window(&f, 0), "open")
    ck(window.make(&f, 240, 120), "make")
    ck(window.show_window(&f), "show")
    pump(&f, 100)
    ck(!extras.is_topmost(&f), "not topmost at start")
    ck(extras.set_topmost(&f, true), "set_topmost")
    ck(extras.is_topmost(&f), "is_topmost")
    ck(extras.set_topmost(&f, false), "topmost off")
    ck(!extras.is_topmost(&f), "not topmost after off")
    ck(extras.set_topmost(&f, true), "topmost on again")
    ck(extras.is_visible(&f), "visible")
    ck(extras.hide(&f), "hide")
    ck(!extras.is_visible(&f), "hidden")
    ck(extras.show(&f), "show again")
    ck(extras.is_visible(&f), "visible again")
    ck(extras.is_topmost(&f), "topmost survives hide/show")
    ck(extras.set_frameless(&f, true), "frameless")
    pump(&f, 100)
    var o: extras.Rect = extras.Rect { x: 0, y: 0, w: 0, h: 0 }
    ck(extras.outer_rect(&f, &o), "outer_rect")
    ck(o.w == 240 && o.h == 120, "frameless: outer = client")
    var wa: extras.Rect = extras.Rect { x: 0, y: 0, w: 0, h: 0 }
    ck(extras.work_area(&f, &wa), "work_area")
    ck(wa.w > 0 && wa.h > 0, "work area size")
    ck(extras.place_corner(&f, extras.CORNER_BR, 10), "place_corner BR")
    pump(&f, 100)
    ck(extras.outer_rect(&f, &o), "outer_rect 2")
    ck(o.x + o.w == wa.x + wa.w - 10 && o.y + o.h == wa.y + wa.h - 10, "window sits bottom right")
    ck(extras.fit_height(&f, extras.CORNER_BR, 10, 200, 60, 400), "fit_height 200")
    ck(wait_height(&f, 200), "height 200")
    ck(extras.outer_rect(&f, &o) && o.y + o.h == wa.y + wa.h - 10, "bottom edge stayed")
    ck(extras.fit_height(&f, extras.CORNER_BR, 10, 9000, 60, 400), "fit_height max")
    ck(wait_height(&f, 400), "clamped to 400")
    ck(extras.set_frameless(&f, false), "frame back")
    pump(&f, 100)
    ck(extras.outer_rect(&f, &o) && (o.h > 400 || o.w > 240), "frame is part of the outer rect again")
    // RegisterHotKey is a stub-like call in Wine 8 (it refuses every combination here): NOT counted as a failure.
    // On a real Windows machine this must say "hotkey: registered".
    if extras.hotkey_set(&f, 3, window.HK_CTRL | window.HK_ALT, 74) {
        say("  hotkey: registered\n")
        ck(extras.hotkey_clear(&f, 3), "hotkey_clear")
        ck(!extras.hotkey_clear(&f, 3), "clear twice = false")
    } else {
        say("  note: hotkey_set refused (Wine 8 does not implement RegisterHotKey) -- Win32 hotkey path not verified\n")
    }
    ck(!extras.hotkey_set(&f, 4, 0 as u32, 0 as u32), "unknown key refused")
    window.close_window(&f)
    if failures == 0 {
        say("ok: window extras (Win32)\n")
    }
    return failures
}
