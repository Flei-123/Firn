// SPDX-License-Identifier: MPL-2.0
// tools/dialog/fontdlg_live_main.fi -- driver of tools/dialog/fontdlg_live.py: ONE font dialog per run, the
// answer on standard output.
//
//     fontdlg_live_main [family] [size]
//
// Output: `STATUS <ok|canceled|nowindow>`, then `VALUE family=<name> size=<n> bold=<0|1> italic=<0|1>
// underline=<0|1> strike=<0|1>` when the user chose. FUI_FONT_DIRS (colon separated) replaces the font folders.
import std.rt
import fui.fontdlg

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn num(s: str) -> i32 {
    var v: i32 = 0
    var i: usize = 0
    while i < s.n && rt.ld8(s.p as u64, i) >= 48 as u8 && rt.ld8(s.p as u64, i) <= 57 as u8 {
        v = v * 10 + (rt.ld8(s.p as u64, i) - 48 as u8) as i32
        i = i + 1
    }
    return v
}

fn flag(b: bool) -> str {
    if b {
        return "1"
    }
    return "0"
}

fn main(start: u64) -> i32 {
    var family: str = "DejaVu Sans"
    var size: i32 = 12
    if rt.arg_count(start) > 1 {
        family = arg(start, 1)
    }
    if rt.arg_count(start) > 2 {
        size = num(arg(start, 2))
    }
    var fam: rt.Buf = rt.buf_new()
    var pick: fontdlg.FontPick = fontdlg.pick_new()
    let rc: i32 = fontdlg.run("Choose a font", family, size, &fam, &pick)
    if rc == 12 {
        say("STATUS nowindow\n")
        return 0
    }
    if rc != 0 {
        say("STATUS canceled\n")
        return 0
    }
    say("STATUS ok\n")
    say("VALUE family=")
    rt.write_everything(1, rt.buf_ptr(&fam), rt.buf_len(&fam))
    say(" size=")
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, pick.size as i64)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    say(" bold=")
    say(flag(pick.bold))
    say(" italic=")
    say(flag(pick.italic))
    say(" underline=")
    say(flag(pick.underline))
    say(" strike=")
    say(flag(pick.strike))
    say("\n")
    return 0
}
