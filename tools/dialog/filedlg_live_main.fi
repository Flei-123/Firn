// tools/dialog/filedlg_live_main.fi -- driver of the live check of lib/fui/filedlg.fi (filedlg_live.py).
//
//     filedlg_live_main <mode 0..3> [directory] [name] [filters]
//
// Opens the file dialog (fUi window), waits, and prints on standard output:
//     STATUS ok | canceled | failed
//     VALUE <the paths, LF separated>          (only after ok)
import std.rt
import fui.filedlg

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn main(start: u64) -> i32 {
    var mode: i32 = 0
    if rt.arg_count(start) > 1 {
        let m: str = arg(start, 1)
        if m.n > 0 {
            mode = (rt.ld8(m.p as u64, 0) - (48 as u8)) as i32
        }
    }
    var dirp: str = ""
    var name: str = ""
    var filters: str = ""
    if rt.arg_count(start) > 2 { dirp = arg(start, 2) }
    if rt.arg_count(start) > 3 { name = arg(start, 3) }
    if rt.arg_count(start) > 4 { filters = arg(start, 4) }
    var out: rt.Buf = rt.buf_new()
    let rc: i32 = filedlg.run(mode, "dlg-file", dirp, name, filters, &out)
    if rc == 0 {
        say("STATUS ok\nVALUE ")
        rt.write_everything(1, rt.buf_ptr(&out), rt.buf_len(&out))
        say("\n")
        return 0
    }
    if rc == 1 {
        say("STATUS canceled\n")
        return 0
    }
    say("STATUS failed\n")
    return 1
}
