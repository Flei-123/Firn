// SPDX-License-Identifier: MPL-2.0
// tools/dialog/webdialog_probe.fi -- a page for tools/dialog/check_webdialog.cjs: std.dialog, std.toast and
// lib/plat/webdialog.fi against a real Chromium. Keys drive it:
//   m  message box (OK)         y  confirm (Yes / No)        3  Yes / No / Cancel (no such box in a page)
//   f  open_file (no path in a browser: NO_BACKEND)
//   c  ask for a colour         l  ask for files (.txt, several)
//   n  show a notification
// Answers go to localStorage: "dlg" (the synchronous ones), "dlg_ev" = "<q>|<data>|<status>|<id>" (WE_DIALOG),
// "note" (the notification's number), "note_ev" (click / close).
import std.rt
import std.str
import std.dialog
import std.toast
import plat.web
import plat.webdialog

fn store(key: str, s: str) {
    web.web_store_set(key.p as u64, key.n, s.p as u64, s.n)
}

fn paint(ud: u64, w: *mut web.Web) -> bool {
    return true
}

fn event(ud: u64, w: *mut web.Web, e: *mut web.WebEvent) -> bool {
    if (*e).kind == web.WE_KEY && (*e).status == 1 as u32 && (*e).n == 1 {
        let k: u8 = rt.ld8((*e).p, 0)
        var a: i32 = 0
        if k == 109 as u8 {
            let r: i32 = dialog.message(dialog.KIND_INFO, "T", "hello", dialog.BTNS_OK, &a)
            if r == dialog.OK && a == dialog.ANS_OK { store("dlg", "msg-ok") } else { store("dlg", "msg-other") }
        }
        if k == 121 as u8 {
            var yes: bool = false
            let r: i32 = dialog.confirm("T", "sure?", &yes)
            if r == dialog.OK && yes {
                store("dlg", "yes")
            } else if r == dialog.OK {
                store("dlg", "no")
            } else {
                store("dlg", "none")
            }
        }
        if k == 51 as u8 {
            let r: i32 = dialog.message(dialog.KIND_INFO, "T", "x", dialog.BTNS_YES_NO_CANCEL, &a)
            if r == dialog.NO_BACKEND { store("dlg", "ynca-nobackend") } else { store("dlg", "ynca-other") }
        }
        if k == 102 as u8 {
            var b: rt.Buf = rt.buf_new()
            let r: i32 = dialog.open_file("t", "", "", &b)
            if r == dialog.NO_BACKEND { store("dlg", "file-nobackend") } else { store("dlg", "file-other") }
            rt.buf_free(&b)
        }
        if k == 99 as u8 {
            webdialog.web_dialog_color("t", 0x1BD96A as u32)
        }
        if k == 108 as u8 {
            webdialog.web_dialog_file(".txt", true)
        }
        if k == 110 as u8 {
            let id: u32 = toast.show("Hello", "from Firn")
            var v: rt.Buf = rt.buf_new()
            rt.buf_push_dec_u64(&v, id as u64)
            store("note", str { p: rt.buf_data(&v), n: rt.buf_len(&v) })
            rt.buf_free(&v)
        }
        return false
    }
    if (*e).kind == web.WE_DIALOG {
        var b: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&b, (*e).q, (*e).qn)
        rt.buf_push(&b, 124 as u8)
        rt.buf_push_bytes(&b, (*e).p, (*e).n)
        rt.buf_push(&b, 124 as u8)
        rt.buf_push_dec_u64(&b, (*e).status as u64)
        rt.buf_push(&b, 124 as u8)
        rt.buf_push_dec_u64(&b, (*e).id as u64)
        store("dlg_ev", str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
        rt.buf_free(&b)
        var te: toast.Event = toast.Event { kind: 0 as u32, id: 0 as u32, reason: 0 as u32 }
        if toast.from_web_event(e, &te) {
            if te.kind == toast.EV_ACTION { store("note_ev", "click") } else { store("note_ev", "close") }
        }
        return false
    }
    return (*e).kind == web.WE_RESIZE
}

fn main() -> i32 {
    if !web.web_app(0, paint, event) {
        return 1
    }
    return 0
}
