// SPDX-License-Identifier: MPL-2.0
// tools/dialog/msgdlg_live_main.fi -- the driver of tools/dialog/msgdlg_live.py: ONE message box per run,
// the result on standard output.
//
//     msgdlg_live <kind 0..3> <buttons 0..3> <title> <text> [dark|light]
//
// Output: `RESULT <rc> <answer>` (rc 0 = a button decided, 1 = dismissed, 12 = no window; answer 1 ok,
// 2 cancel, 3 yes, 4 no), then `CLIP <text>` is NOT printed: the clipboard is read by the script.
import std.rt
import fui.msgdlg

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn num(s: str) -> i32 {
    var v: i32 = 0
    var i: usize = 0
    while i < s.n && rt.ld8(s.p as u64, i) >= 48 as u8 && rt.ld8(s.p as u64, i) <= 57 as u8 {
        v = v * 10 + (rt.ld8(s.p as u64, i) - 48 as u8) as i32
        i = i + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 5 {
        say("usage: msgdlg_live <kind> <buttons> <title> <text>\n")
        return 2
    }
    var ans: i32 = 0
    let rc: i32 = msgdlg.run(num(arg(start, 1)), arg(start, 3), arg(start, 4), num(arg(start, 2)), &ans)
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, "RESULT ".p as u64, 7)
    rt.buf_push_dec_i64(&b, rc as i64)
    rt.buf_push(&b, 32 as u8)
    rt.buf_push_dec_i64(&b, ans as i64)
    rt.buf_push(&b, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    return 0
}
