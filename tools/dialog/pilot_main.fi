// SPDX-License-Identifier: MPL-2.0
// tools/dialog/pilot_main.fi -- the "user" of a Windows dialog (dialog_check_win.py): a second program that looks the
// dialog of ANOTHER process up by its title and presses its buttons with window messages, the way a person would.
//
//     pilot.exe <window title> <steps>
//
// `steps` are separated by `;`:  wait (until the window exists, 20 s)   sleep:<ms>   cmd:<id> (a WM_COMMAND for the
// control <id>: 1 = OK, 2 = Cancel, 6 = Yes, 7 = No)   text:<id>:<text> (WM_SETTEXT of the control <id>)
//   list (print the controls found: id and class, for finding the right ids)
// Exit code 0 = all steps done, 3 = the window never came.
import std.rt
import std.str
import std.cmdline

extern fn FindWindowW(cls: u64, title: u64) -> i64;
extern fn GetDlgItem(hwnd: i64, id: i64) -> i64;
extern fn SendMessageW(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64;
extern fn PostMessageW(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i32;

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn number(s: str, from: usize, to: usize) -> i64 {
    var v: i64 = 0
    var i: usize = from
    while i < to && s.chars(i) >= 48 as u8 && s.chars(i) <= 57 as u8 {
        v = v * 10 + (s.chars(i) - 48 as u8) as i64
        i = i + 1
    }
    return v
}

fn find(title: str) -> i64 {
    var cls: [u16; 7] = u"#32770\0"
    var t: rt.Buf = rt.buf_new()
    cmdline.utf8_to_utf16(title.p as u64, title.length(), &t)
    cmdline.push_u16(&t, 0 as u16)
    var h: i64 = 0
    var tries: i32 = 0
    while h == 0 && tries < 200 {
        h = FindWindowW((&cls[0]) as u64, rt.buf_ptr(&t))
        if h == 0 {
            Sleep(100)
        }
        tries = tries + 1
    }
    rt.buf_free(&t)
    return h
}

fn step(h: i64, st: str) {
    if st == "wait" {
        return
    }
    if st.length() > 6 && st.chars(0) == 115 as u8 && st.chars(5) == 58 as u8 { // sleep:<ms>
        Sleep(number(st, 6, st.length()))
        return
    }
    if st.length() > 4 && st.chars(0) == 99 as u8 && st.chars(3) == 58 as u8 { // cmd:<id>
        PostMessageW(h, 273, number(st, 4, st.length()), 0) // WM_COMMAND
        return
    }
    if st.length() > 5 && st.chars(0) == 116 as u8 && st.chars(4) == 58 as u8 { // text:<id>:<text>
        var i: usize = 5
        while i < st.length() && st.chars(i) != 58 as u8 {
            i = i + 1
        }
        let id: i64 = number(st, 5, i)
        var w: rt.Buf = rt.buf_new()
        cmdline.utf8_to_utf16(((st.p as u64) + (i + 1) as u64), st.length() - i - 1, &w)
        cmdline.push_u16(&w, 0 as u16)
        let c: i64 = GetDlgItem(h, id)
        if c == 0 {
            say("NOCONTROL\n")
        } else {
            SendMessageW(c, 12, 0, rt.buf_ptr(&w) as i64) // WM_SETTEXT
        }
        rt.buf_free(&w)
    }
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        say("usage: pilot <window title> <steps>\n")
        return 2
    }
    let title: str = arg(start, 1)
    let steps: str = arg(start, 2)
    let h: i64 = find(title)
    if h == 0 {
        say("NOWINDOW\n")
        return 3
    }
    var from: usize = 0
    var i: usize = 0
    while i <= steps.length() {
        if i == steps.length() || steps.chars(i) == 59 as u8 {
            step(h, str { p: ((steps.p as u64) + from as u64) as *mut u8, n: i - from })
            from = i + 1
        }
        i = i + 1
    }
    return 0
}
