// SPDX-License-Identifier: MPL-2.0
// tools/dialog/dialog_main.fi -- driver of the real dialog checks (dialog_check.py on Linux against dialogd,
// dialog_check_win.py under Wine against comdlg32): ONE dialog per run, the answer on standard output.
//
//     dialog_main <mode> [directory] [name]
//
//   info | confirm | okcancel | ynca        message boxes
//   open | open_multi | save | folder       files (directory = where it starts, name = the suggested name for `save`)
//   color [rrggbb]                          a colour, starting at rrggbb (default 1bd96a)
//   font                                    a font
//
// Output: `STATUS <ok|canceled|no backend|failed>`, then `VALUE <what the dialog gave>` when it was OK.
import std.rt
import std.str
import std.dialog

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn status(r: i32) {
    say("STATUS ")
    say(dialog.status_name(r))
    say("\n")
}

fn value_buf(b: *mut rt.Buf) {
    say("VALUE ")
    syscall(1, 1, rt.buf_ptr(b) as i64, rt.buf_len(b) as i64, 0, 0, 0)
    say("\n")
}

fn answer_name(a: i32) -> str {
    if a == dialog.ANS_OK { return "ok" }
    if a == dialog.ANS_CANCEL { return "cancel" }
    if a == dialog.ANS_YES { return "yes" }
    if a == dialog.ANS_NO { return "no" }
    return "?"
}

fn hex_value(s: str) -> u32 {
    var v: u32 = 0 as u32
    var i: usize = 0
    while i < s.length() {
        let c: u8 = s.chars(i)
        var d: u32 = 0 as u32
        if c >= 48 as u8 && c <= 57 as u8 {
            d = (c - 48 as u8) as u32
        } else if c >= 97 as u8 && c <= 102 as u8 {
            d = (c - 97 as u8) as u32 + 10 as u32
        } else if c >= 65 as u8 && c <= 70 as u8 {
            d = (c - 65 as u8) as u32 + 10 as u32
        }
        v = (v << 4) | d
        i = i + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        say("usage: dialog_main <mode> [directory] [name]\n")
        return 2
    }
    let mode: str = arg(start, 1)
    var dirp: str = ""
    var name: str = ""
    if rt.arg_count(start) > 2 { dirp = arg(start, 2) }
    if rt.arg_count(start) > 3 { name = arg(start, 3) }
    var out: rt.Buf = rt.buf_new()
    var a: i32 = 0
    var r: i32 = dialog.FAILED
    if mode == "info" || mode == "confirm" || mode == "okcancel" || mode == "ynca" {
        if mode == "info" {
            r = dialog.message(dialog.KIND_INFO, "dlg-info", "Done.", dialog.BTNS_OK, &a)
        } else if mode == "confirm" {
            var yes: bool = false
            r = dialog.confirm("dlg-confirm", "Delete 3 files?", &yes)
            if r == dialog.OK {
                status(r)
                say("VALUE ")
                if yes { say("yes\n") } else { say("no\n") }
                return 0
            }
        } else if mode == "okcancel" {
            r = dialog.message(dialog.KIND_WARNING, "dlg-okcancel", "Continue?", dialog.BTNS_OK_CANCEL, &a)
        } else {
            r = dialog.message(dialog.KIND_QUESTION, "dlg-ynca", "Save the changes?", dialog.BTNS_YES_NO_CANCEL, &a)
        }
        status(r)
        if r == dialog.OK {
            say("VALUE ")
            say(answer_name(a))
            say("\n")
        }
        return 0
    }
    if mode == "open" {
        r = dialog.open_file("dlg-open", dirp, "Pictures|*.png;*.jpg|All files|*", &out)
    } else if mode == "open_multi" {
        r = dialog.open_files("dlg-multi", dirp, "", &out)
    } else if mode == "save" {
        r = dialog.save_file("dlg-save", dirp, name, "Text|*.txt", &out)
    } else if mode == "folder" {
        r = dialog.pick_folder("dlg-folder", dirp, &out)
    } else if mode == "color" {
        var rgb: u32 = 0x1BD96A as u32
        if dirp.length() > 0 {
            rgb = hex_value(dirp)
        }
        r = dialog.pick_color("dlg-color", rgb, &rgb)
        status(r)
        if r == dialog.OK {
            rt.buf_push_hex_u64(&out, rgb as u64, 6)
            value_buf(&out)
        }
        rt.buf_free(&out)
        return 0
    } else if mode == "font" {
        var f: dialog.FontChoice = dialog.FontChoice { size: 0 as u32, bold: false, italic: false }
        r = dialog.pick_font("dlg-font", "Sans", 12 as u32, &out, &f)
        status(r)
        if r == dialog.OK {
            say("VALUE ")
            syscall(1, 1, rt.buf_ptr(&out) as i64, rt.buf_len(&out) as i64, 0, 0, 0)
            var d: rt.Buf = rt.buf_new()
            rt.buf_push(&d, 124 as u8)
            rt.buf_push_dec_u64(&d, f.size as u64)
            rt.buf_push(&d, 124 as u8)
            if f.bold { rt.buf_push(&d, 98 as u8) }
            if f.italic { rt.buf_push(&d, 105 as u8) }
            rt.buf_push(&d, 10 as u8)
            syscall(1, 1, rt.buf_ptr(&d) as i64, rt.buf_len(&d) as i64, 0, 0, 0)
            rt.buf_free(&d)
        }
        rt.buf_free(&out)
        return 0
    } else {
        say("unknown mode\n")
        return 2
    }
    status(r)
    if r == dialog.OK {
        value_buf(&out)
    }
    rt.buf_free(&out)
    return 0
}
