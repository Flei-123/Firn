// SPDX-License-Identifier: MPL-2.0
// tools/dialog/colordlg_live_main.fi -- driver of the real colour dialog (colordlg_live.py): ONE
// dialog per run, the answer on standard output.
//
//     colordlg_live_main [rrggbb] [title]
//
// A real fUi window (lib/fui/colordlg.fi through colordlg.run) on the display. Output as in
// tools/dialog/dialog_main.fi: `STATUS ok` and `VALUE rrggbb` when the user chose, `STATUS canceled`
// when they cancelled or closed the window, `STATUS failed` when no window could be opened.
import std.rt
import std.str
import fui.colordlg

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn main(start: u64) -> i32 {
    var rgb: u32 = 0x1BD96A as u32
    var title: str = "dlg-color"
    if rt.arg_count(start) > 1 {
        if !colordlg.parse_hex(arg(start, 1), &rgb) {
            say("usage: colordlg_live_main [rrggbb] [title]\n")
            return 2
        }
    }
    if rt.arg_count(start) > 2 {
        title = arg(start, 2)
    }
    var out: u32 = 0 as u32
    let rc: i32 = colordlg.run(title, rgb, &out)
    if rc == 0 {
        say("STATUS ok\n")
        var h: [u8; 7] = [0 as u8; 7]
        colordlg.hex_of(out, &h)
        var i: usize = 1
        while i < 7 {
            if h[i] >= 65 as u8 && h[i] <= 70 as u8 {
                h[i] = h[i] + 32 as u8
            }
            i = i + 1
        }
        say("VALUE ")
        syscall(1, 1, (&h[1]) as i64, 6, 0, 0, 0)
        say("\n")
        return 0
    }
    if rc == 1 {
        say("STATUS canceled\n")
        return 0
    }
    say("STATUS failed\n")
    return 1
}
