// tools/dialog/toast_main.fi -- driver for the std.toast test (toast_check.py): a notification with every option, a
// replacement, a close, then the events as a callback (dispatch) and as a poll.
import std.rt
import std.io
import std.str
import std.toast

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn num(v: i64) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, v)
    io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

fn clicked(ud: u64, id: u32, key: str) {
    say("ACTION ")
    num(id as i64)
    say(" ")
    say(key)
    say(" ud=")
    num(ud as i64)
    say("\n")
}

fn main(start: u64) -> i32 {
    var o: toast.Options = toast.options()
    if !toast.open("Firn toast test") {
        say("READY no\n")
        say("ID ")
        num(toast.show("x", "y") as i64)
        say("\n")
        var ev0: toast.Event = toast.Event { kind: 0 as u32, id: 0 as u32, reason: 0 as u32 }
        if toast.poll(0, &ev0) || toast.close(1 as u32) {
            say("UNEXPECTED event\n")
        }
        toast.shutdown()
        return 0
    }
    say("READY yes\n")
    var name: rt.Buf = rt.buf_new()
    toast.server_name(&name)
    say("SERVER ")
    io.print_bytes(rt.buf_ptr(&name), rt.buf_len(&name))
    say("\n")
    var caps: rt.Buf = rt.buf_new()
    say("CAPS ")
    num(toast.capabilities(&caps) as i64)
    say("\n")
    o.icon = "emblem-downloads"
    o.actions = "default\nOpen\nopen\nShow file\n"
    o.category = "transfer.complete"
    o.urgency = toast.URGENCY_CRITICAL
    o.timeout_ms = 7000
    let id: u32 = toast.send("Download finished", "mod.jar, 4.2 MiB \u{e4}\u{f6}", &o)
    say("ID ")
    num(id as i64)
    say("\n")
    var o2: toast.Options = toast.options()
    o2.replaces = id
    o2.timeout_ms = toast.TIMEOUT_NEVER
    let id2: u32 = toast.send("Download finished (2)", "again", &o2)
    say("ID2 ")
    num(id2 as i64)
    say("\n")
    say("CLOSE ")
    if toast.close(id2) { say("ok\n") } else { say("fail\n") }
    say("GO\n")
    // events: the close by call and the click arrive through dispatch (the callback sees the click), then the dismissal by poll
    var seen: u32 = 0
    var quiet: u32 = 0
    while seen < 2 && quiet < 10 {
        if toast.dispatch(1000, clicked, 42 as u64) {
            seen = seen + 1
            quiet = 0
        } else {
            quiet = quiet + 1
        }
    }
    var ev: toast.Event = toast.Event { kind: 0 as u32, id: 0 as u32, reason: 0 as u32 }
    quiet = 0
    while quiet < 10 {
        if toast.poll(1000, &ev) {
            say("EVENT ")
            num(ev.kind as i64)
            say(" ")
            num(ev.id as i64)
            say(" ")
            num(ev.reason as i64)
            say("\n")
            if ev.kind == toast.EV_CLOSED && ev.reason == toast.CLOSED_DISMISSED {
                break
            }
        } else {
            quiet = quiet + 1
        }
    }
    toast.shutdown()
    say("DONE\n")
    return 0
}
