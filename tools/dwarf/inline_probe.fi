// expect_exit: 101
// tools/dwarf/inline_probe.fi -- the program that made round 94 necessary.
//
// `add_one` is small enough for the optimizer to embed it in `main`
// (`inline.rs`). Its addition overflows, so at every build level with
// checked arithmetic the program stops with the panic message the COMPILER
// built at lowering time -- and that message names the position of the
// addition in THIS file, not the position of the caller.
//
// That message is the yardstick `tools/dwarf/run.sh` holds the line table
// against: whatever the debugger says about the address of that addition has
// to be the same place. Before round 94 the two disagreed as soon as the
// optimizer ran: `gdb` said line 24 (the `fn main` line, the only thing an
// optimized build carried) while the message said line 20.
//
// The starting value comes out of a `static mut` on purpose. As a literal
// the whole calculation folds away at `release-fast` and there would be
// nothing left to attribute.
static mut SEED: i32 = 2147483646

fn add_one(x: i32) -> i32 {
    var y: i32 = x
    y = y + 1 as i32
    return y
}

fn plus_two(x: i32) -> i32 {
    return add_one(add_one(x))
}

fn main() -> i32 {
    var a: i32 = SEED
    let b: i32 = plus_two(a)
    return b
}
