// expect_exit: 38
// tools/dwarf/probe.fi -- the program the gdb session in tools/dwarf/run.sh
// walks through. It contains exactly the shapes the debug information has to
// carry: parameters, local variables, a struct with members, a pointer, an
// array and a nested call.
struct Point {
    x: i32,
    y: i32,
}

fn shift(p: *mut Point, by: i32) -> i32 {
    (*p).x = (*p).x + by
    (*p).y = (*p).y + by
    return (*p).x + (*p).y
}

fn total(n: i32) -> i32 {
    var sum: i32 = 0
    var field: [i32; 4] = [1, 2, 3, 4]
    var k: i32 = 0
    while k < 4 as i32 {
        sum = sum + field[k as usize]
        k = k + 1 as i32
    }
    return sum + n
}

fn main() -> i32 {
    var p: Point = Point { x: 5, y: 7 }
    let moved: i32 = shift(&p, 3)
    let flag: bool = moved > 10 as i32
    let big: u64 = 1234567890
    let sum: i32 = total(2)
    if flag {
        return moved + sum + 8 as i32
    }
    return big as i32
}
