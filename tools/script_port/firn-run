#!/bin/sh
# firn-run -- PROTOTYPE of "firn run": compile a .fi script once, cache the
# executable by content hash, run it.   Use as:  #!/usr/bin/env firn-run
#   firn-run script.fi [args...]
# The shebang line is blanked (the lexer does not know '#!'; line numbers stay).
set -e
src=$1; shift
: "${FIRNC:=$(dirname "$0")/../../compiler/target/release/firnc}"
: "${FIRNLIB:=$(dirname "$0")/../../lib}"
export FIRNLIB
cache=${FIRN_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/firn-run}
mkdir -p "$cache"
key=$( (cat "$src"; echo "$FIRNC"; "$FIRNC" --version) | sha256sum | cut -c1-32)
exe=$cache/$key
if [ ! -x "$exe" ]; then
    tmp=$(mktemp -d "$cache/build.XXXXXX")
    trap 'rm -rf "$tmp"' EXIT
    sed '1s/^#!.*$//' "$src" > "$tmp/$(basename "$src")"
    "$FIRNC" -o "$tmp/exe" "$tmp/$(basename "$src")"
    mv "$tmp/exe" "$exe"
    rm -rf "$tmp"
    trap - EXIT
fi
exec "$exe" "$@"
