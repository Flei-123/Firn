// tools/script_port/pngdiff.fi -- PROTOTYPE of the PIL + numpy part of
// OpenPlan's tools/web/webcheck.py: decode two PNG files and count the pixels
// whose colour differs (webcheck.py `diff()`: (a != b).any(axis=2).sum()).
//
//     pngdiff a.png b.png      prints "<differing pixels>" ; -1 = sizes differ
import std.rt
import std.str
import std.fs
import paint.png

fn load(path: str, im: *mut png.Image) -> bool {
    var data: rt.Buf = rt.buf_new()
    fs.read_file(path, &data) catch 0
    let ok: bool = png.decode_png(rt.buf_ptr(&data), rt.buf_len(&data), im)
    rt.buf_free(&data)
    return ok
}

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 2
    }
    var a: png.Image = png.image_new()
    var b: png.Image = png.image_new()
    if !load(arg(start, 1), &a) || !load(arg(start, 2), &b) {
        return 3
    }
    var diff: i64 = -1
    if png.image_width(&a) == png.image_width(&b) && png.image_height(&a) == png.image_height(&b) {
        diff = 0
        var y: usize = 0
        while y < png.image_height(&a) {
            var x: usize = 0
            while x < png.image_width(&a) {
                // RGB only, like convert("RGB")
                if (png.image_pixel(&a, x, y) & 16777215) != (png.image_pixel(&b, x, y) & 16777215) {
                    diff = diff + 1
                }
                x = x + 1
            }
            y = y + 1
        }
    }
    var out: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&out, diff)
    rt.buf_push(&out, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&out), rt.buf_len(&out))
    rt.buf_free(&out)
    png.image_free(&a)
    png.image_free(&b)
    return 0
}
