// tools/extfn/callback.fi -- direction 2: a foreign (C) caller reaches
// INTO Firn via '#[export_c]'. The function keeps its bare Firn name, so
// the linker symbol and the C-side 'extern' declaration match.
//
// 'main' here is a placeholder every Firn program needs (14.8) -- it is
// never called; run.sh localizes '_start'/'main' before linking against
// tools/extfn/host.c so that host.c's own 'main' is the one that runs.
#[export_c]
fn add_one(x: i64) -> i64 {
    return x + 1
}

fn main() -> i32 {
    return 0
}
