// tools/extfn/linkname.fi -- '#[link_name(...)]' overrides the linker
// symbol when the Firn name and the foreign one are meant to differ.
#[link_name(strlen)]
extern fn my_strlen(p: u64) -> u64;

fn main() -> i32 {
    let buf: [u8; 4] = [104, 105, 33, 0]
    let p: u64 = (&buf[0]) as u64
    let n: u64 = my_strlen(p)
    return n as i32
}
