// tools/extfn/callout.fi -- direction 1: Firn calls out to a foreign
// function via 'extern fn'. Linked against tools/extfn/impl.s (a
// hand-written strlen), NOT against libc, so the proof does not
// secretly lean on the system's C library.
extern fn strlen(p: u64) -> u64;

fn main() -> i32 {
    let buf: [u8; 6] = [104, 101, 108, 108, 111, 0]
    let p: u64 = (&buf[0]) as u64
    let n: u64 = strlen(p)
    return n as i32
}
