// SPDX-License-Identifier: MPL-2.0
// expect_exit: 0
// tools/windows/timeout.fi -- a receive timeout must look the same on both systems: recv() that times out
// answers EAGAIN (-11) on Linux; the Winsock seam has to translate WSAETIMEDOUT (10060) to the same number.
// A server that never answers; SO_RCVTIMEO = 300 ms; prints `RECV <result>` (expected: RECV -11).
// Nothing imported: raw syscalls only, like tools/windows/net.fi.

const SYS_WRITE: i64 = 1
const SYS_CLOSE: i64 = 3
const SYS_SOCKET: i64 = 41
const SYS_CONNECT: i64 = 42
const SYS_SENDTO: i64 = 44
const SYS_RECVFROM: i64 = 45
const SYS_SETSOCKOPT: i64 = 54

const AF_INET: i64 = 2
const SOCK_STREAM: i64 = 1
const SOL_SOCKET: i64 = 1
const SO_RCVTIMEO: i64 = 20

fn ld8(p: u64, i: i64) -> i64 {
    let q: *mut u8 = ((p as i64) + i) as *mut u8
    return (*q) as i64
}

fn ld64(p: u64, i: i64) -> i64 {
    let q: *mut i64 = ((p as i64) + i * 8) as *mut i64
    return *q
}

fn ch(c: i64) {
    var b: [u8; 1] = [0; 1]
    b[0] = c as u8
    syscall(SYS_WRITE, 1, (&b[0]) as i64, 1, 0, 0, 0)
}

fn num(v: i64) {
    if v < 0 {
        ch(45)
        num(0 - v)
        return
    }
    if v >= 10 {
        num(v / 10)
    }
    ch(48 + (v % 10))
}

fn port_of(start: u64) -> i64 {
    if start == 0 { return 0 }
    if ld64(start, 0) < 2 { return 0 }
    let p: u64 = ld64(start, 2) as u64
    var v: i64 = 0
    var i: i64 = 0
    while true {
        let c: i64 = ld8(p, i)
        if c < 48 || c > 57 { break }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    let port: i64 = port_of(start)
    if port == 0 { return 2 }
    let fd: i64 = syscall(SYS_SOCKET, AF_INET, SOCK_STREAM, 0, 0, 0, 0)
    if fd < 0 { return 3 }
    var sa: [u8; 16] = [0; 16]
    sa[0] = AF_INET as u8
    sa[2] = (port / 256) as u8
    sa[3] = (port % 256) as u8
    sa[4] = 127
    sa[7] = 1
    if syscall(SYS_CONNECT, fd, (&sa[0]) as i64, 16, 0, 0, 0) < 0 { return 4 }
    // struct timeval { tv_sec, tv_usec } = 0 s + 300000 us
    var tv: [i64; 2] = [0; 2]
    tv[1] = 300000
    if syscall(SYS_SETSOCKOPT, fd, SOL_SOCKET, SO_RCVTIMEO, (&tv[0]) as i64, 16, 0) < 0 { return 5 }
    var buf: [u8; 64] = [0; 64]
    let n: i64 = syscall(SYS_RECVFROM, fd, (&buf[0]) as i64, 64, 0, 0, 0)
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    var tag: [u8; 5] = [82, 69, 67, 86, 32]
    syscall(SYS_WRITE, 1, (&tag[0]) as i64, 5, 0, 0, 0)
    num(n)
    ch(10)
    return 0
}
