// SPDX-License-Identifier: GPL-2.0-only
// expect_exit: 0
// tools/windows/seam.fi -- ROUND MERGE-WIN: WHAT THE SEAM REALLY ANSWERS.
//
// One line per system call number:
//
//     <number> <return value>
//
// On Linux those are the Linux calls. On Windows the same numbers go
// through `compiler/src/win_seam.rs`, and everything that has no Windows
// equivalent there answers -38 (ENOSYS). Running this program on both
// operating systems and putting the two lists side by side gives a MEASURED
// table of what the seam carries and where it stops -- instead of a list
// read out of the source.
//
// Only calls WITHOUT a side effect are in here. `fork`(57), `execve`(59),
// `clone`(56), `unlink`(87) and `exit_group`(231) are deliberately absent:
// probing them would change the machine, and what they do is already
// measured by tests/700_process_start and tests/860..862 through
// tools/windows/run.sh.
//
// Nothing is imported. No std, no allocator, no collector -- so the file
// measures the seam and nothing else.

fn out(p: u64, n: i64) {
    syscall(1, 1, p as i64, n, 0, 0, 0)
}

fn ch(c: i64) {
    var b: [u8; 1] = [0; 1]
    b[0] = c as u8
    out((&b[0]) as u64, 1)
}

fn digits(v: i64) {
    if v >= 10 {
        digits(v / 10)
    }
    ch(48 + (v % 10))
}

fn num(v: i64) {
    if v < 0 {
        ch(45)
        digits(0 - v)
    } else {
        digits(v)
    }
}

// `<nr> <ret>\n`
fn line(nr: i64, ret: i64) {
    num(nr)
    ch(32)
    num(ret)
    ch(10)
}

fn main(start: u64) -> i32 {
    // A path that exists in the repository root and is opened relative --
    // an absolute Linux path does not survive the crossing (2.3 of
    // docs/ROUND-WINDOWS.md), and a relative one measures the seam and not
    // Wine's Z: drive.
    var path: [u8; 10] = "README.md\0"
    let pp: i64 = (&path[0]) as i64

    var buf: [u8; 512] = [0; 512]
    let bp: i64 = (&buf[0]) as i64

    // ---- files -----------------------------------------------------------
    let fd: i64 = syscall(2, pp, 0, 0, 0, 0, 0) // open(O_RDONLY)
    line(2, fd)
    if fd >= 0 {
        line(0, syscall(0, fd, bp, 16, 0, 0, 0)) // read
        line(8, syscall(8, fd, 0, 2, 0, 0, 0)) // lseek(SEEK_END)
        line(3, syscall(3, fd, 0, 0, 0, 0, 0)) // close
    }
    let fd2: i64 = syscall(257, 0 - 100, pp, 0, 0, 0, 0) // openat(AT_FDCWD)
    line(257, fd2)
    if fd2 >= 0 {
        syscall(3, fd2, 0, 0, 0, 0, 0)
    }
    line(21, syscall(21, pp, 0, 0, 0, 0, 0)) // access(F_OK)
    line(74, syscall(74, 1, 0, 0, 0, 0, 0)) // fsync(stdout)
    line(79, syscall(79, bp, 256, 0, 0, 0, 0)) // getcwd
    line(4, syscall(4, pp, bp, 0, 0, 0, 0)) // stat
    line(5, syscall(5, 0 - 1, bp, 0, 0, 0, 0)) // fstat(bad fd)
    line(77, syscall(77, 0 - 1, 0, 0, 0, 0, 0)) // ftruncate(bad fd)
    line(89, syscall(89, pp, bp, 256, 0, 0, 0)) // readlink
    line(217, syscall(217, 0 - 1, bp, 256, 0, 0, 0)) // getdents64(bad fd)

    // ---- descriptors -----------------------------------------------------
    let d: i64 = syscall(32, 1, 0, 0, 0, 0, 0) // dup(stdout)
    line(32, d)
    if d >= 0 {
        syscall(3, d, 0, 0, 0, 0, 0)
    }
    line(72, syscall(72, 1, 1, 0, 0, 0, 0)) // fcntl(F_GETFD)
    line(16, syscall(16, 0 - 1, 0, 0, 0, 0, 0)) // ioctl(bad fd)
    line(7, syscall(7, 0, 0, 0, 0, 0, 0)) // poll(no fds)

    // ---- memory ----------------------------------------------------------
    let m: i64 = syscall(9, 0, 4096, 3, 34, 0 - 1, 0) // mmap anon rw
    if m > 0 {
        line(9, 1)
        line(10, syscall(10, m, 4096, 1, 0, 0, 0)) // mprotect r
        line(11, syscall(11, m, 4096, 0, 0, 0, 0)) // munmap
    } else {
        line(9, m)
    }

    // ---- process, time, chance -------------------------------------------
    let pid: i64 = syscall(39, 0, 0, 0, 0, 0, 0) // getpid
    if pid > 0 {
        line(39, 1)
    } else {
        line(39, pid)
    }
    let tid: i64 = syscall(186, 0, 0, 0, 0, 0, 0) // gettid
    if tid > 0 {
        line(186, 1)
    } else {
        line(186, tid)
    }
    line(24, syscall(24, 0, 0, 0, 0, 0, 0)) // sched_yield
    var ts: [i64; 2] = [0; 2]
    line(35, syscall(35, (&ts[0]) as i64, 0, 0, 0, 0, 0)) // nanosleep 0s
    let ck: i64 = syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0) // clock_gettime
    line(228, ck)
    line(318, syscall(318, bp, 8, 0, 0, 0, 0)) // getrandom
    line(61, syscall(61, 0 - 1, 0, 1, 0, 0, 0)) // wait4(WNOHANG)
    var fw: [i64; 1] = [0; 1]
    line(202, syscall(202, (&fw[0]) as i64, 129, 0, 0, 0, 0)) // futex WAKE

    // ---- sockets ---------------------------------------------------------
    let s: i64 = syscall(41, 2, 1, 0, 0, 0, 0) // socket(AF_INET)
    if s >= 0 {
        line(41, 1)
        var sa: [u8; 16] = [0; 16]
        sa[0] = 2
        line(49, syscall(49, s, (&sa[0]) as i64, 16, 0, 0, 0)) // bind
        line(50, syscall(50, s, 1, 0, 0, 0, 0)) // listen
        var alen: [i64; 1] = [16; 1]
        line(51, syscall(51, s, (&sa[0]) as i64, (&alen[0]) as i64, 0, 0, 0))
        var one: [i64; 1] = [1; 1]
        line(54, syscall(54, s, 1, 2, (&one[0]) as i64, 8, 0)) // setsockopt
        line(48, syscall(48, s, 2, 0, 0, 0, 0)) // shutdown
        syscall(3, s, 0, 0, 0, 0, 0)
    } else {
        line(41, s)
    }
    line(288, syscall(288, 0 - 1, 0, 0, 0, 0, 0)) // accept4(bad fd)
    return 0
}
