// SPDX-License-Identifier: MPL-2.0
// tools/windows/thread_exit_race.fi -- the smallest program that shows a
// Wine-only artefact of the Windows threads (round PROCESS): one thread that
// returns 7, joined, then the process ends. Under Wine about 1 run in 100 is
// killed by SIGKILL (the shell sees 137, Python -9) AFTER everything was done;
// `bash tools/windows/thread_exit_race.sh` counts them. Found while testing
// net.download (tools/download/check.py repeats a run that ended that way once).
// Not seen on Linux, not tried on a real Windows machine.
import std.rt
fn __thread_work(kind: u64, arg: u64) -> u64 {
    return 7
}
fn main(start: u64) -> i32 {
    let h: u64 = thread_start(1, 0)
    let r: u64 = thread_wait(h)
    if r != 7 { return 3 as i32 }
    return 0 as i32
}
