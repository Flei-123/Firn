import std.time
import window.window

fn wait_code() -> i64 {
    var code: i64 = -1
    var n: i32 = 0
    while code == -1 && n < 400 {
        time.sleep_ms(25)
        code = window.update_poll()
        n = n + 1
    }
    return code
}

fn main() -> i32 {
    if window.update_poll() != -2 {
        return 1
    }
    if !window.update_run(0 as u32) {
        return 2
    }
    if window.update_run(1 as u32) {
        return 3
    }
    if wait_code() != 10 {
        return 4
    }
    if window.update_poll() != -2 {
        return 5
    }
    if !window.update_run(2 as u32) {
        return 6
    }
    if wait_code() != 10 {
        return 7
    }
    return 0
}
