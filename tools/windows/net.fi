// SPDX-License-Identifier: GPL-2.0-only
// expect_exit: 0
// tools/windows/net.fi -- THE PROOF THAT THE SEAM CARRIES MORE THAN printf.
//
// A TCP client with nothing underneath it but `syscall`. On Linux those are
// the Linux calls; on Windows the seam (compiler/src/win_seam.rs) turns the
// same numbers into `socket`/`connect`/`send`/`recv` out of `ws2_32.dll`
// and keeps the descriptor table that makes a SOCKET look like a small
// integer.
//
// The port comes out of `argv[1]` -- so this program proves the second
// thing as well: that the start block `__win_argv` builds out of
// `GetCommandLineW` is the same block Linux leaves on the stack.
//
// Nothing here is imported. No std, no allocator, no collector.

const SYS_WRITE: i64 = 1
const SYS_CLOSE: i64 = 3
const SYS_SOCKET: i64 = 41
const SYS_CONNECT: i64 = 42
const SYS_SENDTO: i64 = 44
const SYS_RECVFROM: i64 = 45

const AF_INET: i64 = 2
const SOCK_STREAM: i64 = 1

fn ld8(p: u64, i: i64) -> i64 {
    let q: *mut u8 = ((p as i64) + i) as *mut u8
    return (*q) as i64
}

fn ld64(p: u64, i: i64) -> i64 {
    let q: *mut i64 = ((p as i64) + i * 8) as *mut i64
    return *q
}

fn out(p: u64, n: i64) {
    syscall(SYS_WRITE, 1, p as i64, n, 0, 0, 0)
}

fn ch(c: i64) {
    var b: [u8; 1] = [0; 1]
    b[0] = c as u8
    out((&b[0]) as u64, 1)
}

fn num(v: i64) {
    if v >= 10 {
        num(v / 10)
    }
    ch(48 + (v % 10))
}

// argv[1] read as a decimal number. 0 = nothing usable there.
fn port_of(start: u64) -> i64 {
    if start == 0 {
        return 0
    }
    if ld64(start, 0) < 2 {
        return 0
    }
    let p: u64 = ld64(start, 2) as u64
    var v: i64 = 0
    var i: i64 = 0
    while true {
        let c: i64 = ld8(p, i)
        if c < 48 || c > 57 {
            break
        }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    let port: i64 = port_of(start)
    if port == 0 {
        return 2
    }
    let fd: i64 = syscall(SYS_SOCKET, AF_INET, SOCK_STREAM, 0, 0, 0, 0)
    if fd < 0 {
        return 3
    }
    // struct sockaddr_in, octet for octet. `family` in host order, the port
    // and the address in network order -- the same sixteen octets on both
    // operating systems, which is exactly why the seam can pass them
    // through untouched.
    var sa: [u8; 16] = [0; 16]
    sa[0] = AF_INET as u8
    sa[1] = 0
    sa[2] = (port / 256) as u8
    sa[3] = (port % 256) as u8
    sa[4] = 127
    sa[5] = 0
    sa[6] = 0
    sa[7] = 1
    if syscall(SYS_CONNECT, fd, (&sa[0]) as i64, 16, 0, 0, 0) < 0 {
        return 4
    }
    // "GET / HTTP/1.0\r\n\r\n"
    var req: [u8; 18] = [
        71, 69, 84, 32, 47, 32, 72, 84, 84, 80, 47, 49, 46, 48, 13, 10, 13, 10
    ]
    if syscall(SYS_SENDTO, fd, (&req[0]) as i64, 18, 0, 0, 0) < 0 {
        return 5
    }
    var buf: [u8; 4096] = [0; 4096]
    var total: i64 = 0
    var first: [u8; 7] = [0; 7]
    var have_first: i64 = 0
    while true {
        let n: i64 = syscall(SYS_RECVFROM, fd, (&buf[0]) as i64, 4096, 0, 0, 0)
        if n <= 0 {
            break
        }
        if have_first == 0 && n >= 7 {
            var k: i64 = 0
            while k < 7 {
                first[k as usize] = buf[k as usize]
                k = k + 1
            }
            have_first = 1
        }
        total = total + n
    }
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    if have_first == 0 {
        return 6
    }
    num(total)
    ch(32)
    out((&first[0]) as u64, 7)
    ch(10)
    return 0
}
