// SPDX-License-Identifier: MPL-2.0
// expect_exit: 0
// tools/windows/nonblock.fi -- O_NONBLOCK must be visible through fcntl(F_GETFL) on sockets made by socket(SOCK_NONBLOCK) and accept4(SOCK_NONBLOCK).
// Prints `NB <socket nonblock> <plain socket> <accept4 nonblock> <accept plain>` (expected: NB 2048 0 2048 0).

const SYS_WRITE: i64 = 1
const SYS_CLOSE: i64 = 3
const SYS_SOCKET: i64 = 41
const SYS_CONNECT: i64 = 42
const SYS_ACCEPT: i64 = 43
const SYS_BIND: i64 = 49
const SYS_LISTEN: i64 = 50
const SYS_GETSOCKNAME: i64 = 51
const SYS_FCNTL: i64 = 72
const SYS_ACCEPT4: i64 = 288

const AF_INET: i64 = 2
const SOCK_STREAM: i64 = 1
const SOCK_NONBLOCK: i64 = 2048
const F_GETFL: i64 = 3

fn ld8(p: u64, i: i64) -> i64 {
    let q: *mut u8 = ((p as i64) + i) as *mut u8
    return (*q) as i64
}

fn ld64(p: u64, i: i64) -> i64 {
    let q: *mut i64 = ((p as i64) + i * 8) as *mut i64
    return *q
}

fn ch(c: i64) {
    var b: [u8; 1] = [0; 1]
    b[0] = c as u8
    syscall(SYS_WRITE, 1, (&b[0]) as i64, 1, 0, 0, 0)
}

fn num(v: i64) {
    if v < 0 {
        ch(45)
        num(0 - v)
        return
    }
    if v >= 10 {
        num(v / 10)
    }
    ch(48 + (v % 10))
}

fn nb_flag(fd: i64) -> i64 {
    return syscall(SYS_FCNTL, fd, F_GETFL, 0, 0, 0, 0) & SOCK_NONBLOCK
}

fn connect_to(port_hi: u8, port_lo: u8) -> i64 {
    let fd: i64 = syscall(SYS_SOCKET, AF_INET, SOCK_STREAM, 0, 0, 0, 0)
    var sa: [u8; 16] = [0; 16]
    sa[0] = AF_INET as u8
    sa[2] = port_hi
    sa[3] = port_lo
    sa[4] = 127
    sa[7] = 1
    if syscall(SYS_CONNECT, fd, (&sa[0]) as i64, 16, 0, 0, 0) < 0 { return 0 - 1 }
    return fd
}

fn main() -> i32 {
    let lfd: i64 = syscall(SYS_SOCKET, AF_INET, SOCK_STREAM, 0, 0, 0, 0)
    if lfd < 0 { return 3 }
    var sa: [u8; 16] = [0; 16]
    sa[0] = AF_INET as u8
    sa[4] = 127
    sa[7] = 1
    if syscall(SYS_BIND, lfd, (&sa[0]) as i64, 16, 0, 0, 0) < 0 { return 4 }
    if syscall(SYS_LISTEN, lfd, 8, 0, 0, 0, 0) < 0 { return 5 }
    var got: [u8; 16] = [0; 16]
    var glen: [i32; 1] = [16]
    if syscall(SYS_GETSOCKNAME, lfd, (&got[0]) as i64, (&glen[0]) as i64, 0, 0, 0) < 0 { return 6 }
    let hi: u8 = got[2]
    let lo: u8 = got[3]
    let n0: i64 = syscall(SYS_SOCKET, AF_INET, SOCK_STREAM | SOCK_NONBLOCK, 0, 0, 0, 0)
    let p0: i64 = syscall(SYS_SOCKET, AF_INET, SOCK_STREAM, 0, 0, 0, 0)
    let c1: i64 = connect_to(hi, lo)
    let c2: i64 = connect_to(hi, lo)
    if c1 < 0 || c2 < 0 { return 7 }
    let a1: i64 = syscall(SYS_ACCEPT4, lfd, 0, 0, SOCK_NONBLOCK, 0, 0)
    let a2: i64 = syscall(SYS_ACCEPT, lfd, 0, 0, 0, 0, 0)
    if a1 < 0 || a2 < 0 { return 8 }
    var tag: [u8; 3] = [78, 66, 32]
    syscall(SYS_WRITE, 1, (&tag[0]) as i64, 3, 0, 0, 0)
    num(nb_flag(n0))
    ch(32)
    num(nb_flag(p0))
    ch(32)
    num(nb_flag(a1))
    ch(32)
    num(nb_flag(a2))
    ch(10)
    return 0
}
