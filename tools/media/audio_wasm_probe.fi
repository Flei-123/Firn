import std.rt
import media.audio.source
import media.audio.open
import media.audio.CODEC

fn main(start: u64) -> i32 {
    var reg: source.Registry = source.registry_new()
    CODEC.register(&reg)
    var s: source.AudioSource = source.source_new()
    let n: usize = 4096
    let d: u64 = rt.heap_alloc(n)
    if !open.open_bytes(&reg, d, n, &s) {
        return 1
    }
    let out: u64 = rt.heap_alloc(8192 * 8)
    let got: i64 = source.source_read_f32(&s, out, 8192)
    source.source_seek(&s, 100 as u64)
    source.source_close(&s)
    return got as i32
}
