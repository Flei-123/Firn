import std.rt
import std.io
import media.audio.source
import media.audio.open
import media.audio.all

fn main(start: u64) -> i32 {
    var data: rt.Buf = rt.buf_new()
    if !io.read_stdin(&data) {
        return 2
    }
    var reg: source.Registry = source.registry_new()
    all.register_all(&reg)
    var s: source.AudioSource = source.source_new()
    if !open.open_bytes(&reg, rt.buf_ptr(&data), rt.buf_len(&data), &s) {
        return 3
    }
    let ch: usize = source.source_info(&s).channels as usize
    let tmp: u64 = rt.heap_alloc(4096 * ch * 4)
    var h: u64 = 14695981039346656037 as u64
    var total: u64 = 0 as u64
    while true {
        let got: i64 = source.source_read_f32(&s, tmp, 4096)
        if got <= 0 {
            break
        }
        var i: usize = 0
        while i < (got as usize) * ch * 4 {
            h = (h ^ (rt.ld8(tmp, i) as u64)) *% 1099511628211 as u64
            i = i + 1
        }
        total = total + (got as u64)
    }
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, total)
    rt.buf_push(&b, 32 as u8)
    rt.buf_push_hex_u64(&b, h, 16)
    rt.buf_push(&b, 10 as u8)
    io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
    return 0
}
