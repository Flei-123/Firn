import std.rt
import std.io
import media.audio.source
import media.audio.open
import media.audio.all

fn pn(label: str, v: u64) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, label.p as u64, label.length())
    rt.buf_push_dec_u64(&b, v)
    rt.buf_push(&b, 10 as u8)
    io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

fn arg_num(start: u64, i: usize) -> u64 {
    var v: u64 = 0 as u64
    let p: u64 = rt.arg_ptr(start, i)
    var k: usize = 0
    while rt.ld8(p, k) != 0 as u8 {
        v = v * 10 as u64 + ((rt.ld8(p, k) as u64) - 48 as u64)
        k = k + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        io.print("usage: audio_dump in out [seek_frame [max_frames]]\n")
        return 2
    }
    var data: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &data) {
        io.print("cannot read\n")
        return 3
    }
    var reg: source.Registry = source.registry_new()
    all.register_all(&reg)
    var s: source.AudioSource = source.source_new()
    if !open.open_bytes(&reg, rt.buf_ptr(&data), rt.buf_len(&data), &s) {
        io.print("open failed\n")
        return 4
    }
    var inf: source.AudioInfo = source.source_info(&s)
    io.print("format=")
    io.print(source.format_name(inf.format))
    io.print("\n")
    pn("channels=", inf.channels as u64)
    pn("rate=", inf.rate as u64)
    pn("frames=", inf.frames)
    pn("known=", if_known(inf.known_length))
    var maxf: u64 = 0 as u64
    if rt.arg_count(start) >= 4 {
        if !source.source_seek(&s, arg_num(start, 3)) {
            io.print("seek failed\n")
            return 5
        }
    }
    if rt.arg_count(start) >= 5 {
        maxf = arg_num(start, 4)
    }
    var out: rt.Buf = rt.buf_new()
    let chunk: usize = 4096
    let tmp: u64 = rt.heap_alloc(chunk * (inf.channels as usize) * 4)
    var total: u64 = 0 as u64
    while true {
        var want: usize = chunk
        if maxf > 0 as u64 && maxf - total < (want as u64) {
            want = (maxf - total) as usize
        }
        if want == 0 {
            break
        }
        let got: i64 = source.source_read_f32(&s, tmp, want)
        if got <= 0 {
            if got < 0 {
                io.print("read error\n")
            }
            break
        }
        rt.buf_push_bytes(&out, tmp, (got as usize) * (inf.channels as usize) * 4)
        total = total + (got as u64)
    }
    pn("decoded=", total)
    rt.write_file(rt.arg_ptr(start, 2), rt.buf_ptr(&out), rt.buf_len(&out))
    source.source_close(&s)
    return 0
}

fn if_known(b: bool) -> u64 {
    if b { return 1 as u64 }
    return 0 as u64
}
