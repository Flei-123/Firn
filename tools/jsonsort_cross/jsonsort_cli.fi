// tools/jsonsort_cross/jsonsort_cli.fi -- json_write_opts as a program (SKRIPT-LIBS r315).
//
//     jsonsort_cli dumps <in> <out>    every document in <in>, every variant -> <out>
//     jsonsort_cli fuzz  <in>          round trip check; summary on stdout, exit 1 on a failure
//
// <in> is binary, little endian u64 words: ndocs, then per document its length
// and its octets padded to a multiple of 8. `dumps` answers per document and per
// variant: status (0 ok, 1 parse error, 2 write incomplete), length, octets
// padded to 8. The variants (VARIANTS of them) are the keyword arguments of
// Python's json.dumps listed in tools/jsonsort_cross/cross.py. The checker is
// cross.py; `fuzz` needs no Python.
import std.rt
import std.json
import std.io

const VARIANTS: usize = 11

fn num_out(v: usize) {
    var f: io.Fmt = io.fmt_new()
    f = io.fmt_u64(f, v as u64)
    io.fmt_print(f)
}

fn make_opts(v: usize) -> json.JsonOpts {
    var o: json.JsonOpts = json.json_opts_new()
    if v == 0 {
        return o
    }
    if v == 1 {
        o.flags = json.JSON_ASCII | json.JSON_SORT_KEYS
        return o
    }
    if v == 2 {
        o = json.json_opts_indent(2)
        o.flags = json.JSON_ASCII | json.JSON_SORT_KEYS
        return o
    }
    if v == 3 {
        o = json.json_opts_indent(4)
        o.flags = json.JSON_SORT_KEYS
        return o
    }
    if v == 4 {
        o = json.json_opts_compact()
        o.flags = json.JSON_ASCII | json.JSON_SORT_KEYS
        return o
    }
    if v == 5 {
        o = json.json_opts_indent(0)
        return o
    }
    if v == 6 {
        o = json.json_opts_indent(1)
        var tab: [u8; 2] = "\t\0"
        json.json_opts_set_indent_text(&o, (&tab[0]) as u64, 1)
        o.flags = json.JSON_SORT_KEYS
        return o
    }
    if v == 7 {
        json.json_opts_set_indent(&o, 1)
        return o
    }
    if v == 8 {
        var a: [u8; 4] = " , \0"
        var b: [u8; 4] = " : \0"
        json.json_opts_set_separators(&o, (&a[0]) as u64, 3, (&b[0]) as u64, 3)
        o.flags = json.JSON_ASCII | json.JSON_SORT_KEYS
        return o
    }
    if v == 9 {
        o.flags = 0 as u32
        return o
    }
    o.flags = json.JSON_ASCII | json.JSON_SORT_KEYS | json.JSON_PY_NONFINITE
    return o
}

fn put_word(out: *mut rt.Buf, v: u64) {
    var w: u64 = v
    rt.buf_push_bytes(out, (&w) as u64, 8)
}

fn put_padded(out: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push_bytes(out, p, n)
    var pad: usize = (8 - n % 8) % 8
    while pad > 0 {
        rt.buf_push(out, 0 as u8)
        pad = pad - 1
    }
}

fn dumps(base: u64, out: *mut rt.Buf) {
    let ndocs: usize = rt.ld64(base, 0) as usize
    var pos: usize = 1
    var di: usize = 0
    while di < ndocs {
        let len: usize = rt.ld64(base, pos) as usize
        let data: u64 = base + ((pos + 1) as u64) * 8
        pos = pos + 1 + (len + 7) / 8
        var d: json.Json = json.json_new()
        let ok: bool = json.json_parse(&d, data, len) catch false
        var v: usize = 0
        while v < VARIANTS {
            if !ok {
                put_word(out, 1)
                put_word(out, 0)
            } else {
                var o: json.JsonOpts = make_opts(v)
                var text: rt.Buf = rt.buf_new()
                let full: bool = json.json_write_opts(&d, json.json_root(&d), &text, &o)
                if full {
                    put_word(out, 0)
                } else {
                    put_word(out, 2)
                }
                put_word(out, rt.buf_len(&text) as u64)
                put_padded(out, rt.buf_ptr(&text), rt.buf_len(&text))
                rt.buf_free(&text)
            }
            v = v + 1
        }
        json.json_free(&d)
        di = di + 1
    }
}

// the first failures are named: document number, variant, which check
// (1 = written text does not parse, 2 = not a fixed point, 3 = sorted text differs)
static mut noted: i32 = 0

fn note(doc: usize, variant: usize, check: usize) {
    if noted >= 5 {
        return
    }
    noted = noted + 1
    io.print("FAIL doc #")
    num_out(doc)
    io.print(" variant ")
    num_out(variant)
    io.print(" check ")
    num_out(check)
    io.print_line("")
}

// Strict UTF-8 (no overlong forms, no surrogates, nothing above U+10FFFF).
// The parser lets other octets through inside strings (J3); on such a document
// two different keys can become the same key after the writer replaced the bad
// octets, so only the weaker checks (no crash, the text parses) apply to it.
fn utf8_valid(p: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 128 as u8 {
            i = i + 1
        } else if c >= 194 as u8 && c <= 223 as u8 {
            if i + 1 >= n || (rt.ld8(p, i + 1) & 192 as u8) != 128 as u8 {
                return false
            }
            i = i + 2
        } else if (c & 240 as u8) == 224 as u8 {
            if i + 2 >= n || (rt.ld8(p, i + 1) & 192 as u8) != 128 as u8
            || (rt.ld8(p, i + 2) & 192 as u8) != 128 as u8 {
                return false
            }
            let t: u32 = (((c & 15 as u8) as u32) << 12)
            | (((rt.ld8(p, i + 1) & 63 as u8) as u32) << 6)
            | ((rt.ld8(p, i + 2) & 63 as u8) as u32)
            if t < 2048 as u32 || (t >= 55296 as u32 && t <= 57343 as u32) {
                return false
            }
            i = i + 3
        } else if c >= 240 as u8 && c <= 244 as u8 {
            if i + 3 >= n || (rt.ld8(p, i + 1) & 192 as u8) != 128 as u8
            || (rt.ld8(p, i + 2) & 192 as u8) != 128 as u8
            || (rt.ld8(p, i + 3) & 192 as u8) != 128 as u8 {
                return false
            }
            let t: u32 = (((c & 7 as u8) as u32) << 18)
            | (((rt.ld8(p, i + 1) & 63 as u8) as u32) << 12)
            | (((rt.ld8(p, i + 2) & 63 as u8) as u32) << 6)
            | ((rt.ld8(p, i + 3) & 63 as u8) as u32)
            if t < 65536 as u32 || t > 1114111 as u32 {
                return false
            }
            i = i + 4
        } else {
            return false
        }
    }
    return true
}

fn same(a: *mut rt.Buf, b: *mut rt.Buf) -> bool {
    if rt.buf_len(a) != rt.buf_len(b) {
        return false
    }
    return rt.mem_eq(rt.buf_ptr(a), rt.buf_ptr(b), rt.buf_len(a))
}

// For every document that parses: write it with each variant, parse the text
// again (it must parse, except the non-JSON `Infinity`), write that again with
// the SAME variant (must be byte-identical: the writer is a fixed point after
// one round), and the sorted compact text of the original must equal the sorted
// compact text of the re-parsed unsorted text (sorting is canonical).
fn fuzz(base: u64) -> i32 {
    let ndocs: usize = rt.ld64(base, 0) as usize
    var pos: usize = 1
    var di: usize = 0
    var parsed: usize = 0
    var invalid: usize = 0
    var rejected: usize = 0
    var checks: usize = 0
    var failures: usize = 0
    while di < ndocs {
        let len: usize = rt.ld64(base, pos) as usize
        let data: u64 = base + ((pos + 1) as u64) * 8
        pos = pos + 1 + (len + 7) / 8
        di = di + 1
        var d: json.Json = json.json_new()
        let ok: bool = json.json_parse(&d, data, len) catch false
        if !ok {
            rejected = rejected + 1
            json.json_free(&d)
            continue
        }
        parsed = parsed + 1
        let strict: bool = utf8_valid(data, len)
        if !strict {
            invalid = invalid + 1
        }
        var v: usize = 0
        while v < 10 {
            var o: json.JsonOpts = make_opts(v)
            var t1: rt.Buf = rt.buf_new()
            json.json_write_opts(&d, json.json_root(&d), &t1, &o)
            var d2: json.Json = json.json_new()
            let ok2: bool = json.json_parse(&d2, rt.buf_ptr(&t1), rt.buf_len(&t1)) catch false
            checks = checks + 1
            if !ok2 {
                failures = failures + 1
                note(di - 1, v, 1)
            } else if strict {
                var t2: rt.Buf = rt.buf_new()
                json.json_write_opts(&d2, json.json_root(&d2), &t2, &o)
                if !same(&t1, &t2) {
                    failures = failures + 1
                    note(di - 1, v, 2)
                }
                // canonical: sorted compact text of both documents is the same
                var c: json.JsonOpts = json.json_opts_compact()
                c.flags = json.JSON_ASCII | json.JSON_SORT_KEYS
                var s1: rt.Buf = rt.buf_new()
                var s2: rt.Buf = rt.buf_new()
                json.json_write_opts(&d, json.json_root(&d), &s1, &c)
                json.json_write_opts(&d2, json.json_root(&d2), &s2, &c)
                if !same(&s1, &s2) {
                    failures = failures + 1
                    note(di - 1, v, 3)
                }
                rt.buf_free(&t2)
                rt.buf_free(&s1)
                rt.buf_free(&s2)
            }
            json.json_free(&d2)
            rt.buf_free(&t1)
            v = v + 1
        }
        json.json_free(&d)
    }
    io.print("docs=")
    num_out(ndocs)
    io.print(" parsed=")
    num_out(parsed)
    io.print(" invalid_utf8=")
    num_out(invalid)
    io.print(" rejected=")
    num_out(rejected)
    io.print(" checks=")
    num_out(checks)
    io.print(" failures=")
    num_out(failures)
    io.print_line("")
    if failures > 0 {
        return 1
    }
    return 0
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 2
    }
    var src: rt.Buf = rt.buf_new()
    defer rt.buf_free(&src)
    if !rt.read_file(rt.arg_ptr(start, 2), &src) {
        return 4
    }
    var m_dumps: [u8; 6] = "dumps\0"
    let mode: u64 = rt.arg_ptr(start, 1)
    if rt.c_length(mode) == 5 && rt.mem_eq(mode, (&m_dumps[0]) as u64, 5) {
        if rt.arg_count(start) < 4 {
            return 2
        }
        var out: rt.Buf = rt.buf_new()
        defer rt.buf_free(&out)
        dumps(rt.buf_ptr(&src), &out)
        if !rt.write_file(rt.arg_ptr(start, 3), rt.buf_ptr(&out), rt.buf_len(&out)) {
            return 6
        }
        return 0
    }
    return fuzz(rt.buf_ptr(&src))
}
