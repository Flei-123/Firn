// SPDX-License-Identifier: MPL-2.0
// tools/net/tls_probe_main.fi <https-url> [roots.pem] -- one async GET and the
// reason, layer by layer: error number + name, tls error, x509 verdict, roots.
import std.rt
import async.loop
import async.ahttp
import net.http
import tls.x509

static mut lp: u64 = 0
static mut ac: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
    rt.write_everything(1, "\n".p as u64, 1)
}

fn dec(v: i64) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, v)
    return __str_copy(str { p: b.ptr as *mut u8, n: b.len })
}

fn on_done(r: *mut ahttp.Request, ud: u64) {
    var nm: rt.Buf = rt.buf_new()
    ahttp.areq_error_name(ahttp.areq_error(r), &nm)
    say("error=" + dec(ahttp.areq_error(r) as i64) + " name=" + __str_copy(str { p: nm.ptr as *mut u8, n: nm.len }))
    say("tls_error=" + dec(ahttp.areq_tls_error(r) as i64) + " status=" + dec(ahttp.areq_status(r) as i64))
    let a: *mut ahttp.AClient = ac as *mut ahttp.AClient
    say("roots=" + dec(http.client_tls_roots(ahttp.aclient_http(a)) as i64) +
        " verify=" + dec(http.client_tls_verify(ahttp.aclient_http(a)) as i64))
    loop.stop(lp as *mut loop.Loop)
}

fn arg_str(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

#[allow_escape]
fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 2
    }
    var l: loop.Loop = loop.loop_new()
    if !loop.loop_init(&l) {
        return 2
    }
    lp = (&l) as u64
    var a: ahttp.AClient = ahttp.aclient_new()
    ac = (&a) as u64
    if !ahttp.aclient_init(&a, &l) {
        say("init failed")
        return 2
    }
    let url: str = arg_str(start, 1)
    if rt.arg_count(start) > 2 {
        var pem: rt.Buf = rt.buf_new()
        let pth: str = arg_str(start, 2)
        if rt.read_file(pth.p as u64, &pem) {
            say("added=" + dec(http.client_add_trust_pem(ahttp.aclient_http(&a), pem.ptr, pem.len) as i64))
        }
        http.client_set_system_trust(ahttp.aclient_http(&a), false)
    }
    let r: *mut ahttp.Request = ahttp.aclient_get(&a, url.p as u64, url.n, 15000, on_done, 0)
    loop.run(&l)
    return 0
}
