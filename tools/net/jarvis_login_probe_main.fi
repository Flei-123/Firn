// SPDX-License-Identifier: MPL-2.0
// tools/net/jarvis_login_probe_main.fi <base-url> [nosys] -- net.jarvisc login with a
// WRONG password against a real https server. Expected: JE_LOGIN arg 401 (layer none).
// With `nosys` the system roots are off: only the embedded Let's Encrypt roots count.
// Prints "login arg=<n> layer=<word> tls=<n> verify=<n>".
import std.rt
import async.loop
import net.jarvisc

static mut lp: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
    rt.write_everything(1, "\n".p as u64, 1)
}

fn dec(v: i64) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, v)
    return __str_copy(str { p: b.ptr as *mut u8, n: b.len })
}

fn on_event(c: *mut jarvisc.Jc, ud: u64, kind: u32, arg: i64) {
    if kind == jarvisc.JE_LOGIN {
        say("login arg=" + dec(arg) + " layer=" + jarvisc.jc_net_layer_name(c) + " tls=" +
            dec(jarvisc.jc_net_tls(c) as i64) + " verify=" + dec(jarvisc.jc_net_verify(c) as i64))
        loop.stop(lp as *mut loop.Loop)
    }
}

fn on_timeout(l: *mut loop.Loop, ud: u64) {
    say("TIMEOUT")
    loop.stop(l)
}

#[allow_escape]
fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 2
    }
    var l: loop.Loop = loop.loop_new()
    if !loop.loop_init(&l) {
        return 2
    }
    lp = (&l) as u64
    let bp: u64 = rt.arg_ptr(start, 1)
    let base: str = str { p: bp as *mut u8, n: rt.c_length(bp) }
    let c: *mut jarvisc.Jc = jarvisc.jc_new(&l, on_event, 0)
    if rt.arg_count(start) > 2 {
        jarvisc.jc_set_system_trust(c, false)
    }
    jarvisc.jc_set_base(c, base)
    if !jarvisc.jc_login(c, "a10-probe", "wrong-password") {
        say("login not started")
        return 3
    }
    loop.timer_after(&l, 20000, on_timeout, 0)
    loop.run(&l)
    return 0
}
