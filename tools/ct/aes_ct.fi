// tools/ct/aes_ct.fi -- the ANSWER to tools/ct/aes_probe.fi, and what it costs.
//
// `aes_probe.fi` is refused: a table indexed by a secret leaks through the
// cache (SPEC 9.1, C4). The way SPEC 9.1 names is to read the WHOLE table
// every time and to keep the entry that was meant with `select` -- one
// `cmov`, no jump, and the same 256 loads for every input.
//
// This file does both, holds the two answers against each other for ALL 256
// inputs, and measures what the constant-time way costs. The CONTENT of the
// table is beside the point -- what is measured is one load against 256
// reads plus 256 conditional moves. It is filled by a deterministic
// permutation so that the comparison has something to compare.
import std.io

fn now_ns() -> u64 {
    var ts: [u64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as u64)
    return ts[0] * 1000000000 + ts[1]
}

// A permutation of 0..255 (x -> 5x + 17 mod 256; 5 is odd, so it is one).
fn fill(t: *mut [u8; 256]) {
    var i: usize = 0
    while i < 256 {
        (*t)[i] = ((i * 5 + 17) & 255) as u8
        i = i + 1
    }
}

// The way `lib/std/crypto/aes.fi` does it today: one load, and the ADDRESS
// says which entry was wanted.
fn sub_table(sbox: *mut [u8; 256], x: u8) -> u8 {
    return (*sbox)[x as usize]
}

// The way SPEC 9.1 asks for: every entry is read, every time, and `select`
// keeps the one that was meant.
#[constant_time]
fn sub_ct(sbox: *mut [u8; 256], x: secret[u8]) -> secret[u8] {
    var out: secret[u8] = 0
    var i: usize = 0
    while i < 256 {
        let hit: secret[bool] = x == (i as u8)
        out = select(hit, (*sbox)[i], out)
        i = i + 1
    }
    return out
}

fn main() -> i32 {
    var sbox: [u8; 256] = [0; 256]
    fill(&sbox)
    // 1. the two ways have to agree, for every one of the 256 inputs.
    var same: i32 = 0
    var i: usize = 0
    while i < 256 {
        let x: u8 = i as u8
        let s: secret[u8] = x
        if declassify(sub_ct(&sbox, s)) == sub_table(&sbox, x) {
            same = same + 1
        }
        i = i + 1
    }
    io.fmt_print(f"SAME {same}\n")
    // 2. what it costs. The same number of calls each way; the accumulator
    // keeps the optimizer from dropping the work.
    let reps: usize = 20000
    var acc: u64 = 0
    var t0: u64 = now_ns()
    var k: usize = 0
    while k < reps {
        acc = acc + sub_table(&sbox, (k & 255) as u8) as u64
        k = k + 1
    }
    let t1: u64 = now_ns()
    var acc2: u64 = 0
    k = 0
    while k < reps {
        let s2: secret[u8] = (k & 255) as u8
        acc2 = acc2 + declassify(sub_ct(&sbox, s2)) as u64
        k = k + 1
    }
    let t2: u64 = now_ns()
    let a: u64 = (t1 - t0) / (reps as u64)
    let b: u64 = (t2 - t1) / (reps as u64)
    io.fmt_print(f"table {a} ns, constant time {b} ns, reps {reps}\n")
    if acc != acc2 {
        io.fmt_print(f"MISMATCH in the sums\n")
        return 2
    }
    if same != 256 {
        return 3
    }
    return 0
}
