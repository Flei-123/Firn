// expect_exit: 89
// tools/ct/probe.fi -- the program tools/ct/run.sh reads the ASSEMBLY of.
//
// Every function marked `#[constant_time]` in here is deliberately free of
// loops: what the proof measures is a TEXT, and in a text a conditional jump
// belonging to a public loop counter cannot be told from one belonging to a
// secret. So the functions that are measured have no jump at all to begin
// with, and the claim is the strongest one that can be checked this way:
// NOT ONE conditional jump, at any of the four build levels.
//
// The loop case is checked elsewhere and by a different means: the code
// generator refuses a conditional jump whose condition is a secret value
// (`f.constant_time && f.is_secret(cond)`, checked in ct.rs by a unit test
// that builds the FIR by hand -- the type check will not produce it).
//
// `public_*` are the counter-checks. They compute the same thing over public
// types with an `if` -- and they HAVE TO carry a conditional jump, otherwise
// the whole comparison would be worth nothing.

#[constant_time]
fn ct_eq(a: secret[u64], b: secret[u64]) -> secret[bool] {
    return a == b
}

#[constant_time]
fn ct_choose(c: secret[bool], a: secret[u32], b: secret[u32]) -> secret[u32] {
    return select(c, a, b)
}

#[constant_time]
fn ct_mask(x: secret[u32], m: secret[u32]) -> secret[u32] {
    return (x ^ m) & (~m | x)
}

// Four octets compared without a loop and without a branch: the classic
// accumulate-the-difference shape of SPEC 9.1, spelled out.
#[constant_time]
fn ct_eq4(a: [secret[u8]; 4], b: [secret[u8]; 4]) -> secret[bool] {
    var acc: secret[u8] = a[0] ^ b[0]
    acc = acc | (a[1] ^ b[1])
    acc = acc | (a[2] ^ b[2])
    acc = acc | (a[3] ^ b[3])
    return acc == 0
}

fn public_eq(a: u64, b: u64) -> bool {
    if a == b {
        return true
    }
    return false
}

fn public_choose(c: bool, a: u32, b: u32) -> u32 {
    if c {
        return a
    }
    return b
}

fn main() -> i32 {
    var k1: secret[u64] = 4242
    var k2: secret[u64] = 4242
    var k3: secret[u64] = 4243
    var out: i32 = 0
    if declassify(ct_eq(k1, k2)) {
        out = out + 1
    }
    if declassify(ct_eq(k1, k3)) {
        out = out + 100
    }
    var flag: secret[bool] = true
    var x: secret[u32] = 40
    var y: secret[u32] = 2
    out = out + declassify(ct_choose(flag, x, y)) as i32
    out = out + declassify(ct_mask(x, y)) as i32
    var p: [secret[u8]; 4] = [1, 2, 3, 4]
    var q: [secret[u8]; 4] = [1, 2, 3, 5]
    if declassify(ct_eq4(p, p)) {
        out = out + 4
    }
    if declassify(ct_eq4(p, q)) {
        out = out + 100
    }
    if public_eq(1, 1) {
        out = out + 1
    }
    out = out + public_choose(true, 3, 9) as i32
    return out
}
