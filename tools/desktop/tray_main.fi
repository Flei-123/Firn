// tools/desktop/tray_main.fi -- driver for the tray test (tools/desktop/tray_check.py).
// Shows a tray icon with a small menu, prints one line per event, ends after
// the menu item "Quit" (id 2) or after 15 s of quiet.
import std.rt
import std.io
import std.str
import desktop.tray

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn num(v: i64) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, v)
    io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

fn main(start: u64) -> i32 {
    var t: tray.Tray = tray.tray_new("org.firn.traytest", "Firn tray test")
    tray.tray_set_icon_name(&t, "mail-unread")
    // a 4x2 picture: red, green, blue, white (opaque) / half-transparent row
    var px: [u8; 32] = [255, 0, 0, 255, 0, 255, 0, 255, 0, 0, 255, 255, 255, 255, 255, 255,
        255, 0, 0, 128, 0, 255, 0, 128, 0, 0, 255, 128, 255, 255, 255, 128]
    tray.tray_set_icon_rgba(&t, 4 as u32, 2 as u32, (&px[0]) as u64)
    tray.tray_set_tooltip(&t, "Firn", "two new messages")
    tray.tray_menu_add(&t, 1, "Open", tray.ITEM_ENABLED)
    tray.tray_menu_separator(&t)
    tray.tray_menu_add(&t, 3, "Mute", tray.ITEM_ENABLED | tray.ITEM_CHECKABLE)
    tray.tray_menu_add(&t, 4, "Gray", 0 as u32)
    tray.tray_menu_add(&t, 2, "Quit", tray.ITEM_ENABLED)
    let shown: bool = tray.tray_show(&t)
    if shown { say("SHOWN yes\n") } else { say("SHOWN no\n") }
    if rt.arg_count(start) >= 2 {
        // `balloon`: also show a balloon (Windows), report what the platform said
        if tray.tray_balloon(&t, "Firn", "balloon text") { say("BALLOON yes\n") } else { say("BALLOON no\n") }
    }
    var ev: tray.TrayEvent = tray.tray_event_zero()
    var quiet: u32 = 0
    while quiet < 15 {
        if tray.tray_poll(&t, 1000, &ev) {
            quiet = 0
            say("EV ")
            num(ev.kind as i64)
            say(" ")
            num(ev.id as i64)
            say(" ")
            num(ev.x as i64)
            say(" ")
            num(ev.y as i64)
            say("\n")
            if ev.kind == tray.EV_MENU && ev.id == 2 as u32 {
                break
            }
            if ev.kind == tray.EV_MENU && ev.id == 3 as u32 {
                tray.tray_menu_set_checked(&t, 3 as u32, true)
                tray.tray_menu_set_label(&t, 1 as u32, "Open now")
            }
        } else {
            quiet = quiet + 1
        }
    }
    say("VISIBLE ")
    if tray.tray_visible(&t) { say("yes\n") } else { say("no\n") }
    tray.tray_close(&t)
    return 0
}
