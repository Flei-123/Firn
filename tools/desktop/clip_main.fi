// SPDX-License-Identifier: MPL-2.0
// tools/desktop/clip_main.fi -- the system clipboard through the window layer (clip_check.py drives it).
//   clip_main set <text file> <uri list file>   offers text (the file's octets), a file list and a private type, then
//                            stays alive 25 s (the owner has to be there when somebody pastes)
//   clip_main get <mime>     prints "GOT <n>" and the n octets (or "NONE")
//   clip_main types          prints "TYPES" and one type per line
// Windows build: run under Wine, the clipboard of which is bridged to the X selections.
import std.rt
import std.io
import std.str
import std.time
import window.window

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 2
    }
    var w: window.Window = window.window_new()
    if !window.open_window(&w, 0) {
        say("NODISPLAY\n")
        return 1
    }
    if !window.make(&w, 200, 100) {
        say("MAKE-FAILED\n")
        return 3
    }
    window.show_window(&w)
    window.present(&w)
    let mode: str = arg(start, 1)
    if mode == "set" {
        var data: rt.Buf = rt.buf_new()
        if !rt.read_file(rt.arg_ptr(start, 2), &data) {
            say("NOFILE\n")
            return 4
        }
        let ok1: bool = window.clipboard_set(&w, "text/plain;charset=utf-8", rt.buf_ptr(&data), rt.buf_len(&data))
        // the file list: argv[3] is a file with the URIs (platform specific: Wine wants Z:)
        var lb: rt.Buf = rt.buf_new()
        if rt.arg_count(start) < 4 || !rt.read_file(rt.arg_ptr(start, 3), &lb) {
            say("NOLIST\n")
            return 4
        }
        let list: str = str { p: rt.buf_data(&lb), n: rt.buf_len(&lb) }
        let ok2: bool = window.clipboard_set(&w, "text/uri-list", list.p as u64, list.length())
        // "private" NUL "bytes" 1 2 255: sixteen octets that are not text
        var priv: [u8; 16] = [112, 114, 105, 118, 97, 116, 101, 0, 98, 121, 116, 101, 115, 1, 2, 255]
        let ok3: bool = window.clipboard_set(&w, "application/x-firn-test", (&priv[0]) as u64, 16)
        if ok1 { say("SET text ok\n") } else { say("SET text failed\n") }
        if ok2 { say("SET uris ok\n") } else { say("SET uris failed\n") }
        if ok3 { say("SET private ok\n") } else { say("SET private failed\n") }
        say("READY\n")
        let t0: u64 = time.monotonic_ns()
        while time.monotonic_ns() - t0 < 25000000000 as u64 {
            window.wait_event(&w, 100)
            var go: bool = true
            while go {
                if window.next_event(&w) == window.EV_NONE {
                    go = false
                }
            }
        }
        say("DONE\n")
        return 0
    }
    if mode == "get" {
        var out: rt.Buf = rt.buf_new()
        // give the bridge a moment to see the other program's selection
        var got: bool = false
        var tries: u32 = 0
        while !got && tries < 80 as u32 {
            got = window.clipboard_get(&w, arg(start, 2), &out)
            if !got {
                window.wait_event(&w, 100)
                tries = tries + 1 as u32
            }
        }
        if !got {
            say("NONE\n")
            return 0
        }
        var b: rt.Buf = rt.buf_new()
        rt.buf_push_dec_u64(&b, rt.buf_len(&out) as u64)
        say("GOT ")
        io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
        say("\n")
        syscall(1, 1, rt.buf_ptr(&out) as i64, rt.buf_len(&out) as i64, 0, 0, 0)
        say("\n")
        return 0
    }
    if mode == "types" {
        var out: rt.Buf = rt.buf_new()
        var n: usize = 0
        var tries: u32 = 0
        while n == 0 && tries < 80 as u32 {
            n = window.clipboard_types(&w, &out)
            if n == 0 {
                window.wait_event(&w, 100)
                tries = tries + 1 as u32
            }
        }
        say("TYPES\n")
        syscall(1, 1, rt.buf_ptr(&out) as i64, rt.buf_len(&out) as i64, 0, 0, 0)
        return 0
    }
    return 2
}
