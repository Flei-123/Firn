// SPDX-License-Identifier: MPL-2.0
// tools/desktop/wintray_poke.fi -- plays the shell for the Windows tray test (tray_check_win.py):
// finds the hidden window of desktop.tray and posts it the messages a real shell and a real
// popup menu would: `click`, `middle`, `right` (callback message WM_APP+1 with the mouse
// message in lParam), `cmd <n>` (WM_COMMAND, the nth menu item), `balloonclick`, `cancel` (closes
// a menu that is open), `taskbar` (the "TaskbarCreated" broadcast). Prints OK/NOWINDOW.
import std.rt
import std.io
import std.str

extern fn FindWindowW(cls: u64, name: u64) -> i64;
extern fn PostMessageW(h: i64, m: i64, wp: i64, lp: i64) -> i32;
extern fn RegisterWindowMessageW(s: u64) -> i32;

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn parse(s: str) -> i64 {
    var v: i64 = 0
    var i: usize = 0
    while i < s.length() {
        v = v * 10 + (s.chars(i) - 48 as u8) as i64
        i = i + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    var cls: [u16; 12] = u"FirnTrayWnd\0"
    let h: i64 = FindWindowW((&cls[0]) as u64, 0 as u64)
    if h == 0 {
        say("NOWINDOW\n")
        return 1
    }
    let what: str = arg(start, 1)
    var ok: i32 = 0
    if what == "click" {
        ok = PostMessageW(h, 32769, 1, 514)
    } else if what == "middle" {
        ok = PostMessageW(h, 32769, 1, 520)
    } else if what == "right" {
        ok = PostMessageW(h, 32769, 1, 517)
    } else if what == "balloonclick" {
        ok = PostMessageW(h, 32769, 1, 1029)
    } else if what == "balloontimeout" {
        ok = PostMessageW(h, 32769, 1, 1028)
    } else if what == "cmd" {
        ok = PostMessageW(h, 273, parse(arg(start, 2)), 0)
    } else if what == "cancel" {
        ok = PostMessageW(h, 31, 0, 0) // WM_CANCELMODE: closes the popup menu
    } else if what == "taskbar" {
        var tb: [u16; 15] = u"TaskbarCreated\0"
        ok = PostMessageW(h, RegisterWindowMessageW((&tb[0]) as u64) as i64, 0, 0)
    }
    if ok != 0 {
        say("OK\n")
        return 0
    }
    say("FAILED\n")
    return 2
}
