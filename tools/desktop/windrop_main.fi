// SPDX-License-Identifier: MPL-2.0
// tools/desktop/windrop_main.fi -- WM_DROPFILES on Windows (run under Wine): the program opens a window,
// accepts drops and posts ITSELF a real WM_DROPFILES with a real HDROP (a GlobalAlloc block holding
// DROPFILES and wide paths), the message Explorer sends when files are dropped. What the window layer
// delivers (EV_DROP, then drop_take) is printed: "DROP <n>" and one "PATH <utf-8>" per file.
import std.rt
import std.io
import std.str
import std.cmdline
import window.window

extern fn FindWindowW(cls: u64, name: u64) -> i64;
extern fn PostMessageW(h: i64, m: i64, wp: i64, lp: i64) -> i32;
extern fn GlobalAlloc(flags: i64, n: i64) -> i64;
extern fn GlobalLock(h: i64) -> u64;
extern fn GlobalUnlock(h: i64) -> i32;

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn num(v: i64) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, v)
    io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

// A CF_HDROP block for the given UTF-8 paths (each ended by a NUL octet in `paths`).
fn make_hdrop(paths: str) -> i64 {
    var names: rt.Buf = rt.buf_new()
    var i: usize = 0
    var start: usize = 0
    while i < paths.length() {
        if paths.chars(i) == 0 as u8 {
            cmdline.utf8_to_utf16(paths.p as u64 + start as u64, i - start, &names)
            rt.buf_push(&names, 0 as u8)
            rt.buf_push(&names, 0 as u8)
            start = i + 1
        }
        i = i + 1
    }
    rt.buf_push(&names, 0 as u8)
    rt.buf_push(&names, 0 as u8)
    let h: i64 = GlobalAlloc(66, (20 + rt.buf_len(&names)) as i64) // GHND
    let q: u64 = GlobalLock(h)
    rt.st32(q, 0, 20 as u32) // pFiles
    rt.st32(q, 4, 1 as u32) // fWide (octet 16)
    rt.mem_copy(q + 20 as u64, rt.buf_ptr(&names), rt.buf_len(&names))
    GlobalUnlock(h)
    rt.buf_free(&names)
    return h
}

fn main(start: u64) -> i32 {
    var w: window.Window = window.window_new()
    if !window.open_window(&w, 0) {
        say("NODISPLAY\n")
        return 1
    }
    if !window.make(&w, 300, 200) {
        say("MAKE-FAILED\n")
        return 3
    }
    window.show_window(&w)
    window.present(&w)
    if !window.drop_accept(&w, true) {
        say("ACCEPT-FAILED\n")
        return 2
    }
    var cls: [u16; 10] = u"FirnFenst\0"
    let h: i64 = FindWindowW((&cls[0]) as u64, 0 as u64)
    if h == 0 {
        say("NOWINDOW\n")
        return 4
    }
    say("READY\n")
    // two drops: three files (blank, umlaut, Japanese), then one
    let first: str = "C:\\Users\\me\\a b.txt\0D:\\gr\u{fc}\u{df}e\\\u{e4}.txt\0Z:\\\u{65e5}\u{672c}\u{8a9e}\\x\0"
    let second: str = "C:\\only.txt\0"
    PostMessageW(h, 563, make_hdrop(first), 0)
    PostMessageW(h, 563, make_hdrop(second), 0)
    var seen: u32 = 0
    var spins: u32 = 0
    while seen < 2 as u32 && spins < 400 as u32 {
        window.wait_event(&w, 50)
        var go: bool = true
        while go {
            let k: u32 = window.next_event(&w)
            if k == window.EV_NONE {
                go = false
            } else if k == window.EV_DROP {
                var paths: rt.Buf = rt.buf_new()
                let n: usize = window.drop_take(&w, &paths)
                say("DROP ")
                num(n as i64)
                say("\n")
                var i: usize = 0
                var at: usize = 0
                while i < rt.buf_len(&paths) {
                    if rt.buf_at(&paths, i) == 0 as u8 {
                        say("PATH ")
                        syscall(1, 1, (rt.buf_ptr(&paths) + at as u64) as i64, (i - at) as i64, 0, 0, 0)
                        say("\n")
                        at = i + 1
                    }
                    i = i + 1
                }
                rt.buf_free(&paths)
                seen = seen + 1 as u32
            }
        }
        spins = spins + 1 as u32
    }
    say("DONE\n")
    return 0
}
