// tools/desktop/winnotify_win_main.fi -- driver for winnotify_check_win.py: window.notify / window.stay_alive on
// Win32 (a balloon from a notification-area icon that stays; Wine's explorer plays the shell).
import std.rt
import std.io
import window.window

fn say_bool(label: str, ok: bool) {
    io.print_bytes(label.p as u64, label.length())
    if ok {
        io.print_line(" yes")
    } else {
        io.print_line(" no")
    }
}

fn main(start: u64) -> i32 {
    var w: window.Window = window.window_new()
    if !window.open_window(&w, 0) {
        io.print_line("NODISPLAY")
        return 1
    }
    if !window.make(&w, 200, 100) {
        io.print_line("MAKE-FAILED")
        return 3
    }
    window.show_window(&w)
    let t: str = "Hello from a window"
    let b: str = "body \u{e4}\u{f6}"
    say_bool("NOTIFY", window.notify(&w, t.p as u64, t.length(), b.p as u64, b.length()))
    say_bool("ALIVE", window.stay_alive(&w, true))
    // the window goes, the icon stays (stay_alive): a second balloon still works
    window.close_window(&w)
    let t2: str = "Second"
    say_bool("NOTIFY2", window.notify(&w, t2.p as u64, t2.length(), b.p as u64, b.length()))
    io.print_line("DONE")
    // a program in the tray lives on: pump a little so the shell can talk to the icon's window
    window.wait_event(&w, 1500)
    say_bool("ALIVE_OFF", window.stay_alive(&w, false))
    io.print_line("END")
    return 0
}
