// SPDX-License-Identifier: MPL-2.0
// tools/desktop/clipboard_main.fi -- std.clipboard as a command line tool (clipboard_check.py drives it).
//   clipboard_main copy <file>      copies the file's octets as text, prints "COPY ok|FAILED", then READY and
//                                   serves other programs' paste requests for 20 s (X11 needs the owner alive)
//   clipboard_main copypng <file>   the same for a PNG file
//   clipboard_main paste            prints "GOT <n>" and the n octets, or "NONE"
//   clipboard_main pastepng         the same for a PNG
//   clipboard_main has              prints "HAS text=<0|1> png=<0|1>"
//   clipboard_main clear            prints "CLEAR ok|FAILED"
//   clipboard_main name             prints the backend name
// Windows build: run under Wine, whose clipboard is bridged to the X selections.
import std.rt
import std.io
import std.str
import std.clipboard

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn flag(b: bool) -> str {
    if b {
        return "1"
    }
    return "0"
}

fn show(out: *mut rt.Buf) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, rt.buf_len(out) as u64)
    say("GOT ")
    io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
    say("\n")
    syscall(1, 1, rt.buf_ptr(out) as i64, rt.buf_len(out) as i64, 0, 0, 0)
    say("\n")
    rt.buf_free(&b)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 2
    }
    let mode: str = arg(start, 1)
    if mode == "copy" || mode == "copypng" {
        var data: rt.Buf = rt.buf_new()
        if rt.arg_count(start) < 3 || !rt.read_file(rt.arg_ptr(start, 2), &data) {
            say("NOFILE\n")
            return 4
        }
        var ok: bool = false
        if mode == "copy" {
            ok = clipboard.copy_text(str { p: rt.buf_data(&data), n: rt.buf_len(&data) })
        } else {
            ok = clipboard.copy_png(rt.buf_ptr(&data), rt.buf_len(&data))
        }
        if ok { say("COPY ok\n") } else { say("COPY FAILED\n") }
        say("READY\n")
        clipboard.serve(20000)
        say("DONE\n")
        return 0
    }
    if mode == "paste" || mode == "pastepng" {
        var out: rt.Buf = rt.buf_new()
        var got: bool = false
        var tries: u32 = 0
        // give a bridge (Wine) a moment to see the other program's selection
        while !got && tries < 40 as u32 {
            if mode == "paste" {
                got = clipboard.paste_text(&out)
            } else {
                got = clipboard.paste_png(&out)
            }
            if !got {
                clipboard.serve(100)
                tries = tries + 1 as u32
            }
        }
        if !got {
            say("NONE\n")
            return 0
        }
        show(&out)
        return 0
    }
    if mode == "has" {
        say("HAS text=")
        say(flag(clipboard.has_text()))
        say(" png=")
        say(flag(clipboard.has_png()))
        say("\n")
        return 0
    }
    if mode == "clear" {
        if clipboard.clear() { say("CLEAR ok\n") } else { say("CLEAR FAILED\n") }
        return 0
    }
    if mode == "name" {
        say(clipboard.backend_name())
        say("\n")
        return 0
    }
    return 2
}
