// SPDX-License-Identifier: MPL-2.0
// tools/desktop/dbus_main.fi -- driver of the net.dbus test (dbus_check.py).
// Owns org.firn.Rich and answers: Probe (compares every value it reads with
// what libdbus sent), Make (marshals a rich body of its own), Echo (hands the
// body back byte for byte), Fail (an error reply), Slow (calls the Python
// side and meanwhile receives a signal that must be queued, not lost).
import std.rt
import std.io
import std.str
import net.dbus

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn bad(what: str) {
    say("BAD ")
    say(what)
    say("\n")
}

fn probe(m: *mut dbus.Msg) -> bool {
    var rd: dbus.Rd = dbus.msg_body(m)
    var ok: bool = true
    if (*m).f.sig != "ybnqiuxtdsogvaiaya{sv}(yx)a(yx)" { bad("signature"); return false }
    if dbus.rd_byte(&rd) != 200 as u8 { bad("y"); ok = false }
    if !dbus.rd_bool(&rd) { bad("b"); ok = false }
    if dbus.rd_i16(&rd) != -1234 as i16 { bad("n"); ok = false }
    if dbus.rd_u16(&rd) != 65535 as u16 { bad("q"); ok = false }
    if dbus.rd_i32(&rd) != -2000000000 { bad("i"); ok = false }
    if dbus.rd_u32(&rd) != 4000000000 as u32 { bad("u"); ok = false }
    if dbus.rd_i64(&rd) != -9000000000000000000 { bad("x"); ok = false }
    if dbus.rd_u64(&rd) != 18000000000000000000 as u64 { bad("t"); ok = false }
    if dbus.rd_f64_bits(&rd) != 4609434218613702656 as u64 { bad("d"); ok = false }
    if dbus.rd_str(&rd) != "h\u{e9}llo" { bad("s"); ok = false }
    if dbus.rd_path(&rd) != "/org/firn/Obj" { bad("o"); ok = false }
    if dbus.rd_sig(&rd) != "a{sv}" { bad("g"); ok = false }
    let vs: str = dbus.rd_sig(&rd)
    if vs != "u" || dbus.rd_u32(&rd) != 77 as u32 { bad("v"); ok = false }
    // ai
    var end: usize = dbus.rd_array_begin(&rd, 4)
    var sum: i64 = 0
    var cnt: i64 = 0
    while dbus.rd_array_more(&rd, end) {
        sum = sum + dbus.rd_i32(&rd) as i64
        cnt = cnt + 1
    }
    if cnt != 3 || sum != 2 { bad("ai"); ok = false }
    // ay
    end = dbus.rd_array_begin(&rd, 1)
    var k: u8 = 0
    while dbus.rd_array_more(&rd, end) {
        if dbus.rd_byte(&rd) != k { bad("ay"); ok = false }
        k = k + 1 as u8
    }
    if k != 10 as u8 { bad("ay length"); ok = false }
    // a{sv}
    end = dbus.rd_array_begin(&rd, 8)
    var entries: i32 = 0
    while dbus.rd_array_more(&rd, end) {
        dbus.rd_align(&rd, 8)
        let key: str = dbus.rd_str(&rd)
        let sg: str = dbus.rd_sig(&rd)
        if key == "k1" {
            if sg != "s" || dbus.rd_str(&rd) != "v1" { bad("k1"); ok = false }
        } else if key == "k2" {
            if sg != "i" || dbus.rd_i32(&rd) != -5 { bad("k2"); ok = false }
        } else if key == "k3" {
            if sg != "ay" { bad("k3 sig"); ok = false }
            let e2: usize = dbus.rd_array_begin(&rd, 1)
            if dbus.rd_byte(&rd) != 7 as u8 || dbus.rd_byte(&rd) != 8 as u8 || dbus.rd_array_more(&rd, e2) { bad("k3"); ok = false }
        } else {
            // skipping by signature must work for anything
            var j: usize = 0
            dbus.rd_skip_value(&rd, sg, &j)
        }
        entries = entries + 1
    }
    if entries != 3 { bad("a{sv} count"); ok = false }
    // (yx)
    dbus.rd_align(&rd, 8)
    if dbus.rd_byte(&rd) != 9 as u8 || dbus.rd_i64(&rd) != -9 { bad("(yx)"); ok = false }
    // a(yx)
    end = dbus.rd_array_begin(&rd, 8)
    var n2: i64 = 0
    while dbus.rd_array_more(&rd, end) {
        dbus.rd_align(&rd, 8)
        let a: u8 = dbus.rd_byte(&rd)
        let b: i64 = dbus.rd_i64(&rd)
        n2 = n2 + 1
        if a as i64 != n2 || b != 0 - n2 { bad("a(yx)"); ok = false }
    }
    if n2 != 2 { bad("a(yx) count"); ok = false }
    if !rd.ok || dbus.rd_left(&rd) != 0 { bad("reader state"); ok = false }
    return ok
}

fn make(body: *mut rt.Buf) {
    dbus.w_byte(body, 200 as u8)
    dbus.w_bool(body, true)
    dbus.w_i16(body, -1234 as i16)
    dbus.w_u16(body, 65535 as u16)
    dbus.w_i32(body, -2000000000)
    dbus.w_u32(body, 4000000000 as u32)
    dbus.w_i64(body, -9000000000000000000)
    dbus.w_u64(body, 18000000000000000000 as u64)
    dbus.w_f64_bits(body, 4609434218613702656 as u64)
    dbus.w_str(body, "h\u{e9}llo")
    dbus.w_path(body, "/org/firn/Obj")
    dbus.w_sig(body, "a{sv}")
    dbus.w_variant(body, "u")
    dbus.w_u32(body, 77 as u32)
    var at: usize = dbus.w_array_begin(body, 4)
    dbus.w_i32(body, 1)
    dbus.w_i32(body, -2)
    dbus.w_i32(body, 3)
    dbus.w_array_end(body, at, 4)
    at = dbus.w_array_begin(body, 1)
    var k: u8 = 0
    while k < 10 as u8 {
        dbus.w_byte(body, k)
        k = k + 1 as u8
    }
    dbus.w_array_end(body, at, 1)
    at = dbus.w_array_begin(body, 8)
    dbus.w_struct_begin(body)
    dbus.w_str(body, "k1")
    dbus.w_variant(body, "s")
    dbus.w_str(body, "v1")
    dbus.w_struct_begin(body)
    dbus.w_str(body, "k2")
    dbus.w_variant(body, "i")
    dbus.w_i32(body, -5)
    dbus.w_struct_begin(body)
    dbus.w_str(body, "k3")
    dbus.w_variant(body, "ay")
    let a2: usize = dbus.w_array_begin(body, 1)
    dbus.w_byte(body, 7 as u8)
    dbus.w_byte(body, 8 as u8)
    dbus.w_array_end(body, a2, 1)
    dbus.w_array_end(body, at, 8)
    dbus.w_struct_begin(body)
    dbus.w_byte(body, 9 as u8)
    dbus.w_i64(body, -9)
    at = dbus.w_array_begin(body, 8)
    dbus.w_struct_begin(body)
    dbus.w_byte(body, 1 as u8)
    dbus.w_i64(body, -1)
    dbus.w_struct_begin(body)
    dbus.w_byte(body, 2 as u8)
    dbus.w_i64(body, -2)
    dbus.w_array_end(body, at, 8)
}

fn main(start: u64) -> i32 {
    var bus: dbus.Bus = dbus.bus_new()
    if !dbus.bus_connect_session(&bus) { say("NOBUS\n"); return 1 }
    if dbus.bus_request_name(&bus, "org.firn.Rich", 0) != 1 { say("NONAME\n"); return 1 }
    dbus.bus_add_match(&bus, "type='signal',interface='org.firn.PySig'")
    say("READY\n")
    var m: dbus.Msg = dbus.msg_new()
    var quiet: i32 = 0
    while quiet < 20 {
        let r: i32 = dbus.bus_recv(&bus, &m, 1000)
        if r < 0 { break }
        if r == 0 { quiet = quiet + 1; continue }
        quiet = 0
        if dbus.msg_is_signal(&m) {
            say("SIGNAL ")
            say(m.f.member)
            say("\n")
            continue
        }
        if !dbus.msg_is_call(&m) { continue }
        let mem: str = m.f.member
        if mem == "Probe" {
            if probe(&m) { say("PROBE ok\n") } else { say("PROBE bad\n") }
            dbus.bus_reply(&bus, &m, "", 0 as *mut rt.Buf)
        } else if mem == "Make" {
            var body: rt.Buf = rt.buf_new()
            make(&body)
            dbus.bus_reply(&bus, &m, "ybnqiuxtdsogvaiaya{sv}(yx)a(yx)", &body)
            rt.buf_free(&body)
        } else if mem == "Echo" {
            var body: rt.Buf = rt.buf_new()
            rt.buf_push_bytes(&body, rt.buf_ptr(&m.buf) + m.body_off as u64, m.body_len)
            dbus.bus_reply(&bus, &m, m.f.sig, &body)
            rt.buf_free(&body)
        } else if mem == "Fail" {
            dbus.bus_reply_error(&bus, &m, "org.firn.Error.Nope", "that did not work")
        } else if mem == "Slow" {
            // call the Python side; its signal arrives before the reply
            var f: dbus.Fields = dbus.fields_call("org.firn.PyService", "/org/firn/Py", "org.firn.Py", "Slow", "")
            var reply: dbus.Msg = dbus.msg_new()
            let rc: i32 = dbus.bus_call(&bus, &f, 0 as *mut rt.Buf, &reply, 5000)
            if rc == 0 { say("SLOW reply ok\n") } else { say("SLOW reply failed\n") }
            dbus.msg_free(&reply)
            // the signal that arrived meanwhile comes out of the queue now
            var s: dbus.Msg = dbus.msg_new()
            if dbus.bus_recv(&bus, &s, 2000) == 1 && dbus.msg_is_signal(&s) {
                say("SLOW queued signal ")
                say(s.f.member)
                say("\n")
            } else {
                say("SLOW lost the signal\n")
            }
            dbus.msg_free(&s)
            dbus.bus_reply(&bus, &m, "", 0 as *mut rt.Buf)
        } else if mem == "Quit" {
            dbus.bus_reply(&bus, &m, "", 0 as *mut rt.Buf)
            break
        } else {
            dbus.bus_reply_error(&bus, &m, "org.freedesktop.DBus.Error.UnknownMethod", "unknown")
        }
    }
    dbus.msg_free(&m)
    dbus.bus_free(&bus)
    say("DONE\n")
    return 0
}
