// tools/desktop/audio_main.fi -- driver of the audio test (audio_check.py).
//   audio_main <file.mp3> <percent> <mode>
//   mode play  : the whole song through player_pump until the end
//   mode pause : pump to 500 ms, pause (nothing may advance), resume, play to the end
//   mode stop  : pump to 300 ms, then player_stop
//   mode bad   : play_mp3 of a buffer that is not an MP3 (must fail, not crash)
// Prints one line: RESULT <state> <frames> <crc> <sink kind> <volume>
import std.rt
import std.io
import std.str
import std.time
import audio.player

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn num(v: i64) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, v)
    io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn parse_u32(s: str) -> u32 {
    var v: u32 = 0
    var i: usize = 0
    while i < s.length() {
        v = v * 10 as u32 + (s.chars(i) - 48 as u8) as u32
        i = i + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 4 {
        say("usage: audio_main <mp3> <percent> <mode>\n")
        return 2
    }
    let mode: str = arg(start, 3)
    var source: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &source) {
        say("input not readable\n")
        return 3
    }
    let percent: u32 = parse_u32(arg(start, 2))
    var p: player.Player = player.player_new()
    player.player_set_volume(&p, percent)
    if mode == "bad" {
        var junk: [u8; 64] = [7; 64]
        let ok: bool = player.play_mp3("bad", (&junk[0]) as u64, 64, 100 as u32)
        if ok { say("BAD played junk\n") } else { say("BADOK refused\n") }
        return 0
    }
    if !player.player_play_mp3(&p, "Firn audio test", rt.buf_ptr(&source), rt.buf_len(&source)) {
        say("play failed\n")
        return 4
    }
    // the buffer is copied: free ours right away to prove it
    rt.buf_free(&source)
    var spins: u32 = 0
    if mode == "stop" {
        while player.player_position_ms(&p) < 300 as u64 && player.player_pump(&p, 5 as u64) == player.ST_PLAYING {
            time.sleep_ms(1 as u64)
        }
        player.player_stop(&p)
    } else {
        var paused_check: bool = mode != "pause"
        while player.player_state(&p) == player.ST_PLAYING {
            player.player_pump(&p, 20 as u64)
            if !paused_check && player.player_position_ms(&p) >= 500 as u64 {
                player.player_pause(&p, true)
                let at: u64 = player.player_position_ms(&p)
                var k: u32 = 0
                while k < 20 as u32 {
                    player.player_pump(&p, 5 as u64)
                    time.sleep_ms(2 as u64)
                    k = k + 1 as u32
                }
                if player.player_position_ms(&p) != at || player.player_state(&p) != player.ST_PAUSED {
                    say("PAUSE advanced\n")
                    return 5
                }
                player.player_pause(&p, false)
                paused_check = true
                say("PAUSE ok\n")
            }
            time.sleep_ms(2 as u64)
            spins = spins + 1 as u32
        }
    }
    say("RESULT ")
    num(player.player_state(&p) as i64)
    say(" ")
    num(p.frames as i64)
    say(" ")
    num(player.player_crc(&p) as i64)
    say(" ")
    num(player.player_sink_kind(&p) as i64)
    say(" ")
    num(percent as i64)
    say(" ")
    num(p.channels as i64)
    say(" ")
    num(p.hz as i64)
    say("\n")
    player.player_free(&p)
    return 0
}
