// SPDX-License-Identifier: MPL-2.0
// tools/desktop/drop_main.fi -- a window that takes dropped files (drop_check.py drives it).
// Prints READY, then for every drop "DROP <n>" and one "PATH <path>" per file; ends after
// 4 drops, a close request, or 150 s without a drop.
import std.rt
import std.io
import std.str
import std.time
import window.window
import desktop.filedrop

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn num(v: i64) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, v)
    io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

fn got_file(ud: u64, path: str) {
    say("PATH ")
    syscall(1, 1, path.p as i64, path.length() as i64, 0, 0, 0)
    say("\n")
}

fn main(start: u64) -> i32 {
    var w: window.Window = window.window_new()
    if !window.open_window(&w, 0) {
        say("NODISPLAY\n")
        return 1
    }
    if !window.make(&w, 300, 200) {
        say("MAKE-FAILED\n")
        return 3
    }
    let ttl: str = "firn-drop-test"
    window.title(&w, ttl.p as u64, ttl.length())
    window.fill(&w, 16777215 as u32, 0, 0, 300, 200)
    window.show_window(&w)
    window.present(&w)
    if !window.drop_accept(&w, true) {
        say("ACCEPT-FAILED\n")
        return 2
    }
    say("READY\n")
    var drops: u32 = 0
    var last: u64 = time.monotonic_ns()
    while drops < 4 as u32 && time.monotonic_ns() - last < 150000000000 as u64 {
        window.wait_event(&w, 200)
        var go: bool = true
        while go {
            let k: u32 = window.next_event(&w)
            if k == window.EV_NONE {
                go = false
            } else if k == window.EV_CLOSED {
                return 0
            } else if k == window.EV_DROP {
                say("DROP\n")
                filedrop.filedrop_event(&w, k, got_file, 0 as u64)
                drops = drops + 1 as u32
                last = time.monotonic_ns()
            }
        }
    }
    say("DONE\n")
    return 0
}
