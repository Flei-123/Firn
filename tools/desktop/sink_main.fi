// SPDX-License-Identifier: MPL-2.0
// tools/desktop/sink_main.fi -- plays a generated test pattern through audio.sink:
// frame n is (left = low 16 bits of n * 7 + 1000, right = bitwise complement of left),
// `seconds` long at 44100 Hz stereo, written in blocks of `block` frames. Prints
// "SINK <frames written> <crc> <kind>".
import std.rt
import std.io
import std.str
import audio.sink

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn parse(s: str) -> usize {
    var v: usize = 0
    var i: usize = 0
    while i < s.length() {
        v = v * 10 + (s.chars(i) - 48 as u8) as usize
        i = i + 1
    }
    return v
}

fn num(v: i64) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, v)
    io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn main(start: u64) -> i32 {
    let seconds: usize = parse(arg(start, 1))
    let block: usize = parse(arg(start, 2))
    var s: sink.Sink = sink.sink_open("Firn sink test", 44100 as u32, 2 as u32)
    if !sink.sink_is_open(&s) {
        say("NOSINK\n")
        return 1
    }
    let total: usize = seconds * 44100
    var buf: rt.Buf = rt.buf_new()
    rt.buf_reserve(&buf, block * 4)
    var n: usize = 0
    while n < total {
        var k: usize = block
        if k > total - n {
            k = total - n
        }
        rt.buf_clear(&buf)
        var i: usize = 0
        while i < k {
            let l: u32 = (((n + i) * 7 + 1000) & 65535) as u32
            let r: u32 = l ^ 65535 as u32
            rt.buf_push(&buf, (l & 255 as u32) as u8)
            rt.buf_push(&buf, (l >> 8) as u8)
            rt.buf_push(&buf, (r & 255 as u32) as u8)
            rt.buf_push(&buf, (r >> 8) as u8)
            i = i + 1
        }
        if !sink.sink_write(&s, rt.buf_ptr(&buf), k) {
            say("WRITEFAIL\n")
            return 2
        }
        n = n + k
    }
    sink.sink_drain(&s)
    say("SINK ")
    num(n as i64)
    say(" ")
    num(sink.sink_crc(&s) as i64)
    say(" ")
    num(sink.sink_kind(&s) as i64)
    say("\n")
    sink.sink_close(&s)
    return 0
}
