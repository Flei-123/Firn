// tools/desktop/winnotify_main.fi -- driver for winnotify_check.py: window.notify on X11 (Xvfb) over the session bus.
import std.rt
import std.io
import window.window

fn main(start: u64) -> i32 {
    var w: window.Window = window.window_new()
    if !window.open_window(&w, 0) {
        io.print_line("NODISPLAY")
        return 1
    }
    if !window.make(&w, 200, 100) {
        io.print_line("MAKE-FAILED")
        return 3
    }
    window.show_window(&w)
    let t: str = "Hello from a window"
    let b: str = "body \u{e4}\u{f6}"
    if window.notify(&w, t.p as u64, t.length(), b.p as u64, b.length()) {
        io.print_line("NOTIFY yes")
    } else {
        io.print_line("NOTIFY no")
    }
    if window.stay_alive(&w, true) {
        io.print_line("ALIVE yes")
    } else {
        io.print_line("ALIVE no")
    }
    window.close_window(&w)
    return 0
}
