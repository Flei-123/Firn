// tools/desktop/autostart_main.fi -- driver for autostart_check.py:
//   autostart_main set <dir> <app_id> <name> <exe> <args one per line>
//   autostart_main remove <dir> <app_id>
//   autostart_main enabled <dir> <app_id>     (exit 0 = enabled, 1 = not)
import std.rt
import std.str
import desktop.autostart

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn main(start: u64) -> i32 {
    let mode: str = arg(start, 1)
    if mode == "set" && rt.arg_count(start) >= 7 {
        if autostart.autostart_set_in(arg(start, 2), arg(start, 3), arg(start, 4), arg(start, 5), arg(start, 6)) {
            return 0
        }
        return 1
    }
    if mode == "remove" && rt.arg_count(start) >= 4 {
        if autostart.autostart_remove_in(arg(start, 2), arg(start, 3)) {
            return 0
        }
        return 1
    }
    if mode == "enabled" && rt.arg_count(start) >= 4 {
        if autostart.autostart_is_enabled_in(arg(start, 2), arg(start, 3)) {
            return 0
        }
        return 1
    }
    return 2
}
