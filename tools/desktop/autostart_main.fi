// SPDX-License-Identifier: MPL-2.0
// tools/desktop/autostart_main.fi -- driver for autostart_check.py:
//   autostart_main set <dir> <app_id> <name> <exe> <args one per line | @file with them>
//   autostart_main remove <dir> <app_id>
//   autostart_main enabled <dir> <app_id>     (exit 0 = enabled, 1 = not)
import std.rt
import std.str
import desktop.autostart

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn main(start: u64) -> i32 {
    let mode: str = arg(start, 1)
    if mode == "set" && rt.arg_count(start) >= 7 {
        var args: str = arg(start, 6)
        if args.length() > 1 && args.chars(0) == 64 as u8 {
            // @file: the argument lines come from a file (a command line cannot carry line breaks everywhere)
            var b: rt.Buf = rt.buf_new()
            if !rt.read_file(args.p as u64 + 1 as u64, &b) {
                return 3
            }
            args = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
        }
        if autostart.autostart_set_in(arg(start, 2), arg(start, 3), arg(start, 4), arg(start, 5), args) {
            return 0
        }
        return 1
    }
    if mode == "command" && rt.arg_count(start) >= 4 {
        var out: rt.Buf = rt.buf_new()
        if autostart.autostart_command_in(arg(start, 2), arg(start, 3), &out) {
            syscall(1, 1, rt.buf_ptr(&out) as i64, rt.buf_len(&out) as i64, 0, 0, 0)
            return 0
        }
        return 1
    }
    if mode == "remove" && rt.arg_count(start) >= 4 {
        if autostart.autostart_remove_in(arg(start, 2), arg(start, 3)) {
            return 0
        }
        return 1
    }
    if mode == "enabled" && rt.arg_count(start) >= 4 {
        if autostart.autostart_is_enabled_in(arg(start, 2), arg(start, 3)) {
            return 0
        }
        return 1
    }
    return 2
}
