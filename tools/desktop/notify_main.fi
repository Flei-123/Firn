// tools/desktop/notify_main.fi -- driver for the notification test (notify_check.py).
import std.rt
import std.io
import std.str
import desktop.notify

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn num(v: i64) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, v)
    io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

fn main(start: u64) -> i32 {
    var n: notify.Notifier = notify.notify_open("Firn notify test")
    if !notify.notify_ready(&n) {
        say("READY no\n")
        var note0: notify.Note = notify.note_new("x", "y")
        say("ID ")
        num(notify.notify_show(&n, &note0) as i64)
        say("\n")
        notify.notify_close_bus(&n)
        return 0
    }
    say("READY yes\n")
    var info: rt.Buf = rt.buf_new()
    notify.notify_server_info(&n, &info)
    say("INFO ")
    io.print_bytes(rt.buf_ptr(&info), rt.buf_len(&info))
    var caps: rt.Buf = rt.buf_new()
    let nc: usize = notify.notify_capabilities(&n, &caps)
    say("CAPS ")
    num(nc as i64)
    say("\n")
    var note: notify.Note = notify.note_new("Download finished", "mod.jar, 4.2 MiB \u{e4}\u{f6}")
    note.icon = "emblem-downloads"
    note.actions = "default\nOpen\nopen\nShow file\n"
    note.category = "transfer.complete"
    note.desktop_entry = "firn-test"
    note.urgency = notify.URGENCY_CRITICAL
    note.timeout_ms = 7000
    let id: u32 = notify.notify_show(&n, &note)
    say("ID ")
    num(id as i64)
    say("\n")
    var note2: notify.Note = notify.note_new("Download finished (2)", "again")
    note2.replaces = id
    note2.timeout_ms = notify.TIMEOUT_NEVER
    let id2: u32 = notify.notify_show(&n, &note2)
    say("ID2 ")
    num(id2 as i64)
    say("\n")
    say("CLOSE ")
    if notify.notify_close(&n, id2) { say("ok\n") } else { say("fail\n") }
    say("GO\n")
    var ev: notify.NotifyEvent = notify.notify_event_zero()
    var quiet: u32 = 0
    while quiet < 10 {
        if notify.notify_poll(&n, 1000, &ev) {
            quiet = 0
            if ev.kind == notify.EV_ACTION {
                say("ACTION ")
                num(ev.id as i64)
                say(" ")
                say(notify.notify_event_key(&n))
                say("\n")
            } else {
                say("CLOSED ")
                num(ev.id as i64)
                say(" ")
                num(ev.reason as i64)
                say("\n")
                if ev.reason == notify.CLOSED_DISMISSED {
                    break
                }
            }
        } else {
            quiet = quiet + 1
        }
    }
    notify.notify_close_bus(&n)
    return 0
}
