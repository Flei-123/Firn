// tools/checked/widths.fi -- checked arithmetic at every integer width
// (round 72). Nothing here goes out of range: this is the counter-check
// that a program which stays in range behaves exactly as it always did,
// in every build level.
fn main() -> i32 {
    var a8: i8 = 100 as i8
    var b8: i8 = 27 as i8
    if a8 + b8 != 127 as i8 {
        return 1
    }
    var c8: u8 = 200 as u8
    var d8: u8 = 55 as u8
    if c8 + d8 != 255 as u8 {
        return 2
    }
    var a16: i16 = 30000 as i16
    var b16: i16 = 2767 as i16
    if a16 + b16 != 32767 as i16 {
        return 3
    }
    var a32: i32 = 2147483000
    if a32 + 647 != 2147483647 {
        return 4
    }
    var small: i32 = 1234
    var a64: i64 = 9223372036854775000
    if a64 + 807 != 9223372036854775807 {
        return 5
    }
    var u64a: u64 = 18446744073709551000
    if u64a + 615 != 18446744073709551615 {
        return 6
    }
    if a32 / 1000 != 2147483 {
        return 7
    }
    if a64 % 1000 != 0 {
        return 8
    }
    // A narrowing `as` that really FITS is not a panic and not a
    // truncation -- it is just a conversion, in every level.
    if (small as i16) as i32 != small {
        return 9
    }
    return 42
}
