// tools/checked/mul_u8.fi -- 200u8 * 2 (round 72). Unsigned overflow shows
// up in CF, not in OF -- the whole reason the check does not test OF alone.
fn feed(x: u8) -> u8 {
    return x
}

fn main() -> i32 {
    let a: u8 = feed(200 as u8)
    let b: u8 = feed(2 as u8)
    let c: u8 = a * b
    if c == 144 as u8 {
        return 7
    }
    return 1
}
