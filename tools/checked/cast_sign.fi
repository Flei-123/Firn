// tools/checked/cast_sign.fi -- (-5 as i32) as u32 (round 72). SAME width,
// different signedness: the value does not survive, and the check catches
// it exactly like a narrowing one.
fn feed(x: i32) -> i32 {
    return x
}

fn main() -> i32 {
    let a: i32 = feed(-5)
    let b: u32 = a as u32
    if b == 4294967291 as u32 {
        return 7
    }
    return 1
}
