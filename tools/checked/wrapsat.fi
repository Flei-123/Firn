// tools/checked/wrapsat.fi -- the six explicit operators of round 72
// (SPEC 13, item L9). They are NEVER checked, in any build level: this
// program has to return 42 in all four of them.
fn u8v(x: u8) -> u8 {
    return x
}

fn i8v(x: i8) -> i8 {
    return x
}

fn u64v(x: u64) -> u64 {
    return x
}

fn i64v(x: i64) -> i64 {
    return x
}

fn i32v(x: i32) -> i32 {
    return x
}

fn main() -> i32 {
    // wrapping: the low order bits, two's complement
    if (i32v(2147483647) +% i32v(1)) != -2147483648 {
        return 1
    }
    if (i8v(-128 as i8) -% i8v(1 as i8)) != 127 as i8 {
        return 2
    }
    if (u8v(200 as u8) *% u8v(2 as u8)) != 144 as u8 {
        return 3
    }
    // the FNV-1a step, the reason the spelling exists at all
    var h: u64 = 14695981039346656037
    h = h *% u64v(1099511628211)
    if h == 0 {
        return 4
    }
    // saturating: clamped to the type's own MIN/MAX
    if (i32v(2147483647) +| i32v(1)) != 2147483647 {
        return 5
    }
    if (i8v(-128 as i8) -| i8v(1 as i8)) != -128 as i8 {
        return 6
    }
    if (u8v(200 as u8) +| u8v(100 as u8)) != 255 as u8 {
        return 7
    }
    if (u8v(1 as u8) -| u8v(5 as u8)) != 0 as u8 {
        return 8
    }
    if (i64v(9223372036854775807) *| i64v(2)) != 9223372036854775807 {
        return 9
    }
    if (i64v(-9223372036854775808) *| i64v(2)) != -9223372036854775808 {
        return 10
    }
    if (i8v(100 as i8) *| i8v(2 as i8)) != 127 as i8 {
        return 11
    }
    if (u64v(18446744073709551615) +| u64v(1)) != 18446744073709551615 {
        return 12
    }
    // and they really are UNCHECKED, not accidentally in range
    if (u64v(0) -% u64v(1)) != 18446744073709551615 {
        return 13
    }
    return 42
}
