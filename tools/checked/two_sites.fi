// tools/checked/two_sites.fi -- TWO functions, each with a checked and a
// saturating site of its own (round 72, second pass). Value numbers restart
// at 0 in every function, so labels built from them alone collided and the
// assembler refused the whole file. Nothing here overflows: what is proved
// is that the program assembles and runs at all.
fn one(a: i32, b: i32) -> i32 {
    let s: i32 = a + b
    let t: i32 = a +| b
    return s + t
}

fn two(a: i32, b: i32) -> i32 {
    let s: i32 = a * b
    let t: i32 = a *| b
    return s + t
}

fn three(a: i32, b: i32) -> i32 {
    let s: i32 = a - b
    let t: i32 = a -| b
    return s + t
}

fn main() -> i32 {
    if one(3, 4) != 14 {
        return 1
    }
    if two(3, 4) != 24 {
        return 2
    }
    if three(9, 4) != 10 {
        return 3
    }
    return 42
}
