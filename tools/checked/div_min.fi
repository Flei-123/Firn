// tools/checked/div_min.fi -- i32::MIN / -1 (round 72). The one division
// that overflows instead of dividing by zero; without the check the CPU
// raises SIGFPE with no message of ours at all.
fn feed(x: i32) -> i32 {
    return x
}

fn main() -> i32 {
    let a: i32 = feed(-2147483648)
    let b: i32 = feed(-1)
    let c: i32 = a / b
    return c
}
