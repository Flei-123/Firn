// tools/checked/fold.fi -- round 72, second pass. Everything in here is
// computable at compile time AND stays in range, so `release-safe` -- the
// level that both checks and runs every optimisation pass -- has to fold
// it away completely. Before the second pass it folded NOTHING: the
// constant folder matched `Op::Bin`, and the arithmetic it existed for had
// become `Op::CheckedBin`.
fn main() -> i32 {
    let a: i32 = 20 + 22
    let b: i32 = 7 * 6
    let c: i32 = 100 - 58
    let d: i32 = 126 / 3
    let e: i32 = 342 % 100
    let f: i32 = 40 +% 2
    let g: i32 = 21 *| 2
    let h: i32 = 4242 as i16 as i32
    if a != 42 {
        return 1
    }
    if b != 42 {
        return 2
    }
    if c != 42 {
        return 3
    }
    if d != 42 {
        return 4
    }
    if e != 42 {
        return 5
    }
    if f != 42 {
        return 6
    }
    if g != 42 {
        return 7
    }
    if h != 4242 {
        return 8
    }
    return 42
}
