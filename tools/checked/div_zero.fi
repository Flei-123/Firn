// tools/checked/div_zero.fi -- division by zero (round 72). Only the three
// CHECKED levels are run: release-fast has nothing to wrap here, the CPU
// raises SIGFPE, and that is not this round's promise.
fn feed(x: i32) -> i32 {
    return x
}

fn main() -> i32 {
    let a: i32 = feed(10)
    let b: i32 = feed(0)
    let c: i32 = a / b
    return c
}
