// tools/checked/add_i32.fi -- i32::MAX + 1 (round 72, SPEC 13 item L9).
// dev / dev-fast / release-safe: panic. release-fast: wraps to i32::MIN.
fn feed(x: i32) -> i32 {
    return x
}

fn main() -> i32 {
    let a: i32 = feed(2147483647)
    let b: i32 = feed(1)
    let c: i32 = a + b
    if c == -2147483648 {
        return 7
    }
    return 1
}
