// tools/checked/mul_i8.fi -- 100i8 * 2 (round 72). The 8 bit SIGNED
// multiplication is the one that has no two operand `imul` at all; before
// the second pass of this round the assembler rejected the file outright.
fn feed(x: i8) -> i8 {
    return x
}

fn main() -> i32 {
    let a: i8 = feed(100 as i8)
    let b: i8 = feed(2 as i8)
    let c: i8 = a * b
    if c == -56 as i8 {
        return 7
    }
    return 1
}
