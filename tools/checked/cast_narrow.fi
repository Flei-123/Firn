// tools/checked/cast_narrow.fi -- 313 as u8 (round 72). A narrowing `as`
// that really loses the value is checked; release-fast truncates to 57.
fn feed(x: i32) -> i32 {
    return x
}

fn main() -> i32 {
    let a: i32 = feed(313)
    let b: u8 = a as u8
    if b == 57 as u8 {
        return 7
    }
    return 1
}
