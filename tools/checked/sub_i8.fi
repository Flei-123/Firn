// tools/checked/sub_i8.fi -- i8::MIN - 1 (round 72).
fn feed(x: i8) -> i8 {
    return x
}

fn main() -> i32 {
    let a: i8 = feed(-128 as i8)
    let b: i8 = feed(1 as i8)
    let c: i8 = a - b
    if c == 127 as i8 {
        return 7
    }
    return 1
}
