import std.io
import std.rt
import std.time
import std.vec
import fui.kitmd_types
import fui.kitmd_clean
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.safeout
import fui.theme
import fui.style
import fui.painter
import fui.render
import fui.kit
import fui.kitchat
import fui.kitmd

const W: usize = 520
const H: usize = 6000

fn load_set(path: u64, keep: *mut rt.Buf) -> u64 {
    if !rt.read_file(path, keep) {
        return 0
    }
    let fsp: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    *fsp = metrics.fontset_new()
    if !metrics.fontset_load(fsp, (*keep).ptr as *mut u8, (*keep).len) {
        return 0
    }
    return fsp as u64
}

fn crop(src: *mut canvas.Canvas, dst: *mut canvas.Canvas, height: f64) -> bool {
    var h: usize = (height + 0.5) as usize
    if h > canvas.canvas_height(src) { h = canvas.canvas_height(src) }
    if h == 0 || !canvas.canvas_init(dst, canvas.canvas_width(src), h) { return false }
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < canvas.canvas_width(src) {
            canvas.canvas_set_raw(dst, x, y, canvas.canvas_get(src, x, y))
            x = x + 1
        }
        y = y + 1
    }
    return true
}

fn next_fixture(all: str, pos: *mut usize, out: *mut str) -> bool {
    if *pos >= all.n { return false }
    var i: usize = *pos
    while i < all.n {
        if rt.ld8(all.p as u64, i) == (10 as u8) && i + 5 < all.n && rt.ld8(all.p as u64, i + 1) == (61 as u8) && rt.ld8(all.p as u64, i + 2) == (61 as u8) && rt.ld8(all.p as u64, i + 3) == (61 as u8) && rt.ld8(all.p as u64, i + 4) == (61 as u8) && rt.ld8(all.p as u64, i + 5) == (10 as u8) {
            break
        }
        i = i + 1
    }
    var e: usize = i
    if i >= all.n { e = all.n }
    *out = str { p: all.p + *pos, n: e - *pos }
    *pos = e + 6
    return true
}

static mut BAD: usize = 0
static mut CHECKS: usize = 0
static mut SEED: u64 = 12345

fn expect(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if !ok {
        BAD = BAD + 1
        io.print_line(what)
    }
}

fn rnd(n: usize) -> usize {
    SEED = (SEED * 1103515245 + 12345) % 2147483648
    return ((SEED >> 8) % (n as u64)) as usize
}

fn hex_val(b: u8) -> u8 {
    if b >= (97 as u8) { return b - (87 as u8) }
    return b - (48 as u8)
}

fn hex_into(hex: str, out: *mut rt.Buf) {
    var i: usize = 0
    while i + 1 < hex.n {
        rt.buf_push(out, hex_val(rt.ld8(hex.p as u64, i)) * (16 as u8) + hex_val(rt.ld8(hex.p as u64, i + 1)))
        i = i + 2
    }
}

fn clean_hex(input: str, want: str) -> bool {
    var inb: rt.Buf = rt.buf_new()
    var wb: rt.Buf = rt.buf_new()
    var b: rt.Buf = rt.buf_new()
    hex_into(input, &inb)
    hex_into(want, &wb)
    kitmd_clean.clean_into(0 as *mut painter.Painter, &b, inb.ptr as u64, inb.len)
    let ok: bool = b.len == wb.len && rt.mem_eq(b.ptr as u64, wb.ptr as u64, wb.len)
    rt.buf_free(&inb)
    rt.buf_free(&wb)
    rt.buf_free(&b)
    return ok
}

fn pool_has(c: *mut render.Ctx, text: str, ch: u8) -> bool {
    let lay: *mut kitmd_types.Layout = kitmd.md_layout(c, text, 400.0, 14.0)
    var i: usize = 0
    while i < rt.buf_len(&(*lay).pool) {
        if rt.buf_at(&(*lay).pool, i) == ch { return true }
        i = i + 1
    }
    return false
}

fn mutate(src: str, out: *mut rt.Buf) {
    rt.buf_clear(out)
    var n: usize = src.n
    if rnd(3) != 0 && n > 0 {
        n = rnd(n + 1)
    }
    var i: usize = 0
    var alpha: str = "*`#-1.2 \n>_~[]()|\\"
    while i < n {
        let r: usize = rnd(40)
        if r == 0 {
            rt.buf_push(out, rt.ld8(alpha.p as u64, rnd(alpha.n)))
        } else if r == 1 {
            rt.buf_push(out, rnd(256) as u8)
        } else if r == 2 {
        } else {
            rt.buf_push(out, rt.ld8(src.p as u64, i))
        }
        i = i + 1
    }
}

fn arg_num(p: u64) -> usize {
    var v: usize = 0
    var i: usize = 0
    while rt.ld8(p, i) != (0 as u8) {
        v = v * 10 + ((rt.ld8(p, i) - (48 as u8)) as usize)
        i = i + 1
    }
    return v
}

fn run_checks(c: *mut render.Ctx, all: str, fuzz_runs: usize) {
    expect(clean_hex("610062", "6162"), "clean: NUL dropped")
    expect(clean_hex("610962", "612062"), "clean: tab to space")
    expect(clean_hex("610d0a62", "610a62"), "clean: CR dropped")
    expect(clean_hex("78c28579", "780a79"), "clean: NEL is a line break")
    expect(clean_hex("fffe", ""), "clean: invalid bytes dropped")
    expect(clean_hex("6162e282", "6162"), "clean: truncated tail dropped")
    expect(clean_hex("c080", ""), "clean: overlong dropped")
    expect(clean_hex("eda080", ""), "clean: surrogate dropped")
    expect(clean_hex("61efbfbd62", "6162"), "clean: U+FFFD dropped")
    expect(clean_hex("61e2808b62", "6162"), "clean: zero width dropped")
    expect(clean_hex("c3bce280a2", "c3bce280a2"), "clean: valid text kept")
    expect(clean_hex("610a62", "610a62"), "clean: newline kept")
    expect(clean_hex("f490808078", "78"), "clean: above U+10FFFF dropped")
    var line: f64 = kitmd.md_height(c, "one", 400.0, 14.0)
    expect(line > 10.0 && line < 40.0, "one line height sane")
    expect(kitmd.md_height(c, "- a\n- b\n- c", 400.0, 14.0) > 2.5 * line, "list has three rows")
    expect(kitmd.md_height(c, "a\n\nb", 400.0, 14.0) > 2.0 * line, "paragraph gap")
    expect(kitmd.md_height(c, "", 400.0, 14.0) > 0.0, "empty text still has a line")
    expect(!pool_has(c, "**Laufen:** x", 42 as u8), "bold markers consumed")
    expect(!pool_has(c, "`code` x", 96 as u8), "code markers consumed")
    expect(pool_has(c, "**open bold", 42 as u8), "open bold stays visible")
    expect(pool_has(c, "`open code", 96 as u8), "open code stays visible")
    expect(kitmd.md_height(c, "```\nopen block", 400.0, 14.0) > line, "open fence has height")
    expect(kitmd.md_width(c, "- a", 400.0, 14.0) < 100.0, "short list is narrow")
    let b0: i64 = kitmd.md_builds()
    kitmd.md_height(c, "same text", 400.0, 14.0)
    kitmd.md_height(c, "same text", 400.0, 14.0)
    expect(kitmd.md_builds() - b0 == 1, "second query hits the cache")

    var fx: [str; 32] = [str { p: all.p, n: 0 }; 32]
    var nf: usize = 0
    var pos: usize = 0
    var item: str = str { p: all.p, n: 0 }
    while nf < 32 && next_fixture(all, &pos, &item) {
        fx[nf] = item
        nf = nf + 1
    }
    var st: kitmd_types.Style = kitmd.style_theme(c, 14.0, 0xFF202020 as u32)
    var buf: rt.Buf = rt.buf_new()
    var r: usize = 0
    var bad_geom: usize = 0
    while r < fuzz_runs {
        mutate(fx[rnd(nf)], &buf)
        let maxw: f64 = 200.0 + (rnd(300) as f64)
        st.size = 14.0 + ((rnd(3) * 4) as f64)
        let t: str = str { p: buf.ptr as *mut u8, n: buf.len }
        var m: [f64; 2] = [0.0; 2]
        kitmd.md_measure(c, t, maxw, st.size, &m)
        kitmd.md_draw(c, 10.0, 10.0, maxw, t, &st)
        if !(m[1] > 0.0) || m[1] > 1000000.0 || m[0] > maxw + 1.0 {
            bad_geom = bad_geom + 1
            if bad_geom == 1 {
                var g: io.Fmt = io.fmt_new()
                g = io.fmt_number(g, (m[0] * 100.0) as i64)
                g = io.fmt_text(g, " ".p as u64, 1)
                g = io.fmt_number(g, (maxw * 100.0) as i64)
                g = io.fmt_text(g, " ".p as u64, 1)
                g = io.fmt_number(g, buf.len as i64)
                io.fmt_print(g)
                io.new_line()
                io.print_bytes(buf.ptr as u64, buf.len)
                io.new_line()
            }
        }
        r = r + 1
    }
    expect(bad_geom == 0, "fuzz: geometry stays inside bounds")
    rt.buf_free(&buf)
    io.print_line("kitmd fuzz runs done")
}

fn run_bench(c: *mut render.Ctx) {
    var src: rt.Buf = rt.buf_new()
    var unit: str = "Tipps:\n\n- **Laufen:** dreimal pro Woche `30` Minuten, *langsam* steigern.\n- Schlafen: acht Stunden pro Nacht, mehr ist besser.\n1. Wasser trinken\n2. Obst essen\n\n"
    while src.len < 2000 {
        rt.buf_push_bytes(&src, unit.p as u64, unit.n)
    }
    rt.buf_set_len(&src, 2000)
    var worst: u64 = 0
    let t0: u64 = time.monotonic_ns()
    var i: usize = 1
    while i <= 2000 {
        let a: u64 = time.monotonic_ns()
        kitmd.md_height(c, str { p: src.ptr as *mut u8, n: i }, 420.0, 14.0)
        let d: u64 = time.monotonic_ns() - a
        if d > worst { worst = d }
        i = i + 1
    }
    let total: u64 = time.monotonic_ns() - t0
    var f: io.Fmt = io.fmt_new()
    f = io.fmt_text(f, "KITMD-BENCH per char us: ".p as u64, 24)
    f = io.fmt_number(f, (total / 2000 / 1000) as i64)
    f = io.fmt_text(f, " (ns: ".p as u64, 6)
    f = io.fmt_number(f, (total / 2000) as i64)
    f = io.fmt_text(f, ") worst ns: ".p as u64, 12)
    f = io.fmt_number(f, worst as i64)
    io.fmt_print(f)
    io.new_line()
    rt.buf_free(&src)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 6 { return 2 }
    let mode: u64 = rt.arg_ptr(start, 1)
    let out_path: u64 = rt.arg_ptr(start, 2)
    var dark: bool = rt.ld8(rt.arg_ptr(start, 3), 0) != (108 as u8)
    var fx: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 4), &fx) { return 3 }
    var f0: rt.Buf = rt.buf_new()
    var f1: rt.Buf = rt.buf_new()
    let fm: u64 = load_set(rt.arg_ptr(start, 5), &f0)
    let mono: u64 = load_set(rt.arg_ptr(start, 6), &f1)
    if fm == 0 || mono == 0 { return 4 }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) { return 5 }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 300) { return 6 }
    painter.painter_set_font(&z, fm)
    painter.painter_set_font_slot(&z, 1, mono)
    var m: theme.Theme = theme.theme_new(dark)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque((*f).base))
    let all: str = str { p: fx.ptr as *mut u8, n: fx.len }
    if rt.ld8(mode, 0) == (99 as u8) {
        var runs: usize = 12000
        if rt.arg_count(start) >= 8 { runs = arg_num(rt.arg_ptr(start, 7)) }
        run_checks(&c, all, runs)
        run_bench(&c)
        var ff: io.Fmt = io.fmt_new()
        ff = io.fmt_text(ff, "KITMD CHECKS: ".p as u64, 14)
        ff = io.fmt_number(ff, CHECKS as i64)
        ff = io.fmt_text(ff, " bad: ".p as u64, 6)
        ff = io.fmt_number(ff, BAD as i64)
        io.fmt_print(ff)
        io.new_line()
        if BAD > 0 { return 1 }
        return 0
    }
    let plain: bool = rt.ld8(mode, 0) == (112 as u8)
    var pos: usize = 0
    var item: str = str { p: all.p, n: 0 }
    var y: f64 = 16.0
    let maxw: f64 = 440.0
    while next_fixture(all, &pos, &item) {
        var h: f64 = 0.0
        if plain {
            h = kitchat.bubble_draw(&c, 16.0, 500.0, y, maxw, item, "", false)
        } else {
            h = kitchat.bubble_draw_md(&c, 16.0, 500.0, y, maxw, item, "", false)
        }
        y = y + h + 14.0
    }
    var image: canvas.Canvas = canvas.canvas_new()
    if !crop(&cv, &image, y + 4.0) { return 7 }
    var png_out: mem.Buf = mem.buf_new()
    mem.buf_init(&png_out)
    if !png.write_png(&image, &png_out) { return 8 }
    var pf: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < rt.c_length(out_path) {
        rt.buf_push(&pf, rt.ld8(out_path, k))
        k = k + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !safeout.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&png_out) as u64, mem.buf_len(&png_out)) { return 9 }
    return 0
}
