// tools/perf/rf_repro.fi -- mini repro of the release-fast regression (docs/RELEASE-FAST-REGRESSION.md).
//
// A pixel-loop shaped function: integer edge values, float divides, `math.floor` and `math.fabs` per
// iteration. `math.floor` / `math.trunc` / `math.fabs` contain `__bits`, `math.sqrt` contains `__sqrt`.
// Where the inliner pulls such a call in (release-safe, release-fast), a compiler without RFAST threw the
// WHOLE caller out of the register allocator (FIRN_RA_WARN=1 prints "RA-BASE ... reason=__sqrt / __bits"):
// every value in a frame slot, much bigger frame, 1.5-2.5x slower than with the call left standing.
// Run it with tools/perf/rf_repro.sh. Output: one checksum line (must be equal in every build).
import std.math
import std.io

fn shade(n: i64, w: i64) -> i64 {
    var e0: i64 = 3
    var e1: i64 = 5
    var e2: i64 = 7
    var acc: i64 = 0
    var cnt: i64 = 0
    var x: i64 = 0
    while x < n {
        if e0 + 1 > 0 && e1 + 3 > 0 && e2 + 7 > 0 {
            let f0: f64 = e0 as f64
            let f1: f64 = e1 as f64
            let f2: f64 = e2 as f64
            let sum: f64 = f0 * 0.37 + f1 * 0.11 + f2 * 0.52
            let u: f64 = (f0 * 0.3 + f1 * 0.2 + f2 * 0.5) / sum
            let v: f64 = (f0 * 0.6 + f1 * 0.1 + f2 * 0.3) / sum
            let tx: i64 = (math.floor(u * 16.0) as i64) & 15
            let ty: i64 = (math.floor(v * 16.0) as i64) & 15
            let a: f64 = math.fabs(f0 - f1)
            acc = acc + tx * 16 + ty + (a as i64) % 7
            cnt = cnt + 1
        }
        e0 = e0 + 3 - (x % 5)
        e1 = e1 + 5 - (x % 7)
        e2 = e2 + 7 - (x % 11)
        if e0 > 1000000 { e0 = e0 - 999983 }
        if e1 > 1000000 { e1 = e1 - 999979 }
        if e2 > 1000000 { e2 = e2 - 999961 }
        x = x + 1
        if x % w == 0 { e0 = 3 }
    }
    return acc + cnt
}

fn main() -> i32 {
    let r: i64 = shade(20000000, 640)
    io.fmt_print(f"checksum={r}\n")
    return 0
}
