// expect_out: 1 1 1 0 0 0 0 0 1 1 4 240 159 152 128 2 55357 56832 1
// Bytes/Str (SPEC 8.1): `Bytes` is not text; the border to `Str` is the
// UTF-8 validation. Checked are valid sequences, overlong encodings,
// surrogate sequences forbidden in UTF-8 (ED A0 80), too large lead bytes and
// truncated sequences -- after that Str -> Str16 -> Str with a character
// outside the BMP (U+1F600).
//#include lib/str/alloc.fi
//#include lib/str/bytes.fi
//#include lib/str/str16.fi
//#include lib/str/utf8.fi
//#include lib/str/print.fi

fn push3(b: *mut Bytes, a: u32, c: u32, d: u32) {
    bytes_clear(b)
    bytes_push(b, a as u8)
    bytes_push(b, c as u8)
    bytes_push(b, d as u8)
}

fn main() -> i32 {
    var b: Bytes = Bytes { ptr: 0 as *mut u8, len: 0, cap: 0, }
    bytes_init(&b)

    // valid: "Hi"
    bytes_push(&b, 72 as u8)
    bytes_push(&b, 105 as u8)
    print_num(bytes_is_str(&b) as u64)

    // valid: C3 A4 (a with diaeresis)
    bytes_clear(&b)
    bytes_push(&b, 0xC3 as u8)
    bytes_push(&b, 0xA4 as u8)
    print_num(bytes_is_str(&b) as u64)

    // valid: F0 9F 98 80 (U+1F600)
    bytes_clear(&b)
    bytes_push(&b, 0xF0 as u8)
    bytes_push(&b, 0x9F as u8)
    bytes_push(&b, 0x98 as u8)
    bytes_push(&b, 0x80 as u8)
    print_num(bytes_is_str(&b) as u64)

    // invalid: overlong C0 80
    bytes_clear(&b)
    bytes_push(&b, 0xC0 as u8)
    bytes_push(&b, 0x80 as u8)
    print_num(bytes_is_str(&b) as u64)

    // invalid: the surrogate ED A0 80 is NOT valid UTF-8 ...
    push3(&b, 0xED, 0xA0, 0x80)
    print_num(bytes_is_str(&b) as u64)

    // invalid: F5 is above U+10FFFF
    bytes_clear(&b)
    bytes_push(&b, 0xF5 as u8)
    bytes_push(&b, 0x80 as u8)
    bytes_push(&b, 0x80 as u8)
    bytes_push(&b, 0x80 as u8)
    print_num(bytes_is_str(&b) as u64)

    // invalid: truncated (E2 82)
    bytes_clear(&b)
    bytes_push(&b, 0xE2 as u8)
    bytes_push(&b, 0x82 as u8)
    print_num(bytes_is_str(&b) as u64)

    // invalid: a lone continuation byte
    bytes_clear(&b)
    bytes_push(&b, 0x80 as u8)
    print_num(bytes_is_str(&b) as u64)

    // ... but as WTF-8, ED A0 80 is allowed and yields exactly 0xD800.
    push3(&b, 0xED, 0xA0, 0x80)
    var s: Str16 = Str16 { ptr: 0 as *mut u16, len: 0, cap: 0, }
    str16_init(&s)
    wtf8_to_str16(&b, &s)
    print_num((str16_len(&s) == 1 && str16_at(&s, 0) as u32 == 0xD800) as u64)

    // Str -> Str16 -> Str with U+1F600
    bytes_clear(&b)
    bytes_push(&b, 0xF0 as u8)
    bytes_push(&b, 0x9F as u8)
    bytes_push(&b, 0x98 as u8)
    bytes_push(&b, 0x80 as u8)
    utf8_to_str16(&b, &s)
    var out: Bytes = Bytes { ptr: 0 as *mut u8, len: 0, cap: 0, }
    bytes_init(&out)
    let ok: bool = str16_to_utf8(&s, &out)
    print_num(ok as u64)
    print_num(bytes_len(&out) as u64)
    var i: usize = 0
    while i < bytes_len(&out) {
        print_num(bytes_at(&out, i) as u64)
        i = i + 1
    }
    print_num(str16_len(&s) as u64)
    print_num(str16_at(&s, 0) as u64)
    print_num(str16_at(&s, 1) as u64)
    print_num_nl(bytes_eq(&b, &out) as u64)

    bytes_free(&b)
    bytes_free(&out)
    str16_free(&s)
    return 0
}
