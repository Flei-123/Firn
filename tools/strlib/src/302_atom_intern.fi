// expect_out: 0 1 2 0 1 3 1 1 3 1 4 100 105 118 1000 1000
// Atome (SPEC §8.3): interniert, u32, Vergleich = Ganzzahlvergleich.
// Geprueft: gleiche Namen ergeben dieselbe Nummer, verschiedene Namen
// verschiedene, die Reihenfolge legt kleine Nummern fest, der Text laesst
// sich zurueckholen, und 1000 verschiedene Namen bekommen 1000 Nummern
// (Wachstum von Arena, Eintragstabelle und Hashfeld).
//#include lib/str/alloc.fi
//#include lib/str/bytes.fi
//#include lib/str/print.fi
//#include lib/str/atom.fi

fn set_name(b: *mut Bytes, c0: u32, c1: u32, c2: u32, n: usize) {
    bytes_clear(b)
    bytes_push(b, c0 as u8)
    if n > 1 {
        bytes_push(b, c1 as u8)
    }
    if n > 2 {
        bytes_push(b, c2 as u8)
    }
}

fn main() -> i32 {
    var t: AtomTable = AtomTable{ arena: 0 as *mut u8, arena_len: 0, arena_cap: 0,
        ents: 0 as *mut u8, count: 0, ents_cap: 0, buckets: 0 as *mut u8, nbuckets: 0, }
    atom_table_init(&t)
    var b: Bytes = Bytes{ ptr: 0 as *mut u8, len: 0, cap: 0, }
    bytes_init(&b)

    set_name(&b, 100, 105, 118, 3)      // "div"
    let a_div: u32 = atom_intern(&t, &b)
    set_name(&b, 115, 112, 110, 3)      // "spn"
    let a_spn: u32 = atom_intern(&t, &b)
    set_name(&b, 105, 100, 0, 2)        // "id"
    let a_id: u32 = atom_intern(&t, &b)
    set_name(&b, 100, 105, 118, 3)      // "div" erneut
    let a_div2: u32 = atom_intern(&t, &b)

    print_num(a_div as u64)
    print_num(a_spn as u64)
    print_num(a_id as u64)
    print_num(a_div2 as u64)
    print_num(atom_eq(a_div, a_div2) as u64)   // Ganzzahlvergleich
    print_num(atom_count(&t) as u64)
    print_num((a_div != a_spn) as u64)
    print_num((a_div == a_div2) as u64)

    // leerer Name ist ein eigenes Atom
    bytes_clear(&b)
    print_num(atom_intern(&t, &b) as u64)
    print_num((atom_intern(&t, &b) == 3 as u32) as u64)
    print_num(atom_count(&t) as u64)

    // Text zurueckholen
    var out: Bytes = Bytes{ ptr: 0 as *mut u8, len: 0, cap: 0, }
    bytes_init(&out)
    atom_text(&t, a_div, &out)
    var i: usize = 0
    while i < bytes_len(&out) {
        print_num(bytes_at(&out, i) as u64)
        i = i + 1
    }

    // 1000 verschiedene Namen -> 1000 verschiedene Nummern
    var k: usize = 0
    var neu: usize = 0
    while k < 1000 {
        bytes_clear(&b)
        bytes_push(&b, 122 as u8)
        bytes_push(&b, (48 + k % 10) as u8)
        bytes_push(&b, (48 + (k / 10) % 10) as u8)
        bytes_push(&b, (48 + (k / 100) % 10) as u8)
        let id: u32 = atom_intern(&t, &b)
        if id as usize == 4 + k {
            neu = neu + 1
        }
        k = k + 1
    }
    print_num(neu as u64)
    // dieselben Namen erneut: keine neuen Nummern
    k = 0
    var gleich: usize = 0
    while k < 1000 {
        bytes_clear(&b)
        bytes_push(&b, 122 as u8)
        bytes_push(&b, (48 + k % 10) as u8)
        bytes_push(&b, (48 + (k / 10) % 10) as u8)
        bytes_push(&b, (48 + (k / 100) % 10) as u8)
        if atom_intern(&t, &b) as usize == 4 + k {
            gleich = gleich + 1
        }
        k = k + 1
    }
    print_num_nl(gleich as u64)

    bytes_free(&b)
    bytes_free(&out)
    atom_free(&t)
    return 0
}
