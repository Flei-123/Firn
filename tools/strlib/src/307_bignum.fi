// expect_out: 333 1329 101 64 18446744065119617025 10000000000 0 1 1 1 1 999999999999999999 7 3
// The big-number arithmetic is the foundation of strtod and dtoa; if it is
// wrong, every rounding is wrong. Checked are the bit lengths of 10^100 and
// 10^400, shifting, multiplication up into the upper half, division with a
// 64-bit quotient, comparison, subtraction and digit extraction.
//#include lib/str/alloc.fi
//#include lib/str/bytes.fi
//#include lib/str/print.fi
//#include lib/num/bignum.fi

fn main() -> i32 {
    let mem: *mut u8 = heap_alloc(BN_LIMBS * 4 * 4)
    let stride: usize = BN_LIMBS * 4
    var a: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var b: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var t: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    bn_init(&a, mem, BN_LIMBS)
    bn_init(&b, (mem as usize + stride) as *mut u8, BN_LIMBS)
    bn_init(&t, (mem as usize + stride * 2) as *mut u8, BN_LIMBS)

    bn_pow10(&a, 100)
    print_num(bn_bitlen(&a) as u64) // 333
    bn_pow10(&a, 400)
    print_num(bn_bitlen(&a) as u64) // 1329

    bn_set_u64(&a, 1)
    bn_shl(&a, 100)
    print_num(bn_bitlen(&a) as u64) // 101

    // (2^32-1)^2 = 18446744065119617025, needs 64 bit
    bn_set_u64(&a, 4294967295)
    bn_mul_small(&a, 4294967295 as u32)
    print_num(bn_bitlen(&a) as u64) // 64
    print_num(bn_limb(&a, 0) as u64 + (bn_limb(&a, 1) as u64 << 32))

    // 10^20 / 10^10 = 10^10, remainder 0
    bn_pow10(&a, 20)
    bn_pow10(&b, 10)
    print_num(bn_div_q(&a, &b, &t)) // 10000000000
    print_num(bn_bitlen(&a) as u64) // Rest 0 -> Bitlaenge 0

    // Comparisons
    bn_set_u64(&a, 5)
    bn_set_u64(&b, 4)
    print_num((bn_cmp(&a, &b) == 1) as u64)
    bn_set_u64(&b, 5)
    print_num((bn_cmp(&a, &b) == 0) as u64)
    bn_shl(&b, 64)
    print_num((bn_cmp(&a, &b) == -1) as u64)

    // Subtraction across digit borders: 10^18 - 1
    bn_pow10(&a, 18)
    bn_set_u64(&b, 1)
    bn_sub(&a, &b)
    print_num((bn_is_zero(&a) == false) as u64)
    print_num(bn_limb(&a, 0) as u64 + (bn_limb(&a, 1) as u64 << 32)) // 999999999999999999

    // Digit extraction: 7 with remainder 3 out of 73/10
    bn_set_u64(&a, 73)
    bn_set_u64(&b, 10)
    print_num(bn_div_digit(&a, &b) as u64) // 7
    print_num_nl(bn_limb(&a, 0) as u64) // 3
    return 0
}
