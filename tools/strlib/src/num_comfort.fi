// tools/strlib/src/num_comfort.fi -- SOURCE for a part of lib/std/num.fi.
//
// Round 69, the comfort layer of `std.num`: reading a number WITHOUT an
// output parameter and WITHOUT a pointer/length pair.
//
// WHAT WAS WRONG. The old way needs four lines and knows two truths about
// one address:
//
//     var x: i64 = 0
//     if !num.text_to_i64(s.p, s.n, &x) { ... }
//
// The value comes back through a `*mut`, the failure through the return
// value, and the text has to be taken apart into `s.p, s.n` although a
// `Span` is exactly that pair. The new way is one line:
//
//     let r: num.ParsedI64 = num.parse_i64(s)
//     if !r.ok { ... }        // r.value is the number, r.overflow the reason
//
// Firn returns structs by value (SPEC 13.1, the result location guarantee),
// so an output parameter buys nothing here -- it only costs a line and a
// mutable variable.
//
// NOTHING IS REIMPLEMENTED. `parse_*` calls exactly the `read_*` core that
// `text_to_*` calls too; there is no second parser that could drift away
// from the first. The `text_to_*` forms stay untouched next to it, so that
// every existing caller keeps working.
//
// THE SPAN COMES FROM `str`. That is why this module imports `str`: an
// address is a `*mut u8` outward (docs/ROUND69.md), and a piece of text is
// a `Span`, not two loose parameters.
//
// Include:  //#include tools/strlib/src/num_comfort.fi

// An empty octet buffer BY VALUE -- the counterpart of `bytes_init`, for
// whoever wants to write `var b: num.Bytes = num.bytes_new()` instead of
// spelling out the three fields.
fn bytes_new() -> Bytes {
    return Bytes { ptr: 0 as *mut u8, len: 0, cap: 0 }
}

// ---------------------------------------------------------- The results
//
// `ok` answers the only question the caller usually has: is `value` the
// number that was written there? `overflow` says WHY not, when the digits
// were fine but too many -- the honesty the `read_*` core already had is
// kept, it is only no longer carried in a second output pointer.

struct ParsedI64 {
    ok: bool,
    overflow: bool,
    value: i64,
}

struct ParsedU64 {
    ok: bool,
    overflow: bool,
    value: u64,
}

struct ParsedF64 {
    ok: bool,
    value: f64,
}

// ROUND 71: the same for the single width.
struct ParsedF32 {
    ok: bool,
    value: f32,
}

// "There was nothing to read" -- the form a caller returns when the input
// ended before a number could even be looked for.
fn parsed_i64_none() -> ParsedI64 {
    return ParsedI64 { ok: false, overflow: false, value: 0 }
}

fn parsed_u64_none() -> ParsedU64 {
    return ParsedU64 { ok: false, overflow: false, value: 0 }
}

fn parsed_f64_none() -> ParsedF64 {
    return ParsedF64 { ok: false, value: 0.0 }
}

fn parsed_f32_none() -> ParsedF32 {
    return ParsedF32 { ok: false, value: 0.0 }
}

// ----------------------------------------------------------- The parsers
//
// STRICT, like `text_to_*`: the WHOLE span has to be the number. Leading or
// trailing blanks are NOT swallowed silently -- `s.trim()` is one call and
// says what it does, while a parser that trims on its own would also accept
// " 4 2" halfway.

fn parse_i64(s: str.Span) -> ParsedI64 {
    var v: i64 = 0
    var over: bool = false
    let used: usize = read_i64(s.p, s.n, 0, &v, &over)
    return ParsedI64 { ok: used == s.n && used > 0 && !over, overflow: over,
        value: v }
}

fn parse_u64_base(s: str.Span, base: u32) -> ParsedU64 {
    var v: u64 = 0
    var over: bool = false
    let used: usize = read_u64_base(s.p, s.n, 0, base, &v, &over)
    return ParsedU64 { ok: used == s.n && used > 0 && !over, overflow: over,
        value: v }
}

fn parse_u64(s: str.Span) -> ParsedU64 {
    return parse_u64_base(s, 10)
}

// With a base prefix: 0x/0X = 16, 0b/0B = 2, 0o/0O = 8, otherwise 10 --
// the same rule as `text_to_u64_auto`.
fn parse_u64_auto(s: str.Span) -> ParsedU64 {
    var v: u64 = 0
    let ok: bool = text_to_u64_auto(s.p, s.n, &v)
    return ParsedU64 { ok: ok, overflow: false, value: v }
}

// Floating point runs through `strtod` (correctly rounded). There is no
// overflow flag: outside the f64 range the answer is an infinity, and that
// IS the correctly rounded result.
fn parse_f64(s: str.Span) -> ParsedF64 {
    var v: f64 = 0.0
    let used: usize = read_f64(s.p, s.n, &v)
    return ParsedF64 { ok: used == s.n && used > 0, value: v }
}

// ROUND 71: the same core, one narrowing further.
fn parse_f32(s: str.Span) -> ParsedF32 {
    var v: f32 = 0.0
    let used: usize = read_f32(s.p, s.n, &v)
    return ParsedF32 { ok: used == s.n && used > 0, value: v }
}

// -------------------------------------------------------- Taking it apart
//
// The short form for "a number or a default value" -- the `int.TryParse`
// with an `out` becomes an expression.

fn i64_or(r: ParsedI64, fallback: i64) -> i64 {
    if r.ok {
        return r.value
    }
    return fallback
}

fn u64_or(r: ParsedU64, fallback: u64) -> u64 {
    if r.ok {
        return r.value
    }
    return fallback
}

fn f64_or(r: ParsedF64, fallback: f64) -> f64 {
    if r.ok {
        return r.value
    }
    return fallback
}

fn f32_or(r: ParsedF32, fallback: f32) -> f32 {
    if r.ok {
        return r.value
    }
    return fallback
}

// The results are VALUES; their methods therefore take `self`, not `*self`.
impl ParsedI64 {
    fn value_or(self, fallback: i64) -> i64 { return i64_or(self, fallback) }
}

impl ParsedU64 {
    fn value_or(self, fallback: u64) -> u64 { return u64_or(self, fallback) }
}

impl ParsedF64 {
    fn value_or(self, fallback: f64) -> f64 { return f64_or(self, fallback) }
}

impl ParsedF32 {
    fn value_or(self, fallback: f32) -> f32 { return f32_or(self, fallback) }
}
