// expect_out: 2000 2000 2000
// Round-trip guarantee in the small (SPEC 8.4, Z6): 2000 pseudo-random bit
// patterns (xorshift64*, without an input file -- the test stands on its own)
// go through dtoa -> strtod and have to come back BIT-IDENTICAL. On top of
// that it is checked that strtod consumes the produced text completely and
// that the shortest digit sequence never has more than 17 digits (no double
// needs more).
//
// The big run over >= 100,000 doubles compared against Rust is in
// tools/dtoa_vectors/ (run.sh) -- it takes too long for every test round.
//#include lib/str/alloc.fi
//#include lib/str/bytes.fi
//#include lib/str/print.fi
//#include lib/num/bignum.fi
//#include lib/num/strtod.fi
//#include lib/num/dtoa.fi

fn xorshift(s: *mut u64) -> u64 {
    var x: u64 = *s
    x = x ^ (x >> 12)
    x = x ^ (x << 25)
    x = x ^ (x >> 27)
    *s = x
    // ROUND 72: xorshift* -- the final multiplication is SUPPOSED to
    // wrap, that is what makes it a mixing step. `*%` says so.
    return x *% 2685821657736338717
}

// Significant digits of the shortest representation (without formatting zeros).
fn significant_digits(bits: u64, ws: *mut u8) -> usize {
    var digits: [u8; 32] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    var k10: i64 = 0
    return dtoa_digits(bits, &digits[0], &k10, ws)
}

fn main() -> i32 {
    let ws: *mut u8 = heap_alloc(DTOA_WS_BYTES)
    var out: Bytes = Bytes { ptr: 0 as *mut u8, len: 0, cap: 0, }
    bytes_init(&out)
    var seed: u64 = 88172645463325252
    var i: usize = 0
    var equal: usize = 0
    var whole: usize = 0
    var short: usize = 0
    while i < 2000 {
        var bits: u64 = xorshift(&seed)
        // NaN/infinity have no digit representation, +-0 is checked separately
        // in 305: both are mapped onto a finite value.
        if (bits >> 52) & 0x7FF == 0x7FF {
            bits = bits ^ 0x0010000000000000
        }
        if (bits << 1) == 0 {
            bits = 1
        }
        dtoa(bits, &out, ws)
        var used: usize = 0
        let back: u64 = strtod(out.ptr, out.len, ws, &used)
        if back == bits {
            equal = equal + 1
        }
        if used == out.len {
            whole = whole + 1
        }
        // 17 significant digits are enough for every double.
        if significant_digits(bits, ws) <= 17 {
            short = short + 1
        }
        i = i + 1
    }
    print_num(equal as u64)
    print_num(whole as u64)
    print_num_nl(short as u64)
    bytes_free(&out)
    return 0
}
