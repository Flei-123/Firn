// expect_out: 2000 2000 2000
// Rueckwandlungsgarantie im Kleinen (SPEC §8.4, Z6): 2000 pseudozufaellige
// Bitmuster (xorshift64*, ohne Eingabedatei — der Test ist eigenstaendig)
// durchlaufen dtoa -> strtod und muessen BITGLEICH zurueckkommen. Zusaetzlich
// wird geprueft, dass strtod den erzeugten Text vollstaendig verbraucht und
// dass die kuerzeste Ziffernfolge nie mehr als 17 Ziffern hat (mehr braucht
// kein Double).
//
// Der grosse Lauf ueber >= 100.000 Doubles mit Vergleich gegen Rust steht in
// tools/dtoa_vectors/ (run.sh) — er dauert zu lange fuer jede Testrunde.
//#include lib/str/alloc.fi
//#include lib/str/bytes.fi
//#include lib/str/print.fi
//#include lib/num/bignum.fi
//#include lib/num/strtod.fi
//#include lib/num/dtoa.fi

fn xorshift(s: *mut u64) -> u64 {
    var x: u64 = *s
    x = x ^ (x >> 12)
    x = x ^ (x << 25)
    x = x ^ (x >> 27)
    *s = x
    return x * 2685821657736338717
}

// Signifikante Ziffern der kuerzesten Darstellung (ohne Formatierungsnullen).
fn signifikante_ziffern(bits: u64, ws: *mut u8) -> usize {
    var digits: [u8; 32] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    var k10: i64 = 0
    return dtoa_digits(bits, &digits[0], &k10, ws)
}

fn main() -> i32 {
    let ws: *mut u8 = heap_alloc(DTOA_WS_BYTES)
    var out: Bytes = Bytes{ ptr: 0 as *mut u8, len: 0, cap: 0, }
    bytes_init(&out)
    var seed: u64 = 88172645463325252
    var i: usize = 0
    var gleich: usize = 0
    var ganz: usize = 0
    var kurz: usize = 0
    while i < 2000 {
        var bits: u64 = xorshift(&seed)
        // NaN/Unendlich haben keine Zifferndarstellung, +-0 wird gesondert
        // in 305 geprueft: beides wird auf einen endlichen Wert abgebildet.
        if (bits >> 52) & 0x7FF == 0x7FF {
            bits = bits ^ 0x0010000000000000
        }
        if (bits << 1) == 0 {
            bits = 1
        }
        dtoa(bits, &out, ws)
        var used: usize = 0
        let zurueck: u64 = strtod(out.ptr, out.len, ws, &used)
        if zurueck == bits {
            gleich = gleich + 1
        }
        if used == out.len {
            ganz = ganz + 1
        }
        // 17 signifikante Ziffern reichen fuer jeden Double.
        if signifikante_ziffern(bits, ws) <= 17 {
            kurz = kurz + 1
        }
        i = i + 1
    }
    print_num(gleich as u64)
    print_num(ganz as u64)
    print_num_nl(kurz as u64)
    bytes_free(&out)
    return 0
}
