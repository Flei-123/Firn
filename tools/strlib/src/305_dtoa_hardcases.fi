// expect_out: 0.1 1e+23 5e-324 9007199254740992 1.7976931348623157e+308 1e+21 1e-7 1234.5678 0.000001 100 0 0 1e-320 2.225073858507201e-308 123456789012345680000 5e-10 0.3 0.7 9.109383e-31 0.3333333333333333 -42.5 1e+300 4.35 0.00001 1234567890123456800 Infinity -Infinity NaN 24
// Shortest double output with a round-trip guarantee (SPEC 8.4, Z6).
// The classic hard cases are checked as BIT PATTERNS (the language has no
// f64 yet): 0.1, 1e23, 5e-324, 2^53, largest double, 1e21/1e-7 (the borders
// of the ECMAScript notations), subnormals, -0, infinity and NaN.
// Finally: for 24 of the 25 finite cases strtod(dtoa(x)) has to be x again
// (-0 is the one exception: ECMAScript writes "0" for it).
//#include lib/str/alloc.fi
//#include lib/str/bytes.fi
//#include lib/str/print.fi
//#include lib/num/bignum.fi
//#include lib/num/strtod.fi
//#include lib/num/dtoa.fi

fn show(bits: u64, out: *mut Bytes, ws: *mut u8) {
    dtoa(bits, out, ws)
    bytes_push(out, 32 as u8)
    print_bytes_raw(out)
}

// dtoa -> strtod has to lead back bit-identically.
fn roundtrip(bits: u64, out: *mut Bytes, ws: *mut u8) -> usize {
    dtoa(bits, out, ws)
    var used: usize = 0
    let back: u64 = strtod((*out).ptr, (*out).len, ws, &used)
    if back == bits && used == (*out).len {
        return 1
    }
    return 0
}

fn main() -> i32 {
    let ws: *mut u8 = heap_alloc(DTOA_WS_BYTES)
    var out: Bytes = Bytes { ptr: 0 as *mut u8, len: 0, cap: 0, }
    bytes_init(&out)
    show(4591870180066957722, &out, ws)
    show(4950912855330343670, &out, ws)
    show(1, &out, ws)
    show(4845873199050653696, &out, ws)
    show(9218868437227405311, &out, ws)
    show(4921056587992461136, &out, ws)
    show(4502148214488346440, &out, ws)
    show(4653144502051863213, &out, ws)
    show(4517329193108106637, &out, ws)
    show(4636737291354636288, &out, ws)
    show(0, &out, ws)
    show(9223372036854775808, &out, ws)
    show(2024, &out, ws)
    show(4503599627370495, &out, ws)
    show(4907451598986591450, &out, ws)
    show(4467902934002620053, &out, ws)
    show(4599075939470750515, &out, ws)
    show(4604480259023595110, &out, ws)
    show(4157519394783087270, &out, ws)
    show(4599676419421066581, &out, ws)
    show(13854550197419376640, &out, ws)
    show(9094988921128908188, &out, ws)
    show(4616583683022153318, &out, ws)
    show(4532020583610935537, &out, ws)
    show(4877717327635671425, &out, ws)
    show(9218868437227405312, &out, ws)
    show(18442240474082181120, &out, ws)
    show(9221120237041090560, &out, ws)
    var ok: usize = 0
    ok = ok + roundtrip(4591870180066957722, &out, ws)
    ok = ok + roundtrip(4950912855330343670, &out, ws)
    ok = ok + roundtrip(1, &out, ws)
    ok = ok + roundtrip(4845873199050653696, &out, ws)
    ok = ok + roundtrip(9218868437227405311, &out, ws)
    ok = ok + roundtrip(4921056587992461136, &out, ws)
    ok = ok + roundtrip(4502148214488346440, &out, ws)
    ok = ok + roundtrip(4653144502051863213, &out, ws)
    ok = ok + roundtrip(4517329193108106637, &out, ws)
    ok = ok + roundtrip(4636737291354636288, &out, ws)
    ok = ok + roundtrip(0, &out, ws)
    ok = ok + roundtrip(2024, &out, ws)
    ok = ok + roundtrip(4503599627370495, &out, ws)
    ok = ok + roundtrip(4907451598986591450, &out, ws)
    ok = ok + roundtrip(4467902934002620053, &out, ws)
    ok = ok + roundtrip(4599075939470750515, &out, ws)
    ok = ok + roundtrip(4604480259023595110, &out, ws)
    ok = ok + roundtrip(4157519394783087270, &out, ws)
    ok = ok + roundtrip(4599676419421066581, &out, ws)
    ok = ok + roundtrip(13854550197419376640, &out, ws)
    ok = ok + roundtrip(9094988921128908188, &out, ws)
    ok = ok + roundtrip(4616583683022153318, &out, ws)
    ok = ok + roundtrip(4532020583610935537, &out, ws)
    ok = ok + roundtrip(4877717327635671425, &out, ws)
    print_num_nl(ok as u64)
    bytes_free(&out)
    return 0
}
