// expect_out: 0.1 1e+23 5e-324 9007199254740992 1.7976931348623157e+308 1e+21 1e-7 1234.5678 0.000001 100 0 0 1e-320 2.225073858507201e-308 123456789012345680000 5e-10 0.3 0.7 9.109383e-31 0.3333333333333333 -42.5 1e+300 4.35 0.00001 1234567890123456800 Infinity -Infinity NaN 24
// Kuerzeste Double-Ausgabe mit Rueckwandlungsgarantie (SPEC §8.4, Z6).
// Geprueft werden die klassischen Haertefaelle als BITMUSTER (die Sprache hat
// noch kein f64): 0.1, 1e23, 5e-324, 2^53, groesster Double, 1e21/1e-7 (die
// Grenzen der ECMAScript-Schreibweisen), Denormale, -0, Unendlich und NaN.
// Zuletzt: fuer 24 der 25 endlichen Faelle muss strtod(dtoa(x)) wieder x sein
// (-0 ist die eine Ausnahme: ECMAScript schreibt dafuer "0").
//#include lib/str/alloc.fi
//#include lib/str/bytes.fi
//#include lib/str/print.fi
//#include lib/num/bignum.fi
//#include lib/num/strtod.fi
//#include lib/num/dtoa.fi

fn zeige(bits: u64, out: *mut Bytes, ws: *mut u8) {
    dtoa(bits, out, ws)
    bytes_push(out, 32 as u8)
    print_bytes_raw(out)
}

// dtoa -> strtod muss bitgleich zurueckfuehren.
fn rundlauf(bits: u64, out: *mut Bytes, ws: *mut u8) -> usize {
    dtoa(bits, out, ws)
    var used: usize = 0
    let zurueck: u64 = strtod((*out).ptr, (*out).len, ws, &used)
    if zurueck == bits && used == (*out).len {
        return 1
    }
    return 0
}

fn main() -> i32 {
    let ws: *mut u8 = heap_alloc(DTOA_WS_BYTES)
    var out: Bytes = Bytes{ ptr: 0 as *mut u8, len: 0, cap: 0, }
    bytes_init(&out)
    zeige(4591870180066957722, &out, ws)
    zeige(4950912855330343670, &out, ws)
    zeige(1, &out, ws)
    zeige(4845873199050653696, &out, ws)
    zeige(9218868437227405311, &out, ws)
    zeige(4921056587992461136, &out, ws)
    zeige(4502148214488346440, &out, ws)
    zeige(4653144502051863213, &out, ws)
    zeige(4517329193108106637, &out, ws)
    zeige(4636737291354636288, &out, ws)
    zeige(0, &out, ws)
    zeige(9223372036854775808, &out, ws)
    zeige(2024, &out, ws)
    zeige(4503599627370495, &out, ws)
    zeige(4907451598986591450, &out, ws)
    zeige(4467902934002620053, &out, ws)
    zeige(4599075939470750515, &out, ws)
    zeige(4604480259023595110, &out, ws)
    zeige(4157519394783087270, &out, ws)
    zeige(4599676419421066581, &out, ws)
    zeige(13854550197419376640, &out, ws)
    zeige(9094988921128908188, &out, ws)
    zeige(4616583683022153318, &out, ws)
    zeige(4532020583610935537, &out, ws)
    zeige(4877717327635671425, &out, ws)
    zeige(9218868437227405312, &out, ws)
    zeige(18442240474082181120, &out, ws)
    zeige(9221120237041090560, &out, ws)
    var ok: usize = 0
    ok = ok + rundlauf(4591870180066957722, &out, ws)
    ok = ok + rundlauf(4950912855330343670, &out, ws)
    ok = ok + rundlauf(1, &out, ws)
    ok = ok + rundlauf(4845873199050653696, &out, ws)
    ok = ok + rundlauf(9218868437227405311, &out, ws)
    ok = ok + rundlauf(4921056587992461136, &out, ws)
    ok = ok + rundlauf(4502148214488346440, &out, ws)
    ok = ok + rundlauf(4653144502051863213, &out, ws)
    ok = ok + rundlauf(4517329193108106637, &out, ws)
    ok = ok + rundlauf(4636737291354636288, &out, ws)
    ok = ok + rundlauf(0, &out, ws)
    ok = ok + rundlauf(2024, &out, ws)
    ok = ok + rundlauf(4503599627370495, &out, ws)
    ok = ok + rundlauf(4907451598986591450, &out, ws)
    ok = ok + rundlauf(4467902934002620053, &out, ws)
    ok = ok + rundlauf(4599075939470750515, &out, ws)
    ok = ok + rundlauf(4604480259023595110, &out, ws)
    ok = ok + rundlauf(4157519394783087270, &out, ws)
    ok = ok + rundlauf(4599676419421066581, &out, ws)
    ok = ok + rundlauf(13854550197419376640, &out, ws)
    ok = ok + rundlauf(9094988921128908188, &out, ws)
    ok = ok + rundlauf(4616583683022153318, &out, ws)
    ok = ok + rundlauf(4532020583610935537, &out, ws)
    ok = ok + rundlauf(4877717327635671425, &out, ws)
    print_num_nl(ok as u64)
    bytes_free(&out)
    return 0
}
