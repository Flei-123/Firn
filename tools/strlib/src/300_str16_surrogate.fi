// expect_out: 3 97 55296 98 0 0 5 97 239 191 189 98 5 97 237 160 128 98 1 55296
// PFLICHT-NEGATIVTEST zu SPEC §8.2 (Modul str, Ziel-Punkt 4b):
// Ein Str16 mit einem EINZELNEN 0xD800 wird konstruiert; geprueft wird,
//   * dass das ungepaarte Surrogat unveraendert ERHALTEN bleibt,
//   * dass to_utf8() NICHTS liefert (Ergebnis false, Ziel leer),
//   * dass to_utf8_lossy() U+FFFD (EF BF BD) liefert,
//   * dass WTF-8 verlustfrei ist (ED A0 80 und zurueck).
//
// Ausgabe (eine Zeile, Zahlen mit Leerzeichen):
//   len u0 u1 u2 | to_utf8_ok to_utf8_len | lossy_len lossy... |
//   wtf8_len wtf8... | wtf8_rt_gleich  u0_nach_rueckwandlung
//#include lib/str/alloc.fi
//#include lib/str/bytes.fi
//#include lib/str/str16.fi
//#include lib/str/utf8.fi
//#include lib/str/print.fi

fn main() -> i32 {
    var s: Str16 = Str16{ ptr: 0 as *mut u16, len: 0, cap: 0, }
    str16_init(&s)
    str16_push(&s, 97 as u16)      // 'a'
    str16_push(&s, 0xD800 as u16)  // EINZELNES hohes Surrogat, ohne Partner
    str16_push(&s, 98 as u16)      // 'b'

    // 1. Das Surrogat bleibt erhalten — Str16 prueft und normalisiert nichts.
    print_num(str16_len(&s) as u64)
    print_num(str16_at(&s, 0) as u64)
    print_num(str16_at(&s, 1) as u64)
    print_num(str16_at(&s, 2) as u64)

    var out: Bytes = Bytes{ ptr: 0 as *mut u8, len: 0, cap: 0, }
    bytes_init(&out)

    // 2. to_utf8() muss scheitern und nichts liefern.
    let ok: bool = str16_to_utf8(&s, &out)
    print_num(ok as u64)
    print_num(bytes_len(&out) as u64)

    // 3. to_utf8_lossy() ersetzt durch U+FFFD = EF BF BD.
    str16_to_utf8_lossy(&s, &out)
    print_num(bytes_len(&out) as u64)
    var i: usize = 0
    while i < bytes_len(&out) {
        print_num(bytes_at(&out, i) as u64)
        i = i + 1
    }

    // 4. WTF-8 haelt das Surrogat verlustfrei: ED A0 80.
    str16_to_wtf8(&s, &out)
    print_num(bytes_len(&out) as u64)
    i = 0
    while i < bytes_len(&out) {
        print_num(bytes_at(&out, i) as u64)
        i = i + 1
    }
    var back: Str16 = Str16{ ptr: 0 as *mut u16, len: 0, cap: 0, }
    str16_init(&back)
    wtf8_to_str16(&out, &back)
    print_num(str16_eq(&s, &back) as u64)
    print_num_nl(str16_at(&back, 1) as u64)

    str16_free(&s)
    str16_free(&back)
    bytes_free(&out)
    return 0
}
