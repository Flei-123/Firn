// expect_exit: 0
// Zahlenstrom: liest 8-Byte-Bitmuster von der Standardeingabe, schreibt fuer
// jedes die kuerzeste Darstellung (lib/num/dtoa.fi) als Textzeile und prueft
// zugleich, dass strtod (lib/num/strtod.fi) daraus wieder GENAU dasselbe
// Bitmuster macht. Exit-Code 0 nur, wenn jede Rueckwandlung bitgleich war;
// die Zusammenfassung geht auf die Fehlerausgabe (fd 2), damit die
// Standardausgabe rein aus Zahlen besteht.
//
// Ohne Eingabe (leere Standardeingabe) laeuft das Programm sofort mit 0 durch —
// so kann test.sh es gefahrlos mituebersetzen und ausfuehren.
//#include lib/str/alloc.fi
//#include lib/str/bytes.fi
//#include lib/str/print.fi
//#include lib/num/bignum.fi
//#include lib/num/strtod.fi
//#include lib/num/dtoa.fi

const CHUNK: usize = 8192

fn read_block(buf: *mut u8, n: usize) -> usize {
    var got: usize = 0
    var weiter: bool = true
    while got < n && weiter {
        let r: i64 = syscall(SYS_READ, 0, (buf as usize + got) as i64, (n - got) as i64)
        if r <= 0 {
            weiter = false
        } else {
            got = got + r as usize
        }
    }
    return got
}

fn main() -> i32 {
    let ws: *mut u8 = heap_alloc(DTOA_WS_BYTES)
    let buf: *mut u8 = heap_alloc(CHUNK)
    var out: Bytes = Bytes{ ptr: 0 as *mut u8, len: 0, cap: 0, }
    var zeile: Bytes = Bytes{ ptr: 0 as *mut u8, len: 0, cap: 0, }
    bytes_init(&out)
    bytes_init(&zeile)
    var gesamt: u64 = 0
    var schlecht: u64 = 0
    var weiter: bool = true
    while weiter {
        let got: usize = read_block(buf, CHUNK)
        let anz: usize = got / 8
        if anz == 0 {
            weiter = false
        }
        var i: usize = 0
        while i < anz {
            let bits: u64 = ld64(buf, i)
            dtoa(bits, &out, ws)
            var used: usize = 0
            let zurueck: u64 = strtod(out.ptr, out.len, ws, &used)
            if zurueck != bits || used != out.len {
                schlecht = schlecht + 1
            }
            gesamt = gesamt + 1
            bytes_clear(&zeile)
            bytes_append(&zeile, out.ptr, out.len)
            bytes_push(&zeile, 10 as u8)
            print_bytes_raw(&zeile)
            i = i + 1
        }
        if got < CHUNK {
            weiter = false
        }
    }
    // Zusammenfassung auf fd 2 (Standardausgabe bleibt reiner Text)
    bytes_clear(&zeile)
    dtoa_push_int(&zeile, gesamt as i64)
    bytes_push(&zeile, 32 as u8)
    dtoa_push_int(&zeile, schlecht as i64)
    bytes_push(&zeile, 10 as u8)
    write_all(2, zeile.ptr, zeile.len)
    if schlecht == 0 {
        return 0
    }
    return 1
}
