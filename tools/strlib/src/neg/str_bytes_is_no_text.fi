// expect_error: ?:16 has type *mut Bytes, expected *mut Str16
// expect_error_count: 1
// SPEC 8.1: `Bytes` is NO text and never silently becomes a
// string. The attempt to treat raw octets like WTF-16 code units
// has to be a compile error -- no warning, no
// silent reinterpretation.
//#include lib/str/alloc.fi
//#include lib/str/bytes.fi
//#include lib/str/str16.fi

fn main() -> i32 {
    var b: Bytes = Bytes { ptr: 0 as *mut u8, len: 0, cap: 0, }
    bytes_init(&b)
    bytes_push(&b, 65 as u8)
    str16_push(&b, 65 as u16) // FEHLERZEILE
    return 0
}
