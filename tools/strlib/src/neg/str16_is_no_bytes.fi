// expect_error_count: 1
// Die Gegenrichtung: WTF-16-Codeeinheiten sind keine Oktettfolge. Wer aus
// Str16 UTF-8 machen will, muss die ausdrueckliche Umwandlung nehmen
// (str16_to_utf8 / str16_to_utf8_lossy, SPEC §8.2).
//#include lib/str/alloc.fi
//#include lib/str/bytes.fi
//#include lib/str/str16.fi

fn main() -> i32 {
    var s: Str16 = Str16{ ptr: 0 as *mut u16, len: 0, cap: 0, }
    str16_init(&s)
    str16_push(&s, 0xD800 as u16)
    return bytes_is_str(&s) as i32  // FEHLERZEILE
}
