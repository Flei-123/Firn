// expect_exit: 0
// tools/strlib/comfort/soak.fi -- the endurance run for the input layer of
// round 69, WITH its own counter-check.
//
// THE PROMISE UNDER TEST: `io.read_text()` hands out a `Text` that owns its
// octets; `text_free` gives them back to the operating system
// (`rt.heap_free` is `munmap`). A program that reads a million lines and
// releases each one must therefore NOT grow.
//
// A promise without a counter-check is worth nothing: a measurement that
// never strikes proves nothing. That is why THE SAME program has both
// behaviours, and the first line of the input chooses:
//
//     "free"  -- every `Text` is released     -> RSS has to stay flat
//     "keep"  -- no `Text` is released        -> RSS HAS to climb
//
// One program, one loop, one difference: the missing `free`. If the "keep"
// run stayed flat too, the measurement would be broken and the "free" run
// would prove nothing.
//
// RSS is read out of /proc/self/statm (field 2 = resident pages), by the
// program itself -- no sampling from outside that could race with the run.
// And it is read WITH the comfort layer, which walks it once more:
// `io.span_of_buf`, `str.divisor_whitespace`, `num.parse_u64`.
import std.io
import std.rt
import std.str
import std.num

// The resident pages of this process, or 0 if /proc is not there.
fn rss_pages() -> u64 {
    var path: [u8; 17] = "/proc/self/statm\0"
    var b: rt.Buf = rt.buf_new()
    if !io.read_file(rt.addr_of(&path[0]), &b) {
        rt.buf_free(&b)
        return 0
    }
    var fields: str.Divisor = str.divisor_whitespace(io.span_of_buf(&b))
    var part: str.Span = str.span_empty()
    var i: usize = 0
    var pages: u64 = 0
    while str.divisor_next(&fields, &part) {
        if i == 1 {
            pages = num.parse_u64(part).value_or(0)
        }
        i = i + 1
    }
    rt.buf_free(&b)
    return pages
}

fn main() -> i32 {
    var mode: io.Text = io.read_text()
    if !mode.is_ok() {
        io.fmt_print_line(f"soak: the first line has to be 'free' or 'keep'")
        mode.free()
        return 2
    }
    var keep_word: io.Text = io.text_of(f"keep")
    let keep: bool = str.equal(mode.span(), keep_word.span())
    keep_word.free()
    mode.free()

    let start: u64 = rss_pages()
    var lines: usize = 0
    var first: u64 = 0
    var last: u64 = 0
    var running: bool = true
    while running {
        var line: io.Text = io.read_text()
        if line.is_ok() {
            lines = lines + 1
            if lines % 10000 == 0 {
                let here: u64 = rss_pages()
                if first == 0 {
                    first = here
                }
                last = here
            }
        } else {
            running = false
        }
        // THE ONE DIFFERENCE between the run and its counter-check.
        if !keep {
            line.free()
        }
    }
    if first == 0 {
        first = start
        last = rss_pages()
    }
    io.fmt_print(f"lines {lines} rss_start {start} rss_first {first} ")
    io.fmt_print_line(f"rss_last {last}")
    return 0
}
