// SPDX-License-Identifier: MPL-2.0
// tools/compress/repro_release_fast_loop.fi -- a miscompilation found while
// writing lib/compress (xxHash's tail): in --opt-level=release-fast the
// SECOND while loop (`while i < (*s).used`) is skipped when it follows a first
// loop over the same index `while i + 4 <= (*s).used` and both conditions read
// the bound through a pointer. The other three levels print f441eb8, release-
// fast prints ba5aa115 (the value without the second loop). Copying the bound
// into a local first (`let used = (*s).used`) makes release-fast right again;
// lib/compress/common.fi does that. Not part of test.sh (it is a repro, not a
// test of this change).
import std.rt
import std.io

const P3: u32 = 0xC2B2AE3D
const P4: u32 = 0x27D4EB2F

fn rotl32(x: u32, n: u32) -> u32 {
    return (x << n) | (x >> (32 - n))
}

fn ld32le(p: u64, off: usize) -> u32 {
    return *((p + off as u64) as *mut u32)
}

struct S { mem: [u8; 16], used: usize }

fn fin(s: *mut S, h0: u32) -> u32 {
    var h: u32 = h0
    let m: u64 = (&(*s).mem[0]) as u64
    var i: usize = 0
    while i + 4 <= (*s).used {
        h = rotl32(h +% (ld32le(m, i) *% P3), 17) *% P4
        i = i + 4
    }
    while i < (*s).used {
        h = rotl32(h +% ((rt.ld8(m, i) as u32) *% 374761393), 11) *% 2654435761
        i = i + 1
    }
    return h
}

fn pr(tag: str, v: u32) {
    io.print(tag)
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_hex_u64(&nb, v as u64, 1)
    io.print_bytes(rt.buf_ptr(&nb), rt.buf_len(&nb))
    io.print_line("")
}

fn main() -> i32 {
    var s: S = S { mem: [0; 16], used: 0 }
    var i: usize = 0
    while i < 15 {
        s.mem[i] = (i * 7 + 1) as u8
        s.used = s.used + 1
        i = i + 1
    }
    pr("fin ", fin(&s, 12345))
    return 0
}
