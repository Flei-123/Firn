// SPDX-License-Identifier: GPL-2.0-only
// tools/state/kernel.fi -- global state under `profile kernel` (round 89).
//
// This is the shape the round exists for: a counter and a ring buffer that
// no collector and no runtime is involved in. Two things are being proved
// at once here:
//
//   * the `static`s land in the object file's own `.bss`/`.rodata`, with
//     no `_start`, no libc and no collector anywhere near them, and
//   * the program brings its OWN ending. Without `#[panic_handler]` the
//     bounds check of `RING[at]` would leave an undefined reference to
//     `osum_panic` for the kernel author to define in assembly; with it,
//     the only name left open is the one this file means to leave open.
profile kernel

extern fn serial_out(c: u8);

static mut TICKS: u64 = 0
static mut RING: [u8; 256] = [0; 256]
static BANNER: [u8; 4] = "boot"

#[panic_handler]
fn kpanic(msg: *u8, len: u64, a: i64, b: i64, code: u64) {
    var i: u64 = 0
    while i < len {
        serial_out(*((msg as u64 + i) as *mut u8))
        i = i +% 1
    }
    serial_out(10 as u8)
    // A kernel does not exit; it stops.
    while true {}
}

fn tick() -> u64 {
    TICKS = TICKS +% 1
    return TICKS
}

fn banner() {
    var i: usize = 0
    while i < 4 {
        serial_out(BANNER[i])
        i = i + 1
    }
}

fn store(v: u8) {
    let at: usize = (TICKS & 255) as usize
    RING[at] = v
}
