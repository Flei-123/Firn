// tools/state/counter.fi -- the shortest thing a `static` is for: a place
// that survives the function that wrote it (round 89, SPEC 14.1.statics).
static mut COUNT: u64 = 0
static TABLE: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8]
static mut BUF: [i32; 4] = [0, 0, 0, 0]
static START: i32 = 41

fn bump() -> u64 {
    COUNT = COUNT + 1
    return COUNT
}

fn main() -> i32 {
    bump()
    bump()
    bump()
    BUF[2] = 9
    let t: u8 = TABLE[5]
    return (COUNT as i32) + (t as i32) + BUF[2] + START
}
