// SPDX-License-Identifier: GPL-2.0-only
// tools/state/sections.fi -- one `static` per section, so that `readelf`
// has something to answer about (round 89).
//   ZED   `mut`, all zero  -> .bss
//   SEED  `mut`, a value   -> .data
//   NAMES no `mut`         -> .rodata
static mut ZED: [u8; 32] = [0; 32]
static mut SEED: u32 = 12345
static NAMES: [u8; 4] = "firn"

fn main() -> i32 {
    ZED[3] = 7
    SEED = SEED + 1
    return (ZED[3] as i32) + ((SEED - 12345) as i32) + (NAMES[0] as i32) - 102
}
