// tools/state/table.fi -- an aggregate `static`: a table read out of
// `.rodata`, a struct in `.data`, and a repetition `[0; n]` in `.bss`.
struct Point { x: i32, y: i32 }

static SQUARES: [i32; 6] = [0, 1, 4, 9, 16, 25]
static ORIGIN: Point = Point { x: 3, y: 4 }
static mut SCRATCH: [u8; 64] = [0; 64]
static GREETING: [u8; 5] = "hello"

fn main() -> i32 {
    SCRATCH[7] = 11
    var sum: i32 = 0
    var i: usize = 0
    while i < 6 {
        sum = sum + SQUARES[i]
        i = i + 1
    }
    // 55 + 3 + 4 + 11 - 31 = 42
    return sum + ORIGIN.x + ORIGIN.y + (SCRATCH[7] as i32) - (GREETING[0] as i32) + 73
}
