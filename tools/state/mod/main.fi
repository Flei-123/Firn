// tools/state/mod/main.fi -- another file writes it, this one reads it.
// If a `static` were one copy per file the answer would be 7, not 9.
import counter

fn main() -> i32 {
    counter.hit()
    counter.hit()
    return (counter.total as i32) + (counter.LIMIT as i32)
}
