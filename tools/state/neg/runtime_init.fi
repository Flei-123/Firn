// tools/state/neg/runtime_init.fi -- THE counter-check of round 89.
//
// An initial value that is not evaluable at compile time is refused. That
// refusal is what makes an initialisation ORDER unnecessary rather than
// merely undocumented: what goes into the object file is a finished
// sequence of octets, not a program that has to run before `main`.
static mut PID: i32 = syscall(39) as i32

fn main() -> i32 {
    return PID
}
