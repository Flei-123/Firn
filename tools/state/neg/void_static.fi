// tools/state/neg/void_static.fi -- a `static` of a type with no storage
// has no place to be, and saying so is better than emitting a zero-length
// symbol nobody can point at.
struct Empty {}

static mut NOTHING: Empty = Empty {}

fn main() -> i32 {
    return 0
}
