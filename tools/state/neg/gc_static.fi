// SPDX-License-Identifier: GPL-2.0-only
// tools/state/neg/gc_static.fi -- a `static Gc[T]` is refused, and the
// message says why: the root set of the collector is the stack and the
// callee-saved registers (SPEC 3.5.3), and a data section entry is
// neither. Pretending otherwise would produce a use-after-free that no
// test catches reliably.
gc class Node { v: i32 }

static mut HEAD: Gc[Node] = 0

fn main() -> i32 {
    return 0
}
