// tools/state/neg/write_const.fi -- a `static` without `mut` is a place
// that is read and not written. `.rodata` is where it lands, and the
// loader maps that read-only, so the refusal and the section agree.
static K: i32 = 3

fn main() -> i32 {
    K = 4
    return K
}
