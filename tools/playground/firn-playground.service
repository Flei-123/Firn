[Unit]
Description=Firn Playground
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/jarvis/data/firn-playground/app
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PLAYGROUND_HOST=0.0.0.0
Environment=PLAYGROUND_PORT=8110
Environment=PLAYGROUND_FIRNC=/root/jarvis/data/firn-playground/firnc
Environment=PLAYGROUND_FIRNLIB=/root/jarvis/data/firn-playground/lib
ExecStart=/usr/bin/python3 /root/jarvis/data/firn-playground/app/server.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
