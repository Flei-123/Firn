fn main() {
    let s: str = "  Firn makes small fast programs  "
    let t = s.trim()
    println(t.to_upper())
    println(t.replace("small", "tiny"))
    let words = t.split(" ")
    println(f"{words.len()} words, first: {words[0]}")
    println(",".join(words))
    println(t.substring(0, 4).pad_right(8) + "|")
    println(f"index of fast: {t.index_of("fast")}")
}
