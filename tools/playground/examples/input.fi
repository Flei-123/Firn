fn main() {
    print("Name: ")
    let name = io.read_line()
    println(f"Hello, {name}!")
    print("How many numbers? ")
    let count = parse.to_i32(io.read_line()) catch 0
    var sum: int = 0
    for i in 0..count {
        print(f"number {i + 1}: ")
        sum += parse.to_i32(io.read_line()) catch 0
    }
    println(f"sum = {sum}")
}
