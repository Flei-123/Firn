fn divmod(a: int, b: int) -> (int, int) {
    return (a / b, a % b)
}

fn minmax(a: int, b: int) -> (int, int) {
    if a < b {
        return (a, b)
    }
    return (b, a)
}

fn main() {
    let (q, r) = divmod(17, 5)
    println(f"17 / 5 = {q} remainder {r}")
    let t = minmax(9, 4)
    println(f"min {t.0}, max {t.1}")
}
