fn work(n: i64) -> i64 {
    var acc: i64 = 0
    var i: i64 = 0
    while i < n {
        acc = (acc + i * i) % 1000003
        i += 1
    }
    return acc
}

fn main() {
    let t0: u64 = time.millis()
    let r = work(50000000)
    let t1: u64 = time.millis()
    println(f"result = {r}")
    println(f"took {t1 - t0} ms")
    time.sleep_ms(100)
    println(f"after sleep: {time.millis() - t1} ms")
}
