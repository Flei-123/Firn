fn main() {
    var v = Vec[int].new()
    v.push(5)
    v.push(2)
    v.push(9)
    v.push(1)
    v.sort()
    println(f"sorted: {v.get(0)} {v.get(1)} {v.get(2)} {v.get(3)}")
    println(f"len={v.len()} last={v.last()} has9={v.contains(9)}")
    var total: int = 0
    for x in v {
        total += x
    }
    println(f"sum={total}")
}
