struct Point {
    x: int,
    y: int,
}

fn main() {
    let name: str = "Firn"
    let version: int = 1
    let ratio: double = 0.1 + 0.2
    let p = Point { x: 3, y: 4 }
    println(f"{name} v{version}")
    println(f"ratio = {ratio}")
    println(f"point = ({p.x}, {p.y}), dist2 = {p.x * p.x + p.y * p.y}")
    println(format("{0} + {1} = {2}", 2, 3, 2 + 3))
}
