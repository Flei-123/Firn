// SPDX-License-Identifier: MPL-2.0
// tools/modreload/mod.fi -- an example MOD for the hot-reload prototype.
// Built by run.sh as a shared object (firnc --pic -c + ld -shared); the host
// (host.fi) loads it with std.dynlib. Entry points are plain C-ABI symbols;
// the "entry table" is the object's dynamic symbol table.
//
//   mod_abi() -> u64                    ABI number the host checks (1)
//   mod_init(state) -> i64              first load: state is zeroed host memory
//   mod_migrate(state, from) -> i64     later loads: `from` = ABI of the old build
//   mod_tick(state, out, cap) -> i64    one game tick; writes text into out, returns its length
//   mod_shutdown(state) -> i64          before unload
//
// `state` is a block of 16 u64 owned by the HOST, so it survives a reload.
// Slot 0 = tick counter, slot 1 = total of the "damage" the mod has dealt.
// The mod keeps NO globals: everything it remembers lives in `state`.
//
// MOD_TAG and MOD_STEP are replaced by run.sh to make "v1" and "v2".
#[export_c]
#[no_gc]
fn mod_abi() -> u64 {
    return 1
}

#[export_c]
#[no_gc]
fn mod_init(state: u64) -> i64 {
    *(state as *mut u64) = 0
    *((state + 8) as *mut u64) = 0
    return 0
}

#[export_c]
#[no_gc]
fn mod_migrate(state: u64, from: u64) -> i64 {
    return 0
}

#[no_gc]
fn put_str(out: u64, at: usize, s: str) -> usize {
    var i: usize = 0
    while i < s.n {
        *((out + (at + i) as u64) as *mut u8) = *(s.p + i)
        i = i + 1
    }
    return at + s.n
}

#[no_gc]
fn put_dec(out: u64, at: usize, v: u64) -> usize {
    var t: [u8; 20] = [0; 20]
    var n: usize = 0
    var x: u64 = v
    if x == 0 {
        t[0] = 48 as u8
        n = 1
    }
    while x > 0 {
        t[n] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    var p: usize = at
    while n > 0 {
        n = n - 1
        *((out + p as u64) as *mut u8) = t[n]
        p = p + 1
    }
    return p
}

#[export_c]
#[no_gc]
fn mod_tick(state: u64, out: u64, cap: u64) -> i64 {
    let ticks: u64 = *(state as *mut u64) + 1
    *(state as *mut u64) = ticks
    let dmg: u64 = *((state + 8) as *mut u64) + MOD_STEP
    *((state + 8) as *mut u64) = dmg
    var p: usize = put_str(out, 0, "MOD_TAG tick=")
    p = put_dec(out, p, ticks)
    p = put_str(out, p, " damage=")
    p = put_dec(out, p, dmg)
    return p as i64
}

#[export_c]
#[no_gc]
fn mod_shutdown(state: u64) -> i64 {
    return 0
}

fn main() -> i32 {
    return 0
}
