// SPDX-License-Identifier: MPL-2.0
// tools/grapheme/probe.fi -- grapheme cluster probe.
//   probe <cases.bin>
// cases.bin = repeated records: u32 little-endian octet count, then that many UTF-8 octets.
// Prints one line per record: the cluster lengths in octets, separated by blanks.
import std.rt
import str.grapheme

fn main(start: u64) -> i32 {
    var inb: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &inb) {
        return 2
    }
    let t: u64 = grapheme.gb_map()
    if t == 0 {
        return 3
    }
    var out: rt.Buf = rt.buf_new()
    var pos: usize = 0
    while pos + 4 <= inb.len {
        let n: usize = rt.ld32(inb.ptr + pos as u64, 0) as usize
        pos = pos + 4
        if pos + n > inb.len {
            return 4
        }
        let p: u64 = inb.ptr + pos as u64
        var i: usize = 0
        while i < n {
            let k: usize = grapheme.gb_next(t, p, n, i)
            if i > 0 {
                rt.buf_push(&out, 32 as u8)
            }
            rt.buf_push_dec_u64(&out, k as u64)
            i = i + k
        }
        rt.buf_push(&out, 10 as u8)
        pos = pos + n
    }
    rt.write_everything(1, out.ptr, out.len)
    grapheme.gb_free(t)
    return 0
}
