#[export_c]
fn fi_get(p: *mut bits, which: i32) -> i64 {
    if which == 0 { return bits_get_a(p) as i64 }
    if which == 1 { return bits_get_b(p) as i64 }
    if which == 2 { return bits_get_c(p) as i64 }
    if which == 3 { return bits_get_d(p) as i64 }
    if which == 4 { return bits_get_f(p) as i64 }
    return bits_get_g(p) as i64
}

#[export_c]
fn fi_set(p: *mut bits, which: i32, x: i64) {
    if which == 0 { bits_set_a(p, x as u32) }
    else if which == 1 { bits_set_b(p, x as i32) }
    else if which == 2 { bits_set_c(p, x as u32) }
    else if which == 3 { bits_set_d(p, x as u32) }
    else if which == 4 { bits_set_f(p, x as i32) }
    else { bits_set_g(p, x as u32) }
}

#[export_c]
fn fi_varargs() -> i64 {
    let a: i32 = vsum3(3, 10, 20, 30)
    let b: i32 = vsum1(1, 7)
    let d: f64 = dmix_ii("x".p, 2, 3, 4, 4.5)
    return (a + b) as i64 * 1000 + (d * 10.0) as i64
}

#[export_c]
fn fi_consts_int(h: i64, p: i64, ul: i64, sh: i64, hb: i64, bb: i64) -> i64 {
    var bad: i64 = 0
    if HDR_SIZE as i64 != h { bad = bad + 1 }
    if PTR_SIZE as i64 != p { bad = bad + 1 }
    if ULONG_SIZE as i64 != ul { bad = bad + 1 }
    if SHORT_SIZE as i64 != sh { bad = bad + 1 }
    if HDR_BYTES as i64 != hb { bad = bad + 1 }
    if BUF_BYTES as i64 != bb { bad = bad + 1 }
    return bad
}

#[export_c]
fn fi_consts_text(pi6: i64, neg6: i64, half6: i64) -> i64 {
    var bad: i64 = 0
    if NAME_STR != "fire\tfly" { bad = bad + 1 }
    if VERSION_STR != "1.2" { bad = bad + 1 }
    if (PI_F * 1000000.0) as i64 != pi6 { bad = bad + 1 }
    if (NEG_E * 1000000.0) as i64 != neg6 { bad = bad + 1 }
    if (HALF * 1000000.0) as i64 != half6 { bad = bad + 1 }
    return bad
}

fn main() -> i32 {
    return 0
}
