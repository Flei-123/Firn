// bench/chan/chan_bench.fi -- throughput and ping-pong latency of lib/chan (docs/CHAN.md).
// self_compare_skip: prints throughput and latency numbers
import std.io
import std.rt
import std.time
import chan.chan

static mut g_a: u64 = 0
static mut g_b: u64 = 0
static mut g_n: u64 = 0

fn __thread_work(kind: u64, arg: u64) -> u64 {
    var a: chan.Chan = chan.Chan { blk: g_a }
    var b: chan.Chan = chan.Chan { blk: g_b }
    var i: u64 = 0
    var v: u64 = 0
    if kind == 1 {
        while i < g_n {
            chan.chan_send1(&a, i)
            i = i + 1
        }
        return 0
    }
    if kind == 2 {
        while chan.chan_recv(&a, &v) {
            chan.chan_send1(&b, v + 1)
        }
        return 0
    }
    return 9
}

fn throughput(cap: u64, producers: u64, per: u64) -> u64 {
    var a: chan.Chan = chan.chan_new(cap, 1)
    g_a = a.blk
    g_n = per
    let t0: u64 = time.monotonic_ns()
    var hs: [u64; 8] = [0; 8]
    var p: u64 = 0
    while p < producers {
        hs[p as usize] = thread_start(1, p)
        p = p + 1
    }
    var v: u64 = 0
    var got: u64 = 0
    let total: u64 = per * producers
    while got < total {
        chan.chan_recv(&a, &v)
        got = got + 1
    }
    let dt: u64 = time.monotonic_ns() - t0
    p = 0
    while p < producers {
        thread_wait(hs[p as usize])
        p = p + 1
    }
    chan.chan_free(&a)
    return total * 1000000000 / dt
}

fn pingpong(rounds: u64) -> u64 {
    var a: chan.Chan = chan.chan_new(2, 1)
    var b: chan.Chan = chan.chan_new(2, 1)
    g_a = a.blk
    g_b = b.blk
    let h: u64 = thread_start(2, 0)
    var v: u64 = 0
    let t0: u64 = time.monotonic_ns()
    var i: u64 = 0
    while i < rounds {
        chan.chan_send1(&a, i)
        chan.chan_recv(&b, &v)
        i = i + 1
    }
    let dt: u64 = time.monotonic_ns() - t0
    chan.chan_close(&a)
    thread_wait(h)
    chan.chan_free(&a)
    chan.chan_free(&b)
    return dt / rounds
}

fn main() -> i32 {
    let s1: u64 = throughput(1024, 1, 5000000)
    io.fmt_print_line(f"SPSC cap 1024, 1 word: {s1} msg/s")
    let s2: u64 = throughput(64, 1, 5000000)
    io.fmt_print_line(f"SPSC cap 64, 1 word: {s2} msg/s")
    let s3: u64 = throughput(2, 1, 1000000)
    io.fmt_print_line(f"SPSC cap 2, 1 word: {s3} msg/s")
    let m1: u64 = throughput(1024, 4, 1250000)
    io.fmt_print_line(f"MPSC 4 producers cap 1024: {m1} msg/s")
    let m2: u64 = throughput(64, 2, 2500000)
    io.fmt_print_line(f"MPSC 2 producers cap 64: {m2} msg/s")
    let pp: u64 = pingpong(200000)
    io.fmt_print_line(f"ping-pong round trip: {pp} ns")
    return 0
}
