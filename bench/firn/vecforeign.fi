// expect_exit: 0
// Microbenchmark: copy between two Vecs (r763). The store into `dst` does
// not touch the header of `src`, so the guard on `src` survives it and the
// index checks of both loops are proven away in release-safe / dev-fast.
import std.rt
import std.vec

fn add_into(dst: *mut Vec[i64], src: *mut Vec[i64]) {
    var i: usize = 0
    while i < vec_len[i64](dst) && i < vec_len[i64](src) {
        (*dst)[i] = (*dst)[i] + (*src)[i]
        (*dst)[i] = (*dst)[i] ^ (*src)[i]
        i = i + 1
    }
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var a: Vec[i64] = vec_new[i64]()
    var b: Vec[i64] = vec_new[i64]()
    var k: i64 = 0
    while k < 100000 {
        vec_push[i64](&a, k)
        vec_push[i64](&b, k * 3)
        k = k + 1
    }
    var r: i32 = 0
    while r < 50 {
        add_into(&a, &b)
        r = r + 1
    }
    if (*(&a))[5] == 12345 { return 1 }
    return 0
}
