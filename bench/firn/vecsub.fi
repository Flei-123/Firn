// expect_exit: 0
// Microbenchmark: v[i - 1] under 1 <= i < n (r762), signed and unsigned
// counters. In release-safe and dev-fast the index checks are proven away
// (r761: a vec_len call is the length word).
import std.rt
import std.vec

fn diffs(v: *mut Vec[i64]) -> i64 {
    var s: i64 = 0
    var i: i32 = 1
    let n: i32 = vec_len[i64](v) as i32
    while i < n {
        s = s + ((*v)[i] ^ (*v)[i - 1])
        i = i + 1
    }
    return s
}

fn smear(v: *mut Vec[i64]) {
    var i: usize = 1
    while i < vec_len[i64](v) {
        (*v)[i] = ((*v)[i - 1] + (*v)[i]) & 1023
        i = i + 1
    }
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i64] = vec_new[i64]()
    var k: i64 = 0
    while k < 100000 {
        vec_push[i64](&v, k)
        k = k + 1
    }
    var r: i64 = 0
    var rep: i32 = 0
    while rep < 20 {
        smear(&v)
        r = r ^ diffs(&v)
        rep = rep + 1
    }
    if r == 123456789 { return 1 }
    return 0
}
