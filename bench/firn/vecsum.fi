// expect_exit: 0
// Microbenchmark: sum of a Vec[i64] under its own length guard (r755:
// CheckedIdxV is proven away in release-safe).
import std.rt
import std.vec

fn sum_while(v: *mut Vec[i64]) -> i64 {
    var s: i64 = 0
    var i: usize = 0
    while i < vec_len[i64](v) {
        s = s + v[i]
        i = i + 1
    }
    return s
}

fn sum_pairs(v: *mut Vec[i64]) -> i64 {
    var s: i64 = 0
    var i: usize = 0
    while i + 1 < vec_len[i64](v) {
        s = s + (v[i] ^ v[i + 1])
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i64] = vec_new[i64]()
    var k: i64 = 0
    while k < 100000 {
        vec_push[i64](&v, k)
        k = k + 1
    }
    var total: i64 = 0
    var r: i32 = 0
    while r < 50 {
        total = total + sum_while(&v) + sum_pairs(&v)
        r = r + 1
    }
    if total == 0 { return 1 }
    return 0
}
