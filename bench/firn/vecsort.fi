// expect_exit: 0
import std.rt
import std.vec

fn main() -> i32 {
    if !gc_init() { return 1 }
    let n: usize = 1000000
    var v: Vec[i32] = vec_new[i32]()
    var seed: u64 = 12345
    var i: usize = 0
    while i < n {
        seed = seed *% 6364136223846793005 +% 1442695040888963407
        vec_push[i32](&v, (seed >> 33) as i32)
        i = i + 1
    }
    vec_sort[i32](&v)
    var bad: usize = 0
    var k: usize = 1
    while k < n {
        if v[k - 1] > v[k] { bad = bad + 1 }
        k = k + 1
    }
    if bad != 0 { return 2 }
    return 0
}
