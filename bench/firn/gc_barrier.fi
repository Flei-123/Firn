// SPDX-License-Identifier: MPL-2.0
// Round B4 -- the cost of the GC insertion barrier.
//
// Two measurements, both print picoseconds per unit of work:
//
//   1. store: N pointer stores into a heap field (`a.next = b`), nothing
//      else in the loop -- the barrier is most of the work.
//   2. reverse: a list of LEN nodes reversed in place R times -- three
//      loads, one Gc store and a few moves per node, the shape of real
//      pointer shuffling (DOM relinking, interpreter object graphs).
//
// The third line is a checksum, so the work cannot be optimised away and
// both compilers can be compared on the result.
gc class Node {
    next: Gc[Node],
    id: u64,
}

fn print_u64(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var n: usize = 0
    var x: u64 = v
    if x == 0 {
        buf[0] = 48
        n = 1
    }
    while x > 0 {
        buf[n] = (x % 10) as u8 + 48
        x = x / 10
        n = n + 1
    }
    var i: usize = 0
    while i < n / 2 {
        let t: u8 = buf[i]
        buf[i] = buf[n - 1 - i]
        buf[n - 1 - i] = t
        i = i + 1
    }
    buf[n] = 10
    syscall(1, 1, &buf[0], (n + 1) as i64)
}

fn now_ns() -> u64 {
    var ts: [u64; 2] = [0; 2]
    let r: i64 = syscall(228, 1, (&ts[0]) as usize as i64)
    return ts[0] * 1000000000 + ts[1]
}

fn stores(a: Gc[Node], b: Gc[Node], n: u64) -> u64 {
    var i: u64 = 0
    while i < n {
        a.next = b
        b.next = a
        i = i + 1
    }
    return a.next.id + b.next.id
}

fn reverse(head: Gc[Node]) -> Gc[Node] {
    var prev: Gc[Node] = gc_null[Node]()
    var cur: Gc[Node] = head
    while cur != gc_null[Node]() {
        let nx: Gc[Node] = cur.next
        cur.next = prev
        prev = cur
        cur = nx
    }
    return prev
}

fn main() -> i32 {
    if !gc_init() { return 3 }
    let a = gc Node { next: gc_null[Node](), id: 1 } catch gc_null[Node]()
    let b = gc Node { next: gc_null[Node](), id: 2 } catch gc_null[Node]()
    let n: u64 = 50000000
    let t0: u64 = now_ns()
    let s: u64 = stores(a, b, n)
    let t1: u64 = now_ns()
    print_u64((t1 - t0) * 1000 / (2 * n))

    let len: u64 = 1000
    var head: Gc[Node] = gc_null[Node]()
    var k: u64 = 0
    while k < len {
        head = gc Node { next: head, id: k } catch gc_null[Node]()
        k = k + 1
    }
    let rounds: u64 = 50000
    let t2: u64 = now_ns()
    var r: u64 = 0
    while r < rounds {
        head = reverse(head)
        r = r + 1
    }
    let t3: u64 = now_ns()
    print_u64((t3 - t2) * 1000 / (len * rounds))
    print_u64(s + head.id)
    return 0
}
