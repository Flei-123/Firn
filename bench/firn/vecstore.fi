// expect_exit: 0
// Microbenchmark: element stores in a Vec loop (r759) and a signed loop
// counter below the length (r760). In release-safe the index checks of
// both loops are proven away.
import std.rt
import std.vec

fn scale(v: *mut Vec[i64]) {
    for i in 0..vec_len[i64](v) {
        (*v)[i] = ((*v)[i] ^ 5) + 1
    }
}

fn sum_signed(v: *mut Vec[i64]) -> i64 {
    var s: i64 = 0
    var i: i32 = 0
    let n: i32 = vec_len[i64](v) as i32
    while i < n {
        s = s ^ (*v)[i]
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i64] = vec_new[i64]()
    var k: i64 = 0
    while k < 100000 {
        vec_push[i64](&v, k)
        k = k + 1
    }
    var total: i64 = 0
    var r: i32 = 0
    while r < 50 {
        scale(&v)
        total = total ^ sum_signed(&v)
        r = r + 1
    }
    if total == 12345 { return 1 }
    return 0
}
